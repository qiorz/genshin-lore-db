qT1782392970463\":[\"axbp0pnl1i5T1782393017675\",\"xdnl5so36olT1782393024906\"],\"xdnl5so36olT1782393024906\":[\"yw14ww1br3nT1782393018775\"],\"yw14ww1br3nT1782393018775\":[]},\"contents\":{\"axbp0pnl1i5T1782393017675\":{\"icon\":\"\",\"option\":\"旅行者：这是什么时候的茶…\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\"},\"kuxmqe6njfqT1782392970463\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e尼可：欢迎来到魔女小屋…等下原来是你们啊。\u003c/p\u003e\u003cp\u003e尼可：我现在不在挪德卡莱，在须弥看长鬓虎眦牙呢。桌上有茶，你们自己倒吧。\u003c/p\u003e\"},\"xdnl5so36olT1782393024906\":{\"icon\":\"\",\"option\":\"旅行者：还能喝吗？\",\"dialogue\":\"\"},\"yw14ww1br3nT1782393018775\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e尼可：想什么呢，魔女的茶壶中只会有刚沏的茶，放心喝。\u003c/p\u003e\u003cp\u003e尼可：不说了，那家伙朝我扑过来了。真是勇气可嘉，我去会会它。\u003c/p\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"9912","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"彩蛋三","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"关键词\",\"value\":[\"\u003cp\u003e「天使」、怀念\u003c/p\u003e\"]},{\"key\":\"备注\",\"value\":[\"\u003cp\u003e概率出现\u003c/p\u003e\"]}]}\n","style":""}],"id":"9908","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8177","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"jc8x1ms8wsT1782392221776\",\"child_ids\":{\"i20n7fxe58iT1782392254672\":[],\"jc8x1ms8wsT1782392221776\":[\"yb01ptqe7liT1782392254052\"],\"yb01ptqe7liT1782392254052\":[\"i20n7fxe58iT1782392254672\"]},\"contents\":{\"i20n7fxe58iT1782392254672\":{\"option\":\"旅行者：怀念还是「天使」的时候？\",\"dialogue\":\"\u003cp\u003e尼可：这倒也没有，那时候我活得挺无聊的，远没有现在这么有趣。不过那时候到处都是同伴，还挺热闹。\u003c/p\u003e\u003cp\u003e尼可：一定要说的话——我并非是怀念某个同伴，也不是怀念自己还是「天使」的时光。我只是单纯怀念「天使」这个种族而已。\u003c/p\u003e\",\"icon\":\"\"},\"jc8x1ms8wsT1782392221776\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e尼可：嗯…\u003c/p\u003e\",\"icon\":\"\"},\"yb01ptqe7liT1782392254052\":{\"option\":\"旅行者：在想什么呢？\",\"dialogue\":\"\u003cp\u003e尼可：我在想一些过去的事。众所周知…好吧也没那么多人知道，被毁灭的「天使」要么失去理想形态，要么失去力量。\u003c/p\u003e\u003cp\u003e尼可：我选择同时保留二者，但事实上也可以理解为同时失去二者。虽然我看起来依旧很像人类，但终究是不一样的。\u003c/p\u003e\u003cp\u003e尼可：打个比方说——人类没办法活几千年不疯不死对吧？活得久了，偶尔就会开始怀念以前的事情。\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"9906","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/06/25/50494840/128e7357078f4172ed3191dfe234460a_4072201989051068134.png\"}]}\n","style":""}],"id":"9910","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8178","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/06/25/50494840/35d6d674bce92a99c93897a8b776d285_897849560547827275.png\"}]}\n","style":""}],"id":"9913","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8178","without_border":false,"can_delete":false