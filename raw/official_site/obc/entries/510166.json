false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"w6qie5v28h9T1757444371834\",\"child_ids\":{\"w6qie5v28h9T1757444371834\":[]},\"contents\":{}}],\"root_id\":\"\"}\n","style":""}],"id":"8179","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"七圣召唤对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"piil9l0htzT1757444371851\",\"child_ids\":{\"piil9l0htzT1757444371851\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8180","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻想真境剧诗对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"anjx8kpxeffT1757444371854\",\"child_ids\":{\"anjx8kpxeffT1757444371854\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"tab_name\":\"邮件名——送信时间\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e邮件内容和贺图\u003c/p\u003e\"]}]}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"a60dfl0x04rT1757444371838\",\"child_ids\":{\"23460yd22w2T1757444712882\":[],\"36kzmhxjw2T1757444591699\":[],\"3w649ozfptsT1757444636867\":[\"br2enjsuhpmT1757444644576\"],\"4ny6xap1zs5T1757444582996\":[\"36kzmhxjw2T1757444591699\"],\"57n7vmjbnkgT1757444564317\":[\"4ny6xap1zs5T1757444582996\"],\"5spkbgsbybrT1757444504461\":[],\"7l4ijodi8mnT1757444671951\":[\"ybsk28y6jjmT1757444699744\"],\"a60dfl0x04rT1757444371838\":[\"loudpy976neT1757444500436\",\"bjl05hjauvlT1757444501525\",\"tcpfdatsecT1757444502585\",\"h5dpw6in7s7T1757444503267\",\"5spkbgsbybrT1757444504461\"],\"aecdcstdjykT1757444624578\":[],\"bfteyq8t9ruT1757444606497\":[\"ghboyt66jv6T1757444612271\",\"aecdcstdjykT1757444624578\"],\"bjl05hjauvlT1757444501525\":[\"bfteyq8t9ruT1757444606497\"],\"br2enjsuhpmT1757444644576\":[\"g64ac8f4f4T1757444651983\"],\"cjpykhkt3ksT1757444659521\":[\"ybsk28y6jjmT1757444699744\"],\"g64ac8f4f4T1757444651983\":[\"cjpykhkt3ksT1757444659521\",\"7l4ijodi8mnT1757444671951\"],\"ghboyt66jv6T1757444612271\":[],\"h5dpw6in7s7T1757444503267\":[],\"loudpy976neT1757444500436\":[\"57n7vmjbnkgT1757444564317\"],\"tcpfdatsecT1757444502585\":[\"3w649ozfptsT1757444636867\"],\"ybsk28y6jjmT1757444699744\":[\"23460yd22w2T1757444712882\"]},\"contents\":{\"23460yd22w2T1757444712882\":{\"option\":\"【我也来帮忙！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有件事确实只有你能帮忙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e给我说说这些家具摆件背后的故事吧，我想听！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"36kzmhxjw2T1757444591699\":{\"option\":\"【没关系，我会来救你的！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘻嘻，真的？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那你听见远处突然传来慌慌张张的银铃声时，要记得来找我哦？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"3w649ozfptsT1757444636867\":{\"option\":\"【欸？还缺什么吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…原本打算做一些藤编家具送你，但你这家具陈设一应俱全，就连小件摆设都已经不缺什么了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4ny6xap1zs5T1757444582996\":{\"option\":\"【我家是挺大的。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对对…大是一方面，可最让人啧啧称奇的还要数你在布设上的巧思。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我家乡的山也很大，但我从来不会迷路。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e刚刚我独自在周边逛了一下，得亏边走边留神着，不然可就找不着回来的路喽。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"57n7vmjbnkgT1757444564317\":{\"option\":\"【有哪里不满意吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？不不，你误会了，不是不满意的意思。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我说不习惯，指的是在这里很难保持平时的心境…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毕竟我还没住过这么奇妙的地方，说实话，直到这一刻我还很兴奋呢，心扑通乱跳。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5spkbgsbybrT1757444504461\":{\"option\":\"【晚安，蓝砚。】——【夜晚】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，快睡吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这小说还有两页，马上看完了，已经讲到主角睡前被床底下的手抓住脚跟的情节了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7l4ijodi8mnT1757444671951\":{\"option\":\"【我舍不得弄坏你做的藤编…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗐，原来你在担心这个呀？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e藤枝藤条都要先经历过洗、晒、拗、刨、等等好多道工序，还要熏蒸干燥，抹油上色…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e放一百个心好了，不是我自卖自夸，我做的藤器水不腐，虫不蠹，结实又耐用，没那么容易坏！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e退一万步来说，真弄坏了，可以修呀，我随时都在呢，难不成你还不相信我的手艺？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有，请答应我，不要因为怕弄脏弄坏再盖一层软布之类的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…我都快忘了我家里的家具原来的样子了，妈妈总是一层盖一层，再盖一层…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"a60dfl0x04rT1757444371838\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗨，我在这呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这个地方好有意思，玩风行迷踪一定很合适。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"aecdcstdjykT1757444624578\":{\"option\":\"【我真的累了…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…我们又不是银器工艺品，不需要被千锤百炼，累了就歇会吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听我的，你现在闭上眼睛，脑海中浮现的第一个画面是什么，我们就去做什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是好吃的？还是好看的风景？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e什么？！是冒险手册上没做完的委托清单？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎…看来不解决这个问题你是歇不住了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好吧，我们一起去，但要两天后才能出发哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为我现在不想去，我要尊重自己「现在」的想法，给你做个好榜样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可以在你的手册里插入一条紧急委托吗？那就是陪我好好放两天假吧！我倒是真的累了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"bfteyq8t9ruT1757444606497\":{\"option\":\"【突然这么问，有点答不上来…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对吧对吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知道你有没有发现，我对你的了解好像比你对我的少得多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，我们聊过好多好多…我的爱好啊，烦恼啊，出糗的瞬间啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可关于你，我只知道你有很多了不起的经历，还有很多非常重要的事情等着你去完成…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e噢，我不是说这样不好，只是…「过去」和「未来」加起来应该不能等于一个人的「全部」吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总感觉大家都很容易忽视「现在」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有过「走很远的路都不会累」的记录，所以哪怕现在脚很痛了，也要咬着牙继续赶路。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e计划一天要完成很多事情，所以即使早早困了也不肯去睡觉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你每天好像比筑巢的燕子还忙，我还挺好奇这种状态真是你当下想要的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"bjl05hjauvlT1757444501525\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那我想要聊…唔…就聊一聊此时此刻你的心情吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没错，就现在，这一分钟这一秒钟你的心里正在想什么呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"br2enjsuhpmT1757444644576\":{\"option\":\"【嗯，全是我的杰作和收藏！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，看得出来，有些物件应该很有意义吧，一尘不染的，你一定很爱惜它们。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈，我想到了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e给桌椅板凳铺上藤席，还有，易碎的器皿摆件也套个藤甲，这样就不怕刮花碰坏啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cjpykhkt3ksT1757444659521\":{\"option\":\"【能收获蓝师傅的匠心力作，当然好！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抬爱啦。我的小手工能被大名鼎鼎的旅行者夸赞，荣幸至极！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好了好了，我的配合打得不错吧？可以暂停客套了哦？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e轮到我直说了——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e藤席也好藤甲也好，做好以后你就大胆随心使用，最好不要放到柜子里收藏啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有，请答应我，不要因为怕弄脏弄坏再盖一层软布之类的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…我都快忘了我家里的家具原来的样子了，妈妈总是一层盖一层，再盖一层…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"g64ac8f4f4T1757444651983\":{\"option\":\"【那多麻烦你呀！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么能说是麻烦，你忘啦？我是手工艺协会的成员，我擅长也喜欢做这种手工活。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e况且我来你这里打搅了这么久，你也没说麻烦呀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是你觉得好呢，我就打点打点马上动手，还有顾虑的话…不妨趁这个机会说说看？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ghboyt66jv6T1757444612271\":{\"option\":\"【当然，这样很充实！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊——？出乎意料的答案！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还以为你会哭诉说你真的累了呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，也好。这是最好不过的答案，至少说明你从内而外都是那么有活力！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呼…那我就不用担心了。来，快陪我再聊几句。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e快告诉我像你这么忙的人会睡懒觉吗？你左手和右手能各自做完全不相干的事情吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"h5dpw6in7s7T1757444503267\":{\"option\":\"【早啊，蓝砚。】——【白天】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好啊，睡得好吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看你的状态，睡个回笼觉比较好哦？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"loudpy976neT1757444500436\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然不太习惯，跟我平时爱待的地方太不一样了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"tcpfdatsecT1757444502585\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我在想还需要添置些什么呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ybsk28y6jjmT1757444699744\":{\"option\":\"【哈哈，包在我身上！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好耶！开工开工。我来量尺寸！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/af332958a5bcbeb647da5622e5478229_759821508272441054.png\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色赠礼","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"同伴赠礼\",\"header\":[\"好感套装\",\"对应奖励\",\"好感套装对话\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper