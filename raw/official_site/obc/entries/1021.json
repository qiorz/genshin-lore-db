lse,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"2jcjdc5v37zT1746869875069\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呦，客官您这话问的，我要是能说准了，那大家还玩什么啊？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…而且就算开不出玉石，也能开出点别的东西不是吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这不，前两天刚有个大老板从里面开出了几块矿石，看都不看就扔给我了，可这些搁我这儿也是占地儿啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不，您有用就拿去？以后多来光顾我的生意就行了，哈哈哈…\u003c/p\u003e\u003cp\u003e【\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1028\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/f64303524fe1245e0fa8710b70a0bbea_702048159379594484.png\\\" data-entry-name=\\\"精锻用杂矿\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1028/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1028/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/f64303524fe1245e0fa8710b70a0bbea_702048159379594484.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用杂矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/b26706122e54335e75a99308e473cc62_8007640927840247848.png\",\"option\":\"【开出来的概率大吗？】——获得精锻用杂矿*4\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e客官看来是没玩过啊，真稀奇呢。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e这些璞石都是「岩层巨渊」出产的存货，上等的玉石原料，您随便挑着买一块。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e「孰知石中玉有无，一刀切开知赢输。」\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e您也别怕钱打了水漂，这业内还有一句话——\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e「今天不来明天来，总有一天好运来！」\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于璞石…】\"},\"4wox21qft15T1746869671726\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这就走了吗客官，别与好运擦肩而过哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"4xkwryn5u66T1746869935432\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"5n4ubf7bbmdT1746869682058\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"5ygok0h9qhT1746869703694\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e客官，看你满面红光，今天一定要走大运！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e怎样，买块璞石试试手气？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"60flebt3s8vT1746869825783\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这就走了吗客官，别与好运擦肩而过哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e客官，看你满面红光，今天一定要走大运！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e怎样，买块璞石试试手气？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9vb1e3r58yT1746869748454\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e【胜利】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e可以啊，客官，没想到被您给轻松挑过了，了不得。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan\u003e【失败】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e嘿嘿，看来客官您还要多试试，下次再来啊！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手四级解锁】\"},\"bx268qyi916T1746869714099\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e来，您请便！这些都是从璞石里开出来的，虽然不是翡翠，但说不定能入了您的眼呢！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/11ee64c710e3b091256c0d349ac55461_9025602401545864528.png\",\"option\":\"【你这里除了璞石还卖什么吗？】——打开商店界面\"},\"cy4604kq1spT1746869616457\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呦，客官您这话问的，我要是能说准了，那大家还玩什么啊？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…而且就算开不出玉石，也能开出点别的东西不是吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这不，前两天刚有个大老板从里面开出了几块矿石，看都不看就扔给我了，可这些搁我这儿也是占地儿啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不，您有用就拿去？以后多来光顾我的生意就行了，哈哈哈…\u003c/p\u003e\u003cp\u003e【\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1028\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/f64303524fe1245e0fa8710b70a0bbea_702048159379594484.png\\\" data-entry-name=\\\"精锻用杂矿\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1028/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1028/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/f64303524fe1245e0fa8710b70a0bbea_702048159379594484.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用杂矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/b26706122e54335e75a99308e473cc62_2123483147212359114.png\",\"option\":\"【开出来的概率大吗？】——获得精锻用杂矿*4\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e来，您请便！这些都是从璞石里开出来的，虽然不是翡翠，但说不定能入了您的眼呢！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/11ee64c710e3b091256c0d349ac55461_1211692920712605899.png\",\"option\":\"【你这里除了璞石还卖什么吗？】——打开商店界面\"},\"p8fyoo7bdudT1746869819660\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e怎么，客官第一次来「解翠行」？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e我们这儿几代以来都经营珠宝玉器，在璃月，招牌也打得很响亮。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e可是最近行业不景气啊，总务司把原料产地的「岩层巨渊」给封锁了。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e所以现在原料反而快比产品值钱了…我就想不如直接把璞石拿来卖，刺激、好玩、又说不准能赚钱…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e现在我那群经常一起打牌的朋友都会来店里买璞石，生意也比同行「明星斋」要好得多了哈哈…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是？】\"},\"sebc5h33pqT1746869820544\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客官看来是没玩过啊，真稀奇呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些璞石都是「岩层巨渊」出产的存货，上等的玉石原料，您随便挑着买一块。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「孰知石中玉有无，一刀切开知赢输。」\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您也别怕钱打了水漂，这业内还有一句话——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「今天不来明天来，总有一天好运来！」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于璞石…】\"},\"xrh6rv2e4nhT1746869749561\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e【胜利】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e客官您运气不错啊，今天一定能走大运，玩完牌顺便买块璞石吧！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan\u003e【失败】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e客官，看来您今天的运气不在玩牌上，哎，就得在刚输的时候开璞石，不如来一块？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【决斗对局】——进行七圣召唤对局【牌手四级解锁】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e怎么，客官第一次来「解翠行」？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e我们这儿几代以来都经营珠宝玉器，在璃月，招牌也打得很响亮。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e可是最近行业不景气啊，总务司把原料产地的「岩层巨渊」给封锁了。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e所以现在原料反而快比产品值钱了…我就想不如直接把璞石拿来卖，刺激、好玩、又说不准能赚钱…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e现在我那群经常一起打牌的朋友都会来店里买璞石，生意也比同行「明星斋」要好得多了哈哈…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是？】\"},\"z75d2gqxkybT1746869817919\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e唉，岩王爷一路走好了…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e不过伤心归伤心，我们也得好好活着不是？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e我在考虑要不要把在送仙典仪上用到的那种夜泊石改个名，以此来纪念岩王爷。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e你说是叫「送仙石」好，还是叫「别神石」好呢？好像两个都不错啊…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于岩王帝君的死…】——完成魔神任务 第一章第三幕「迫近的客星」后\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2jcjdc5v37zT1746869875069\":[\"4xkwryn5u66T1746869935432\"],\"4xkwryn5u66T1746869935432\":[],\"60flebt3s8vT1746869825783\":[\"4xkwryn5u66T1746869935432\"],\"8gfxrw8wla9T1710863939170\":[\"bx268qyi916T1746869714099\",\"9vb1e3r58yT1746869748454\",\"xrh6rv2e4nhT1746869749561\",\"z75d2gqxkybT1746869817919\",\"p8fyoo7bdudT1746869819660\",\"sebc5h33pqT1746869820544\",\"60flebt3s8vT1746869825783\"],\"9vb1e3r58yT1746869748454\":[\"4xkwryn5u66T1746869935432\"],\"bx268qyi916T1746869714099\":[\"4xkwryn5u66T1746869935432\"],\"p8fyoo7bdudT1746869819660\":[\"4xkwryn5u66T1746869935432\"],\"sebc5h33pqT1746869820544\":[\"2jcjdc5v37zT1746869875069\"],\"xrh6rv2e4nhT1746869749561\":[\"4xkwryn5u66T1746869935432\"],\"z75d2gqxkybT1746869817919\":[\"4xkwryn5u66T1746869935432\"]}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"【决斗对局】：石头","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"石头\",\"created_at\":\"2022-12-26\",\"list\":[{\"energy_bg\":11,\"ep_id\":5524,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/26/160491137/5edc9e7666110963cd4bd6b59a0bc593_2612523086001557317.png\",\"life\":8,\"life_bg\":11,\"link\":\"/ys/obc/content/5524/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":11,\"ep_id\":5358,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/26/160491137/f324df836656f10930a04f3016fb8019_667835495388724974.png\",\"life\":10,\"life_bg\":11,\"link\":\"/ys/obc/content/5358/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":0,\"ep_id\":5371,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/26/160491137/95b39b2c2120904d796253e11e4bc23a_4756798834971169445.png\",\"life\":10,\"life_bg\":11,\"link\":\"/ys/obc/content/5371/detail?bbs_presentation_style=no_header\"}]}\n","style":""}],"id":"1255","is_customize_name":true,"is