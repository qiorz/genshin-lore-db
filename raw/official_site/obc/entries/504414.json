alse,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e魔神任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"503686\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/26/80663279/8d13718394910e0eb47b42159a7fa4f3_5970122536495089791.png\\\" data-entry-name=\\\"第五章 幕间「万火归一」\\\" data-entry-link=\\\"/ys/obc/content/503686/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/503686/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e第五章 幕间「万火归一」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"pv3wi793p2dT1737044227920\"],\"nqb471m7nmnT1710863941173\":[],\"pv3wi793p2dT1737044227920\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是负责打理部族物资的帮手，请多关照啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无论是部落的日常事务，还是最最重要的飞行队，都需要各方各面的支持。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我年轻时是飞行队中的一员，对这一块的需要再清楚不过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然现在年纪大了，一到龙背上就开始头晕，但还是闲不住啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e能在这里给大家帮忙，算是非常适合我的工作了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好。是来提供物资的帮手，还是需要我们帮助的同伴呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你的物资和帮助，我们会提供相应的报酬的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/17/288180982/60e98896f16b1e2f98bb1952b677ae4f_4374652252440781861.png\",\"option\":\"【关于我在「花羽会」的声望…】\"},\"pv3wi793p2dT1737044227920\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请慢走，要注意安全哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【打扰了。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个就是花羽会的「曜石图腾柱」啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你已经去过其他部族，那可能已经见过类似的石柱了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这根图腾柱在我小时候就是这个样子，现在也没有变过，一直见证着花羽会的兴衰起落。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我想，只要它还存在一天，花羽会就能继续翱翔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，这里是…】——开启纳塔声望后\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"「话事处」的赠礼","is_poped":fa