kqg6T1739862450885\":[\"1154p391cxgT1739862507021\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"a187zrs0rosT1739862602173\":[\"pu751fzb8noT1739862658869\"],\"afw45lwm3tT1739862678573\":[],\"h79abmm1turT1739862449925\":[\"1154p391cxgT1739862507021\"],\"ipwtf3g1lwT1739862563005\":[\"viq30msfrbT1739862585029\"],\"nqb471m7nmnT1710863941173\":[\"qtxgczjj908T1739862448990\",\"h79abmm1turT1739862449925\",\"39ij5lbkqg6T1739862450885\"],\"pu751fzb8noT1739862658869\":[\"afw45lwm3tT1739862678573\"],\"qtxgczjj908T1739862448990\":[\"1154p391cxgT1739862507021\"],\"viq30msfrbT1739862585029\":[\"a187zrs0rosT1739862602173\"]},\"contents\":{\"1154p391cxgT1739862507021\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好的，您的反馈我收到了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e欸？您问别的？我没有别的话要说了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊...老大的意思是，我的工作只要说，「您有什么要反馈的吗?」，「您的反馈我们收到了」这两句话就可以了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果客人还要追问什么时候反馈才有消息，那就再加一句，「请您耐心等待」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他说他在其他地方参加的活动都是这样的，想必是借鉴了一下优秀的经验吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过后来忍姐说这样实在太敷衍了啦，所以又给我准备了一个小本子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e瞧，您的意见我已经记下来了，等忍姐回来了再给她看看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"39ij5lbkqg6T1739862450885\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【我觉得不太行。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「荒泷极上盛世豪鼓大祭典」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"a187zrs0rosT1739862602173\":{\"dialogue\":\"\u003cp\u003e【阿晃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我们以前跟老大去过一次。但老大当时突发奇想，突然就开始比赛…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你们怎么不去？】\"},\"afw45lwm3tT1739862678573\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"h79abmm1turT1739862449925\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【我觉得一般般。】\"},\"ipwtf3g1lwT1739862563005\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「三川游艺绮梦谭」期间\u0026完成终夜「如伴雷电」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是荒泷豪鼓祭反馈大使阿晃，您有什么要反馈的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"pu751fzb8noT1739862658869\":{\"dialogue\":\"\u003cp\u003e【元太】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…忘了，只记得当时差点就热晕过去了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【比赛什么？】\"},\"qtxgczjj908T1739862448990\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【我觉得还不错。】\"},\"viq30msfrbT1739862585029\":{\"dialogue\":\"\u003cp\u003e【阿守】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？你没跟老大他们去泡温泉吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1739868961","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module