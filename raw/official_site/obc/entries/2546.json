h_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/07/76078930/df9ea5feb957f08ee68c11b1b27446b8_6647785851697182702.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"1t7we0i51okT1713831088995\":[\"c9f6ytukucvT1713910698796\",\"4ixpuobb7zbT1713910699110\"],\"2v1fl0bskilT1713912486647\":[\"ht8ihe2gdt7T1713912551677\",\"x1g2tnq6wuT1713912552029\"],\"4ixpuobb7zbT1713910699110\":[\"lgv5cgwviT1713910753069\"],\"9aaaywud0kgT1713910770995\":[\"alr50qepg0cT1713910812840\"],\"alr50qepg0cT1713910812840\":[\"mq10lgu75oT1713910851655\",\"x3tjzmbrpqT1713910851949\"],\"c9f6ytukucvT1713910698796\":[\"lgv5cgwviT1713910753069\"],\"ewllh0qqr0dT1711546416025\":[\"1t7we0i51okT1713831088995\",\"pwyuq123y4hT1713831089323\"],\"ht8ihe2gdt7T1713912551677\":[],\"jubag3w847T1713910939418\":[\"2v1fl0bskilT1713912486647\",\"z63wns8sunjT1713912487473\"],\"lgv5cgwviT1713910753069\":[\"9aaaywud0kgT1713910770995\",\"pdk3yjftphtT1713910771326\"],\"mq10lgu75oT1713910851655\":[\"jubag3w847T1713910939418\"],\"pdk3yjftphtT1713910771326\":[\"alr50qepg0cT1713910812840\"],\"pwyuq123y4hT1713831089323\":[],\"x1g2tnq6wuT1713912552029\":[],\"x3tjzmbrpqT1713910851949\":[\"jubag3w847T1713910939418\"],\"z63wns8sunjT1713912487473\":[]},\"contents\":{\"1t7we0i51okT1713831088995\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e嘉义：\u003c/strong\u003e那就拜托你了，实在是太感谢了！\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e嘉义的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，本来我算着日子，再值个两三天班就能回去了…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e加上我之前攒的假，这次回去少说能陪小六一个多星期。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e结果一声命令全体千岩军取消休假，正在休假的也全部召回。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e按照我的经验，至少一个月内我都别想回轻策庄。这都叫什么事嘛…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与若心对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这孩子，跑到哪里去了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于小六…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们是来找小六的？唉，你们来得不巧，那孩子不知道跑到哪里去了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e前几天，她爸爸从璃月港里托人带了封信回来，说很快就能回来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e小六很开心，说要给她爸爸准备礼物，拉着几个孩子到处采花采野果…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e结果前几天，她爸爸又说临时要执勤，回不来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这孩子就赌了气，怎么劝也不好，非说她爸爸不回来，她就自己去璃月港。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们还当她是开玩笑，结果今天一起来，小六人就不见了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，能去找她的人已经都出去找她了，要是你们愿意的话，就也去找找她吧。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"2v1fl0bskilT1713912486647\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与嘉义对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你把礼物送给小六了吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"直接返回\"},\"4ixpuobb7zbT1713910699110\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e这孩子也跑不太远，应该就在附近，但荒郊野外的太危险了…你们快去找找她吧。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：她会去哪？\"},\"9aaaywud0kgT1713910770995\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义年年也都这么说，我都记不清他说了多少次了…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：他也是为了璃月港…\"},\"alr50qepg0cT1713910812840\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e寻找小六\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这些是…脚印？难道是小六的，我们快点往前追吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这些落下的树莓…说不定就是小六采的，得快点找到她。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e好多脚印，总觉得不太妙，我们快点找找小六吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e打倒所有魔物\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e看那边，小六在那边！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e她被丘丘人围住了，快把这些丘丘人打倒！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与小六对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小六：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们是来抓我回轻策庄的吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"c9f6ytukucvT1713910698796\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那就麻烦你了，唉，这孩子…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与嘉义对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e啊…已经这么久没回过轻策庄了，小六，爸爸好想你啊…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你还好吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是旅行者啊，谢谢你关心，我没什么事，就是想我女儿了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e本来说好，等值完这一轮班，我就请个假回轻策庄好好陪她几天。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但是…但是谁知道璃月港突然出了这么大的事，不仅休假的千岩军全部召回，在岗的千岩军也全部取消休假。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e而且还必须全天候执勤，别说请假了，执勤的时候去喝口水都要提前找好临时替班的人。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我礼物都买好了，这么一大包玩具，这下可怎么办…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e对了！旅行者，你能帮我把这些玩具送给我女儿小六吗？她就住在轻策庄里，问问村长若心就能找到她。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"hmb82af99eT1713912742299\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：帮助小六带礼物\"},\"ht8ihe2gdt7T1713912551677\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e那就好，那都是她最喜欢的玩具。谢谢你们，这些拿着吧，算是谢礼了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：送过去了。\"},\"jubag3w847T1713910939418\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e你们回去告诉村里的人，我要去璃月港找我爸爸去。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e找到了之后，我和我爸爸说会话就回去，让他们别操心了。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e追上小六\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e哎！你等等呀！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e小六跑走了…我们快点追上去吧，别出什么意外。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e打倒所有魔物\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与小六对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e你们跟着我到底有什么事？我说了我要去璃月港。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e这些魔物我自己会绕着走，它们发现不了我。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e别老是把我当小孩子，我已经长大了！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e这是你爸爸给你的…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e我爸爸给我的？是他要你们送过来的吗…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e准又是些小孩子玩的东西…不是风筝就是娃娃。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e你不喜欢这些？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e…喜欢啊，我爸爸送给我的东西，我怎么可能不喜欢。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e但我要是一直只喜欢这些东西的话，不就一直是小孩子了吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e老是玩这些，我什么时候能成为冒险家，拿到「神之眼」啊。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e你要「神之眼」做什么？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e有了「神之眼」，我就能做到很多事了啊，无论是赚钱还是其他什么…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e然后，爸爸就不用天天在璃月港里工作，可以回来陪我了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e你看，现在我没有「神之眼」…连自己去璃月港都做不到。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e不过，爸爸都让你们把礼物送过来了，我去找他，说不定还会给他添麻烦。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e我本来也给他准备了礼物，想要给他个惊喜的…但现在我自己是送不过去了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e要是有人愿意帮我送过去…算了，我回去了。你们别跟着我了，我自己知道回去的路。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e若心的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们回来啦，辛苦你们了，小六已经回来了，怀里还抱着个包裹。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那是嘉义送给她的。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是吗…唉，但是小六那孩子，还是更想他人回来啊。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这小孩子啊，就和村子旁边的那些竹子一样，开始不惹眼，但是一眨眼就长大啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e孩子的小时候啊，错过了，就错过了，再也补不回来了…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"lgv5cgwviT1713910753069\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e若心的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嘉义也是，怎么说不回来就不回来了。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这孩子一年都见不到他几次，这天下哪里有这么当爸爸的。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"mq10lgu75oT1713910851655\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e小六：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e哼，果然是来抓我回去的，我才不回去呢。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：若心奶奶很担心你。\"},\"pdk3yjftphtT1713910771326\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那他也要顾顾自己的女儿吧，小六可是看着看着长大了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e可别到时候，他是不工作了回庄里住着了，结果小六又要去工作了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e若心：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这父女俩啊，反正就凑不到一块去。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：这也是为了工作…\"},\"pwyuq123y4hT1713831089323\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e好吧，轻策庄那么远，也不好麻烦你，我自己再想想办法。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者： 还有别的事。\"},\"x1g2tnq6wuT1713912552029\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e我也想回去，可是现在璃月港这情况，我怕是一时半会走不了了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e唉，还是谢谢你们，那些都是小六最喜欢的玩具，她的心情应该会好些。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e这些给你们，就算是谢礼吧。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者： 她更想你回去。\"},\"x3tjzmbrpqT1713910851949\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小六：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我才不要你们的东西，又是那些哄小孩的东西…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我们有东西给你…\"},\"xt1bhfzulqeT1713912758279\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：直接与嘉义对话\"},\"z63wns8sunjT1713912487473\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e娃娃…风筝…风车…爸爸果然又送了这些。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e唉，可惜了我搜集的那些礼物，没法送到爸爸手上了…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e我帮你把礼物送过去吧。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e你要帮我送过去？好吧…虽然你没有「神之眼」，但你刚才对付那些魔物的样子，好像还挺轻松的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e也只能这样了，那就拜托你了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e唉，要是…我也有你这样的身手就好了。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e小六的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e要是我有「神之眼」就好了，有了「神之眼」就能做很多事，无论是赚钱啦，还是其他什么…\u003cbr\u003e\u003cstrong\u003e小六：\u003c/strong\u003e至少…自己去璃月港这件事，肯定是没问题的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e小六：\u003c/strong\u003e但是，到底怎么才能获得「神之眼」呢…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与嘉义对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e嘉义：\u003c/strong\u003e你把礼物送给小六了吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这是小六给你的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这是…小六给我的东西？这么多，那孩子得花了多大功夫。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我真是恨不得直接回轻策庄去算了，但是总务司这边又…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谢谢你们，这些是谢礼，请收下吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e嘉义：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，也不知道这事情到底什么时候才算完，总务司又到底什么时候能准我的假…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"与小六对话\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1714011048","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"传说任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"世界任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"限时任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他任务\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"任务区域\\\",\\\"children\\\":[{\\\"label\\\":\\\"蒙德\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"璃月\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"层岩巨渊\\\",\\\"children\\\":[]},