-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/07/76078930/6515a9835053803345d4294457bb14af_3145981155856962349.png\\\" data-entry-name=\\\"嘉义\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/1673/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1673/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/07/76078930/6515a9835053803345d4294457bb14af_3145981155856962349.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e嘉义\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e璃月港\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e千岩军嘉义想要送一份礼物给自己的女儿小六，但他实在抽不出空回轻策庄，正在找人帮忙...\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e与嘉义对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与若心对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e寻找小六\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e打倒所有魔物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与小六对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e追上小六（\u0026gt;30米失败）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e打倒所有魔物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与小六对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与嘉义对话\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"swit