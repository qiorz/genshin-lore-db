003e\u003cspan class=\\\"name\\\"\u003e兰迦鲁的涂鸦\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5285\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/07/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_8057617322572995012.JPG\\\" data-entry-name=\\\"回忆终章\\\" data-entry-link=\\\"/ys/obc/content/5285/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5285/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e回忆终章\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"child_ids\":{\"3gmn5h27ncxT1758714851557\":[\"nqb471m7nmnT1710863941173\"],\"8gfxrw8wla9T1710863939170\":[\"3gmn5h27ncxT1758714851557\"],\"ldgvfjq5ouT1758714804664\":[\"sn3ztnlb4ccT1758714826095\"],\"nqb471m7nmnT1710863941173\":[\"ldgvfjq5ouT1758714804664\",\"w30ulcdfi3T1758714805288\",\"otcjw0er80bT1758714819910\"],\"otcjw0er80bT1758714819910\":[\"sn3ztnlb4ccT1758714826095\"],\"sn3ztnlb4ccT1758714826095\":[],\"w30ulcdfi3T1758714805288\":[\"sn3ztnlb4ccT1758714826095\"]},\"contents\":{\"3gmn5h27ncxT1758714851557\":{\"dialogue\":\"\u003cp\u003e【兰纳迦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e森林会记住一切。但是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰迦鲁】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望不要有风，吹走快乐，让快乐多留一下。希望有雨，淋湿大地，留住那菈朋友，多停一下…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」结束之后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【森林会记住一切。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰迦鲁】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，无忧节好热闹，桓那兰那到处都是快乐！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰纳真】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是无忧节会结束。兰那罗的那菈朋友，可能也会离开。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"ldgvfjq5ouT1758714804664\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e无忧节很开心，那菈旅行者也收到了许多花。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e兰迦鲁很好奇。为什么金色的那菈像是汇聚雨水的河流一样地，收到大家的花朵。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e原来在故事里，兰迦鲁更早就送过花了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于花…】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那菈旅行者是新朋友，但是原来早就收到过花了，兰迦鲁的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"otcjw0er80bT1758714819910\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，金灿灿的那菈旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"sn3ztnlb4ccT1758714826095\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"w30ulcdfi3T1758714805288\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e坏蛋那菈的花，是兰迦鲁送的。不过不知道是谁，不记得了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是那时候，坏蛋那菈肯定还不坏。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的时候，明明月亮升起的时候，那菈还是好孩子，但是到了太阳再升起的时候，那菈就变坏了，不明白…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，不管太阳与月亮升落多少次，那菈旅行者也一定都会和那菈法留纳那样，金灿灿的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于坏蛋那菈…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758719219","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"ty