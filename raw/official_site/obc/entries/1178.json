eader\\\"\u003e\u003ca href=\\\"/ys/obc/content/1018/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e旧味难寻\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"ydc1a9x86eT1722155935133\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"czj7cz9ciq5T1722155943580\"],\"czj7cz9ciq5T1722155943580\":[],\"nqb471m7nmnT1710863941173\":[],\"ydc1a9x86eT1722155935133\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【这里真是冷清。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，可不是嘛。早知道我就应该听老爷子的话好好在家待着，出来开什么客栈…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我这家客栈的位置就没选好，偏偏在望舒客栈和璃月港的中间…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e从北边来的旅客顺路就投宿望舒客栈了，从南面来的旅客呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e又往往是刚刚在璃月港歇够了才出来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…唉，你看，根本没人会来我这里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这位客人您好！您是来歇脚还是住店？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"czj7cz9ciq5T1722155943580\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请慢走！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我想买些吃的。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e打尖儿是吧？客官想吃点啥？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/28/288180982/11ee64c710e3b091256c0d349ac55461_2420252143562634525.png\"},\"ydc1a9x86eT1722155935133\":{\"option\":\"【关于客栈经营…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我就凑合开吧，实在没有客人就关张大吉，把这座破房子低价转让出去。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e靠这个行当真的是没办法谋生…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我这人也没什么本事，只能回去继承老爷子留下三座玉石矿，勉强过日子吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【我只是路过。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦…路过，也挺好的。不进来喝点茶，吃点东西吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1722183259","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_