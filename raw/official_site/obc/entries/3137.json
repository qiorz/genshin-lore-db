ame":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【第一次开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e喂！我还在这呢！！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e现在年轻人都是怎么回事，一点公德心都没有吗！！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【对，对不起！】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哼...这还差不多，认错就好，那点蘑菇就当我送你的了...不要乱碰我的蘑菇啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【这是你的蘑菇吗？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e关你什么事！别再乱采摘了，乖乖离开就好！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哇啊！刚刚那家伙...你看到了吗？！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【没看到。】和【是幻觉吧。】一样\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e唔....真邪门。我们再摘几朵蘑菇就快点离开吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【等刷新再次采掉蘑菇触发】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【第二次开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e喂！我没有警告过你们吗！你们是耳朵不好还是没长眼睛呀？！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【哇，是幽灵】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哇啊！什么幽灵？！哪里有幽灵！！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【就在这里哦。】和【就是我啦。】一样\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e呀啊！去，去！恶灵速去！以我阿部的氏名，命你快快离去！！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e唉呀，邪门，邪门！我活了这么些年，还没见过如此凶残的灵！！为何还不速去！！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【我是从岛外来的。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e雾海外的恶灵吗...哼，我可不怕你！你在这里站着别动，等着让雷鸟大人把你驱走吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【雷鸟不会再来了。】和【「雾海」已经是过去了。】一样\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说什么...？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【大家都已经离去了。】和【是时候告别了。】一样\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e什么...你在说什么啊...别说让我害怕的话呀，鸡皮疙瘩都起来了...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不过...岛上的人是越来越少了...之前木奈那孩子说，大家都去坐船了呢...唉，也不知道那孩子跑去哪里玩了....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e对了，岛外来的恶灵大人，你不去吗...？海边那条银璨璨的船?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【我没看到哪里有船。】和【那不是为我准备的。】一样\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哼...我就知道，那船呀，岛外的人是看不到的...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e谢谢你催我上船，岛外的恶灵大人，只不过呀...我活了这么些年，还有好些东西没见识过呢，可舍不得离开...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你需要什么？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e需要？哈哈，不算需要吧。。也就是看个新鲜而已....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我很小，很小的时候，曾经和宇奈大姐打过一个赌...我说岛外一定有不一样的蘑菇，可她就是不信。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e后来...她的丈夫出海去了外人的土地，就再也没能回来...他的灵也只能在外人的土地上晃悠了....可怜呀。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e于是，宇奈大姐一直是一个人过日子到现在...一想起来我就....唉....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【请不要惦记别人了。】和【关于蘑菇。。】一样\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我还求过祭司大人呢....好歹要给人家一个归宿....嗯？哦，对了，对了，蘑菇！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e咳咳....就要登船了，我也没什么可遗憾的.....就是没见过岛外的玩意。可是我最上心的呢....也就是每天在关照蘑菇们了....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e就请你给我带来一些雾海外的蘑菇吧....也让我涨涨见识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e拜托你了，岛外的恶灵大人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【结束后再问】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e怎么？准备让我开开眼界了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【这些是你要的蘑菇吗？】————给予阿部蘑菇×3和慕风蘑菇×3\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哦哦！哈哈...真是奇怪的形状！它们也是自己的「灵」吗？它们也凝结着人的记忆吗....？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e还有这个...软软呼呼的，小翅膀一样，它是会飞吗...？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e唉呀...没完没了的好奇，船夫都要生气了...真是不好意思，最终还是该走了，该上船咯....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e————获得精致宝箱×1\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1699536228","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692",