ich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"5rbgyf25qztT1720487511099\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"82ptep7r5n9T1720009545759\"],\"82ptep7r5n9T1720009545759\":[],\"8gfxrw8wla9T1710863939170\":[\"5rbgyf25qztT1720487511099\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？如果是说前段时间的话，泽娜一直在枫丹科学院那边。想要学习帅气发条机关的制作技巧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那边也有一个看上去非常非常帅气的巨型机关，但泽娜总有一天会拼出比那个还要大的东西来的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【之前似乎没见过你…】\"},\"5rbgyf25qztT1720487511099\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要是有亮闪闪的东西，可以和泽娜交换喔！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"82ptep7r5n9T1720009545759\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见啦！记得再来哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务「古老的颜色」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都在这里了！如果有什么喜欢的东西，就请跟我说吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/11ee64c710e3b091256c0d349ac55461_8378575660584545270.png\",\"option\":\"【能交换什么呢…】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没错没错，就是像这样的，闪闪发光的零件！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是有了足够多的零件，说不定就可以用它们拼出比厄里那斯还要大的超巨型机关，想想就令人兴奋。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e泽娜有时候也会到村外收集那些暂时还没有办法发光的小东西，想办法把它们变成晶光闪闪的样子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，亮闪闪的东西越多越好！所以，如果有亮闪闪的东西，可以像大家一样，用它们和泽娜交换喔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【亮闪闪的东西？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746389356","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","r