03c/span\u003e\u003c/p\u003e\u003cp\u003e完成「魔女的谕示」相关任务，可以解锁对应角色的额外天赋，部分角色的技能与命之座效果也会发生变化。\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/50494840/83561c18ea066fbf4ac8f0ef673ce4af_8391067320368808990.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/50494840/83561c18ea066fbf4ac8f0ef673ce4af_8391067320368808990.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e每个「魔女的谕示」任务分别对应一名角色。获得对应角色，并使对应角色的角色等级提升至70级以上，即可解锁对应的任务。\u003c/p\u003e\"]},{\"key\":\"魔女的谕示·说明\",\"value\":[\"\u003cp\u003e【角色强化】\u003c/p\u003e\u003cp\u003e完成「魔女的谕示」相关任务，可以解锁对应角色的额外天赋，部分角色的技能与命之座效果也会发生变化。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【解锁条件】\u003c/p\u003e\u003cp\u003e每个「魔女的谕示」任务分别对应一名角色。获得对应角色，并使对应角色的角色等级提升至70级以上，即可解锁对应的任务。\u003c/p\u003e\"]},{\"key\":\"玩法说明\",\"value\":[\"\u003cp\u003e【基本玩法】\u003c/p\u003e\u003cp\u003e完成「偶发的谕示」，即可获得「魔女的谕示匣」。通过揭晓「魔女的谕示匣」中的谕示，即可解锁对应角色的额外天赋，并获得角色强化。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【参与条件】\u003c/p\u003e\u003cp\u003e完成魔神任务「巨龙与自由之歌」。\u003c/p\u003e\"]}]}\n","style":""}],"id":"8910","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"更多信息","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"官方资讯\",\"value\":[\"\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/76308867\\\" target=\\\"_blank\\\"\u003e「魔女的谕示」玩法说明\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.co