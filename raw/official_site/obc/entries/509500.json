u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/14/288180982/1b764ab0418774d3f6ebf1bf4b1bd200_4185603251647415445.png\",\"option\":\"【我需要一些钓鱼用品…】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，钓鱼，做好准备很重要…人生也是这样…呵呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"w241dcdai2mT1786638525657\":{\"icon\":\"\",\"option\":\"【是、是吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e正是如此啊…不过要是真的能钓上一条就好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【那今天赢了吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…如果只想着赢的话，是没有办法赢的，衡量人生的标准又岂能如此狭隘呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像我…虽然失去了正经的工作和妻子的体贴，但在垂钓时获得的平静也值回了一切…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1786673055","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repe