\"],\"oku8fu1684dT1758536755711\":[\"7p2fnh3586T1758536771376\"],\"x5ng0dpqhk8T1758536812958\":[\"36yhh5wes0gT1758536823851\"],\"y7v9dycy8b7T1758536852645\":[\"be7gyec1s3eT1758536871145\"]},\"contents\":{\"06t04v90pc68T1758536642118\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都是「精选货物」，快来看一看吧，「物美价廉」，「预购从速」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"36yhh5wes0gT1758536823851\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」结束之后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"45xs4zkkg4yT1758536801407\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「快乐」看不见，摸不着，但充满了无忧节的桓那兰那…我明白了，快乐是那菈朋友带来的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【「快乐」是什么？】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"5opfdqjjvdT1758536634983\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」举办之前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"7p2fnh3586T1758536771376\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e节日！快活！「客人」很多，可以「大卖」，「走过路过，千万不要错过」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"7zlw221lnnrT1758536843487\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e无忧节「赚」了「盆满钵满」，还想要更多的快乐，所以下一步…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【初入桓那兰那】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"97hio1dvm1T1758536731167\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，那菈朋友，「欢迎您下次光临」？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"9pcc5hpbfwfT1758536853374\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，那莅朋友。希望你也「盆满钵满」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"be7gyec1s3eT1758536871145\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"fxakkbar0dwT1758536652745\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「特产」？不明白，但是有「精选货物」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/22/288180982/11ee64c710e3b091256c0d349ac55461_7896959029201234394.png\",\"option\":\"【来点兰那罗特产】——打开商店界面\"},\"if40o20xpscT1758536653454\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e现咦，为什么那菈朋友的表情这么奇怪？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那菈商人就是这么说话的呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还是说，这里不可以「预购从速」？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不明白，那菈商人，说话太奇怪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【兰那罗…商人？】\"},\"mnqn3bw9mmiT1758536791853\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e现在「大卖」的是无忧节的快乐，那菈朋友，要快乐吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么卖的东西？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e用那菈的话该怎么说…「童叟无欺」？不懂，完全不懂。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"oku8fu1684dT1758536755711\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"x5ng0dpqhk8T1758536812958\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，那莅朋友。希望你快乐多多，能「大卖」！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"y7v9dycy8b7T1758536852645\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e现在不叫「精选货物」了，现在兰玛尼卖的是「特产」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/22/288180982/11ee64c710e3b091256c0d349ac55461_5674200632929114736.png\",\"option\":\"【来点精选货物。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758537156","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"a