stract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e【稳定作息的重要因素好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这里给我的感觉，像是回到了特巡队队舍啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但还少了几件搭在椅子背上的衣服，几杯喝剩下的咖啡…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，也缺了一群累得东倒西歪的特巡队队员。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【禁限之堡的「拳力以赴」好感套装对话】\u003c/strong\u003e\\t\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这么想来，我也亲手送了不少人进梅洛彼得堡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e既然他们有了一次新的机会，那我希望…他们能够好好把握，赎清自己的罪孽。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最重要的是，认清是非，不要再犯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true