ttps://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/7b2c7a9d947ca010e2b719e9b58a102d_604969010600198248.png\\\" data-entry-name=\\\"冒险阅历*100 原石*20 「天光」的指引*3 （获得六份旅程记录）\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"无\\\"\u003e\\n    \u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\\n      \u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/7b2c7a9d947ca010e2b719e9b58a102d_604969010600198248.png\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e冒险阅历*100 原石*20 「天光」的指引*3 （获得六份旅程记录）\u003c/span\u003e\\n      \\n    \u003c/a\u003e\\n  \u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务开始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/5971bc3466296229bfa01be7414373b9_6310321369753242045.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e〓路线攻略〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e具体路线攻略推荐：\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/10925405\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e【V2.2攻略】#邀约事件#早柚，托马邀约简明攻略【导图】\u003c/a\u003e  作者：\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color:rgba(102,102,102,1)\\\"\u003eDramaturge\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd1 凡事都需节制\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/fa022e7513b7614efd7c0f518399f775_4500191011804658285.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e「逃脱」对早柚来说如同家常便饭，但这次她失手了。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd2 如在天际翱翔\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/b27e01a167c633745d51d97b7bebefa4_8616655182689072629.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e虽然长高之事并不顺利，但至少你能让她看到未来的风景。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd3 早柚绝不工作！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/2ef8885413083a47d4860e45997e408a_1519816980808541384.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e既然怎么都藏不住，那就只能靠速度了！\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd4 与树同行\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/efed0e608cd9882e740b49b709be0555_2223203583711901089.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e稍微有点理解她的想法了，终有一天，她能够回应所有的期待吧。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd5 最安稳的休憩\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/e4f96e4617168ee8a2b55594f0945a61_8827895417329093588.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e辛劳之后的休憩最为甘甜，你见证了她的努力，此时就再多守护她一会儿吧。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd6 小小早柚之烦恼\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/4e387e01ff08541e545cc371ba7e1b28_1896973826520161678.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e每个人都要在烦恼中学习如何与世界相处，早柚也不例外...\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1702959533","langs":[],"te