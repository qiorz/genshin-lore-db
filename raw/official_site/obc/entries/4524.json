4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e那就欢迎再来咯。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【暂时不用。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e亲爱的客人，需要歇脚的地方吗？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8y3vnoj0m6lT1747474234346\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e举手之劳，不必客气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e旅途劳累，最重要的就是充足的食物和安全的住处。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而这两点，便是小店能够提供给大家的了。\u003c/p\u003e\u003cp\u003e【\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4898\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/d74505923f85009267f96d590856e8ec_6987668828701456852.png\\\" data-entry-name=\\\"兽米香香\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/4898/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/4898/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/d74505923f85009267f96d590856e8ec_6987668828701456852.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e兽米香香\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/17/50494840/b26706122e54335e75a99308e473cc62_1149479913141225759.png\",\"option\":\"【多谢提醒。】——获得兽米香香*3\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里是「金砂之旅」，我呢，就是这间旅店的老板啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不用担心，我不会因为自己开着喀万驿唯一的旅店就漫天要价，所以客人可以放心入住。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，如果你愿意找附近的居民或者游学者的住所借住，也是可以的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过因为这里是驿站，来往的人…鱼龙混杂，所以客人在选取住所时，可要睁大双眼啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"8y3vnoj0m6lT1747474234346\":[],\"nqb471m7nmnT1710863941173\":[\"8y3vnoj0m6lT1747474234346\"]}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222621","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","corr