{"retcode":0,"message":"OK","data":{"page":{"id":"203","name":"瓦格纳【铁匠老板】","desc":"瓦格纳【铁匠老板】","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2022/09/21/183046623/afd50f1736d6df7dda12d34aafef016d_8489638765739970947.png","header_img_url":"","modules":[{"name":"瓦格纳","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"key\":\"编者注：\",\"value\":[\"\u003cp\u003e蒙德城内最受人信任的铁匠！\u003c/p\u003e\"]}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/03/23/4905523/ef22472b80f625ccd1c9778aa9e54fef_6991199705423993015.png\",\"attr\":[{\"key\":\"性别\",\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"]},{\"key\":\"位置\",\"value\":[\"\u003cp\u003e蒙德城\u003c/p\u003e\"]},{\"key\":\"功能\",\"value\":[\"\u003cp\u003e铁匠铺\u003c/p\u003e\u003cp\u003e矿物富集点指引\u003c/p\u003e\"]},{\"key\":\"职业\",\"value\":[\"\u003cp\u003e铁匠老板\u003c/p\u003e\"]}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/22/4905523/f9932a4054a0e6ddd01bd715ff864881_2537977708968527905.png\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/12/21665168/000daf1b46aeaeaef8274504d0007349_3262280037855723399.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"锻造列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/c