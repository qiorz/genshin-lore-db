t\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/09/76373921/c936520994ef0dc05e64267c629bd588_8433549590102860932.png\\\" data-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（轻策来客、轻策庄的霄灯、海灯节的诗与画之二）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"3ma8n0aozkrT1783672113227\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"di64bjnvhn6T1783672094828\"],\"di64bjnvhn6T1783672094828\":[],\"nqb471m7nmnT1710863941173\":[],\"sj1bcils6uT1783672109971\":[],\"z2tn3pzsbujT1710863943430\":[\"sj1bcils6uT1783672109971\",\"3ma8n0aozkrT1783672113227\"]},\"contents\":{\"3ma8n0aozkrT1783672113227\":{\"option\":\"【没有神之眼也可以冒险的。】——获得《侠客记·第一卷》\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你是想说侠客之类吗？我才不要呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e庄里的老人听说我喜欢冒险的故事，给我找了很多侠客的书…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我看过才发现，主人公全都是些臭男人嘛！我才不喜欢这种故事呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…你没看过？那就拿走吧，反正我可不想当侠客！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"605\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/28/8797197/a0b405c48a068f4e745835411663d86d_6373662680241252433.png\\\" data-entry-name=\\\"侠客记·第一卷\\\" data-entry-link=\\\"/ys/obc/content/605/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/605/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/28/8797197/a0b405c48a068f4e745835411663d86d_6373662680241252433.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e侠客记·第一卷\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/10/288180982/b26706122e54335e75a99308e473cc62_5879894243851189265.png\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【为什么在乎神之眼？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e因为我也想得到神之眼啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有了神之眼就有了地位和钱，有了钱爸爸妈妈就会回村子，不用留在璃月港了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我把神之眼的事告诉其他小朋友以后，他们都很想要呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e喂，看起来很像冒险家的人，你有神之眼吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"di64bjnvhn6T1783672094828\":{\"option\":\"【不告诉你。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，什么嘛，又不是没见过。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【决斗对局】——进行七圣召唤对局【牌手九级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…这次不算，下次我会赢的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，我赢了！就算是大人，打牌也没什么了不起的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/10/288180982/cc2a44c2e85425afbbd461e49fe0875d_8715727715319906925.png\"},\"sj1bcils6uT1783672109971\":{\"option\":\"【但我能操纵元素。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不可能，少骗人了，我读了这么多书也没有听说过有这种事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e别以为我是小孩子，你就可以骗我…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【没有。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那就麻烦了，没有神之眼的冒险家是没有办法被人记住的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要问为什么的话，有神之眼才能使用元素的力量，才能惩奸除恶，才能高人一等！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e反正好处可多了，书上都写着的，书里记下来的著名冒险家都有神之眼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你连神之眼都没有，就别做什么英雄梦了吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"f