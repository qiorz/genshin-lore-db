nent_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"3s8ljfbo0s4T1757519425020\":[\"tmqur81e8bjT1759885354370\"],\"4cf2vhylew3T1710863944349\":[\"bzpgi51kk1T1757518199496\",\"ws5ea33otq8T1757518200141\",\"4h46l5s9d6eT1757518201058\"],\"4h46l5s9d6eT1757518201058\":[\"tmqur81e8bjT1759885354370\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"3s8ljfbo0s4T1757519425020\",\"4cf2vhylew3T1710863944349\",\"lnbcb6hfu6jT1757518061045\"],\"bzpgi51kk1T1757518199496\":[\"tmqur81e8bjT1759885354370\"],\"lnbcb6hfu6jT1757518061045\":[\"tmqur81e8bjT1759885354370\"],\"nqb471m7nmnT1710863941173\":[\"tmqur81e8bjT1759885354370\"],\"s2mvuxis92qT1759885727306\":[],\"tmqur81e8bjT1759885354370\":[\"xr8b7c104raT1759885389081\"],\"ws5ea33otq8T1757518200141\":[\"tmqur81e8bjT1759885354370\"],\"xr8b7c104raT1759885389081\":[\"s2mvuxis92qT1759885727306\"],\"z2tn3pzsbujT1710863943430\":[\"tmqur81e8bjT1759885354370\"]},\"contents\":{\"3s8ljfbo0s4T1757519425020\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e之前的委托已经完成了喔。还需要什么别的东西吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/288180982/45b433a26de72a670e897bbcda70fa8f_40389067783576654.png\",\"option\":\"【委托锻造…】——打开锻造界面【有未获取的已完成锻造物品】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？啊…没什么，只是在想月矩力的新应用而已。要是能进一步改造这台锻造机器的话…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，现在的挪德卡莱也没几个比「它」还要厉害的锻造师啦。除了爱诺…嗯，除了爱诺。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你在做什么?】\"},\"4h46l5s9d6eT1757518201058\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e月矩力就是…嗯…解释起来很麻烦，所以你就当成一种很厉害的能量吧。这里的机关基本上都是靠着这个运行的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e霜月之子的家伙还会管这个叫祝福什么的…听听就好，听听就好啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于月矩力…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果能把这个发现应用于新的装置…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"bzpgi51kk1T1757518199496\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e铁匠？嗯…你觉得我算吗？我觉得应该不算，毕竟和老爹不一样，我连锤子都拎不起来嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是研究员啦，研究员…虽然研究的经费基本都来自打铁的收入就是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是铁匠吗？】\"},\"lnbcb6hfu6jT1757518061045\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦…拜拜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不打扰了，再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？好喔，随便看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/288180982/11ee64c710e3b091256c0d349ac55461_4768890361468597670.png\",\"option\":\"【想买些武器。】——打开商店界面\"},\"s2mvuxis92qT1759885727306\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"tmqur81e8bjT1759885354370\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【队伍中包含爱诺时】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ws5ea33otq8T1757518200141\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼哼，怎么样，看上去就很厉害吧？这可是爱诺和我的得意之作，罗素姆工坊的万能锻造机关喔。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要投入原材料，无论是日常使用的工具还是兵器，都可以按照标准制造模板快速生产出来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e之前听奈芙尔大姐说，那些北方人好像也有类似的东西…不过没有月矩力的话，他们的机器又是靠什么驱动的呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于这台机器…】\"},\"xr8b7c104raT1759885389081\":{\"dialogue\":\"\u003cp\u003e【柳佳】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e爱诺？今天怎么有空来我这边？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e和伊涅芙一起来买东西，路过这边，就顺便过来玩啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【柳佳】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样啊，我还以为你又是来给我出难题的，你那些设计图，我可是看不懂的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦对了，上次你帮我改造的设备挺好用的，谢啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，锻造出来的矿石很纯净，而且对原矿的利用率也很高。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那当然了，你也不看看，到底是谁帮你亲手改造的设备。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【柳佳】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是你是你，大大天才爱诺师傅。喏，我刚买了点零食，趁你家伊涅芙不在，赶紧尝尝？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e又用零食收买我，这次又要我帮你什么？先说好，无聊的东西我可不做，力气活你去找伊涅芙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【柳佳】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，都说了是为了感谢你上次的帮忙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你上次也这么说，每一次都是为了感谢上一次，你是认定了一定还会有「下一次」么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【柳佳】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳，不说这个！来来来，吃糖吃糖，还有巧克力和蛋卷呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506380\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/ec1d7d6fed9f195fbc811b219284c791_3682243623086739835.png\\\" data-entry-name=\\\"白灵蛋卷\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506380/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506380/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/ec1d7d6fed9f195fbc811b219284c791_3682243623086739835.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e白灵蛋卷\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/08/80663279/d14d59d4aa24fe90d719dafc11f4d7b8_8058937053634809067.png\",\"option\":\"【开场白】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…需要什么呢？只要有图纸，不管什么都能打造出来喔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/288180982/45b433a26de72a670e897bbcda70fa8f_6477975282804602482.png\",\"option\":\"【委托锻造…】——打开锻造界面【无已完成锻造物品】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule