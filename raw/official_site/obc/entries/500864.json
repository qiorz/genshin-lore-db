can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"fxhjuc3vmdlT1717770932126\"],\"fxhjuc3vmdlT1717770932126\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【船上吃东西不会难受吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人您可说到点子上了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们家的料理经过八珍师傅的改进，在保持菜肴原有风味的基础上，添加了多种辅料…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有了这些辅料的帮助，食客们晕船的症状将大大缓解，自然不会难受了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的回头客在登船前还会特意来我们这儿买茶点，说是吃了以后再大的风浪都不怕了，很不错吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e茶叶蛋和茶糕，清爽的小吃！连芳茶点欢迎您！我们主打简单便捷的特色料理，可以带上船吃哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"fxhjuc3vmdlT1717770932126\":{\"option\":\"【下次再来…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e随时恭候您的到来！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【让我看看菜单…】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请您随意挑选！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/07/75981509/11ee64c710e3b091256c0d349ac55461_4767385744488070797.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【为什么强调简单便捷？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊呀，这就说来话长了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e沉玉谷的氛围悠闲清雅，本地人习惯在水边对坐，煮一壶茶，摆两碟豆子、两个主菜…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一面欣赏大好风光，一面慢慢地对饮对谈，兴致正酣时，便吟诗作赋，好不自在！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e都说美景衬美食，在这种意境下，杯中茶和碟中菜的味道尤为醉人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e许多沉玉谷的传统菜肴就是基于这种情景烹调的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可是遗珑埠毕竟是个商港，你和外国的客人说这些，他们不懂的啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来来往往的人都想着快些搞定工作，大笔大笔赚钱，他们更需要能快速吃完的工作餐。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，为了满足他们的需求，我就对传统的菜肴适当做了改进。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等到客人们都喜欢上了本地的美食，再慢慢引导他们静下心来，在合适的意境中享受正餐…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这样就既能适应商业化的潮流，又能宣传本地的传统美食了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1736074529","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器