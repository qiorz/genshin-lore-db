003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，愿晨曦能为您带来片刻休憩。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e贵安，欢迎来到晨曦酒庄。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"dgzimgfagcwT1718201359679\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是摩可和海莉那里听来的吗？唉……她们是不是又给客人说了奇怪的话。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不必放在心上，她们说什么都不要在意，不要深思，也不要细想。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么会有这样那样的事嘛，呵呵呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于传闻…】\"},\"gqekpkchv9sT1718201603044\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看样子，他最近过得还不错。只是他和迪卢克老爷吃饭时虽然一直笑着，却还是能看出略有顾虑…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，是说这个称呼吗？都是过去的事了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e抱歉，我失言了…请无须在意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在第一次佳酿节结束后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【凯亚少爷？】——第一次佳酿节（2022）期间\"},\"h4i82f8pcwsT1718201552703\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你认识凯亚少爷？他最近过得还不错吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，是说这个称呼吗？都是过去的事了……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e抱歉，我失言了……请无须在意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【凯亚少爷？】\"},\"ob6q7qyri4cT1718201568602\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【佳酿节期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"yvy906zutoT1718201360856\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您多虑了，那些真的是无稽之谈，呵呵呵…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…对了，您最近胃口如何呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我今天做肉排时多做了一些，如果不嫌弃的话就请收下吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e请您不要想太多，这些都是用普通的兽肉做成的，绝对没有任何问题，呵呵呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"87\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/12/183046623/e7daf00481b52dee2525039f0adca6e8_7102035865217040734.png\\\" data-entry-name=\\\"美味的蜜酱胡萝卜煎肉\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/87/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/87/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/12/183046623/e7daf00481b52dee2525039f0adca6e8_7102035865217040734.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的蜜酱胡萝卜煎肉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/12/183046623/b26706122e54335e75a99308e473cc62_8511157930152410549.png\",\"option\":\"【真的是这样吗…】―――获得美味的蜜酱胡萝卜煎肉*3\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这里的女仆长。在酒庄内若是需要帮助，随时可以来找我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e工作吗？不过是些内务，平时只要打扫府邸，清理杂务，已经很轻松了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"gqekpkchv9sT1718201603044\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"dgzimgfagcwT1718201359679\":[\"yvy906zutoT1718201360856\"],\"gqekpkchv9sT1718201603044\":[],\"nqb471m7nmnT1710863941173\":[],\"yvy906zutoT1718201360856\":[],\"z2tn3pzsbujT1710863943430\":[\"dgzimgfagcwT1718201359679\"]}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1730773414","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","templa