lete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"3k07k9lj16aT1713234289512\":[\"z156fmummjT1713234354079\"],\"ewllh0qqr0dT1711546416025\":[\"3k07k9lj16aT1713234289512\",\"n3cs0vnog7iT1713234289985\",\"j9gb85cvngT1713234311472\"],\"j9gb85cvngT1713234311472\":[\"z156fmummjT1713234354079\"],\"n3cs0vnog7iT1713234289985\":[\"z156fmummjT1713234354079\"],\"z156fmummjT1713234354079\":[]},\"contents\":{\"3k07k9lj16aT1713234289512\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e欸？你居然这么觉得吗⋯\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我也觉得。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与夏诺蒂拉对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e哎呀，又见面了。咦，这次把派蒙也带来了吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e咦，上次我们一起「冥想」到这里来的时候，我也在呀⋯\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e有这回事？那可能是我忘了吧。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e不管怎么说，多亏你帮忙，我才找到了「谜镜」的位置、找到将要盛开花朵的地方，对这里的了解也加深了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e唔⋯夏诺蒂拉说话的风格还是这么令人摸不着头脑呢。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e「小狗」：\u003c/strong\u003e汪！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e嗯？不过⋯\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e「小狗」：\u003c/strong\u003e呜汪！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e好啦好啦，我知道啦。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e（唔⋯她和小狗在说什么呀？难道说，美露莘一般都会狗语吗？）\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e（真不可思议。）\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e真没办法，那下次再见喽。哼，就算你这么说了，我也还是会回来找你玩的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e夏诺蒂拉：\u003c/strong\u003e那我们走吧，旅行者哥哥(姐姐)、派蒙。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e回到海沫村\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉。又到这里来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e怎么啦？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e其实我也觉得这么说太任性了，毕竟大家都对我很好，你们也对我很好。但是⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不觉得现实世界无趣得可怕吗？不觉得书里的世界更美丽吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"j9gb85cvngT1713234311472\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e看来旅行者哥哥(姐姐)是最坚强的人呢。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：对我来说没有区别。\"},\"n3cs0vnog7iT1713234289985\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是喔…可能这样才是对的，我这样是不正常的。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我不这么觉得。\"},\"z156fmummjT1713234354079\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我觉得，还是「揭示之书」里的世界更美丽。到处都是沾着露水的花瓣，而且好不容易才跟小狗交上了朋友。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e小狗⋯说起来，夏诺蒂拉，你能听懂狗狗说的话吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯？当然不能啦。只是，「揭示之书」里的小狗是特别的。也可能，我是特别的？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但我一直冥想，到书里的世界去玩。有一天，突然间，原本的汪汪叫，就变成了语言。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e至于我们说的话⋯他在劝我走，让我不要再来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，我还是想看到向日葵盛开的景象⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e⋯⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是、是喔⋯夏诺蒂拉要多保重喔！那我们先走啦！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1754528411","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_