ng\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;孤心沙龙：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;元素战技\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;芙宁娜\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;当前处于「始基力：荒性」形态：召唤\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;沙龙成员\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;br\u0026gt;（芙宁娜处于「始基力：芒性」形态时，会改为召唤\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;众水的歌者\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e装备有此牌的芙宁娜使用\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e孤心沙龙\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;孤心沙龙：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;元素战技\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;芙宁娜\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;当前处于「始基力：荒性」形态：召唤\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;沙龙成员\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;br\u0026gt;（芙宁娜处于「始基力：芒性」形态时，会改为召唤\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;众水的歌者\u0026lt;/span\u0026gt;\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e时，会对自身附属\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e万众瞩目\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;万众瞩目：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;状态\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;角色进行普通攻击时：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;使角色造成的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;物理伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;变为\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(24, 144, 255)\u0026quot;\u0026gt;水元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。如果角色处于「荒」形态，则治疗我方所有后台角色1点；如果角色处于「芒」形态，则此伤害+2，但是对一位受伤最少的我方角色造成1点穿透伤害。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;可用次数：1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。（角色普通攻击时根据形态触发不同效果）\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e（牌组中包含芙宁娜，才能加入牌组）\u003c/span\u003e\u003c/p\u003e\"]},\"tab_id\":\"1759479143814_0\"}],\"baseInfoSwitchDisabled\":false,\"repeated\":true}","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038307","lang