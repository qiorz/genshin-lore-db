mize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【第一次开场白】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e孩子们，永远不要放弃，希望就在你们之中...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e是你们吗?孩子们，你们成功了吗?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不，不是..我感觉到了，你们不是...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e旅行者，他好像个目盲之后被留影的人..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不论你是什么人，请帮帮我!帮我找到孩子们，我有话要告诉他们。\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【可是，你是谁呢？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我...我的名字是..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我...忘记了我的名字...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我只记得...我曾为白夜国站了出来，为了希望战斗过。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我至今仍然是反抗军。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e可是在白夜国这样的地底国家，你在反抗什么呢?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e当然是庙堂之上污秽的贵人们!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e他们号称接收着神明的旨意，嘴上打着神明的旗号，做的事却只为满足他们的低劣欲望。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e表面上是太阳之子们的监护者， 实际上就是国家的统治者， 本质上却是趴在人民身上吸食血肉的虫豸!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e他们必须要被消灭。\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这些记得这么清楚，却连自己的名字都忘记了...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e那是因为他们的手段就是这么残忍!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e因为上次的失败，他们抓住了我，将我囚禁在这处祭坛里折磨。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这是一个恶毒的囚牢，我能感觉到，我的灵魂被碾磨，有珍贵的东西在流失...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e善良的人啊，我恳求你，趁我还记得这些，请去帮我找到孩子们!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e告诉他们，永远不要放弃，希望就在他们之中..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【孩子们？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e有一批愿意跟随我的青年人，他们很聪明。他们是我的学生，也是我们的后备军。我把他们看作是我的孩子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e邪恶的大人们想尽各种办法要撬开我的嘴，让我交代孩子们的情报，我不可能开口。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e因为我知道，希望就在他们之中...\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e现在这个时间点，他们应该都不在了吧..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不，不会的!他们都是好孩子，一样怀揣着理想。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我都没有放弃...他们一定还在坚持。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【应该如何找到他们？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我肯定记得，这种事我肯定记得...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我告诉你他们的藏身处。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但是如果找到了他们，要怎样说明来意呢?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e「我们是一位忘记名字的反抗军大叔派来的」?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不，这还不够，我把他们教得很好。除非你们能够证明自己，否则他们绝对不会信任你们。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但我现在却连名字都想不起来了，可恶啊...\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e旅行者，这位大叔看起来曾经是白夜国的重犯。怎么说也是个历史里能留名的级别了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e他的线索应该不难找到吧，说不定附近就有。我们可以先找找看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果在历史里留下名字，我希望这名字让我们事业的后继者来书写。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【看过建筑旁的墓碑再对话】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你们你们是谁?你们的声音有熟悉的感觉..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e欸?这么快把我们忘了..大叔的状况已经这么差了吗?好担心...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e谢谢，我们真的认识吗?\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e选【我们刚刚才见过。】和【我们刚刚在寻找你的身份。】一样\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e啊，我想起来了...在这里灵魂会被磨损，我的记忆衰退太严重了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e抱歉，我....唉!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你们找到了有用的信息吗?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你的名字是贼子须吗？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哎呀，不是贼子须，是须婆达之彦啦!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e选【你的名字是须婆达之彦吗？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e须婆达之彦.. .须婆达之彦，没错!我就是反抗军的首领，斯巴达克!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e所以须婆达之彦和斯巴达克，都是大叔的名字吗?不愧是首领大叔啊，连名字都有两个!\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e感谢你们找回了我的名字，我好像还想起了一些别的..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e......\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e「黑暗来自太阳之后，光明藏于你我之中。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【这是？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这是我们反抗军的秘密口令。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e找回了名字，记忆也逐渐回来了。这应该就是我们的暗号。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e现在，让我把孩子们的藏身处告诉你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【有什么需要我带话的吗？】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【须婆达之彦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e让我想想,让我想想....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e把我的话带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你希望我带他们回来见你吗？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不，永远不要。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我们唯一的优势，就是敌明我暗，而且所有白夜之民的心都和我们在一起。 不要轻易暴露自己。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e更何况，现在我已经不能记住他们每个人的名字了。甚至连自己的名字都已经..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e把我的话带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【如果他们已经不在了...】\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_d