,\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/12/18/82503813/5b8d831cc21648a69de0b73e2b0cc80d_5820446249991559812.png\"},{\"tab_name\":\"任务结束位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/12/18/82503813/5b8d831cc21648a69de0b73e2b0cc80d_1896287645852728429.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"3v4icxus5kbT1713237850990\":[\"5u3hybesr6T1713237870454\"],\"5u3hybesr6T1713237870454\":[],\"a40g03kkacuT1713237691302\":[\"ndofknfbqdfT1713237807598\"],\"ewllh0qqr0dT1711546416025\":[\"u02p5yz49kgT1713237690846\",\"a40g03kkacuT1713237691302\"],\"ndofknfbqdfT1713237807598\":[\"tbd12iik7qT1713237850575\",\"3v4icxus5kbT1713237850990\"],\"tbd12iik7qT1713237850575\":[\"5u3hybesr6T1713237870454\"],\"u02p5yz49kgT1713237690846\":[\"ndofknfbqdfT1713237807598\"]},\"contents\":{\"3v4icxus5kbT1713237850990\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：（还好你没去。）\"},\"5u3hybesr6T1713237870454\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e（什么嘛！真气人…）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…总之，我不要呆在这里了，我要和大家一起住在海沫村里。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那就对啦！别的美露莘会好好照顾你的！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯。谢谢你们，旅行者哥哥(姐姐)、派蒙。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"a40g03kkacuT1713237691302\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你很明智。那么别了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我想也是。把我送回去吧。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e「揭示之书」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者，还要进行「冥想」吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e夏诺蒂拉还没找到。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这次也拜托你稍等我片刻。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔…好吧！反正也就是一眨眼功夫的事情啦。我一点也不担心！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你要注意安全喔，旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e毋须担心。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「揭示之书」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与「夏诺蒂拉」对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e……\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦，旅行者哥哥(姐姐)…我们不是刚刚才见过面吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e什么时候的事？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔，我也说不准耶…毕竟，在这种地方根本不知道时间嘛！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e夏诺蒂拉，跟我走吧。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这里很不正常。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但是，正常与不正常，难道不是我们决定的吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯…我也没有别的意思，但这里对我来说真的很好。这里充满生机与色彩，在那边的世界我从来没见过这样的景象。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我只见到一朵向日葵…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e真的？哇！在什么地方？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e之前我们遇到小狗的地方。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e喔！那我先出发啦！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等等…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e继续追寻\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e战斗\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e继续追寻\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e啊！是旅行者哥哥(姐姐)。咦，派蒙没和你一起吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那个裂隙…你在看什么？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？什么裂隙呀，这不是镜子吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔，这么说来，我确实有在找的东西。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我一直在找「谜镜」的线索…应该是像画一样的东西，和「揭示之书」一样，也能够让人「冥想」。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于四象限与格式塔的「画」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…是喔，原来在那样的地方。嗯！谢谢旅行者哥哥(姐姐)！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e战斗\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往呼救声传来的地方\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是旅行者哥哥（姐姐）！救命…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e战斗\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与夏诺蒂拉对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan\u003e \u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e呜呜…谢谢你，旅行者哥哥(姐姐)…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e发生什么事了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我不知道…我只是想来看看开放的向日葵，还有可爱的小狗…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但在路上，突然出现了一个很可怕的怪物追我。同时，天变得越来越黑…而且有很多不同的声音，说我听不懂的东西…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我害怕极了，就跟着金色的光，一直往前跑。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e每当怪物接近我，整个世界就会变黑一点…花园、宫殿、大树和花朵都不见了，变得好阴暗，只剩下废墟…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e然后，怪物追上我…呜呜…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e已经不用担心了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「小狗」，把她送回去吧。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e小姐，别再来了。这里什么也没有，而外面还有一整个属于你的世界呢。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？你就是小狗吗…但是…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e夏诺蒂拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…我们还能再见面吗？这个世界还能变成美丽的花园吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不会的。再见了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e还有你。我再问你一次，我在你眼里，到底是什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e狗。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯，那就好。你已经赶走了不应该来到这里的人物，多亏了你，这个世界的崩解也停下了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但继续待在这里也是不明智的。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ndofknfbqdfT1713237807598\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e苏醒\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与夏诺蒂拉对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哇！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e派蒙，我…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这次也好快！我还来不及眨眼呢…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…那就好。\u003c/span\u00