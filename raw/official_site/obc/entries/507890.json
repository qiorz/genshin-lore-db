27205780581648845.png\\\" data-entry-name=\\\"精锻用魔矿\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/2e39a9f5b912ec7717a4f77182e8605b_4227205780581648845.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用魔矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/27/80663279/4100e0fd5cef89675b1562e1d2f2622a_8141920577359559776.png\"},{\"tab_name\":\"任务结束地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/27/80663279/9f5eb32392005f3289d011310c032382_612303532417618117.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"ewllh0qqr0dT1711546416025\",\"child_ids\":{\"ewllh0qqr0dT1711546416025\":[]},\"contents\":{\"ewllh0qqr0dT1711546416025\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：欸？那…那边刚才是不是…闪过几个东西？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：一眨眼又没有了，旅行者，我们过去看看吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：唔，帐篷破破烂烂，感觉这个营地已经废弃了很久呢…\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e探查峡谷内部\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：好恐怖的声音…里面发生什么了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：嘿，契诺夫，你还好吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e契诺夫：还拿得动刀…队长。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：肖诺科维奇…菲拉耶夫…你们没事吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e肖诺科维奇：呃啊…我的腿好像断了，万幸我还活着，你计数了吗？我杀了几个了？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e菲拉耶夫：到…到底有多少魔物啊，我们…我们不会要死在这里了吧，队长。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：你个混小子在说啥呢？我们肯定能安全出去的！别担心，斥候肯定已经回城告诉老爷子了，我们的增援已经在路上了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：又来了，这群狂猎真是没完没了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：嘿！拿好你们的武器和灯，我们还有一场硬仗要打呢。\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e清除魔物\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：是执灯人…吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：欸？！旅行者，小心狂猎！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：契诺夫！肖诺科维奇！不！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：小子们，往里走！往里走！快走！\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e继续向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：像是虚影一样出现又消失的执灯士们…他、他们该不会是…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：里面…里面还有声音。要小心啊，旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：菲拉耶夫，别怕，我和帕托利会带你一起出去的。精神点，像个合格的执灯人一样，把剑拿稳了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e菲拉耶夫：我…我…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：有什么计划？能有什么计划，帕托利。如果这就是结局，那我会在这里战斗到底。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：你们是最棒的小队，不论结果会如何，曾与你们一同并肩是我的荣幸。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e菲拉耶夫：……\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e菲拉耶夫：这也是我们的荣幸，队长。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：来吧，准备防守！让这群狗东西见识一下「凛风之马」的厉害！\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e清除魔物\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e？？？：菲拉耶夫！不！帕托利切夫，走！快走！别管我了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：快走！去告诉老爷子这里需要更多的增援！这地方的狂猎数量太多了！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1769567031","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"传说任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"世界任务\\\",\\\"children\\\":[]},{\\\"lab