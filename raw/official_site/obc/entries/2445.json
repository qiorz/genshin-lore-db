ss=\\\"name\\\"\u003e电气水晶\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e1000\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: right\\\"\u003e5[每三日]\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客官，要来些璃月的矿石吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【关于这家店⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e本店是「楚瑜商行」在稻妻开设的分店，主要经营矿石、珠宝玉器的生意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们的货可都是上好的璃月矿石，每一块都是岩王爷的恩赐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然名号不如「解翠行」、「明星斋」那样的老字号响亮，但质量一点都不比他们差！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【生意如何？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还可以，毕竟矿石这个东西不管在哪都有需求嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e⋯只要有需求就有市场，我们璃月商人可不会错过商机！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只是受「锁国令」影响，进货渠道多少还是被影响了⋯唉，真是让人头疼啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【关于岩王帝君⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你是想说岩王帝君的离去么？这件事我已经听说了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e事情发生时稻妻锁国已经开始，我也没能赶上「送仙典仪」⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，这件事令人心痛，没有一个璃月子民不会为此难过⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【我见证了送仙典仪⋯】——获得「坚牢黄玉断片」×1\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，原来您就是传闻中那位协助完成送仙典仪的异国旅者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是失敬。我作为岩王帝君的子民，要好好感谢您才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这份薄礼，还请您不要推辞，一定要收下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【再见。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客官慢走，欢迎再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务 千里之信后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客官，要来些璃月的矿石吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【我想买些矿石。】——打开商店界面\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e来，请在这里挑吧，都是上品！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【附近有什么值得留意的吗？】——有可标记地点\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说起来，最近听说有人在附近看到了一些矿脉，其中有些似乎比普通的矿石成色还要好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过我只是个生意人而已，对采矿什么的其实并不在行，也不方便离开店面。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e位置大概在这里⋯给你标在地图上了。如果你能用得到的话，就去看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【附近有什么值得留意的吗？】——无可标记地点\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔⋯最近的话，还是老样子，从璃月进货的渠道还是很难打通⋯没什么特别的变化\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【关于这家店⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e本店是「楚瑜商行」在稻妻开设的分店，主要经营矿石、珠宝玉器的生意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们的货可都是上好的璃月矿石，每一块都是岩王爷的恩赐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然名号不如「解翠行」、「明星斋」那样的老字号响亮，但质量一点都不比他们差！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【生意如何？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还可以，毕竟矿石这个东西不管在哪都有需求嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e⋯只要有需求就有市场，我们璃月商人可不会错过商机！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只是受「锁国令」影响，进货渠道多少还是被影响了⋯唉，真是让人头疼啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【关于岩王帝君⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你是想说岩王帝君的离去么？这件事我已经听说了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e事情发生时稻妻锁国已经开始，我也没能赶上「送仙典仪」⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，这件事令人心痛，没有一个璃月子民不会为此难过⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【我见证了送仙典仪⋯】——获得「坚牢黄玉断片」×1\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，原来您就是传闻中那位协助完成送仙典仪的异国旅者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是失敬。我作为岩王帝君的子民，要好好感谢您才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这份薄礼，还请您不要推辞，一定要收下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【再见。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客官慢走，欢迎再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成雷电将军传说任务 天下人之章第二幕 须臾百梦后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客官，要来些璃月的矿石吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【我想买些矿石。】——打开商店界面\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e来，请在这里挑吧，都是上品！\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【冒险挑战】——进行七圣召唤对局【牌手五级解锁】\u003c/p\u003e\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e⋯这都让你过了，怎么会⋯等等，让我复盘一下⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么样，我「七圣召唤」的水平可不会输给任何人！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【附近有什么值得留意的吗？】——有可标记地点\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说起来，最近听说有人在附近看到了一些矿脉，其中有些似乎比普通的矿石成色还要好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过我只是个生意人而已，对采矿什么的其实并不在行，也不方便离开店面。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e位置大概在这里⋯给你标在地图上了。如果你能用得到的话，就去看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【附近有什么值得留意的吗？】——无可标记地点\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔⋯最近的话，似乎想要来离岛开店的人越来越多了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然可能会有生意上的竞争，但顾客也随之变多了，总体上算是好事吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【关于这家店⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e本店是「楚瑜商行」在稻妻开设的分店，主要经营矿石、珠宝玉器的生意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们的货可都是上好的璃月矿石，每一块都是岩王爷的恩赐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然名号不如「解翠行」、「明星斋」那样的老字号响亮，但质量一点都不比他们差！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【生意如何？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最近很不错哦，一是因为矿石不管在哪都有需求嘛，只要有需求就有市场，我们璃月商人可不会错过商机！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e另一方面当然是因为商路通畅后，进货的渠道和买家自然也变多了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不瞒你说，等我再多攒些本金，还想去稻妻城开家分店！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在这里应该还没有矿石生意能比得上我家的竞争对手，我可得好好把握机会才是。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【关于岩王帝君⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你是想说岩王帝君的离去么？这件事我已经听说了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e事情发生时稻妻锁国已经开始，我也没能赶上「送仙典仪」⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，这件事令人心痛，没有一个璃月子民不会为此难过⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【我见证了送仙典仪⋯】——获得「坚牢黄玉断片」×1\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，原来您就是传闻中那位协助完成送仙典仪的异国旅者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是失敬。我作为岩王帝君的子民，要好好感谢您才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这份薄礼，还请您不要推辞，一定要收下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【光华容彩祭期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最近总是有人问我知不知道来自璃月的「枕玉」老师在哪，可我完全没听说过这个人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e难道他是什么名人，比七星还要显赫吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊抱歉，客人久等了，请问要来些璃月的矿石吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"【冒险挑战】：独狼刃潭","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"秋月\",\"created_at\":\"2022-12-19\",\"list\":[{\"energy_bg\":0,\"ep_id\":5596,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/19/160491137/a2c5813ae7980ce41f4c06cb768fded9_6089080931134000299.png\",\"life\":6,\"life_bg\":11,\"link\":\"/ys/obc/content/5596/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":0,\"ep_id\":5598,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/19/160491137/8bd90745f54674fb859971710dde6916_523848104558591325.png\",\"life\":6,\"life_bg\":11,\"link\":\"/ys/obc/content/5598/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":0,\"ep_id\":5597,\"im