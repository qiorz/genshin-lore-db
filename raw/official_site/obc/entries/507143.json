ted":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【赫尔穆特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，狂猎的威胁总算解决了，是时候好好休整一下了！自从来到挪德卡莱，我们有多少日子没喝酒了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【埃维德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…还是少喝点吧，赫尔穆特大哥。芙蕾德莉卡队长曾经说过，身为西风骑士，无论何时都应当忠于职责，保持警惕——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【赫尔穆特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，别那么死板嘛！狂猎之主都已经被解决掉了，第五小队甚至已经有人被调回蒙德了，那现在我们的职责就是痛饮庆功酒！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【茜尔雅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呃，第五小队…那算是特例吧？考虑到洛恩副队长的作战风格以及他们小队先前的行动强度，不回蒙德休整反而会更让人担心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【赫尔穆特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那你想想，西蒙枢机卿不也回去了嘛！虽说那是因为\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【埃维德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…像这样随意谈论别人的家事，可是会被马踢的，赫尔穆特大哥。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【赫尔穆特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好好好，不谈不谈，来，喝酒！老板，麻烦再来十杯蜜酒，要大杯！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/