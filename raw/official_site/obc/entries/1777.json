witch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"razmn31nrweT1720164708911\"],\"5trbdrdtt1iT1720164830337\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"5trbdrdtt1iT1720164830337\"],\"nqb471m7nmnT1710863941173\":[],\"razmn31nrweT1720164708911\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【蒙德有什么好地方吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你身上罪孽的气息也有些重了啊…现在对你来说最好的地方可能是忏悔室吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…呵呵，我随口说说的，玩笑而已。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e麻烦下次不要问我这种无聊的问题。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"5trbdrdtt1iT1720164830337\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e需要忏悔的时候可以再来找我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么事，是需要来忏悔的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第三幕 「巨龙与自由之歌」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e自从风魔龙出现之后，来忏悔的人倒是变多了不少，真没想到会有这样的意外收获。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过没关系，就算没有风魔龙，我也有的是办法来让他们「主动」忏悔的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…别放在心上，随口说说罢了，呵呵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"razmn31nrweT1720164708911\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/05/183046623/b26706122e54335e75a99308e473cc62_5353589904437797876.png\",\"option\":\"【我怎么觉得没那么简单…】——获得染血骑士之杯*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，敏锐的人总是不讨人喜欢啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有些人出生在阳光之下，便觉得那些光明和温暖都是理所应当。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然而爱、虔诚与神圣，一切的美好都是构筑在罪人的血泪之上的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你们究竟是看不到，还是说故意不想去看到呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e既然如此，便不要多问，不要多想，罪孽找上门时，审判自然也会接踵而至。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我说的这些，你就当做是一个忠告吧。还有这个东西你也可以收下，愿它能够一直警示你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1637\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/05/183046623/396fc4d12405894c039590858dbf48bf_4033733709729134115.PNG\\\" data-entry-name=\\\"染血骑士之杯\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/1637/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/1637/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/05/183046623/396fc4d12405894c039590858dbf48bf_4033733709729134115.PNG\\\"\u003e\u003cspan class=\\\"name\\\"\u003e染血骑士之杯\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【你在做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是维多利亚，教会的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我聆听人们的忏悔，并在必要的时候加以引导。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e各种各样的，有益于灵魂的…引导。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"list\":null,\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693735","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hove