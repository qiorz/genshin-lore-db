3cp\u003e是哦，真是不好意思。堂吃的话麻烦至少提前三个月来预订位置，我会好好登记的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e欸…三个月很长吗？我们「琉璃亭」一天只在固定时间招待几桌客人，所以要排很久啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且，能在「璃菜的天堂」享用最地道的璃菜，三个月的等待又算得了什么呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来「琉璃亭」的都是真正喜欢山珍料理的璃菜粉丝！即便是达官贵人也不能插队的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽说打包也可以啦，但吃饭重要的是氛围！氛围呀~！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1783588084","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{