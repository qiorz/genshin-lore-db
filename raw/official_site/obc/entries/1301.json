-upload.mihoyo.com/ys-obc/2023/10/27/12233500/e4a82f15ee4fe4912ac01b83b2ff76cb_8268460340251489008.png\",\"life\":4,\"life_bg\":11,\"link\":\"/ys/obc/content/6634/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":0,\"ep_id\":5592,\"img\":\"https://act-upload.mihoyo.com/ys-obc/2023/10/27/12233500/ba55e6e19d419b16ec763dfcfb655834_246011204530670342.png\",\"life\":3,\"life_bg\":11,\"link\":\"/ys/obc/content/5592/detail?bbs_presentation_style=no_header\"},{\"energy_bg\":0,\"ep_id\":5604,\"img\":\"https://act-upload.mihoyo.com/ys-obc/2023/10/27/12233500/cbb167fdd9ba03585d0cbbbbdf40ed91_6163163366986407279.png\",\"life\":4,\"life_bg\":11,\"link\":\"/ys/obc/content/5604/detail?bbs_presentation_style=no_header\"}]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"挑战目标or特殊规则","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: start; line-height: 1.4;\\\"\u003e\u003cstrong\u003e挑战目标：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; line-height: 1.4;\\\"\u003e赢得胜利——210【牌手经验】，250【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; line-height: 1.4;\\\"\u003e6回合内胜利——500【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; line-height: 1.4;\\\"\u003e引发2次「元素反应」——500【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: start; line-height: 1.4;\\\"\u003e\u003cstrong\u003e特殊规则：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; line-height: 1.4;\\\"\u003e我方「切换角色」行动少花费1个元素骰（每回合2次）；我方进行「下落攻击」时，造成的伤害+2。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e世界任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"672\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/04/317305234/41a53cbf3d3742b30dd4261689b9e6fc_4390028018678878489.png\\\" data-entry-name=\\\"大生意\\\" data-entry-link=\\\"/ys/obc/content/672/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/672/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大生意\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【先算了，再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什、什么叫先算了。我是清白的啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e下次看到我在蒙德进货你们就相信我了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e找我有什么事情吗？如你所见，我就是个蒙德来的商人，做酒业生意的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…干、干什么用这种眼神看着我？我说的可是实话…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"f7jrejvekfT1783591539495\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看来璃月这边也和蒙德一样，出现奇怪的陨石了呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有什么事吗？我不过是个从蒙德来的商人，做酒业生意的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ip1b6tvpjmqT1783591412647\":{\"option\":\"【越看越可疑…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎、怎么能这么说。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那，我来告诉你一个只有在酒行才知道的秘密吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「天使的馈赠」其实说的是「天使的一份」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也就是酿酒时，被空气带走的一部分。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么样，学习到了吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"kjhxjyqhoymT1783591411792\":{\"option\":\"【有些可疑啊…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，离开蒙德太久了会这样的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我可是这里老熟人了，这条商道跑了好多年了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e掌柜和老板娘，他们都可以给我担保的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是不是啊，淮安、戈黛特，啊哈哈哈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你们别不说话啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e失算了失算了，下次我不会如此失态！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢了！你的牌艺启发了我，让我明白了接下来该怎么去和棘手的家伙博弈…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ypenvfkx74hT1783591593478\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【请问你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我叫兰达，做酒业生意的。那边跑来跑去的是我的女儿，蒂雅。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你知道，蒙德的酒要流通到璃月才能卖给全大陆。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明曦酒庄你知道吗？就是从那里来的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，对对，晨曦晨曦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zi6qj22mrcT1783591503150\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「未归的熄星」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"zi6qj22mrcT1783591503150\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"f7jrejvekfT1783591539495\":[\"ypenvfkx74hT1783591593478\"],\"ip1b6tvpjmqT1783591412647\":[\"zi6qj22mrcT1783591503150\"],\"kjhxjyqhoymT1783591411792\":[\"zi6qj22mrcT1783591503150\"],\"nqb471m7nmnT1710863941173\":[\"zi6qj22mrcT1783591503150\"],\"ypenvfkx74hT1783591593478\":[],\"z2tn3pzsbujT1710863943430\":[\"kjhxjyqhoymT1783591411792\",\"ip1b6tvpjmqT1783591412647\"],\"zi6qj22mrcT1783591503150\":[\"f7jrejvekfT1783591539495\"]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":