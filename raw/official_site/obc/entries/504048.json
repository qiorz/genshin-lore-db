dule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，愿智慧让你免入歧途。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊，欢迎光临「伊杜坎的秘藏」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e各种饭菜吃多了才知道什么好吃，所以不管什么样式的书都应该多读读！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/05/288180982/11ee64c710e3b091256c0d349ac55461_1450205279481760013.png\",\"option\":\"【想要浏览商品…】——打开商店界面\"},\"vtpemysz8hT1736068631133\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对对，是这样的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e暝视龙大长老的全名意为「拥有烟雾色利爪的他」，我的名字「阿马佐利」意为「古老的书籍」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以你看，我现在就在这里，开着一家书店。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像萨满们从梦中窥探命运的一角，一切都有迹可循。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【名字的意义很重要。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「伊杜坎」…真是个好名字。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是我从某本神话书籍里读到的，具体什么内容有些记不得了…但印象中名字的主人是十分智慧的人物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e智慧有很多种形式，纸质的，布织的，甚至口口相传的语言，皆在其内。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这就是为什么我会给自己店起名叫「伊杜坎的秘藏」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于「伊杜坎的秘藏」…】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"vtpemysz8hT1736068631133\":[],\"z2tn3pzsbujT1710863943430\":[\"vtpemysz8hT1736068631133\"]}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1745070384","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden