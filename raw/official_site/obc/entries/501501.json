3cli\u003e\u003cp\u003e4.3：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7670\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/19/4521515/fce901e7099702d841445454c59c4e6d_3744961927135263850.png\\\" data-entry-name=\\\"蔷薇与铳枪\\\" data-entry-link=\\\"/ys/obc/content/7670/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/7670/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e蔷薇与铳枪\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500557\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/03/317305234/9c351ebd1c21968046d854aaa3e6f8a3_2262911364444097931.png\\\" data-entry-name=\\\"景框内外的虚实\\\" data-entry-link=\\\"/ys/obc/content/500557/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/500557/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e景框内外的虚实\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有空再来玩啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7fjezg3224dT1719339183734\":{\"option\":\"【枫丹还有企鹅？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…你这样问，我倒是有点说不准了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一般来说，企鹅生活在寒冷的北方，不过也听说其中一些会在气候炎热的地带出没。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e店里的发条企鹅不是我做的，都是一个叫菲米尼的小伙子寄售在这的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他的手艺很不错，让我想起小时候的弟弟…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我曾想邀请菲米尼先生来这里专职研发发条玩具，不过看他一副沉默寡言的样子，还是不强求了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，莱舒的发条工坊就在这里。你是来选购发条工艺品的吗？还有许多有趣的玩具哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【发条工艺品？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没错，本店的特色机械装置，依靠发条进行驱动。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e小到玩具鸟，大到发条人偶，应有尽有。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e个个性能优秀、款式新颖，呃…就是发条人偶的对话听多了可能可能稍微会有点吵。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你对发条动物感兴趣吗？店里有奔驰的发条马、会吹喇叭的发条膨膨兽，还有会原地摇摆的发条企鹅。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"7fjezg3224dT1719339183734\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[\"7fjezg3224dT1719339183734\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1722502787","langs":[],"template_layout":{"tab":[{"tab_id