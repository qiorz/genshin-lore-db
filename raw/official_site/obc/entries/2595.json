lpjkz7diuT1741812289822\":{\"option\":\"【你们还在拍「映影」吗？】\",\"dialogue\":\"\u003cp\u003e【泽维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…是您啊！我亲爱的男（女）一号！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我正在和这位士兵先生讨论下一部「映影」拍什么好呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想要去记录一下狸猫和狐狸的传说，而这位士兵先生嘛…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【虎之助】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我则更推荐泽维尔先生去城里，记录一下武士们真正的威武姿态。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【你们讨论出结果了吗？】\u003c/p\u003e\u003cp\u003e【泽维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e喔，这个嘛…在我俩进行了充分的讨论之后，总算还是达成了共识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那就是…拍一部两者皆有的「映影」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我现在想的故事，大概就是一位武士在很久很久之前的稻妻斩妖除魔的故事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然啦，里面还要填充一些其他元素，比如爱情或者喜剧元素…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是，这也只是一个初步的想法，我还得再搜集一些素材才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e【虎之助】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e泽维尔先生，我们还要接着拍下去吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【泽维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那是当然！还有很多题材在等着我去尝试！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"vms3jiwxx1T1741812312756\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e【活动「剪影辑帧」期间完成「映影制作札记」后】\u003c/p\u003e\",\"icon\":\"\"},\"vy9wo8kbx7rT1784392921249\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"y6y2vsyeulT1741812290303\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cp\u003e【泽维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e喔，再见，我亲爱的男（女）一号，祝您好运！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1784506442","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","su