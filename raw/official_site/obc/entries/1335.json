er\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"077g5w8qp7i9T1730787477622\":[],\"71gp07epz18T1730787447415\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"brddsw50kh7T1730787496318\":[],\"hoomdbfgy0dT1730787420167\":[],\"nqb471m7nmnT1710863941173\":[\"y7gf08cvuqT1730787418983\",\"hoomdbfgy0dT1730787420167\",\"71gp07epz18T1730787447415\",\"077g5w8qp7i9T1730787477622\",\"brddsw50kh7T1730787496318\",\"t31w3o8b49T1730787507790\"],\"t31w3o8b49T1730787507790\":[],\"y7gf08cvuqT1730787418983\":[]},\"contents\":{\"077g5w8qp7i9T1730787477622\":{\"option\":\"【我也没办法…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，怎么能说没办法呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e妈妈说，只要爱着这个世界，就不会有小动物怕你的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不然，鸽子为什么不怕我呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"71gp07epz18T1730787447415\":{\"option\":\"【关于龙灾…】——完成魔神任务 序章第一幕后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我在想，风魔龙…会不会是鸽子变的呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就是因为你们老吓它们，所以它们变成了龙，回来报复人类！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e它一定不会伤害像我这样善待它们的人，一定是这样的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 序章第三幕「巨龙与自由之歌」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"brddsw50kh7T1730787496318\":{\"option\":\"【还会飞回来的。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一般来说是这样的…但万一有一天就不回来了呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像爸爸那样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hoomdbfgy0dT1730787420167\":{\"option\":\"【决斗对局】——进行七圣召唤对局【牌手十级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…输掉了…鸽子也飞走了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好欸！是我赢…咦，周围的鸽子呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/05/178964736/cc2a44c2e85425afbbd461e49fe0875d_3240803732016741472.png\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你、你干嘛！鸽子都吓跑了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"t31w3o8b49T1730787507790\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…我要去告诉妈妈！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"y7gf08cvuqT1730787418983\":{\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手一级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…怎么会输掉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我赢啦！嘿嘿嘿！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/05/178964736/cc2a44c2e85425afbbd461e49fe0875d_7304051310511975917.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":