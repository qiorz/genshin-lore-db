372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e寝子：不过奴家还记得封印那几块石头的方法，要封印的话…唔…瞄瞄…\u003c/p\u003e\u003cp\u003e    阿响说,关键是要用石头上的绳子，还有上面的纸…\u003c/p\u003e\u003cp\u003e           \u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e要把边上的棍子的纸,变成和石头的纸一样…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e解密的方法是先数一下三根棍子上的纸条数，转动镇石上下两层，使得对应棍子的三个方向上的上下层纸条数之和等于棍子上的纸条数。建议先保证与其中一根棍子的纸条数相等的情况下进行枚举，详细方法请参考下方攻略链接：\u003c/p\u003e\u003cp\u003e玩家攻略推荐：\u003cbr\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/9093146\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e【V2.1攻略】#探索解谜#【稻妻大型任务其5】清籁逐雷记\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\\t作者：\u003c/strong\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003eDramaturge\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"清籁逐雷记 · 其二","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"list\":[{\"key\":\"触发条件\",\"value\":[\"完成【清籁逐雷记 · 其一】\"]},{\"key\":\"等级限制\",\"value\":[\"冒险等阶达到30级（开启稻妻区域）\"]},{\"key\":\"特殊限制\",\"value\":[\"完成第二章 第一幕「不动鸣神，恒常乐土」才能解锁清籁岛区域\"]}]}","style":""}],"id":"1607","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1367","without_border":false,"can_delete":false,"is_hidden":false,"