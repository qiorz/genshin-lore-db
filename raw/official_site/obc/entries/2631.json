-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/31/76078930/2aeb2f82fe238f894cf7aa3c634d227e_4949368539411951569.png\\\" data-entry-name=\\\"大佑\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/31/76078930/2aeb2f82fe238f894cf7aa3c634d227e_4949368539411951569.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大佑\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e清籁岛\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2631\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/06/380453694/4751f1b480da9c872bd22d12f744eb58_308730757445567355.png\\\" data-entry-name=\\\"清籁逐雷记 · 其二\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/2631/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/2631/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/06/380453694/4751f1b480da9c872bd22d12f744eb58_308730757445567355.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e清籁逐雷记 · 其二\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e从稻妻冒险家协会的凯瑟琳小姐那里，你得知稻妻冒险家协会最近正在招募冒险家前往清籁岛进行探索…\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e前往冒险家协会\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e寻找清籁岛上的冒险家\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e前往调查「镇石」\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e循着猫的足迹向前探索\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e探索神社\u003c/p\u003e\u003cp\u003e来到清籁岛后,你遇见了两位冒险家，他们似乎正在研究一种叫做「镇石」的东西。但跟随着猫的足迹，你来到了一座破败的神社,里面有一只自称「浅濑神社代宫司」,名叫「寝子」的猫,它说只要你愿意帮它的忙，它就可以告诉你封印「镇石」的方法…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e查看「塞钱箱」的情况\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e前往村子，搜集维修用材料\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e打倒所有盗宝团\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与盗宝团对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e前往盗宝团营地\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e回到浅濑神社，维修「塞钱箱」\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e向寝子回报\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e封印「镇石」（具体方法请参考下方攻略推荐）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与大佑对话\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/22/78524498/6ee632dc08f8146408597e4b9001fa98_2448574155246290566.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"300\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=