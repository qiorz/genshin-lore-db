客\\\" data-entry-link=\\\"/ys/obc/content/501133/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/501133/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e璃月来客\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2bkey1g2w5iT1719469970571\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"aq7xhzqorn4T1719469993730\":[],\"cojfk2rgdk6T1719469981392\":[],\"nqb471m7nmnT1710863941173\":[\"p48v6ts6xb8T1719469957942\",\"aq7xhzqorn4T1719469993730\"],\"p48v6ts6xb8T1719469957942\":[\"2bkey1g2w5iT1719469970571\",\"cojfk2rgdk6T1719469981392\"]},\"contents\":{\"2bkey1g2w5iT1719469970571\":{\"option\":\"【我怎么感觉挺温馨的…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e扯什么呢，那小冥可是鬼啊，鬼还不够吓人吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是的，搞不清你的思路…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走不送，想听故事的话，就尽管来找我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，年轻人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"aq7xhzqorn4T1719469993730\":{\"option\":\"【还是不了…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼…我还以为你的胆子会比那群小鬼头大多少呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e也罢，也罢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cojfk2rgdk6T1719469981392\":{\"option\":\"【有被吓到。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿…这可是我最得意的鬼故事，还没失过手呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最重要是…这故事它是真的…嘿嘿嘿…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你是…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵…庄里的小鬼头都叫我鬼伯伯，因为我有讲不完的鬼故事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么，你也要听故事吗？要听的话可要站稳了，别腿一软吓趴下了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"p48v6ts6xb8T1719469957942\":{\"option\":\"【好啊。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有个叫小冥的小姑娘，生得娇巧可爱，就是运气不太好，害了一场大病就早夭了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e她的妈妈天天以泪洗面，足不出户，受不了这样的打击。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可突然有一天家里出现了敲门声…咚，咚，咚…妈妈被吓坏了，小心翼翼地推开门一看…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是一碗热乎乎的肉汤和一大盘煮熟的肉，却不见着半个人影…小冥的妈妈疑惑不解，便循着香喷喷的味道一路找了过去…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e结果误打误撞碰上一处丘丘人营地！丘丘人们立马将她团团围住，吓得她赶忙捂上了双眼…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可半晌过去，却只听到「哒哒…哒哒…」的响声…妈妈慢慢把手拿开，看到的是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e丘丘人们正跳着小冥生前最喜欢的那支舞呐！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这时她的背后突然被什么轻轻撞了一下，却什么也看不到，只闻到一股香香甜甜而又熟悉的气味…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e妈妈落下了眼泪，原来死后的小冥并不孤单，她交上了一群可爱的朋友啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"list\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1722500827","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",