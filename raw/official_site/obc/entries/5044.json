origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"j231o3jv47fT1783065294238\"],\"j231o3jv47fT1783065294238\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【拉希德是什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e拉希德？拉希德就是正确的指引，正确的指引就是拉希德！这是我家乡那边的含义，也是我的名字哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我相信万物都有拉希德，比如我的就是钓鱼，鱼的就是被我钓。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嘻嘻，你找到自己的拉希德了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来钓鱼就是我的拉希德。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"j231o3jv47fT1783065294238\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，祝你早日找到自己的拉希德。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我需要一些钓鱼用品。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e随便挑吧！价格都很便宜，放心，我赚钱的地方可不在这里，嘻嘻。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/03/288180982/1b764ab0418774d3f6ebf1bf4b1bd200_3503046936121170820.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是鲁梅拉·阿提夫·艾布·拉希德，须弥的渔师。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e别看我很擅长钓鱼，告诉你，我可是出生在沙漠的家伙哦。沙漠虽然有绿洲，但里面几乎没有鱼，我小时候都不知道鱼是什么东西。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e直到后面来了港里，才发现我居然这么擅长钓鱼，干这行，我一年能挣人家三年的钱呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e照这个速度，要不了多久，我就可以把爸爸妈妈接来一起生活了，哈哈，原来这就是我的拉希德。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1783069089","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1"