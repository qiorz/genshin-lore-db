=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1584\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/09/76373921/c936520994ef0dc05e64267c629bd588_8433549590102860932.png\\\" data-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（轻策庄的霄灯）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"b34rzrpoglT1746429656353\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"b34rzrpoglT1746429656353\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，祝你也能像我爸爸那么厉害，嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，看你的样子是旅行者对吧？！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"b34rzrpoglT1746429656353\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢！你是庄里为数不多会鼓励我的人呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e庄里的大人说我一定不会成为爸爸那样的大英雄的，因为我不爱喝牛奶…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…谁说成为大英雄就一定要喝牛奶的…那个味道实在是太奇怪了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可是全倒掉的话又有些可惜…要不然，你拿走吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嘘，不要和别人说啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"786\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/09/8912764/3b66e7e92fdc25670bcf33561152fc90_2978093864944691298.png\\\" data-entry-name=\\\"牛奶\\\" data-entry-amount=\\\"7\\\" data-entry-link=\\\"/ys/obc/content/786/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/786/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/09/8912764/3b66e7e92fdc25670bcf33561152fc90_2978093864944691298.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e牛奶\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*7\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/b26706122e54335e75a99308e473cc62_8354796743797705744.png\",\"option\":\"【加油，祝你成功。】——获得牛奶*7\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好厉害，根本打不过你…请你别把打赢我的事告诉别人啊，尤其是南十字船队的船员！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我打赢了庄外的人！爸爸要是知道了，一定会夸我厉害的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/cc2a44c2e85425afbbd461e49fe0875d_1163416275057811485.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哇呜，好厉害！那你肯定去过很多地方，见识过很多了不起的事情吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我爸爸他是南十字船队的船员，和伙伴一起游历各国，每天都在冒险，是个大英雄！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然他很少回家，但他每次都会写信把路上最刺激的事告诉我，嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e再过几年，我也要去南十字船队，到时候我就能亲眼见识那些厉害的东西啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是的。】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746430524","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"p