e":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e部族纪闻：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502872\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/07/82503813/108ca6d405137a812f2379336a17888c_1526017220817841425.png\\\" data-entry-name=\\\"流泉所归之处 第三幕 「神秘岛之旅」\\\" data-entry-link=\\\"/ys/obc/content/502872/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502872/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e流泉所归之处 第三幕 「神秘岛之旅」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"10swmi9dy98oT1735472403711\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"10swmi9dy98oT1735472403711\",\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\",\"twunkk49l3nT1725026720363\"],\"nqb471m7nmnT1710863941173\":[],\"twunkk49l3nT1725026720363\":[]},\"contents\":{\"10swmi9dy98oT1735472403711\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，那要看客人的天赋如何了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/12/29/288180982/fe6e04050bfdac710fcdc6a61fa828a5_1849531875722357842.png\",\"option\":\"【有什么适合我的吗？】——打开商店界面\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，你听到了？让你见笑了，我说的是那些烟谜主的老伙计们。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他们部族办的一些活动上需要演奏和唱歌，我常被请去弹琴。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过每次都是我千里迢迢赶去他们那里，他们也不说过来看看我！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，算了，那些老家伙们就是这样啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e除非专门写信请他们出门，不然休想让他们挪动半步——我才不要呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【老家伙们是指…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临，要试试乐器吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"dm70kjmed0kT1714916229036\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e吃虎鱼，腌笃鲜，蟹黄豆腐…都是须弥难得一见的美食。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【比如…】\"},\"ij7rvkv4u6T1714203722640\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…没有。那些蛮族个个奸诈狡猾，很少会在没有把握的情况下直接露面…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你见过那些蛮族吗？】\"},\"kibg0yo5n5T1714916271695\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都在我的待品尝名单里。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e上次博言那家伙说「沉玉仙茗」滋味上佳，忽悠我进了一大批货，全砸在手里，气死我了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他又说，只是那一批茶叶有问题，现在水土治理好了，茶叶的品质也回来了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谁知道他的话是真是假？上过的当，吃过的亏，我扎娅才不会跌倒第二次。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我要亲自去璃月走走，用我的舌头把美味带回来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这些你都吃过吗？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是「金贝乐棚」的老板，卖一些老乐器。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有不少在科隆切广场看完乐团表演的游客跑过来买乐器，我都会让他们先试一试， 等第二天再来买。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好多年轻人啊，容易被氛围感染，一时冲动买了乐器回家，就再没弹过了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里的乐器我多少都有些感情，不想让它们被冷落啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以我会给客人们一个冷静下来的机会。等想好了，再来买也不迟。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e反正这家店一直在这里，哪也不会去；而且，单纯地享受音乐就已经很好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"},\"twunkk49l3nT1725026720363\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【先不用了。】\"},\"vtqh1ivl2dcT1714203601353\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，公民！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"ypqzksbnb9hT1714203822568\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈？保护这座城市的城墙，我们现在不就在城墙里面吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，我知道了,你这是在考我呢…当然，就像波爱修斯大人曾经说过的那样，「伟大的军团才是帝国真正的城墙」！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【城墙？哪来的城墙？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e拜达港和枫丹太近了，大家对枫丹的新鲜玩意已经见怪不怪了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可他们对璃月还知之甚少啊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e商人的嗅觉不会出错，嗯，如果把璃月美食引进拜达港，比如…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【什么商机？】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1735718552","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"paren