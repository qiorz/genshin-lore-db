{"retcode":0,"message":"OK","data":{"page":{"id":"502232","name":"安切塔【「金贝乐棚」店主】","desc":"安切塔【「金贝乐棚」店主】","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/30/1694811/6e31f36203d2b991b445a9e75e70327d_7940747843557603165.png","header_img_url":"","modules":[{"name":"安切塔","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"key\":\"编者注\",\"value\":[\"\u003cp\u003e买回家吃灰的东西可太多了\u003c/p\u003e\"]}],\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/30/1694811/88600a86d34241bb2339f9660149831f_8226979304049581766.png\",\"attr\":[{\"key\":\"性别\",\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"]},{\"key\":\"位置\",\"value\":[\"\u003cp\u003e「流泉之众」\u003c/p\u003e\"]},{\"key\":\"职业\",\"value\":[\"\u003cp\u003e「金贝乐棚」店主\u003c/p\u003e\"]},{\"key\":\"功能\",\"value\":[\"\u003cp\u003e商店\u003c/p\u003e\"]}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/30/1694811/f9f17e86b8b4a5c150e9cda88ca40160_842884382544125739.png\"},{\"tab_name\":\"位置\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/30/1694811/83550f65045e5d4f4f3db03f0e5d3675_3483270426869395451.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\