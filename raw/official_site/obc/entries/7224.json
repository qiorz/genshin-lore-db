3e\u003cli\u003e\u003cp\u003e你就说答不答应嘛…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【勒莫迪埃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…很有难度。你看，我现在的年龄是你的两倍。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那等你成年时我已经是开始掉头发的中年人了，没办法和你搭档咯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【柯蕾特莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就不能变个魔术让你不再长大吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【勒莫迪埃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e亲爱的小妹，魔术可不是魔法啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746508246","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_gro