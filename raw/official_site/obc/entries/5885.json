"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"天赋牌\",\"layout_\":\"banner\",\"list\":[{\"tab_name\":\"砰砰礼物\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/0cca153cadfef3f9ccfd37fd2b306b61_3474099874593550270.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为\u003cstrong\u003e可莉\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e可莉装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e蹦蹦炸弹\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;蹦蹦炸弹：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素战技\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成3点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;火元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，本角色附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;爆裂火花\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;爆裂火花\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;所附属角色进行\u0026lt;u\u0026gt;重击\u0026lt;/u\u0026gt;时：\u0026lt;/strong\u0026gt;少花费1个\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;火元素\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，并且伤害+1。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;：1\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;重击：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方行动开始前，如果元素骰总数为偶数，则进行的「普通攻击」将被视为「重击」。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;火元素：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;花费投出了\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;火元素\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;的元素骰，来支付此费用。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;（万能元素也可以支付此费用。）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e装备有此牌的可莉生成的\u003cstrong\u003e\u003cu\u003e爆裂火花\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;爆裂火花：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;所附属角色进行\u0026lt;u\u0026gt;重击\u0026lt;/u\u0026gt;时：\u0026lt;/strong\u0026gt;少花费1个\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;火元素\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，并且伤害+1。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;：1\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;重击：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方行动开始前，如果元素骰总数为偶数，则进行的「普通攻击」将被视为「重击」。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;火元素：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;花费投出了\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;火元素\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;的元素骰，来支付此费用。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;（万能元素也可以支付此费用。）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e的\u003cstrong\u003e\u003cu\u003e可用次数\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e+1。\u003c/p\u003e\u003cp\u003e（牌组中包含可莉，才能加入牌组）\u003c/p\u003e\"]},\"tab_id\":\"1759479143814_0\"}],\"baseInfoSwitchDisabled\":false,\"repeated\":true}","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038052","langs":[],"template_layout":{"tab":[{"tab_id":"49","tab_name":"七圣召唤","module_group":[{"module_group_id":"87","layout":"l1r1","module":[{"id":"131","pos":"left"},{"id":"132","pos":"right"},{"id":"133","pos":"left"},{"id":"134","pos":"left"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"2630","layout":"l2r1","module":[{"id":"8551","pos":"banner"},{"id":"8550","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]},{"tab_id":"445","tab_name":"自行巧局","module_group":[{"module_group_id":"2158","layout":"l1r1","module":[{"id":"6537","pos":"banner"},{"id":"6496","pos":"left"},{"id":"6497","pos":"right"},{"id":"6498","pos":"left"}],"name":"自行巧局","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"233","name":"角色牌","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"角色牌","is_hidden":fals