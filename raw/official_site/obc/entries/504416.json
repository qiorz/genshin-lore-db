an class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e灼燃的燧原矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e800\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"created_at\":\"\",\"list\":[],\"author\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"0sy2sohk2grT1737040204136\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢，哦，我是说，慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【一切都好。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有答案之前先得有问题吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说实话，我经常在想出一个值得思考的问题之前，思维就已经跑向很远了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e严格来说这其实违背了冥想的目的，这可能就是为什么我在当守卫而不是首领了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也没什么不好的，烟谜主里永远不缺神神叨叨的人，重要的事务就交给他们吧，我只要做好我的工作就好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想出什么答案了吗？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好。…抱歉，我刚刚在冥想，没有错过什么吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你的协助，愿你永不迷失在烟尘之中。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/16/288180982/60e98896f16b1e2f98bb1952b677ae4f_7562540192533907731.png\",\"option\":\"【关于我在「烟谜主」的声望…】——打开声望界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，这个，叫「曜石图腾柱」。因为黑曜石在纳塔十分常见，所以一般简称为「图腾柱」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我知道你在想什么，我也觉得这之间没有什么必要的因果关系，但上一任守卫是这样告诉我的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当时作为新人守卫的我，虽然心里也有疑问，但最终还是没有开口提出。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在想来这应该是什么内部笑话吧…当然，并不好笑。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，我也会把它讲给未来的接班人的。看看这没意义的东西究竟能传承多久。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，这里是…】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0sy2sohk2grT1737040204136\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"0sy2sohk2grT1737040204136\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"「话事处」的赠礼","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e达成数量\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"703\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e奖励内容\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e功能开启\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1