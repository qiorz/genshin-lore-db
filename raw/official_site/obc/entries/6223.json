e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"dnl6ifn8ja6T1745642277348\"],\"dnl6ifn8ja6T1745642277348\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这里的图书管理员，负责处理借阅申请和书籍整理等工作。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我家世世代代都在教令院担任与书相关的职务，我从小就喜欢新书散发的油墨味道，图书管理员是我梦寐以求的工作呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过在入职了之后我才发现，这份工作比我想象的要简单许多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很多在智慧宫逗留的人并不是为了借书，而只是想找个安静的环境思考问题罢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以需要我处理的事情很少，基本就是整理整理书架而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，是来智慧宫借书的吗？请出示在教令院就职或就读的凭证。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"dnl6ifn8ja6T1745642277348\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e智慧宫是教令院的藏书阁，学者或学生可以在这里借阅部分通识书籍。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有不少藏书仅对高级学者开放，作为文献凭证使用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毕竟大部分的知识都能通过虚空获取，很多人阅读书籍仅仅是想亲眼见证知识的来源罢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以虽然大家都说智慧宫就是须弥的图书馆，但我倒觉得这里更像是博物馆呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于智慧宫…】——完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」前\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e智慧宫是教令院的藏书阁，学者或学生可以在这里借阅部分通识书籍。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有不少藏书仅对高级学者开放，作为文献凭证使用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为以前大部分的知识都能通过虚空获取，所以很多人阅读书籍仅仅是想亲眼见证知识的来源罢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一直以来，与其说智慧宫是须弥的图书馆，倒不如说更像是博物馆呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过在虚空关闭之后，关于拓宽智慧宫使用权限的申请越来越多了，书记官大人应该已经在处理此事了吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我想今后喜欢捧着书读的人也会越来越多的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于智慧宫…】——完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」后\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1781575301","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout