\\"504692\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/03/12/4521515/577dc4c59a2da726e6a8a35526bf7729_7883882257036420933.png\\\" data-entry-name=\\\"游逸旅闻·诗汇之章\\\" data-entry-link=\\\"/ys/obc/content/504692/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504692/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e游逸旅闻·诗汇之章\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"7nqnj8wm5j3T1747464363121\":[\"uun4456s5iT1747464714019\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"8t8dxtgntkT1747464506240\":[\"uun4456s5iT1747464714019\"],\"mghwy7d1xj8T1747464317609\":[\"7nqnj8wm5j3T1747464363121\",\"yl9xfhz68rT1747464363953\",\"ns16wr6nklhT1747464364617\"],\"nqb471m7nmnT1710863941173\":[\"mghwy7d1xj8T1747464317609\"],\"ns16wr6nklhT1747464364617\":[\"uun4456s5iT1747464714019\"],\"qnhc5ury4djT1747464505312\":[\"uun4456s5iT1747464714019\"],\"uun4456s5iT1747464714019\":[],\"yl9xfhz68rT1747464363953\":[\"qnhc5ury4djT1747464505312\",\"8t8dxtgntkT1747464506240\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7nqnj8wm5j3T1747464363121\":{\"option\":\"【您是在赏花？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，这花一代又一代，花谢又花开，生生不息，就和璃月一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看这边，还有这边，又新开了好几朵花…看来今年是个好年，一定会有好事发生的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…这年头，愿意沉下心赏花的年轻人可不算多呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8t8dxtgntkT1747464506240\":{\"option\":\"【这花真是漂亮。】——获得琉璃百合*5\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，应该说多亏了如今的太平盛世。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其实我一直希望，有朝一日这花能再次遍布璃月大地，希望它们不会再次销声匿迹…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过在此之前，希望你能带上一些这玉京台的花儿，让它们先见见外面的世界吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"756\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/70e9deaddfc2f39a71b8f4257001bc78_4247746153843528709.png\\\" data-entry-name=\\\"琉璃百合\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/756/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/756/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/70e9deaddfc2f39a71b8f4257001bc78_4247746153843528709.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e琉璃百合\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/17/178964736/b26706122e54335e75a99308e473cc62_1791683474327978408.png\"},\"mghwy7d1xj8T1747464317609\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？是你啊，孩子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e花开花谢。人去人归，我就知道你会回来看我的，呵呵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务 第一章第二幕「辞行久远之躯」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"ns16wr6nklhT1747464364617\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，年轻人。如果你恰好路过绝云间的话，请代我向老朋友们问候一声。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有缘你自会见到他们。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"qnhc5ury4djT1747464505312\":{\"option\":\"【关于过去。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，你是在暗示我老朽不堪了吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不用道歉，我只是说笑而已…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e年纪大了，闲时多了，过往的事情也便越来越历历在目了…也不知山里的老朋友们，如今过得如何了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看着璃月港当今的繁华，会不会也想来凡人的烟火世界体验一下呢…？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不好意思，自言自语了一些莫名其妙的话。关于我的过去…还是有缘再讲吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"uun4456s5iT1747464714019\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"yl9xfhz68rT1747464363953\":{\"option\":\"【这是什么花？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这是「琉璃百合」，璃月港最后的琉璃百合应该都在这里了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e人们说这种花能聆听人们的歌声，美丽的音乐对于它有如养分一般…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而厮杀、诅咒与破坏的声音对它们而言则如鸩毒，会腐蚀它们的根系。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以…在千年前的纷争之中，它们在璃月大地上销声匿迹了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1747621567","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute