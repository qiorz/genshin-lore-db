h\":false,\"without_border\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/29/317305234/f74ee3aac8da92095f3d0549375f7177_293516293945307272.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e•等待到两天后\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e•前往千灵映影节会场\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e自那之后又过了一阵子⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e影片顺利上映，铳枪杀人事件也正式结案⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e派蒙：泽维尔！有一段时间没见到你了！\u003c/p\u003e\u003cp\u003e泽维尔：两位好，这不是，剪辑完成之后，我又开始着手于宣传与放映的工作了，实在忙不过来。\u003c/p\u003e\u003cp\u003e派蒙：今天就是颁奖的日子了吧？也不知道我们的映影能不能夺得「芙宁娜奖」。\u003c/p\u003e\u003cp\u003e芙宁娜：我倒是有九成的把握。\u003c/p\u003e\u003cp\u003e派蒙：芙宁娜！原来你已经到现场了呀，来得比其他人都早呢！\u003c/p\u003e\u003cp\u003e芙宁娜：其他人应该也很快就到。对了，泽维尔，说到领奖，你是不是该为我们的团队起个名字呀？\u003c/p\u003e\u003cp\u003e泽维尔：啊？可我还不知道能不能得奖⋯我、我可不敢做这种提前打开美酒的事啊⋯\u003c/p\u003e\u003cp\u003e芙宁娜：睁大眼睛，看看人们离开剧场的反应吧！没有一个不叫好的。\u003c/p\u003e\u003cp\u003e芙宁娜：你自己也知道吧？剧场的工作人员一定找过你，说要增加这部映影的放映次数。\u003c/p\u003e\u003cp\u003e芙宁娜：这次的票房回报，都够你开一家正经的映影公司了吧？\u003c/p\u003e\u003cp\u003e泽维尔：但这不是我一个人的功劳！是诸位好先生与好女士们共同的心血，绝不能由我一个人来取这个名字！\u003c/p\u003e\u003cp\u003e芙宁娜：总之你就好好想想吧，我相信大家会同意的。\u003c/p\u003e\u003cp\u003e泽维尔：好吧⋯但在那之前，旅行者和派蒙，可以麻烦您二位去一趟梅洛彼得堡吗？\u003c/p\u003e\u003cp\u003e派蒙：咦？可不是还有颁奖典礼吗？\u003c/p\u003e\u003cp\u003e泽维尔：我想请二位去找我们的女主角之一，夏沃蕾小姐来这边。\u003c/p\u003e\u003cp\u003e泽维尔：我最近都见不到她，也没机会通知她来参加今天的颁奖典礼。\u003c/p\u003e\u003cp\u003e泽维尔：但报纸上说，铳枪杀人案的犯人今天会由特巡队队长亲自押送至梅洛彼得堡⋯\u003c/p\u003e\u003cp\u003e派蒙：哦，原来是这样。\u003c/p\u003e\u003cp\u003e旅行者：举手之劳。\u003c/p\u003e\u003cp\u003e派蒙：嗯！泽维尔在这里等着就好，争取想出个好听的名字！\u003c/p\u003e\u003cp\u003e泽维尔：好，拜托二位了。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e•前往梅洛彼得堡找夏沃蕾\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e夏沃蕾：⋯押送程序结束。他们三个，接下来就交给你了。\u003c/p\u003e\u003cp\u003e莱欧斯利：看样子后边还有别的事？\u003c/p\u003e\u003cp\u003e夏沃蕾：嗯，得去赶一场派对。\u003c/p\u003e\u003cp\u003e莱欧斯利：真少见，在培养新爱好吗？\u003c/p\u003e\u003cp\u003e夏沃蕾：只是这场比较特殊。\u003c/p\u003e\u003cp\u003e派蒙：夏沃蕾，公爵！\u003c/p\u003e\u003cp\u003e莱欧斯利：过节就是好，连我这都变热闹了。\u003c/p\u003e\u003cp\u003e夏沃蕾：这就是千灵节。\u003c/p\u003e\u003cp\u003e莱欧斯利：是啊，护士长甚至准备了豪华版营养奶昔⋯健康程度也是豪华版的。\u003c/p\u003e\u003cp\u003e派蒙：你们刚才在聊工作吗？\u003c/p\u003e\u003cp\u003e夏沃蕾：已经聊完了。我也向莱欧斯利先生打了「招呼」，对吗？\u003c/p\u003e\u003cp\u003e莱欧斯利：我没有明确回应哦。\u003c/p\u003e\u003cp\u003e夏沃蕾：但你也没拒绝。\u003c/p\u003e\u003cp\u003e夏沃蕾：我有个好主意，给他们每人发一份报纸吧，比如，一份头版印着一段二十年前往事的报纸。\u003c/p\u003e\u003cp\u003e莱欧斯利：那我猜有一个人要倒霉了。\u003c/p\u003e\u003cp\u003e夏沃蕾：我猜有两个人要被当成英雄了。\u003c/p\u003e\u003cp\u003e莱欧斯利：说到英雄，你们两位是有什么事要找我吗？\u003c/p\u003e\u003cp\u003e派蒙：哦，我们是来⋯\u003c/p\u003e\u003cp\u003e夏沃蕾：来邀请我去派对的，对吧？我可没忘记今天是什么日子。\u003c/p\u003e\u003cp\u003e派蒙：嘿嘿，那我们赶快回去吧！\u003c/p\u003e\u003cp\u003e派蒙：公爵再见！千灵节快乐！\u003c/p\u003e\u003cp\u003e莱欧斯利：嗯，节日快乐。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e•返回千灵映影节会场\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e会场主持人：我宣布，获得首届千灵映影节「芙宁娜」奖的影片是——\u003c/p\u003e\u003cp\u003e会场主持人：《两个铳枪手》！\u003c/p\u003e\u003cp\u003e派蒙：是我们耶！真的是我们耶！\u003c/p\u003e\u003cp\u003e神里绫华：恭喜你，泽维尔先生。\u003c/p\u003e\u003cp\u003e泽维尔：天哪，我⋯我⋯真是太谢谢各位了！\u003c/p\u003e\u003cp\u003e芙宁娜：我对枫丹娱乐界的判断从不出错。\u003c/p\u003e\u003cp\u003e会场主持人：现在有请《两个铳枪手》的制片人，泽维尔先生，上台领奖！\u003c/p\u003e\u003cp\u003e泽维尔：谢谢⋯非常感谢大家对我们影片的认可。我在此，要特别感谢——\u003c/p\u003e\u003cp\u003e夏沃蕾：时间过得真快。\u003c/p\u003e\u003cp\u003e神里绫华：嗯，就好像夏沃蕾你教我握枪只是几天前的事一样。\u003c/p\u003e\u003cp\u003e夏沃蕾：还会来枫丹吗？\u003c/p\u003e\u003cp\u003e神里绫华：当然！我喜欢这个城市，新奇的东西看都看不过来。\u003c/p\u003e\u003cp\u003e神里绫华：夏沃蕾会来稻妻吗？\u003c/p\u003e\u003cp\u003e夏沃蕾：⋯以前从没有过这个打算。不过，现在可以考虑一下。\u003c/p\u003e\u003cp\u003e神里绫华：我期待你的到来。到时候，还想邀请你来家里做客，给你尝尝我们家的茶点。\u003c/p\u003e\u003cp\u003e夏沃蕾：嗯，保持联系。\u003c/p\u003e\u003cp\u003e千织：如你所愿？\u003c/p\u003e\u003cp\u003e神里绫人：你也该回稻妻看看了。\u003c/p\u003e\u003cp\u003e千织：「小仓屋」怎么样？\u003c/p\u003e\u003cp\u003e神里绫人：一切都好。\u003c/p\u003e\u003cp\u003e千织：代我向她问好。\u003c/p\u003e\u003cp\u003e神里绫人：我会的。\u003c/p\u003e\u003cp\u003e千织：听说岛上不下雷暴了。\u003c/p\u003e\u003cp\u003e神里绫人：也不打仗了。和平安治。\u003c/p\u003e\u003cp\u003e千织：听起来真好，是适合晒布料的天气。\u003c/p\u003e\u003cp\u003e泽维尔：——再次感谢我提到的所有人。是你们带我走上了领奖台，是你们铸就了这部映影。\u003c/p\u003e\u003cp\u003e泽维尔：另外，经过团队成员的一致认可，我正式将泽维尔剧组，命名为「铳枪影业」！\u003c/p\u003e\u003cp\u003e派蒙：嘿嘿，这么喊出来还真帅气！\u003c/p\u003e\u003cp\u003e会场主持人：那么，下面就有请「铳枪影业」的所有成员，上台合影！\u003c/p\u003e\u003cp\u003e派蒙：哦！还有合影环节！\u003c/p\u003e\u003cp\u003e泽维尔：芙宁娜导演，我认为，你才是应该举起这个奖杯的人。\u003c/p\u003e\u003cp\u003e芙宁娜：欸？不、不要啦⋯好丢人的⋯\u003c/p\u003e\u003cp\u003e夏沃蕾：没人比导演您更合适。\u003c/p\u003e\u003cp\u003e神里绫华：当之无愧。\u003c/p\u003e\u003cp\u003e旅行者：非你莫属。\u003c/p\u003e\u003cp\u003e千织：你就认命吧。\u003c/p\u003e\u003cp\u003e会场主持人：准备好了吗？三、二、一⋯\u003c/p\u003e\u003cp\u003e众人：铳枪影业！！\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e【剧情完成后彩蛋】\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e泽维尔：芙宁娜大人，请容许我再为您拍摄一张画片吧！我还想要您的签名⋯作为我们本次合作的留念。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e芙宁娜：领奖的时候我可是已经被闪烁的留影机拍够了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e泽维尔：噢⋯芙宁娜大人，我见过的最好的导演！最上镜的人！您正适合这样热闹又喜庆的场面，我相信所有的摄影师都是这么想的。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e泽维尔：来吧，亲爱的大明星，展现！展现您的光芒，留影机正在翘首以待呢！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e芙宁娜：就算你把我夸成这个样子⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e芙宁娜：唉⋯好吧，我就勉为其难再摆几个不一样的姿势好了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e芙宁娜：奖杯总可以不拿着吧？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e泽维尔：啊⋯啊！当然！您想怎么来就怎么来！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e泽维尔：万分感谢，万分感谢！天啊，我的运气真是好得让我自己都惊讶了！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：宵宫小姐，之前没找到机会说。这几天的事，我很感谢你。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e宵宫：致？我不记得我做了什么特别的事呀。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：最后那场特殊的演出，我很感谢你的配合。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：我明白。跟莫里斯单独接触⋯多少是有些风险的。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：你并不像我们特巡队，没有经过专业训练⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e宵宫：别这么说。我是导演助理，当然就该为剧组里的所有事情出力！能帮夏沃蕾破案，我还觉得荣幸呢。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e宵宫：虽然⋯那时候躺在地上，心跳声是扑通扑通响了好一阵子，我都怕被听出来呢，嘿嘿。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：你做得很好。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e宵宫：对了！如果你要来稻妻的话，记得来长野原烟花店找我哦，我给你做烟花。造型都想好了呢！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e夏沃蕾：铳枪？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e宵宫：嘿嘿，现在可不告诉你。想知道的话，就亲眼来稻妻看吧！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：没想到会在这里碰见你。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：关于你正在喝的东西⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：哦，这种叫做「枫达」的饮料，口感新颖，我很喜欢。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：「畅饮世界」的宣传语也不错，有点想把它也列做「文化交流」的项目之一了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：如果往「枫达」里加一些薄荷会怎么样呢？我很在意。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：不如再勇敢一些，往「枫达」里兑等比例的什锦奶茶⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：呵呵，感觉并不会好喝呢。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：关于映影⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：多亏你们，映影顺利上映，社奉行也同沫芒宫达成了合作。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：如果下次还有机会的话，我是不是真的该尝试担任一部电影的主演呢？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：还是说⋯在你看来，「反派」这类角色要更适合我？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：希望回程顺利。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：谢谢，我会照顾好绫华和宵宫她们的。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫人：也愿你今后的旅途顺利。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：是你们，有什么事吗？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：关于「千织屋」⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：想要定制服务吗？随时欢迎。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：托你们的福，映影也如期上映，我的品牌能被更多人看到。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：我们也没做什么⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：别那么谦虚，你帮了泽维尔、帮了夏沃蕾、绮良良也说她之前受你们照顾⋯他们都是我朋友。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：你们所做的，远比你们所认为的多。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：关于千织的工作⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：我就是个服装设计师而已，没什么奇怪的副业。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：只不过做生意的缘故，结交的朋友越来越多，遇到的破事也越来越多。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：你帮我一个忙，我帮你一个忙⋯今天你照顾我，明天我照顾你一这就是生意。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：关于映影⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：夺得了「芙宁娜」奖，泽维尔可要高兴坏了。说不定下次真会在喷泉里找到他。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：来找我定制服装的人也越来越多，店里的人手都不够了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：这么一来，我的梦想⋯或许又近了一步⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：不论如何，「千织屋」永远欢迎你们。不久后的枫丹时装周，也请你们多多捧场。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：没什么事了⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e千织：嗯，回头见。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：映影终于成功拍完了，我很高兴。这段时间⋯也承蒙你的关照。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：绫华的演技很出色。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：欸？谢谢⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：一开始，我抱着不能拖大家后腿的心情努力，想着如果是因为我的原因喊「停」就太丢人了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：芙宁娜导演既专业又耐心，夏沃蕾和埃兰小姐也给了我很多细节上的帮助⋯这才渐渐得心应手起来。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：虽然这么说，但到了最后，大家⋯包括你也在夸奖我，我心里还是会有些不好意思的⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：最近玩得开心吗？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：嗯，空下来的时候，我和宵宫一起逛了枫丹廷很多地方。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：优雅的街景，美丽的绿植与花卉，还有像身处梦中一般的海底世界⋯留下了闪闪发光的回忆。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：一想到在不久之前，或许你也曾恰好走过这些地方⋯就有些开心。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：绫华也辛苦了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：哪里。我平时⋯不太容易得到这样出门的机会。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：这次不仅交到了新朋友，还跟着大家学到了不少东西，非常有收获。我很珍惜。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：啊，对了，我还给社奉行的大家带了晶螺糕作为伴手礼。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：配着咖啡喝，呵呵⋯说不定就和现在在枫丹的感觉一样呢。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：回去路上慢点。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：嗯，谢谢你的关心，你在冒险途中也要照顾好自己哦。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e神里绫华：有机会的话⋯我们稻妻再见。\u003c/mark\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1781744401","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","