d\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"/ys/obc/content/1030/detail\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e精锻用魔矿\u003c/a\u003e×6，\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×20000\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e向好友赠送一次「梦里花」\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"/ys/obc/content/1030/detail\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e精锻用魔矿\u003c/a\u003e×6，\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×20000\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1313","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动玩法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2021/11/10/75276545/34eeed319ef99f41f8248950942d6f78_972648459772966657.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e稻妻的花匠咲耶为了推广自己的「咲耶花屋」，正举办着一场全新的推广活动…\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2021/11/10/75276545/1b5f546c6516bfde75c5a1932d3343d9_1518711757072697563.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e〓活动时间〓\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(193,110,3,1)\\\"\u003e花种兑换时间：2021/11/12 10:00 ~ 2021/11/18 03:59\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(193,110,3,1)\\\"\u003e花卉交换时间：2021/11/12 10:00 ~ 2021/11/22 03:59\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e〓参与条件〓\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(193,110,3,1)\\\"\u003e冒险等阶≥30级\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(193,110,3,1)\\\"\u003e且「尘歌壶」开放，并完成魔神任务「离岛逃离计划」\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e〓玩法介绍〓\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2021/11/10/75276545/e89058ae1a1ed66ac0a2316bb36ad655_2897119553920627676.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-b