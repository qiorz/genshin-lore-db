e\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/24/81460104/00b6325a61ff76b55ac87919153f5990_2708245177488534797.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大英雄的经验\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/26/76078930/17da480e3309e2db4cf7dee6d02332f5_6338011868951749063.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e玩家攻略推荐：\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/7812481\\\" target=\\\"_blank\\\"\u003e【V2.0攻略】#其他攻略#世界任务「异国的披萨」攻略流程\u003c/a\u003e\\t\\t作者：\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=4896641\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(102, 102, 102)\\\"\u003eFTFuture\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"02hpjslcfrjmT1713695910221\":[\"04nn2nct27swT1713695945859\",\"j8em1hgapihT1713695961897\"],\"04nn2nct27swT1713695945859\":[\"ypsa1r4tawaT1713696993031\",\"91tfouweyo7T1713696993394\"],\"91tfouweyo7T1713696993394\":[\"yj0pxwjkc3gT1713697037856\"],\"esp8xe1oicT1713696207470\":[\"vgedsv66jlnT1713696310943\"],\"ewllh0qqr0dT1711546416025\":[\"02hpjslcfrjmT1713695910221\",\"wjbyawd7xbpT1713695910575\"],\"gt9asbavji5T1713696362874\":[],\"j8em1hgapihT1713695961897\":[\"esp8xe1oicT1713696207470\",\"y4qprpo7kqT1713696207792\"],\"vgedsv66jlnT1713696310943\":[\"gt9asbavji5T1713696362874\"],\"wjbyawd7xbpT1713695910575\":[\"04nn2nct27swT1713695945859\",\"j8em1hgapihT1713695961897\"],\"y4qprpo7kqT1713696207792\":[\"vgedsv66jlnT1713696310943\"],\"yj0pxwjkc3gT1713697037856\":[\"gt9asbavji5T1713696362874\"],\"ypsa1r4tawaT1713696993031\":[\"yj0pxwjkc3gT1713697037856\"]},\"contents\":{\"02hpjslcfrjmT1713695910221\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e太好了！对了，我也搜集了客人们的意见，我找一下，你稍等。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：没问题。\"},\"04nn2nct27swT1713695945859\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e这位梨绘小姐说，这份披萨的味道虽然还不错…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e但她觉得，如果这道披萨能融合一些稻妻本土的食材，味道一定会更好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e也不知道，她想融合的是哪些食材…旅行者，你就先去问问她吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e木南杏奈的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e唉，也许我真的不太会做「披萨」这种菜吧…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e与梨绘对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e你好呀，有什么事找我吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e关于「木南料亭」的披萨…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e哦，你说那个披萨啊，味道确实很不错。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e但是…怎么说呢，总感觉不太吃得惯呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e我个人是觉得，要是能在那种披萨里融入一些稻妻本地食材的话，比如堇瓜之类的…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e说不定，这种披萨会更受大家欢迎呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘的场景对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e梨绘：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e用堇瓜制作的披萨…不知道吃起来味道怎么样…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e向木南杏奈回报\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e旅行者，你回来了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e怎么样，你有问到什么吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e关于客人们的反馈…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e用堇瓜做的披萨…倒也不会太复杂…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e其余的材料就照常准备好了，唔，既然都说要「融入一些稻妻本地食材」了，那我就再加一点其他的材料好了…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e唔，海灵芝？鸣草？嗯…幽灯蕈怎么样…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e那个，要我帮忙吗？\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e喔！抱歉，我光顾着想放什么食材好了！我看看，店里的堇瓜好像没多少了…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e旅行者，请你去帮我拿一个堇瓜来吧，材料的话…应该就只差这个了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"在雪鹤之章 第一幕 「鹤与白兔的诉说」——他乡之食中选择了均为蒙德食材的选项触发\"},\"91tfouweyo7T1713696993394\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e其他的食材店里还有些存货，你带一个堇瓜回来就好，拜托你啦。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：还要找其他的食材吗？\"},\"esp8xe1oicT1713696207470\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e那就拜托你了，只要一份奶酪就好。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，这可怎么办呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e怎么了？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者？太好了，你来得正好！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你还记得上次，你和神里小姐来我店里的时候，你写给我那道食谱吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哎呀，那道披萨可受欢迎了，好多客人都专门来店里点那道披萨吃呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但是…有些客人也说，总是吃这一种披萨感觉有点腻了，问我有没有其他味道的披萨。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e虽然我自己也根据客人们的反馈尝试过几种新做法…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但总觉得…差那么点味道，客人们的反响也不太好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，也许我真的不太会做「披萨」这种菜吧…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者，你应该很懂这种菜吧？你能帮我再拿拿主意吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"gt9asbavji5T1713696362874\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈开始制作披萨…\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e完成了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这披萨…看起来还不错…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谢谢你帮忙，旅行者，这些东西请你收下吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我等会就去仔细品尝一下这份披萨的味道…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e如果还不错的话…应该很快就能作为新品正式推出啦。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"j8em1hgapihT1713695961897\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e这位松本小姐说，虽然我店里的这道披萨融合了很多稻妻的食材，但她听说，蒙德的披萨不是这么做的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e她说，这种异国的食物，最好还是保持着异国的特色比较好…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e唉，但我怎么知道蒙德的披萨做法呢…旅行者，你就先去问问她吧。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e木南杏奈的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e唉，也许我真的不太会做「披萨」这种菜吧…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与与松本对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e松本：\u003c/strong\u003e唉，这个世界上还有能满足我味蕾的新奇菜肴吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e关于「木南料亭」的披萨…\u003cbr\u003e\u003cstrong\u003e松本：\u003c/strong\u003e你说那个披萨啊，味道确实很不错，还融合了不少当地的食材。\u003cbr\u003e\u003cstrong\u003e松本：\u003c/strong\u003e不过，我之前也尝过正宗的「烤蘑菇披萨」。\u003cbr\u003e\u003cstrong\u003e松本：\u003c/strong\u003e我记得，那种披萨是由奶酪，高丽菜和蘑菇做成的来着…\u003cbr\u003e\u003cstrong\u003e松本：\u003c/strong\u003e哈哈哈，我个人是觉得，这种异国的食物，最好还是保持着异国的特色比较好啦。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e松本的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e松本：\u003c/strong\u003e那种「烤蘑菇披萨」味道可是很不错的，有机会的话你一定要去尝尝看。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e向木南杏奈回报\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e旅行者，你回来了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e怎么样，你有问到什么吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e关于客人们的反馈…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e原汁原味的「烤蘑菇披萨」啊…嗯，倒是可以试试看。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e要准备的材料是奶酪，高丽菜和蘑菇…\u003cbr\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e其余的材料店里倒是有，可是这个奶酪，店里平时也没准备多少…\u003cbr\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e旅行者，能请你帮我去拿一份奶酪来吗？\u003c/p\u003e\",\"icon\":\"\",\"option\":\"在雪鹤之章 第一幕 「鹤与白兔的诉说」——他乡之食中选择了含有稻妻食材的选项触发\"},\"vgedsv66jlnT1713696310943\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e将奶酪带回给木南杏奈\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e你把食材带回来了吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e交付「奶酪」\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e谢谢你，有这些食材就够了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e原汁原味的蒙德「烤蘑菇披萨」，不知道能不能顺利做出来…\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"wjbyawd7xbpT1713695910575\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你想看看客人们的反馈吗？\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我找一下，你稍等。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：关于客人的反馈…\"},\"y4qprpo7kqT1713696207792\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e也不能说完全不用，只能说用得很少。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e毕竟，店里的这些菜，也没几道要用到奶酪的，所以储备的很少…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e总之，就拜托你了旅行者，请帮我带一份奶酪回来吧。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：店里平时都不用奶酪的吗？\"},\"yj0pxwjkc3gT1713697037856\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e将堇瓜带回给木南杏奈\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e你把食材带回来了吗？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e交付「堇瓜」\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e木南杏奈：\u003c/strong\u003e谢谢你，有这些食材就够了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e加入稻妻本地食材的披萨，不知道做出来会是什么味道…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ypsa1r4tawaT1713696993031\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e木南杏奈：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e嗯，那就拜托你了，只要一个堇瓜就好。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713751373","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"