{"retcode":0,"message":"OK","data":{"page":{"id":"5343","name":"赛芭","desc":"赛芭","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/288180982/ea8ca9eb51bbba398bb24588299af593_4799932303329856798.png","header_img_url":"","modules":[{"name":"赛芭","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"attr\":[{\"key\":\"性别\",\"value\":[\"女\"]},{\"key\":\"位置\",\"value\":[\"阿如村\"]},{\"key\":\"功能\",\"value\":[\"暂无\"]},{\"key\":\"相关任务\",\"value\":[\"「流放者·萌芽」；「流放者·花期」；「献给某人的蔷薇」系列任务\"]},{\"key\":\"职业\",\"value\":[\"暂无\"]}],\"extra_attr\":[{\"key\":\"编者注：\",\"value\":[\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e有知之罪⋯\u003c/p\u003e\"]},{\"key\":\"心声：\",\"value\":[\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e在所有的结论前面都存在条件⋯\u003c/p\u003e\"]}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/288180982/a715263ec13c66ea4f5822fcfa7a63d8_5983611675386184720.png\"}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"NPC截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/288180982/743497c57aa84d7ccba87b947dbfa597_9217964384355436339.png\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/288180982/1d9a210821a0d98a358636ed5cfe68be_7179324085027990046.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成世界任务 流放者·萌芽后】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果不是遇到你们，恐怕我很难看到那些蔷薇发芽。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e早知道会这样，比起种子，当初我更应该带些书来这里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你不是本地人？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e很意外吗？这算是说明我适应得很好吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e当初刚来这里的时候，从衣食到起居习惯，每一样我都没办法适应。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但过了这么久，慢慢也就接受了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e只不过表面适应，并不代表内心就接受了自己的处境。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e能在须弥城里盛放的蔷薇，在这里始终还是难以开花。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你是学者吗？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我⋯曾经被称为学者，但现在不是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我说了以我的身份不该说的话，了解了以我的身份不该了解的知识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这是有违教令院禁忌的，所以我就不再是学者了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你说了什么？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e好奇心是我们寻求智慧的原动力，但也是招致罪罚的源头。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这是我被驱逐到这里来之后才明白的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e安全起见，我认为不向你细说最好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【那好吧。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e咳咳，不过⋯那个⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e没想到，又跟你说了这么多话。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯在这里，我能敞开聊天的朋友不是很多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你认为⋯之后⋯你有空来帮忙给它们施肥吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【可以。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e那⋯好，我会等你来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【为什么要种须弥蔷薇？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你可能不太了解须弥蔷薇，这种植物的用途非常广泛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e它可以食用、可以药用，作为礼品，也有很高的经济价值。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这还仅仅是它在我们日常生活中的常见用途。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e须弥蔷薇的花、叶、茎并不总是我们今天见到的这样，它曾经也有过不同的形态。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我认为地理条件的改变，促使须弥蔷薇的形态特征也发生过改变。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e从它的形态演化过程，我们能得到很多历史地理方面的信息。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这不是一两句话说得清的事，向一位路过的冒险家解释恐怕也不合规定。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果你对植物演化感兴趣，就去教令院吧，那里的植物学教育更加完备。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【所以是为了研究？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我已经不是学者了，没有做研究的条件和资格。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e非要说为什么的话⋯唉，你的好奇心可真重。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我以前的居所里种了很多须弥蔷薇，它们开花的时候很漂亮，我每天都看得到。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e有可能的话，我还想像以前一样，每天都有它们作陪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e⋯只是这样而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【我能理解。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e没想到，又跟你说了这么多话。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯在这里，我能敞开聊天的朋友不是很多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你认为⋯之后⋯你有空来帮忙给它们施肥吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【可以。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e那⋯好，我会等你来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成世界任务 流放者·花期后】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e来找我聊天了吗？我可攒了一肚子的话。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【这是我采到的须弥蔷薇。】——获得「「香辛果」的种子」×3、「「墩墩桃」的种子」×3、「「须弥蔷薇」的种子」×3\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e多让人怀念的花，给你的礼物我也准备好了，你拿着吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e都是无法在这里生长发芽的植物种子，如果你在别处有宅院的话，就能看它们长大了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你看我，一下说了好多话，好畅快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你来之前，我在这里没什么朋友，其实有些寂寞。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e整个村子里，有闲心种花的人很少。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我去看望过他，是个有点奇怪的老人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e种下的明明是「石头」，却非说自己在种花，还把我赶走了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e一个人生活也有点寂寞吧，我能理解那种心情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你能帮我的须弥蔷薇开花，说不定也能帮帮他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果有机会的话，你和派蒙也可以去看看他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你是哪个学派的学者？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e想聊聊我的学派？我能说上三天三夜都不停，哈哈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我以前属于生论派，专攻植物演化，算是一门实证研究学科吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这意味着没有新材料就很难发现新结论，你可以简单理解成：要考察过去的植物，历史标本是研究基础。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但是便于搜集的标本就那么多，它们基本上都被搜罗得差不多了，教令院能提供的新标本有限。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e客观条件就是这样，但院内还是在不断要求研究指标。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e有人就把以前的研究成果拿出来，改一改凑一凑，也算交差了。你肯定也觉得这样很没意思对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e其实我们完全可以尝试从历史地理的角度，找一找新材料，这样一定能有新发现。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e一些不受生论派重视的文学材料也是可以利用的。不过这样的话，难免要涉及因论派和知论派的领域了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我并不具备那些领域的知识，申请相关「知识」的手续又太麻烦，和相关领域的学者合作更是难上加难⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但是我相信，如果我们能做到跨学科合作的话，过去的很多问题就可以得到突破性进展。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e只是可惜这样的尝试没能进行下去，因论派和知论派的怪人们讨论事情的角度特别⋯嗯⋯奇妙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我交给他们的提案里，所有的措辞都得仔细斟酌，要不然就会出现误会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e被赶出教令院之前，我还在跟一个知论派的家伙吵架。现在好了，想找他们吵架也难了⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你看我，一下说了好多话，好畅快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你来之前，我在这里没什么朋友，其实有些寂寞。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e整个村子里，有闲心种花的人很少。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我去看望过他，是个有点奇怪的老人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e种下的明明是「石头」，却非说自己在种花，还把我赶走了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e一个人生活也有点寂寞吧，我能理解那种心情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你能帮我的须弥蔷薇开花，说不定也能帮帮他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果有机会的话，你和派蒙也可以去看看他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【阿如村的生活怎么样？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e还算可以。有饭吃，有地方住，基本生活能得到保证就已经很不错了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e毕竟是被驱逐到这里来的人，我当然不能奢求藏书和研究器材。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e而且从以前开始，这个村子就是教令院放逐学者的地方，生存条件和研究条件都无法和须弥城相比，自然也不会有什么学术氛围。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我不是第一个流放者，可能也不会是最后一个。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e来都来了，习惯就好。只能这么想了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你看我，一下说了好多话，好畅快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你来之前，我在这里没什么朋友，其实有些寂寞。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e整个村子里，有闲心种花的人很少。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我去看望过他，是个有点奇怪的老人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e种下的明明是「石头」，却非说自己在种花，还把我赶走了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e一个人生活也有点寂寞吧，我能理解那种心情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你能帮我的须弥蔷薇开花，说不定也能帮帮他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果有机会的话，你和派蒙也可以去看看他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成世界任务 献给某人的蔷薇·曾有人战胜消逝后】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我们种下的须弥蔷薇，还有阿凡老先生苗圃里的金蔷薇，都长得很好，这都得谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你是哪个学派的学者？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e想聊聊我的学派？我能说上三天三夜都不停，哈哈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我以前属于生论派，专攻植物演化，算是一门实证研究学科吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e这意味着没有新材料就很难发现新结论，你可以简单理解成：要考察过去的植物，历史标本是研究基础。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但是便于搜集的标本就那么多，它们基本上都被搜罗得差不多了，教令院能提供的新标本有限。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e客观条件就是这样，但院内还是在不断要求研究指标。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e有人就把以前的研究成果拿出来，改一改凑一凑，也算交差了。你肯定也觉得这样很没意思对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【⋯⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e其实我们完全可以尝试从历史地理的角度，找一找新材料，这样一定能有新发现。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e一些不受生论派重视的文学材料也是可以利用的。不过这样的话，难免要涉及因论派和知论派的领域了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我并不具备那些领域的知识，申请相关「知识」的手续又太麻烦，和相关领域的学者合作更是难上加难⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但是我相信，如果我们能做到跨学科合作的话，过去的很多问题就可以得到突破性进展。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e只是可惜这样的尝试没能进行下去，因论派和知论派的怪人们讨论事情的角度特别⋯嗯⋯奇妙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我交给他们的提案里，所有的措辞都得仔细斟酌，要不然就会出现误会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e被赶出教令院之前，我还在跟一个知论派的家伙吵架。现在好了，想找他们吵架也难了⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【阿如村的生活怎么样？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e谢谢你的关心，我很好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e邻居们都很关照我，阿凡老先生也经常来找我聊天，比起之前⋯寂寞的时候已经少很多了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e虽然作为被放逐的人，没办法奢求藏书和研究器材，不过只要向智之心还在，在哪里都可以求知。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【再见。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e再见，祝你旅途顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762232643","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"