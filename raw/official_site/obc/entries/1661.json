.mihoyo.com/wiki-user-upload/2024/03/25/80663279/7dad28e3823fb191c66121a25551d9fd_703732323435654307.png\\\" data-entry-name=\\\"第一章 第三幕 「迫近的客星」\\\" data-entry-link=\\\"/ys/obc/content/1250/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1250/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e第一章 第三幕 「迫近的客星」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e传说任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4324\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/6936f9b2b1fa19ec3d6fc12bf0d83e67_6597109183532999773.png\\\" data-entry-name=\\\"引蝶之章 第一幕：奈何蝶飞去\\\" data-entry-link=\\\"/ys/obc/content/4324/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/4324/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e引蝶之章 第一幕：奈何蝶飞去\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e2.4：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3518\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/24/4521515/a1909ba874c6267a4c2028509f1be2d3_7411506098313890744.jpg\\\" data-entry-name=\\\"飞彩镌流年\\\" data-entry-link=\\\"/ys/obc/content/3518/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/3518/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e飞彩镌流年\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（吉星似火，福禄成喜）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"0x1tmk59cqcT1736404052968\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……果然吗。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我是「代替他人直视死亡之人」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我与你来时的一切毫无牵连。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我与你去时的一切了无因缘。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e彷徨的人，请离去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没错，是「别的东西」…】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"77xsnu78g4pT1736404051366\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，你好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我在「往生堂」的门下，想来已经很久没和同门以外的人说过话了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e即使在「工作」之时，出于对古老传统以及逝去之人的尊重，与家属之间也不会有交谈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e入夜，家属留下必备用具和待客小食，便会紧闭房门。而我们则尽可能悄无声息地完成工作，留下骨灰龛离开。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以遇到这种夜里被人搭话的情况实在太过少见，我刚才并不是有意无视你的，不好意思。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是外来人。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"a1zfzzw1y6sT1736404008055\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…莫非，你是在向我搭话吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e按照璃月的风俗，人们一般是会避免与「往生堂」的子弟交谈的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以…你是外来人吧？还是说你是什么「别的东西」…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【…怎么没反应？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【…小姐？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【……】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0x1tmk59cqcT1736404052968\":[],\"77xsnu78g4pT1736404051366\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"a1zfzzw1y6sT1736404008055\":[\"77xsnu78g4pT1736404051366\",\"0x1tmk59cqcT1736404052968\"],\"nqb471m7nmnT1710863941173\":[\"a1zfzzw1y6sT1736404008055\"],\"z2tn3pzsbujT1710863943430\":[]}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1736404111","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"p