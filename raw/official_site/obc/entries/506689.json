","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"53oz0r150gyT1759036268343\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【首次对话】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【？？？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是会飞的妖精！我的笔记…重要的笔记被愚人众扣下来了，你能帮我找回来吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然我不是妖精…但这点小忙也不是不能帮啦。话说回来，愚人众为什么会扣留小孩子的笔记呀？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【？？？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说不定是害怕我将笔记上的内容公之于众…你们要是能帮我把笔记找回来，我就把这个秘密也告诉你们。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些待会儿再说，拜托你们先帮我\u003cspan style=\\\"color: rgb(145, 213, 255)\\\"\u003e找回笔记\u003c/span\u003e吧，说不定还有些从笔记本里\u003cspan style=\\\"color: rgb(145, 213, 255)\\\"\u003e散落的纸页\u003c/span\u003e，就在那边，有愚人众的地方。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【集齐三张\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506509\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/df2d68b4a3c70757399dbe775a449e7f_195170750328089856.png\\\" data-entry-name=\\\"印有海螺纹样的纸页\\\" data-entry-link=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的纸页\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e和\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506507\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/f2cbf4ada3430bfe641a8934b5ea8c56_904455085764666657.png\\\" data-entry-name=\\\"印有海螺纹样的笔记本\\\" data-entry-link=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的笔记本\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e前】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【？？？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e笔记就拜托你们了，可能还有些散落的·就在那边有愚人众的地方。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【集齐三张\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506509\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/df2d68b4a3c70757399dbe775a449e7f_195170750328089856.png\\\" data-entry-name=\\\"印有海螺纹样的纸页\\\" data-entry-link=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的纸页\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e和\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506507\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/f2cbf4ada3430bfe641a8934b5ea8c56_904455085764666657.png\\\" data-entry-name=\\\"印有海螺纹样的笔记本\\\" data-entry-link=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的笔记本\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【？？？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么样，你们找到我的笔记了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e（提交\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506509\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/df2d68b4a3c70757399dbe775a449e7f_195170750328089856.png\\\" data-entry-name=\\\"印有海螺纹样的纸页\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506509/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的纸页\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506507\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/f2cbf4ada3430bfe641a8934b5ea8c56_904455085764666657.png\\\" data-entry-name=\\\"印有海螺纹样的笔记本\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506507/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e印有海螺纹样的笔记本\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我看看…没错！就是这些，太感谢了。这里面可是记录了不少愚人众的罪证呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…罪证？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【？？？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你瞧他们在帕哈岛上建的那些设施，还有他们带来的机械装置…那里原本也是很多动物的家呀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我刚从绯沙盐沼回来，一定是因为愚人众的机器，那边的水母都奄奄一息了…我得让大家都知道这件事才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原来是这样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【谢苗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对了，如果你们要和别人说，一定要说是谢苗，也就是我告诉你们的。毕竟回去写成文章在报纸上刊登还需要时间…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这份笔记就交给你们了。我得快点回去把其他的笔记的内容整理好，写成文章才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506508\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/df2d68b4a3c70757399dbe775a449e7f_195170750328089856.png\\\" data-entry-name=\\\"谢苗的笔记\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506508/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506508/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e谢苗的笔记\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、「冰淇淋甜心」图纸】\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"t2dvrnm99gqT1759073957079\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【再次对话】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1759109207","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id"