4c4892d86685df69eec78ec6641b_8508220871906089737.png\\\" data-entry-name=\\\"往日留痕: 潮涌之章 第一幕\\\" data-entry-link=\\\"/ys/obc/content/7431/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/7431/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e往日留痕: 潮涌之章 第一幕\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，可爱的人。刚刚在思考问题，差点没注意到你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【可以问问是什么问题吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然可以。我在思考，人类究竟是如何诞生的呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们美露莘是在厄里那斯诞生的。我时常在想，世界上的第一个人类是如何出现的呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是和我们一样诞生于血肉，还是由别的方式创造的呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"pn5ngx4z8eT1717865413668\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/10/288180982/b26706122e54335e75a99308e473cc62_5540850057535695131.png\",\"option\":\"【我不是提瓦特人，不太清楚…】——获得4★杰作的序曲*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，这样吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没关系，反正我只是随便想想。这个世界上有很多美露莘看不清也想不明白的问题，已经习惯啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过还是谢谢你！这个小小的纪念品，请收下吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cem\u003e4★\u003c/em\u003e\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500037\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/10/288180982/07a8e830cef8c17b23daddb57e7b1da0_3399842010921106473.png\\\" data-entry-name=\\\"杰作的序曲\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/500037/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/500037/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/10/288180982/07a8e830cef8c17b23daddb57e7b1da0_3399842010921106473.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e杰作的序曲\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[\"pn5ngx4z8eT1717865413668\"],\"pn5ngx4z8eT1717865413668\":[]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":f