c/content/5566/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e原石\u003c/a\u003e×30，\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×30000，大英雄的经验×3，\u003ca href=\\\"/ys/obc/content/4304/detail\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e恒动械画\u003c/a\u003e×1\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1313","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动玩法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/10/75276545/356c98cf48ff7c3bee0de4e623abca0c_5908114653975110090.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: left;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e「恒动械画」即将开启。活动期间，帮助来自枫丹廷的菲利斯·尤格解决烦恼，复原「械画部件」并拼接「恒动械画」，完成后即可获取\u003c/span\u003e\u003cspan style=\\\"color:rgba(173,114,14,1)\\\"\u003e原石、摆设、大英雄的经验、武器突破素材、摩拉\u003c/span\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e等奖励。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/10/75276545/65c5e9f1afc9565a482ccd7cb0cf5071_1911330596386746060.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e「海蓝纪行」中也增加了对应的活动任务，完成后可领取纪行经验。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: left;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch5 style=\\\"text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓活动时间〓\u003c/span\u003e\u003c/h5\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(173,114,14,1)\\\"\u003e2022/08/12 10:00 ~ 2022/08/22 03:59\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: left;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch5 style=\\\"text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓参与条件〓\u003c/span\u003e\u003c/h5\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(173,114,14,1)\\\"\u003e冒险等阶≥18级\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e\u003cspan style=\\\"color:rgba(173,114,14,1)\\\"\u003e完成魔神任务：序章·第三幕「巨龙与自由之歌」\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: left;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch5 style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓玩法介绍〓\u003c/span\u003e\u003c/h5\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/10/75276545/1ce4bbf6fe852696a2af0b1f168aacb4_2577114616158544838.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" href=\\\"\\\" style=\\\"border:1px solid r