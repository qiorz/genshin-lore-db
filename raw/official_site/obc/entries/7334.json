ext-align: center\\\"\u003e好感套装\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e奖励\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500539\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/28/50494840/eaa03a1cc286929907aabb686d7f5300_2858074758599412161.png\\\" data-entry-name=\\\"严守流程的办公准则\\\" data-entry-link=\\\"/ys/obc/content/500539/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/500539/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/28/50494840/eaa03a1cc286929907aabb686d7f5300_2858074758599412161.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e严守流程的办公准则\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7025\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/08/13/183046623/747433612c3f46cbf5c5ea14879a92c9_3762545253417319202.png\\\" data-entry-name=\\\"「公平」的指引\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/7025/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/7025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/08/13/183046623/747433612c3f46cbf5c5ea1