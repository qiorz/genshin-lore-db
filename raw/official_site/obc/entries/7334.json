d":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e【严守流程的办公准则好感套装对话】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在我看来，办公桌是人类最实用的发明之一。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在接见陌生人的时候，一道有形的屏障往往比口头提醒更有效，可以应付一些没有分寸感的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e它之于我，很重要。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【正义之廷的清新水雾好感套装对话】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e看得出来，这里的布景与露景泉广场类似。可惜根源不同，肯定无法品尝出与露景泉相仿的味道。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，根据我以往的经验，寻常人看到了这样的情景，大概会说一句「这里很有露景泉的味道」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我的杯子很干净，可以舀一勺泉水试喝吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"3nje35108abT1712737357219\":[\"vjnhqxfhf8lT1712737358713\"],\"4cf2vhylew3T1710863944349\":[\"awvygl2xu6cT1712737544680\"],\"6apngixaj28T1712737257065\":[\"qpndszbb4lT1712737258473\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"pfo2s83jw0dT1712737562872\",\"y4arruxh0i8T1712737564110\"],\"awvygl2xu6cT1712737544680\":[\"k60i1d0l2oaT1712737556027\"],\"k60i1d0l2oaT1712737556027\":[],\"kb23vx6kd7rT1712737393760\":[],\"nqb471m7nmnT1710863941173\":[\"6apngixaj28T1712737257065\"],\"pfo2s83jw0dT1712737562872\":[],\"qpndszbb4lT1712737258473\":[],\"qrdey2f8baT1712737391931\":[],\"vjnhqxfhf8lT1712737358713\":[\"qrdey2f8baT1712737391931\",\"kb23vx6kd7rT1712737393760\"],\"y4arruxh0i8T1712737564110\":[],\"z2tn3pzsbujT1710863943430\":[\"3nje35108abT1712737357219\"]},\"contents\":{\"3nje35108abT1712737357219\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你的人生确实少了很多口福…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过这也是没有办法的事情，有些事情就是天生的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你知道吗？龙蜥会在进化的过程中失去分辨色彩的能力。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e错过了时机，就没有办法再度欣赏有色彩的画作了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，我只是出于兴趣了解过这类知识而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【…我舌头拙，无缘体会。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果你问现在想做什么的话，散步就很不错了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果是问长远来看的话，生命只要用自己本来的形态活着就好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只不过如今，这样的一种自然状态却要用激烈的方式去争取。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"6apngixaj28T1712737257065\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我明白了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e想来也是，开辟如此一方天地就是为了方便遮风挡雨。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不必在意，没什么。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【确实不会。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是你啊，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我一直在等待屋主现身，得到许可才方便四处游逛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"awvygl2xu6cT1712737544680\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e确实如此吧。这句话是说给我自己听的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果你也遇到了让自己觉得委屈的事情，同时又发现束缚你的是被歪曲的规则。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你一定要挺身而出，去扭正这个歪曲。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果你不打破卵壳，世界就是一片蒙蔽囚禁你的牢狱。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不要畏惧牢狱外的荒芜与贫瘠，不要担心监牢被摧毁就没有了牢饭供应。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e世界之外，我会一直等着你的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是不是有点极端了。】\"},\"k60i1d0l2oaT1712737556027\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【我会记得的。】\"},\"kb23vx6kd7rT1712737393760\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不错的回答。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是我很确信，这件事多晚做都不迟。我也盘算着之后去周游世界呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【去周游世界？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【在这里还习惯吗？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e风景宜人，让人心情愉快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但我想问一下，这里不会下雨是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"pfo2s83jw0dT1712737562872\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，旅行者。不要调侃我了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这里的天气一直都很…不错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，最高审判官。】——【白天】\"},\"qpndszbb4lT1712737258473\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，那太好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我对于稻妻的温泉早有耳闻，没想到能在你这里得以一见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…你说水源只是人工加热的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这也不要紧。我早已听说稻妻本无天然温泉，现有的设施也是由他们的财务部引进并开发出来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e差不多也是原汁原味的温泉体验了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【但是我们这里有稻妻的温泉。】\"},\"qrdey2f8baT1712737391931\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你的回答超出我的想象了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果人们能做到就好了。若不如此，世界将会被悲哀淹没。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【去爱人然后被爱？】\"},\"vjnhqxfhf8lT1712737358713\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我从龙蜥的故事里学到的两个经验就是——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e第一，要尊重所有物种以及物种内所有个体的差异。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e第二，不要辜负最美好的年华。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你能想到什么事情应该年轻时要做，不要等老了之后跌坐哀叹的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【总感觉在哪里听过这话…】\"},\"y4arruxh0i8T1712737564110\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e忘掉不快的事情，好好睡一觉吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，那维莱特。】——【夜晚】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好。你有什么想知道的事情吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e比如我的世界名泉品鉴心得？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712801689","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","la