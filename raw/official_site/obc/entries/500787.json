alse,\"is_show_switch\":true}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4290\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/6ee632dc08f8146408597e4b9001fa98_2461154768230960176.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"100\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/6ee632dc08f8146408597e4b9001fa98_2461154768230960176.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*100\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"10000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*10000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/ed0dd0aaeeb27c37c9ee7526eeead35c_4421238561910109100.png\"},{\"tab_name\":\"任务结束地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/02/317305234/8a8d79e5b4871d230b9e53474f8b4217_4663549443264552009.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e派蒙：说起来，不知道浮锦恢复得怎么样了？\u003c/p\u003e\u003cp\u003e派蒙：我记得，她之前离开赤望台的时候，好像是借助了那里的什么宝玉，然后「唰」地一下，整天鱼就不见了⋯\u003c/p\u003e\u003cp\u003e派蒙：要是有空的话，我们再回赤望台看看吧？我稍微有些担心她的身体状况⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e前往来歆山顶\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e与灵渊对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e派蒙：咦？那个是⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e灵渊：旅行者，还有派蒙。你们来了。\u003c/p\u003e\u003cp\u003e派蒙：欸，灵渊？为什么你会在这里？\u003c/p\u003e\u003cp\u003e灵渊：因为我进不去。\u003c/p\u003e\u003cp\u003e派蒙：进不去？是说进不去什么地方呀？\u003c/p\u003e\u003cp\u003e灵渊：锦落庭。浮锦现在休息的地方。\u003c/p\u003e\u003cp\u003e派蒙：锦落庭⋯唔，就是浮锦一开始把我们拉进去的那个地方吗？\u003c/p\u003e\u003cp\u003e灵渊：那里是她用仙力封锁的居所。我没有她的仙力，去不到她的身边。\u003c/p\u003e\u003cp\u003e派蒙：啊？可是她之前回去休息的时候，你也没提这件事⋯\u003c/p\u003e\u003cp\u003e灵渊：我没想起来。\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e需要帮忙吗？/阿蓝，好笨。\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e选择“需要帮忙吗？”\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(217, 217, 217)\\\"\u003e无特殊对话\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e选择“阿蓝，好笨。”\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e派蒙：就是就是！为什么连这么重要的事情都能忘啦！真是的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e灵渊：因为我只是愚钝的野兽。见到她，想了很多事情，忘了很多事情。是我的错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e灵渊：你们拥有她的仙力，能够开启锦落庭的大门。是的，希望你们帮助我。\u003c/p\u003e\u003cp\u003e派蒙：欸？等一下，所以你是一直在这里等我们吗？\u003c/p\u003e\u003cp\u003e灵渊：我不是在等你们。我是在寻找进入锦落庭的办法。\u003c/p\u003e\u003cp\u003e派蒙：好像没什么区别⋯总、总之，我们也有些在意浮锦的身体状况，那灵渊，我们一起去探望她吧？\u003c/p\u003e\u003cp\u003e灵渊：好。谢谢你们。\u003c/p\u003e\u003cp\u003e灵渊：跟我来。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e前往锦落庭\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e进入锦落庭\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e灵渊：就是这里。门已经打开了。直接前进就好。\u003c/p\u003e\u003cp\u003e派蒙：唔，这么说来，我们之前被浮锦仙人拉到这里来的时候，好像一直打不开这边的封印呢⋯\u003c/p\u003e\u003cp\u003e灵渊：力量需要熟悉。她的力量也不例外。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e寻找浮锦\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e浮锦：欸？旅行者和派蒙，还有灵渊⋯为什么会到这里来呀？\u003c/p\u003e\u003cp\u003e派蒙：哇啊，是浮锦的声音！好像是⋯从这下面传上来的？\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e我有些担心你。/灵渊有些担心你。\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e选择“我有些担心你。”\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e派蒙：是呀，我们都很担心你的身体状况，所以没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e选择“灵渊有些担心你。”\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e灵渊：我没有。我只是⋯\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e灵渊：⋯⋯\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e派蒙：你看，灵渊这都担心得说不出话了，所以我们没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e浮锦：欸？啊！抱歉！我回锦落庭休息的时候，好像忘了解除门口的封锁了⋯！对不起，你们明明是来探望我的，却给你们添了那么多麻烦⋯\u003c/p\u003e\u003cp\u003e派蒙：也算不上是添麻烦啦。不过，为什么你要躲在这个⋯呃，水坑里呀？\u003c/p\u003e\u003cp\u003e浮锦：怎么说呢⋯因为我现在还没能恢复我最喜欢的形态，总是让你们看到鲤鱼的样子，稍微觉得有些⋯不好意思⋯\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e明明之前已经见过好多次了⋯/那也没必要躲起来吧？\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e浮锦：啊哈哈⋯因为之前能随时变回人的样子，所以觉得用鲤鱼的形态行动起来会更方便；现在只剩下滑溜溜的样子了，反而觉得有点⋯\u003c/p\u003e\u003cp\u003e派蒙：呜哇，还真是奇怪的执着⋯总之，浮锦你没事就好！\u003c/p\u003e\u003cp\u003e派蒙：不过，按照灵渊之前的说法，浮锦的力量其实不是直接消耗掉了，而是逸散到了沉玉谷的山林河川之间，所以才会变得虚弱⋯\u003c/p\u003e\u003cp\u003e派蒙：那要是像我们在药蝶谷找金色的鲤鱼一样，把逸散的仙力收集起来，浮锦就能恢复了吧？\u003c/p\u003e\u003cp\u003e浮锦：嗯⋯理论上来说是这样没错啦，不过⋯\u003c/p\u003e\u003cp\u003e派蒙：对吧对吧？那我们之后要是发现了类似的鲤鱼，就把它带回这里来吧！这样一来，浮锦也能早日恢复啦！\u003c/p\u003e\u003cp\u003e浮锦：这、这种事情也太麻烦你们了！小仙我的力量还没有耗尽到那种程度，只要在这里稍稍静养一段时间，就可以⋯\u003c/p\u003e\u003cp\u003e旅行者：倒也不算是麻烦⋯\u003c/p\u003e\u003cp\u003e旅行者：⋯只是遇到的话会留神一下。\u003c/p\u003e\u003cp\u003e浮锦：谢谢你们。不过，我真的不想因为自己的事情再给你们添麻烦了，你们为我做过的已经太多了。\u003c/p\u003e\u003cp\u003e浮锦：要是二位在旅途中寻到了更多逸散的仙力，就将它们直接汇入这里的祀珑吧。\u003c/p\u003e\u003cp\u003e浮锦：虽然水土的调理已经完成，但若是能向祀珑中注入更多力量，就能保证沉玉谷风调雨顺、年登岁稔。\u003c/p\u003e\u003cp\u003e灵渊：⋯那你呢？\u003c/p\u003e\u003cp\u003e浮锦：真是的，我都说了，我只要在这里休养一段时间就好啦！\u003c/p\u003e\u003cp\u003e浮锦：旅行者和派蒙，真的非常感谢你们能来探望我。我真的真的好开心。自从药君离开，还是第一次有人到这里来呢。\u003c/p\u003e\u003cp\u003e浮锦：也谢谢你，灵渊。\u003c/p\u003e\u003cp\u003e灵渊：我没做什么值得你感谢的事情。\u003c/p\u003e\u003cp\u003e浮锦：哎呀，好啦！就当我是在感谢你把旅行者和派蒙带到这里吧，真是的！\u003c/p\u003e\u003cp\u003e浮锦：最后⋯让我再说一次谢谢吧，旅行者和派蒙。谢谢你们做过的一切。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e【剧情结束后彩蛋】\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(255, 163, 158)\\\"\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e=赤璋城垣七天神像西北侧=\u003c/mark\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：欸，这不是灵渊吗？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：⋯⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：啊，对不起！难道说你是在狩猎，我们不小心打扰了你⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我没有在狩猎。你们也没有打扰我。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：呃，那你这是在⋯发呆？比方说，在想好吃的？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我也没在想你的事情。我在思考。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：思考⋯不对，你前半句话是什么意思啦！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我在思考旅行者之前的问题。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：「如果人类活动也是自然法则的一部分，该如何看待人类。」\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：你这话说的，小茂不也是人类嘛！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：小茂是属于聚落的人类，而不是组成聚落的人类。你和旅行者「组成」了旅行的同伴，而不「属于」旅行者。这就是区别。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：\u003c/mark\u003e\u003cstrong\u003e\u003cu\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e你认为小茂不是社会秩序的一部分？/这可不好说⋯\u003c/mark\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e你认为小茂不是社会秩序的一部分？\u003c/mark\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。\u003c/mark\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e这可不好说⋯\u003c/mark\u003e\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：喂！不要说这么奇怪的话啦！\u003c/mark\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e旅行者：因为他们侵占了属于自然的土地？/因为浮锦为了他们选择牺牲自己？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我不知道。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：也许不存在明显的区别，划分「我们」和「他们」，但我无法确定。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：人类的幼崽会与我同行，我也有年幼的同族，出于好奇选择与人类同行。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e派蒙：欸？年幼的同族？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：那孩子在山中遇到了烟火气的人类，\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：所以，我现在依然没办法回答你的问题。我需要继续观察人类。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：许多事情，我不理解。我会试着理解，直到我能够按照约定，回答你的问题。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(255, 163, 158)\\\"\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e=灵濛山南侧=\u003c/mark\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e小茂：阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：嗯。我记得。不过，我改变主意了。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e小茂：「改变主意」是什么意思呀？\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：这个故事的结尾，就交给你来讲吧。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e小茂：欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我只是愚钝的野兽。想不出好的结局。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e小茂：可这还是在耍赖嘛！\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：⋯⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e灵渊：不要露出那种表情。我特别允许你⋯坐在我背上，五分钟左右。十分钟也可以。\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(255, 232, 230); color: inherit\\\"\u003e小茂：那⋯那就这样说好了，我想想这个故事该怎么结尾⋯\u003c/mark\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_edit