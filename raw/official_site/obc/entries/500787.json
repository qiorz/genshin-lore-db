{"retcode":0,"message":"OK","data":{"page":{"id":"500787","name":"赤望所居，锦落云程","desc":"世界任务系列「沉玉祝珑」后续","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/5f9af9d051379276e4fc7f76ed7d9bcb_2410113334334840393.png","header_img_url":"","modules":[{"name":"赤望所居，锦落云程","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"moduleName\":\"\",\"layout_\":\"left\",\"list\":[{\"key\":\"触发条件\",\"value\":[\"完成「沉玉祝珑」系列任务后，游戏内第二天自动接取\"]},{\"key\":\"等级限制\",\"value\":[\"无\"]},{\"key\":\"特殊限制\",\"value\":[\"无\"]}]}","style":""}],"id":"1367","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500786\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/53c1c5109edb51f54a7873cdcf371420_8497780155450793844.png\\\" data-entry-name=\\\"沉玉祝珑\\\" data-entry-link=\\\"/ys/obc/content/500786/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/500786/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e沉玉祝珑\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3386\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/02/01/317305234/6ff6307d4f4f955aa9faa89f3e0526aa_7148592881614743818.png\\\" data-entry-name=\\\"灵渊\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97