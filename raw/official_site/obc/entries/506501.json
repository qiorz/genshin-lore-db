tomize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"0bmenvpww05cT1764736680893\":[\"fic3gfwvvh7T1764737438397\"],\"4cf2vhylew3T1710863944349\":[\"4e77nd0bovuT1757602439742\",\"oj7pkq36ftfT1757602444414\"],\"4e77nd0bovuT1757602439742\":[\"fic3gfwvvh7T1764737438397\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"0bmenvpww05cT1764736680893\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"pjv86kgizlcT1757602217443\"],\"fic3gfwvvh7T1764737438397\":[],\"nqb471m7nmnT1710863941173\":[\"fic3gfwvvh7T1764737438397\"],\"oj7pkq36ftfT1757602444414\":[\"fic3gfwvvh7T1764737438397\"],\"pjv86kgizlcT1757602217443\":[\"fic3gfwvvh7T1764737438397\"],\"z2tn3pzsbujT1710863943430\":[\"fic3gfwvvh7T1764737438397\"]},\"contents\":{\"0bmenvpww05cT1764736680893\":{\"dialogue\":\"\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e海德薇卡小姐，上次你拜托我们采购的鱼竿，用着还好么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海德薇卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，雅珂达小姐，上次真是多谢你们了，这鱼竿用着很好，我钓上来好多鱼！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你想试试吗？我刚调好了一盒很棒的鱼饵，肯定能轻松诱到大鱼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真的？嘿嘿，那我来试试，正好我也想学习一下钓鱼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海德薇卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，稍等一下，我去拿点资料给你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对了，海德薇卡小姐，钓一条鱼，大概要花多长时间？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海德薇卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我没有注意过欸…有时候钓着钓着，一下午就过去了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？那鱼上钩的时候，你总会留意吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海德薇卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有啊，一下午都没有鱼上钩也很正常。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e比起「把鱼钓上来」，我更享受「钓鱼的过程」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e欸！雅珂达小姐，你别走呀，我刚找到资料了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个…我、我突然想到有事要办，先走了——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/03/80663279/ead302bf7db83ccaefbafca7162a8b8c_5452282854135999465.png\",\"option\":\"【（雅珂达似乎有所思考…）】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳，没什么，只是在钓鱼时的大部分时间都会有点儿无聊，所以我会花点时间想些好玩…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，就是刚好想到了——是水池里的鱼开心，还是海里游着的鱼开心？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说呢？水池小但相对更安全，大海辽阔但危机四伏…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【什么进展？】\"},\"4e77nd0bovuT1757602439742\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…确实，可惜我不懂鱼语，不然采访一下它们就能知道啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这怕是要当事鱼才能知道吧…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，刚才的进展到哪了？好像是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"fic3gfwvvh7T1764737438397\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦好的，请随意看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/11/288180982/1b764ab0418774d3f6ebf1bf4b1bd200_85117501713148617.png\",\"option\":\"【我需要一些钓鱼用品。】——打开商店界面\"},\"oj7pkq36ftfT1757602444414\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是我狭隘了，唉，或许它们都不快乐呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不同的鱼有不同的想法。】\"},\"pjv86kgizlcT1757602217443\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好的，唉，下次真是该带个小本子记下，这样就不用再从头想起…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见，你慢慢想吧。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e钓鱼爱好者之一罢了，最多算狂热喜欢的那一批吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e钓鱼爱好者，也是读书爱好者\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与伊尔玛里和佩卡尼是钓友\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e曾经钓起过「阿特拉号」的遗物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但因为不是鱼所以直接丢回了海里\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e雅珂达：（海德薇卡小姐，她上次找我们采购过外国的钓鱼竿，为什么要盯她啊？算了算了，反正奈姐都发话了…）\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1764739097","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\