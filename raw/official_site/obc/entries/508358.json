nents":[{"component_id":"card_skill","layout":"","data":"{\"list\":[{\"tab_name\":\"愿一切欢睦陪伴你\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/80663279/9a0eb459e86399a81ad6d57be21a1c67_7273013661072646897.png\",\"life\":3,\"life_bg\":6,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为\u003cstrong\u003e塔利雅\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e塔利雅装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e纯耀的祷咏\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;纯耀的祷咏：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;元素爆发\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成2点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(24, 144, 255)\u0026#34;\u0026gt;\u0026lt;u\u0026gt;水元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，生成2层\u0026lt;strong\u0026gt;护盾\u0026lt;/strong\u0026gt;和2层\u0026lt;strong\u0026gt;西风之眷\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;护盾\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;为我方出战角色提供1点\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;护盾\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;。（可叠加，没有上限）\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;西风之眷：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;出战状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方角色受到伤害后：\u0026lt;/strong\u0026gt;生成1层\u0026lt;strong\u0026gt;护盾\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;：2\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素爆发：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;角色的充能达到上限时，可以消耗所有的充能，来使用威力强大的「元素爆发」。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;护盾：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此护盾所保护的角色受到伤害时，将会消耗护盾来抵消伤害。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(24, 144, 255)\u0026#34;\u0026gt;水元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;附着水元素，可发生元素反应：\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;蒸发：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;感电：\u0026lt;/strong\u0026gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;冻结：\u0026lt;/strong\u0026gt;本伤害+1，使目标本回合无法行动（受到物理或火元素伤害后提前解除，但是伤害+2）\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;绽放：\u0026lt;/strong\u0026gt;本伤害+1，生成使下次火元素或雷元素伤害+2的[\u0026lt;strong\u0026gt;草原核\u0026lt;/strong\u0026gt;]\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;月感电：\u0026lt;/strong\u0026gt;生成回合结束时造成2点雷元素伤害的[\u0026lt;strong\u0026gt;雷暴云\u0026lt;/strong\u0026gt;]。（可用次数1，可叠加，没有上限，入场或可用次数增加时，赋予敌方随机1张手牌[\u0026lt;strong\u0026gt;电击\u0026lt;/strong\u0026gt;]）\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e装备有此卡牌的塔利雅在场时，我方角色被击倒时：\u003c/strong\u003e如果我方场上存在\u003cstrong\u003e\u003cu\u003e西风之眷\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;西风之眷：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;出战状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方角色受到伤害后：\u0026lt;/strong\u0026gt;生成1层\u0026lt;strong\u0026gt;护盾\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;：2\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e，则消耗所有\u003cstrong\u003e西风之眷\u003c/strong\u003e，使该角色\u003cstrong\u003e\u003cu\u003e免于被击倒\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;免于被击倒：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;一些效果会使角色在生命值被降为0的时候\u0026lt;strong\u0026gt;免于被击倒\u0026lt;/strong\u0026gt;，并治疗该角色到一定生命值。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此时，角色不视为被\u0026lt;strong\u0026gt;击倒\u0026lt;/strong\u0026gt;过。（因此，角色所附属的装备和状态不会被弃置，充能也不会被清空。）\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e，并治疗该角色到2点生命值。\u003c/p\u003e\u003cp\u003e（牌组中包含塔利雅，才能加入牌组）\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}}]}\n","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038496","langs":[],"template_layout":{"tab":[{"tab_id":"49","tab_name":"七圣召唤","module_group":[{"module_group_id":"87","layout":"l1r1","module":[{"id":"131","pos":"left"},{"id":"132","pos":"right"},{"id":"133","pos":"left"},{"id":"134","pos":"left"}],"name":"七圣召唤","repeated":false,"parent_group_id":"0"},{"module_group_id":"2630","layout":"l2r1","module":[{"id":"8551","pos":"banner"},{"id":"8550","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]},{"tab_id":"445","tab_name":"自行巧局","module_group":[{"module_group_id":"2158","layout":"l1r1","module":[{"id":"6537","pos":"banner"},{"id":"6496","pos":"left"},{"id":"6497","pos":"right"},{"id":"6498","pos":"left"}],"name":"自行巧局","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"233","n