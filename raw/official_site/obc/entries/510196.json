,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"默认标题\",\"image\":\"\"}]}\n","style":""}],"id":"8175","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"contents\":{\"9l3x26v477fT1762846019994\":{\"option\":\"旅行者：好、好可怕…\",\"dialogue\":\"\u003cp\u003e伊安珊：唉，我明明都给他列好了训练计划，还特意叮嘱他，如果想要冲击大重量，那就一定要把我叫去驻场。\u003c/p\u003e\u003cp\u003e伊安珊：谁知道那个笨蛋练上了头，非要自己试试，还不听旁边人的劝。\u003c/p\u003e\u003cp\u003e伊安珊：现在好了，伤了腰，就算敷上我的特效药，也不知道什么时候能好。\u003c/p\u003e\u003cp\u003e伊安珊：真是头疼…过几天，还要再去向他们强调一遍…\u003c/p\u003e\",\"icon\":\"\"},\"plmd6xr4iT1762845950788\":{\"option\":\"旅行者：伊安珊在做什么呢？\",\"dialogue\":\"\u003cp\u003e伊安珊：几份外敷的伤药。部族里的一个笨蛋做深蹲的时候重量太大，没控制住动作，把腰拉伤了。\u003c/p\u003e\u003cp\u003e伊安珊：还好旁边的几个人动作快，一起冲上去帮他扛住了杠铃。不然…\u003c/p\u003e\",\"icon\":\"\"},\"ywd6k3mju2iT1757442760865\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"ywd6k3mju2iT1757442760865\",\"child_ids\":{\"ywd6k3mju2iT1757442760865\":[]}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"8176","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"名称\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"上线时间\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"相关奖励\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"8177","is_cus