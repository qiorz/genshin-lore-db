ontents\":{}}],\"root_id\":\"\"}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"tab_name\":\"「放纵日」…——2025-08-08\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e每年生日，学员们都会比我本人还兴奋，他们爱以给教练庆生为由，准备很多高热量美食…我也就顺势把这一天定为一年一度的「放纵日」。虽然我总强调营养均衡和热量控制，但健身是马拉松，不是冲刺跑。只要心里装着这个长期目标，偶尔一顿把水煮禽肉换成油炸食品，天也塌不下来。\u003c/p\u003e\u003cp\u003e况且，大家总说「吃饱了才有力气训练」，餐后我会为各位制定加练计划的。所以今天嘛，就让我们一起痛痛快快地吃一顿吧！\u003c/p\u003e\u003cp\u003e不好，瓦雷莎已经系好餐巾准备开动了。我会尽全力帮你留一些好吃的，建议加快脚程！\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502059\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/26/75610764/9f8ca4d96864057f1a607b3955beff2c_3975863677487795941.png\\\" data-entry-name=\\\"美味的炸虾豆球\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/502059/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502059/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的炸虾豆球\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"503442\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/19/75610764/38901eb23edfbb2ca38610e659d356f9_5244903875366571798.png\\\" data-entry-name=\\\"火山蛋糕\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/503442/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/503442/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e火山蛋糕\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502088\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/8912764/fcfe8881293a256d4ffed108ff85203f_5597273885124026878.png\\\" data-entry-name=\\\"金牌健康餐\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/502088/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502088/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e金牌健康餐\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/aa071aa247fb02a6aec365d14e291c3b_6881279417662024072.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/aa071aa247fb02a6aec365d14e291c3b_6881279417662024072.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/67273000\\\" target=\\\"_blank\\\"\u003e伊安珊生日快乐｜这只小突角龙分给你，我就扛这只大的好啦。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"来健身吗？——2026-08-08\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e「好久没见了，今天有空来健身吗？」\u003c/p\u003e\u003cp\u003e很多学员跟我说，他们一听到这句话就头皮发紧，冷汗直冒…你也会有同感吗？\u003c/p\u003e\u003cp\u003e从前我坚信，严苛的训练虽然辛苦，但长期坚持带来的益处绝对值得。可最近我才发觉，要求定得太高，反而会在无形中压垮人，越往后越难坚持下去。\u003c/p\u003e\u003cp\u003e看来我的训练风格也得适时调整了。我打算往课表里加些「轻量级」的运动，哪怕只是饭后散步十分钟，或者睡前做几组简单的拉伸，这些都算有效锻炼。\u003c/p\u003e\u003cp\u003e你还有别的建议吗？既然来都来了，顺便做几组，我帮你纠正动作！\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502059\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/26/75610764/9f8ca4d96864057f1a607b3955beff2c_3975863677487795941.png\\\" data-entry-name=\\\"「角逐」的指引\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"https://baike.mihoyo.com/ys/obc/content/501925/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"https://baike.mihoyo.com/ys/obc/content/501925/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「角逐」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502088\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/8912764/fcfe8881293a256d4ffed108ff85203f_5597273885124026878.png\\\" data-entry-name=\\\"金牌健康餐\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/502088/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502088/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e金牌健康餐\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/10/50494840/474e175d0828b5ee234ca5a39a7589b0_5331015680553745308.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/10/50494840/474e175d0828b5ee234ca5a39a7589b0_5331015680553745308.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/77279654\\\" target=\\\"_blank\\\"\u003e伊安珊生日快乐 | 按照我的标准做，绝对能强身健体，精神百倍\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"3ioyevtbggtT1757442760884\",\"child_ids\":{\"2htnk6fy7gxT1757443216841\":[],\"3ioyevtbggtT1757442760884\":[\"cw03v8lzhwT1757442959228\",\"gdb03dwu8jT1757442960160\",\"qnelxqehfglT1757442961183\",\"sxemimoua2bT1757442962042\",\"9qkgbuqbzz7T1757442963414\"],\"7xbt2yz6b5iT1757443071533\":[],\"8kqloigz7qiT1757443171887\":[],\"9qkgbuqbzz7T1757442963414\":[],\"cw03v8lzhwT1757442959228\":[\"7xbt2yz6b5iT1757443071533\",\"zmni5hh5u09T1757443072682\"],\"d02d072xxufT1757443103453\":[\"q2im06jf0uT1757443111271\",\"sz8lcn2gvxT1757443118905\"],\"gdb03dwu8jT1757442960160\":[\"ltpuljn41ehT1757443092669\"],\"jpiypdlhbqT1757443160156\":[],\"k7d7dti3f17T1757443148326\":[\"jpiypdlhbqT1757443160156\",\"8kqloigz7qiT1757443171887\"],\"ltpuljn41ehT1757443092669\":[\"d02d072xxufT1757443103453\"],\"lzs4pp78oqkT1757443207706\":[\"2htnk6fy7gxT1757443216841\"],\"q2im06jf0uT1757443111271\":[\"k7d7dti3f17T1757443148326\"],\"qnelxqehfglT1757442961183\":[\"t2ow85zvu0jT1757443192081\"],\"sxemimoua2bT1757442962042\":[],\"sz8lcn2gvxT1757443118905\":[\"k7d7dti3f17T1757443148326\"],\"t2ow85zvu0jT1757443192081\":[\"zdc70njsjcbT1757443197845\"],\"zdc70njsjcbT1757443197845\":[\"lzs4pp78oqkT1757443207706\"],\"zmni5hh5u09T1757443072682\":[]},\"contents\":{\"2htnk6fy7gxT1757443216841\":{\"option\":\"【好，我答应你。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你。那么现在，我们一起来闭目冥想吧。不要闭着眼睛偷懒，这可瞒不过本教练。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"3ioyevtbggtT1757442760884\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊，旅行者，原来你住在这样的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我可以四处逛一逛吗？你知道的，我不是那种喜欢呆站着的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7xbt2yz6b5iT1757443071533\":{\"option\":\"【好啊？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，那我得认真规划一下了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e首先器材就得仔细选选，很多人健身时伤到身体就是因为用了不趁手的器材。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这样吧，先等一段时间，我直接找熟人给你定做一套。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8kqloigz7qiT1757443171887\":{\"option\":\"【请教练指导。】  \",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e健身是一种坚持，不是一个结果哦。你基础不错，那是值得肯定的好事，但也不要输给岁月和松懈感啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"9qkgbuqbzz7T1757442963414\":{\"option\":\"【晚安，伊安珊。】——【夜晚】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，早睡早起是个好习惯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cw03v8lzhwT1757442959228\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很不错，空气清新，有益身心。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，我好像没看到专门用来锻炼的地方啊…要不我帮你搭一间健身房？设计图还有器材的事都可以交给我去办。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"d02d072xxufT1757443103453\":{\"option\":\"【往年的课程安排不能用吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你大概是觉得健身的方法大体类似？每年的新人都有这种想法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e旅行者，不妨先回答本教练一个问题，你健身的时候更关注哪一点？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gdb03dwu8jT1757442960160\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么了？伊安珊在发愁吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊…抱歉。我在思考下一批学员的课程该怎么安排。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jpiypdlhbqT1757443160156\":{\"option\":\"【我现在就足够健壮了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e健身是一种坚持，不是一个结果哦。你基础不错，那是值得肯定的好事，但也不要输给岁月和松懈感啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"k7d7dti3f17T1757443148326\":{\"option\":\"【原来当健身教练这么辛苦…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么会，我乐在其中。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我的古名是「力量」，而健身本质上就是一种通过自身努力获得力量的过程。它与天赋关系不大，更看重每个人付出的汗水。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e指导过的学员越多，我对这个古名的理解就越深刻呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e话说回来，你对健身感兴趣吗？我正好可以帮你也制定一套健身计划。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ltpuljn41ehT1757443092669\":{\"option\":\"【课程？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，健身课程。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e健身是我们部族的特色文化之一，作为沃陆之邦健身俱乐部的总教练，我有义务指导新人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"lzs4pp78oqkT1757443207706\":{\"option\":\"【伊安珊的话肯定没问题。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…其实，比起俱乐部的新人，我可能更容易在这方面出问题。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我有段时间很喜欢突破身体极限的感觉，总想着多做几个俯卧撑，多做几组卧推，每次打破之前的记录都会开心很久…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在想来，这是否也是一种「把石球推上山」的欲望呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e旅行者，作为朋友，我想请求你一件事。如果哪一天我真的受到了「力量的诅咒」，陷入了某种执念，请一定要把我拉回来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e以你的实力，肯定可以办到。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"q2im06jf0uT1757443111271\":{\"option\":\"【运动。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那就以此为例，总有新人认为所有健身运动都是一套大差不差的流程，按这个流程去做就能练出一身肌肉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其实每个人的情况都不一样，我指定的运动计划也必须随之做出改变。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果一个学员体型较胖，我就会推荐他尝试慢跑之类的有氧运动，先把体脂降下来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果一个学员体型较瘦，我就会推荐他先从推拉等基本的力量训练做起，增肌是第一要务。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是所有人都按同一套流程来，免不了会有人受伤。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就是这样，每换一批学员，课程安排就得跟着换…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"qnelxqehfglT1757442961183\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我偶尔会闭目冥想，进行精神上的锻炼，从烟谜主那里学来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"sxemimoua2bT1757442962042\":{\"option\":\"【早啊，伊安珊。】——【白天】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早啊，旅行者。不要忘记吃早餐，这对一整天的营养均衡很重要。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"sz8lcn2gvxT1757443118905\":{\"option\":\"【营养。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那就以此为例，总有新人认为所有健身运动都是一套大差不差的流程，按这个流程去做就能练出一身肌肉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其实每个人的情况都不一样，我指定的运动计划也必须随之做出改变。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果一个学员体型较胖，我就会推荐他尝试慢跑之类的有氧运动，先把体脂降下来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果一个学员体型较瘦，我就会推荐他先从推拉等基本的力量训练做起，增肌是第一要务。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是所有人都按同一套流程来，免不了会有人受伤。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就是这样，每换一批学员，课程安排就得跟着换…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"t2ow85zvu0jT1757443192081\":{\"option\":\"【健身还需要锻炼精神吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…先听我讲个故事吧，旅行者。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很久之前，沃陆之邦出现过一位大力士。他热爱健身，并且十分喜欢展现自己的力量。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一开始是参加举重比赛，后来是与突角龙角力，最后甚至正面挑战长颈角犀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那时的他已经成为全纳塔公认的大力王，但他仍旧不满足，并宣布了一个疯狂的计划——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他要推着一块巨石爬上圣山，彻底堵死火山口，以此证明自己战胜了圣山的伟力。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了完成这个目标，他无所不用其极，甚至不惜使用危险的药物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到了约定的那一天，他果真找来了一个小山一样大的石球，开始推着它攀登圣山。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然而爬到半山腰时，圣山忽然喷发，山体震颤起来。他不小心跌倒，被滚落的石球压死。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e讽刺的是，只有小山一样大的石球才有可能压死他，反过来也只有他这位大力士才能把那么大的石球推上陡峭的半山腰。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最终，他是死于自己最想展示的「力量」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zdc70njsjcbT1757443197845\":{\"option\":\"【还有这种事…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e健身是一种获得力量的过程，也是一种学习驾驭力量的修行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e精神的锻炼不过关，很容易变成「力量」的奴隶。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zmni5hh5u09T1757443072682\":{\"option\":\"【外出探险就是我的锻炼。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这样说倒也没错…每个人对健身的喜好都不一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不是所有人都喜欢跟器材较劲，爬爬山，去田野里跑几个来回，这些运动方式确实更适合你这样的旅者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/e3d69b4d83f8ef6d45a5140e87fcfff7_7391227467984878051.png\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色赠礼","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"同伴赠礼\",\"header\":[\"好感套装\",\"对应奖励\",\"好感套装对话\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"505162\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/0291f223284c06df0692f6944b6a0225_2745627140479188358.png\\\" data-entry-name=\\\"于最灼热的炉火中诞生\\\" data-entry-link=\\\"/ys/obc/content/505162/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/505162/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/0291f223284c06df0692f6944b6a0225_2745627140479188358.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan 