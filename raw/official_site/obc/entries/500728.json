order":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉…我不能一辈子只做普普通通的口粮茶…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e口粮茶大多被饭店当成招待客人的第一杯茶，和白开水没什么区别…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是辛辛苦苦栽培出来的茶叶只有这种水准，那我干茶农这行还有什么意义？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾葛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不至于吧？你师父又说什么了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…前两天，他说我可以出师了，但我感觉，他的意思是我没救了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他说的时候甚至没有多看我一眼！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾葛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我倒是觉得你想多了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你师父素来对弟子要求很严格，不可能放任水平不够格的弟子出师，坏了他的名声。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定他没和你说什么，正是因为他对你彻底放心了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有，有这回事吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾葛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e再说了，你也没必要那么心急！你才干这行不到十年，比不过那些大师的作品很正常！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e以我们现在的年龄，在各自的行业里，肯定不可能有多出彩的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看我编的茶筐，不也普普通通的？我倒是觉得挺好的，起码每天做工轻轻松松。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你过得不累，我倒是挺宽心的，但我自己种的茶叶才不能普普通通！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还得再想想办法，尽快提高茶叶的品质…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾葛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那之前说好的，一起出去旅行…要等到什么时候？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就等我下次的二茬茶叶收成，看看品相…品相有明显进步我们就出发！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾葛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那要是品相没长进呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【衡听】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然是再等一茬！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1720543251","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":