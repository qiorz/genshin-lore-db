ntents\":{\"d5teumgnmejT1786989501293\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"d5teumgnmejT1786989501293\"},{\"child_ids\":{\"k8zmglqqcjT1786989826639\":[]},\"contents\":{\"k8zmglqqcjT1786989826639\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【北斗、枫原万叶】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e北斗：几日不见，小子，你的牌技怎么长进这么多？\u003c/p\u003e\u003cp\u003e枫原万叶：多亏和高人交过手。\u003c/p\u003e\u003cp\u003e北斗：哦？哪位高人？你先别急着说…让我猜猜。\u003c/p\u003e\u003cp\u003e北斗：凝光那家伙没这个闲心，香菱和辛焱也不是一直琢磨牌的人…\u003c/p\u003e\u003cp\u003e北斗：瑶瑶最近要是不忙，早耐不住往船上跑，和大家打招呼了。也不会是她。\u003c/p\u003e\u003cp\u003e北斗：难道是旅行者？她刚巧也来璃月港了？\u003c/p\u003e\u003cp\u003e枫原万叶：可惜大姐头还是猜的不对。我的确和旅行者同行了一阵，期间也「以牌会友」…\u003c/p\u003e\u003cp\u003e北斗：新朋友？那我就猜不出了。\u003c/p\u003e\u003cp\u003e枫原万叶：往生堂堂主，胡桃小姐。大姐头可有耳闻？\u003c/p\u003e\u003cp\u003e北斗：听倒是听说过。这次拿了「召唤王大奖赛」冠军的也是她吧？\u003c/p\u003e\u003cp\u003e枫原万叶：正是。她还说对大姐头崇拜已久，一直想跟你交个朋友。\u003c/p\u003e\u003cp\u003e北斗：那好啊！这不是正好吗？\u003c/p\u003e\u003cp\u003e北斗：把她请来船上，切磋上几局，让我仰望仰望冠军的风采。\u003c/p\u003e\u003cp\u003e北斗：唔…这么说来，是不是还是我亲自去往生堂，显得比较有诚意？\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"k8zmglqqcjT1786989826639\"}],\"root_id\":\"\"}\n","style":""}],"id":"9597","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787019324","langs":[],"template_layout":{"tab":[{"tab_id":"524","tab_name":"活动介绍","module_group":[{"module_group_id":"2716","layout":"l2r1","module":[{"id":"8981","pos":"banner"},{"id":"8979","pos":"left"},{"id":"8980","pos":"right"},{"id":"8910","pos":"left"},{"id":"8911","pos":"left"},{"id":"9597","pos":"left"},{"id":"8912","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"105","name":"活动","has_page