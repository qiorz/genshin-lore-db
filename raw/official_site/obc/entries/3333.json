003cli\u003e\u003cp\u003e珊瑚社长虽然脾气不好，但是为人正派善良，你可以相信她的能力。我当年的冤屈，多亏了她才得以洗清。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我以前是奉行所的捕快，被人栽赃陷害到革职。若不是珊瑚社长智慧惊人，如今的我还不知道会流落到什么地步呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e事情解决后，见我当时穷困潦倒，社长也没有要我付报酬，还答应了我想当她助手的请求。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我现在一身清白，还能为珊瑚社长卖命，真是雷神保佑啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"4l7b7au9vrlT1757164593204\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有新线索随时联系，再会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e需要我去调查的话，请讲。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ly2p1n1f0dT1751267283662\":{\"icon\":\"\",\"option\":\"【工作忙吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如今稻妻的情况，你应该也有所耳闻吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e奉行所么也有靠不住的地方。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e珊瑚社长负责动用她的智慧，那我就负责用我的体力来支援她啦。总之世事多变，事项纷杂，总要一件一件做完。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"834\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/a28104baf04e93246d2fe4fb0e0e90ab_2677734073457321193.png\\\" data-entry-name=\\\"「勤劳」的指引\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/834/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/834/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/a28104baf04e93246d2fe4fb0e0e90ab_2677734073457321193.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「勤劳」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手六级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好，我知道怎么破局了。之后就用你这套牌组去应付珊瑚社长吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咦，赢了，我赢了吗？啊，其实我还没弄清楚规则，这个牌局是珊瑚社长设的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【关于委托…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e委托的情况请与珊瑚社长详谈，之后的情报搜集就交给我吧，让我去哪就去哪。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e叫我竹生或者龙…不，还是叫我龙二吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然竹生是我的本名，但珊瑚社长总是嫌弃不够硬派，所以坚持称我为龙二。我虽然苦恼…但还是听她的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1757297788","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":