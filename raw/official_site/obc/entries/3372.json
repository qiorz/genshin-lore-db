":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"og6on2k80gdT1747301077039\":[],\"wwdt74yb3m8T1747301080129\":[],\"z2tn3pzsbujT1710863943430\":[\"og6on2k80gdT1747301077039\",\"wwdt74yb3m8T1747301080129\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e嗯，先不要打岔…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e啊！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e你能别突然搭话吗，把我吓了一跳…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e我原本都做好决定了，被你一吓又不知道该怎么办了…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【关于岩王帝君的死…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e唉，你说我们这些做生意的该向谁祈福啊？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e岩王爷走了，以后做生意也没法参考岩王爷的神谕了，对我这种性格的人来说无异是灭顶之灾啊！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e算了，和你说这些也没用，我还是再想想要不要把钱存起来吧…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"og6on2k80gdT1747301077039\":{\"option\":\"【就存起来？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e可是可是，如果要是存起来，说不定会错过一大波商机啊…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e唉，你是不知道，在岩王爷的地盘上做买卖还是挺赚钱的…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e要是拿着这笔钱去做生意、赚更多的钱，说不定哪天都可以把船换成凝光大人那样的款式…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"wwdt74yb3m8T1747301080129\":{\"option\":\"【要不别先存？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e可是可是，如果做生意赔了，那我真是血本无归了…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e而且现在七星正在对市场的动向进行调控，如果要是万一不小心跟错了方向…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e唉，那我努力了小半辈子的血汗钱就全都打水漂了…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你在干什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e唉，我只是一个平凡的跑船人，辛苦了小半辈子攒了些钱，现在正在犹豫要不要把钱存起来…\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e你说，我是把钱存起来好，还是不存比较好呢？\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1752632435","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"N