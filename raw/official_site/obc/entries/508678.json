0966702623094.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"1080\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 1080px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/21/50494840/4627228c75011047c4779a6eaf5cd54b_8959680966702623094.png\\\" style=\\\"width: 1080px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8980","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻友绮旅","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/21/50494840/e065a06e6f33f791d792873b1f0315ee_5413323449212052326.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"690\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 690px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/21/50494840/e065a06e6f33f791d792873b1f0315ee_5413323449212052326.png\\\" style=\\\"width: 690px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8981","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色对话彩蛋","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"1adykb6915rT1779621696005\":[\"52q51xjx59bT1779622055882\",\"hxxvqg94wwiT1779622056698\"],\"52q51xjx59bT1779622055882\":[\"6qg4da4ehamT1779622057894\"],\"6qg4da4ehamT1779622057894\":[],\"hxxvqg94wwiT1779622056698\":[\"6qg4da4ehamT1779622057894\"],\"kytz9q85t7rT1779338253963\":[\"1adykb6915rT1779621696005\"]},\"contents\":{\"1adykb6915rT1779621696005\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【可莉、瑶瑶、七七、早柚】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e可莉：大家，小魔女会已经创办3天了！距离100天还有·还有…唔…不会算。\u003c/p\u003e\u003cp\u003e可莉：但是距离10天还有7天！10哦，要两只手都用上才能数得完的大数字哦！\u003c/p\u003e\",\"icon\":\"\"},\"52q51xjx59bT1779622055882\":{\"option\":\"旅行者：真热闹呀。\",\"dialogue\":\"\",\"icon\":\"\"},\"6qg4da4ehamT1779622057894\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e瑶瑶：上次在雪山见过早柚和可莉后，我们就约定好要一起出来玩了。\u003c/p\u003e\u003cp\u003e瑶瑶：最近收到早柚的邀请，我就立刻去请示师父和白术先生，他们都同意我带着七七过来交朋友。\u003c/p\u003e\u003cp\u003e七七：没来过的地方，樱花，好看。红红的女孩很爱笑，会睡觉的女孩，唔…很会睡觉。\u003c/p\u003e\u003cp\u003e派蒙：可莉呢？可莉是自己来的吗？\u003c/p\u003e\u003cp\u003e可莉：可莉来过稻妻，可莉认识路！妈妈说了，可莉会长大，会有自己的世界，她很支持可莉来找朋友玩！\u003c/p\u003e\u003cp\u003e可莉：阿贝多哥哥和小杜林哥哥送我上船，船上有很多冒险家哥哥姐姐陪着可莉，下船，早柚就在码头等着可莉啦。\u003c/p\u003e\u003cp\u003e早柚：哼哼。这次聚会是终末番对我执行了高难度任务的嘉奖！那位大人批了假期和经费，还让巫女姐姐帮忙招待过来的朋友。\u003c/p\u003e\u003cp\u003e派蒙：真好啊。看到你们几个玩得这么好，不知道为什么，有种很幸福的感觉…\u003c/p\u003e\u003cp\u003e可莉：好多朋友，就像好多嘟嘟可一样，可莉很开心！\u003c/p\u003e\",\"icon\":\"\"},\"hxxvqg94wwiT1779622056698\":{\"option\":\"旅行者：小魔女们为什么会聚在稻妻？\",\"dialogue\":\"\",\"icon\":\"\"},\"kytz9q85t7rT1779338253963\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第一阶段\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【布伦妮】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e布伦妮：爆米花是吧，你快回忆一下，是不是被一个长得很好看的女人抓过来的？\u003c/p\u003e\u003cp\u003e爆米花：撞翻眼泪虫！炸！炸飞！\u003c/p\u003e\u003cp\u003e布伦妮：想起来了？你也不能原谅她对吧！没猜错的话她就是所谓的面团大王。\u003c/p\u003e\u003cp\u003e爆米花：踢飞鼻涕怪！炸！炸飞！\u003c/p\u003e\u003cp\u003e布伦妮：那你有没有见过一只长得很可爱的小狗？它也是幻想朋友。\u003c/p\u003e\u003cp\u003e爆米花：炸！炸飞！统统装进大麻袋！\u003c/p\u003e\u003cp\u003e布伦妮：什么嘛…根本不是在回答我啊…\u003c/p\u003e\u003chr\u003e\",\"icon\":\"\"}},\"root_id\":\"kytz9q85t7rT1779338253963\"},{\"child_ids\":{\"ke6hrkgxlzT1779622237106\":[]},\"contents\":{\"ke6hrkgxlzT1779622237106\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第二阶段\u003c/h1\u003e\u003cp\u003e无\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"ke6hrkgxlzT1779622237106\"},{\"child_ids\":{\"0zjmzu8jeaoeT1780028006814\":[],\"wukryh46wvT1780027911044\":[\"0zjmzu8jeaoeT1780028006814\"]},\"contents\":{\"0zjmzu8jeaoeT1780028006814\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【可莉、瑶瑶、七七、早柚】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e瑶瑶：早柚，原来大礼貉这——么——大啊。\u003c/p\u003e\u003cp\u003e早柚：嗯哼。而且肚皮还很软哦，在它肚皮上睡觉很舒服。\u003c/p\u003e\u003cp\u003e七七：也很高。比早柚高。\u003c/p\u003e\u003cp\u003e早柚：呜…你怎么能说出这么冰冷的话…\u003c/p\u003e\u003cp\u003e可莉：可莉来温暖大家，轰轰火花——\u003c/p\u003e\",\"icon\":\"\"},\"wukryh46wvT1780027911044\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第三阶段\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【布伦妮】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e布伦妮：你的意思是…这一切都是误会？\u003c/p\u003e\u003cp\u003e德斯卡戴：……\u003c/p\u003e\u003cp\u003e布伦妮：啊…可恶啊！那就更可恶了！竟敢耍我！\u003c/p\u003e\u003cp\u003e德斯卡戴：……\u003c/p\u003e\u003cp\u003e布伦妮：谁说我后悔了…不后悔跑这一趟…更不后悔加入小魔女会。\u003c/p\u003e\u003chr\u003e\",\"icon\":\"\"}},\"root_id\":\"wukryh46wvT1780027911044\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"9597","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1780031581","langs":[],"template_layout":{"tab":[{"tab_id":"524","tab_name":"活动介绍","module_group":[{"module_group_id":"2716","layout":"l2r1","module":[