70\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"ud6n5nnisfT1746926097060\",\"w585t05owuT1746926099041\",\"m74dsqrt31nT1746926099827\"],\"m74dsqrt31nT1746926099827\":[],\"mk1ca6tpinT1746926541610\":[],\"ud6n5nnisfT1746926097060\":[],\"w585t05owuT1746926099041\":[\"mk1ca6tpinT1746926541610\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e欢迎，客人要看看商品吗？\u003c/p\u003e\",\"icon\":\"\"},\"m74dsqrt31nT1746926099827\":{\"option\":\"【先不用了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没关系，有空来聊聊天也好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"mk1ca6tpinT1746926541610\":{\"option\":\"【只听不买没关系吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然没关系。有人愿意在我的摊位前停留，难道不是招揽顾客的最佳方式吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e托这个的福，我也见识了不少奇人异士呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我记得有个枫丹来的酷哥，戴副墨镜，帽子上还插着个小船锚，给人印象很深。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他话不多，但对纳塔的「古名」很感兴趣，听我杂七杂八的念叨了好久。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说来惭愧，我当时说了什么自己都忘了…可能有些东西也不是很准确吧，哈哈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ud6n5nnisfT1746926097060\":{\"option\":\"【有新货吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这位客人，本店的商品，当然是「旧」的比较好啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/11/76362111/11ee64c710e3b091256c0d349ac55461_6532656316327451730.png\"},\"w585t05owuT1746926099041\":{\"option\":\"【这里是卖什么的？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一些冒险的成果，也是一些先驱者的成就。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的是我自己搜罗来的小玩意儿，还有些是别人送来的。所以能买到什么，就看客人你的眼力咯！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，客人如果有感兴趣的商品，也可以先交个定金，拿给龙遗物协会去鉴定一下，再决定买不买。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过以他们的专业程度…哈哈，我也说不准啦。拿给他们看，还不如听我多讲几个小故事呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1747018135","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"v