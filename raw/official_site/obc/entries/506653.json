omize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1370","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/21/80663279/1c03a1f949ede4f869964ea508a2ac00_1272457013553845232.png\"},{\"tab_name\":\"任务结束地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/21/80663279/1c03a1f949ede4f869964ea508a2ac00_3499082881613777994.png\"}]}\n","style":""}],"id":"8428","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1371","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"8427","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1372","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"gx3iqxy4m6iT1758427227246\",\"child_ids\":{\"00ugxwoji88xT1758438621779\":[\"zsm800ainpT1758438628291\"],\"gx3iqxy4m6iT1758427227246\":[\"ofwnib824cgT1758438621452\",\"00ugxwoji88xT1758438621779\"],\"ofwnib824cgT1758438621452\":[\"zsm800ainpT1758438628291\"],\"zsm800ainpT1758438628291\":[]},\"contents\":{\"00ugxwoji88xT1758438621779\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：我好像被吹到奇怪的地方去了…\"},\"gx3iqxy4m6iT1758427227246\":{\"dialogue\":\"\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e想办法离开奇怪的空间\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：呜呜，终于找到你了，旅行者！刚才那两个发光的东西撞到一起以后，我就被爆炸的冲击波给吹飞了，还好没受伤…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：我飞了好久才飞回这里来…你没事真是太好了！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ofwnib824cgT1758438621452\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：原来如…欸？等等，为什么是飞？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：其实我也飞了好久…\"},\"zsm800ainpT1758438628291\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e向派蒙讲述了刚才见到的景象…\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：唔，我完全没听说过提瓦特还有那样的地方…旅行者，你该不会是看到了什么奇怪的幻觉吧？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：不过，只要你平安无事就好啦！这地方搞不懂的事情实在是太多了，我们还是早点离开吧…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：呜啊，没想到居然是那么危险的东西，而且到头来也没找到什么宝藏…究竟为什么会出现在这里呢？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：而且，既然那两个发光的家伙不是仙灵，那又会是什么东西呢…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}}}]}\n","style":""}],"id":"8426","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"4059","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"390\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/17/317305234/6ee632dc08f8146408597e4b9001fa98_5267551538414350250.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"250\\\" data-entry-link=\\\"无\\\" data-entry-status=\\\"Online