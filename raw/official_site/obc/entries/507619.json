witch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"ewllh0qqr0dT1711546416025\",\"child_ids\":{\"ewllh0qqr0dT1711546416025\":[]},\"contents\":{\"ewllh0qqr0dT1711546416025\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003cspan\u003e宵宫似乎正在寻找你们…\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与宵宫对话\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e宵宫：旅行者！没想到在蒙德碰上了你。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：这还是我第一次来这么冷的地方呢，所有的体验都很新奇。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：打雪仗啊，堆雪人啊，哦对了，还有漫画！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：没想到，在稻妻流行的作品《炽魂斗士战记》，在这里也有读者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：我和几个纳塔来的朋友聊漫画聊得可开心了，一时手痒，还做了一块漫画角色立牌。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：对了，你听说过《炽魂斗士战记》吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan\u003e和宵宫聊了聊「炽魂斗士特攻队」的事…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：竟然这么巧，你的朋友也喜欢这部漫画，好奇妙的缘分。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e宵宫：那这块立牌就送给你们吧，炽魂斗士菲耶蒂娜，正好配「炽魂斗士特战队」。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1768790346","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"传说任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"世界任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"限时任务\\\",\\\"childr