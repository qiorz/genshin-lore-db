{"retcode":0,"message":"OK","data":{"page":{"id":"2460","name":"阿创【「天目锻冶屋」学徒】","desc":"阿创【「天目锻冶屋」学徒】","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2021/07/29/49984918/57ff9a3e7d27df4959228f4171172eeb_8128947583826419202.jpg","header_img_url":"","modules":[{"name":"阿创","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e在稻妻的刀锻冶中，有着雷电五传之说，「天目流」是其中一传。不屑于那些装神弄鬼的锻造秘法，只是一味投入无限的热情和意志力，每一件作品都可以说是贯彻了稻妻的武道，这便是「天目流」！\u003c/p\u003e\"],\"key\":\"编者注：\"}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/29/49984918/b0df44733581c0f284d4226db1c86375_6895156619582212652.jpg\",\"attr\":[{\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"],\"key\":\"性别\"},{\"value\":[\"\u003cp\u003e稻妻城\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e铁匠铺\u003c/p\u003e\"],\"key\":\"功能\"},{\"value\":[\"\u003cp\u003e「天目锻冶屋」学徒\u003c/p\u003e\"],\"key\":\"职业\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/29/49984918/d38c14c2ae70239b4554ceb870e0d4f7_8133676156669544417.jpg\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/19/192134014/a08db2268ab31ba4073f5a90658f8712_4145863711353963944.jpg\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"锻造列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003