c05e64267c629bd588_8433549590102860932.png\\\" data-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（言笑的喧闹厨房）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，祝你旅途顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果这个世界上真的有能治好一切病症的灵丹妙药就好了，那我一定会不惜一切代价…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的妻子青莲天生就体弱多病，前段时间更是大病了一场，直到现在都还没有康复…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e作为一名水手，我始终觉得是我常年出海在外没有好好陪她，好好照顾她的原因…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如今我决定离开大海，来到山上为她采药，只要能够补偿她一点，我什么都愿意做。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你在发愁什么？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e还好吧，进山采药难免会有些疲劳，幸好青莲准备了一些树莓。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这甘甜的味道，确实有一种疲劳被一扫而空的感觉。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我一个人吃不完，话说你还要继续旅行吧？不如你也备上一些，别客气拿去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"769\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/13/24077343/a8d91df9b2ca3257da3549bd714092fc_8300133397586808476.png\\\" data-entry-name=\\\"树莓\\\" data-entry-amount=\\\"6\\\" data-entry-link=\\\"/ys/obc/content/769/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/769/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/13/24077343/a8d91df9b2ca3257da3549bd714092fc_8300133397586808476.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e树莓\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*6\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/27/76362111/b26706122e54335e75a99308e473cc62_2969931316359700230.png\",\"option\":\"【你好像很疲劳？】——获得树莓*6\"}},\"list\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1722500834","langs":[],"template_layout":{"