4/04/07/317305234/41a53cbf3d3742b30dd4261689b9e6fc_2077323609448369838.png\\\" data-entry-name=\\\"酒庄大扫除\\\" data-entry-link=\\\"/ys/obc/content/1264/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1264/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e酒庄大扫除\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e每日委托：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1132\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/26/76953456/79b77eeb63503f854da4815f8e46ee89_5600896855100014414.png\\\" data-entry-name=\\\"酒庄大扫除之二\\\" data-entry-link=\\\"/ys/obc/content/1132/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1132/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e酒庄大扫除之二\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1shoki4z8t9T1721813267972\":[\"u2lt1pkkalbT1721813277096\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"f89gjzdpq08T1721813261425\":[\"1shoki4z8t9T1721813267972\"],\"nqb471m7nmnT1710863941173\":[\"f89gjzdpq08T1721813261425\"],\"u2lt1pkkalbT1721813277096\":[]},\"contents\":{\"1shoki4z8t9T1721813267972\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸！不会吧，那个客人就真的…？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然是真的啊，嘘…小点声。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那天上午是我值班呀，完全没有人离开的样子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我扫除完二楼所有的客房，发现所有房间都是空的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，不会吧，好可怕…然后呢，然后呢?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e然后我问爱德琳小姐，昨晚入住的那位客人呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e爱德琳小姐没有理我，只是一边在花园浇花一边在说…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说…说什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「等到明年，这丛花会开得很艳吧？」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【上午】\u003c/strong\u003e\u003c/p\u003e\"},\"f89gjzdpq08T1721813261425\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【下午】\u003c/strong\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你有没有注意过…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e注意过什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们的钥匙都比爱德琳小姐少一把。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸…那也就是说…有秘密房间？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对吧！对吧！你果然很懂！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然后。那天我在给地板上蜡的时候，偶然发现二楼走廊的深处里还有一个隐藏房间！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真的吗！那房间果然就是…？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我靠近房门，只听到里面越来越近的「哒哒，哒哒…」的声音。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我感到很害怕令就要离开的时候，发现爱德琳小姐就在我身后!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【海莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呀——！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【摩可】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可没想到，她不仅没有责骂我，还客客气气地让我回去…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可等我回到房间才忽然想起——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个「哒哒」的声音，和爱德琳小姐穿靴子的脚步声…不是一模一样的吗?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"u2lt1pkkalbT1721813277096\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"list\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693757","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"mo