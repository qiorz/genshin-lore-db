 17, 17)\\\"\u003e● \u003c/span\u003e\u003cspan style=\\\"color: rgb(51, 51, 51)\\\"\u003e「谜丘对决」玩法中，旅行者可在秘境内挑战强敌，适时利用强敌招式或场地效果，可以更加迅速地完成挑战。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(17, 17, 17)\\\"\u003e● \u003c/span\u003e\u003cspan style=\\\"color: rgb(51, 51, 51)\\\"\u003e「探幽之行」玩法仅支持单人挑战；「谜丘对决」玩法可进行多人挑战。\u003c/span\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1312","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"流程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e关卡1-1：\u003cspan style=\\\"color: rgb(51, 51, 51)\\\"\u003e「\u003c/span\u003eNini movo muhe yoyo！ 」\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/01/4521515/80e583c283423ec9f50b8779e3d79077_800718509644315313.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\" data-image-originwidth=\\\"532\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/01/4521515/80e583c283423ec9f50b8779e3d79077_800718509644315313.png\\\" style=\\\"width: 450px; border: \\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e成功完成调查：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\