;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;草原核\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;燃烧：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;目标附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;持续燃烧\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;原激化：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;生成2层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;激化领域\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]，最多叠加\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;2\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e，2回合内，自身\u003cstrong\u003e\u003cu\u003e额外行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;额外行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;角色不会因为额外行动而获得充能。 \u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e次数+1，附属\u003cstrong\u003e\u003cu\u003e元素附魔：草\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素附魔：草：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;所附属角色造成的\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;物理伤害\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;变为\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;草元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;物理伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;物理伤害不会附着元素，也不会发生元素反应。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;草元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着草元素，可发生元素反应\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;每点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素精通\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;使\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;特定效果\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;提升1倍。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;绽放：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;生成\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;草原核\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;燃烧：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;目标附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;持续燃烧\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;原激化：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;生成2层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;激化领域\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]，最多叠加\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;2\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\"]},\"tab_id\":\"1746582759431_1\"},{\"tab_name\":\"画巧则施\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/258999284/c16266bb9d15e3d2f72b5c9928d8c3da_7768445883992857981.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003cp\u003e【被动】我方的\u003cstrong\u003e\u003cu\u003e元素精通\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素精通：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;每点元素精通使得敌方受到的元素反应中\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;特定效果\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;提升1倍。 \u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e+1。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e使用技能后：\u003c/strong\u003e对随机敌方造成己方\u003cstrong\u003e\u003cu\u003e草原核\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;草原核：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;出战状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;触发绽放反应时：\u0026lt;/strong\u0026gt;对随机敌方造成自身层数三分之一的\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;穿透伤害\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方造成\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;火元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;后：\u0026lt;/strong\u0026gt;对敌方全体造成自身层数的\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;火元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，然后消灭自身。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方造成\u0026lt;span style=\u0026quot;color: rgb(146, 84, 222)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;雷元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;后：\u0026lt;/strong\u0026gt;对敌方生命值最低2名角色造成自身层数的\u0026lt;strong\u0026gt;穿透伤害\u0026lt;/strong\u0026gt;，然后消灭自身。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;（可叠加，没有上限）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;穿透伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;穿透伤害无法受到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;火元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着火元素，可发生元素反应\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;每点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素精通\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;使\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;特定效果\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;提升1倍。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;蒸发：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害翻倍，每8点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素精通\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;额外翻1倍\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;融化：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害翻倍，每8点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素精通\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;额外翻1倍\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超载：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;伤害+\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;，目标切换到上一个角色，他们交换位置并受到\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;燃烧：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;目标附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;持续燃烧\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(114, 46, 209)\u0026quot;\u0026gt;雷元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着雷元素，可发生元素反应\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;每点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素精通\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;使\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;特定效果\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;提升1倍。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超载：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;伤害+\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;，目标切换到上个角色，他们交换位置并受到\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超导：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;所有敌方角色附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;冻伤\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;感电：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;所有敌方角色受到\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;原激化：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;生成2层[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;激化领域\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]，最多叠加\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(250, 219, 20)\u0026quot;\u0026gt;2\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;层\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e层数六分之一的\u003cstrong\u003e\u003cu\u003e穿透伤害\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;穿透伤害：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;穿透伤害无法受到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。 \u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cstrong\u003e。\u003c/strong\u003e\u003c/p\u003e\"]},\"tab_id\":\"1746582883047_2\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6497","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"召唤物","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"召唤物\",\"layout_\":\"left\",\"list\":[{\"tab_name\":\"默认标题\",\"skill_type\":\"\",\"icon\":\"\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},\"tab_id\":\"1730815724349_0\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6498","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e自行巧局\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"6537","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"list\":[{\"tab_name\":\"预算师的技艺\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/22/258999284/10ea9432a97b89788ede72906f5af735_2900270216620323771.png\",\"life\":3,\"life_bg\":2,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;战斗行动：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e：我方出战角色为\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e卡维\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e时，装备此牌。\u003cbr/\u003e卡维装备此牌后，立刻使用一次\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e画则巧施\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;画则巧施：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;元素战技\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;造成2点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(82, 196, 26)\u0026#34;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;，生成\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;迸发扫描\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。\u003cbr/\u003e装备有此牌的卡维在场，我方触发\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e迸发扫描\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;迸发扫描：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;出战状态\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;双方选择行动前：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;如果我方场上存在草原核或丰穰之核，则使其\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;可用次数\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;-1，并\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;舍弃\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;我方牌库顶的1张卡牌。然后，造成所\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;舍弃\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;卡牌当前元素骰费用的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(82, 196, 26)\u0026#34;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;可用次数：1（可叠加，最多叠加到3次）\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e的效果后：将1张所\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e舍弃\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;