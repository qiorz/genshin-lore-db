c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7132\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/08/21/183046623/79b77eeb63503f854da4815f8e46ee89_5607193834461311160.png\\\" data-entry-name=\\\"枫丹廷，二三事\\\" data-entry-link=\\\"/ys/obc/content/7132/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/7132/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e枫丹廷，二三事\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"3zlui133anmT1739370869750\":[],\"4cf2vhylew3T1710863944349\":[],\"5473wr8qumnT1739370855918\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"5473wr8qumnT1739370855918\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"3zlui133anmT1739370869750\"]},\"contents\":{\"3zlui133anmT1739370869750\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看来您是位非常理智的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在我这里，理智与清醒拥有不同的概念。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我非常欢迎理智的顾客，并祝福他们能度过快乐而甜蜜的一天。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7072\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/3baf4743643438c92db7483ba9d6c01b_1141222144263362308.png\\\" data-entry-name=\\\"晶螺糕\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/7072/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/7072/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/3baf4743643438c92db7483ba9d6c01b_1141222144263362308.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e晶螺糕\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/12/288180982/b26706122e54335e75a99308e473cc62_4021216286165584148.png\",\"option\":\"【谢谢，还是算了。】——获得晶螺糕*3\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如你所见，我开的是一家咖啡厅，而不是酒馆。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里常有些先生们一边休息一边高谈阔论，而我会在心中暗自祈祷他们是喝醉了才会说出那些话。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e人们在清醒时说的话，有时比醉鬼的胡闹还要荒谬呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【清醒与荒谬…】\"},\"5473wr8qumnT1739370855918\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，欢迎下次光临。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临咖啡厅·露泽，这里有最苦的咖啡，也有最甜的蛋糕，以及最清醒和最荒谬的客人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e保证每一口都像美露莘的笑容一样甜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/12/288180982/8c1682d1176d5e5c252663655f810639_1492143619022485534.png\",\"option\":\"【关于甜的…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e每位客人对咖啡都有不同口味上的偏好，而我就是那个尽力满足他们偏好的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但如果有人想要完全没有一丝苦涩的咖啡或茶，我的能力就十分有限了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e遇到这种情况，我会建议他去拜访沫芒宫或卡朗代沙龙，并与他们见到的第一位女士或先生聊聊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于苦的…】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1739370994","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基础信息","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\