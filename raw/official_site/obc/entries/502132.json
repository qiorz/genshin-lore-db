910e0eb47b42159a7fa4f3_7080236865954525228.png\\\" data-entry-name=\\\"第五章 第三幕「镜与谜烟的彼方」\\\" data-entry-link=\\\"/ys/obc/content/502979/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502979/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e第五章 第三幕「镜与谜烟的彼方」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504033\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/01/80663279/8d13718394910e0eb47b42159a7fa4f3_7610498574503476711.png\\\" data-entry-name=\\\"第五章 第五幕「炽烈的还魂诗」\\\" data-entry-link=\\\"/ys/obc/content/504033/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504033/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e第五章 第五幕「炽烈的还魂诗」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8dsh8jyg4yaT1713458263767\":[],\"8gfxrw8wla9T1710863939170\":[\"np3wfiqy1t9T1725290171568\",\"nqb471m7nmnT1710863941173\",\"wwkehndtj2hT1713365048102\",\"ywnnd4uig8oT1728742448369\",\"g8239mx8906T1736339046660\",\"qxz5x7ngbipT1713365093048\"],\"g8239mx8906T1736339046660\":[],\"np3wfiqy1t9T1725290171568\":[],\"nqb471m7nmnT1710863941173\":[],\"qxz5x7ngbipT1713365093048\":[],\"wwkehndtj2hT1713365048102\":[\"8dsh8jyg4yaT1713458263767\"],\"ywnnd4uig8oT1728742448369\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8dsh8jyg4yaT1713458263767\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那当然是我的拿手菜，塔塔可了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过这个菜做起来很简单，纳塔这边几乎人人都会。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来，伸出手来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵呵，以为我会给你成品吗？不，我要亲自教你！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502061\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/26/75610764/a19e8c4816003a337d3c3f0f214bfe63_3732607246091733855.png\\\" data-entry-name=\\\"食谱：塔塔可\\\" data-entry-link=\\\"/ys/obc/content/502061/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502061/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/26/75610764/a19e8c4816003a337d3c3f0f214bfe63_3732607246091733855.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e食谱：塔塔可\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/19/288180982/b26706122e54335e75a99308e473cc62_2740637559742047416.png\",\"option\":\"【有什么推荐吗？】——获得食谱：塔塔可*1\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e想要吃得饱、睡得好？那你来对地方了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"bql0fq8xxjnT1713365091982\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这儿是全蒙德最地道的餐馆——猎鹿人主打菜肴是“七分熟鹿排”和“满足沙拉”。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们跟清泉镇的猎户是有长期食材供应关系的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所有食材都是当日运输，确保绝对新鲜！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不客人您先看看菜单，我再给您详细推荐一下？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【「猎鹿人」是…】\"},\"g8239mx8906T1736339046660\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢关心，一切都好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…当然，也可能是不想在我面前展现出不开心的样子吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「和平」的喜悦与「失去」的伤痛是两回事，我们都知道的。只希望他们能多来我这吃吃饭、喝喝酒，我请客！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【近况如何？】——完成魔神任务 第五章第五幕「炽烈的还魂诗」后\"},\"np3wfiqy1t9T1725290171568\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咦？确实是我寄出去的订货单。没想到呀，它居然运气这么不好…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e稍后我再写一封订货单吧。这件事倒也不急。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谢谢你帮我把信带回来。看你这一身汗，来，喝点东西吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"786\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/09/8912764/3b66e7e92fdc25670bcf33561152fc90_2978093864944691298.png\\\" data-entry-name=\\\"牛奶\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/786/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/786/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/09/8912764/3b66e7e92fdc25670bcf33561152fc90_2978093864944691298.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e牛奶\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/09/02/288180982/a6ce4c0ac6aa3778657bec0f4994f6f0_3531432015562914250.png\",\"option\":\"【关于这封丢失的信…】——持有「破损的信件」时\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e来，给你菜单。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/183046623/8c1682d1176d5e5c252663655f810639_497665155361357074.png\",\"option\":\"【有什么好吃的？】——打开商店界面\"},\"qxz5x7ngbipT1713365093048\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"wwkehndtj2hT1713365048102\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是「倦意之屋」的老板，顺便在门口摆摆小吃摊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎呀，说起这家店，以前我当选手的时候还来免费住过呢，没想到现在换我来管它了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你有认识的朋友参加过归火圣夜巡礼吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的话就方便了，可以叫他带你来留宿，餐饮也是免费的，吃到你满意为止！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"},\"ywnnd4uig8oT1728742448369\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢关心，一切都好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…当然，也可能是不想在我面前展现出不开心的样子吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为旧伤，我已经帮不上他们的忙了，只好请他们多吃几顿了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 第五章第五幕「炽烈的还魂诗」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【近况如何？】——完成魔神任务 第五章第四幕「命定将焚的虹光」后\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，自从风魔龙出现后，大家都没心情吃饭了，生意比以前差了很多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e即便是来用餐的客人，也总是唉声叹气的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过这也很正常吧，只能希望龙灾尽快结束了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 序章第三幕「巨龙与自由之歌」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第一幕「捕风的异乡人」后\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1736389443","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"18