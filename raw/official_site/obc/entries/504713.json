[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"hh6pjuo33vvT1742358972058\":[\"n262b9sc14jT1742359022315\"],\"hhe5qbb5syjT1742358953447\":[\"hh6pjuo33vvT1742358972058\"],\"n262b9sc14jT1742359022315\":[],\"nqb471m7nmnT1710863941173\":[\"hhe5qbb5syjT1742358953447\"],\"z2tn3pzsbujT1710863943430\":[\"n262b9sc14jT1742359022315\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(59, 66, 85)\\\"\u003e欢迎，这位音乐爱好者！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"hh6pjuo33vvT1742358972058\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，当一家店的服务宗旨是尽量满足客户的需求时，生意应该不会不好的吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然我开店也没有很久，但这是我赚钱的经验之谈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1024\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/81f42f1f48a4f381c17f0d7e8cb934f3_8834823113849099838.png\\\" data-entry-name=\\\"冒险家的经验\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/81f42f1f48a4f381c17f0d7e8cb934f3_8834823113849099838.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的经验\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/03/19/80663279/b26706122e54335e75a99308e473cc62_6046776211301505238.png\",\"option\":\"【很有商业头脑。】\"},\"hhe5qbb5syjT1742358953447\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对， 这位朋友很懂嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我认识一些很喜欢音乐的朋友，有回声之子的唱片匠人，也有烟谜主的涂鸦艺术家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如此一来，不仅是出唱片，就连包装、宣传海报之类的业务我也可以帮忙安排。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e非常全面、贴心的一条龙服务，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【算是拓展业务吗？】\"},\"n262b9sc14jT1742359022315\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「花歌唱片店」！这名字是我表妹夏萝起的，很浪漫吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e正如其名，卖唱片是本店的基本业务。除此之外，本店还可以为大家提供代出唱片的帮助。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果有人写了音乐但不知道怎么出唱片，我可以从制作到发行进行全权代理。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，旁边正摆着的著名童谣音乐人的经典合集专辑，就是本店的成功作品之一。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(59, 66, 85)\\\"\u003e请便！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我先自己看看。】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1742375843","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691