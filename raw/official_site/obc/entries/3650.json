66967.png\\\" data-entry-name=\\\"映影书写札记\\\" data-entry-link=\\\"/ys/obc/content/4204/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/4204/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e映影书写札记\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"sq6il2sv0hT1790440062648\"],\"4vopt8vyrjxT1746542058647\":[\"c4y7tn14z8dT1746542075821\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"l3ymn7rq0xT1746542397060\"],\"c4y7tn14z8dT1746542075821\":[\"sq6il2sv0hT1790440062648\"],\"l3ymn7rq0xT1746542397060\":[\"sq6il2sv0hT1790440062648\"],\"lncoo9if6orT1746542176081\":[\"sq6il2sv0hT1790440062648\"],\"nqb471m7nmnT1710863941173\":[\"4vopt8vyrjxT1746542058647\"],\"sq6il2sv0hT1790440062648\":[\"vmop9t5pnekT1790440114624\"],\"vmop9t5pnekT1790440114624\":[],\"z2tn3pzsbujT1710863943430\":[\"lncoo9if6orT1746542176081\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【关于势至丸…】——完成世界任务 映影书写札记后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦？年轻人，你对这个故事很感兴趣呀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不瞒你说，势至丸原本是我家族中的亲戚。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他的事也曾经闹得沸沸扬扬，只是现在年轻人都不知道这些旧事了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也活了几十年，看了几十年，世上真实发生过的事总是比故事精彩啊呵呵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4vopt8vyrjxT1746542058647\":{\"option\":\"【身为老板却在喝酒吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有何不可？清酒在手，佳肴常伴，不来一杯怎么对得起奔波的一生。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e加油，有朝一日你当了老板，也能像我一样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e年轻人，饿了吧？来尝尝绘里香的好手艺！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"c4y7tn14z8dT1746542075821\":{\"option\":\"【我还喝不了酒哦。】————获得串串三味*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那是因为你还年轻嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不喝酒也有不喝酒的好处啊，年轻人可不要急功近利。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来，一起吃点炸串吧。没有了酒的下酒菜，也是美味的食物呀。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2421\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/efef4034ba69b9f0c3c335da79d3d291_7355134820754248952.png\\\" data-entry-name=\\\"串串三味\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2421/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/2421/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/efef4034ba69b9f0c3c335da79d3d291_7355134820754248952.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e串串三味\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/24077343/b26706122e54335e75a99308e473cc62_2662044688148405512.png\"},\"l3ymn7rq0xT1746542397060\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，欢迎再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"lncoo9if6orT1746542176081\":{\"option\":\"【稻妻现在…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这位客人年纪轻轻，也关心稻妻时政？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也难怪，你毕竟是异乡的旅客嘛，如果被困在稻妻没法回家，可是件麻烦事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要我说的话…天领奉行永远相信将军大人的神力，将军大人的选择也定有其含义吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我么，是这家居酒屋的老板。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想吃什么随便点，找绘里香点菜就行。在我看来，她的手艺在稻妻城可算数一数二。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"sq6il2sv0hT1790440062648\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次逐月节（2026）期间】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【冈崎陆斗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好像找回了年轻时的感觉啊…真不错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【冈崎绘里香】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，我们有多久没这样一起出游了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就抓紧机会，再携手完成一百道料理，如何？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【冈崎陆斗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不在话下，我来备菜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"vmop9t5pnekT1790440114624\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【听说你是大人物？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？你听谁说的？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，一定又是绘里香在夸我了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e实不相瞒，当年我在天领奉行的名望甚高。即便现在隐退，也有不少与力、同心来找我商谈事宜。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最近偶尔就连常常出入奉行府的大人物也会屈尊莅临本店…看来当下的稻妻确实暗流涌动啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1790563179","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_