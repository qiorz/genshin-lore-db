editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e传说任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"593\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/9fe2fdcddfb18846461c287a09a85312_8278133649388139081.png\\\" data-entry-name=\\\"长杓之章 第一幕「蒙德食遇之旅」\\\" data-entry-link=\\\"/ys/obc/content/593/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/593/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e长杓之章 第一幕「蒙德食遇之旅」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"l392oy2c6yT1746354066422\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"zirienevug9T1746353805318\",\"demccaapkowT1746353827446\"],\"demccaapkowT1746353827446\":[\"l392oy2c6yT1746354066422\"],\"gjrjulkn0iT1746354072829\":[\"qev7xx1u32T1746354148789\"],\"l392oy2c6yT1746354066422\":[\"gjrjulkn0iT1746354072829\"],\"nqb471m7nmnT1710863941173\":[\"l392oy2c6yT1746354066422\"],\"qev7xx1u32T1746354148789\":[],\"z2tn3pzsbujT1710863943430\":[\"l392oy2c6yT1746354066422\"],\"zirienevug9T1746353805318\":[\"l392oy2c6yT1746354066422\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【又见面了。】——完成长杓之章第一幕「蒙德食遇之旅」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你不是那个璃月大厨香菱的助手来着吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来这里应该不单单只是闲逛吧？莫非是她想要再次挑战「蒙德肉类料理厨艺之王」的我？哼…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…唔，好像不对，上次是我输了来着…再挑战我也没什么意义啊……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？被肉的香味吸引而来的么，哼哼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"demccaapkowT1746353827446\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，祝你有个好胃口。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gjrjulkn0iT1746354072829\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，又一个被肉香吸引来的人呢，哼哼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最近不是过节了吗，就连这个小镇上来往的人都变多了，甚至还有外国人出现。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e本以为他是来问路的，结果竟然是问我会不会用慕风蘑菇做菜。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e慕风蘑菇吗…倒也不是不行，但顶多也就是肉的陪衬罢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"l392oy2c6yT1746354066422\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次风花节（2023）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我想买些吃的可以吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然没问题。新鲜的大肉排，这可是蒙德最好的肉类料理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/04/178964736/661f4aed07b4e34115c0ea22f4b4b711_7663818806834972822.png\"},\"qev7xx1u32T1746354148789\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你是谁？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你没见过我吗？我叫布洛克，我做的肉类料理在蒙德可是很出名的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zirienevug9T1746353805318\":{\"option\":\"【你在做什么？】——获得美味的烤肉排*4\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e为了得到最最最新鲜的肉，从狩猎到开始料理的过程可是一会儿也不能耽误的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这也是我来到清泉镇定居的原因。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e经我之手做出来的肉料理，虽然大部分都用来出售了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但一天之中最最最新鲜的那块肉嘛…我一般只留给自己享受。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好香啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哼哼，那当然了，这可是我布洛克做的肉排！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我可以自豪地说，在蒙德我的肉排绝对是最顶级的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你尝过了吗？如果没尝过的话就来一块吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e别客气，这可是能革新你味觉的美味！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"101\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/25/24077343/38e6c1e3628b3bb3e50b4f2699520768_7580371877185684852.png\\\" data-entry-name=\\\"美味的烤肉排\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/101/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/101/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/25/24077343/38e6c1e3628b3bb3e50b4f2699520768_7580371877185684852.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的烤肉排\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/04/178964736/b26706122e54335e75a99308e473cc62_8491627197862121044.png\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746410136","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon