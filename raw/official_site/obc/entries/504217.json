atus=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502484/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e流泉所归之处 第二幕 「神秘岛的传说」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e5.5：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504854\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/03/28/4521515/255a7c159c42b750bba9949c78ee31c1_6538742284148845710.jpg\\\" data-entry-name=\\\"荣花竞捷之争\\\" data-entry-link=\\\"/ys/obc/content/504854/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504854/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e荣花竞捷之争\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504971\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/02/82503813/c25866397e5ccd8d5781c826f01bba72_1921059559304345451.png\\\" data-entry-name=\\\"荣花竞捷之争 第一幕 「为了龙伙伴」\\\" data-entry-link=\\\"/ys/obc/content/504971/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504971/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e荣花竞捷之争 第一幕 「为了龙伙伴」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0ry61rhm289jT1736317555978\":[\"5x6f193r4dtT1745940221747\"],\"4cf2vhylew3T1710863944349\":[\"5x6f193r4dtT1745940221747\"],\"57wnhoc56hiT1763386459817\":[\"83tleqvy9n9T1763386546486\"],\"5x6f193r4dtT1745940221747\":[\"68dn58w8n7sT1745940410159\"],\"68dn58w8n7sT1745940410159\":[\"mc187z4t1tT1745940782830\"],\"83tleqvy9n9T1763386546486\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"e2eu9fvhp6cT1736318565019\",\"xsubojm2x8gT1736318826043\"],\"e2eu9fvhp6cT1736318565019\":[\"5x6f193r4dtT1745940221747\"],\"mc187z4t1tT1745940782830\":[\"57wnhoc56hiT1763386459817\"],\"nqb471m7nmnT1710863941173\":[\"0ry61rhm289jT1736317555978\"],\"xsubojm2x8gT1736318826043\":[\"5x6f193r4dtT1745940221747\"],\"z2tn3pzsbujT1710863943430\":[\"5x6f193r4dtT1745940221747\"]},\"contents\":{\"0ry61rhm289jT1736317555978\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不只是大话哦！如果你在流泉之众游玩的时候有什么意见和建议，可以随时告诉我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没准下次再来的时候，你想要的东西就会出现在这里了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e顺便，请收下这些纪念品吧。是你在这里踏足过的证明哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501914\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/183046623/149607013a4ed9cec7959a1647ffaf63_3650777371382694063.png\\\" data-entry-name=\\\"浪沫羽鳃\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/501914/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/501914/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/183046623/149607013a4ed9cec7959a1647ffaf63_3650777371382694063.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e浪沫羽鳃\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/08/178964736/b26706122e54335e75a99308e473cc62_6077099723611439235.png\",\"option\":\"【真可靠啊。】——获得浪沫羽鳃*2\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢关心，有大家的帮助，我想一切都会好起来的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大战之后，有很多人离开了…希望他们去到阿伽娅阿姨在的地方，毕竟人多才热闹嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…抱歉，听上去有些幼稚吧？但我是真的相信逝去的纳塔人可以在夜神之国重新相会。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这就是为什么英雄的记忆会铸就「古名」，流传永世。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 第五章第五幕「炽烈的还魂诗」后 消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【最近还好吗？】——完成魔神任务 第五章第四幕「命定将焚的虹光」后\"},\"57wnhoc56hiT1763386459817\":{\"dialogue\":\"\u003cp\u003e【阿米娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这次来访的须弥朋友们都很热情嘛！给我们带来的礼物，那些特色菜和食材，也都特别棒！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【穆托塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e以后应该和玛拉妮提前商量好，做更全面的准备。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿米娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e菜肴要最最丰盛！不过，他们也不喜欢太正式，太拘谨的场合。要找好一个平衡点才行哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"5x6f193r4dtT1745940221747\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务第五章第一幕「荣花与炎日之途」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"68dn58w8n7sT1745940410159\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e阿伽娅…对我来说也是一位可敬的长辈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e祖父过世后，我是许多长辈们推举着成为了「部族首领」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为我总是有许多新奇的想法，大家相信我能将「流泉之众」带向「不一样的未来」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是，在很长一段时间里，我也不知道自己该做什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e阿伽娅阿姨经常勉励我，哪怕我犯了错，她也从不会跟我说「怎么做成这个样子」。她会很认真地陪我分析问题出在哪里，让我能做得更好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我很尊敬她。所以…我会记住她教给我的一切，努力做好我该做的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【开场白】—— 首次\"},\"83tleqvy9n9T1763386546486\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，今天天气不错吧？泡过温泉了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"e2eu9fvhp6cT1736318565019\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢关心，在大家的不懈努力下，这里还是一如既往地吵闹，嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大战之后，有很多人离开了…希望他们去到阿伽娅阿姨在的地方，毕竟人多才热闹嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…抱歉，听上去有些幼稚吧？但我是真的相信逝去的纳塔人可以在夜神之国重新相会。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这就是为什么英雄的记忆会铸就「古名」，流传永世。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近还好吗？】——完成魔神任务 第五章第五幕「炽烈的还魂诗」后\"},\"mc187z4t1tT1745940782830\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「跃跃律动舞力聚会」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我叫阿米娜，是「流泉之众」的首领。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不要一副很惊讶的样子，我可是很认真地在做老大呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你要知道，「认真」在我们这可是难能可贵的品德。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e部族里的其他家伙不是在泡温泉，就是在泡温泉的路上。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你遇到那种很懒散又搞不清状况的人，不用着急，来找我吧，我作为首领会担起责任的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己…】\"},\"xsubojm2x8gT1736318826043\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这就对了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【马上去泡。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，是专门来看我的吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e流泉之众一切都好哦，没什么意外发生，小孩子们也不怎么往温泉里扔石子了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e算了，还是不讲伤心事了。爷爷说过，要积极生活！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我…我最近还挺忙的呢，忙着设计新的演出舞台，还要加强部族周围的巡逻防线。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e脑子里的点子一个个冒出来，希望马努阿不要提太多意见！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，还有，虽然就算我不说玛拉妮也会叫你来，但我还是得补一句：记得常来玩哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，阿米娜。】——完成魔神任务 第五幕第一章「荣花与炎日之途」后\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1763432466","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","