if\\\" style=\\\"width: 700px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8980","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"映夏！归乡？千灵节！","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/50494840/86c98a5df8a3df255aca58ef41ccca72_2012476247552444318.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"690\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 690px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/50494840/86c98a5df8a3df255aca58ef41ccca72_2012476247552444318.png\\\" style=\\\"width: 690px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8981","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色对话彩蛋","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"rcoy6ccxktT1782845539660\",\"child_ids\":{\"rcoy6ccxktT1782845539660\":[]},\"contents\":{\"rcoy6ccxktT1782845539660\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第一阶段\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【哥伦比娅、芙宁娜】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e芙宁娜：演得不错，哥伦比娅小姐。辛苦了。\u003c/p\u003e\u003cp\u003e哥伦比娅：谢谢你，芙宁娜导演。\u003c/p\u003e\u003cp\u003e哥伦比娅：但我真的不摘眼罩也没问题吗？\u003c/p\u003e\u003cp\u003e芙宁娜：嗯，放心吧，关于这一点我也和泽维尔讨论过了。\u003c/p\u003e\u003cp\u003e芙宁娜：既然我们是以你为原型，那么就应该尊重你最原本的习惯。而且这也能成为我们影片中女主角的一大特色。\u003c/p\u003e\u003cp\u003e芙宁娜：就像你说的，睁眼就留给最重要的时候吧。\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【哥伦比娅】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e派蒙：嗨！哥伦比娅。拍摄辛苦了，拍映影开心吗？\u003c/p\u003e\u003cp\u003e哥伦比娅：嗯，是很新奇的体验。同伴们齐心协力，一起去做成一件事的感觉也令人开心。\u003c/p\u003e\u003cp\u003e派蒙：嘿嘿，你喜欢就好。\u003c/p\u003e\u003cp\u003e派蒙：但有个问题我其实早就想问了。你到底告诉了泽维尔多少关于自己的事呀？就是说，关于你是月神的事…\u003c/p\u003e\u003cp\u003e哥伦比娅：哦，那部分没告诉哟。\u003c/p\u003e\u003cp\u003e哥伦比娅：临行前奈芙尔和菈乌玛也嘱咐过我这点，她们难得能达成一致。所以我便隐去了和「月神」身份有关的故事。\u003c/p\u003e\u003cp\u003e哥伦比娅：另外我还从奈芙尔口中得知，芙宁娜小姐曾是枫丹的水神。\u003c/p\u003e\u003cp\u003e哥伦比娅：等拍完映影后，我也想找个时间约她聊聊天呢。总觉得我们有很多话题可聊。\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【娜维娅、克洛琳德】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e娜维娅：你认识这位《奇械公》吗？\u003c/p\u003e\u003cp\u003e克洛琳德：你不认识？\u003c/p\u003e\u003cp\u003e娜维娅：认识，我就考考你嘛。\u003c/p\u003e\u003cp\u003e克洛琳德：哈…他是新式发条机关和芒荒湮灭能源的发明者，枫丹科学院创立者和首任院长。\u003c/p\u003e\u003cp\u003e娜维娅：哦~\u003c/p\u003e\u003cp\u003e克洛琳德：你这不是不认识吗…\u003c/p\u003e\u003cp\u003e娜维娅：只是知道的没你多而已嘛！欸，你会去看这部映影吗？\u003c/p\u003e\u003cp\u003e克洛琳德：有时间的话。\u003c/p\u003e\u003cp\u003e娜维娅：嘿嘿，那就一起去吧！不过…「阿兰·吉约丹」？「吉约丹」…？总感觉这名字最近在哪里见到过。\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【茜特菈莉】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e茜特菈莉：你…你们别去太久啊！\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003c/p\u003e\"}}},{\"root_id\":\"ov7vyij1oxT1782921958128\",\"child_ids\":{\"ov7vyij1oxT1782921958128\":[]},\"contents\":{\"ov7vyij1oxT1782921958128\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第二阶段\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【「木偶」】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e「木偶」：不被承认的游魂…怨意与污秽的聚合…\u003c/p\u003e\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"9597","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1782958120","langs":[],"template_layout":{"tab":[{"tab_id":"524","tab_name":"活动介绍","module_group":[{"module_group_id":"2716","layout":"l2r1","module":[{"id":"8981","pos":"banner"},{"id":"8979","pos":"left"},{"id":"8980","pos":"right"},{"id":"8910","pos":"left"},{"id":"8911","pos":"left"},{"id":"9597","pos":"left"},{"id":"8912","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"105","name":"活动","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"活动","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"1\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"活动类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"纪行\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"游戏活动\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"活动祈愿\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"版本\\\",\\\"children\\\":[{\\\"label\\\":\\\"常驻\\\",\\\"children\\\":[]},{\\