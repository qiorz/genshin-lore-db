h\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"c7c42h7lxhtT1712759345346\":[\"r6r58s7g79qT1712759765711\"],\"iy54wf45wqT1712759342856\":[\"c7c42h7lxhtT1712759345346\"],\"kfl4qtwh3k9T1712760747706\":[],\"myfz3on6enaT1712760162363\":[\"kfl4qtwh3k9T1712760747706\"],\"nbo2v788i2T1712762908162\":[\"r6r58s7g79qT1712759765711\"],\"nqb471m7nmnT1710863941173\":[\"iy54wf45wqT1712759342856\",\"nbo2v788i2T1712762908162\"],\"r6r58s7g79qT1712759765711\":[\"myfz3on6enaT1712760162363\"],\"z2tn3pzsbujT1710863943430\":[\"r6r58s7g79qT1712759765711\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e能感受出来。因为我也是曾经被世界选中的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只不过，我把这个力量拿去做了不正确的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我的「神之眼」已经收起来了。我不配再用它了，也不再需要了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【该做的事情？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e上客栈的路在那边。嗯，来找我说话的？那就小声一点，别把鱼吓走了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"c7c42h7lxhtT1712759345346\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e能感受出来。因为我也是曾经被世界选中的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只不过，我把这个力量拿去做了不正确的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我的「神之眼」已经收起来了。我不配再用它了，也不再需要了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【该做的事情？】\"},\"iy54wf45wqT1712759342856\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你还有更有意义的事情要去做。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不要学我。我只是在等，什么时候这条命走到头罢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e因为我该干的事情，已经做完了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我也想钓鱼！】\"},\"j6oyo9syzg9T1712760218317\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e言笑这回在厨王争霸赛上得了第二名，可惜，却也不是坏事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e厨艺一事本就与武学相似，有对手才有比较，才有进步。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e以后他多半要研究新菜谱了吧。希望到时能叫我去试吃。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"kfl4qtwh3k9T1712760747706\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"myfz3on6enaT1712760162363\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e言笑这回在厨王争霸赛上得了第二名，可惜，却也不是坏事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e厨艺一事本就与武学相似，有对手才有比较，才有进步。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e以后他多半要研究新菜谱了吧。希望到时能叫我去试吃。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nbo2v788i2T1712762908162\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你误会了，我并不是以捕鱼为生的渔人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e钓鱼的过程与结果对我来说都没有意义，只是钓鱼会让时间过得更快一些，仅此而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e若是想要鱼，那你拿去便是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"771\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/10/8912764/609a57bb9e6ee8a2ae6451f7637c6462_2695821719949782576.png\\\" data-entry-name=\\\"鱼肉\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/771/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/771/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/10/8912764/609a57bb9e6ee8a2ae6451f7637c6462_2695821719949782576.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e鱼肉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/10/72954525/b26706122e54335e75a99308e473cc62_6629399951419313733.png\",\"option\":\"【你是渔夫吗？】——获得鱼肉*5\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我就是个普通钓客罢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e一定要问名字吗…名字已经丢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…叫我江雪吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【请问你是？】\"},\"r6r58s7g79qT1712759765711\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【逐月节期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","vers