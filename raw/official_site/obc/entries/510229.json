id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"zu7u6bh1u7oT1757449271505\",\"child_ids\":{\"zu7u6bh1u7oT1757449271505\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8179","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"七圣召唤对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"s5xmenpk8ypT1757449271523\":[]},\"contents\":{},\"root_id\":\"s5xmenpk8ypT1757449271523\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8180","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻想真境剧诗对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"na83dcginkqT1757449271526\",\"child_ids\":{\"na83dcginkqT1757449271526\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"tab_name\":\"生日的安排…——2022-02-22\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e最近，有什么让你感到烦恼的事情吗？\u003c/p\u003e\u003cp\u003e诸事顺遂自然最好，但蒙受挫折、遭遇考验，似乎是生活中难免要经历的事。\u003c/p\u003e\u003cp\u003e有什么困扰的话，可以和我说说看。\u003c/p\u003e\u003cp\u003e我不会向你下达「军师」的指令或建议，只会作为朋友分享自己的心得见解。\u003c/p\u003e\u003cp\u003e拿我自己来说吧。就算缺乏能量，我也不是每次都会钻进书里。像今天这种日子，我会更愿意去海里潜水。\u003c/p\u003e\u003cp\u003e被海水轻柔地环抱托起，面对一望无际的蔚蓝与自由起舞的鱼群，不论是怎样的烦恼都会消失。\u003c/p\u003e\u003cp\u003e这份快乐，希望能与你共享。\u003c/p\u003e\u003cp\u003e不如说…我还挺期待与你的见面。\u003c/p\u003e\u003cp\u003e【邮件赠礼:\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2318\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/21/15568211/bec41ca24fbc0e42b4280abfd6aad533_1864903025890334673.png\\\" data-entry-name=\\\"「浮世」的指引\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2318/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/2318/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「浮世」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2770\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/23/24077343/e73b9132f8073beab1525888ee88a10f_5752297305231885310.png\\\" data-entry-name=\\\"「奇策」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「奇策」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/01c5960340a2dbbbe84199b28be551fa_322899538878754997.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/01c5960340a2dbbbe84199b28be551fa_322899538878754997.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/18041732\\\" target=\\\"_blank\\\"\u003e珊瑚宫心海生日快乐｜真不可思议，原来我也有与谁倾诉的愿望\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"沧海之约。——2023-02-22\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e许久不见，希望你诸事顺遂。\u003c/p\u003e\u003cp\u003e海衹岛的生活一如寻常，值得分享的小事倒也不少。\u003c/p\u003e\u003cp\u003e就拿我近来漫步浅滩时的见闻来说吧。我见到三两只藤纹陆鳗鳗从沙中钻出来，它们迎着斜阳，在海风中摇曳身姿，模样很是悠闲。\u003c/p\u003e\u003cp\u003e这些幼小的生灵，说不好能理解海浪中我们所读不出的东西。\u003c/p\u003e\u003cp\u003e我相信那一定是好消息。\u003c/p\u003e\u003cp\u003e那日，我不忍打扰那副画面，小心地绕了点路。内心获得的放松感，却留存至今。\u003c/p\u003e\u003cp\u003e沧海总能带给人惊喜，有时是物产，有时是片刻安宁。如果你也愿意触碰这个藏满未知体验的宝匣，不如…就趁今日。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2610\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/31/4820086/9cad2999f1b417dba8e84bba95f29263_7335635232854236656.png\\\" data-entry-name=\\\"浮游幽核\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/2610/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/2610/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e浮游幽核\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2770\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/23/24077343/e73b9132f8073beab1525888ee88a10f_5752297305231885310.png\\\" data-entry-name=\\\"「奇策」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「奇策」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/ecc720a7e68dd407a0f2e11a49e0f369_790015304051452437.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/ecc720a7e68dd407a0f2e11a49e0f369_790015304051452437.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/36085443\\\" target=\\\"_blank\\\"\u003e珊瑚宫心海生日快乐｜剑鱼二番队队长，你的小队成员都在等你哦。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"书友交流会…2024-02-22\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e最近一段时间，我时常思考，和平来之不易，作为「现人神巫女」，现在我能为大家做的事情应当比过去更多。\u003c/p\u003e\u003cp\u003e我想举办一场书友交流会，邀请海祇岛的民众们共同参加，鼓励大家阅读并分享心仪的书籍。我已对活动形式和想要达到的效果进行了一番预测。但我对此缺乏经验，没法保证完善了所有细节…\u003c/p\u003e\u003cp\u003e如果可以的话，你愿意先与我演练一遍吗？\u003c/p\u003e\u003cp\u003e试办小型交流会，参与者仅我们二人。这样既能熟悉流程，还能同你交流阅读心得。\u003c/p\u003e\u003cp\u003e不必有压力。就请你当是一场…与书香相伴的野餐会吧。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3964\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/64f4a2576bdd325f904eed0d3a209080_8413776418366792458.png\\\" data-entry-name=\\\"美味的紫苑云霓\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/3964/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/3964/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的紫苑云霓\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2382\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/25/24077343/fc68ca4568285bef3dfec25c25ff0a74_2095450731614881888.png\\\" data-entry-name=\\\"美味的鸟蛋烧\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/2382/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2382/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的鸟蛋烧\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2770\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/23/24077343/e73b9132f8073beab1525888ee88a10f_5752297305231885310.png\\\" data-entry-name=\\\"「奇策」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「奇策」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/99c7ee9dbecfb4c81662c9ea9f3a4c81_8072400362159586740.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/99c7ee9dbecfb4c81662c9ea9f3a4c81_8072400362159586740.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/49587173\\\" target=\\\"_blank\\\"\u003e珊瑚宫心海生日快乐｜在碧波游鱼间穿行…\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"重温…——2025-02-22\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e鸣神岛正在举办「三川花祭」，如你所知，我也参与了游艺的创作。既能让海祇岛民众同享人类与妖怪的盛会，又可探讨游艺作为海祇岛旅游方向的可行性，着眼当下和未来，这个祭典正是让海祇岛迈向外界的契机，多投入些心力无可厚非。\u003c/p\u003e\u003cp\u003e只是，创作中频密的聚议，比预想中更耗费能量…\u003c/p\u003e\u003cp\u003e所幸，闲聊间，刑部小判提起跟你玩过的追赶游戏，「黄毛，抓住，又抓不住！」，仅仅是想象着这个画面，心情就欢畅许多…\u003c/p\u003e\u003cp\u003e不知你有没有兴趣重温这种游戏呢？我备了些锦囊，加入新的规则，不为决胜，只为再添相聚之乐。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2612\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/31/4820086/14b329077246e42db8b76d2efb61b630_532172194687858565.png\\\" data-entry-name=\\\"珊瑚真珠\\\" data-entry-amount=\\\"10\\\" data-entry-link=\\\"/ys/obc/content/2612/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/2612/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e珊瑚真珠\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*10\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2770\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/23/24077343/e73b9132f8073beab1525888ee88a10f_5752297305231885310.png\\\" data-entry-name=\\\"「奇策」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「奇策」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/4edeab3eb2d7f095c1080ceb08c32d47_8216179117886495247.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/294074726/4edeab3eb2d7f095c1080ceb08c32d47_8216179117886495247.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/62181657\\\" target=\\\"_blank\\\"\u003e珊瑚宫心海生日快乐｜书中所描绘的光怪陆离的世界…\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"有关映影…——2026-02-22\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e近来，海祇岛似乎也流行起了看映影，大家还向我提出，能不能以海祇岛为取景地拍一部映影。\u003c/p\u003e\u003cp\u003e我想，或许这是一个对外介绍海岛的好方法，就答应了下来。\u003c/p\u003e\u003cp\u003e首先自然是要撰写映影剧本了，但整个海祇岛上好像没有擅长写剧本的人，想来也只能由我执笔。可我平时看的那些书，似乎并不能作为映影的参考…\u003c/p\u003e\u003cp\u003e所以，我打算再去研究几部有名的作品，就像以前研读兵书阵法一样。\u003c/p\u003e\u003cp\u003e只有对剧本结构了然于胸，实战时才能布局得当。\u003c/p\u003e\u003cp\u003e你平时喜欢看映影么？如果有时间，我们可以一起研究。说不定，还能一起聊出几个打动人心的好点子呢。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3964\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/64f4a2576bdd325f904eed0d3a209080_8413776418366792458.png\\\" data-entry-name=\\\"紫苑云霓\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/3964/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/3964/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e紫苑云霓\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2770\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/09/23/24077343/e73b9132f8073beab1525888ee88a10f_5752297305231885310.png\\\" data-entry-name=\\\"「奇策」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/2770/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「奇策」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/03/10/50494840/938d8456d562b25ce183d77bb014486c_8731355153468336599.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/03/10/50494840/938d8456d562b25ce183d77bb014486c_8731355153468336599.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/73450404\\\" target=\\\"_blank\\\"\u003e珊瑚宫心海生日快乐 | 一直想与你分享这个海底的「秘密基地」\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"mxeucbj4amiT1757449271509\",\"child_ids\":{\"1mmn1jkuo0yT1757449558819\":[],\"3aradfimqq5T1757449665958\":[\"tduv11mq8tgT1757449679581\"],\"41jgjgbfztT1757449556709\":[\"n4e6tonpxvgT1757449752858\",\"bu4n2jzg27T1757449762984\"],\"7551uml2ss4T1757449684903\":[\"quea6vp7hzT1757449699071\"],\"avbzzjq69wT1757449555689\":[\"7551uml2ss4T1757449684903\"],\"bu4n2jzg27T1757449762984\":[\"eyaxcidvzivT1757449773279\"],\"ce5ds0sln4T1757449557423\":[],\"chj7n7n39viT1757449722467\":[],\"eyaxcidvzivT1757449773279\":[],\"lvs7umuqioiT1757449553756\":[\"pfc39d8u7weT1757449651991\"],\"mxeucbj4amiT1757449271509\":[\"lvs7umuqioiT1757449553756\",\"avbzzjq69wT1757449555689\",\"41jgjgbfztT1757449556709\",\"ce5ds0sln4T1757449557423\",\"1mmn1jkuo0yT1757449558819\"],\"n4e6tonpxvgT1757449752858\":[\"eyaxcidvzivT1757449773279\"],\"pfc39d8u7weT1757449651991\":[\"3aradfimqq5T1757449665958\"],\"quea6vp7hzT1757449699071\":[\"chj7n7n39viT1757449722467\"],\"tduv11mq8tgT1757449679581\":[]},\"contents\":{\"1mmn1jkuo0yT1757449558819\":{\"option\":\"【晚安，心海。】——【夜晚】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e明天的早饭轮到我来做，你可以多休息一段时间。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等早饭做好之后，我会叫你起床的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"3aradfimqq5T1757449665958\":{\"option\":\"【当然可以。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e太好了。真想一直呆在这里呀，不需要社交，可以每天躺在床上看兵书…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e再也不会有能量不足的情况，每天精力都很充沛，想想就觉得幸福。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"41jgjgbfztT1757449556709\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果可以的话，我想带你一起去海里潜水。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e尘世中有许多烦恼，但任何烦恼与大海的广阔相比，都变得不值一提。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e悠悠古今，岁月变迁，而大海一如既往。身处水下的世界，心也会慢慢平静下来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有时候我会感觉你太累了，所以我也想尝试一下，把我平时放松的方法教给你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7551uml2ss4T1757449684903\":{\"option\":\"【我想听关于心海的事情。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e关于我的？嗯…我倒是不介意啦，主要是担心有些无聊，你应该不感兴趣。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我记得我很小的时候，常常是一个人呆在家里。没什么朋友，也很少跟人说话。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e闲来无聊的时候，我就会翻看家里的藏书。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e里面大部分都是些政务、外交之类的教材，为数不多的几本兵法就成了我的宝贝。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那时候我就想，将来能做个幕僚就好了。主公来向我求计，我就故作玄虚地递上一个锦囊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e之后我就可以躺在被窝里继续睡觉，不会有人来打扰。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"avbzzjq69wT1757449555689\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊，不过要聊些什么呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"bu4n2jzg27T1757449762984\":{\"option\":\"【可是我不会游泳…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…这倒是一个问题…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，我想到了一个办法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我可以做一个特别特别大的泡泡，将我们两个包裹进去，慢慢沉到水下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样我们就可以一起在水下遨游了！想必能量也会回复得更快吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我也没和别人一起潜过水呢，真让人期待…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ce5ds0sln4T1757449557423\":{\"option\":\"【早啊，心海。】——【白天】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早安，旅行者，昨晚睡得还好吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e旅程如战场，可不能带着疲惫出发。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"chj7n7n39viT1757449722467\":{\"option\":\"【真辛苦。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…所以每次看到你有所成长的时候，我都很开心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说不定有一天，你比我更适合出现在人前，更适合背负着大家的期待前行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等到那时，我来给你当幕僚，这样好像也不错？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"eyaxcidvzivT1757449773279\":{\"option\":\"【需要我准备什么东西吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不用，本来就是为了放松而规划的旅行，随性而为就好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e更何况，还有我这个「军师」在呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你就好好休息，剩下的事情交给我就好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"lvs7umuqioiT1757449553756\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e刚开始的时候，会有一点点不习惯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么说呢…因为我常年学习兵法，所以每到一个新的地方，首先思考的便是「攻防」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e敌军会选何处驻扎，会从哪里进攻？我方又要采取什么样的应对之策？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e起初我在这里闲游的时候，总会不自觉地去想，这里应该加个拒马，那里应该补个哨塔…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"mxeucbj4amiT1757449271509\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者，你回来了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e正好我处理完了今天的政务，一起放松一下吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"n4e6tonpxvgT1757449752858\":{\"option\":\"【可是在水下要怎么呼吸…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…这倒是一个问题…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，我想到了一个办法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我可以做一个特别特别大的泡泡，将我们两个包裹进去，慢慢沉到水下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样我们就可以一起在水下遨游了！想必能量也会回复得更快吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我也没和别人一起潜过水呢，真让人期待…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"pfc39d8u7weT1757449651991\":{\"option\":\"【尘歌壶里很安全的。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，后来我也发现自己想多了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呆了一段时间之后，我对这里的景色慢慢熟悉，心也逐渐放松下来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对我来说，这里是最理想的环境了。能够与外面暂时隔开，享受一段属于自己的时光…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我可以租用一间房屋，来摆放兵法与地图吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"quea6vp7hzT1757449699071\":{\"option\":\"【但实际上…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。结果没想到，一直习惯于宅在家里的我，突然就被推上了那个位置。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我还记得上任的第一天，先后有上百人过来拜访。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我小心地记着他们的名字，结果才记了二十几个，就开始对不上号了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最后我只能装作处理政务，在眼前的白纸上画他们的简笔画，把名字标注在旁边，然后死记硬背。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"tduv11mq8tgT1757449679581\":{\"option\":\"【不会孤单吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一个人的话，或许会有一点。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，不是还有你在吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/395f777f88be716c41d68801a0c56f17_5122058564515649641.png\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色赠礼","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"同伴赠礼\",\"header\":[\"好感套装\",\"对应奖励\",\"好感套装对话\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3062\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/10/19/74019947/a10d90c93d3bcdfb07e073fa4343be6c_7773849583505514366.png\\\" data-entry-name=\\\"沉墨书舍\\\" data-entry-link=\\\"/ys/obc/content/3062/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/co