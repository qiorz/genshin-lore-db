{"retcode":0,"message":"OK","data":{"page":{"id":"6227","name":"马塞拉","desc":"马塞拉","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2023/03/03/76297419/b164f345074da3a648cbe7fed919b1d7_5274128157198161124.png","header_img_url":"","modules":[{"name":"马塞拉","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e【完成「永恒的葱茏之梦」前】\u003c/p\u003e\u003cp\u003e…如果她仍要一意孤行的话…\u003c/p\u003e\u003cp\u003e【完成「比勒琪丝的哀歌」后】\u003c/p\u003e\u003cp\u003e…或许她，太低估了这几个小家伙呢…\u003c/p\u003e\u003cp\u003e【完成『「猎鹰」塔德菈』后】\u003cbr\u003e…塔德菈啊…你的成长…太慢了…\u003c/p\u003e\u003cp\u003e【完成『「鹰猎」』后】\u003c/p\u003e\u003cp\u003e…清晨的水雾蒸腾之前，正午的蜃景成形之前，我的猎鹰便已起飞…\u003c/p\u003e\"],\"key\":\"心声\"},{\"value\":[\"\u003cp\u003e塔德菈的父亲\u003c/p\u003e\"],\"key\":\"编者注：\"}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/03/76297419/02d2a63b409ca9fc637da64a809c36a8_7529786901369836279.png\",\"attr\":[{\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"],\"key\":\"性别\"},{\"value\":[\"\u003cp\u003e【完成『「鹰猎」』前】塔尼特露营地\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"功能\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"职业\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/03/76297419/43de542ac86e655610797fa77e43c2cf_9174933661561160374.png\"},{\"tab_name\":\"位置【完成『「鹰猎」』前】\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/03/76297419/77b292def4661638d27133e745f0c951_8584914658924145463.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false