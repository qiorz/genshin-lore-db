126206785908552.png\\\" data-entry-name=\\\"「鹰猎」\\\" data-entry-link=\\\"/ys/obc/content/5973/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5973/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「鹰猎」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5972\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/09/50494840/41a53cbf3d3742b30dd4261689b9e6fc_4505860455021020889.png\\\" data-entry-name=\\\"折翼的猎鹰\\\" data-entry-link=\\\"/ys/obc/content/5972/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5972/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e折翼的猎鹰\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1uplc3dnobT1779763813688\":[\"tw0lpjkb4ejT1779765412772\"],\"4buh6jgiuc4T1779769358920\":[\"jknsbeeztvfT1779769430487\",\"gng1yffg31jT1779769431662\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"8r7kolam0sT1779763815200\":[\"prbp2sf9tbsT1779765873953\"],\"ebejrtthvuiT1779768770913\":[\"4buh6jgiuc4T1779769358920\"],\"fkqdlq4745rT1779768077772\":[\"y22rmndicncT1779767853947\"],\"gng1yffg31jT1779769431662\":[\"pk1gs1tcgaqT1779769552846\"],\"j8i2xj3q62rT1779768159613\":[\"w8w1t7n7n3T1779768384010\",\"mkgvuf60loeT1779768695834\"],\"jknsbeeztvfT1779769430487\":[\"pk1gs1tcgaqT1779769552846\"],\"mkgvuf60loeT1779768695834\":[\"ebejrtthvuiT1779768770913\"],\"nqb471m7nmnT1710863941173\":[\"1uplc3dnobT1779763813688\",\"8r7kolam0sT1779763815200\"],\"pk1gs1tcgaqT1779769552846\":[],\"prbp2sf9tbsT1779765873953\":[\"fkqdlq4745rT1779768077772\"],\"tw0lpjkb4ejT1779765412772\":[\"prbp2sf9tbsT1779765873953\"],\"w8w1t7n7n3T1779768384010\":[\"ebejrtthvuiT1779768770913\"],\"y22rmndicncT1779767853947\":[\"j8i2xj3q62rT1779768159613\"]},\"contents\":{\"1uplc3dnobT1779763813688\":{\"option\":\"【风…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…如果是像你这样的外人…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也罢，别放在心上。金丝雀的歌声悠扬婉转，又怎么能撕破缱绻的蛛网呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4buh6jgiuc4T1779769358920\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，这位不是尊贵的客人…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真是了不起，您居然真的达成了那样的伟业。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定有一日，我有需求您帮助的时候，到那时，还望您能够伸出援手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【接取世界任务\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6056\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/adda7c268429bfbed624a1d873fd6418_1077458196248580272.png\\\" data-entry-name=\\\"「智慧筑屋，凿成七柱」\\\" data-entry-link=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「智慧筑屋，凿成七柱」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"8r7kolam0sT1779763815200\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，陌生人…愿你的前路上没有沙暴。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ebejrtthvuiT1779768770913\":{\"option\":\"【你到底在说什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，哦！你生气了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，没什么…请保护好她，她是个好孩子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6056\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/adda7c268429bfbed624a1d873fd6418_1077458196248580272.png\\\" data-entry-name=\\\"永恒的葱茏之梦\\\" data-entry-link=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e永恒的葱茏之梦\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"fkqdlq4745rT1779768077772\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e跟芭别尔说过话了？她又去忙了吧…这女人像风一样，从来都停不下来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵呵，年轻人。说起「风」…我要提醒你一句，沙漠中有一种风名叫「齐卜里」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最开始，你不会有任何感觉。直到沙暴从地平线上升起，空气开始在逐渐升温中燃烧，然后，你才发现…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你会逐渐嗅不到任何气味，因为高温的空气遮蔽了你的嗅觉，灼伤了你的鼻孔…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到这个时候，呵呵…其实已经悔之晚矣。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gng1yffg31jT1779769431662\":{\"option\":\"【到时候我会帮忙的。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那我就提前谢过了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"j8i2xj3q62rT1779768159613\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「扑梭梭梭梭~」小金丝雀飞回来咯！嘿嘿，恭喜你！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jknsbeeztvfT1779769430487\":{\"option\":\"【当然可以，不过先来局牌吧。】——进行七圣召唤对局\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e跟您来上一局吗，那可真是我的荣幸。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/26/288180982/cc2a44c2e85425afbbd461e49fe0875d_1938406946223749322.png\"},\"mkgvuf60loeT1779768695834\":{\"option\":\"【我不是小金丝雀。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，那你是小猎鹰？哈哈，先要赢过我的猎鹰才行！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过呀…那只小狞猫和你一样，对自己深陷的天罗地网一无所知，只是出于直觉和本能在里面撕扯着…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「撕拉、撕拉…」她会不会越陷越深呢…？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e风终将卷起沙尘，但究竟在何方，才能寻得足以唤起朔风之物…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"pk1gs1tcgaqT1779769552846\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"prbp2sf9tbsT1779765873953\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6056\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/adda7c268429bfbed624a1d873fd6418_1077458196248580272.png\\\" data-entry-name=\\\"「智慧筑屋，凿成七柱」\\\" data-entry-link=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「智慧筑屋，凿成七柱」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"t1txm1zmc2T1779769622046\":{\"option\":\"【开场白】\",\"dialogue\":\"\",\"icon\":\"\"},\"tw0lpjkb4ejT1779765412772\":{\"option\":\"【我没听懂你想说什么…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那么，陌生人，就把我的话当做流风吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"w8w1t7n7n3T1779768384010\":{\"option\":\"【什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e瞧瞧你，瞧瞧你…小金丝雀还不知道发生了什么，就已经让毒蝎作茧自缚了…真是了不起呀，了不起！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过呀…那只小狞猫和你一样，对自己深陷的天罗地网一无所知，只是出于直觉和本能在里面撕扯着…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「撕拉、撕拉…」她会不会越陷越深呢…？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"y22rmndicncT1779767853947\":{\"option\":\"【我没听明白…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没什么…我说，小心沙暴。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6056\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/adda7c268429bfbed624a1d873fd6418_1077458196248580272.png\\\" data-entry-name=\\\"「流沙如泪的神殿」\\\" data-entry-link=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「流沙如泪的神殿」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，是你啊…年轻人，听说你和婕德那个孩子一起前往了受诅咒之城，你问我怎么知道的？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e猎人自有他的鹰隼与猎犬作他的耳目。不过，年轻人，我要提醒你啊，「诅咒」一词并非空穴来风。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e流金装裹的面包之中，包藏着的可是令所有人都疯狂的祸心之毒。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定这次也是一样，贪吃的猎物落入陷阱，无人得以幸免，呵呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6056\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/adda7c268429bfbed624a1d873fd6418_1077458196248580272.png\\\" data-entry-name=\\\"「埋葬丰饶的沙丘・上」\\\" data-entry-link=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/6056/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「埋葬丰饶的沙丘・上」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\