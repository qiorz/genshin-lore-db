":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"7w6nowsw69eT1776592606913\":[\"htjl0hj7oa8T1776592658769\",\"vwnvoqnspnkT1776592660339\"],\"8gfxrw8wla9T1710863939170\":[\"fru541raagT1776592347736\",\"7w6nowsw69eT1776592606913\",\"z2tn3pzsbujT1710863943430\"],\"fru541raagT1776592347736\":[],\"htjl0hj7oa8T1776592658769\":[],\"vwnvoqnspnkT1776592660339\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"1foqg8sidkdT1776592607674\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。我要再好好想想。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7w6nowsw69eT1776592606913\":{\"option\":\"【久雨莲？】——使用特制香水·风息后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…是这样的，我的外出执勤任务马上就要结束了，而我的结婚纪念日也快要到了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可我还没有选好给妻子的礼物…她是枫丹人，所以我在想，也许应该送些与枫丹有关的东西。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我记得，枫丹有位叫科培琉司的剧作家说过，「嗅觉是记忆的本能，芬芳是爱情的音乐」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e闻到您的香氛后…我觉得我已经有主意了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【未使用\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e她会喜欢什么呢…好难选啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【使用\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉…打扰一下，请问您用的香氛，是久雨莲吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"9y0vl0acmj6T1776592375870\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"fru541raagT1776592347736\":{\"option\":\"【你在烦恼什么？】——未使用特制香水·风息\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…是这样的，我的外出执勤任务马上就要结束了，而我的结婚纪念日也快要到了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可我还没有选好给妻子的礼物。我害怕她会不喜欢我的礼物，却又要挤出满意的笑容。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也害怕她会不喜欢我的礼物，冷着脸收下，然后认为我并不在意她的喜好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因此，我需要在选择礼物这件事上慎之又慎。以确保她一定会喜欢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"htjl0hj7oa8T1776592658769\":{\"option\":\"【（赠送香氛。）】———赠送香水·风息*1，获得《罗纳布韦之梦》、大英雄的经验*2、摩拉*21500\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e非常感谢您。这淡雅的香气…我想，她要是闻到这样的芬芳，一定会露出最真实、最美丽的笑容吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e请务必收下这个作为谢礼。这是我妻子最喜欢的一本枫丹爱情诗集，我特意多买了一本带在身边。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e愿诗歌与芬芳，也能为您带来美好的奇遇。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508364\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/a683a311d0e97b9987c9a590c280426b_1462176960942185763.png\\\" data-entry-name=\\\"《罗纳布韦之梦》\\\" data-entry-link=\\\"/ys/obc/content/508364/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508364/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/a683a311d0e97b9987c9a590c280426b_1462176960942185763.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e《罗纳布韦之梦》\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1025\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/d50fb37e3954b2b7105c61cf8f442c6e_7679619291811796065.png\\\" data-entry-name=\\\"大英雄的经验\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box ent