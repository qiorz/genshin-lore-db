/format,png\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e〓参与条件〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(173,114,14,1)\\\"\u003e冒险等阶≥20级\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e〓活动说明〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e● 从活动开始的第一天起，每天会解锁一个新的试炼关卡，共五关。前四天解锁「定序试炼」，第五天解锁「偶发试炼」。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e● \u003c/span\u003e在「定序试炼」中，旅行者需要连续通过三个次序固定的「试炼挑战」。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e● \u003c/span\u003e在「偶发试炼」中，三个「试炼挑战」则会在旅行者进入秘境后随机产生。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e● 在\u003c/span\u003e「试炼挑战」中，旅行者需要使用指定的试用角色，在限定时间内达成挑战目标。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e● 旅行者可以单人挑战试炼关卡，也可以自行组队或通过匹配模式参与挑战。\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1312","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动流程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e定序试炼·其一\u003c/p\u003e\u003cp style=\\\"white-space: pr