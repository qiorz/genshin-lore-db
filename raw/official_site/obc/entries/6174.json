84, 222)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;雷元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，我方出战角色附属\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;鸣煌护持\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;：1\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(146, 84, 222)\u0026quot;\u0026gt;雷元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着雷元素，可发生元素反应：\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超载\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+2，目标强制切换到下一个角色\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超导\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;感电\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;原激化\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，生成使下2次草元素或雷元素伤害+1的[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;激化领域\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;鸣煌护持：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;所附属角色\u0026lt;strong\u0026gt;元素战技\u0026lt;/strong\u0026gt;和\u0026lt;strong\u0026gt;元素爆发\u0026lt;/strong\u0026gt;造成的伤害+1。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数：2\