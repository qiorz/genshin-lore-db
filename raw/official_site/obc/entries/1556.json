tyle":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【志华】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e绮命姐，这次我想请您帮我指点一下…我的爱情运势。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【绮命】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e又是爱情运势吗…这已经是这个月第十次了吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【志华】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e因为您算得准呀，每次您都说：「太沉迷于占卜的结果就是得不到爱情的。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e于是我决定把心思放在「占卜本身」上。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【绮命】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…好吧，那么我换一种说法——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e爱情这种东西，远在天边，近在眼前。不需强求，总有一天会自己送到你眼前…说不定就是今天呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【志华】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦~！我明白了，我明白了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【绮命】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你又明白什么了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【志华】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们果然是心意相通的！我会努力让你幸福，你愿意和我结婚吗？！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【绮命】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…不了，谢谢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【志华】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e姐姐今晚有空吗！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【绮命】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有，我要叫巡逻队了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"list\":null,\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1722502664","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数