/uploadstatic.mihoyo.com/ys-obc/2021/08/29/76953456/79b77eeb63503f854da4815f8e46ee89_562926552308174843.png\\\" data-entry-name=\\\"「那位先生」的委托\\\" data-entry-link=\\\"/ys/obc/content/2222/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/2222/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「那位先生」的委托\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"zs79o8sr2zT1720164275246\"],\"zs79o8sr2zT1720164275246\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，再见。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不论如何，祝愿你和你的家人都过得幸福。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，您好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e愿巴巴托斯的和风与您同在。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你好。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你也是来祈祷的吗?\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果坚持向巴巴托斯诚心诚意地祈祷，那么巴巴托斯也一定会回应我们的期待。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【莉莉是你的女儿吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是我祈祷的时候不留神说了什么吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…看来祈祷还是要专心才行呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e莉莉是我的女儿，是巴巴托斯赐予我的希望。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…唔，其实只是莉莉早上缠着我要礼物的原因吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zs79o8sr2zT1720164275246\":{\"option\":\"【你很爱护你的女儿呢。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，是啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…我以前经历过很多…错误的事情。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幸好最后走了出来，有了家庭，最重要的是…有了莉莉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要你不停下脚步，总有一天神会听到你，认可你的意志。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有些人在展现了愿望之后，得到了梦寐以求的「神之眼」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…而莉莉对我来说，也是像「神之眼」一样的心愿的结晶吧，或许还要更加宝贵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"list\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693738","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":fals