"repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【阿坎蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e大姐姐，你听说过「超复兴主义学派」吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有哦，姐姐我好像不是很懂时尚呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿坎蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗨呀呀，这个不怪你！因为那是我刚刚创造的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，所以是什么意思呢?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿坎蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是我即将引领、开拓和发扬光大的艺术学派。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e具体是什么样的风格…哼哼…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那就要看我接下来画出什么样的画了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，那听起来还挺厉害的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿坎蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…欸，真的吗？大姐姐真的觉得很厉害吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对啊，流行艺术不都是这样的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e首先有个东西，然后起个名字，最后，让更多的人看到并感到迷惑，喏，就能流行起来咯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"optio