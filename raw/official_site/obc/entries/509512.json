_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0b2q3elnq1saT1786691872683\":[\"jozba0yvns9T1786691957365\"],\"4cf2vhylew3T1710863944349\":[\"jozba0yvns9T1786691957365\"],\"62qdq7xhmgkT1786691628160\":[\"jozba0yvns9T1786691957365\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"h3t02eef66jT1786691870531\":[\"jozba0yvns9T1786691957365\"],\"hcwvr9efoziT1786691645079\":[\"jozba0yvns9T1786691957365\"],\"jozba0yvns9T1786691957365\":[],\"ko6ji1hse8iT1786691598933\":[\"p1fq2v21gxjT1786691626369\",\"62qdq7xhmgkT1786691628160\"],\"nqb471m7nmnT1710863941173\":[\"jozba0yvns9T1786691957365\"],\"p1fq2v21gxjT1786691626369\":[\"h3t02eef66jT1786691870531\",\"0b2q3elnq1saT1786691872683\"],\"z2tn3pzsbujT1710863943430\":[\"ko6ji1hse8iT1786691598933\",\"hcwvr9efoziT1786691645079\"]},\"contents\":{\"0b2q3elnq1saT1786691872683\":{\"icon\":\"\",\"option\":\"【唔…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，是老头子自顾自讲那么多，让你不耐烦了吧，唉，还真是抱歉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【不打扰了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？好的…好的，你请自便…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"62qdq7xhmgkT1786691628160\":{\"icon\":\"\",\"option\":\"【呃，下次我再听你说…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦…啊！不好意思，我这人一说起这些就…唉，是个老毛病了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，确实…仔细想想，的确应该是那个样子…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"h3t02eef66jT1786691870531\":{\"icon\":\"\",\"option\":\"【真有趣啊。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，历史和地理本就是密不可分的东西，有的时候综合来看，就如同在掌中纵观。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看来你也对这感兴趣，真是太好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"hcwvr9efoziT1786691645079\":{\"icon\":\"\",\"option\":\"【呃…我对冰原和裂谷不感兴趣。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…抱歉，一说起这些我就有点头脑发热，哈哈，不好意思啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"jozba0yvns9T1786691957365\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【队伍中存在「阿罗夏」时】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你上次要的地图册，就放在那里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我就知道找你准没错，莫老板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e每次听见你这么叫我，都觉得怪怪的…但你要这份冰渊的勘测地图做什么？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你不是那种要钱不要命的盗宝团，也不是那种热血上头后，就什么也不管的傻瓜冒险家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你想要在那些冰原和裂谷下找到什么？阿罗夏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e一头野兽。我和它交过手，侥幸活了下来，它跌下了冰渊，但…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e猎人的直觉，嗯？你觉得它没死，而且正在冰川下舔舐伤口，重聚爪牙，随时可能卷土重来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是。我要确保它死了，再不能危害任何人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你可以向冒险家协会报告，或者冬契军，他们会乐意帮忙的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你想要自己去猎杀，而且只想自己去猎杀，对吗？阿罗夏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e它是我的猎物。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e而你是它的猎人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e收好地图，我在里面放了一些零碎的勘测图，或许对你有帮助。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你，莫老板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e付了钱，就不用这么客气。等你回来，记得告诉我你在冰川下看见了什么，我相信这一定会非常有趣的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1024\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/81f42f1f48a4f381c17f0d7e8cb934f3_8834823113849099838.png\\\" data-entry-name=\\\"冒险家的经验\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/81f42f1f48a4f381c17f0d7e8cb934f3_8834823113849099838.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的经验\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"ko6ji1hse8iT1786691598933\":{\"icon\":\"\",\"option\":\"【是嘛…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是的，至于冰原的形成，从时间上来看，其实又要更早，早于基捷城的建立。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其实从观测水文的书籍上来看，旧基捷建立的地方为中心，曾经产生过巨大的地理变迁…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/14/178964736/11ee64c710e3b091256c0d349ac55461_8568235773460960819.png\",\"option\":\"【这里有什么书卖吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，都在这里了，你随便看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"p1fq2v21gxjT1786691626369\":{\"icon\":\"\",\"option\":\"【哦…然后呢？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这或许也是至冬与边地挪德卡莱之间那巨大的冰川结构，或是新基捷和至冬堡之间冰川的来源。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很久以前就有传闻说，旧基捷城地下藏着了不起的秘密，说不定是真的呢，呵呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【什么样子？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什么？哦，我是在想新基捷城边的裂谷…据说很久以前不是这样…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只不过从战争史，和五百年前的一些文书记录来看，那里或许本来是一整块冰原…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而具体到底是何时产生那样大的裂谷，以至于冰原冻土都被切分，这其中的缘由值得深究。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1786698792","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"le