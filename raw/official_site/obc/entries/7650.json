3235750385\"],\"bmef9z2y5zwT1713235750385\":[\"o9qv5mb3hbpT1713235864935\",\"81kku8rwz32T1713235880039\"],\"buebnrfzqjsT1713236201151\":[\"tkzc5slte5T1713236227392\"],\"cenvyeffxnlT1713235693751\":[\"ht0khrhibwT1713235706311\"],\"efxblgcgsvhT1713235932256\":[\"fz5eeunn46kT1713236125543\"],\"et8osuv5o0kT1713236201639\":[\"tkzc5slte5T1713236227392\"],\"ewllh0qqr0dT1711546416025\":[\"hjgwqe4bjx8T1713234760833\",\"pc493jyljocT1713234761376\"],\"fz5eeunn46kT1713236125543\":[\"buebnrfzqjsT1713236201151\",\"et8osuv5o0kT1713236201639\"],\"hjgwqe4bjx8T1713234760833\":[\"beqhxil5idT1713234775375\"],\"ht0khrhibwT1713235706311\":[\"6o6ac8401eqT1713235407007\",\"2rpiysumdl7T1713235406431\"],\"iestlh2nolT1713235931759\":[\"fz5eeunn46kT1713236125543\"],\"o9qv5mb3hbpT1713235864935\":[\"ht0khrhibwT1713235706311\"],\"pc493jyljocT1713234761376\":[\"beqhxil5idT1713234775375\"],\"tkzc5slte5T1713236227392\":[],\"xobpe5q1r1rT1713235593303\":[\"iestlh2nolT1713235931759\",\"efxblgcgsvhT1713235932256\"]},\"contents\":{\"2rpiysumdl7T1713235406431\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是叫这个名字吗？算了，没所谓了。你是好人，派蒙也是好人。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我来这里，是要找一个很重要的东西。你知道我要找的是什么吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：派蒙在外面等我。\"},\"6o6ac8401eqT1713235407007\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e\u003cspan\u003e我来这里，是要找一个很重要的东西。你知道我要找的是什么吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你还好吗？\"},\"81kku8rwz32T1713235880039\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e阅读：\u003c/strong\u003e……\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与「揭示之书」交互\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e阅读：\u003c/strong\u003e（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e要进行「冥想」吗？要注意安全喔…\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：暂时算了。\"},\"beqhxil5idT1713234775375\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e所以，我不希望你冒险。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e但是…但是，一直以来我们不是一起冒险的吗？我们在一起，就没有克服不了的困难、战胜不了的敌人才对…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e里面的危险可能不是战斗能解决的。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e……\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e好吧！哼，你比我聪明多了，我相信你。那你可别抛下我喔！我会一直等你回来的！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e我一定会回来的。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e「揭示之书」：\u003c/strong\u003e（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"bmef9z2y5zwT1713235750385\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e好喔！\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与「揭示之书」交互\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e阅读：\u003c/strong\u003e（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e派蒙：\u003c/strong\u003e要进行「冥想」吗？要注意安全喔…\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我先准备一下…\"},\"buebnrfzqjsT1713236201151\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：关于巨人的花园的事情。\"},\"cenvyeffxnlT1713235693751\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e「揭示之书」：\u003c/strong\u003e（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我一定会回来的。\"},\"efxblgcgsvhT1713235932256\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我想起来了。没错，我们带着莉诺尔逃出了海底的牢狱。孩子们不应该生活在那样的地方。她应该生活在阳光下、花丛中。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：拯救莉诺尔？\"},\"et8osuv5o0kT1713236201639\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：关于学徒与小鱼的事情。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e「揭示之书」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e夏诺蒂拉好像不在呢，可能又到那个神秘的地方去了！要进行「冥想」吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e听了她上次说的话…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e有点在意。我要去看看。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔…虽然有点不安，不过我们一起去吧！夏诺蒂拉真是让人担心呢！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e派蒙，你在外面等我就好。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e欸？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「揭示之书」的世界…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"fz5eeunn46kT1713236125543\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e啊，金色的蝴蝶。像阳光一样耀眼的颜色。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e只要得到了那样的光，一切都会…一切都会…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e追寻光芒\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与人影对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…是吗，那就好说了。你叫什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e卡特皮拉。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者，没想到会在这里遇到你。派蒙没在你身边吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等等，你该不会也是什么怪物，变成我认识的人的样子来戏弄我的吧。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们不久前才见过。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…是这样吗？自从和你告别，感觉已经过了很久了。算了，可能是年纪大了吧，我能记得的事情越来越少。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…你真的不是什么怪物吧？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你还记得吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"hjgwqe4bjx8T1713234760833\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：可能比想象中更危险。\"},\"ht0khrhibwT1713235706311\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e通过揭示之书进入「冥想」的世界\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e追寻人影\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e（不是之前「冥想」抵达的地方。那边是…）\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e追寻人影\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e追寻人影\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e追寻人影\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与人影对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e……\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e卡特皮拉。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e谁？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e…原来是你啊。我记得你。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e你怎么会在这里？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e被你抢先了。我也想问你这个问题呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e没什么，我只是觉得…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e卡特皮拉：\u003c/strong\u003e你是旅行者，对吧？你身边那个白色的小东西…叫什么名字来着？她怎么没和你一起？\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"iestlh2nolT1713235931759\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e大师他怎么了？你也是水仙十字结社的成员吗…还是说，你是吉约丹的人？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：战胜纳齐森科鲁兹？\"},\"o9qv5mb3hbpT1713235864935\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e阅读：\u003c/strong\u003e（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：嗯。\"},\"pc493jyljocT1713234761376\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：可能有我们不知道的一面。\"},\"tkzc5slte5T1713236227392\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我记得。我记得。你真的是你。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e抱歉，我在这里遇到了太多不可思议的事情，也经过了许多无法取胜的战斗。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但这里终于发生了变化。金色的光芒已经升起，向日葵已经开放。也许就算是古人臆想的宇宙也会发生变化。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e也许一切都会变好。也许我也能够理解，然后放下。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e卡特皮拉…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e跟我一起走吧。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哈哈哈，看来真的是你。我想起来了，我曾经认识的你，就算到现在也没有变。你总是多管闲事，这是因为你正直而善良。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但你不用担心我。我不需要帮助。你也见识过我的身手。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e况且，对于这里的事情，或许我比你懂的还多呢。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e丘丘人，帮我告诉那位少年(少女)，请他(她)赶紧离开。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你有话对我说吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…你能听懂我说的话？嗯，那我问你。在你眼里，我是什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e狗。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这样啊…那还来得及。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这也是为了你好。离开这里吧，少年(少女)。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我同意。旅行者，你属于更光明的世界。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我还有问题…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e「小狗」：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你不应该有。再见。不要再回来了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与派蒙对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e呜哇！你回来了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我离开了多久？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔，也就一眨眼的事情…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e如果对你来说只是一眨眼的话…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e怎么了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e没什么。这里面确实很危险。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是喔…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这么说来，夏诺蒂拉怎么还没回来呀？该不会到枫丹廷里当警卫去了吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…下次再来吧。我头有点晕。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是喔。那一起去找点东西吃吧？你害得我都担心得饿了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不是才过了一眨眼的时间？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我可是很用力很用力地担心你！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"xobpe5q1r1rT1713235593303\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e算了，就当我没问吧。你怎么会在这里？快点离开。这里很危险，以前有人来这里接受试炼，结果迷失了，脑子变成了浆糊…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cstrong\u003e\u003cspan\u003e卡特皮拉：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我想起来了，我和你，我们曾经做过很厉害的事情。那是我的一生中唯一值得骄傲的事情…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你是说…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1754528400","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display