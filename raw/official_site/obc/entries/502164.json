ry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502421/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e一场公差\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"l4tf2wmkvpnT1724851830909\",\"odiyh72rt7T1724851832093\"],\"9rq1nlnfdk5T1724851918953\":[],\"l4tf2wmkvpnT1724851830909\":[\"9rq1nlnfdk5T1724851918953\"],\"odiyh72rt7T1724851832093\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好。需要饰品，还是武器？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9rq1nlnfdk5T1724851918953\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我也觉得。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过对我来说还是太过新潮了，一般来说在工具上镶嵌两三颗自己喜欢的石头就足够充当个人标志了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e忘了自我介绍，我是「穆胡鲁宝石铺」的店主，是一名珠宝匠，也会打些武器。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我做的武器大多是比较传统、被历史证实了可靠好用的款式。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你要是喜欢更新颖的东西，可以去问问希诺宁，但她不太容易找到，你可能得翻遍纳塔所有的树。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【真了不起。】\"},\"l4tf2wmkvpnT1724851830909\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对啊，怎么了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对我们部族的人来说，锻造饰品和武器没什么区别，都是使用燃素辅助加工矿物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e用宝石装饰武器和工具就更常见了。如果有哪件装备上没有宝石，就说明它不好用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e反之，你要是见到有人举着一把镶满水晶的凿子挖矿，不用怕，更不用担心，这只能说明他干劲儿十足。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【饰品和武器都能做？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"odiyh72rt7T1724851832093\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没事，慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【暂时不用。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1732547249","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_