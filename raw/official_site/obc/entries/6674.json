:false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【樱染的街巷好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我喜欢这样的街景！既热闹又漂亮。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e尤其是爬上房顶，从上往下看着人们来来往往的时候，特别有意思！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸对了，机会难得，不如和我一起试试吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【幽芳与恬谧之中好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这两颗大树看起来好结实啊！树叶也好密实。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e要是爬到上面睡觉的话，一定很舒服吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e微风吹拂树叶的声音，再加上喷泉的流水声…啊——我已经困了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"1xm1c6egvylT1712844912520\":[],\"1z88ixjh6ppT1712844654284\":[\"vy4lrbwq55T1712844853814\"],\"27f6kqpltdfT1712844292542\":[],\"31kkb5o9ucT1712844413519\":[\"z3xt6ladk1oT1712844519759\"],\"4cf2vhylew3T1710863944349\":[\"vy4lrbwq55T1712844853814\"],\"4h2z7bk3m9sT1712844232930\":[\"9qfb4tj9ospT1712844274036\"],\"539pcctd34wT1712844344847\":[\"54a13xmmcjeT1712844368995\",\"z78rq8uzq4T1712844370707\"],\"54a13xmmcjeT1712844368995\":[\"31kkb5o9ucT1712844413519\",\"m383hwhy9ufT1712844433994\"],\"6vrpmpopq3pT1712844309049\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"1z88ixjh6ppT1712844654284\",\"f80vc221qgmT1712844940205\",\"8oqmieurfjlT1712844941331\"],\"8oqmieurfjlT1712844941331\":[],\"9qfb4tj9ospT1712844274036\":[\"27f6kqpltdfT1712844292542\",\"6vrpmpopq3pT1712844309049\"],\"f80vc221qgmT1712844940205\":[],\"gqc6lwsa4ofT1712844882942\":[],\"m383hwhy9ufT1712844433994\":[\"z3xt6ladk1oT1712844519759\"],\"nqb471m7nmnT1710863941173\":[\"4h2z7bk3m9sT1712844232930\",\"tzd20s2tvuqT1712844258633\"],\"tzd20s2tvuqT1712844258633\":[\"9qfb4tj9ospT1712844274036\"],\"vy4lrbwq55T1712844853814\":[\"gqc6lwsa4ofT1712844882942\",\"1xm1c6egvylT1712844912520\"],\"z2tn3pzsbujT1710863943430\":[\"539pcctd34wT1712844344847\"],\"z3xt6ladk1oT1712844519759\":[],\"z78rq8uzq4T1712844370707\":[\"z3xt6ladk1oT1712844519759\"]},\"contents\":{\"1xm1c6egvylT1712844912520\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，你很懂行呀？我果然没有问错人！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个…等你什么时候有空，可以陪我逛逛商店吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想买些好看的小饰品，有你提供意见，肯定会更顺利！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不如再搭配点别的。】\"},\"1z88ixjh6ppT1712844654284\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，我有个事情早就想问你了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你喜欢怎样打扮自己呀？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】（对荧）\"},\"27f6kqpltdfT1712844292542\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e壶灵？跟付丧神类似吗？难道说她的本体是个茶壶？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还是说…现在的样子正是她原本的形态，而她也像我一样，能变成一名少女？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，太让人好奇了！请介绍我跟她认识认识吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那是壶灵阿圆。】\"},\"31kkb5o9ucT1712844413519\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e停停停！再数下去感觉尾巴都要打结了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【一只猫又两条尾巴…】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，我有个事情早就想问你了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你知道人类女孩子喜欢些什么打扮吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】（对空）\"},\"4h2z7bk3m9sT1712844232930\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这是你应得的，我才该多谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【好高的评价…】\"},\"539pcctd34wT1712844344847\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e噢，这个话题好！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e接单量对我来说不是难事，妖怪的腿脚天生跑得就快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但好评率就没那么容易维持了。怕麻烦，不想多费周折是人之常情…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e奇怪…为什么是只猫的时候，路过的人会花时间来看我晒太阳，但变成人后就没人愿意多花些时间给个好评呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【聊聊快递工作？】\"},\"54a13xmmcjeT1712844368995\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可能会有一点吧，尤其在筹备祭典的时候，加急件总会像墩墩桃那样挤在一堆。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真想妖力变得更强些。这样说不定能跑得更快，或者变出好多个自己。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不辛苦吗？】\"},\"6vrpmpopq3pT1712844309049\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊！不会的，不会的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是有一点点好奇而已，想知道她是怎么来的，平时会想些什么、做点什么…说不定还能交上朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有机会的话，请介绍我跟她认识认识吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【她可不能吃。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者！今天天气真好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…仔细想想，这里的天气总是一个样呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8oqmieurfjlT1712844941331\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安。梦里要是听到嘎吱嘎吱声的话，可不要觉得奇怪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我…我尽量不在半夜吃东西。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，绮良良。】\"},\"9qfb4tj9ospT1712844274036\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e噢噢，我懂，是最后的简答部分，好大一个空格子对吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…我想想啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我对那只个头大大的碧团雀挺感兴趣的。看上去胖墩墩、毛茸茸的，模样很悠闲，警惕性也低…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【还有其他感想吗？】\"},\"f80vc221qgmT1712844940205\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早，旅行者！我今天看起来还不错吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你放心，这里的团雀我一只都不会碰的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，绮良良。】\"},\"gqc6lwsa4ofT1712844882942\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的吗？那太好啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个…等你什么时候有空，可以陪我逛逛商店吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想买些好看的小饰品，有你提供意见，肯定会更顺利！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【的确很可爱。】\"},\"m383hwhy9ufT1712844433994\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e停停停！再数下去感觉尾巴都要打结了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【三只猫又六条尾巴…】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，那么快就到「用户回访」环节了吗？咳咳，那我可要认真作答。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e环境分，五星！这里风景优美，难能一见，好像还存在着某种我看不透的妖力…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e舒适度，五星！晚上我在箱子里睡得可安稳了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有噪音，没有强光，完全可以给满分！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最后…服务分也是五星，无可挑剔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"tzd20s2tvuqT1712844258633\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你做了那么多，有这个机会，我当然要好好表达自己的心情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【好认真的回答…】\"},\"vy4lrbwq55T1712844853814\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e太突然了吗？抱歉抱歉！那我从头讲好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你知道，我虽然是个妖怪，但从小时候起，就一直受到人类奶奶的照顾。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e人的故事，比妖的故事，听得多的多了。温暖又多彩的人类社会，我非常向往！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e于是，我好不容易才用妖力变出了现在的外貌，可新的问题又来了。如果打扮和举止太像「猫又」，也不太好…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以，我偷偷观察了人类女孩子的打扮，大家似乎都很喜欢蝴蝶结和花朵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我就给自己的衣服加了不少！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这个…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，有什么想问我的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"},\"z3xt6ladk1oT1712844519759\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊。多亏了它，我才能这样融入人类的城市。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e负责一点…才能算「报恩」？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【听上去你很热爱工作。】\"},\"z78rq8uzq4T1712844370707\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，我现在是唯一一位，「狛荷屋」金牌级快递员。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e之前老板还想给我一笔特别奖励呢！但我也说了，还是公费出游…啊不，还是多给我些接跨国件的机会更好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【收效如何？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712847187","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"地区\\\",\\\"children\\\":[{\\\"label\\\":\\\"蒙德\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"璃月\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"稻妻\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"须弥\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"枫丹\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"纳塔\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"挪德卡莱\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"至冬\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"活动地区\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"洞天\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"活动\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"商人\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"任务\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"牌手挑战\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"对话奖励\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"特殊效果\\\",\\\"children\\\":[{\\\"label\\\":\\\"心声\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"秘闻馆情报\\\",\\\"children\\\":[]}]}]\"},{\"type\":\"text\",\"attribute_name\":\"首页更多\",\"attribute_key\":\"home_more\",\"value\":\"https://baike.mihoyo.com/ys/obc/channel/map/189/20?bbs_presentation_style=no_header\"},{\"type\":\"text\",\"attribute_name\":\"在目录中展示\",\"attribute_key\":\"show_in_catalog\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"最新词条\",\"attribute_key\":\"is_latest\",\"value\":\"0\"},{\"type\":\"text\",\"attribute_name\":\"更多入口icon\",\"attribute_key\":\"king_kong_icon\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"首页更多文案\",\"attribute_key\":\"home_more_text\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"开放全量C端玩家可新建词条\",\"attribute_key\":\"open_for_create\",\"value\":\"0\"}]","updated_at":"-62135596800"}],"template_id":"6605788895f7dc84ca833e44","ext":{"fe_ext":"{\"c_20\":{\"filter\":{\"text\":\"[\\\"地区/洞天\\\"]\"}}}","post_ext":{"post_id":"","post_user_name":"","post_time":"0","post_avatar_url":"","url":""},"server_ext":"","personalized_color":"","scrolling_text":"","corner_mark":"None"},"alias_name":"","lang":"","beta":false,"page_type":"Default","menu_style":"","status":"Online"}}}