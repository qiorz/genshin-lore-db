0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【我要解签⋯】——抽了御神签后\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e把竹签交出来\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【（运势为吉）】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我瞧瞧我瞧瞧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，还不错嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e和派蒙在一起，一定会幸运的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【（运势为凶）】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我瞧瞧我瞧瞧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，是「凶」！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这种情况我记得！是说⋯「把凶签捆到『御签挂』上。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「然后请派蒙吃好吃的，就可以逢凶化吉。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【是这样喔？】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然了，你要质疑古人的智慧吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e古人的智慧真了不起哪！总之，先找找御签挂吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【态度⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？有什么问题吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【没、没有。】\u003c/p\u003e\u003chr\u003e\u003cp\u003e【再见。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务 特别的御神签后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊呀，旅行者，您好！您今天也要来解签吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【我要解签⋯】——抽了御神签后\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好的，请将竹签给我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【（运势为吉）】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我瞧瞧我瞧瞧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，还不错嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e和派蒙在一起，一定会幸运的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【（运势为凶）】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我瞧瞧我瞧瞧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，是「凶」！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这种情况我记得！是说⋯「把凶签捆到『御签挂』上。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「然后请派蒙吃好吃的，就可以逢凶化吉。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【是这样喔？】\u003c/p\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然了，你要质疑古人的智慧吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e古人的智慧真了不起哪！总之，先找找御签挂吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【关于这种纸片儿⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，您是说「御神签」吧？求签的流程是这样的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e首先需要由您用力摇晃「御神签箱」，取出一根竹签。然后，需要麻烦您将竹签交给我，我会将其换成对应的「御神签」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果是「凶签」的话，可以将其结在「御签挂」是逢凶化吉喔。大致就是这样一回事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【玄冬小姐懂得真多。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哪、哪有，这毕竟是⋯是巫女的基本素养嘛！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【最近怎么样？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢您的关心，我最近感觉很不错！我能够成为真正的巫女，离不开您和其他许多人的帮助。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我会在这里虔诚地为诸位祈祷。如果您有什么烦恼的话，我也很乐意倾听哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【有百代小姐的消息吗？】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e很遗憾，我回到这里的时候，百代小姐已经走了，我至今没能当面向她道谢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但我想，未来我一定能和她再见的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【再见。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e再见！愿您拥有美好的一天！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「御神签箱」】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（确实记得说求签的流程是⋯每天有一次机会，从「御神签箱」中摇出竹签，再向玄冬小姐换取「御神签」。要摇竹签，看看今日的运势吗？）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【求签吧。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（拿起了签筒⋯）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e【下次再说吧⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（放下了签筒⋯）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「御神签箱」 抽过签后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（确实记得说求签的流程是⋯每天有一次机会，从「御神签箱」中摇出竹签，再向玄冬小姐换取「御神签」。）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（今天已经摇过了。明天再来看看吧⋯）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1710318557","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unl