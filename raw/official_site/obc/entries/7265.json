s_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【持续旋转的灵感发条好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这种储能炉其实可以再加装一层炉芯，比商家宣传的更耐用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有这种风扇，它的电机一直在以临界转速工作，这样不够安全…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e抱歉！一说到这些，我就变得忘乎所以。如果你允许，我…我保证可以把它们调整得更加合适！尽我所能…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【静隐水下的海沫浮光好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这种建筑，还有这些圆圆的小灯，都是海沫村的风格吧？我在画册上见过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我一直相信那个传说：美露莘的家乡是位于水底的一座小村庄，那里与世无争，就像童话里的村落一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个…还请不要对别人讲。这种想法…可能其他人听了会觉得幼稚吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"1x8ewpk4tcfT1712738169250\":[],\"3afeakvh2knT1712738406884\":[\"6erl2scp5cT1712738435023\"],\"4cf2vhylew3T1710863944349\":[\"95ivl2ereytT1712738536413\",\"rkx6ccjm7jkT1712738537503\"],\"6erl2scp5cT1712738435023\":[\"l2v1wldj8bfT1712738460682\",\"ig1rjo96pvqT1712738470414\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"rw3hv3rg9tqT1712738661283\",\"p6xjgafnl1T1712738662370\"],\"8grbrk9kd4vT1712738648085\":[],\"8k7l7j6qp09T1712738594052\":[\"8grbrk9kd4vT1712738648085\"],\"95ivl2ereytT1712738536413\":[\"8k7l7j6qp09T1712738594052\",\"y3z7pjevc3mT1712738595254\"],\"cfkh81viiffT1712738225977\":[],\"ig1rjo96pvqT1712738470414\":[],\"kg22i1k4p7oT1712738328262\":[\"3afeakvh2knT1712738406884\",\"naljcpl3y1aT1712738409210\"],\"l2v1wldj8bfT1712738460682\":[],\"naljcpl3y1aT1712738409210\":[\"6erl2scp5cT1712738435023\"],\"nqb471m7nmnT1710863941173\":[\"1x8ewpk4tcfT1712738169250\",\"cfkh81viiffT1712738225977\"],\"p6xjgafnl1T1712738662370\":[],\"rkx6ccjm7jkT1712738537503\":[\"8k7l7j6qp09T1712738594052\",\"y3z7pjevc3mT1712738595254\"],\"rw3hv3rg9tqT1712738661283\":[],\"y3z7pjevc3mT1712738595254\":[\"8grbrk9kd4vT1712738648085\"],\"z2tn3pzsbujT1710863943430\":[\"kg22i1k4p7oT1712738328262\"]},\"contents\":{\"1x8ewpk4tcfT1712738169250\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对不起…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我怕什么想法都往外说的话，会让听的人产生不必要的误解。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…好吧，那我遵从你的意愿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e其实，我…我有点想家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然住得很舒适，环境无可挑剔，但我暂时还没法…彻底融入这里的生活。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是我自己的问题…请你不要误会成我对你或这个地方有任何的不满。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…也请你原谅我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你不用那么拘谨。】\"},\"3afeakvh2knT1712738406884\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要解释的话…就得提到很久很久以前，我在绘本上读到的故事了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【它的名字有什么来历吗？】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…等你有空，可以请你陪我去几个地方吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e勒波特钟表店、博蒙特工坊还有瓦萨里回廊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"6erl2scp5cT1712738435023\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…说在遥远的海滨小镇，生活着一只黑白相间的海鸟。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e它生来就不会飞翔，走路歪歪扭扭，说话结结巴巴，因此遭到了其他海鸟的排挤。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e直到后来有一天，贪婪的海盗从水下宫殿偷走了镶满珍珠和黄金的冠冕…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e转眼间，电闪雷鸣，眼看海啸即将吞灭陆地…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e黑白的海鸟纵身一跃，却依旧无法飞翔…舍命之举使它撞断了桅杆，连同破船一起沉入海中。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e盘旋的海鸟都以为它会就此溺于水中，却没想到，在海里，它游得比谁都快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e它游啊游，一直游到筋疲力尽。它终于将冠冕归还了原处。顷刻间风平浪静，仿佛一切都不曾发生。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e恐怕你已经猜到了…故事里的海鸟就叫「佩伊」，它是一只意外来到小镇的企鹅。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想听！】\"},\"7s5565lp488T1712738549262\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…我想去看看发条工艺品，还有各式各样的机械装置。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平日里我常去的是莱舒的发条工坊，但路过其他店的时候，总免不了好奇…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e深处的橱柜藏着怎样的商品？会不会有什么既新鲜又精巧的设计？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真想一件不落地看下来！可是…唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我不太擅长和人打交道…如果闷声看了半天却是只看不买，肯定会被店家讨厌的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个时候，就需要麻烦你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我在。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8grbrk9kd4vT1712738648085\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e太好了！…简直像做梦一样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没问题。】\"},\"8k7l7j6qp09T1712738594052\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…对的。我知道这样很为难…但…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你只要帮我解释两句就好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我会报答你的！只要我力所能及…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【帮你解释？】\"},\"95ivl2ereytT1712738536413\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…我想去看看发条工艺品，还有各式各样的机械装置。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平日里我常去的是莱舒的发条工坊，但路过其他店的时候，总免不了好奇…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e深处的橱柜藏着怎样的商品？会不会有什么既新鲜又精巧的设计？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真想一件不落地看下来！可是…唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我不太擅长和人打交道…如果闷声看了半天却是只看不买，肯定会被店家讨厌的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个时候，就需要麻烦你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【当然可以啊。】\"},\"cfkh81viiffT1712738225977\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈…你希望我如此吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…好吧，那我遵从你的意愿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e其实，我…我有点想家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然住得很舒适，环境无可挑剔，但我暂时还没法…彻底融入这里的生活。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是我自己的问题…请你不要误会成我对你或这个地方有任何的不满。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…也请你原谅我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你可以实话实说。】\"},\"ffyuh7fxcscT1712738504770\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我很崇敬故事里的「佩伊」，但读完之后，却深切地感到…它很孤独…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以，我想跟它相互依偎，相互取暖…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"hr8cd6hrtgpT1712738170300\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…好吧，那我遵从你的意愿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e其实，我…我有点想家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然住得很舒适，环境无可挑剔，但我暂时还没法…彻底融入这里的生活。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是我自己的问题…请你不要误会成我对你或这个地方有任何的不满。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…也请你原谅我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"ig1rjo96pvqT1712738470414\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我很崇敬故事里的「佩伊」，但读完之后，却深切地感到…它很孤独…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以，我想跟它相互依偎，相互取暖…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【真是个不错的故事。】\"},\"jm0ivjshsmT1712738423209\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要解释的话…就得提到很久很久以前，我在绘本上读到的故事了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"kg22i1k4p7oT1712738328262\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…谢谢你，能够记住它的名字。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【 聊聊佩伊怎么样？】\"},\"l2v1wldj8bfT1712738460682\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…哈，是啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我很崇敬故事里的「佩伊」，但读完之后，却深切地感到…它很孤独…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以，我想跟它相互依偎，相互取暖…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【原来你是英雄的同伴！】\"},\"naljcpl3y1aT1712738409210\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要解释的话…就得提到很久很久以前，我在绘本上读到的故事了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【它为什么是这个外形呢？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我是说…我很习惯，一切都好，不用为我担心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"},\"p6xjgafnl1T1712738662370\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「愿你的梦境如海上星空般璀璨绮丽，而无梦之夜唯有安详。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，菲米尼。】——【夜晚】\"},\"rkx6ccjm7jkT1712738537503\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…我想去看看发条工艺品，还有各式各样的机械装置。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平日里我常去的是莱舒的发条工坊，但路过其他店的时候，总免不了好奇…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e深处的橱柜藏着怎样的商品？会不会有什么既新鲜又精巧的设计？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真想一件不落地看下来！可是…唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我不太擅长和人打交道…如果闷声看了半天却是只看不买，肯定会被店家讨厌的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个时候，就需要麻烦你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是有什么想逛的吗？】\"},\"ron5reibg6T1712738626487\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你只要帮我解释两句就好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我会报答你的！只要我力所能及…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"rw3hv3rg9tqT1712738661283\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有特殊指派的话，我就原地待命了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，菲米尼。】——【白天】\"},\"y3z7pjevc3mT1712738595254\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？！当、当然不是这个意思…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你只要帮我解释两句就好了…\u003c/