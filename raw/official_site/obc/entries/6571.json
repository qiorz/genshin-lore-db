t-upload.mihoyo.com/ys-obc/2023/05/21/288180982/a3de6793e9032b9d5ae68ed9df86d0f8_1890374893862620705.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"ewllh0qqr0dT1711546416025\":[\"zm08lmlamaT1714893496469\",\"zys2stibw3T1714893500876\"],\"zm08lmlamaT1714893496469\":[],\"zys2stibw3T1714893500876\":[]},\"contents\":{\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往地下遗迹入口\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：看呐，命运的时刻就要来到了！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：……\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：唔，明明只是个普通的机关门而已吧！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：咳，我的意思是说，只要打开这处机关门，我们就能进到这个遗迹里面了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：想到是第一次进入荼诃人的遗迹，内心还有些激动呢！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：欸？看你之前那么自信的样子，我还以为你早就探索过很多遗迹了呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哈，虽然没有亲身探索过，但通过研究我手中这本伟大的古代学者留下的「雷内的调查笔记」，我可就如身临其境一般呢！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：「雷内的调查笔记」？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：你们也没听说过吗？我还以为只有偏居沙漠如我才会不知道这位学者的大名呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：这本笔记中抄录了不少荼诃人留下来的记录。根据作者的说法，他曾经在这些遗迹中找到了「超越凡人」的知识。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：怎么越听越感觉不靠谱了！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：这个暂且不提，总之有了这本笔记，再进入这些荼诃遗迹可以说就是畅通无阻了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：你们要是不相信的话，我们就先验证一下！比如想要解开这处机关的话…哦哦，找到了！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：「转动齿轮使之显现全部三种符号，在不改变底部三角符号的同时，使矩形与之相连」，总之你们按照我说的试一下就好了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e打开遗迹大门\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e进入遗迹\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：看来我们终于到达这个遗迹的中心了，那么就由对荼诃遗迹颇有研究的本人来为你们进行说明吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：根据笔记中的说法，这里原本是荼诃人研究与试验机关性能的试验基地，而灵光绝唱就位于最深处的试验场。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：想要去到那里的话，首先…\u003c/p\u003e\u003cp\u003e（\u003ca href=\\\"/ys/obc/content/6375/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\"\u003e夹在笔记中的示意图\u003c/a\u003e）\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：刚刚还说自己有研究，现在就开始明目张胆地翻书了！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：毕竟此处遗迹的结构实在太复杂了。这些荼诃人所设置的神秘装置，我想没人能不看说明就搞清楚它们的运作原理。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：让我看看…嗯，我知道了。看来我们所在的位置就是整座试验基地的控制中心。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：想要到达灵光绝唱所在的位置，必须先启动整座遗迹的控制系统才行。而为了启动控制系统，还得先解决能源问题。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：虽然据说荼诃人会利用污秽的力量驱使机关和魔物，但这座遗迹似乎并没有使用污秽作为能源。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：相反是依靠一种被称为「阿索斯物质」的能源运作的。它们是从纯粹的元素能量中提取出来，然后凝练成块状。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：也就是说只要能找到这种能量块，便可以为这些能量核心供能，剩下的问题应该也能迎刃而解了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：听上去还真是麻烦，要是能靠战斗解决就好了。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"zm08lmlamaT1714893496469\":{\"dialogue\":\"\u003cp\u003e旅行者：那么我们就开始吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哦哦，干劲满满啊，不愧是尊使的谒颂主。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 既然这样，寻找能量块的工作就交给你们了。这张是描绘了这座试验基地结构的示意图，我想你们一定会用得上。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 那么我还有些事情需要研究，就在这里等你们回来了。有尊使和你们一同前往，想必一定是所向披靡。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 有什么问题，就多研究一下这张示意图吧。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e寻找能量块\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e返回控制中心\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：果然和笔记中所说的一样…嗯？你们怎么这么快就回来了？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不过看你们的样子，应该已经找到了我们所需要的能量块了吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：这些能量核心我已经检查过了，保存得都相当完整。接下来只要把能量块装载到里面就可以了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：那么就拜托你们了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e装载能量块\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：只要将能量块装载到这些能量核心里面，整个控制系统应该都能启动了…\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：能量核心已经装填完毕，这样整个控制系统应该都能启动了…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：嗯？和预期中的反应不一样啊，是哪里出了什么问题吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：看上去得去中继装置所在的控制室看看了，反正要前往试验场也得经过那里。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哦哦，正好控制室的位置就在你们刚刚过来的方向，我们一起过去吧！\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往中继装置所在的控制室调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：果然是这些中继装置的问题，自能量核心所输出的动力无法传输到它们上，得想办法把它们都连通起来才行。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：而且这些中继装置还都被结晶所封印了，但这些遗迹明明并未使用污秽的能量，应该不会引起灵光的注意才对…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：唯一的解释便是，这里是被能够操纵灵光之力的人所刻意封禁的。但这又是为了隐藏什么呢…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哈，这些事情以后再论。现在的当务之急还是得用灵光的力量消除掉这些封印装置的「灰余晶」。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：嗯…附近应该会有蕴含着灵光力量的「灵芯」，尊使大人应该也能感觉到吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：唔…哼，这是当然，你是在质疑身为花灵勇者的吾之伟力吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：岂敢，那么就拜托尊使大人为我们引路了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：只要找到「灵芯」消除了「灰余晶」，然后再操作混变器将这些中继装置连通就好了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e连通能源线路\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往左侧房间调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e连通能源线路\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往试验场调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：尊使大人，还有尊使的谒颂主，恐怕我只能陪你们到这里了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：又怎么了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：按照文献中的记载，接下来的路途充满凶险，并非本人的凡人之躯所能承受。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：从这里进去便是古时荼诃人用来试验机关性能的试验场，其中还有一架未完成的实验型的巨型机关。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：根据笔记中所抄录的荼诃人的记录，虽然没有发挥什么作用，但这里曾被改造为狙击魔物的防御工事。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：很奇怪不是吗，明明是引发了污秽灾厄的荼诃人，却建造了对抗魔物的机关。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不过既然我们现在已经启动了整座遗迹的控制系统，想必这个试验场里面的防御机关也被启动了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：而我们要找的灵光绝唱，应该就藏在里面的巨像当中。虽然使我望而却步，但对于诸位来说，必定是小菜一碟。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：为了能够集齐全部的灵光绝唱，请允许我暂且在此等候诸位。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：毕竟你也不过是区区人类，这样的请求也算是合情合理。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：蒙您恩许。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：虽然那先朱那又临阵脱逃了，不过反正你们两个不凑在一块我也感觉轻松很多啦…\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e进入试验场\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e调查奇怪的装置\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与斯露莎对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：地上出现了一台奇怪的大炮，意思是说要让我们射击那边的大机器人吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：唔…还真是贴心的设计呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：白飘飘的想象力还真是够丰富的，刚才「纳苏勒阿」不是说过，这里是由试验机关性能的试验场改造而来。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：想必我们刚才解开的装置，便是用来启动这个试验场的吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：虽然经过了改造，但原本的机关也并未来得及拆卸，可以说是帮了我们大忙呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：那么，我的谒颂主，操作这台大炮的任务可就交给你了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e启动遗迹重炮\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e击退敌人\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e使用遗迹重炮摧毁巨像的核心\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e调查展开的装置\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e取得灵光绝唱\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e离开试验场\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不愧是尊使大人和谒颂主，不管是荼诃的机关还是迪弗的魔物都无法阻止你们前进的步伐。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：欸？那先朱那你是什么时候进到这里来的？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：我可是一直在外面欣赏你们战斗的英姿呢！看到你们已经取得了灵光绝唱，我就赶紧跟上来了啊。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：真是辛苦你们了，那么不如就先把灵光绝唱交由我来保管吧，这样的话，怎么说呢，会让我比较有参与感？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：不过那先朱那根本就没怎么出力吧，而且祖尔宛也说不能把灵光绝唱随便交给别人。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：话可不能这样说。况且我对灵光绝唱可是很有研究的，先让我研究一下对于后面的事情也会很有帮助吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：比如这些灵光绝唱究竟为什么会被藏在这些遗迹之下…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：现在不是讲故事的时候，纳苏勒阿。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"zys2stibw3T1714893500876\":{\"dialogue\":\"\u003cp\u003e派蒙 : 对哦，之前在须弥我们操控过的大机器人，里面不是也有类似的装置吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 哦哦，没想到你们竟然接触过这种装置，那么问题就简单了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 既然这样，寻找能量块的工作就交给你们了。这张是描绘了这座试验基地结构的示意图，我想你们一定会用得上。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 那么我还有些事情需要研究，就在这里等你们回来了。有尊使和你们一同前往，想必一定是所向披靡。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那 : 有什么问题，就多研究一下这张示意图吧。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e寻找能量块\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e返回控制中心\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：果然和笔记中所说的一样…嗯？你们怎么这么快就回来了？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不过看你们的样子，应该已经找到了我们所需要的能量块了吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：这些能量核心我已经检查过了，保存得都相当完整。接下来只要把能量块装载到里面就可以了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：那么就拜托你们了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e装载能量块\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：只要将能量块装载到这些能量核心里面，整个控制系统应该都能启动了…\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：能量核心已经装填完毕，这样整个控制系统应该都能启动了…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：嗯？和预期中的反应不一样啊，是哪里出了什么问题吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：看上去得去中继装置所在的控制室看看了，反正要前往试验场也得经过那里。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哦哦，正好控制室的位置就在你们刚刚过来的方向，我们一起过去吧！\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往中继装置所在的控制室调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：果然是这些中继装置的问题，自能量核心所输出的动力无法传输到它们上，得想办法把它们都连通起来才行。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：而且这些中继装置还都被结晶所封印了，但这些遗迹明明并未使用污秽的能量，应该不会引起灵光的注意才对…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：唯一的解释便是，这里是被能够操纵灵光之力的人所刻意封禁的。但这又是为了隐藏什么呢…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：哈，这些事情以后再论。现在的当务之急还是得用灵光的力量消除掉这些封印装置的「灰余晶」。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：嗯…附近应该会有蕴含着灵光力量的「灵芯」，尊使大人应该也能感觉到吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：唔…哼，这是当然，你是在质疑身为花灵勇者的吾之伟力吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：岂敢，那么就拜托尊使大人为我们引路了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：只要找到「灵芯」消除了「灰余晶」，然后再操作混变器将这些中继装置连通就好了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e连通能源线路\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往左侧房间调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e连通能源线路\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往试验场调查\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：尊使大人，还有尊使的谒颂主，恐怕我只能陪你们到这里了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：又怎么了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：按照文献中的记载，接下来的路途充满凶险，并非本人的凡人之躯所能承受。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：从这里进去便是古时荼诃人用来试验机关性能的试验场，其中还有一架未完成的实验型的巨型机关。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：根据笔记中所抄录的荼诃人的记录，虽然没有发挥什么作用，但这里曾被改造为狙击魔物的防御工事。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：很奇怪不是吗，明明是引发了污秽灾厄的荼诃人，却建造了对抗魔物的机关。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不过既然我们现在已经启动了整座遗迹的控制系统，想必这个试验场里面的防御机关也被启动了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：而我们要找的灵光绝唱，应该就藏在里面的巨像当中。虽然使我望而却步，但对于诸位来说，必定是小菜一碟。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：为了能够集齐全部的灵光绝唱，请允许我暂且在此等候诸位。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：毕竟你也不过是区区人类，这样的请求也算是合情合理。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：蒙您恩许。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：虽然那先朱那又临阵脱逃了，不过反正你们两个不凑在一块我也感觉轻松很多啦…\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e进入试验场\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e调查奇怪的装置\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与斯露莎对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：地上出现了一台奇怪的大炮，意思是说要让我们射击那边的大机器人吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：唔…还真是贴心的设计呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：白飘飘的想象力还真是够丰富的，刚才「纳苏勒阿」不是说过，这里是由试验机关性能的试验场改造而来。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：想必我们刚才解开的装置，便是用来启动这个试验场的吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：虽然经过了改造，但原本的机关也并未来得及拆卸，可以说是帮了我们大忙呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：那么，我的谒颂主，操作这台大炮的任务可就交给你了。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e启动遗迹重炮\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e击退敌人\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e使用遗迹重炮摧毁巨像的核心\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e调查展开的装置\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e取得灵光绝唱\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e离开试验场\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与那先朱那对话\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：不愧是尊使大人和谒颂主，不管是荼诃的机关还是迪弗的魔物都无法阻止你们前进的步伐。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：欸？那先朱那你是什么时候进到这里来的？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：我可是一直在外面欣赏你们战斗的英姿呢！看到你们已经取得了灵光绝唱，我就赶紧跟上来了啊。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：真是辛苦你们了，那么不如就先把灵光绝唱交由我来保管吧，这样的话，怎么说呢，会让我比较有参与感？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：不过那先朱那根本就没怎么出力吧，而且祖尔宛也说不能把灵光绝唱随便交给别人。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：话可不能这样说。况且我对灵光绝唱可是很有研究的，先让我研究一下对于后面的事情也会很有帮助吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e那先朱那：比如这些灵光绝唱究竟为什么会被藏在这些遗迹之下…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e斯露莎：现在不是讲故事的时候，纳苏勒阿。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：感觉有些熟悉。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1714961311","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"val