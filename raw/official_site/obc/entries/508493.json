\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0p3mmreloauT1778419110926\":[\"jpzhi6nwtsT1777219699103\"],\"4cf2vhylew3T1710863944349\":[\"jpzhi6nwtsT1777219699103\"],\"5vq2h0vxsurT1777219308656\":[\"jpzhi6nwtsT1777219699103\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"r5pimpsheckT1777219536617\",\"0p3mmreloauT1778419110926\",\"sujhcqqr7vnT1777219537702\"],\"jpzhi6nwtsT1777219699103\":[],\"mwfbxa7ogqT1777219309064\":[\"jpzhi6nwtsT1777219699103\"],\"nqb471m7nmnT1710863941173\":[\"5vq2h0vxsurT1777219308656\",\"mwfbxa7ogqT1777219309064\"],\"r5pimpsheckT1777219536617\":[\"jpzhi6nwtsT1777219699103\"],\"sujhcqqr7vnT1777219537702\":[\"jpzhi6nwtsT1777219699103\"],\"z2tn3pzsbujT1710863943430\":[\"jpzhi6nwtsT1777219699103\"]},\"contents\":{\"0p3mmreloauT1778419110926\":{\"option\":\"【关于前面这个大家伙…】——供奉已满级\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，这东西叫「摹忆中枢」，该怎么解释呢…简单来说，就是汇聚着无人知晓的「文明」信息的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无人铭记的文明会失去原本的意义，失去意义之物便也会失去原本的形体。最后，只剩下被称作「摹忆因子」的残火，等待再也不会到来的新轮回。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎呀，要是有足够的种火，说不定还能用这个复现出一些别的东西…怎么样，要试试看吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【说说你的时代吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我比伊斯托利亚稍微晚一个时代。我出生的时候从来没有听过撕开天幕的龙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们的智慧不如伊斯托利亚那个时代，因为天使们不再吐露真正的隐秘了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在知道我们的思考、创造和挣扎都无意义之后，我唯一欣慰的事情就是——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e伊斯托利亚那个时代并不是吃黄金喝宝石。他们的享受和我们也差不多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一个绝望的思考者变成一个攀比的享乐者。哈，多么心碎的故事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种意义上，伊斯托利亚真的很坚强。求知和记录是如此没有意义的行为。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他还在用他的大脑记忆。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5vq2h0vxsurT1777219308656\":{\"option\":\"供奉未满级触发\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀…可惜，现在中枢里的种火不太够。要是能收集到足够的种火，说不定就能构筑出各种各样的东西来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e还是这里让人安心啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jpzhi6nwtsT1777219699103\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"mwfbxa7ogqT1777219309064\":{\"option\":\"供奉满级触发——打开商店界面\",\"dialogue\":\"\u003cp\u003e好，让我来试试看…\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【进行「种火再构」。】\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/27/80663279/a0688e82c2c53cce368e3c470e9e64ac_3243103797325038771.png\"},\"r5pimpsheckT1777219536617\":{\"option\":\"【关于前面这个大家伙…】——供奉未满级\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，这东西叫「摹忆中枢」，该怎么解释呢…简单来说，就是汇聚着无人知晓的「文明」信息的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无人铭记的文明会失去原本的意义，失去意义之物便也会失去原本的形体。最后，只剩下被称作「摹忆因子」的残火，等待再也不会到来的新轮回。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎呀，要是有足够的种火，说不定还能用这个复现出一些别的东西…可惜，现在中枢里的种火好像不是太够啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"sujhcqqr7vnT1777219537702\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(59, 66, 85)\\\"\u003e再见，旅行者。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【为什么叫你「反自杀大师」？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我提出了一个数学问题。就是一群士兵为了荣耀拒绝投降，所以他们决定用一定规则来…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来确定谁去为谁结束屈辱。那么如何在特定规则下，成为最后活着的人呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大概就是这么个纯粹数学问题。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1778468269","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694"