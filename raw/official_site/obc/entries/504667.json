se,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e4.2：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7600\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/11/23/4521515/cb99f47a315f71371613c02ca59c6c1b_7079126563740202684.png\\\" data-entry-name=\\\"特尔克西的奇幻历险\\\" data-entry-link=\\\"/ys/obc/content/7600/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/7600/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特尔克西的奇幻历险\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7610\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/11/25/83684823/73b96a4c041a2c3aef06cf0677f1f355_7935965896331264919.jpg\\\" data-entry-name=\\\"水妖的猜想\\\" data-entry-link=\\\"/ys/obc/content/7610/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/7610/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e水妖的猜想\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7615\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/11/25/83684823/73b96a4c041a2c3aef06cf0677f1f355_7935965896331264919.jpg\\\" data-entry-name=\\\"奇迹的冠冕\\\" data-entry-link=\\\"/ys/obc/content/7615/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/7615/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e奇迹的冠冕\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊！「鱼斗胜利之神」，你又出现了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这段时间我一直在踏踏实实地改进鱼饵，感觉自己进步很大，还钓到了不少…尺寸比较「可观」的鱼！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，我暂时还没能做出理想的鱼饵，没什么礼物送给你…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e请你别担心，按我现在进步的速度，我迟早会做出之前那种奇妙鱼饵的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近的钓鱼收获如何？】——当旅行者在隐藏任务中选择【还是耐心地讲道理吧。】、完成隐藏任务后\"},\"8b77hm64e7hT1741104969776\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，没错！这是我托冒险家协会的朋友买到的武器，听说是别国的型号…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然没有铳枪之类的武器用起来那么优雅，但简单、便宜，维护起来也方便。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e奇怪的水产品，就祈祷不要被我钓上来吧！不然，就等着接受特别的招待啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你还真的带了武器来啊！】——当旅行者在隐藏任务中选择【吓唬她！吓唬她！】、完成隐藏任务后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e耐心…耐心…这是对我耐心的磨练…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e身为钓鱼协会的理事，必须坚守在鱼点旁，用坚强的意志打败鱼斗士！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"becvio5gchmT1741104980668\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咦？咦咦？你刚才是找我有事吗？对不起，我刚刚没注意到，下次一定不会冷落你的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不打扰了！】\"},\"fucidf2x75T1741104971410\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是枫丹钓鱼协会的现任理事，德拉萝诗！如果有什么钓鱼相关的问题，你都可以来咨询我！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，我指的是钓鱼的装备和资料…至于钓鱼的技巧和窍门，我就不胡乱指导别人了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是?】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，当然没问题！请随意挑选！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/03/05/288180982/1b764ab0418774d3f6ebf1bf4b1bd200_273717911118605282.png\",\"option\":\"【先不谈这个，我需要钓鱼用品。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，你好你好…多谢关心！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如你所见，我正在奋力和水下的鱼斗士搏斗，暂时还没什么战果。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要我一直保持耐心，隐忍下去，一定能赢的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【收获如何？】——完成隐藏任务前\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8b77hm64e7hT1741104969776\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"8b77hm64e7hT1741104969776\",\"fucidf2x75T1741104971410\",\"becvio5gchmT1741104980668\"],\"becvio5gchmT1741104980668\":[],\"fucidf2x75T1741104971410\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_mo