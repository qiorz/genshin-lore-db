{"retcode":0,"message":"OK","data":{"page":{"id":"1395","name":"乌尔班【武器铸造师】","desc":"乌尔班【武器铸造师】","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2020/12/23/21665168/8cb790cc0c4204319402a3e2c1ab597d_1514293183990733554.png","header_img_url":"","modules":[{"name":"乌尔班","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/12/23/21665168/cd7754df30f6d48d47376e882907b1d5_3933464746316415430.png\",\"attr\":[{\"key\":\"性别\",\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"]},{\"key\":\"位置\",\"value\":[\"\u003cp\u003e龙脊雪山山脚营地\u003c/p\u003e\"]},{\"key\":\"功能\",\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"]},{\"key\":\"职业\",\"value\":[\"\u003cp\u003e武器铸造师\u003c/p\u003e\"]}],\"extra_attr\":[{\"key\":\"编者注：\",\"value\":[\"\u003cp\u003e\u003cs\u003e对奥斯曼的虚弱深信不疑。。。\u003c/s\u003e一阵铜管乐响起\u003c/p\u003e\"]}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/12/23/21665168/90f9377509ab5bae345f18599f14ae18_3677918951518937273.png\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/13/76297419/9f3098ab421bdee9534ffc52af7486d2_1965996284994845979.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"冒险挑战：乌尔班","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"乌尔班\",\"created_at\":\"2025.05.06\",\"list\":[{\"status\":\"Online\",\"energy\":0,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/12109492/9f134f05bb71f0ee1afb33785cf945e9_8328484566733664558.png\",\"life_bg\":0,\"link\":\"/ys/obc/content/5526/detail?bbs_presentation_style=no_header\",\"ep_id\":5526,\"updated\":true,\"life\":0,\"energy_bg\":0},{\"status\":\"Online\",\"energy\":0,\"img\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/05/12109492/3fc3ca86fcfc5333343aed2bb93f972c_4056005914865201079.png\",\"life_bg\":0,\"link\":\"/ys/obc/content/5527/detail?bbs_presentation_style=no_header\",\"ep_id\":5527,\"updated\":true,\"life\":0,\"energy_bg\":0},{\"status\":\"Online\",\"energy\":0,\"img\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/16/183046623/549d1869ad1f7d1d27fb5c733a239373_7619632532605164276.png\",\"life_bg\":0,\"link\":\"/ys/obc/content/6565/detail?bbs_presentation_style=no_header\",\"ep_id\":6565,\"updated\":true,\"life\":0,\"energy_bg\":0}]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"挑战目标or特殊规则","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e关卡介绍：\u003c/p\u003e\u003cp\u003e传说，有些铁匠会将得意之作委托给各种战士，让他们测试武器的极限，因此，一些经验丰富的铁匠也能在不经意间了解到陌生势力的战斗特点，甚至将它们带上对局的牌桌…\u003c/p\u003e\u003cp\u003e特殊规则：\u003c/p\u003e\u003cp\u003e我方支援区初始存在一张「迪娜泽黛」\u003c/p\u003e\u003cp\u003e挑战目标：\u003c/p\u003e\u003cp\u003e赢得胜利——120【棋手经验】；\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5353\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\" data-entry-name=\\\"幸运牌币\\\" data-entry-amount=\\\"100\\\" data-entry-link=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e幸运牌币\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*100\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e6回合内胜利——\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5353\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\" data-entry-name=\\\"幸运牌币\\\" data-entry-amount=\\\"200\\\" data-entry-link=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e幸运牌币\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*200\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e  \u003c/p\u003e\u003cp\u003e胜利时，角色被击倒次数小于2——\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5353\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\" data-entry-name=\\\"幸运牌币\\\" data-entry-amount=\\\"200\\\" data-entry-link=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5353/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/11/13/187743934/3d6b5728fd92c0d7e3de6d1c6465ce88_1172456293365408529.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e幸运牌币\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*200\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e  \u003c/p\u003e\u003cp\u003e【提示】「迪娜泽黛」在场时，可以降低打出「伙伴」牌的费用！\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e世界任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1400\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/09/80663279/41a53cbf3d3742b30dd4261689b9e6fc_3708589282696565956.png\\\" data-entry-name=\\\"腐殖之牙\\\" data-entry-link=\\\"/ys/obc/content/1400/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1400/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e腐殖之牙\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没事就算了，别浪费我的时间。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没什么事。】\"},\"5ray47ll5dkT1750217297584\":{\"dialogue\":\"\u003cp\u003e【乌尔班】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你回来了，那些「牙齿」…哦，你已经找齐了啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你们去冒险的时候，我这边遇到了点问题，无论我用什么方法，都没办法从这枚「牙齿」上敲下来一点碎屑。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还从没遇到过这样的奇事，于是就托人去问了阿贝多先生，该怎么处理这样的材料。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e于是——喏，你看，阿贝多先生托砂糖小姐送来了一块符石，就摆在那边的炼金合成台上了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e欸，符石？这和我们找到的「龙牙」有什么关系吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这个嘛，按照砂糖小姐转述阿贝多先生的说法，要想用这种材料来锻造武器，必须先进行一些特殊处理。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其中一种处理方法，就是让一枚龙牙汲取到某种和龙有关的「生命力」, 再用它来处理其他龙牙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这枚符石——我想想砂糖小姐是怎么说的——哦对，据说是「一千年前帮助蒙德反抗旧贵族的某支流浪乐团留给骑士团的遗物」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那支乐团的笛手，曾在烬寂海与当地人称作「巴窟纳瓦」的可怖魔兽交战，从它身上斩下了这块符石…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咦？等一下喔，如果我没记错的话，茜特菈莉好像说过，烬寂海是在五百年前，因为桑哈杰的战斗，才成为烬寂海的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于「龙牙」…】——完成魔神任务「悖理」\u0026世界任务「腐殖之牙」后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什么事？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8skcau97v06T1750217117049\":{\"dialogue\":\"\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/06/18/178964736/cc2a44c2e85425afbbd461e49fe0875d_2748305179332271859.png\",\"option\":\"【决斗对局】——打开对局界面\"},\"c8o54og49hrT1750217725472\":{\"dialogue\":\"\u003cp\u003e【乌尔班】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，这怎么可能有错呢？那支流浪的乐团可是活跃在旧贵族时代的英雄，《列王与宗窒史》中就有记载。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，阿贝多先生说，这块符石中就蕴藏着与龙的力量相近的「无限的生命力」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要借助炼金合成台，用龙牙汲取符石中的生命力，就能用它来锻造武器了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e听、听起来好像很厉害…该说不愧是阿贝多吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那只乐团真的是一千年前的人吗？】\"},\"csjmppthtxT1750217983239\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的名字并不重要，重要的是我的作品。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你听说过冷刃吗？是那位曾经名满大陆的冒险家赫尔曼的佩剑，正是出自我手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e⋯虽然不少人对它评价很高，不过那只是我铸造过的诸多武器中平平无奇的一件。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对我来说，最重要的是下一柄武器⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只有那柄武器，才有资格和我的名字一起被世人铭记。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"r9vm6h620mmT1750217789816\":{\"dialogue\":\"\u003cp\u003e【乌尔班】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，炼金术的力量还真神奇啊，居然能从千年前的石头里提取出「生命力」…究竟是怎么做到的呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【之后要谢谢阿贝多才行。】\"},\"wds09ujnxeaT1746520710879\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我曾尝试过用各种材料铸造武器，但打造出来的无一例外都是平平无奇的兵器。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这让我明白了，普通的矿石与材料是有极限的⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这柄枪你拿走吧。这是我以前铸造的「试验品」，对普通人来说已经是不错的兵器了。\u003c/p\u003e\u003cp\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"134\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/13/80663279/3c6c8af62d002531eeb266740fa7ef48_1688185508617567883.png\\\" data-entry-name=\\\"黑缨枪\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/134/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/134/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/13/80663279/3c6c8af62d002531eeb266740fa7ef48_1688185508617567883.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e黑缨枪\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/06/18/178964736/b26706122e54335e75a99308e473cc62_6702588167170474661.png\",\"option\":\"【材料？】——获得黑缨枪*1\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是为了一柄武器，一柄注定会被所有人牢记在心的武器⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平庸的兵器造再多也毫无意义。埋头打铁的是铁匠，不是武器铸造师。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真正的铸造师，只要有一柄能举世闻名的武器就足够了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我会用我毕生的精力和汗水去磨砺那柄武器⋯完成之时，全提瓦特的人都将会铭记「它」和我的名字。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e⋯为此，我来到了这里，在这座山上有我一直在寻找到的「材料」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你为什么在这里？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"csjmppthtxT1750217983239\"],\"5ray47ll5dkT1750217297584\":[\"c8o54og49hrT1750217725472\"],\"8gfxrw8wla9T1710863939170\":[\"8skcau97v06T1750217117049\",\"5ray47ll5dkT1750217297584\",\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"8skcau97v06T1750217117049\":[\"csjmppthtxT1750217983239\"],\"c8o54og49hrT1750217725472\":[\"r9vm6h620mmT1750217789816\"],\"csjmppthtxT1750217983239\":[],\"nqb471m7nmnT1710863941173\":[\"csjmppthtxT1750217983239\"],\"r9vm6h620mmT1750217789816\":[\"csjmppthtxT1750217983239\"],\"wds09ujnxeaT1746520710879\":[\"csjmppthtxT1750217983239\"],\"z2tn3pzsbujT1710863943430\":[\"wds09ujnxeaT1746520710879\"]}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":fals