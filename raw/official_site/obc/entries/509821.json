r\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成启喻鸟之章 第一幕「飞向归羽声」后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【季诺维娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…小心些，不要到处乱跑，叶什娜。你的病才刚刚稳定下来，最好还是不要受寒…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶什娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好的好的，我知道啦！等刻莱诺姐姐过几天带我回去，见过那边\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;谶鸟\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e的爸爸妈妈，我的身体应该就能更好一些了吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【季诺维娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…但那也只是暂时缓解。在找到根治的办法前，我们还是只能留在这里…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶什娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔，也就是说，我们还要在至冬堡待上很长、很长的时间，才能见到莉奈娅姐姐吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【季诺维娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是啊…只能这样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶什娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咦，为什么妈妈要这么担心…？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e刻莱诺姐姐不是说过吗？莉奈娅姐姐现在已经是非常厉害、非常优秀、非常可靠的大冒险家啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【季诺维娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…是啊…是啊。她是那样好，而我们…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶什娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【季诺维娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不…没什么。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶什娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以，等我的病好了，我们就带上极星区最甜最好吃的糖果，去见莉奈娅姐姐！这样，我们一家人就能团聚啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/body\u003e\u003c/html\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1789352465","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"12