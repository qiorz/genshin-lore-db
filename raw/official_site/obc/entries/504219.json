":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0l9f5lpiqd2hT1737042290114\":[\"ms31k9rzrlcT1737042366937\"],\"5oxerhkqv64T1737042095270\":[\"kddavw11x4eT1737042248642\"],\"7qwrm0mhcpsT1737042276976\":[\"0l9f5lpiqd2hT1737042290114\",\"k1qf9vzuofT1737042290983\",\"zbil9bbb17T1737042291921\",\"wb4qsra2ewT1737042324669\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"9pyzjnmiwhnT1737042118384\":[\"kddavw11x4eT1737042248642\"],\"k1qf9vzuofT1737042290983\":[\"ms31k9rzrlcT1737042366937\"],\"kddavw11x4eT1737042248642\":[\"7qwrm0mhcpsT1737042276976\"],\"ms31k9rzrlcT1737042366937\":[],\"nqb471m7nmnT1710863941173\":[\"ovwwv7umf6qT1737042094459\",\"5oxerhkqv64T1737042095270\"],\"ovwwv7umf6qT1737042094459\":[\"9pyzjnmiwhnT1737042118384\",\"z21r0hgd5bT1737042119468\"],\"wb4qsra2ewT1737042324669\":[\"ms31k9rzrlcT1737042366937\"],\"z21r0hgd5bT1737042119468\":[\"kddavw11x4eT1737042248642\"],\"zbil9bbb17T1737042291921\":[\"ms31k9rzrlcT1737042366937\"]},\"contents\":{\"0l9f5lpiqd2hT1737042290114\":{\"dialogue\":\"\u003cp\u003e原来是来帮忙的朋友啊，辛苦你了。\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/16/288180982/60e98896f16b1e2f98bb1952b677ae4f_1215172071067319220.png\",\"option\":\"【关于我在「流泉之众」的声望…】——打开声望界面\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"5oxerhkqv64T1737042095270\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没事，那以后再说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【谢谢，但还不需要。】\"},\"7qwrm0mhcpsT1737042276976\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可恶，答应和那小子换夜班简直是上了贼船…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"9pyzjnmiwhnT1737042118384\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e就是一帮喜欢在纳塔四处探索的流泉之众成员啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e细究起来，其实和冒险家们做的事情差不多，但他们更喜欢自称「旅行家」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你也知道，纳塔有很多高温地区，我们部族的人借助鳍游龙可以比较自由地在那些地方探索。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以会有很多其他部族的人或者外国游客，为了行动方便，请「旅行家」领航或者探路。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【旅行家是？】\"},\"k1qf9vzuofT1737042290983\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这是「曜石图腾柱」。你可能已经在别的部族见过类似的圣物了，这个呢，就是「流泉之众」的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在你完成了部族的委托任务后，曜石图腾柱将给你相应的回馈。我先代表「流泉之众」感谢你的帮忙啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至于其他的东西，还是去问白天值班的卡拉穆鲁吧！那小子才是第一负责人，可不能让他什么都不干！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，这里是…】——开启纳塔声望后\"},\"kddavw11x4eT1737042248642\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ms31k9rzrlcT1737042366937\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好你好，想找什么？人，还是失物？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"ovwwv7umf6qT1737042094459\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，原来不是委托人啊，失礼失礼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为我认识的人多，所以久而久之，大家在需要找人或者找东西的时候都习惯先来找我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你以后需要雇旅行家，也可以来联系我，我白天基本都在这附近。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不用担心费用，顺手帮忙的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【嗯？】\"},\"wb4qsra2ewT1737042324669\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦没关系，是我自己的事情，请不用在意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【打扰了。】\"},\"z21r0hgd5bT1737042119468\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e平常也不算少，但战后的寻人委托明显变多了，你知道的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也不全是坏消息吧，能帮大家找到失散的亲朋好友，看到他们重聚时的兴奋，我也挺开心的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其他的就…先不提了吧。有些人只是暂时没有消息，没准哪天就回家了呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【找你帮忙的人多吗？】——完成魔神任务第五章 第四幕「命定将焚的虹光」后\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"zbil9bbb17T1737042291921\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…换了也没什么区别，不是白天上班就是晚上上班。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里是很重要的地方，总得有个人看着才行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然很想给卡拉穆鲁一个头槌，但我是比他更有责任心的人啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不能换回来吗？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"「话事处」的赠礼","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e达成数量\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"703\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e奖励内容\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e功能开启\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e1\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"703\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502281\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/28/4905523/959487a92210f0db2feca0626ca3f867_5478906252681195153.png\\\" data-entry-name=\\\"纳塔·神军\\\" data-entry-link=\\\"/ys/obc/content/502281/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502281/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" sr