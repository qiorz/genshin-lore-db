ot;\u0026gt;元素战技\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;造成2点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(245, 34, 45)\u0026quot;\u0026gt;火元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，生成\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;烈烧佑命护盾\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;和\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;炽火大铠\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e装备有此牌的托马生成的\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e炽火大铠\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;炽火大铠：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;出战状态\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;我方角色普通攻击后：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;造成1点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(245, 34, 45)\u0026quot;\u0026gt;火元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，生成\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;烈烧佑命护盾\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;可用次数\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;：2\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，初始\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e可用次数\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;可用次数：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;此牌效果触发后，会消耗1次\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;可用次数\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;；\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;可用次数\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e