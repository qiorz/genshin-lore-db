false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务开始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/02/1694811/0a73696f762c9a3a34606c069cef5b84_1726076565071513151.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e〓路线攻略〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e具体路线攻略推荐：\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/24454894\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e【V2.7攻略】#其他攻略#久岐忍邀约第一幕分支及成就攻略\u003c/a\u003e  作者：\u003cstrong\u003e\u003cspan style=\\\"background-color:rgb(255, 255, 255)\\\"\u003eFTFuture\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd1 期待之外的工资\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/02/1694811/71837d7385cf8a0e6f0101501aa8368c_1393879526384938238.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e接下来的发展...是会幸运还是不幸呢？\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd2 「接下来是商业密谈...」\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/02/1694811/95a6477dd639e41fa05411f61d8155a4_8821267187398114947.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e为了荒泷派的未来，还是再当一阵子「首席顾问」吧。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd3 法度执行！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/02/1694811/4b249e7a832bda3854cf58d02d4e8b39_825566272548378879.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e花坂道路千万条，遵纪守法第一条。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd4 是祸躲不过\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/02/1694811/fcd6069000386723ec6427a28dbebbf1_8548905484137253109.png\\\" href=\\\"\\\" sty