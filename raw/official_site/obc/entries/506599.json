ayout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"ewllh0qqr0dT1711546416025\",\"child_ids\":{\"ewllh0qqr0dT1711546416025\":[]},\"contents\":{\"ewllh0qqr0dT1711546416025\":{\"option\":\"\",\"dialogue\":\"\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与茜涅特对话\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：你好啊，茜涅特，上次找回来的机器人也都调试好了吧？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：嗯，多亏了你们。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：说起来，我们确实有些新的发现呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：真的？请讲给我听！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e你和派蒙向茜涅特讲述了不久前的见闻。\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：你们描述的那种表现…这些机器人似乎很喜欢你们，并向你们发出了「一起玩耍」的邀请。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：真的？好有趣！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：嗯…果然是这样！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：茜涅特，又发现什么了吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：我现在能确定了，我的创意要通过机器人之间的交互来实现，找回的机器人越多，就越接近最初的设想。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：现在它们已经拥有了和他人交流的能力，只要把剩下的机器人也找齐…我的创意还是行得通的！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：哇，兴奋起来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e茜涅特：啊，不好意思，说起来还是要仰仗你们，下一片区域也在地图上标好了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：那我们尽快出发吧，我开始好奇这些机器人最终会变成什么样子了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758621039","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"传说任务\\\",\\\"children\\\":[]},{\\\"label\\\":\