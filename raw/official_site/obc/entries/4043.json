{"retcode":0,"message":"OK","data":{"page":{"id":"4043","name":"五百藏","desc":"五百藏","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2022/05/06/192134014/bdefd8c0321cf90bb5b30e59ef93b34c_595044106423354254.jpg","header_img_url":"","modules":[{"name":"五百藏","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e被封印的可怜家伙…\u003c/p\u003e\"],\"key\":\"编者注：\"}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/05/06/192134014/249c2c47e41720d0b7c5764a1b616b28_8479952758456962096.jpg\",\"attr\":[{\"value\":[\"\u003cp\u003e妖怪\u003c/p\u003e\"],\"key\":\"物种\"},{\"value\":[\"\u003cp\u003e镇守之森\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"功能\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"职业\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/05/06/192134014/081a05f133d5dba18d7892259c0c4022_3546445035624433316.jpg\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/05/06/192134014/893743007d79b4ee03c8a413656fea55_7922599433437967314.jpg\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e世界任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2393\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/09/80663279/53c1c5109edb51f54a7873cdcf371420_6089672231797586817.png\\\" data-entry-name=\\\"神樱大祓\\\" data-entry-link=\\\"/ys/obc/content/2393/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/2393/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e神樱大祓\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e角色逸闻：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506318\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/24077343/5b8e5120f1d0c34bdb8100f51ed88e59_920572431099768653.png\\\" data-entry-name=\\\"绮良良・我的快递！\\\" data-entry-link=\\\"/ys/obc/content/506318/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506318/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e绮良良・我的快递！\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e2.4：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3535\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/02/05/4521515/d3eb5ea012835ac351a4ac3c7e6ecbd4_1595801290622807224.jpg\\\" data-entry-name=\\\"山海八所巡礼\\\" data-entry-link=\\\"/ys/obc/content/3535/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/3535/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e山海八所巡礼\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（山海八所巡礼、山海八所巡礼・大雪隐御伽话、山海八所巡礼・远岛孤山独语、山海八所巡礼・风来坊内鉴录）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e5.4：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504528\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/14/4521515/82258d6f4f735d86facf37cbe2e4c5fc_8232162997839619540.png\\\" data-entry-name=\\\"三川游艺绮梦谭\\\" data-entry-link=\\\"/ys/obc/content/504528/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504528/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e三川游艺绮梦谭\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504613\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/22/83684823/0eaff44fd4031264c2b8a3b06ba243a9_5548769343016561354.png\\\" data-entry-name=\\\"三川游艺绮梦谭·始夜「如入幻梦」\\\" data-entry-link=\\\"/ys/obc/content/504613/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504613/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e三川游艺绮梦谭·始夜「如入幻梦」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"504623\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/22/83684823/0eaff44fd4031264c2b8a3b06ba243a9_3287789001898418085.png\\\" data-entry-name=\\\"三川游艺绮梦谭·继夜「如见泡影」\\\" data-entry-link=\\\"/ys/obc/content/504623/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504623/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e三川游艺绮梦谭·继夜「如见泡影」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"400f7puwv1oT1781750898763\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"ckrum324efgT1781750828947\":[],\"e5k0m72p0ssT1781750897490\":[],\"nqb471m7nmnT1710863941173\":[\"ckrum324efgT1781750828947\",\"tm2xfbqu7rnT1781750829818\"],\"tm2xfbqu7rnT1781750829818\":[],\"wt8iu8a2dzdT1781750919449\":[],\"z2tn3pzsbujT1710863943430\":[\"e5k0m72p0ssT1781750897490\",\"400f7puwv1oT1781750898763\",\"wt8iu8a2dzdT1781750919449\"]},\"contents\":{\"400f7puwv1oT1781750898763\":{\"option\":\"【关于「胜负」…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呶，很过分吧？那时候臭狐狸居然敢用捉迷藏挑战吾辈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说什么「绝对不要现身」，「如果发生了什么事，那就是我在用法术挑拨你」之类的，口气很奇怪得很呶。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但吾辈可是妖狸，又是将军大人亲自封的「保生司正」，在镇守之森用捉迷藏挑战吾辈，那自然接受。得好好教训教训那家伙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e吾辈找了个好地方，变成了一只鬼兜虫，想看那家伙在林子里着急地到处乱找的丑态！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果，那臭狐狸一直没来。这个胜负，到现在还没有分出来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e吾辈会一直等下去，等那个臭狐狸回来，然后，对吾辈道歉。呶，那家伙要道歉的东西太多了，吾辈天天都在算这笔账呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见五百藏。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见了，小辈。如果是那家伙的话，这时候就会念个难懂的诗吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时间要来找吾辈玩。毕竟，吾辈现在可是石头，时间可是多得很呶。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e吾辈以前可是名震天下的妖狸五百藏。总有一天吾辈要用八叠大的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e咳咳。是你啊，小辈。看你与吾等缘分不浅，有什么想问的就尽管问吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ckrum324efgT1781750828947\":{\"option\":\"【开始你还被丘丘人…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呶？你误会了。丘丘人对吾辈没什么害处。因为变成了石头，没办法到处找人玩，所以都是丘丘人陪着我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一开始吾辈看你是人，还以为你也是来害我的，所以就叫它们帮忙对付你了。你没事就好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然语言不通，头脑又笨，但变成石头的这些岁月里，它们多少也算是成了吾辈的伙伴吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说来也怪，以前稻妻是没多少丘丘人的。从哪天开始，就到处都是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"e5k0m72p0ssT1781750897490\":{\"option\":\"【你是怎么被封印的？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呶，吾辈怎么知道——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不对，应该就是因为偷了那把梳子吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谁知道这把梳子是用来做「神樱大福」的嘛！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个臭狐狸从挑战吾辈捉迷藏的那天开始，就再也没现身过了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了把那家伙引出来，吾辈想尽各种办法。因为那家伙过去喜欢跟吾辈斗法，所以吾辈就到处捣乱。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e把绀田村的董瓜变成土豆、把日落果变成老虎。以前，一般这时候，臭狐狸就会冲过来找吾辈麻烦了。但这次不一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后来，吾辈就觉得，「好生气！」干脆把那家伙眷属的雕像破坏掉。这时候吾辈就发现了里面的梳子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「只要把这个偷走，那个臭狐狸肯定会着急。那就会现身了吧。呶。」吾辈这么想，就把梳子偷走了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果，臭狐狸没有出现，却来了个人类小辈，我记得以前是和影向天狗学法术的三人组之一。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知怎么力量这么强，居然把吾辈和孩子们一并封印在石像里了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【关于镇守之森…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e别看现在成了石像，以前吾辈也是大御所大人封的官，是人称「隐神保生司正五百藏」的大人物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e吾辈的职责就是保护镇守之森。保护这里的水土、灵脉。你看，在吾辈的关照下，守护之森多好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"tm2xfbqu7rnT1781750829818\":{\"option\":\"【「保生司正」？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e吾辈一开始也是个自由自在的妖狸。虽然名气不大，但自由自在得很哪。经常和那个臭狐狸比赛斗法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有一天，那个臭狐狸跟我打赌，说吾辈不能偷到将军御苑里长的鸣草。吾辈当然接受挑战，结果害得我差点被将军一刀削了去，变得跟八酝岛似的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后还是那个臭狐狸帮我说情，将军才网开一面。不但放吾辈一条生路，还赐我「保生司正」之职。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种事情，吾辈怎么会忘记呢。吾辈可是欠了那个臭狐狸一条命呶…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"wt8iu8a2dzdT1781750919449\":{\"option\":\"【关于小狸妖…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呶，镇守之森原本是吾辈「隐神保生司正五百藏」与同族的土地，直到吾等被那个人类小姓变成石像。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你看到了狸子石像，那多半也是被封印的妖狸。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过这些时日，有些封印已经松动了。比如「吉法师」他们，已经恢复了原状，所以吾等还是有希望的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呶，小辈哟，答应吾辈一件事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果在外头看到了吾辈同族的小狸子，要对他们好一点。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他们都陪吾辈被封印了…不知道多久岁月，现在就想看看外面的世界。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【关于你自己…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e吾等妖狸族自古就在鸣神的土地上活跃。有什么问题吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1781756978","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","m