003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬前】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你好，是有鉴定古董的委托吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你是···】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我是开古董店的，也是奥摩斯港最可靠的古董鉴定专家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我的祖父是著名的历史学者，所以我家在鉴定各种宝物方面很有家学渊源。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你绝对可以相信我这双眼睛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e无论是树王大人的遗物，还是花神大人的饰品，甚至是赤王遗留在沙海中的古迹，我都能一眼鉴定真伪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【关于树王大人⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e唉⋯虽然树王大人早已离去，但她永远是须弥最伟大的神明。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e她守护须弥扛下了大大小小的灾祸，逝后也为我们留下了取之不竭的智慧与宝藏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e所以一般遇见与树王大人相关的古董，我都会尽我所能买下来收藏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【暂时没有。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e那等下次再来找我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬后】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你好，是有鉴定古董的委托吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【你是⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我是开古董店的，也是奥摩斯港最可靠的古董鉴定专家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e我的祖父是著名的历史学者，所以我家在鉴定各种宝物方面很有家学渊源。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你绝对可以相信我这双眼睛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e无论是花神大人的饰品，还是草神大人的神迹，甚至是赤王遗留在沙海中的古迹，我都能一眼鉴定真伪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【关于草神大人⋯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e唉⋯草神大人永远是须弥最伟大的神明，教令院此前的行为实在令人愤慨。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e她守护须弥扛下了大大小小的灾祸，为我们提供了取之不竭的智慧与宝藏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e所以一般遇见与草神大人相关的古董，我都会尽我所能买下来收藏。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【暂时没有。】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e那等下次再来找我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762237077","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layou