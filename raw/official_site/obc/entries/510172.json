,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/09/30/50494840/5ae4450113d77390197d2b19af6b2f37_623280869345301778.png\"}]}\n","style":""}],"id":"10870","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8178","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"cea8r4ovpiT1790762628221\":[]},\"contents\":{\"cea8r4ovpiT1790762628221\":{\"dialogue\":\"\u003cp\u003e沃雅妮莎：又有两只小狗来我这边避风雪了。\u003c/p\u003e\u003cp\u003e沃雅妮莎：我上去的时候，它们都要冻晕了，还好我发现的早。\u003c/p\u003e\u003cp\u003e阿罗夏：…还好，它们已经缓过来了，我等会就把它们带去我那边。\u003c/p\u003e\u003cp\u003e阿罗夏：但话说回来，你真的不需要几只小狗来看家护院吗？\u003c/p\u003e\u003cp\u003e沃雅妮莎：真不需要了，外面的暴雪，还有洞口那段深井已经是最好的防护措施了，一般的野兽和冒险家也下不来。\u003c/p\u003e\u003cp\u003e沃雅妮莎：要是遇见真能下来的…那我就钻进水里逃跑呗，反正他们也没办法顺着水追过来。\u003c/p\u003e\u003cp\u003e沃雅妮莎：就算追过来了，水里可是我的主场，他们不会有好果子吃的。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"cea8r4ovpiT1790762628221\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"10869","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"tmpju88h7dT1791005830671\",\"child_ids\":{\"tmpju88h7dT1791005830671\":[]},\"contents\":{\"tmpju88h7dT1791005830671\":{\"dialogue\":\"\u003cp\u003e沃雅妮莎：阿罗夏，你之前找到的冰川裂谷在哪？\u003c/p\u003e\u003cp\u003e沃雅妮莎：你之前说，底下好像还有一个巨大的冰湖来着？\u003c/p\u003e\u003cp\u003e阿罗夏：只是猜测，天气太恶劣了，我看了一眼就撤了。\u003c/p\u003e\u003cp\u003e沃雅妮莎：没事，在地图上帮我标出来吧。\u003c/p\u003e\u003cp\u003e沃雅妮莎：嘻嘻，说不定，我又可以找到一个清净的练歌房了。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}}}]}\n","style":""}],"id":"10881","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/10/07/50494840/ada6131f551590f5ed6e9ca610bf872b_3976284954738060876.png\"}]}\n","style":""}],"id":"10930","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8178","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"v07kgwgj7pT1791349794828\",\"child_ids\":{\"v07kgwgj7pT1791349794828\":[]},\"contents\":{\"v07kgwgj7pT1791349794828\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e阿罗夏：柳眀娜——\u003c/p\u003e\u003cp\u003e柳眀娜：汪！汪汪——\u003c/p\u003e\u003cp\u003e阿罗夏：好姑娘，来，吃吧，你肯定会喜欢的。\u003c/p\u003e\u003cp\u003e柳眀娜：汪！\u003c/p\u003e\u003cp\u003e阿罗夏：噢，对了，我已经和沃雅妮莎说过了，她保证暂时不会让你去参加…「合唱」了…\u003c/p\u003e\u003cp\u003e柳眀娜：…汪!\u003c/p\u003e\u003cp\u003e阿罗夏：不过，她前几天又问我，真正的「狗创式泳姿」是什么样的，唉…\u003c/p\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"10929","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,