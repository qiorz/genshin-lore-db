227958/3b6a8246374f44c97eaa89353ce2b45d_3635955840981141443.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"「绮衣珍赏·赫炽」参与获得自选奇偶装扮套装「奇珍缀趣」一套\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/3ada469f68167540074173f7c2aab3f9_4524165504859991343.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/3ada469f68167540074173f7c2aab3f9_4524165504859991343.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(47, 50, 56)\\\"\u003e亲爱的旅行者，「绮衣珍赏·赫炽」活动即将开启，参与获得自选奇偶装扮套装「奇珍缀趣」一套。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e〓活动时间〓\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e7.2版本更新后 ~ 2026/12/16 05:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e〓活动奖励〓\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e自选奇偶装扮套装「\u003c/span\u003e奇珍缀趣」一套、重现晶簇\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e〓参与条件〓\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e唤醒「千星奇域」奇偶后\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e〓活动说明〓\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e● 活动期间，旅行者可以通过完成珍赏任务获得对应的「珍赏见闻」与重现晶簇，每周通过珍赏任务可获得奖励的次数具有上限。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e● 活动期间，「珍赏见闻」总值累计到特定值之后，即可领取奇偶装扮套装「\u003c/span\u003e奇珍缀趣」。\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e● 在首次领取活动奖励奇偶装扮套装「\u003c/span\u003e奇珍缀趣」的部件前，旅行者可以自由切换套装奖励，首次领取后将无法修改选定的套装奖励。\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(65, 70, 75)\\\"\u003e※ 奇偶装扮套装「\u003c/span\u003e奇珍缀趣」将会在7.2版本结束后限时上架千星商城，更多售卖详情可在千星商城查看。\u003c/p\u003e\"]]},{\"tab_name\":\"「奇域秘藏·雪阵霜庭」奇偶装扮上架\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/c0bf9bda8427695e5f3921e13570fd7f_7670588275141883703.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/c0bf9bda8427695e5f3921e13570fd7f_7670588275141883703.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(47, 50, 56)\\\"\u003e亲爱的旅行者，\u003c/span\u003e「奇域秘藏·\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e雪阵霜庭\u003c/span\u003e」\u003cspan style=\\\"color: rgb(47, 50, 56)\\\"\u003e奇偶装扮即将上架~\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓活动颂愿-2介绍〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e颂愿时间：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e7.2版本更新后 ~ 2026/12/15 14:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 活动期间内，限定传说（5星）装扮「\u003c/span\u003e霜庭雪翎」以及卓越（4星）装扮「暖冬欢歌」、「荒远山裔」、「疗愈心意」将进入奇偶的装扮活动颂愿-2！\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 活动期间内，无论通过何种方式（包含但不限于颂愿、商城兑换、装扮赠送等）第2次获得相同性别的限定传说（5星）装扮「\u003c/span\u003e霜庭雪翎」时，将解锁该5星装扮的\u003cspan style=\\\"color: rgb(223, 64, 42)\\\"\u003e升炼效果\u003c/span\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e「\u003c/span\u003e霜庭雪翎·暗云诗篇」。\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e※ 本期活动颂愿-2与活动颂愿规则一致，更多活动颂愿信息可点击活动颂愿界面左下角【详情】按钮进行查询。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e※ 奇偶妆容及动作仅供搭配参考，最终请以实机表现为准。\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8979","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"「奇域秘藏·覆音谐度」奇偶装扮上新","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/c54594035f09a8c0df5918129fbf2831_4964565332083525429.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2026/11/02/75276539/c54594035f09a8c0df5918129fbf2831_4964565332083525429.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(47, 50, 56)\\\"\u003e亲爱的旅行者，「奇域秘藏·覆音谐度」奇偶装扮即将上新~\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e活动期间，旅行者可以通过「\u003c/span\u003e覆音谐度」活动颂愿/「覆音纪游」/千星商城获得心仪的奇偶装扮！\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e穿戴新套装或试行斗篷游玩人气奇域关卡，还可以获得60原石奖励！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓活动颂愿介绍〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e颂愿时间：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e7.2版本更新后 ~ 2026/12/15 14:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e● 活动期间内，\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e限定传说（5星）装扮「\u003c/span\u003e殊律覆音」以及卓越（4星）装扮「藏梦绒偶」、「浮想茶歇」、「嘉卉研序」将进入奇偶的装扮活动颂愿！\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 活动期间内，无论通过何种方式（包含但不限于颂愿、商城兑换、装扮赠送等）第2次获得相同性别的限定传说（5星）装扮「\u003c/span\u003e殊律覆音」时，将解锁该5星装扮的\u003cspan style=\\\"color: rgb(223, 64, 42)\\\"\u003e升炼效果\u003c/span\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e「\u003c/span\u003e殊律覆音·遐苍」。\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e※ 本期活动颂愿与往期规则一致，更多活动颂愿信息可点击活动颂愿界面左下角【详情】按钮进行查询。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e※ 奇偶妆容及动作仅供搭配参考，最终请以实机表现为准。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓千星商城〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e装扮上架时间：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e自7.2版本更新后连续上架三个版本\u003c/span\u003e\u003c/p\u003e\u003cp\u003e限时折扣时间：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e自7.2版本更新后 ~ 2026/12/14 03:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e● \u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e7.2\u003c/span\u003e版本更新后，共计\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e6\u003c/span\u003e套卓越（4星）装扮、\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e4\u003c/span\u003e套优异（3星）装扮\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e限时\u003c/span\u003e上架千星商城，在上架期间均限购1次。\u003c/p\u003e\u003cp\u003e● \u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e7.2\u003c/span\u003e版本上新套装，当期的卓越（4星）装扮套装折扣期间售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e960事象凝核\u003c/span\u003e，限时折扣结束后价格将恢复至\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e1200事象凝核\u003c/span\u003e；当期的优异（3星）装扮「假面礼宴」套装折扣期间售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e160事象凝核\u003c/span\u003e，限时折扣结束后价格将恢复至\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e200事象凝核\u003c/span\u003e，「鱼鱼逃逃」套装折扣期间售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e240事象凝核\u003c/span\u003e，限时折扣结束后价格将恢复至\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e300事象凝核\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e● 当期的上新套装可以通过装扮组合的形式同时购买同一主题的男性装扮与女性装扮。当期的卓越（4星）装扮组合售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e1440事象凝核\u003c/span\u003e；当期的优异（3星）装扮「假面礼宴」套装组合售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e240事象凝核\u003c/span\u003e，「鱼鱼逃逃」套装组合售价为\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e360事象凝核\u003c/span\u003e，装扮组合仅在套装限时折扣期间上架，更多的装扮组合售卖详情可在千星商城查看。\u003c/p\u003e\u003cp\u003e● \u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e7.2\u003c/span\u003e版本更新后，更多的面部妆容售卖详情可在千星商城查看。\u003c/p\u003e\u003cp\u003e● 奇偶装扮购买之后可在派蒙菜单-装扮搭配界面查看。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓覆音纪游〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e● 活动时间：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e7.2版本更新后 ~ 2026/12/14 03:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 活动期间，旅行者可以在纪游中获得丰厚的奖励，解锁「诸界纪游」或「诸界史诗」更可获得\u003c/span\u003e\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e限定（4星）装扮「谐度邃理」\u003c/span\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e！直接购买诸界史诗更可获得纪游专属大厅\u003c/span\u003e\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e「夜咏剧庭·悠扬韵调」\u003c/span\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(223, 64, 42)\\\"\u003e※已解锁诸界纪游的旅行者，如有需要，可补充额外差价购买「纪游再编」以解锁诸界史诗。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(223, 64, 42)\\\"\u003e※2026/12/14 02:59将关闭本次纪游中诸界纪游、诸界史诗和纪游再编的购买，购买关闭后旅行者仍可完成纪游任务并领取奖励，请旅行者留意纪游的购买和开放时间。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 解锁「诸界纪游」或「诸界史诗」后，可享有纪行同惠效果，在提瓦特中购买相应纪行时可享受优惠。同理，如果旅行者已解锁「珍珠纪行」或「珍珠之歌」，也可享有纪游同惠效果，在千星奇域中购买相应纪游时可享受优惠。可在购买纪游或纪行界面的同惠按钮处查看详情说明。当期同惠效果仅生效一次。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● 每期纪游与纪行的起止时间一致，请旅行者留意时间，及时领取奖励。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓常驻颂愿套装形录新增〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e● \u003c/span\u003e7.2\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e版本更新后，新增卓越（4星）套装形录「\u003c/span\u003e枕浪逸行」进入「奇遇回声」常驻颂愿中。\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(85, 85, 85)\\\"\u003e※ 更多常驻颂愿信息可点击常驻颂愿界面左下角【详情】按钮进行查询。\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8980","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"「覆音赛季」赛季开启公告说明","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://upload-bbs.miyoushe.com/upload/2026/10/29/378227958/f8bfed637c3f15cb5ed970e5e6f4303a_1030433889970686292.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2026/10/29/378227958/f8bfed637c3f15cb5ed970e5e6f4303a_1030433889970686292.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(47, 50, 56)\\\"\u003e亲爱的旅行者，「覆音赛季」赛季即将开启~\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e〓赛季时间〓\u003c/p\u003e\u003cp\u003e赛季准备期：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e7.2版本更新后 ~ 2026/11/05 09:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e赛季游玩期：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e2026/11/05 10:00 ~ 2026/12/15 03:59\u003c/span\u003e\u003c/p\u003e\u003cp\u003e赛季展示期：\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e2026/12/15 04:00 ~ 7.2版本结束\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e〓参与条件〓\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(204, 146, 85)\\\"\u003e唤醒「千星奇域」奇偶后\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e〓赛季说明〓\u003c/p\u003e\u003cp\u003e● 单个赛季分为三个赛程：赛季准备期、赛季游玩期、赛季展示期。\u003c/p\u003e\u003cp\u003e● 在赛季游玩期中可以通过参与拥有段位或排行榜的奇域，获得竞技积分或排行榜分数。\u003c/p\u003e\u003cp\u003e※ 部分奇域无法通过房间模式提升竞技积分与排行榜分数，具体以各个具体奇域的奇匠规划为准。\u003c/p\u003e\u003cp\u003e● 在赛季准备期和赛季展示期，依然可游玩奇域但无法获得竞技积分或排行榜分数。\u003c/p\u003e\u003cp\u003e● 跨越赛季后，拥有段位的奇域是否继承对应关卡的竞技积分以及拥有排行榜的奇域是否清榜，以各个具体奇域的奇匠规划为准。\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8981","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1794301747","langs":[],"template_layout":{"tab":[{"tab_id":"5