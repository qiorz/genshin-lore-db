e}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2gmnd98sx0bT1735874971523\":[\"5qthiwsqcgT1735875016283\"],\"3kcmbalbpvsT1735874970355\":[\"5qthiwsqcgT1735875016283\"],\"4aibyvrrf4dT1735876242988\":[\"4cf2vhylew3T1710863944349\",\"z2tn3pzsbujT1710863943430\",\"nqb471m7nmnT1710863941173\"],\"4cf2vhylew3T1710863944349\":[\"hgv68m61scvT1735875300291\"],\"5nomlrdvxx4T1790430357587\":[],\"5qthiwsqcgT1735875016283\":[\"bbna40qg9pT1735875199827\"],\"8gfxrw8wla9T1710863939170\":[\"4aibyvrrf4dT1735876242988\"],\"bbna40qg9pT1735875199827\":[\"hgv68m61scvT1735875300291\"],\"hgv68m61scvT1735875300291\":[\"r10gdtihxuoT1790430301916\"],\"nqb471m7nmnT1710863941173\":[\"hgv68m61scvT1735875300291\"],\"r10gdtihxuoT1790430301916\":[\"5nomlrdvxx4T1790430357587\"],\"z2tn3pzsbujT1710863943430\":[\"3kcmbalbpvsT1735874970355\",\"2gmnd98sx0bT1735874971523\"]},\"contents\":{\"2gmnd98sx0bT1735874971523\":{\"option\":\"【漱玉想赚大钱吗？】\",\"dialogue\":\"\",\"icon\":\"\"},\"3kcmbalbpvsT1735874970355\":{\"option\":\"【漱玉想找个工作吗？】\",\"dialogue\":\"\",\"icon\":\"\"},\"4aibyvrrf4dT1735876242988\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者哥哥/姐姐和派蒙，没想到你们也很擅长斗虫！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【下次再来斗个痛快！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者哥哥/姐姐要去忙别的事了？那就下次再见啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5nomlrdvxx4T1790430357587\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"5qthiwsqcgT1735875016283\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【漱玉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我…我还不知道。比起工作和赚钱什么的，我更想待在师父身边。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果师父需要摩拉了，我就帮师父赚钱！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你的师父应该怎么都不会缺摩拉，她的小发明，随便一个放在璃月港都能卖出天价吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e5.3版本 漱玉工奇斗虫大玄境 期间\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"bbna40qg9pT1735875199827\":{\"option\":\"【甚至比某位客卿还富裕。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那位是特例吧，不能用常理讨论！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hgv68m61scvT1735875300291\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次逐月节（2026）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【没错，我一直是斗虫高手。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然以前大多是被放牛的拉着在斗虫啦…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【漱玉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这种游艺非常有趣！以后要是有机会去稻妻玩，我也想尝试一下原本的斗虫！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊好啊！我们两个在稻妻也有不少朋友，到时候，我们可以叫上大家一起快乐出游！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"r10gdtihxuoT1790430301916\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e吃一点枫丹的甜点，再尝一点须弥的烤肉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，师父给我的零花钱是不是有点多了…我吃到肚子圆圆也用不完。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，就存起来好了，以后买些机关能用上的小部件。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【我们也没想到你是机关术高手…】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对喔，你都能教别人机关术了，应该已经学会了不少硬本领！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【漱玉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还不至于啦，只是跟着师父打了一段时间的基础…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在的师父不会隐居在山林里，也不打算让我过与世隔绝的生活。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以师父教了我两派机关术，一派是仙家的，一派是普通人的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e师父说，要是以后，我想在璃月港里生活，掌握了普通机关术，就能谋一份很好的差事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这也不耽误我继续学习仙家的机关术。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e挺有道理的欸，没想到，那个女人考虑得这么周到！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1790563233","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style