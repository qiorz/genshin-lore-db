-entry-id=\\\"2634\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/07/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_3871674482746532067.JPG\\\" data-entry-name=\\\"鱼群大爆发\\\" data-entry-link=\\\"/ys/obc/content/2634/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/2634/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e鱼群大爆发\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"nj95c4gnhjT1747277814643\"],\"nj95c4gnhjT1747277814643\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e嘘！小点声，这是我这是我正在构思的另一本巨著！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e看你这么有兴趣，我就稍微透露一点。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e那将会是一个豪迈的渔夫与惊涛骇浪为伍，追寻外海中的漆黑巨鲸的史诗故事，一定能够大卖！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e不过你可别告诉其他人，半个字都不要提。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e这种绝妙的灵感，要是给人抄了去，那可不得了。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【什么漆黑巨鲸？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e外海深处的漆黑巨鲸，这种题材一定能够大卖！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nj95c4gnhjT1747277814643\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e再见，这次的选题一定会受欢迎的！\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e恰好我这里有一些协会的存货，你瞧瞧有没有合适的。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/15/50494840/1b764ab0418774d3f6ebf1bf4b1bd200_4346748916906579906.png\",\"option\":\"【我需要一些钓鱼用品。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是楠塔克，蒙德钓鱼协会的负责人之一。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯？看你的样子，是不是一眼就认出我的另一个身份了，果然是人怕出名啊，哈哈！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那我也就不装模作样了，没错！著名海洋作家楠塔克，正是鄙人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e钦？你说没有见到过我的书？那是因为还没发售。放心！很快就能在市面上见到我的大作了，我保证。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯…如果你想的话，签售会的时候我可以优先给你签名。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1747299073","langs":[],"template_layout":{"tab