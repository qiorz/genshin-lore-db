d":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"天赋牌\",\"layout_\":\"banner\",\"list\":[{\"tab_name\":\"万千的愿望\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/bea2df42c6cb8eecf724f2da60554278_7253359527898516926.png\",\"life\":3,\"life_bg\":5,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为\u003cstrong\u003e雷电将军\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e雷电将军装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e奥义·梦想真说\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;奥义·梦想真说：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;元素爆发\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成3点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(146, 84, 222)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;雷元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，其他我方角色获得2点\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;充能\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;元素爆发：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;角色的充能达到上限时，可以消耗所有的充能，来使用威力强大的「元素爆发」。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(146, 84, 222)\u0026quot;\u0026gt;雷元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着雷元素，可发生元素反应：\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超载\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+2，目标强制切换到下一个角色\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超导\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;感电\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;原激化\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;：本伤害+1，生成使下2次草元素或雷元素伤害+1的[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;激化领域\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;充能：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;角色使用「元素爆发」时，需要消耗充能。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;角色使用「元素战技」或「普通攻击」后，会获得1点充能。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e装备有此牌的雷电将军使用\u003cstrong\u003e奥义·梦想真说\u003c/strong\u003e