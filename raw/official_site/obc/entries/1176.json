ext_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e角色邀约：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6269\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/540cbdfc0863929b93b09ad72ab4ead3_1568466514611463655.png\\\" data-entry-name=\\\"邀约事件·云堇 第一幕「弦歌知雅意」\\\" data-entry-link=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e邀约事件·云堇 第一幕「弦歌知雅意」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"02028wtkpi7wT1757955861250\":[\"u5eyrt9squT1757955792987\"],\"109emqe2csqT1757955780949\":[\"u5eyrt9squT1757955792987\"],\"2n0w0zatad7T1757955729200\":[\"zy7nvjh4z5nT1757955755154\"],\"4cf2vhylew3T1710863944349\":[\"zy7nvjh4z5nT1757955755154\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"2n0w0zatad7T1757955729200\"],\"nqb471m7nmnT1710863941173\":[\"zy7nvjh4z5nT1757955755154\"],\"swns3fj4chT1757955666919\":[\"zy7nvjh4z5nT1757955755154\"],\"u5eyrt9squT1757955792987\":[\"zy88migm0ikT1757955800982\"],\"uqvnwdzc11eT1757955808802\":[],\"v1l641amwaT1757955771784\":[\"109emqe2csqT1757955780949\",\"02028wtkpi7wT1757955861250\"],\"z2tn3pzsbujT1710863943430\":[\"swns3fj4chT1757955666919\"],\"zy7nvjh4z5nT1757955755154\":[\"v1l641amwaT1757955771784\"],\"zy88migm0ikT1757955800982\":[\"uqvnwdzc11eT1757955808802\"]},\"contents\":{\"02028wtkpi7wT1757955861250\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那等你逛「霄市」逛饿了，再回来也成。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"109emqe2csqT1757955780949\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈…是啊，我确实年年都这么说，但我可没骗人啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为《璃月风物志》里写了，千年前的仙人们都爱吃烤吃虎鱼…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你该不会年年都这么说吧？】\"},\"2n0w0zatad7T1757955729200\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e下次再来！我摊位一直在这儿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，说起来还是不敢相信啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e岩王爷就这么走了，要是我爹和我爷爷他们还在世，不知道得有多大反应。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可惜等我以后也有了子子孙孙，威风的岩王爷就只能存在于故事里了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于岩王帝君的死…】——完成魔神任务第一章第一幕「浮世浮生千岩间」后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e新鲜热乎的吃虎鱼！尝尝吧，便宜！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞！新鲜又热乎嘞，小心别烫到舌头！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/16/288180982/11ee64c710e3b091256c0d349ac55461_7211273949175921952.png\",\"option\":\"【我想买些小吃。】——打开商店界面\"},\"swns3fj4chT1757955666919\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，提起师门，多少还是会有些怀念的，也不知道师父和师弟、师妹他们现在在做什么…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过现在能用刀法和厨艺为大家做一道热乎乎的烤吃虎鱼，我就已经很满足了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谢谢你的关心，好久没和别人聊这么多了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这是我以前用的剑，反正我以后也不再会与人厮杀了，这剑便赠与你吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"165\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/14/80663279/65c4d832a422c8fc7cca5907c5ba8924_7178698881440615470.png\\\" data-entry-name=\\\"暗铁剑\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/165/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/165/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/14/80663279/65c4d832a422c8fc7cca5907c5ba8924_7178698881440615470.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e暗铁剑\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/16/288180982/b26706122e54335e75a99308e473cc62_6615989467846392169.png\",\"option\":\"【关于古华派…】——获得暗铁剑*1\"},\"u5eyrt9squT1757955792987\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二、三次海灯节（2022、2023）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"uqvnwdzc11eT1757955808802\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"v1l641amwaT1757955771784\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e逛了半天也饿了吧，刚烤好的吃虎鱼，要来几条吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e跟你说，今年「明霄灯」造型纪念的那位，「移霄导天真君」当年最爱吃的就是烤吃虎鱼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不买两条吃的话，这个节算是白过啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e千八百条吧大概，拍着胸脯说，我家的吃虎鱼绝对是璃月最地道的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…因为城里至少一半的烤鱼都是从我这儿买的，我家不地道谁地道呢？哈哈哈…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要说怎么卖的了这么多，还是得提起我这古华派的刀法…去鳞开膛，手起刀落，分分钟的事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没错！我是古华派出身，曾经闭门苦练十余年…等出关时候，第一口吃的就是这烤吃虎鱼…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有人说我在这儿卖鱼是颓废了功夫，哪儿有的事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e祖师爷教训过，行利民之事乃头等「武德」，只要我这手艺好，在这儿杀鱼也是件值得自豪的事儿吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【鱼卖得怎么样？】\"},\"zy7nvjh4z5nT1757955755154\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次海灯节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"zy88migm0ikT1757955800982\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哟，客官是来逛街游玩的吗？饿了的话，要不要来两条刚烤好的吃虎鱼？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e新鲜热乎，就连璃月的仙人们都爱吃！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1757956113","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_l