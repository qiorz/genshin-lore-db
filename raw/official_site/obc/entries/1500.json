p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e与季同对话\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1322","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/02/76078930/2d07bfdb60cb00b22a52772fcf14385c_9035155043864120065.png\\\" data-entry-name=\\\"摩拉*10000\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/02/76078930/2d07bfdb60cb00b22a52772fcf14385c_9035155043864120065.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉*10000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/02/76078930/efa8fc854a69cfd476f75a201ac99152_7953466109692794772.png\\\" data-entry-name=\\\"冒险家的经验*4\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/02/76078930/efa8fc854a69cfd476f75a201ac99152_7953466109692794772.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的经验*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3125\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/14/6800286/ff6571423b753c2237bb5198370aab58_2196383323165677183.png\\\" data-entry-name=\\\"留影机\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/3125/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/3125/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/14/6800286/ff6571423b753c2237bb5198370aab58_2196383323165677183.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e留影机\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1324","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：奇了怪了，这架留影机是怎么回事…\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e旅行者：这架留影机怎么了？\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：好像是坏了，还是什么，总之就是不灵了。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：我之前在枫丹那边订了一批留影机。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：卖留影机的人说，这批留影机是他们枫丹的最新技术。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：说是可以让印出来的画有特殊的色调，带有特殊效果什么的，我就买了一台过来想要试试。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：结果不知道是我操作有问题，还是这台留影机本身就有问题，怎么弄都弄不出来正常的画。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：难道，真是我用这机器的方法有问题…\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：对了，你了解留影机吗？\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e旅行者：还算是了解…\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：那太好了，能请你帮我个忙吗？\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：看你的样子，是旅行者对了？一定去过很多地方，见识也很广。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：我想请你用这台留影机去拍点颜色很强烈的东西。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：拍好了之后，请再把印出来的画拿给我，我想看看，这留影机到底是哪里出了问题…\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e季同：实在不行，我就拿着这些画去找那个人问问去。有这些画做证据，我也不怕他不认账。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e旅行者：交给我吧。\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1325","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1326","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略推荐","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/4053628\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e【V1.3攻略】#福至五彩# 【观测枢】福至五彩活动攻略\u003c/a\u003e\\t作者：Accipiter\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1389","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true