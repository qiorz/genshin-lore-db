u003e\u003cp\u003e\u003cstrong\u003e每日委托：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2828\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/28/76953456/79b77eeb63503f854da4815f8e46ee89_5450180184368421496.png\\\" data-entry-name=\\\"万端珊瑚事件簿·收尾工作\\\" data-entry-link=\\\"/ys/obc/content/2828/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/2828/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e万端珊瑚事件簿·收尾工作\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"bfnalk6l864T1713608119931\":[],\"nqb471m7nmnT1710863941173\":[\"bfnalk6l864T1713608119931\",\"rnf31psxjpbT1713608137939\"],\"rnf31psxjpbT1713608137939\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，如果发现不寻常的事情要来报案啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e常道恢弘，鸣神永恒。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这位旅者，有什么需要帮助的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"bfnalk6l864T1713608119931\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，倒也不是这个意思…居民平安当然是好事，但总归会有事件发生的嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时看到神里家的门客在外执行公务，侦探社的龙二也经常忙着查案，再看看奉行所这里懒散一片，总觉得心里不太平衡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e作为奉行所的同心，尽力为大家解决问题，才算得上尽职尽责吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以啊，有时我也会和龙二他们合作，一起处理些事件。事情圆满完成时的成就感，可是在奉行所每天当班时体验不到的呢，嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【平安无事不好吗？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是奉行所的同心上杉，还是个刚刚加入不久的新人，请多关照。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e奉行所负责管理稻妻城的治安，工作便是处理附近居民的报案。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过这些报案里有不少是大家生活中遇到的琐碎麻烦，还有一些莫名其妙的乌龙事件…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然我很愿意帮他们解决问题，但还是希望能有些大案子上门，让我施展拳脚才好啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不然的话，就只能像大和田与力一样，碌碌无为直到退休吧。说实话，我可不想变成那样的和事佬。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"rnf31psxjpbT1713608137939\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个啊，主要是怪那个叫荒泷一斗的鬼啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在眼狩令执行期间，他被九条裟罗大人击败，之后一直想着要怎么复仇。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一开始九条裟罗大人见他十分认真，还算认可他的斗志，约定择日再战。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…但谁知荒泷一斗非说根据什么古老的妖怪规矩， 复仇战必须得在十字路口进行相扑对决…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这也太奇怪了，简直就是对裟罗大人的骚扰了吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之最后也没有打成，荒泷还被一位戴着面具的小姐拎着耳朵拽走了…只希望裟罗大人不要因为此事留下什么心理阴影，唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【乌龙事件？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是亲人走失事件吗…我明白了，请讲一下详细的情况。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯…嗯，我记下来了。交给我吧，如果有相关的情报，我会第一时间联系你的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【见过和我长的很像的人吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713722080","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\