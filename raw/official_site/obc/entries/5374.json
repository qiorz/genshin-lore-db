"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},\"tab_id\":\"1730815724349_0\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6498","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e自行巧局\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"6537","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"天赋牌\",\"layout_\":\"banner\",\"list\":[{\"tab_name\":\"吐纳真定\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/13/258999284/06f283da39baa2e65703e7e8e9003224_306943355752724906.png\",\"life\":3,\"life_bg\":1,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为\u003cstrong\u003e重云\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e重云装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e重华叠霜\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;重华叠霜：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素战技\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成3点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(145, 213, 255)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;冰元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，生成\u0026lt;strong\u0026gt;重华叠霜领域\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;重华叠霜领域\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方单手剑、双手剑或长柄武器角色造成的\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;物理伤害\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;变为\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(145, 213, 255)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;冰元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;持续回合\u0026lt;/u\u0026gt;：2\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;物理伤害：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;物理伤害不会附着元素，也不会发生元素反应。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(145, 213, 255)\u0026quot;\u0026gt;冰元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;附着冰元素，可发生元素反应:\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;融化：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;超导：\u0026lt;/strong\u0026gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;冻结：\u0026lt;/strong\u0026gt;本伤害+1，使目标本回合无法行动（受到物理或火元素伤害后提前解除，但是伤害+2）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;每回合结束阶段，\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;-1；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e装备有此牌的重云生成的\u003cstrong\u003e\u003cu\u003e重华叠霜领域\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;重华叠霜领域：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;出战状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方单手剑、双手剑或长柄武器角色造成的\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;物理伤害\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;变为\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(145, 213, 255)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;冰元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;持续回合\u0026lt;/u\u0026gt;：2\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;物理伤害：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;物理伤害不会附着元素，也不会发生元素反应。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(145, 213, 255)\u0026quot;\u0026gt;冰元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;附着冰元素，可发生元素反应:\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;融化：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;超导：\u0026lt;/strong\u0026gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u002