false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"3v10hkt6xtzT1743676043150\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你，朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【祝你好运。】\"},\"e2obe038ytgT1743676042532\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，你可能有所不知，在纳塔，失败的战士也有重新来过的机会。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要你像我一样拥有「古名」，并且与你并肩作战的伙伴取得胜利，即便自己失败了，也有再次回到战场的机会。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毫不避讳地讲，我经历过死亡…体验并不好受，但幸好我不是孤军奋战。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，不过我的年纪也渐渐大了…也许有一天，我的「古名」会带着我的故事，找到新的主人。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【失败与死亡…】\"},\"lhw7mqnue6T1743623121606\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「不要畏惧失败与死亡，它们是荣耀到来的前兆。」 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"mc5y3n8rinT1743677005744\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ryhpwu57x6T1743676041367\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你的帮助，祝你在纷争的国度永无败绩。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/03/80663279/60e98896f16b1e2f98bb1952b677ae4f_1875651826477182193.png\",\"option\":\"【关于我在「回声之子」的声望…】\"},\"swy3aeoxoueT1743676041877\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，此物是部族信仰的中心，纳塔部族的「曜石图腾柱」，是各部族与夜神之国连接的象征。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但并不是每个纳塔人都能通过图腾柱和夜神之国的大灵对话。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只有极少数德高望重或者能力突出的人能做到，而且大多集中在烟谜主。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，如果能够帮助部族完成一些委托，说不定你也能得到回应。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e部族里经常有需要人手的事务，如果你感兴趣的话，就来试试吧。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，这里是…】\"}},\"root_id\":\"lhw7mqnue6T1743623121606\",\"child_ids\":{\"3v10hkt6xtzT1743676043150\":[\"mc5y3n8rinT1743677005744\"],\"e2obe038ytgT1743676042532\":[\"mc5y3n8rinT1743677005744\"],\"lhw7mqnue6T1743623121606\":[\"ryhpwu57x6T1743676041367\",\"swy3aeoxoueT1743676041877\",\"e2obe038ytgT1743676042532\",\"3v10hkt6xtzT1743676043150\"],\"mc5y3n8rinT1743677005744\":[],\"ryhpwu57x6T1743676041367\":[\"mc5y3n8rinT1743677005744\"],\"swy3aeoxoueT1743676041877\":[\"mc5y3n8rinT1743677005744\"]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"6144","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1744165471","langs":[],"template_layout":{"tab":[{"tab_id":"75","tab_name":"页签1","module_group":[{"module_group_id":"702","layout":"l2r1","module":[{"id":"1229","pos":"left"},{"id":"1230","pos":"right"},{"id":"6143","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"703","layout":"l1r1","module":[{"id":"1231","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"704","layout":"l1r1","module":[{"id":"1232","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"705","layout":"l1r1","module":[{"id":"1233","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"706","layout":"l1r1","module":[{"id":"1234","pos":"banner"},{"id":"6144","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20",