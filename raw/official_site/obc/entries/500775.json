{"retcode":0,"message":"OK","data":{"page":{"id":"500775","name":"契约之砂","desc":"契约之砂","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/20/184753361/41a53cbf3d3742b30dd4261689b9e6fc_2108809673652298562.png","header_img_url":"","modules":[{"name":"契约之砂","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"moduleName\":\"\",\"layout_\":\"left\",\"list\":[{\"key\":\"触发条件\",\"value\":[\"击败与铁豆儿战斗的敌人后自动接取\"]},{\"key\":\"等级限制\",\"value\":[\"暂无\"]},{\"key\":\"特殊限制\",\"value\":[\"暂无\"]}]}","style":""}],"id":"1367","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7341\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/30fd9edcc97e1a980e4277f441521622_4040116064145670931.png\\\" data-entry-name=\\\"派蒙\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/30fd9edcc97e1a980e4277f441521622_4040116064145670931.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e派蒙\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"结束NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4443\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/65659bc5fcf38de8ffb821ab86a9db37_3504139456544300840.jpeg\\\" data-entry-name=\\\"铁船儿\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/65659bc5fcf38de8ffb821ab86a9db37_3504139456544300840.jpeg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e铁船儿\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e两伙不明人士在野外展开了激战，究竟发生了什么…\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e与铁豆儿交谈\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e前往山崖下的海滩\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e介入双方的交谈\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e击败尊尼\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e与铁明交谈\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e击败铁明\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e与千岩军交谈\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":true}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4290\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/4e25967e554814606c97e11b51381beb_2783785261023540017.jpeg\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"200\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/4e25967e554814606c97e11b51381beb_2783785261023540017.jpeg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*200\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"30\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*30\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"35000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*35000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/ec8eb58a99fe3270a2d5402665012d07_8834109004866409726.jpeg\"},{\"tab_name\":\"任务结束位置\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/31/82503813/74578094e3453959309aa26cacf046e6_3265151055485715741.jpeg\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"987ue16k6gvT1713604369005\":[\"r9m1ywhqijrT1713604493834\",\"nffa4jq8qt9T1713604495082\"],\"ewllh0qqr0dT1711546416025\":[\"ltysdegse9oT1713604366877\",\"987ue16k6gvT1713604369005\"],\"ltysdegse9oT1713604366877\":[\"r9m1ywhqijrT1713604493834\",\"nffa4jq8qt9T1713604495082\"],\"nffa4jq8qt9T1713604495082\":[\"p1qx8wn9xpeT1713604531642\",\"przxv2ewjmdT1713604534418\"],\"p1qx8wn9xpeT1713604531642\":[],\"przxv2ewjmdT1713604534418\":[],\"r9m1ywhqijrT1713604493834\":[\"p1qx8wn9xpeT1713604531642\",\"przxv2ewjmdT1713604534418\"]},\"contents\":{\"987ue16k6gvT1713604369005\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：义薄云天！义薄云天啊！既然这样，两位朋友，俺正好有个事儿想说说。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：俺们的摩拉，全被瓢把子带走了。现在这土窝已经成黄草窑子了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者: 瓢把子？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：就是俺们铁盐帮的老大，他在那边的山崖底下，跟一伙枫丹佬走砂，留下俺们守着窝。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：但是刚刚朋友也瞧见了吧？那些枫丹皮娃子，居然趁着瓢把子在谈事儿，偷偷摸了来，捅屁股！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：呜哇…捅屁股…！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：呜哇…！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：好崽子，这是把俺们当羊牯了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：现在这边水漫了，瓢把子指不定也要吃暗青子。好朋友，话说帮人帮到底，还请再帮俺们一把？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：若瓢把子没事，保准有你们吃香喝辣。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者 ：在哪里？我先去看看。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：就在那边山崖底下的海滩，你们过去指定能瞧见。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：两位朋友，托你们先走一步，俺收拾收拾就来。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e \u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e前往山崖下的海滩\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e 介入双方的交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，你我朋友一场，我呢，也明白你们近来有难处。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：有什么问题当面和我商量就好，搞成这样…未免有点伤感情了吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：嘿，朋友…你知道，我们这边的生意不同往常了。「刺玫会」近来得了势，我们的兄弟颇有些成了干货，落了水…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：小鸟儿们都还嗷嗷待哺呢。再这样下去，我们恐怕连鸟嘴都沾不湿了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：我们的生意很好，很合理，如果多给我们一点…将来感谢的机会，我想朋友们会更能体会到我的诚意。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：不然…哈哈，大海这样广阔，铁明先生，你们也不是不好找到新朋友！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：这样说，尊尼老大，这个报价，就是你的意思了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：这样的价格有什么问题吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：枫丹佬！招子放亮点！这点钱打发谁呢？！放那么多的屁干什么！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：多嘴！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，我的货卖给唐佩西家族，一箱五万八。卖给德尼禄家族，一箱七万。他们都是柔灯港地下响当当的帮会，这不必我说。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：我的货卖给你，三箱只要十万，专人接，专人送…为什么？为的是珍惜你这个朋友。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：大道理我就不多说了…我相信尊尼老大还是欠考虑了！我们找个地方喝一杯，再聊聊怎么样！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：呵呵，没那个必要。我知道璃月人最讲究契约，契约最在乎公平。可没听说过情理能大于公平的说法。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：呵呵，尊尼老大！如此注重契约精神，我的小弟们也该多多向你学习，哈哈！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：只不过，在这件事上，我要首先看到你们对契约的尊重。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：当然，当然！您的话再有道理不过了，璃月的古老契约真是令人崇敬，看来我必须要展示一下我的敬意。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：沃克，你觉得给每件货的报价再提高…一摩拉，怎么样？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：十分恰当，尊尼先生。这些璃月人如此辛劳，理应再获得每件货一摩拉的报酬。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：枫丹佬！你们到底什么意思？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：朋友，你们还感受不到这份远道而来的诚意吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，你们这是执意要违背约定了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哦？是吗？沃克，你觉得是这样吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：尊尼先生，若您问我的意思…大海如此广阔，是虾米就该有点自知之明。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：沃克，我为你羞愧，你怎能如此侮辱我们的璃月朋友？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：毕竟稍后就要收下他们的地盘，我们不该心怀感恩吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：对不起，尊尼先生。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿 ：你们！混账东西！你们居然打着这个主意…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者 ：怎么还骂起人了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哦？这两位小朋友是…？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：呵呵，可真是有趣啊，璃月的小朋友都这么有胆色吗？沃克。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：喂！哪来的小鬼，赏你们点摩拉，赶紧滚去买奶喝吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：你！你们这些人也太没礼貌了吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：你们两位是…？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：路见不平，拔刀相助而已。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：哎呀！那边是怎么回事？好像有人打起来了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e与铁豆儿交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：合字上的朋友，大恩不讲谢，有什么需要的，招呼一声就成！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：喔！你这个人还怪客气的。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ltysdegse9oT1713604366877\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：需要摩拉？哈哈，这倒是好说。就是办起来还有点小小的麻烦——\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：俺们的摩拉，全被瓢把子带走了。现在这土窝已经成黄草窑子了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者: 瓢把子？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：就是俺们铁盐帮的老大，他在那边的山崖底下，跟一伙枫丹佬走砂，留下俺们守着窝。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：但是刚刚朋友也瞧见了吧？那些枫丹皮娃子，居然趁着瓢把子在谈事儿，偷偷摸了来，捅屁股！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：呜哇…捅屁股…！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：呜哇…！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：好崽子，这是把俺们当羊牯了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：现在这边水漫了，瓢把子指不定也要吃暗青子。好朋友，话说帮人帮到底，还请再帮俺们一把？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：若瓢把子没事，保准有你们吃香喝辣。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者 ：在哪里？我先去看看。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：就在那边山崖底下的海滩，你们过去指定能瞧见。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：两位朋友，托你们先走一步，俺收拾收拾就来。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e \u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e前往山崖下的海滩\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e 介入双方的交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，你我朋友一场，我呢，也明白你们近来有难处。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：有什么问题当面和我商量就好，搞成这样…未免有点伤感情了吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：嘿，朋友…你知道，我们这边的生意不同往常了。「刺玫会」近来得了势，我们的兄弟颇有些成了干货，落了水…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：小鸟儿们都还嗷嗷待哺呢。再这样下去，我们恐怕连鸟嘴都沾不湿了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：我们的生意很好，很合理，如果多给我们一点…将来感谢的机会，我想朋友们会更能体会到我的诚意。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：不然…哈哈，大海这样广阔，铁明先生，你们也不是不好找到新朋友！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：这样说，尊尼老大，这个报价，就是你的意思了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：这样的价格有什么问题吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：枫丹佬！招子放亮点！这点钱打发谁呢？！放那么多的屁干什么！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：多嘴！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，我的货卖给唐佩西家族，一箱五万八。卖给德尼禄家族，一箱七万。他们都是柔灯港地下响当当的帮会，这不必我说。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：我的货卖给你，三箱只要十万，专人接，专人送…为什么？为的是珍惜你这个朋友。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：大道理我就不多说了…我相信尊尼老大还是欠考虑了！我们找个地方喝一杯，再聊聊怎么样！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：呵呵，没那个必要。我知道璃月人最讲究契约，契约最在乎公平。可没听说过情理能大于公平的说法。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：呵呵，尊尼老大！如此注重契约精神，我的小弟们也该多多向你学习，哈哈！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：只不过，在这件事上，我要首先看到你们对契约的尊重。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：当然，当然！您的话再有道理不过了，璃月的古老契约真是令人崇敬，看来我必须要展示一下我的敬意。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：沃克，你觉得给每件货的报价再提高…一摩拉，怎么样？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：十分恰当，尊尼先生。这些璃月人如此辛劳，理应再获得每件货一摩拉的报酬。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：枫丹佬！你们到底什么意思？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：朋友，你们还感受不到这份远道而来的诚意吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大，你们这是执意要违背约定了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哦？是吗？沃克，你觉得是这样吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：尊尼先生，若您问我的意思…大海如此广阔，是虾米就该有点自知之明。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：沃克，我为你羞愧，你怎能如此侮辱我们的璃月朋友？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：毕竟稍后就要收下他们的地盘，我们不该心怀感恩吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：对不起，尊尼先生。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿 ：你们！混账东西！你们居然打着这个主意…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者 ：怎么还骂起人了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哦？这两位小朋友是…？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：呵呵，可真是有趣啊，璃月的小朋友都这么有胆色吗？沃克。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：喂！哪来的小鬼，赏你们点摩拉，赶紧滚去买奶喝吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：你！你们这些人也太没礼貌了吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：你们两位是…？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：那我就直说了，最近手头有点紧。\"},\"nffa4jq8qt9T1713604495082\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哈哈哈哈！这样说来…你们是铁明先生请来的帮手了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：原来铁明先生也早就对我们有想法了啊？哼，我们也不是毫无准备。沃克！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：出来吧！兄弟们！到时候了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：什么？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哎呀，哎呀，怎么回事？好像还是我们的人比较多呢。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：铁明先生，真遗憾，我事先给手下安排了一些活，现在您留在营地的人，应该已经被清理干净了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：请安心的去吧，您的生意我们会好好打理的。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大…想淌我们铁盐帮的线，没那么简单！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：希望您的命和嘴一样硬，动手！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e击败尊尼\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e与铁明交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：两位豪侠！多谢了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：不用谢不用谢！不管在哪里交易，都要遵守契约才行！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：呵呵，这位小豪侠说的是。不过这样看，两位似乎对我们的交易很清楚嘛。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：是铁豆儿告诉我们的啦，她说你们在这里走砂什么的…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：不过走砂是什么意思？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：好像不是什么正规的交易。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：既然这样，那我必须得要好好感谢两位豪侠了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：来人！把他们绑好咯，丢去海里！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：记得多绑几块石头，这两位对我们铁盐帮有恩，别叫他们多遭了罪！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：什么？！你…你要对我们做什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：这位小豪侠，你刚才不是还很明白吗？璃月是讲究契约的国度。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：撞破了非法团伙的交易，自然就会被灭口，这不是人尽皆知的契约吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：哪有这种契约啊！你这种恩将仇报才是不讲契约！！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：不要白白浪费我的好意，等我亲自动手，你们就有苦头吃了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我们是来送某些人回家喝奶的。\"},\"p1qx8wn9xpeT1713604531642\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：少废话！铁豆儿！铁船儿！还不动手？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：铁明老大，你果然还是这么不仁不义啊。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：也不枉我们费一番功夫，绝对不能再放你这样的人在璃月为非作歹了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：收网！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：什…什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：贼人铁明！睁大你的眼睛再好好看看！我们是谁？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：千…千岩军？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：喂喂！怎么回事？！怎么突然…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：我只当你们几个是新上了跳板，没想到是该死的鹰爪孙…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：别以为我会束手就擒！我跟你们拼了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e击败铁明\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e与千岩军交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：真是不虚此行！没想到这次行动既抓到了人，还遇见了大名鼎鼎的旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：你们认识我们啊？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：那当然，旅行者，我有亲戚住在璃月港，你们的事我都听了好多遍呢，所以前面一早就认出你们了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：只不过那时候人多口杂，我怕走漏风声，让这伙人跑了。所以没有明说，真是不好意思啦。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：原来我们不是撞上了非法团伙的交易，而是撞上了千岩军抓坏蛋的行动啊！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：哈哈，没错，我们盯上这伙私自贩盐的家伙有一阵子了，前阵子恰好得到帮助，才成功打入了内部。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：差不多等了一个多月呢，今天终于等到机会，把这伙铁盐帮和枫丹那边的大鱼一网捞上来。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：别说了，前面差点还被大鱼拖下了水，那伙人下手真黑，多亏了旅行者来帮忙。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：总而言之，旅行者，前面答应你们吃香的喝辣的，可能没法兑现了，但是这里有一些摩拉，请你们收好。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：不用推脱哦，两位。帮助别人就该得到回报，大家都要遵守这条契约才行。否则未来愿意伸出援手的人会越来越少。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：好了，我们也该去处理剩下的事了，就不再耽误两位时间了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：祝你们前路顺利！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你知道我是谁吗？\"},\"przxv2ewjmdT1713604534418\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：少废话！铁豆儿！铁船儿！还不动手？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：铁明老大，你果然还是这么不仁不义啊。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：也不枉我们费一番功夫，绝对不能再放你这样的人在璃月为非作歹了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：收网！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：什…什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：贼人铁明！睁大你的眼睛再好好看看！我们是谁？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：千…千岩军？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：喂喂！怎么回事？！怎么突然…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：我只当你们几个是新上了跳板，没想到是该死的鹰爪孙…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：别以为我会束手就擒！我跟你们拼了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e击败铁明\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e与千岩军交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：真是不虚此行！没想到这次行动既抓到了人，还遇见了大名鼎鼎的旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：你们认识我们啊？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：那当然，旅行者，我有亲戚住在璃月港，你们的事我都听了好多遍呢，所以前面一早就认出你们了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：只不过那时候人多口杂，我怕走漏风声，让这伙人跑了。所以没有明说，真是不好意思啦。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：原来我们不是撞上了非法团伙的交易，而是撞上了千岩军抓坏蛋的行动啊！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：哈哈，没错，我们盯上这伙私自贩盐的家伙有一阵子了，前阵子恰好得到帮助，才成功打入了内部。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：差不多等了一个多月呢，今天终于等到机会，把这伙铁盐帮和枫丹那边的大鱼一网捞上来。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：别说了，前面差点还被大鱼拖下了水，那伙人下手真黑，多亏了旅行者来帮忙。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：总而言之，旅行者，前面答应你们吃香的喝辣的，可能没法兑现了，但是这里有一些摩拉，请你们收好。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁豆儿：不用推脱哦，两位。帮助别人就该得到回报，大家都要遵守这条契约才行。否则未来愿意伸出援手的人会越来越少。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：好了，我们也该去处理剩下的事了，就不再耽误两位时间了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：祝你们前路顺利！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：喔唷！我好怕怕！\"},\"r9m1ywhqijrT1713604493834\":{\"dialogue\":\"\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哈哈哈哈！这样说来…你们是铁明先生请来的帮手了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：原来铁明先生也早就对我们有想法了啊？哼，我们也不是毫无准备。沃克！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e沃克：出来吧！兄弟们！到时候了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁船儿：什么？！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：哎呀，哎呀，怎么回事？好像还是我们的人比较多呢。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：铁明先生，真遗憾，我事先给手下安排了一些活，现在您留在营地的人，应该已经被清理干净了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：请安心的去吧，您的生意我们会好好打理的。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：尊尼老大…想淌我们铁盐帮的线，没那么简单！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e尊尼：希望您的命和嘴一样硬，动手！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e击败尊尼\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e与铁明交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：两位豪侠！多谢了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：不用谢不用谢！不管在哪里交易，都要遵守契约才行！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：呵呵，这位小豪侠说的是。不过这样看，两位似乎对我们的交易很清楚嘛。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：是铁豆儿告诉我们的啦，她说你们在这里走砂什么的…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：不过走砂是什么意思？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e旅行者：好像不是什么正规的交易。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：既然这样，那我必须得要好好感谢两位豪侠了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：来人！把他们绑好咯，丢去海里！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：记得多绑几块石头，这两位对我们铁盐帮有恩，别叫他们多遭了罪！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：什么？！你…你要对我们做什么？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：这位小豪侠，你刚才不是还很明白吗？璃月是讲究契约的国度。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：撞破了非法团伙的交易，自然就会被灭口，这不是人尽皆知的契约吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e派蒙：哪有这种契约啊！你这种恩将仇报才是不讲契约！！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(64, 64, 64)\\\"\u003e铁明：不要白白浪费我的好意，等我亲自动手，你们就有苦头吃了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我们是来吃香喝辣的。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1714961358","langs":[],"templa