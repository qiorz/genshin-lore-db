3e\u003cstrong\u003e每日委托：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1128\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/26/76953456/79b77eeb63503f854da4815f8e46ee89_6597146479263935459.png\\\" data-entry-name=\\\"无人注意的盖伊\\\" data-entry-link=\\\"/ys/obc/content/1128/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1128/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e无人注意的盖伊\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1123\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/25/76953456/79b77eeb63503f854da4815f8e46ee89_6140537752768463426.png\\\" data-entry-name=\\\"父亲能做的事\\\" data-entry-link=\\\"/ys/obc/content/1123/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1123/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e父亲能做的事\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"3cv3euqkfrnT1721127304711\":[\"rmnyd5nn32nT1721127323934\"],\"4cf2vhylew3T1710863944349\":[\"ge4j9greugeT1721127280080\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"ge4j9greugeT1721127280080\":[\"3cv3euqkfrnT1721127304711\"],\"nqb471m7nmnT1710863941173\":[\"ge4j9greugeT1721127280080\"],\"rmnyd5nn32nT1721127323934\":[],\"z2tn3pzsbujT1710863943430\":[\"ge4j9greugeT1721127280080\"]},\"contents\":{\"3cv3euqkfrnT1721127304711\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e城里的大家越是开心，我的一天就显得更无意义…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e佳酿节啊，父亲那边应该很忙吧…我在这里做什么啊，还不如回家帮忙呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这样啊，如果有麻烦请一定来找我…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，算了反正我在这种不起眼的地方，你马上就会把我忘了吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e又是毫无意义的一天…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦！有什么需要帮忙的吗？不不，没有也没关系！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ge4j9greugeT1721127280080\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次佳酿节（2022）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你在做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我也想知道我在做什么…我到底在做什么啊，盖伊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好吧，我在看守蒙德的侧门。众所周知的，几从来没有人经过的侧门。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嘲笑我吧， 如你所见，是毫无意义的差事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"rmnyd5nn32nT1721127323934\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你好像很苦恼。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，当然很苦恼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e8岁锻炼体力，10岁修习剑法，16岁成为见习骑士…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e作为家里的荣耀的我，却被安排了这样的差事…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明都在骑士团做事，可看守冷清的侧门这样的工作，简直就像没有迪奥娜的猫尾酒馆一样，是没有灵魂的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…话说你有遇到什么麻烦吗？多麻烦的事都行，让我看看能不能帮上忙吧！好歹我也是西风骑士嘛！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊…没有吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"list\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724687553","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_ty