itch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"egod2kt9xg9T1729740249953\":[],\"nqb471m7nmnT1710863941173\":[\"egod2kt9xg9T1729740249953\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我觉得，接下来应该去那边逛一逛！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e小姐，恕我冒昧提醒，您的冒险计划…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e哎呀，知道啦，我没有忘记！这不是在冒险之前，想先买些须弥的特产吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e你就先陪我购物吧，雇佣费我会按照冒险家保镖的规格发放，不会少了你的，放心吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e不是钱的问题，只是我的工作一般不是帮大小姐在闹市区拎包…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e这不是我预判错误，只带了潜水设备来须弥嘛。你就当是在采购冒险物资好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"text-align: start\\\"\u003e唉，好吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"egod2kt9xg9T1729740249953\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【花神诞祭（2024）期间  白天】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我觉得，接下来应该再去那边逛一逛！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e小姐，恕我冒昧提醒，您的冒险计划…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，知道啦，我没有忘记！可现在不是在举办花神诞祭嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这么重要的节日，我怎么能不全身心投入呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不仅是身心的问题吧。如果把钱包都投入进去,可就没有冒险经费咯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【艾维娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这就是你不懂了。钱这种东西，就是要流动起来才有价值！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莲塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，这样吗，好吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","men