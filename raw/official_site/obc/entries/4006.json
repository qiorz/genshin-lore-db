t_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4b58oozttwiT1746448751529\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"nqb471m7nmnT1710863941173\":[\"yuqjsrwc9bT1746448750782\",\"4b58oozttwiT1746448751529\"],\"vxiicz94cT1746448764254\":[],\"yuqjsrwc9bT1746448750782\":[\"vxiicz94cT1746448764254\"],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4b58oozttwiT1746448751529\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你！可是青蛙实在是太难抓了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…到现在为止我只抓住了几只蜥蜴，还只抓到了它们的尾巴。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个，不嫌弃的话，就请你收下吧，我还得继续抓青蛙呢，这些拿在手上有些不方便。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"737\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/13/24077343/659c11d2fa422d4d751516c7f17a5140_1779891039789393448.png\\\" data-entry-name=\\\"蜥蜴尾巴\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/737/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/737/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/13/24077343/659c11d2fa422d4d751516c7f17a5140_1779891039789393448.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e蜥蜴尾巴\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/b26706122e54335e75a99308e473cc62_945402182450977036.png\",\"option\":\"【祝你们好运。】——获得蜥蜴尾巴*3\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不好意思，你看到青蛙了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我刚刚在抓一只青蛙，它的背很滑，不小心让它跳走了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e难得遇上这么精神的青蛙，能抓到就好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【青蛙？】\"},\"vxiicz94cT1746448764254\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我觉得她不喜欢我，无论说什么她都不听我的，更别说陪她玩了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明她想要的东西我都想办法送给她了，是都不合她的心意吗…？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【为什么你不陪她玩？】\"},\"yuqjsrwc9bT1746448750782\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我抓青蛙是为了送给妹妹玩的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那边的小女孩就是我的妹妹，她总是在追自己的影子，明明是不可能抓得到的，不知道她在想什么…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可能她也很无聊吧，抓一只青蛙让她去追，也总好过追影子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【拿青蛙做什么？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见~！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746458676","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}