data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/09/80663279/41a53cbf3d3742b30dd4261689b9e6fc_8073947592600816835.png\\\" data-entry-name=\\\"转行总是令人焦虑\\\" data-entry-link=\\\"/ys/obc/content/506828/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506828/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e转行总是令人焦虑\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【莱里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，如果把头换成机关的话，那就完全不是人类了吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【波泽娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可是身体还是人的身体啊，反而是你说的，只有头保留原样，脖子以下都用机关代替，那样才不是人呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莱里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e头换成机关！说话会有「嗡嗡，嗡嗡」的响声，走起路来也「喀嚓，喀嚓」的，才不是人呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【波泽娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那脖子以下全被机关代替的人，走起路来也是「喀嚓，喀嚓」的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莱里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这、这两种「喀嚓，喀嚓」不一样啦…而且，脖子以下都用机关代替的人，还能够发出正常人的声音！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【波泽娜】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e重要的才不是声音呢，重要的是，他们一样都能说出应该说的话！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莱里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔，这倒是没法反驳呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762086985","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","r