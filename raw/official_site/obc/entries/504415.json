":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0rpt41inw7fT1737043287219\":[\"m81ntxd6tamT1737043559903\"],\"5kqxdejruk7T1737043286584\":[\"m81ntxd6tamT1737043559903\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"8lc9pj2kopsT1737043782090\":[\"d57u0bxye1dT1737043846532\"],\"abd3849wrubT1737043287917\":[\"m81ntxd6tamT1737043559903\"],\"d57u0bxye1dT1737043846532\":[],\"fsipoqdy8hT1737043767507\":[\"8lc9pj2kopsT1737043782090\",\"gc1tih80vk4T1737043782810\"],\"gc1tih80vk4T1737043782810\":[\"d57u0bxye1dT1737043846532\"],\"m81ntxd6tamT1737043559903\":[\"fsipoqdy8hT1737043767507\"],\"nqb471m7nmnT1710863941173\":[\"vvo7d9dpi4lT1737043285909\",\"5kqxdejruk7T1737043286584\",\"0rpt41inw7fT1737043287219\",\"abd3849wrubT1737043287917\"],\"vvo7d9dpi4lT1737043285909\":[\"m81ntxd6tamT1737043559903\"]},\"contents\":{\"0rpt41inw7fT1737043287219\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好你好。可惜现在不能和你聊太长时间。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我不是内向的人哈，但不管怎么说现在是工作时间，被人抓住在偷懒的话总归不太好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你问是什么工作？是值班啦。值班就是…只要人在这里就好了，对不对？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【白天好。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"5kqxdejruk7T1737043286584\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「曜石图腾柱」，很气派吧！据说能直接和「大灵」连接哦！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，大概就是这样的圣物。具体我记不太清了，哈哈，我历史学得不是很好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你有什么想深入了解的知识，请去咨询晚上当值的人吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，如果你愿意帮流泉之众一些小忙，曜石图腾柱也会对你好的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，这里是…】——开启纳塔声望后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8lc9pj2kopsT1737043782090\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，如果是有关「曜石图腾柱」的事情，请找卡胡那先生！我现在已经下班啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果想一起听音乐的话，请便，我不介意多个伙伴。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚上好。】\"},\"abd3849wrubT1737043287917\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那晚上下班见！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"d57u0bxye1dT1737043846532\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"fsipoqdy8hT1737043767507\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚风也是伴奏的一部分呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"gc1tih80vk4T1737043782810\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不再多听一会儿？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"m81ntxd6tamT1737043559903\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，早上好！不对，现在是早上吗…总之，白天好！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"vvo7d9dpi4lT1737043285909\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢感谢，非常感谢你愿意帮忙啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/17/288180982/60e98896f16b1e2f98bb1952b677ae4f_4845051183331817684.png\",\"option\":\"【关于我在「流泉之众」的声望…】——打开声望界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"梅兹特利·「流泉之众」/纳塔任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"573\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e任务名称\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e任务类型\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e经验奖励\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\