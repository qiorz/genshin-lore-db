span\u003e\u003cspan class=\\\"amount\\\"\u003e*50000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506263\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/09/183046623/c5971c438ea335652ab2337bc0fd1e34_6002681181586229185.png\\\" data-entry-name=\\\"毁损机轴\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/506263/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506263/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e毁损机轴\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"备注\",\"value\":[\"\u003cp\u003e参与线下活动获得\u003c/p\u003e\"]}]}\n","style":""}],"id":"8177","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动海报","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"活动海报\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/03/20/317305234/8e7fda219f36578ee3dc9989f088cc0c_8652470891342029889.png\"}]}\n","style":""}],"id":"8178","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"6zuic00j2cT1772465815717\",\"child_ids\":{\"6zuic00j2cT1772465815717\":[]},\"contents\":{\"6zuic00j2cT1772465815717\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e真是热闹的庆典！\u003c/h1\u003e\u003cp\u003e发件人：法尔伽\u003c/p\u003e\u003cp\u003e时间：兑换码使用时间\u003c/p\u003e\u003chr\u003e\u003cp\u003e哟，荣誉骑士，羽球节玩得开心吗？我可是度过了相当痛快的一天！\u003c/p\u003e\u003cp\u003e能回到蒙德和大家一起庆祝节日真是太棒了！要我说，这次你的功劳可不少，得多夸奖夸奖，哈哈。\u003c/p\u003e\u003cp\u003e既然你特意回了一趟蒙德，那我也得拿出大团长的诚意。这期间你们的食宿都算我的，不要客气（为了健康着想，提醒派蒙还是不要吃得太撑比较好）。另外，我从迪奥娜那里学习了一个新的酿酒配方，据说是用钩钩果…然后什么来着？算了下次去猫尾酒馆再问问好了，等酒酿成了我们一起畅饮。\u003c/p\u003e\u003cp\u003e又：之前见你对这些机轴感兴趣，顺手捎了些。\u003c/p\u003e\u003cp\u003e又又：有什么事需要帮忙尽管开口，要是只想找个人喝酒闲聊也行——我随时奉陪。\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8179","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"七圣召唤对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"4r3swh5ua6T1772465815728\":[]},\"contents\":{},\"root_id\":\"4r3swh5ua6T1772465815728\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8180","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻想真境剧诗对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"o22a89odd9jT1772465815731\",\"child_ids\":{\"o22a89odd9jT1772465815731\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":fa