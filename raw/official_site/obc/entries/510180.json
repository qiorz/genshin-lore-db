ecc0a851e_8748453314712826620.png\"}]}\n","style":""}],"id":"9904","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8178","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"qwfhadxehfT1782390863293\",\"child_ids\":{\"3w3gjfa58vlT1782390968302\":[\"c8x20c6aabmT1782391086289\",\"y5tcv5owmznT1782391340174\",\"dyduy6eyoi7T1782391341241\"],\"c8x20c6aabmT1782391086289\":[],\"dyduy6eyoi7T1782391341241\":[],\"ko9b9uxyknT1782390969623\":[],\"qwfhadxehfT1782390863293\":[\"vv9hz6m5jblT1782390901384\"],\"vv9hz6m5jblT1782390901384\":[\"3w3gjfa58vlT1782390968302\",\"ko9b9uxyknT1782390969623\"],\"y5tcv5owmznT1782391340174\":[]},\"contents\":{\"3w3gjfa58vlT1782390968302\":{\"option\":\"旅行者：我来试试！\",\"dialogue\":\"\u003cp\u003e法尔伽：好——都听到了吗，这可是在荣誉骑士面前，都打起点精神来！\u003c/p\u003e\u003cp\u003e法尔伽：预备——开始！\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e通过多轮喊口号后…\u003c/p\u003e\u003cp\u003e法尔伽：——稍息！\u003c/p\u003e\u003cp\u003e法尔伽：怎么样？荣誉骑士，你觉得这里面谁醉得最厉害？\u003c/p\u003e\",\"icon\":\"\"},\"c8x20c6aabmT1782391086289\":{\"option\":\"旅行者：左边的那一位…\",\"dialogue\":\"\u003cp\u003e温弗里德：没…我…我没醉！就是…那个…有点头晕…\u003c/p\u003e\u003cp\u003e法尔伽：比喝醉了更丢脸的事，就是喝醉了还不承认——二十圈，一个都别落！\u003c/p\u003e\",\"icon\":\"\"},\"dyduy6eyoi7T1782391341241\":{\"option\":\"旅行者：右边的那一位…\",\"dialogue\":\"\u003cp\u003e莱夫赫姆：没…我…我没醉！就是…那个…有点头晕…\u003c/p\u003e\u003cp\u003e法尔伽：比喝醉了更丢脸的事，就是喝醉了还不承认——二十圈，一个都别落！\u003c/p\u003e\",\"icon\":\"\"},\"ko9b9uxyknT1782390969623\":{\"option\":\"旅行者：我有点事…\",\"dialogue\":\"\u003cp\u003e法尔伽：好吧，他们估计还得醉上好一阵子，你如果有空了，随时可以回来。\u003c/p\u003e\",\"icon\":\"\"},\"qwfhadxehfT1782390863293\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e法尔伽：向左转…向右转！\u003c/p\u003e\",\"icon\":\"\"},\"vv9hz6m5jblT1782390901384\":{\"option\":\"旅行者：法尔伽，你们这是在？\",\"dialogue\":\"\u003cp\u003e法尔伽：哦，这是骑士团里的队列训练。他们三个昨晚有点喝高了，我在给他们醒酒。\u003c/p\u003e\u003cp\u003e法尔伽：…顺便找出醉得最厉害的，罚跑二十圈。虽然远征军没有禁酒，但什么时候喝、每次喝多少也都是有规矩的。\u003c/p\u003e\u003cp\u003e温弗里德：我…我只喝了一点点！\u003c/p\u003e\u003cp\u003e艾克贝特：我…我也是！\u003c/p\u003e\u003cp\u003e法尔伽：…与其用言语，不如用行动来证明吧！给我拿出就算喝醉了也能完美应付的气势来！\u003c/p\u003e\u003cp\u003e莱夫赫姆：是…是！\u003c/p\u003e\u003cp\u003e法尔伽：…荣誉骑士，能请你来整肃他们吗？只要\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e一边喊口号，一边找出里面犯错最多的人\u003c/span\u003e就行。\u003c/p\u003e\",\"icon\":\"\"},\"y5tcv5owmznT1782391340174\":{\"option\":\"旅行者：中间的那一位…\",\"dialogue\":\"\u003cp\u003e艾克贝特：没…我…我没醉！就是…那个…有点头晕…\u003c/p\u003e\u003cp\u003e法尔伽：比喝醉了更丢脸的事，就是喝醉了还不承认——二十圈，一个都别落！\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"9903","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8179","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1792981898","langs":[],"template_layout":{"tab":[{"tab_id":"475","tab_name":"基本信息","module_group":[{"module_group_id":"2520","layout":"l2r1","module":[{"id":"8239","pos":"banner"},{"id":"8151","pos":"left"},{"id":"8155","pos":"right"}],"name":"基本信息","repeated":false,"parent_group_id":"0"}]},{"tab_id":"488","tab_name":"逸闻纪事","module_group":[{"module_group_id":"2538","layout":"l2r1","module":[{"id":"8174","pos":"left"},{"id":"8175","pos":"right"},{"id":"8176","pos":"left"}],"name":"","repeated":true,"parent_group_id":"0"}]},{"tab_id":"492","tab_name":"剧情彩蛋","module_group":[{"module_group_id":"2539","layout":"l2r1","module":[{"id":"8177","pos":"left"},{"id":"8178","pos":"right"},{"id":"8179","pos":"left"}],"name":"剧情彩蛋","repeated":true,"parent_group_id":"0"},{"module_group_id":"2886","layout":"l2r1","module":[{"id":"9905","pos":"left"},{"id":"9904","pos":"right"},{"id":"9903","pos":"left"}],"name":"","repeated":tru