\\"\u003e仇敌仿佛众水翻腾…\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"hpmgevbkducT1780571558080\"],\"9bg1nijifybT1780572065271\":[\"td895unzyz9T1780572086951\",\"oxt8ritervT1780572135239\",\"x79apcy4ivcT1780572146951\",\"h8r4nptqb2hT1780572158647\"],\"aq2gdy3c7weT1780571781807\":[\"9bg1nijifybT1780572065271\"],\"c9yr1t9slT1780572350487\":[],\"djbby0mgzhuT1746629529878\":[\"aq2gdy3c7weT1780571781807\"],\"h8r4nptqb2hT1780572158647\":[],\"hpmgevbkducT1780571558080\":[\"nqb471m7nmnT1710863941173\",\"xh7wklr5p7T1746630475033\",\"z2tn3pzsbujT1710863943430\"],\"jbbkoxrfbtfT1780572343584\":[],\"nqb471m7nmnT1710863941173\":[\"zmyri3dfl4T1746629322235\"],\"oxt8ritervT1780572135239\":[\"jbbkoxrfbtfT1780572343584\",\"c9yr1t9slT1780572350487\"],\"td895unzyz9T1780572086951\":[],\"x79apcy4ivcT1780572146951\":[],\"xh7wklr5p7T1746630475033\":[\"aq2gdy3c7weT1780571781807\"],\"xhskxkuiezaT1746629332303\":[\"aq2gdy3c7weT1780571781807\"],\"z2tn3pzsbujT1710863943430\":[\"aq2gdy3c7weT1780571781807\"],\"zmyri3dfl4T1746629322235\":[\"xhskxkuiezaT1746629332303\",\"djbby0mgzhuT1746629529878\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务「失而复得者一同欢喜」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"9bg1nijifybT1780572065271\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…旅行者，是你啊，你从居尔城回来了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯…对了，你现在找我，是有什么事吗？呃，最近塔尼特的事情稍微有点多…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"aq2gdy3c7weT1780571781807\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务「居尔城的记忆」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"c9yr1t9slT1780572350487\":{\"option\":\"【当然，不过别忘了付账。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e噗…少拿佣兵那套搪塞我了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过…你要小心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"djbby0mgzhuT1746629529878\":{\"option\":\"【如果我和主母起了冲突呢…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，不许开这种玩笑啦，你是塔尼特的贵宾，又迎回了「镇灵之母」，找到了前往「永恒绿洲」的路…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我想不到主母会和你起冲突的理由。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"h8r4nptqb2hT1780572158647\":{\"option\":\"【那就等你有空…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，等我稍微闲一点了，我们再聊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呃，对了…！对了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没什么…嗯，不管你遇到什么危险，我会站在你这边。所以…请小心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hpmgevbkducT1780571558080\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e啊，旅行者…原来是你，怎么了，有什么事吗？\u003c/p\u003e\",\"icon\":\"\"},\"jbbkoxrfbtfT1780572343584\":{\"option\":\"【当然。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…谢谢。你要…小心坏人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【关于「永恒绿洲」…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…这次去「永恒绿洲」，真是多亏有你，如果没有你的话，说不定根本没办法真的打开通往「永恒绿洲」的道路。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我都不知道应该如何感谢你…下次我们再一起点起篝火，坐在篝火边夜谈吧，就像…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像上次和阿萨里格…啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…那个狗东西…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"oxt8ritervT1780572135239\":{\"option\":\"【塔尼特的事？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，不是什么大事，现在也没法跟你说…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大、大概是旅团里的一些事吧，嗯，也许和那群北方人有关，具体的情况我也不是很清楚…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过…嗯…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过…！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呃，对不起，我怎么一惊一乍的…我是说，之后假如我…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不，假如、假如你遇到了危险，请你一定相信我！我永远站在你这边。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e假如遭遇危险的是我…我也相信，你一定会来帮我，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"td895unzyz9T1780572086951\":{\"option\":\"【关于利露帕尔…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，我听说了，她离开了。回到那个被诅咒的地方去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个家伙，整天一副高高在上的态度惹人不爽，现在可算是安静了…让我松了口气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，她确实帮了我们很多…唔，你说，她在那里会找到什么呢？如果那里什么都没有的话…她也会像我们一样，感到孤独吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…真可惜没能跟你一起去…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"x79apcy4ivcT1780572146951\":{\"option\":\"【关于奔奔…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多亏你上次从那些北方人手里拿来的东西，奔奔现在逐渐恢复，看上去可精神了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e跟我们当初遇到它的时候一样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xh7wklr5p7T1746630475033\":{\"option\":\"【关于奔奔…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多亏你上次从那些北方人手里拿来的东西，奔奔现在逐渐恢复，看上去可精神了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e跟我们当初遇到它的时候一样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xhskxkuiezaT1746629332303\":{\"option\":\"【嗯，我也是婕德人！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e婕德人是什么啦…好怪，听上去好像派蒙会取的外号哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，谢谢你，旅行者…真的很感谢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【没什么事…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…有什么需要我帮忙的，要及时和我说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zmyri3dfl4T1746629322235\":{\"option\":\"【抱歉…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没有什么可抱歉的…我没有在生你的气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e主母在我出发前就已经让我提高警惕了。我可能行事草率…噗，也许吧…但我并不傻。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那些古代机械的图纸…他从来没有给族人分享过一这是重罪，从意识到这点起，我就已经生疑了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我没想到，他在与我接触的这么长时间里，竟然怀着那样的算计···他自以为能掌控我…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想到这个我就觉得恶心…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过还好，还有芭别尔主母始终站在我这边，我相信她一定能让部族重新繁荣…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一定能…嗯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，还有你！还有你是我这边的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"