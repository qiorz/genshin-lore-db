{"retcode":0,"message":"OK","data":{"page":{"id":"2434","name":"「八重堂」的邀约","desc":"2.0版本世界任务 「八重堂」的邀约","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/21/80663279/41a53cbf3d3742b30dd4261689b9e6fc_5105946712217562716.png","header_img_url":"","modules":[{"name":"「八重堂」的邀约","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"list\":[{\"key\":\"触发条件\",\"value\":[\"在图示位置与荒谷对话\"]},{\"key\":\"等级限制\",\"value\":[\"冒险等阶达到30级（开启稻妻区域）\"]},{\"key\":\"特殊限制\",\"value\":[\"完成行秋传说任务 锦织之章第一幕\"]}]}","style":""}],"id":"1367","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3351\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/26/76078930/6eb8d30b00a459255466d1a08ed82172_8481398194256492603.png\\\" data-entry-name=\\\"荒谷\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/3351/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/3351/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/26/76078930/6eb8d30b00a459255466d1a08ed82172_8481398194256492603.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e荒谷\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e稻妻城\u003c/p\u003e\"]},{\"key\":\"结束NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3351\\\" data-entry-ratio=