_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/22/74114945/00b6325a61ff76b55ac87919153f5990_1205902962027309635.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大英雄的经验\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/26/76078930/faf37a52a25d2d6ceafc85d2e2cbe647_1237209455405395484.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e帮助八重堂的编辑给璃月的两位作家发出邀约\u003c/p\u003e\u003cp\u003e玩家攻略推荐：\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/7753074\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e【稻妻世界任务】「八重堂」的邀约\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\\t\\t作者：\u003c/strong\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(102, 102, 102)\\\"\u003eDramaturge\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"ag3auuzeql8T1713697581526\":[\"lsco83cvp0iT1713697620007\"],\"ewllh0qqr0dT1711546416025\":[\"ag3auuzeql8T1713697581526\",\"ydtgg5x18jqT1713697581830\"],\"lsco83cvp0iT1713697620007\":[],\"ydtgg5x18jqT1713697581830\":[\"lsco83cvp0iT1713697620007\"]},\"contents\":{\"ag3auuzeql8T1713697581526\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e那就拜托你了，旅行者。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与荒谷对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这种时候…怎么联系这两位老师呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e联系什么？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e欸！是旅行者啊，你…你来的正好，我正有事想请人帮忙呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是这样，「八重堂」一年一度的小说比赛就快要开始了，按照惯例，我们打算邀请几位作家老师来当评委。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但是…有两位老师并不是稻妻人，目前也不在稻妻国内。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e您也知道，眼下这种时候，实在没法邀请国外人士过来。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但这种大事，如果不给作者老师们知会一声，也不太合适…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e所以我就想着，至少该托人送点礼物过去，也算是不失了礼节，顺便还可以再附信一封，预约一下往后的稿子，咳…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不知道，您意下如何呀？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"lsco83cvp0iT1713697620007\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e常九爷的小说《古华派的大师兄》，叙述的是一个出身古典宗门的璃月大师兄与异国的稻妻小师妹之间的江湖故事。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e要我说的话，题材和剧情其实都有些老套了，但好在还有一些读者买账，销量还可以。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们也总结过疾风意见信，托人带给常九爷，希望能帮助他在后续的作品里做出一些突破…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但信寄出去之后却一直杳无回音，也不知道是送丢了，还是怎么回事…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「枕玉」是谁？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那我可不知道，应该是这位老师的笔名吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这位老师写的《沉秋拾剑录》？这可是引起轰动的著作！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e无论是设定还是剧情，都大大地引领了一波创作的风潮。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那我要去哪里找这位老师…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e呃…这个…这位老师应该也是在璃月。据那位吧这本《沉秋拾剑录》带回稻妻的客商说，他是在「万文集舍」里看见的这本书。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我想，问问「万文集舍」的人，应该就能找到这位老师了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过…咳！先不说这些了，这些礼物和信件请你拿好了，这件事就拜托你了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e荒谷的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，什么时候才能看到「枕玉」老师的新作品呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与常九爷对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？旅行者，你今天过来是有什么事吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于「八重堂」的信件和礼物…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「八重堂」的信？不会又是来让我改笔名的吧？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我都说了，我署原名就好…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e算了，算了，我还是看看吧…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e常九爷读了八重堂的信件…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e小说比赛…评委，这…我也许没空去啊，但还是谢谢他们的好意…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？这后面怎么还有这么多，这是…创作建议…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e呃，我、我会好好看看的，谢谢你，旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e常九爷的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e常九爷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这创作建议，怎么这么多…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e去万文集舍寻找「枕玉」\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e常九爷的信已经送到了，接下来就是那位「枕玉」了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔…我们去「万文集舍」问问看吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？那是…行秋！对了，他看的书多，说不定知道这位「枕玉」是谁。我们去问问他吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与行秋对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯…这里写得倒是不错，文笔颇为新颖…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e行秋。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e原来如此，原来如此…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e行秋！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e欸？是你啊，旅行者，好久不见。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e听你刚辞打招呼的语气，你还挺精神的嘛，不错，不错…找我有什么事吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e其实，我们是想想你打听一个人，你读得书多，说不定会知道。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e一个人？你们莫不是要找哪位作者？唔…但说无妨。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于「枕玉」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「枕玉」？你、你从哪听到这名字的？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这本《沉秋拾剑录》上写着呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们正在找这位「枕玉」，稻妻那边的「八重堂」拜托我们把一封信带给这位作者呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你知道这位「枕玉」到底是谁吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯…这位「枕玉」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e说来惭愧，其实正是…我的笔名。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e欸？！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e之前没听你说过。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这件事…这件事也没什么好提起的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e当初在璃月时，负责的编辑说我写的这本书「设定过于离谱，剧情却意外地俗套，没人会喜欢」，然后就把我的稿给拒了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我听了之后…咳，不太服气，就自己印了几本，偷偷放在「万文集舍」里，看有没有人喜欢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e结果，取阅者依然寥寥，我就没再把心放在这上面了。没想到，这本书在稻妻居然能受到如此好评。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但无论如何，我写的这书有人愿意看，自然是好事。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我会好好看看这封信的，谢谢你旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e行秋的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过，我写的这本书到底是怎么漂洋过海到稻妻的？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e行秋：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e难道，是哪位路过的稻妻客商顺手买走了书，然后带回了稻妻…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e向荒谷回报\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哎，您终于回来了！怎么样？有见到两位老师吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e信都送到了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e太好了！谢谢你旅行者，那两位老师怎么说？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e他们说会好好看信的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那就好，那就好。唉…可惜这两位老师都远在璃月…平日里也没办法去拜访。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e特别是「枕玉」老师的那本《沉秋拾剑录》还不是他本人投的稿，是被一位客商带回的稻妻。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e然后我们「八重堂」中的一位编辑读到了这本书，感觉到了这本书的价值，就准备亲自去璃月一趟，向「枕玉」老师正式约稿。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但没想到…稻妻的局势骤变，我们没法派人去璃月，寄出去的信也始终杳无回音。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们就只能自己先印发了这本书，把稿酬都给「枕玉」老师记下，等取得联系之后，在一起付给他。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过，都这么长时间了，《沉秋拾剑录》的销量始终居高不下，稿酬也越堆越多。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，「枕玉」老师可千万要出席这次比赛啊，这稿酬…这稿酬可不能再堆下去了…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ydtgg5x18jqT1713697581830\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e荒谷：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那两位老师一位叫「枕玉」，一位是叫…常九爷。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：那两位老师分别是谁？\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713751342","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"childre