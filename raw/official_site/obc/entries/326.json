279/e70940b73124b584d629b99f29f73070_5718714634368784469.png\\\" data-entry-name=\\\"锦织之章 第一幕 「江湖不问出处」\\\" data-entry-link=\\\"/ys/obc/content/675/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/675/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e锦织之章 第一幕 「江湖不问出处」\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e1.3：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1584\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/09/76373921/c936520994ef0dc05e64267c629bd588_8433549590102860932.png\\\" data-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"ryxz2z6xq4T1718548965820\"],\"528nkb2afdlT1718548620487\":[\"ryxz2z6xq4T1718548965820\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"g8gw3rk9vylT1718548777467\",\"m58mr6s8u2T1718548844939\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"v5fb1s2m1xT1718548712743\"],\"dxgyolu6c7uT1718550270867\":[],\"fuwsquneqbkT1718550173864\":[\"dxgyolu6c7uT1718550270867\"],\"g8gw3rk9vylT1718548777467\":[\"ryxz2z6xq4T1718548965820\"],\"m58mr6s8u2T1718548844939\":[\"ryxz2z6xq4T1718548965820\"],\"nqb471m7nmnT1710863941173\":[\"ryxz2z6xq4T1718548965820\"],\"ryxz2z6xq4T1718548965820\":[\"syjrp1p1nudT1718549013990\"],\"syjrp1p1nudT1718549013990\":[\"yl9wb8oaqgcT1718549051591\"],\"v5fb1s2m1xT1718548712743\":[\"ryxz2z6xq4T1718548965820\"],\"yl9wb8oaqgcT1718549051591\":[\"fuwsquneqbkT1718550173864\"],\"z2tn3pzsbujT1710863943430\":[\"528nkb2afdlT1718548620487\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【生意如何？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e生意一直都还不错，毕竟绯云坡也算是璃月商业的黄金地段了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只可惜，我这家店还没被有岩王爷亲自「临幸」过…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，我的意思是说，我这家新店还没有被岩王爷亲自光顾过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那些历史上被岩王爷光临并赞许过的店，后来都成了百年老字号，生意特别红火。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，不过这也是可遇而不可求的事情啊…但行人事，莫问天命吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"528nkb2afdlT1718548620487\":{\"option\":\"【「璃月商贸学」…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，简单来说就是以每个璃月商人的角度出发，研究如何赚最多摩拉的学问。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毕竟如今的商人只埋头赚钱可不行。只有学习知识、总结规律，才有机会掌握制胜之道。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，请问需要什么吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"dxgyolu6c7uT1718550270867\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"fuwsquneqbkT1718550173864\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e今年的海灯节和往年真的不太一样呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e之前听说总务司决定办一场烟花会，我就开始联系手上的渠道，筹集制作烟花的材料。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果中途又遇上凝光大人重建群玉阁的事情，因为酬劳的确诱人，我又转手去筹备这事…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果最后两件事都没能办成…看来经商一事，万不可悠游寡断。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过虽然没能抓住这些机会，但今年我仍旧准备了一些霄灯的材料。不图卖出高价，只是为了送给附近的邻居和朋友们。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e希望大家都能享受今年的海灯节。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"g8gw3rk9vylT1718548777467\":{\"option\":\"【关于岩王帝君的死…】——完成魔神任务 第一章第一幕「浮世浮生千岩间」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，我也从小道消息听说了这件事…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e璃月的繁荣离不开岩王帝君的功劳，就连摩拉也是以岩王帝君的真名来命名的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没有一个商人不崇敬他，没有一笔交易不是在他的荣光之下进行的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可如今…恐怕这件事会在商界引起一场轩然大波吧， 或者说这场轩然大波已经开始了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 第一章第三幕「迫近的客星」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\"},\"m58mr6s8u2T1718548844939\":{\"option\":\"【关于岩王帝君的死…】——完成魔神任务 第一章第三幕「迫近的客星」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e璃月的繁荣离不开岩王帝君的功劳，就连摩拉也是以岩王帝君的真名来命名的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没有一个商人不崇敬他，没有一笔交易不是在他的荣光之下进行的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可如今…恐怕这件事会在商界引起一场轩然大波吧， 或者说这场轩然大波已经开始了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【有什么卖的。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e保证合您心意，请看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/288180982/11ee64c710e3b091256c0d349ac55461_1517083340138410766.png\"},\"ryxz2z6xq4T1718548965820\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次海灯节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"syjrp1p1nudT1718549013990\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e总感觉今年的海灯节格外隆重呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e之前我还在打算提前屯一批霄灯的材料，然后等海灯节的时候再以稍贵的价格售卖来着。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果等我想要购入时才发现，凝光大人不久之前修订了律法，严禁高价倒卖霄灯的材料。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真不愧是凝光大人啊，这样的商业眼光实在是自愧不如。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如今我手边就剩下做一盏霄灯的材料了，反正也卖不了什么钱了，就送给一柱和一弦他们吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e希望，他们能过一个温暖的海灯节。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"v5fb1s2m1xT1718548712743\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见！多照顾生意呀！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"yl9wb8oaqgcT1718549051591\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次海灯节（2022）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你是…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，我叫长顺，职业是经商，也是「璃月商贸学」的研究者。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e请问您需要什么吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1718553799","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":