ent_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1a0peqisozwT1754542843549\":[\"egsyx60ni2T1754542908481\"],\"4cf2vhylew3T1710863944349\":[\"egsyx60ni2T1754542908481\"],\"6oq7qb3i5zkT1754542490423\":[\"egsyx60ni2T1754542908481\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"6oq7qb3i5zkT1754542490423\"],\"egsyx60ni2T1754542908481\":[],\"nqb471m7nmnT1710863941173\":[\"egsyx60ni2T1754542908481\"],\"z2tn3pzsbujT1710863943430\":[\"1a0peqisozwT1754542843549\"]},\"contents\":{\"1a0peqisozwT1754542843549\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e倒也不算不愉快，只是和他说话会比较费劲。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他总是说我的肌肉还没有他的脑子大，但其实他说反了，是他的脑子没有我的肌肉大才对，毕竟他连度假村的宣传语都能说反。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你们之间不太愉快？】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你们来的路上没有见过吗？就是那种走路摇摆的可爱小东西。大家都说，它们是悠悠度假村夏天的象征。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e据说，阿夏两个字在本地还有其它含义，很可惜，我对那些也不是很了解。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【阿夏是什么？】\"},\"6oq7qb3i5zkT1754542490423\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e悠悠纳塔，悠悠夏天！欢迎来到「阿夏的宝库」纪念品商店。小店售卖各种趣味玩具与纪念品。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"egsyx60ni2T1754542908481\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请看。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/07/80663279/37fcf7ec854b07b982dadbb4bdaa043d_4053156342129729269.png\",\"option\":\"【让我看看你的货。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e每家店都很有特色，用餐可以去「鱼群之家」餐厅，品尝酒水可以去提提岛的醅蜜和尝露酒吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果一定要选一个没必要去的，我选「膨胀胸甲」商店吧，那家店主是我的叔叔，我很了解他。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【附近还有什么值得一去的店吗？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","wit