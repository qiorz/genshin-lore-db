-entry-link=\\\"无\\\"\u003e\\n    \u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\\n      \u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/83684823/a10de9888d18e13bc20f71e6de065932_8836801196295403500.png\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e库特罗\u003c/span\u003e\\n      \\n    \u003c/a\u003e\\n  \u003c/span\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e在野外发现了不知作何用途的建筑…\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e探索神秘建筑\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与被困的人对话\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e操作迁能终端打开牢笼\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与奎瑟尔对话\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e和派蒙合作打开牢笼\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e向前探索\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e关闭所有阀门\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e开启通路\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败发条机关\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e乘坐升降机继续深入\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索 \u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败发条机关\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space