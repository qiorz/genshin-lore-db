_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/83684823/0087d34a3e4332bc294fc6925430ae06_5866625510609040598.png\"},{\"tab_name\":\"任务结束位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/83684823/5b83ca145cfd29dd0ac6fb4657891356_2078695803520245084.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e探索神秘建筑\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e在野外发现了不知作何用途的建筑…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：…这、这样不好吧？我说，要不还是别…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：你这一事无成的软蛋，什么时候轮到你对我指手画脚了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：可是我…我是说我们…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：闭嘴吧，白痴!我真恨透你了，你这没用的东西，只配在这儿独自腐烂…懂吗？腐烂！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：听起来好像是两个人在吵架欸，不知道发生了什么…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：好、好心的小姐，帮帮我…拜托了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与被困的人对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：两、两位是来应募研究助手的吗？抱、抱歉，我现在有些脱不开身…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e看出来了。/只是随便进来看看。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：参、参观吗？当、当然也是很欢迎的。（此句仅在选择第二个选项出现）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：先别管这些了，你怎么被关在笼子里了呀？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e奎瑟尔：和研究伙伴有些意见分歧…库特罗…他让我在这里冷静一下。对、对了，还没有自我介绍，两位就叫我…叫我奎瑟尔好了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e奎瑟尔：呃，就是…就是奎瑟尔的发条工坊，那个奎瑟尔。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：我是派蒙，他是旅行者…说起来刚才的确听到吵架的声音，原来那个听起来很凶的家伙是你的研究伙伴啊。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e要不换个伙伴吧。/那你继续冷静吧，不打扰了。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：就是！好的伙伴应该像我一样…旅行者能有我这样的伙伴，真是个走运的家伙呀。/喂！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e奎瑟尔：能、能不能麻烦两位，放我出来。如果能激活旁边的储能装置，应、应该就能把门打开了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e奎瑟尔：拜、拜托了！之前来应募研究助手的人也因为受不了他的暴脾气，很快就离开了，这里现在只有我们…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：唔，既然是这样，旅行者，我们就帮帮他吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e操作迁能终端打开牢笼\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与奎瑟尔对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：门已经打开了，你不出来吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：其、其实还有件难以启齿的事…如果我现在走出牢笼，恐、恐怕这里会爆炸。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：爆炸？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：是、是的…之前也说了，研究伙伴他是个…暴脾气，所以在牢笼下加装了特殊的触发装置。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：欸？！那现在该怎么办？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e用其他重物替代一下行吗？/没辙了，我们去枫丹廷找人帮你。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：普、普通的重物恐怕不行…中间的原理很复杂，呃…/普、普通的重物恐怕不行…中间的原理很复杂，呃…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：好心的旅行者先生，如果能暂时代替我…在笼中稍候。我、我可以去解除这个特殊的触发装置。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：毕、毕竟是多年共同研究的伙伴，他的心里想些什么，我一清二楚。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e我的重量应该不够，要不派蒙也…/感觉有点可疑…\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：可、可是你看我都是浮在空中的，肯定根本没有重量！嗯，没有重量！（此句仅在选择第一个选项出现）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：呃…这个触发装置非常特殊，并不单纯是通过重量判断的。（此句仅在选择第一个选项出现）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：请相信我，只要替我一小会儿，我会很快解除触发装置回来的。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：…或许你知道枫丹科学院，或者听过雷蒙多先生和博絮埃先生的名字？我、我也曾经受到他们的指导。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：这、这类技术问题，不难，不会花费很多时间的。只要一小会儿就好…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：唔…那好吧。不过你要快点哦！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e小心翼翼地和奎瑟尔交换了位置…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：欸？门怎么又关上了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：呃，可、可能是出了什么故障。我、我去排查一下…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：不祥的预感。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：别、别担心，我会尽快处理的。解除触发装置的终端不在这里，我暂时离开一下，稍等。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：看来我们只好耐心等待了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e等待了一段时间…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：他怎么去这么久…该不会是出了什么意外吧？不过他之前说了，这里现在只有他和研究伙伴…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e说不定他又被关进别的笼子里了…/我们应该是上当了。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：欸——/你是说他骗了我们？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：我过去常想，「善良」真的能被称为美好的品质吗？徒有善良的人…善良对他的人生又有什么益处呢。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：…欸？是谁在说话？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e？？？：这里根本没有什么会引发爆炸的触发装置，但牢笼的门的确被锁上了。两位，你们会怎么选？是继续等待，还是行动起来…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：这人在说些什么呀！而且总觉得他的声音听起来…有点像奎瑟尔，又有点像之前跟他吵架的人，怎么回事？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：先想办法让我出去…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：对哦！可是…可是你被关在笼子里，该怎么打开被锁上的门呢…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：全靠你了，派蒙，救救我！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：呜哇，怎么会这样！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：不过幸好我没有和你一起被关进笼子…唔，按照和刚才一样的方法应该可以把门打开吧？就让我试一试好了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e和派蒙合作打开牢笼\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：仔细看看，这里有两个终端和两个储能装置。如果能激活门边的储能装置，应该就可以打开牢笼的门了吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：那我该去哪边呢？门那边的终端，还是牢笼边的？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e去门那边的终端看看。/\u003c/u\u003e\u003c/span\u003e\u003cspan style=\\\"color:rgba(255,0,0,1)\\\"\u003e\u003cu\u003e试试牢笼边的终端。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e（此部分对话会将正确选项标红，接下来的对话将会以正确流程进行）\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：试试牢笼边的终端。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：让我瞧瞧…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：从这里可以看到奎瑟尔离开的门呢，那接下来该怎么办呢？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e激活牢笼边的储能装置。/\u003c/u\u003e\u003c/span\u003e\u003cspan style=\\\"color:rgba(255,0,0,1)\\\"\u003e\u003cu\u003e激活门边的储能装置。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：好喔。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：门上的端末亮起来了！从那边应该能看到不同的画面吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：从这边可以看到比较大的门！接下来该怎么办呢？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e回到对面端末的视角。/\u003c/u\u003e\u003c/span\u003e\u003cspan style=\\\"color:rgba(255,0,0,1)\\\"\u003e\u003cu\u003e激活牢笼边的储能装置。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：交给我吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：成功啦！怎么样？我也是可以帮上忙的，对吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：话说回来，奎瑟尔那家伙到底是怎么回事？真搞不懂…我们往他离开的方向找找看吧，说不定能发现什么。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：里面看起来好深，不知道这条路通向哪里…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：没想到里面还有这么大的空间，不过这里怎么看也不像什么发条工坊呀，好怪！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e善意的提示\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e关闭所有阀门即可激活终端，开启通路。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e关闭所有阀门\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e开启通路\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败发条机关\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e乘坐升降机继续深入\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败发条机关\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e设法打开封闭的门\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e开启通路\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败发条机关\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e乘坐升降机继续深入\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e继续向前探索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与奎瑟尔对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：奎瑟尔！找到你了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：那旁边的…肯定就是奎瑟尔说的坏蛋研究伙伴库特罗了吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：…什么？我叫布里科勒，他才是库特罗。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：欸？他不是奎瑟尔吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：奎瑟尔…只是一个方便的角色。两位突破了重重考验，我想现在没有必要对两位隐瞒了，我叫库特罗，是这座工坊真正的主人。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：哈，两位真是…作为素材来说再好不过了，如果两位愿意协助我的研究…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：什么研究，说来听听。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：不会吧？！难道你真要协助这种可疑的家伙？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：这里看起来一点也不像什么正规的工坊呀！而且你又是骗人又是让发条机关攻击我们…根本就是危险分子！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：对！你们可千万别上当了！他…他是个穷凶极恶的歹徒！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：我在调查时顺着线索找到了这里，没想到你在被除名之后仍在继续危险的研究，甚至还为此盗窃了枫丹科学院的资产…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：你已经犯罪了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：真多嘴啊，布里科勒，明明只是个不堪一用的庸才…等我评估完两位贵宾的真正价值之后再来料理你。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：两位贵宾…该不会是指我们吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：当然。距离两位证明自己真正的价值，还差最后一场考验…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：让我亲眼见识一下两位的本领吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败库特罗\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：还是你们…技高一筹。是我见过的所有素材里最好的！但也远非我能驾驭的…是我输了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：这人真是莫名其妙！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：莫名其妙就对了，他之前就是因为做了一些…呃，做了一些「莫名其妙」的研究，才被枫丹科学院除名的。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：那不是什么莫名其妙的研究…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：是啊，当初你和伦理委员会的人也是这么说的，你看有人信你吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：所以到底是什么研究？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：咳，如果您希望获取这方面的信息，可以自行前往新枫丹科学院办理相关的合规手续。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：听起来就好麻烦…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：这事真难办啊，虽然他已经被除名了，可我调查的资材失窃案又和他有关…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e库特罗：哈，这次要把我送去梅洛彼得堡吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：这不由我决定，而是由法律决定。很遗憾，这次可不会像上次那样只是简单的除名就能了事了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：不管怎么说，感谢两位的协助，如果只有我一个人恐怕没法制服他…之后的事就交给我吧，我保证，这次他会受到应有的惩罚。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e布里科勒：唉，之后我恐怕还得回到这里继续善后工作，这么多资产，得写多少报告啊…\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1702959539","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道i