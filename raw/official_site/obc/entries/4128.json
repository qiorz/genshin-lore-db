at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"7jwneaqglqcT1746693128762\":[\"yhf4qi39gz9T1746693130065\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"qwkfzmmy78T1746693230895\"],\"ab0ughq5fr8T1746693196603\":[\"esz2rwgyce6T1746693206501\"],\"esz2rwgyce6T1746693206501\":[],\"nqb471m7nmnT1710863941173\":[\"7jwneaqglqcT1746693128762\"],\"qwkfzmmy78T1746693230895\":[],\"yhf4qi39gz9T1746693130065\":[],\"z2tn3pzsbujT1710863943430\":[\"ab0ughq5fr8T1746693196603\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好，周围一切正常。如果要出去冒险的话，记得叫上我啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，埃洛伊。】——【白天】\"},\"7jwneaqglqcT1746693128762\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不不不，没有哪里不对，这里的一切都棒极了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只不过，我比较习惯露宿荒野。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你知道的，我的故乡几乎每天都会发生点事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e比如到处乱跑的机械巨兽、总是对人抱着敌意的奇怪部落，还有想要毁灭一切的超级机械怪物...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e习惯了那种生活之后，突然一下子变得这么安稳…我还是需要点时间来适应。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有哪里不对吗？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊，旅行者，跟着你还真是能见识到不少新奇的事物。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e赛伦斯一定会被这盏不可思议的…呃...茶壶吓到的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"ab0ughq5fr8T1746693196603\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，这确实很重要。如果饿着肚子去拯救世界，未免也太难了…世界毁灭这件事要全神贯注地应对才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【比如先吃饱喝足？】\"},\"esz2rwgyce6T1746693206501\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…也不全是。如果你真有一天不得不去拯救世界的话，有些重要的事，你只能自己去搞定。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…但说真的，拯救世界这活可是很累人的。你有时候都不能分清到底谁是真正想要毁灭世界的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e而且在某些情况下，某些想毁灭世界的家伙甚至会反过来理直气壮地指责你，真不知道是哪里来的底气…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e要我说，对付这种家伙的唯一方法，就是战斗。除此之外没有别的办法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【比如人多力量大？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果你是问我住得舒不舒服的话…那当然很舒服了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是要说习不习惯…抱歉啦，总是呆在这，多少还是有些不适应。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"qwkfzmmy78T1746693230895\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，这周围静悄悄的，什么动静都没有…我还真有点不太习惯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【晚安，埃洛伊。】——【夜晚】\"},\"yhf4qi39gz9T1746693130065\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那再好不过了！虽然这里的环境很不错，但我还是想多出去转转。老是待在这，我的弓弦都要松了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这次出去，你可得好好和我说一下那种叫做「遗迹守卫」的家伙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我觉得，我应该很擅长对付那种家伙，毕竟它身上也有个会发光的点。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e而且打倒了它之后，也可以从它身上拆下来零件…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然那种零件怪模怪样的，没办法拿来改造我的弓箭…但你拿着应该有用，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是想出去冒险吗？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那当然了，你又有什么新奇的事情要告诉我吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在来到这个世界之后，我可是听说了很多和你有关的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e比如…你帮助蒙德城的西风骑士们打倒了一只巨龙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在璃月港和仙人们一起击退了海中的魔神。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e魔神…还有巨龙，都是些我原来想都想不到的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但无论面对什么样的危机，你总会挺身而出，和其他人一起并肩作战，对吧?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就是因为有你这样勇敢的人在，那两座城市才能安然度过危机。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【我只不过是帮了点小忙...】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那都算是「小忙」的话，那所谓的「大忙」就只有拯救世界了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，如果你有一天真要拯救世界的话，记得叫上我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我已经拯救过一次世界了，多少能告诉你点拯救世界的小窍门。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【星辰与深渊之旅好感套装赠礼对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不错的驻扎点，搭建它的冒险家们肯定有着丰富的经验。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e两个帐篷能相互照应，围栏的布置则考虑到了各个方向的潜在威胁。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e与可靠的伙伴同行，真是件令人宽心的事啊。\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【狩猎与歌舞之营好感套装赠礼对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这片营地很特别，虽然房屋和陈设都很简陋，但细看就能发现，营地的规划遵循着某种「法则」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e秩序井然的部落，给我一种熟悉…却独特的感觉。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在这里生活一段时间，我也许能得到意料之外的收获。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"7415","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1209","without_border":false,"can_delete":false,"is_hi