e,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"z4og73wnfyT1768490972722\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[],\"z4og73wnfyT1768490972722\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【关于你的商品…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这并非商品，我也并非货商，我等的「杜麦尼」\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;希望\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些角菌乃是米克特兰\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;烟谜主\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e传承千年的奇物。纺秘的女主人将研磨的技艺授予我等的列祖，如无数典仪那般。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只需依循特定的步骤研磨，这些草药的微光便足以拟造出接近燃素的涂鸦纹，抵御如潮的漆黑。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e涅法海姆\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;挪德卡莱\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e人用提灯驱散黑夜，我们用微光抵御黑潮，两者没有区别。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e莫要小看这些角菌，异邦人。正如你们的灯火能驱散黑夜，用这些角菌研磨出的颜料，同样能抵御黑灾的侵扰…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我看看你在卖什么。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请便。尽管我并非货商，夜风仍曾低语过你的名。我等的「杜麦尼」\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;希望\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e，若是你愿以物易物，那便请上前来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/11ee64c710e3b091256c0d349ac55461_7356914609207729183.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你是…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我名为科菲策，米克特兰\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;烟谜主\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e的祷告者，受大灵指引，为指引涅法海姆\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;挪德卡莱\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e的异邦勇士而来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然而，那名唤莱沃蒂的守卫却将我称作行商，命我只得在此「做生意」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e智慧的言语岂能说给愚昧的人听呢？无妨，夜风终将让他们知晓我所传授的秘谕…这也是过去来自大灵的启示。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z4og73wnfyT1768490972722\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e夜风会指引我们再度相见，我等的「杜麦尼」\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;希望\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1773981959","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub