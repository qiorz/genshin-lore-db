ki-user-upload/2024/05/07/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_3885544407949729693.JPG\\\" data-entry-name=\\\"伊达的挑战状\\\" data-entry-link=\\\"/ys/obc/content/3431/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/3431/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e伊达的挑战状\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【拿到最后一个令牌再对话】\",\"dialogue\":\"\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那边的迷宫也通关了吗?不错不错。你们赢得了我的认可。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，哦...\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么评价吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e评价？这个嘛....\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，是不是觉得非常精妙非常厉害?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸...欸嘿!\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「欸嘿」是什么意思啊!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳。既然你们已经收集了两枚认可状，密室的通道应该就打开了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e把认可状放进去就可以打开宝库门了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"a4v5p0z5luT1724563543875\":{\"option\":\"【结束再对话】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e其实迷宫终究只是手段，不是目的。像是阿倍良久大人那样福泽万民才是我想做的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【不必，已经品鉴过多了。】\",\"dialogue\":\"\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e别、别这样啊。这件迷宫杰作，是在空间和时间、资金都充裕的情况下做出来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e因为已经有一部分人去海面海衹岛生活了,所以地下的土地挺富余的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我特地借来了《白夜国水文考》，研究了承重和地下空间的最大利用，避开了可能的渗水问题甚至还兼顾了风水!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然对不起绘真，书不小心被我落在奖励密室里了..\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你在小声说什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没什么!我隆重邀请您挑战我的迷宫杰作。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e总之先收下这个钥匙吧。用它可以开启谜题。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e挑战成功还能拿到我亲自制作的认可状纪念章哦。\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e并不是那么稀罕就是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我的宝藏也藏在前面的密室里了!拿到两个认可状就可以打开宝库哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这、这样啊。有空有心情的话我们会去试试的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好的呀。期待你们的反馈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，对了，既然你们通关了第一处迷宫，应该已经拿到第一枚认可状了吧!\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，哦...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么反馈吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么说呢。感觉...\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e感觉？\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e感觉缺少一点「噼咔」的感觉。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「噼咔」，「噼咔」又是什么感觉?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【结束再对话】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么样，挑战过我的反本格派迷宫了吗?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693689","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_g