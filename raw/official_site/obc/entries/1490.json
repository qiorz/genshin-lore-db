ata-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（言笑的喧闹厨房）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":null,\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"hfjrkn2a7mnT1719469542223\":[],\"nqb471m7nmnT1710863941173\":[\"hfjrkn2a7mnT1719469542223\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，谢谢你的祝福，咳咳。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【祝你健康。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳，旅行者你好…咳咳，不好意思，我得了重病，有些止不住咳嗽…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"hfjrkn2a7mnT1719469542223\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对了，我的身体如今已经不需要这么多药草了…我现在需要的只是丈夫的陪伴而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你的倾听，若是不嫌弃就请收下这些吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"751\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/13/24077343/825512faec7fc2631632d82305ef0edf_9103005364725117347.png\\\" data-entry-name=\\\"清心\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/751/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/751/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/13/24077343/825512faec7fc2631632d82305ef0edf_9103005364725117347.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e清心\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/27/76362111/b26706122e54335e75a99308e473cc62_6372836874104485450.png\",\"option\":\"【你们还真是辛苦啊…】——获得清心*4\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，真的吗…这么容易被看穿的话就糟糕了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…我告诉你实情吧，你可千万别和我丈夫说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我丈夫是位水手，常年在海上漂泊难以相见…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可自从我生病之后，我的丈夫便辞去了水手的工作专心照顾我，甚至亲自来山里采药。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样的日子虽然清贫，却也快乐。可想到一旦我痊愈的话，就会失去这种生活…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我不能接受，至少还没有勇气去面对，所以一直瞒着他我已经痊愈了的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，我还真是个自私的女人…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【感觉你的气色还不错…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"op