y-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/15/4521515/a567128256a0138d96fb4f7b05934da5_7836516109303481072.png\\\" data-entry-name=\\\"叮铃哐啷大作战\\\" data-entry-link=\\\"/ys/obc/content/506592/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506592/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e叮铃哐啷大作战\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506548\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/14/83684823/014862bf51adbde002dc3b7b3b5349f0_6715267627133358347.png\\\" data-entry-name=\\\"叮铃哐啷大作战·危机「铛铛铛，大危机！」\\\" data-entry-link=\\\"/ys/obc/content/506548/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506548/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e叮铃哐啷大作战·危机「铛铛铛，大危机！」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真倒霉啊，挪德卡莱的债务真是太难缠了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，你是不知道啊，朋友。这鬼地方的水深得很，表面上风平浪静，底下全是暗流。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e上次讨债惹到了灰河的黑帮，差点把命搭进去。上上次讨债，到最后发现罩着那家伙的其实是我的顶头上司…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说我一个没背景没靠山的年轻人，怎么就被派到这种地方来了呢？真要出了什么事，讨债的薪水说不定还不够我的医药费。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，我现在就想早点回海屑镇养驯鹿，至少驯鹿不会突然变成愚人众的执行官把我痛骂一顿…大概吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【怎么了？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢，但愿吧。唉，你也多加小心呀。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【祝你好运。】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e年轻且没经验的债务处理人\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e胆子很小\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有订购特制武器的意向\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e正在攒钱,进度颇慢\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":fa