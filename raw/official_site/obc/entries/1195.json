\":[\"nqb471m7nmnT1710863941173\"],\"cr3qb3haaxuT1757950832319\":[\"jqlv3q1krzeT1757950915891\"],\"dimebqf0qvaT1757950833005\":[\"jqlv3q1krzeT1757950915891\"],\"jqlv3q1krzeT1757950915891\":[\"tzk00782lgbT1757950934669\"],\"mx1lkb5pfxnT1757950945396\":[\"xl00oo3ngykT1757950975954\"],\"nqb471m7nmnT1710863941173\":[\"cr3qb3haaxuT1757950832319\",\"dimebqf0qvaT1757950833005\",\"69eu8wszeuoT1757950869397\",\"yobolykailT1757950885936\"],\"tzk00782lgbT1757950934669\":[\"mx1lkb5pfxnT1757950945396\",\"wla2jmed7uT1757950946721\",\"2uwmrl9nhj3T1757950947621\"],\"wla2jmed7uT1757950946721\":[\"xl00oo3ngykT1757950975954\"],\"xl00oo3ngykT1757950975954\":[],\"yobolykailT1757950885936\":[\"jqlv3q1krzeT1757950915891\"]},\"contents\":{\"2uwmrl9nhj3T1757950947621\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，再见。祝你今后的冒险一切顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"69eu8wszeuoT1757950869397\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，协会成员一般都是四个人组成冒险团来行动的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦——你好像也有不少伙伴呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e曾经我也在一个不错的冒险团…可惜碰巧遇到「倒霉鬼班尼特」也在团里…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一开始大家还以为他的倒霉只是谣传，可没想到…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他接过的委托，真的会以各种离奇的方式失败…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在回想起来，也觉得真是奇怪呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【冒险团？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"cr3qb3haaxuT1757950832319\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e老实讲一开始真是担心得不行啊，不过其实除了担心之外还有一点兴奋。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这是我第一次见到龙，一想到以后说不定要和这么厉害的大家伙交手就热血沸腾啊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果我能完成这种级别的委托，那一定能让我在整个冒险家协会一举成名的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过，我现在还只能接一些例如清理史莱姆的委托，距离狩猎巨龙好像还挺远的，我还得继续努力了，唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务序章第三幕「巨龙与自由之歌」后\"},\"dimebqf0qvaT1757950833005\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，我叫杰克，直接叫我名字就好，大家都是伙伴，千万不要客气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我刚加入冒险家协会几个月，一直承蒙协会里前辈们的照顾。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e尤其是前辈们讲的那些冒险故事，真是太——酷了！让人热血沸腾，你不觉得吗！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊哈哈…至于我的话，只完成过一些「清理掉入侵下水道的史莱姆」之类的委托而已…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，什么时候才能像前辈们那么威风呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己。】\"},\"jqlv3q1krzeT1757950915891\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"mx1lkb5pfxnT1757950945396\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很多吗？我数数…8杯啤酒…5杯葡萄酒…7杯苹果酒，也就这些吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这点还差得远啊，那些传说中的蒙德冒险家，据说能喝下半个果酒湖那么多的酒…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只是传说？嗯…原来是这样吗…怪不得，我一直想不通他们买酒的钱是哪里来的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好像喝了很多啊？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好！你也是新人冒险家吗？要不要来我的冒险团？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"tzk00782lgbT1757950934669\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好！我在锻炼身为冒险家的酒量…你要不要一起？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"wla2jmed7uT1757950946721\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的话…啤酒吧，倒不是说特别喜欢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只是像我这样的贫穷冒险家，似乎没什么太多选择…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e能喝个痛快的就是好酒，你不觉得吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你喜欢什么酒？】\"},\"xl00oo3ngykT1757950975954\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"yobolykailT1757950885936\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e向着星辰与深渊！祝你的冒险有幸运常伴，朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1757956137","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"