u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/22/78524498/6ee632dc08f8146408597e4b9001fa98_9070755950466730460.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"100\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/22/78524498/6ee632dc08f8146408597e4b9001fa98_9070755950466730460.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*100\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"8000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*8000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"820\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/1145c4b5ac9012f7a30f0b7e480e5b95_3312028965203811771.png\\\" data-entry-name=\\\"「自由」的指引\\\" data-entry-link=\\\"/ys/obc/content/820/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/820/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/1145c4b5ac9012f7a30f0b7e480e5b95_3312028965203811771.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「自由」的指引\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"2838","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1370","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务触发点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/04/317305234/7a5692a7c504dd9ac27af4f1b5e5fef0_5359069045615817595.jpg\"},{\"tab_name\":\"任务结束点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/04/317305234/7a5692a7c504dd9ac27af4f1b5e5fef0_1950684431641631614.jpg\"}]}\n","style":""}],"id":"2837","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1371","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e塞琉斯：唉，风魔龙怎么就被击败了，我们还没有正式登场呢⋯\u003c/p\u003e\u003cp\u003e旅行者：怎么了？\u003c/p\u003e\u003cp\u003e塞琉斯：哦，是荣誉骑士啊。风暴停了，风魔龙也被击败了。\u003c/p\u003e\u003cp\u003e塞琉斯：虽然说是好事，但是⋯但是风魔龙就不能再坚持一下吗?\u003c/p\u003e\u003cp\u003e塞琉斯：我还想着，把周围的魔物都清理干净之后，就挑选精英冒险家组成「风魔龙讨伐队」，去讨伐风魔龙呢!\u003c/p\u003e\u003cp\u003e塞琉斯：结果我还在为找不到医师而发愁的时候，风魔龙就被击败了。\u003c/p\u003e\u003cp\u003e塞琉斯：这下子⋯我们又要去忙着给城里人找猫找狗，送餐打扫了⋯这下是彻底没机会了。\u003c/p\u003e\u003cp\u003e塞琉斯：唉，先不说这个了，在野外调查的冒险家们发回了信息，似乎低语森林附近还有魔物游荡。\u003c/p\u003e\u003cp\u003e塞琉斯：但是协会里的冒险家都散在野外，一时半会也回不来，我还要处理一些杂事。\u003c/p\u003e\u003cp\u003e塞琉斯：能拜托你去低语森林一趟，看看那里的情况吗?\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e旅行者：我知道了。/还有别的事⋯\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“我知道了。”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：那就交给你了，我接着在这里处理委托了⋯\u003c/p\u003e\u003cp\u003e塞琉斯：被风吹走的告示牌⋯被风吹走的花⋯走失的猫⋯唉⋯果然不出我所料⋯\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“还有别的事⋯”\u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e（选择此选项会放弃任务）\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：好吧，你先处理自的事去吧，我再想想办法，看谁能去清理了那群魔物。\u003c/p\u003e\u003cp\u003e塞琉斯：被风吹走的告示牌⋯被风吹走的花⋯走失的猫⋯唉⋯果然不出我所料⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(31, 31, 31)\\\"\u003e•\u003c/span\u003e前往可疑地点调查并消除威胁（0/3）\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e（南侧点位）\u003c/p\u003e\u003cp\u003e派蒙：好多火史莱姆桶！是那群魔物做的吗，太危险了，我们把这些都清理掉吧。\u003c/p\u003e\u003cp\u003e（中间点位）\u003c/p\u003e\u003cp\u003e派蒙：这是⋯哨塔，这群魔物，是准备以这里为营地吗？\u003c/p\u003e\u003cp\u003e（北侧点位）\u003c/p\u003e\u003cp\u003e派蒙：唔⋯这堆篝火，看着总觉得很不舒服，这群魔物到底是用它来做什么的呢⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(31, 31, 31)\\\"\u003e•\u003c/span\u003e击败来袭的魔物\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e派蒙：居然还有这么多怪物⋯我们清理掉的说不定也只是一小部分。\u003c/p\u003e\u003cp\u003e派蒙：还是把这件事告诉塞琉斯先生吧。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(31, 31, 31)\\\"\u003e•\u003c/span\u003e与塞琉斯对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：你们这么快就回来了，看来确实没什么大事⋯\u003c/p\u003e\u003cp\u003e旅行者：还有不少魔物在活跃。\u003c/p\u003e\u003cp\u003e塞琉斯：什么？还有魔物在游荡，数量比原来的还多了？\u003c/p\u003e\u003cp\u003e塞琉斯：奇怪，先前来攻击蒙德城的大部队都已经被击退了，为什么它们还在蒙德城附近游荡？\u003c/p\u003e\u003cp\u003e塞琉斯：难道它们还有什么计划⋯不行，我得把冒险家们都召集回来，重新发布委托，不能对这些魔物掉以轻心。\u003c/p\u003e\u003cp\u003e塞琉斯：对野外游荡的魔物进行秘密调查，这可是冒险家协会的专业范围⋯是时候展现冒险家协会的力量了！\u003c/p\u003e\u003cp\u003e塞琉斯：对了，这是给你的谢礼，收下吧。\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2836","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1372","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2835","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"1373","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1740113830","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"机不可失","repeated":true,"parent_group_id":"0"},{"module_group_id":"1199","layout":"l2r1","module":[{"id":"2841","pos":"left"},{"id":"2840","pos":"right"},{"id":"2839","pos":"left"},{"id":"2838","pos":"left"},{"id":"2837","pos":"right"},{"id":"2836","pos":"banner"},{"id":"2835","pos":"banner"}],"name":"时不再来","repeated":true,"parent_group_id":"771"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false