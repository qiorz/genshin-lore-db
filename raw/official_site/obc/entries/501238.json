miyoushe.com/upload/2024/04/25/75276539/e68e327b89598c1d1827285a4f5d9de2_1001926890449977103.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2024/04/25/75276539/e68e327b89598c1d1827285a4f5d9de2_1001926890449977103.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓参与条件〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(173, 114, 14)\\\"\u003e冒险等阶≥28级\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(173, 114, 14)\\\"\u003e且完成魔神任务「送仙」\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e〓活动说明〓\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(17, 17, 17)\\\"\u003e● 「振晶的应用研究」活动的前六天 ，每天会开启一个新的挑战。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(17, 17, 17)\\\"\u003e● 在「振晶的应用研究」活动中，需要将角色编入2组队伍进行挑战。战斗开始前，可以为两支队伍配置振晶映射方案，组合响振晶与应振晶，以获得不同的战斗增益效果。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(17, 17, 17)\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e 每个响振晶只能映射一个应振晶。而每个应振晶则最多可响应3个响振晶。战斗中，若通过不同的响振晶条件触发应振晶效果，效果会有一定提升。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(17, 17, 17)\\\"\u003e●\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e 在战斗的过程中，需要在时限内击败不断出现的敌人以获得积分。挑战结束时，依据挑战中获得的积分，可以获得不同的纹章。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/topicDetail/997\\\" target=\\\"_blank\\\" class=\\\"mhy-router-link mhy-topic-label__link\\\"\u003e振晶的应用研究\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1312","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"流程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1313","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"玩法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e关卡一：气体流向的偏转\u003c/p\u003e\u003cp\u003e角色对敌人触发扩散反应后的6秒内，队伍中所有角色的风元素攻击的暴击率提升20%。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/abffffdc6b2494e6eb30efc193025e94_7503740921638005384.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/abffffdc6b2494e6eb30efc193025e94_7503740921638005384.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e关卡二：丛植激发的研究\u003c/p\u003e\u003cp\u003e角色对敌人触发原激化、蔓激化与超激化反应后,将恢复4点元素能量,此效果每3秒至多触发一次。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/081a9aa9ca7b80dabaf289bc6924e377_6629212465195387687.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/081a9aa9ca7b80dabaf289bc6924e377_6629212465195387687.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e关卡三：生态波动的影响\u003c/p\u003e\u003cp\u003e角色的当前生命值提升或降低时,角色的暴击伤害提升40%,持续6秒。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/bbe07f5134f36e6049327177dff3ae6e_8399797432506848880.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/30/4521515/bbe07f5134f36e6049327177dff3ae6e_8399797432506848880.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e关卡四：创伤愈合的可能\u003c/p\u003e\u003cp\u003e角色受到治疗时,角色的暴击率提升20%,持续6秒。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/2c7b110bece91b4855443134781c6dfe_1409770997487931387.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/2c7b110bece91b4855443134781c6dfe_1409770997487931387.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e关卡五：光热效应的增幅\u003c/p\u003e\u003cp\u003e角色对敌人触发火元素相关反应后的6秒内,敌人的所有元素抗性降低30%。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/bfb259065b9e53c64b30560f019e1c88_6409021679828493254.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/bfb259065b9e53c64b30560f019e1c88_6409021679828493254.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e关卡六：共鸣震动的归因\u003c/p\u003e\u003cp\u003e角色对敌人触发结晶反应后的6秒内，敌人的所有元素抗性降低30%。\u003c/p\u003e\u003cp\u003e振晶效果：\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/f8c7b9b578dcb94bbfbdb1f0221c61ca_4381436427335156186.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"360\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 360px\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/06/4521515/f8c7b9b578dcb94bbfbdb1f0221c61ca_4381436427335156186.png\\\" style=\\\"width: 360px\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1314","is_customize_name":true,"is_abstract":false,"is_show_switch"