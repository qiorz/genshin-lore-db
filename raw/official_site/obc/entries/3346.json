e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成雷电将军传说任务 天下人之章第二幕「须臾百梦」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于将军大人…】——完成雷电将军传说任务 天下人之章第二幕「须臾百梦」前\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e将军大人的威名震慑四方，守护稻妻永恒的和平。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对于将军大人的任何决定，我都没有疑问。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就算锁国令解除了，来到稻妻的外国人也还是要遵守这里的规矩。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于将军大人…】——完成雷电将军传说任务 天下人之章第二幕「须臾百梦」后\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713718061","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute