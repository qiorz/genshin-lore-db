xrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"aawhft7eghcT1790766902001\":[],\"hg237ch5lT1787191501208\":[\"aawhft7eghcT1790766902001\"],\"khmys4v1adT1787191503397\":[\"aawhft7eghcT1790766902001\"],\"ltxu19hu327T1790766661586\":[\"aawhft7eghcT1790766902001\"],\"n2atcscjh7dT1787191703214\":[\"aawhft7eghcT1790766902001\"],\"nqb471m7nmnT1710863941173\":[\"hg237ch5lT1787191501208\",\"sc6w0r6yi9kT1787191502213\",\"khmys4v1adT1787191503397\"],\"sc6w0r6yi9kT1787191502213\":[\"n2atcscjh7dT1787191703214\",\"ltxu19hu327T1790766661586\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成任务「待访曙光」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"aawhft7eghcT1790766902001\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"hg237ch5lT1787191501208\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e行。您自己选选吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/20/178964736/661f4aed07b4e34115c0ea22f4b4b711_7557352195629542149.png\",\"option\":\"【我看看…】——打开商店界面\"},\"khmys4v1adT1787191503397\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。等待您的下次惠顾…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见…】\"},\"ltxu19hu327T1790766661586\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈…如果只是训斥就好了。我父亲可是连我做生意的本钱都收走了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过，他这么做倒也没错，谁叫我读书读晕了头，仗着书上的理论去做生意，然后被人坑了一笔…赔了个底朝天呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后还是父亲接手，把我的烂摊子处理好，也安抚好了各个合作方，为我保留了「最后一点做生意的本钱」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但父亲也和我说，如果我再想进生意场做商人，那就必须从零开始，累积真正的商业经验…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，我就按照他的安排，来这里摆摊了…但还没摆多久，车站这边好像又发生了什么危险的事情，一群人过来要我赶紧撤离。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然我的货物没什么损失，现在也能照常做生意，但、但是，难道我真的不适合做生意？老天都让我不得安宁…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…呃，算了算了，反正父亲不在这里，叹气就叹气吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是被家里人训斥了？】——完成魔神任务第七章第四幕「往冥府的安魂歌」后\"},\"n2atcscjh7dT1787191703214\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈…如果只是训斥就好了。我父亲可是连我做生意的本钱都收走了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过，他这么做倒也没错，谁叫我读书读晕了头，仗着书上的理论去做生意，然后被人坑了一笔…赔了个底朝天呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后还是父亲接手，把我的烂摊子处理好，也安抚好了各个合作方，为我保留了「最后一点做生意的本钱」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但父亲也和我说，如果我再想进生意场做商人，那就必须从零开始，累积真正的商业经验…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，我就按照他的安排，来这里摆摊了…但这样真的可以积累商业经验吗？不然我还是继续研究一下商业理论吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…呃，算了算了，反正父亲不在这里，叹气就叹气吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是被家里人训斥了？】——完成魔神任务第七章第四幕「往冥府的安魂歌」前\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临…您要点什么？反正我这里的货物都挺便宜的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"sc6w0r6yi9kT1787191502213\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一说起这个我就，唉…呃，不行不行，父亲说了不能在客户面前叹气…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你怎么说话有气无力的…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editi