lse,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【呆子？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e还能是谁，就是那个仓库管理员狗三儿呗！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大姐我早上辛辛苦苦做好了料理，看他一个人看仓库挺累的就给他分了点···\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他吃完，我问他好吃不好吃，结果他说食物只要有咸味和辣味就行了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e客官，你听听这是人话吗！亏大姐我好心给他吃的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不行！越想越气，我一定要好好调教一下他的料理观！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e刚出炉的中原杂碎，好吃得很！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e除了某个呆子外，没人说不好吃！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我想买些小吃。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e来，都是刚出炉的，热乎得很！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/288180982/11ee64c710e3b091256c0d349ac55461_3012054693537384847.png\"},\"pbgt4p3phdT1718552518437\":{\"option\":\"【内脏…？】——获得中原杂碎*4\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e放心吧，都是经过处理的，干净得很！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有些顾客啊，以前从来不吃内脏之类的，自从尝了一口之后就喜欢上了这个味道！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不你尝尝吧，不要钱的，觉得好吃就再来买些呀！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"325\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/dfc0680e7ee028d800eba47f9a3049a9_7801067075061464659.png\\\" data-entry-name=\\\"中原杂碎\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/325/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/325/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/dfc0680e7ee028d800eba47f9a3049a9_7801067075061464659.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e中原杂碎\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/288180982/b26706122e54335e75a99308e473cc62_7372779134010115714.png\"},\"t6phq92roplT1718552469468\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e下次喊上朋友再来呀，大姐给你优惠呀！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【杂碎…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您可别误会了，大姐我可不是在骂人呀！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这「中原杂碎」是我们吃虎岩的特色小吃。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e实际就是用动物内脏下水弄成肉泥，再加入吃虎鱼的鱼胶还有淀粉以及几种辅料做成的肉丸子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e油炸一下之后可好吃了，一点腥味儿都没有，香得很！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过总要跟外来人解释这个名字不是在骂人，麻烦得很！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"t6phq92roplT1718552469468\"],\"nqb471m7nmnT1710863941173\":[],\"pbgt4p3phdT1718552518437\":[],\"t6phq92roplT1718552469468\":[],\"z2tn3pzsbujT1710863943430\":[\"pbgt4p3phdT1718552518437\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1718553777","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"par