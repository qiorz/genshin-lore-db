"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e角色邀约：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1727\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/3ae97e9003fa03b8cba91bca587b16a2_3752263633396223296.png\\\" data-entry-name=\\\"邀约事件·芭芭拉 第一幕「治愈的清泉」\\\" data-entry-link=\\\"/ys/obc/content/1727/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1727/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e邀约事件·芭芭拉 第一幕「治愈的清泉」\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1qwbdrj31u6T1730955345683\":[\"5zp4rxqpqiT1730956138953\"],\"1yhg42bvz56T1730955358010\":[\"5zp4rxqpqiT1730956138953\"],\"4cf2vhylew3T1710863944349\":[\"v3m4is7u6t9T1730955843297\",\"fbgw6fvebwoT1730955845489\"],\"5zp4rxqpqiT1730956138953\":[\"bqi84o3yv4T1730956211873\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"1qwbdrj31u6T1730955345683\",\"1yhg42bvz56T1730955358010\"],\"9nh125euq4fT1730956447881\":[],\"bqi84o3yv4T1730956211873\":[\"xbt4b9q8xoT1730956237576\",\"r2eiyu127vmT1730956246169\"],\"fbgw6fvebwoT1730955845489\":[\"rwu50y678uT1730955927802\"],\"nqb471m7nmnT1710863941173\":[\"5zp4rxqpqiT1730956138953\"],\"r2eiyu127vmT1730956246169\":[\"9nh125euq4fT1730956447881\"],\"rwu50y678uT1730955927802\":[\"5zp4rxqpqiT1730956138953\"],\"v3m4is7u6t9T1730955843297\":[\"5zp4rxqpqiT1730956138953\"],\"xbt4b9q8xoT1730956237576\":[\"9nh125euq4fT1730956447881\"],\"z2tn3pzsbujT1710863943430\":[\"5zp4rxqpqiT1730956138953\"]},\"contents\":{\"1qwbdrj31u6T1730955345683\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你和瓦格纳师父说过话了吗？他很凶吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可打铁的事儿上，他可是难得的好师父，从那些武器上你就能看到他认真的一面。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我认可师父，师父也认可作为徒弟的我，这就够了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e其他的话…如果没我在，师父可能会寂寞吧，上次我回老家…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…还是算了，嘘…这话题可别让师父听到了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于师父。】\"},\"1yhg42bvz56T1730955358010\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，有需要的话就常来光顾吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这里的学徒，舒茨。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e师傅打铁的动作堪称完美，百看不厌呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e平时我一般都在铺子里给师父打杂，能有空这么观察师父的技巧，也算是种奖励了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你在干什么？】\"},\"5zp4rxqpqiT1730956138953\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一、二次风花节（2021、2023）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你要买武器吗？直接和瓦格纳师父说吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9nh125euq4fT1730956447881\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"bqi84o3yv4T1730956211873\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，看你的样子是冒险家吧？不趁着风花节添置些新的装备吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"fbgw6fvebwoT1730955845489\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e赫尔曼先生想送把剑给女儿，他念叨的时候我都听到了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e瓦格纳师父的剑他买不起的话，我想不如我来造一把送他。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也不算什么好心吧，反正我的手艺不值钱。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近有什么安排？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请从这些里挑选吧。这些都是师父打的，他的手艺绝对不会有残次品。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/07/178964736/11ee64c710e3b091256c0d349ac55461_3080636766755244221.png\",\"option\":\"【这里卖什么？】——打开商店界面\"},\"r2eiyu127vmT1730956246169\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，请好好享受风花节的气氛吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"rwu50y678uT1730955927802\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e还差些火候，虽然比起以前打的要好不少，可是还不够锋利。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e若是不嫌弃，这些剑你就拿走吧，拿来防身是够了，可是给赫尔曼先生的话…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…我还是希望能打造一把更好一些的剑，起码要对得起赫尔曼先生的心意才行啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/07/178964736/b26706122e54335e75a99308e473cc62_3759387639548661538.png\",\"option\":\"【剑打得如何了？】——获得银剑*3\"},\"v3m4is7u6t9T1730955843297\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我那些…一般都只能算是半成品，被师父拿去回炉重炼了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e倒是有一把还不错，可师父也不让我在店里卖，怕砸了他的招牌。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以有一天我去城的侧门那里试着挥了两下，随手插在那边了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在好像有群小孩子对它很感兴趣的样子…算了，不管了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你有自己的作品吗？】\"},\"xbt4b9q8xoT1730956237576\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然不少情侣都会选择前往誓言岬约会，不过也有一些勇敢的冒险家情侣会去风龙废墟附近。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e由于那里魔物环伺，不少冒险家出发前都会过来买些新装备…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…毕竟在那里被魔物打败的话，不但会在伴侣面前丢面子，更可能会让伴侣陷入险境之中…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以每到风花节，我们铁匠铺的生意都会变好不少，也算是托了节日的福了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于风花节与冒险家…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，这次骑士团突然增加不少订单，我担心师父一个人弄不完，就想努力帮帮他…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…结果我打的武器不但不够锋利，甚至有一把剑刚一挥就断了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e师父把我骂了一顿，说这样的残次品让别人用，不但会害了别人，同时也会砸了他的招牌。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后来我也醒悟了，师父说得对，有些事情心急只会有反作用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无论是我的剑还是我自己，都还需要不断锤炼啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第三幕「巨龙与自由之歌」后\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_s