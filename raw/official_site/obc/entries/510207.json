\u003e\"]}]}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"fxtg3qe3xfuT1757438312253\",\"child_ids\":{\"12gasj63ev7T1757438568958\":[\"1tzl5pa1gsbT1757438574021\"],\"1s9uxilwp55T1757438553965\":[],\"1tzl5pa1gsbT1757438574021\":[],\"2ncaj6vhy09T1757438746597\":[],\"3tu0syhnmwrT1757438552869\":[\"qz1t5ngsn1lT1757438625070\",\"ocxhxextspcT1757438626222\",\"ibwqw3a2xsT1757438627442\"],\"bt31siw6q4T1757438555267\":[],\"dyhjwwgsyhvT1757438839300\":[\"nff7vlokboT1757438864961\"],\"fsa06mvc0uqT1757438572789\":[\"1tzl5pa1gsbT1757438574021\"],\"fxtg3qe3xfuT1757438312253\":[\"t9dwuue4r98T1757438552397\",\"3tu0syhnmwrT1757438552869\",\"nx2fkiy8heT1757438553477\",\"1s9uxilwp55T1757438553965\",\"bt31siw6q4T1757438555267\"],\"ibwqw3a2xsT1757438627442\":[\"pe6rfjpywaT1757438710325\"],\"lflvdg6efe8T1757438808349\":[\"dyhjwwgsyhvT1757438839300\",\"ywhtuffxm8bT1757438840367\"],\"nff7vlokboT1757438864961\":[],\"nx2fkiy8heT1757438553477\":[\"o8cldx8rfjT1757438805590\",\"q7qfz0h6pmrT1757438807275\"],\"o8cldx8rfjT1757438805590\":[\"lflvdg6efe8T1757438808349\"],\"ocxhxextspcT1757438626222\":[\"pe6rfjpywaT1757438710325\"],\"pe6rfjpywaT1757438710325\":[\"2ncaj6vhy09T1757438746597\",\"wz1vb7cb6yT1757438749844\"],\"q7qfz0h6pmrT1757438807275\":[\"lflvdg6efe8T1757438808349\"],\"qz1t5ngsn1lT1757438625070\":[\"pe6rfjpywaT1757438710325\"],\"t9dwuue4r98T1757438552397\":[\"12gasj63ev7T1757438568958\",\"fsa06mvc0uqT1757438572789\"],\"wz1vb7cb6yT1757438749844\":[],\"ywhtuffxm8bT1757438840367\":[\"nff7vlokboT1757438864961\"]},\"contents\":{\"12gasj63ev7T1757438568958\":{\"icon\":\"\",\"option\":\"【原来只是「还行」的程度。】\",\"dialogue\":\"\"},\"1s9uxilwp55T1757438553965\":{\"icon\":\"\",\"option\":\"【早啊，迪卢克。】——【白天】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，一切顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果有需要我出面的场合，不用顾虑什么。叫我就行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"1tzl5pa1gsbT1757438574021\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，我并不是贬低这处家园。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e也没有想让你失望的意思。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想说的是…如果要适应在这边居住生活的话，对我而言需要一点时间。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望你不会介意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"2ncaj6vhy09T1757438746597\":{\"icon\":\"\",\"option\":\"【没关系。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我得反思一下自己了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你所感兴趣的闲聊话题，我也会找到的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"3tu0syhnmwrT1757438552869\":{\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cp\u003e只是闲聊吗…\u003c/p\u003e\"},\"bt31siw6q4T1757438555267\":{\"icon\":\"\",\"option\":\"【晚安，迪卢克。】——【夜晚】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没什么。你去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"dyhjwwgsyhvT1757438839300\":{\"icon\":\"\",\"option\":\"【感觉怪怪的。】\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\"},\"fsa06mvc0uqT1757438572789\":{\"icon\":\"\",\"option\":\"果然迪卢克的品位名不虚传…\",\"dialogue\":\"\"},\"fxtg3qe3xfuT1757438312253\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你来了，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，看你的状态似乎还不错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ibwqw3a2xsT1757438627442\":{\"icon\":\"\",\"option\":\"【最近还是在关心着「蒙德」的安全？】\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\"},\"lflvdg6efe8T1757438808349\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看你的表情，你是喜欢的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那就好。我根据你的口味进行过一些调整，看来方向没有错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e接下来还有一件事情要拜托你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这款饮料需要一个名字。既然配方改动过，原先的名字就已经不适合了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nff7vlokboT1757438864961\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…说得也是。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没关系，你可以慢慢想。如果忘了味道，我也可以再调制一杯给你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e随时随地。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nx2fkiy8heT1757438553477\":{\"icon\":\"\",\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，请尝一下这个。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e无酒精饮料，基底是祖上的配方。但我在调制的时候，也融入了一些自己的想法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"o8cldx8rfjT1757438805590\":{\"icon\":\"\",\"option\":\"【很清新的口感。】\",\"dialogue\":\"\"},\"ocxhxextspcT1757438626222\":{\"icon\":\"\",\"option\":\"【因为看你一直不太开心的样子？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我吗…？我并没有不开心。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在你身上花些时间，也是应该的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"pe6rfjpywaT1757438710325\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。你还是一如既往地敏锐啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e无论是人的暗中觊觎，还是非人集团的秘密谋划。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e威胁无孔不入，只要有机可乘。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这应该不是你想听的聊天内容。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"q7qfz0h6pmrT1757438807275\":{\"icon\":\"\",\"option\":\"【很浓烈的回味！】\",\"dialogue\":\"\"},\"qz1t5ngsn1lT1757438625070\":{\"icon\":\"\",\"option\":\"【忘记迪卢克不喜欢闲聊了…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不。不用那么在意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在你身上花些时间，也是应该的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"t9dwuue4r98T1757438552397\":{\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cp\u003e还行吧。\u003c/p\u003e\"},\"wz1vb7cb6yT1757438749844\":{\"icon\":\"\",\"option\":\"【知道你这样守护着蒙德，我就放心了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我会的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你所感兴趣的闲聊话题，我也会找到的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ywhtuffxm8bT1757438840367\":{\"icon\":\"\",\"option\":\"【我还是再想想…】\",\"dialogue\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/24077343/2436700f61dceefd5290b4e0a295224a_2829655195048432657.png\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":fal