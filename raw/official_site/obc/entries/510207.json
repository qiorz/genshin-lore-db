彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"jtz1ar34shT1757438312248\":[]},\"contents\":{},\"root_id\":\"jtz1ar34shT1757438312248\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8179","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"七圣召唤对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"qf6ah5w4czsT1757438312270\",\"child_ids\":{\"qf6ah5w4czsT1757438312270\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8180","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻想真境剧诗对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"lmr7s111binT1757438312274\",\"child_ids\":{\"lmr7s111binT1757438312274\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"tab_name\":\"近来可好？——2021-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e今年水果的品质普遍优于往年。想让你第一时间品尝这份美味，随信附上了亲手调制的苹果酿。\u003c/p\u003e\u003cp\u003e你的旅途是否顺利？在外漂泊，难免会出现意料之外的情况。随机应变的经验是其一，拥有能够帮上忙的助力则是其二。我观察过你处理的方式。可圈可点...足够让人放心。\u003c/p\u003e\u003cp\u003e你的身上有许多令人钦慕的优秀品质。你的凝聚力，对我来说也十分耀眼。近来，我时常以你为镜，思考自己的行为。这对我来说算是一种很新奇的体验，同时也很愉快。\u003c/p\u003e\u003cp\u003e我恐怕，也该以更努力的姿态前进。\u003c/p\u003e\u003cp\u003e我们的目标虽然不同，道路却互相交错。我会同你一起。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"89\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/4018f7ad3d102cbfbac7c28ded953d82_4254376637802654847.png\\\" data-entry-name=\\\"「蒙德往事」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「蒙德往事」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1137\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/07/24077343/6847f7cae34950020be4030a6c35042a_5253274843134334210.png\\\" data-entry-name=\\\"苹果酿\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/1137/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1137/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e苹果酿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/12d92d8e65fbabf13d97b44576233f6d_1755207993745336076.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/12d92d8e65fbabf13d97b44576233f6d_1755207993745336076.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/5833687\\\" target=\\\"_blank\\\"\u003e迪卢克生日快乐｜今天第一个来祝我生日快乐的人是你\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"晚餐…——2022-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e要不是机会正好，我恐怕无法想到这件事。\u003c/p\u003e\u003cp\u003e眼下落落莓正值最佳赏味时期，脆嫩饱满，入口香甜。\u003c/p\u003e\u003cp\u003e可惜，它只能成长在湿润多风的山地，难以人工培育。自然生长的数量又很有限，不足以纳入酿造业。\u003c/p\u003e\u003cp\u003e说回正题。我手边种种事情己经处理完毕，还算顺利，不知你近况如何？\u003c/p\u003e\u003cp\u003e如果有空闲，今天可以共进晚餐。\u003c/p\u003e\u003cp\u003e我想将采来的落落莓制成饮品和你分享。时机难得，奢侈些也无妨。\u003c/p\u003e\u003cp\u003e至于信中不方便说的，留待见面后再叙。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"747\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/13/24077343/170a22502513aa54c503781c794125a3_931485427912436904.png\\\" data-entry-name=\\\"落落莓\\\" data-entry-amount=\\\"10\\\" data-entry-link=\\\"/ys/obc/content/747/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/747/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e落落莓\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*10\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"89\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/4018f7ad3d102cbfbac7c28ded953d82_4254376637802654847.png\\\" data-entry-name=\\\"「蒙德往事」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「蒙德往事」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/306385fff3f702eac26d7959d3b72892_3407559710369670031.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/306385fff3f702eac26d7959d3b72892_3407559710369670031.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/21341873\\\" target=\\\"_blank\\\"\u003e迪卢克生日快乐｜对我而言，你的意见向来重要。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"新品…——2023-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e距上次联络已有些时日，希望你近来旅途顺利。\u003c/p\u003e\u003cp\u003e酒庄这边一切都好。此前从须弥运回了一批香辛料，我尝试用它们调制了几款新品，虽然初入口的口感有些新奇，但其层次丰富，我预计总体反响应当是不错的。\u003c/p\u003e\u003cp\u003e在它正式问世之前，不知你是否愿意先行品尝？要知道，你的建议总是能为我带来宝贵的帮助。\u003c/p\u003e\u003cp\u003e我会准备好与它相得益彰的餐点。晚上见。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"89\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/4018f7ad3d102cbfbac7c28ded953d82_4254376637802654847.png\\\" data-entry-name=\\\"「蒙德往事」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「蒙德往事」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4370\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/08/20/4820086/b78a44a7a7b2fa7726d3c52ab3b069e7_4981115585846116786.png\\\" data-entry-name=\\\"「巧思」的指引\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/4370/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/4370/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「巧思」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/76e4c09ff2d0bccaa008a9fa79e48ae2_454436511291406866.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/76e4c09ff2d0bccaa008a9fa79e48ae2_454436511291406866.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/38711539\\\" target=\\\"_blank\\\"\u003e迪卢克生日快乐｜趁时间还早，不如一起看看蒙德的日出吧。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"香氛…——2024-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e托你的福，美酒与炼金香氛的组合在市场上反响不错，不少酒客托人向我传达了他们的喜爱之情。但在我看来，真正应该收下这些褒奖的人是你。\u003c/p\u003e\u003cp\u003e若是遵照礼节，我原本应该尽早邀请你来酒庄共进晚宴，当面致谢，但挑选礼物花了不少时间。思来想去，还是亲手准备更为合适。\u003c/p\u003e\u003cp\u003e这款香氛是我在爱德琳指导下制作的，是我较为中意的一款香型。希望你也喜欢。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"743\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/13/24077343/a1d6993977f2d60680a0b0b3d8ae0ba5_4543240402672656005.png\\\" data-entry-name=\\\"小灯草\\\" data-entry-amount=\\\"10\\\" data-entry-link=\\\"/ys/obc/content/743/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/743/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e小灯草\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*10\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"89\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/4018f7ad3d102cbfbac7c28ded953d82_4254376637802654847.png\\\" data-entry-name=\\\"「蒙德往事」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「蒙德往事」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/23b484eeb0cf7b955318a5849333762f_1224865509422608723.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/23b484eeb0cf7b955318a5849333762f_1224865509422608723.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/52219168\\\" target=\\\"_blank\\\"\u003e迪卢克生日快乐｜这串葡萄你拿好，我们可以将它榨作葡萄汁。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"出门前夕…——2025-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e近来，我观察到花香风味的酒水饮品销量有所上涨，所用品种也不仅限于蒙德当地。\u003c/p\u003e\u003cp\u003e虽然进口对应的花种在酒庄培育也是策略之一，但我更想借此机会往别国走走，加以实地考察，从而做出最为合适的判断。\u003c/p\u003e\u003cp\u003e酒庄事务我已托付埃泽处理，蒙德有西风骑士团守护，恐怕也无需我置喙。\u003c/p\u003e\u003cp\u003e此行不会花费过多时间。\u003c/p\u003e\u003cp\u003e特此来信，以免你来访时走空。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"743\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/12/13/24077343/a1d6993977f2d60680a0b0b3d8ae0ba5_4543240402672656005.png\\\" data-entry-name=\\\"小灯草\\\" data-entry-amount=\\\"10\\\" data-entry-link=\\\"/ys/obc/content/743/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/743/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e小灯草\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*10\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"89\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/25/24077343/4018f7ad3d102cbfbac7c28ded953d82_4254376637802654847.png\\\" data-entry-name=\\\"「蒙德往事」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/89/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「蒙德往事」\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/fcdd752e5a3e85a60509e94d01b7e91d_3225857330134179719.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/50494840/fcdd752e5a3e85a60509e94d01b7e91d_3225857330134179719.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/64017764\\\" target=\\\"_blank\\\"\u003e迪卢克生日快乐｜每次扎头发总是要花一些时间，见谅。\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]},{\"tab_name\":\"聚会…——2026-04-30\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e远征队归来后，「天使的馈赠」也迎来了不少久别的顾客。据查尔斯所述，在他们热烈谈论的诸多远征见闻中，与你相关的逸闻总会毫无意外地成为话题的中心。有赖于此，本月葡萄酒的销量提升了许多。\u003c/p\u003e\u003cp\u003e我理应当面向你致谢才是。\u003c/p\u003e\u003cp\u003e不过，鉴于酒水消耗骤增，运输人力就稍显不足。我计划近日内往蒙德北部走一趟。\u003c/p\u003e\u003cp\u003e不知你可否去过风车镇？最近那里花开正盛，如果喜爱自然景致，作为假日的放松之选倒也不错。\u003c/p\u003e\u003cp\u003e若你有意，我们也可结伴同行。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508307\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/75610764/c568cbd94910d28e297c2dfce9e1351d_4930160117339493338.png\\\" data-entry-name=\\\"风息花\\\" data-entry-amount=\\\"10\\\" data-entry-link=\\\"/ys/obc/content/508307/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/508307/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entr