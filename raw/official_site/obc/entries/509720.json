"ebygiww13slT1787946307354\":[\"urfwtsvk9zT1787946325007\"],\"epb5u4uaq5wT1787944906452\":[\"yz3n717enoT1787945040611\"],\"ewllh0qqr0dT1711546416025\":[\"epb5u4uaq5wT1787944906452\",\"jx5nqio0rgT1787944910568\",\"dkqbwyexoT1787944911697\"],\"i7qz1najxqlT1787946362603\":[\"5mn1xo9eih5T1787946372593\"],\"jx5nqio0rgT1787944910568\":[\"yz3n717enoT1787945040611\"],\"m6h68ajoz7T1787946187298\":[\"3rm6g9hwt4nT1787946237145\"],\"nit454ekxgpT1787946171535\":[\"m6h68ajoz7T1787946187298\"],\"urfwtsvk9zT1787946325007\":[\"8ubefb4qwytT1787946361757\",\"i7qz1najxqlT1787946362603\"],\"ytyv1zsjxmrT1787946174301\":[\"m6h68ajoz7T1787946187298\"],\"yz3n717enoT1787945040611\":[\"nit454ekxgpT1787946171535\",\"ytyv1zsjxmrT1787946174301\"]},\"contents\":{\"3rm6g9hwt4nT1787946237145\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e奥黛塔：我顺手做的。主要是为了保障列车的通行安全。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：这么听起来，好像事情都搞定了呢，那你们现在是在…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：为这座餐厅举办最后的落成仪式！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：意思是，打扫。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：然后再…把这里想办法变成餐厅。沃雅妮莎大概是这个意思。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：哎呀，列车站旁边怎么能没有餐厅呢？「列车站美食」可是一种重要的美食种类啊。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：「列车站美食」…我只记得下车吃东西的时候，必须要时不时地看一眼列车动向，免得吃饱了肚子，却误了车…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：我一般不在车上吃。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：您谦虚了，亲爱的。您平时也不怎么吃。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：总而言之，我可不能浪费那一本好不容易买来的《列车站里的一百种美食》。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：平时没人吃我做的菜，现在可算有机会了，我绝对不会放过的！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：扫除他们的人…\"},\"56qbajisozcT1787946316924\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：一般用的食材是…\"},\"5mn1xo9eih5T1787946372593\":{\"dialogue\":\"\u003cp\u003e派蒙：嗯！我就…飞上去打扫一下屋顶好了。\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cem\u003e阿罗夏：桌椅应该都已经固定好了…嗯，很牢靠。\u003c/em\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e与奥黛塔和沃雅妮莎对话\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e奥黛塔：这边的桌布就由我来铺吧。\u003c/p\u003e\u003cp\u003e沃雅妮莎：你订好了？我还准备自己去设计呢。\u003c/p\u003e\u003cp\u003e奥黛塔：那样的话，餐厅的色彩就太…复杂了。\u003c/p\u003e\u003cp\u003e奥黛塔：旅行者，麻烦搭把手。\u003c/p\u003e\u003cp\u003e沃雅妮莎：嘿…哟！又贴好了一张，奥黛塔，阿罗夏，还有旅行者和派蒙，你们要不要来试试？\u003c/p\u003e\u003cp\u003e沃雅妮莎：在至冬堡里，可找不到这种可以随意贴贴纸的机会。\u003c/p\u003e\u003cp\u003e奥黛塔：但你之前经常在门票后面贴贴纸。\u003c/p\u003e\u003cp\u003e沃雅妮莎：是啊，总要给幸运观众一点惊喜吧，下次你也试试？\u003c/p\u003e\u003cp\u003e奥黛塔：幸运观众会被吓到的。\u003c/p\u003e\u003cp\u003e沃雅妮莎：嗯…这样就打理得差不多了，来吧，进行最后一项仪式！\u003c/p\u003e\u003cp\u003e沃雅妮莎：我记得…让他们把招牌放在车厢旁边…啊，确实在，大家都出来吧。我们一起把它挂上去。\u003c/p\u003e\u003cp\u003e派蒙：这上面画着的…\u003c/p\u003e\u003cp\u003e沃雅妮莎：这是我，这是奥黛塔，这是阿罗夏，这可是我亲手画的，折腾了好几个晚上呢。\u003c/p\u003e\u003cp\u003e派蒙：噗，大家都好可爱喔。\u003c/p\u003e\u003cp\u003e阿罗夏：哈哈…图加林看了肯定会很高兴的。\u003c/p\u003e\u003cp\u003e奥黛塔：不出意外的形象。\u003c/p\u003e\u003cp\u003e沃雅妮莎：不然下次我画成舞鞋？\u003c/p\u003e\u003cp\u003e奥黛塔：舞鞋不能进锅，如果下次我们要一起开鞋店的话，可以。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e在叽叽喳喳的闹腾声里，大家一起合力把招牌挂了上去…\u003c/p\u003e\u003cp\u003e沃雅妮莎：呼啊…这样就好了，果然又气派又好看。\u003c/p\u003e\u003cp\u003e阿罗夏：大家过来喝点饮料吧，刚刚做好的。\u003c/p\u003e\u003cp\u003e派蒙：哇！我看看，旅行者也拿一杯吧。\u003c/p\u003e\u003cp\u003e沃雅妮莎：看起来还有模有样的呢，过几天再找几位店员，我们的「曙光餐厅」就可以正式开业了。\u003c/p\u003e\u003cp\u003e沃雅妮莎：出于仪式感考虑，干脆给第一个来店里的客人免单吧。\u003c/p\u003e\u003cp\u003e沃雅妮莎：如果他不讨人喜欢，那免单的机会就留给下一个，就这样一直顺延…\u003c/p\u003e\u003cp\u003e？？？：这里居然还有餐厅，正好正好，瓦列里总不能追到这里来吧…\u003c/p\u003e\u003cp\u003e？？？：老板，给我来一份罐罐焖肉和一份红菜汤，还有一杯…\u003c/p\u003e\u003cp\u003e？？？：咦？你们…这是…\u003c/p\u003e\u003cp\u003e奥黛塔：免单？\u003c/p\u003e\u003cp\u003e沃雅妮莎：等我考考他。\u003c/p\u003e\u003cp\u003e沃雅妮莎：欢迎光临，米提亚先生。\u003c/p\u003e\u003cp\u003e沃雅妮莎：在用餐之前，请您先回答我一个问题。\u003c/p\u003e\u003cp\u003e沃雅妮莎：我昨天演出的时候，演唱的是什么曲目呢？\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cem\u003e米提亚：这真是巧了，沃雅妮莎小姐，没想到在这里也能遇见您…\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e沃雅妮莎：米提亚先生，我昨天演唱的曲目，是·什·么？\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e米提亚：您…您…嗨！您又在开玩笑了，昨天明明没有您的演出啊，哈哈哈…\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e沃雅妮莎：…哼。菜一会就来。\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e奥黛塔：……\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e阿罗夏：柳明娜又跑去哪里玩了…\u003c/em\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\",\"icon\":\"\",\"option\":\"\"},\"8ubefb4qwytT1787946361757\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"dkqbwyexoT1787944911697\":{\"dialogue\":\"\u003cp\u003e？？？：汪！汪汪汪！汪——\u003c/p\u003e\u003cp\u003e派蒙：它看起来好高兴的样子啊！嘿嘿，说不定他就是阿罗夏养的小狗呢。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你好呀，你认识阿罗夏吗？\"},\"ebygiww13slT1787946307354\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：沃雅妮莎平时会做菜么？\"},\"epb5u4uaq5wT1787944906452\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e？？？：汪？汪汪汪…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：咦？这只小狗怎么一听见沃雅妮莎的名字，就一副很受不了的样子…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你好呀，你认识沃雅妮莎吗？\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e在曙光车站，似乎有什么东西正等待着大家打理…\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e等待至第二天早上（6点~8点）\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往曙光车站\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：哇…这个镇子感觉完全变了个样，好热闹呀。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：多了好多店铺…也来了好多人。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：唔…不知道沃雅妮莎她们在不在镇子上，这镇子也不小，怎么找她们呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：汪！汪汪！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"i7qz1najxqlT1787946362603\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：没问题。\"},\"jx5nqio0rgT1787944910568\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e？？？：汪汪，汪…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：这只小狗听见奥黛塔的名字，怎么一副无奈的样子…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你好呀，你认识奥黛塔吗？\"},\"m6h68ajoz7T1787946187298\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e阿罗夏：嗯，那个炉子启动之后，能够提供稳定的暖源和能量。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：在一段时间里，这附近的人，应该都不用担心受冷了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：我也已经和认识的商人谈好了，他们会额外开一条商路通往这里。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：所以，镇子上的人基本上也不用担心缺乏生活必需品了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：周围的匪徒和危险分子已经被扫除了。安全也不用担心。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nit454ekxgpT1787946171535\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：看来，这里已经热闹起来了。\"},\"urfwtsvk9zT1787946325007\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e奥黛塔：……\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：呃，旅行者，派蒙，关于这个…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：保密。等我研究好了，就请你们来吃，到时候一定要全部吃光喔。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：但在那之前，我们先把桌布铺好吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：旅行者，派蒙，你们愿意来帮忙吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ytyv1zsjxmrT1787946174301\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：小镇和车站都很漂亮，也很暖和。\"},\"yz3n717enoT1787945040611\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：对了，之前沃雅妮莎说，阿罗夏送了几只小狗过来护院…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：难道，这只小狗就是阿罗夏送来的？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：汪！汪！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：它这是在…让我们跟上？走吧，旅行者，它也许要带我们去找阿罗夏呢。\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e跟随小狗\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e派蒙：这应该是沃雅妮莎很在意的雀雀球吧，看着已经打理好了，有空来玩玩吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：蕾托娃已经开始指导矮灵跳舞了么…嘿嘿，等一下帮奥黛塔来看看吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：喔！这是阿罗夏提到的炉子吧，真暖和，旁边也有人专门照看了呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：咦…这是车厢么？里面好像还有人在说话？听起来好像就是…\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e和众人交流\u003c/span\u003e\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：…你就贴嘛，哎呀你长得高，贴高点！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：…这里就好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：哎，这么好看的贴纸，贴这里就看不见了啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：给我给我，阿罗夏的贴纸也给我，我一起贴上去。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：我要搬一把椅子过来，椅子…椅子…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e？？？：汪！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：柳明娜？还有…呵，看来你确实等到旅行者了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e柳明娜：汪汪，汪！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：柳明娜真把旅行者带来了，真聪明，欸，这个给你吃。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e柳明娜：汪汪！汪！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：嗯，很有活力嘛，等下排练的时候也要保持住喔。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e柳明娜：汪？！汪汪——\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：喂！怎么又跑了，我这不是在夸它吗…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e阿罗夏：哈哈…可能柳明娜不太喜欢唱歌吧…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：这样啊…那它喜欢什么，跳舞？游泳？总不能又是打猎吧…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：它喜欢安静地和朋友待在一起。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e沃雅妮莎：好吧，我确实不太懂怎么和小狗交朋友。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e奥黛塔：你只是不懂怎么安静。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1791437216","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"v