25/05/19/80663279/6da949de1232a43532d22f81e298d8d7_8885356500991775046.png\\\" data-entry-name=\\\"森林书 第二章「梦中的苗圃」\\\" data-entry-link=\\\"/ys/obc/content/4691/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/4691/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e森林书 第二章「梦中的苗圃」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【初入桓那兰那】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰难世，输了就是输了，不要像和强风对抗的硬枝，折断自己，没有好处。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰梨娄！等到月亮下去，太阳上来，再来比试！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」举办之前】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰梨娄！下一次比试，我要像雨水藏在河流里一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e兰梨娄没有办法从河流里找到雨水，一定会输！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰难世是笨蛋，雨水不一定都会落到河流，还没被树叶拦下，被花朵拦下。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e兰难世会是落在树叶上地雨水一样，兰梨娄一下就能看见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那…那我就要像土壤里地种子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…兰梨娄要想想怎么找，但是兰难世一定会输！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰梨娄，那菈有个咒语，可以找到藏起来的那菈。是这样的：「咖喱~咖喱的香味~就是孩子们回家的信号~♪」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是，「咖喱」是什么呀？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…不知道耶，但是，听说小那菈听到这个咒语，就会跑出来！所以，如果要找小那菈，就可以用这个咒语！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」结束之后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e输给了金色那菈，可是很快乐。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可是不想一直输，所以想去找小那菈锻炼兰迦拉梨…这样就不会被找到了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰难世弱，小那菈肯定不愿意和兰难世一起玩。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e兰梨娄输给了金色那菈，兰梨娄也一样弱。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可是金色那菈和弱弱的兰梨娄一起玩还是很开心。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e小那菈也一定会愿意和兰难世和兰梨娄一起玩游戏的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰梨娄】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…兰难世没有错，那么，一起去找小那菈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰难世】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好，一起去。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758183696","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row