:false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2y4mbh7ojiwT1755424998605\":[],\"775wouhu1jT1755424997410\":[],\"8gfxrw8wla9T1710863939170\":[\"xrm3nuc50ecT1755424995640\",\"775wouhu1jT1755424997410\",\"2y4mbh7ojiwT1755424998605\",\"m4v0x4qjwpsT1755424999504\",\"w2l9c84skqfT1755425000497\",\"s6mns0lef3T1755425001905\"],\"m4v0x4qjwpsT1755424999504\":[],\"s6mns0lef3T1755425001905\":[],\"w2l9c84skqfT1755425000497\":[],\"xrm3nuc50ecT1755424995640\":[]},\"contents\":{\"2y4mbh7ojiwT1755424998605\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/17/76362111/aa772eee8ecd4a10bbf87d6f27587f4f_2943538573682037084.png\",\"option\":\"【制作摆设】——打开制作界面\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"775wouhu1jT1755424997410\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/17/76362111/9ab28082c23ebfaf39a6d40ae4938afd_7804745350208716077.png\",\"option\":\"【切换洞天形态】——打开洞天形态概览界面\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e（第一阶段）你们或许还有点不习惯，等到「外景」之能所显的房屋和家具够多了，你们就能安安稳稳过日子啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（第二阶段）最近你我不辞劳苦地营建，还挺有成效，周围逐渐热闹起来了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（第三阶段）要不要坐下来，陪我喝杯茶啊？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（第四阶段）这片洞天啊，越来越繁华了，我也难免触景生情咯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"m4v0x4qjwpsT1755424999504\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/17/76362111/11ee64c710e3b091256c0d349ac55461_7831430369319970029.png\",\"option\":\"【洞天百宝】——打开商店界面\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"s6mns0lef3T1755425001905\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e与壶中洞天有关的问题，你们都可以来找我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"w2l9c84skqfT1755425000497\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e其实我有个挺难记的仙号，似乎叫…「销虹霁雨真君」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当年战乱不断，大陆各地风雨如磐，日月无光。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e阿萍和老友们对晴天心心念念，就给我起了这个名号。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，无论我用哪种形象示人，都会保留这身「霁青」的色彩。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己…】\"},\"xrm3nuc50ecT1755424995640\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/17/76362111/e5b3248ee49e51b50ae53e6498cbd50b_5809276379242327007.png\",\"option\":\"【信任等阶】——打开信任等阶界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1755482940","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l