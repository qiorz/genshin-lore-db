desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务开始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/55f203718451b3fccc43abb29fec7bd7_144391197074086252.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e〓路线攻略〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e具体路线攻略推荐：\u003ca href=\\\"https://www.miyoushe.com/ys/article/14160451\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e云堇邀约攻略\u003c/a\u003e  作者：\u003ca href=\\\"https://www.miyoushe.com/ys/accountCenter/postList?id=82367888\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"background-color:rgb(255, 255, 255)\\\"\u003e橙柒柒\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd1 只可叹世路风波险\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/355024c58cf348683385d1dffe46a60a_2394564259440992786.png\\\" href=\\\"\\\" style=\\\"border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e看来云堇会有好一段时间要忙了...\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd2 更难得人海觅知音\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/c4e09330cb7289492e400ce7faf87a42_7258775933898566087.png\\\" href=\\\"\\\" style=\\\"border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e摩拉百万容易得，知己一个也难求。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd3 意趣合入画喜相逢\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/5df68b2f2b216e917e59906aaff833ce_3506019079214093846.png\\\" href=\\\"\\\" style=\\\"border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e留一张合影，留一段念想。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd4 不投机无缘空留念\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;