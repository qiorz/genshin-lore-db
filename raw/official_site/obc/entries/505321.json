:false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"召唤物\",\"layout_\":\"left\",\"list\":[{\"tab_name\":\"默认标题\",\"skill_type\":\"\",\"icon\":\"\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},\"tab_id\":\"1730815724349_0\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6498","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"6537","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"天赋牌\",\"layout_\":\"banner\",\"list\":[{\"tab_name\":\"丛山锻火驰行\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/948de7cc9342fabe613ec2ab1a4c7fd8_8040442673861765328.png\",\"life\":2,\"life_bg\":7,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;战斗行动：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e：我方出战角色为\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e希诺宁\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e时，装备此牌。\u003cbr\u003e希诺宁装备此牌后，立刻使用一次\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e音火锻淬\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;音火锻淬：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;元素战技\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;本角色附属\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;刃轮装束\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，进入\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;夜魂加持\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;并获得1点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;「夜魂值」\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。（角色进入\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;夜魂加持\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;后不可使用此技能）\u0026lt;br\u0026gt;（附属\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;刃轮装束\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;的角色可以使用特技：\u0026lt;/span\u0026gt;\u0026lt;span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;高速腾跃\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e装备有此牌的希诺宁\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e在场时：切换至希诺宁或由希诺宁切换至其他角色时，若目标处于\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e夜魂加持\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;夜魂加持：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;状态\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;所附属角色可累积\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;「夜魂值」\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。（最多累积到2点）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e状态，则回复1点夜魂值。（每回合2次）\u003cbr\u003e（牌组中包含希诺宁，才能加入牌组）\u003c/span\u003e\u003c/p\u003e\"]},\"tab_id\":\"1759479143814_0\"}],\"baseInfoSwitchDisabled\":false,\"repeated\":true}","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038427","langs":[],"template_layout":{"tab":[{"tab_id":"49","tab_name":"七圣召唤","module_group":[{"module_group_id":"87","layout":"l1r1","module":[{"id":"131","pos":"left"},{"id":"132","pos":"right"},{"id":"133","pos":"left"},{"id":"134","pos":"left"}],"name":"七圣召唤","repeated":