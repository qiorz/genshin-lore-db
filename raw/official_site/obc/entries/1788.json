3\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没打什么主意就行…你这么说我都不好意思了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不好意思。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e说你呢，鬼鬼祟祟的，干什么呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，路过啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我告诉你，你别打这仓库的主意，我可是一直看着你呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【只是路过。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看见码头上的船了吗？不论大小，不论开进开出，船上的货物饮水都要这座仓库经手。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有我在这儿，璃月的仓库就是全世界最安全的仓库！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们建造仓库的岩石，风吹不动，火烧不进，绝对安全！你是旅行者，你见到世面多，你到过须弥吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我听说那个国家的仓库是用草搭的棚子…你说那能安全吗？有四个我守着的话，那还差不多…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这座仓库很重要吗？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693745","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,