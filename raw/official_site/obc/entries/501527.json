ss=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海精灵们的礼物\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"3ur11sr0lapT1720012501839\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e派蒙！旅行者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5csepbje6z6T1720012301657\":{\"option\":\"【你又给我们找到了宝箱吗？】\",\"dialogue\":\"\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e珀西芙！箱子，宝贝，花花，闪闪，甜甜，十分很多！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，还有别的东西吗？珀西芙，你真好，但如果白拿你的东西就太不好意思了，不如我们来交换吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e交…换？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e因为我们是朋友，朋友就是用真心交换真心的那种！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以我们去帮你找那个幽林枝，然后来换你的东西，你觉得好不好呀？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5hjdva2udpuT1720012254094\":{\"option\":\"【那是幽林雾道的信息？】\",\"dialogue\":\"\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e珀西芙！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幽林枝…十分很丢！十分很多地方！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e珀西芙…找！珀西芙…累累！珀西芙…吃！珀西芙…躺！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幽林枝…十分很不多！但是箱子，十分很多！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊…谢谢派蒙，谢谢旅行者，给！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务「伊黎耶的野精灵」后 首次对话】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"8vk5om7o35nT1720012517438\":{\"option\":\"【我们带来了汐藻。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e汐藻！汐藻！汐藻汐藻汐藻！交换！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"c5hmok39dniT1720012724629\":{\"option\":\"（关闭商店界面）\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢派蒙！谢谢旅行者！谢谢汐藻！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e珀西芙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"e9vy3rzc55sT1720012563470\":{\"option\":\"（提交幽林枝后）\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e珀西芙看起来很高兴呢，不知道这个有什么用…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e幽林枝，十分很有用！那位来客，十分很有用！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"g51khp00cfrT1720013279711\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"gdf0p5t0bwwT1720011440206\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e派蒙！旅行者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哇！居然是珀西芙！又见到你了，真高兴！你在这里做什么呀？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e珀西芙…千活！珀西芙…累累！珀西芙…躺！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…？你在干活？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e幽林枝…幽林枝…十分很丢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e幽林枝？那是什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e幽林枝…信息！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e垂柳，收集。雾道，处理。泉眼，发送。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幽林枝，雾道信息！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nm2yq11932bT1720012345839\":{\"option\":\"【还可以给你找点吃的。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对哦。珀西芙一个人在外面应该很辛苦，我们可以帮她找吃的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e吃的！汐藻！珀西芙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【旅行者】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你喜欢吃汐藻？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e汐藻！汐藻！汐藻汐藻汐藻！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e一天吃五顿？还是一顿吃五个？呜哇…感觉比我还能吃！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那幽林枝呢？珀西芙，是不是去幽林雾道就可以找到啦？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e美露莘…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幽林枝…十分很丢！十分很多地方！十分伊黎耶！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nt0yghtvyveT1720012405503\":{\"option\":\"【幽林枝在整个伊黎耶？】\",\"dialogue\":\"\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e聪明旅行者！珀西芙！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e雾道，有花花，幽林枝，也花花！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…数量！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…这次我一下就听懂了！幽林枝在的地方，长着和幽林雾道一样的花，一共有六个地方，是这样吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e聪明派蒙！珀西芙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，这下我们就都清楚了。珀西芙，那你就先好好休息，这件事包在我们身上！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【珀西芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e派蒙，旅行者，好东西！所以，慢慢…慢慢！珀西芙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"o74ib6ygemT1720012516287\":{\"option\":\"【我们带来了幽林枝。】——打开提交道具界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e幽林枝！幽林枝！珀西芙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"omaml0g0b1T1720012477838\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【兑换完商店物品前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"r3x2yk77q8bT1720013016095\":{\"option\":\"【这是那位来客需要的东西？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e珀西芙！幽林枝…信息！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊…谢谢派蒙，谢谢旅行者，宝贝，给！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"40\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoy