t\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"15f644bgwwrT1722182773823\":{\"icon\":\"\",\"option\":\"【不用了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没兴趣吗，真可惜啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"2eplwdhadd2T1722182807196\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【逐月节期间】\u003c/strong\u003e\u003c/p\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【关于岩王帝君的死…】——完成魔神任务 第一章第一幕「浮世浮生千岩」间后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉…在海上漂泊了几年，就算北斗大姐头也经常津津乐道岩王爷的各种伟绩。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果说北斗大姐头像是天空中指引我前行的星斗，那岩王爷就是撑起整片天空的人吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e本来说回到陆地上，一定要去参加一次请仙典仪，可没想到居然…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么样，看看货吗朋友，平时在陆地上可是很少见的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"f30i1xs7odlT1722182854545\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e最近听说北斗大姐接到了打捞工作，不知道会不会捞出什么宝贝来呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但既然是七星委派的工作，那就算发现了宝贝也没我什么事吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过我这里还是又不少陆地上少见的商品的，朋友来看看吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"k8bsra4mbxaT1722182830949\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e听说了吧，南十字船队的北斗大姐头，又从海上带回来厉害的宝贝了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听说是古时仙人…呃，还是魔神…呃，总之是神像呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以说，南十字船队上带下来的，可都是好东西。怎么样，要看看货吗朋友？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nn0ns7wa3kT1722182843699\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次海灯节（2022）期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/29/288180982/11ee64c710e3b091256c0d349ac55461_8569503709974962801.png\",\"option\":\"【有什么好东西吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这些都是以前出海时得到的，货真价实！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ppkknlzs4mT1722182717708\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/29/288180982/b26706122e54335e75a99308e473cc62_6099380491724135168.png\",\"option\":\"【关于战利品…】——获得勇士的壮行*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e所有战利品里最让我难忘的，可能就是这个杯子了，它总会让我回想起以前大口喝酒的日子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过如今我已经决定要过平静生活了，这个东西留在我这也只会让我感到遗憾和不甘而已。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e感谢你能听我说这么多，这个就送你吧，希望能对你的冒险有所帮助。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1607\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/29/288180982/aa75c8b672bfeaa6697cab5f007f393b_4133273959769652503.png\\\" data-entry-name=\\\"勇士的壮行\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/1607/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/1607/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/29/288180982/aa75c8b672bfeaa6697cab5f007f393b_4133273959769652503.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e勇士的壮行\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"pv2i4kvy3hpT1722182855626\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【这些商品的来源…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什么？难道你以为是赃物？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不会不会…我原本是南十字船队的水手，这些都是几年来我积累下来的战利品。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可惜在跟妖魔「海山」那场战斗中，我受了伤，多亏北斗大姐头才捡回一条命。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那以后我便识趣地退出船队了，不能带着旧伤复发的隐患拖船队大家的后腿啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至少这些年积攒东西还是够我过上平淡日子了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"15f644bgwwrT1722182773823\":[\"2eplwdhadd2T1722182807196\"],\"2eplwdhadd2T1722182807196\":[\"k8bsra4mbxaT1722182830949\"],\"4cf2vhylew3T1710863944349\":[\"