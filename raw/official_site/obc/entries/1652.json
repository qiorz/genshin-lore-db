target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e飞雀扰剑意\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e1.3：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1584\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/02/09/76373921/c936520994ef0dc05e64267c629bd588_8433549590102860932.png\\\" data-entry-name=\\\"海灯节\\\" data-entry-link=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（去年霄灯，今日古华）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"6jtkwtrk7d2T1758717543549\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"l87mi4jyujT1758717525120\":[\"uwsg2tvclo7T1758717542908\",\"6jtkwtrk7d2T1758717543549\"],\"nqb471m7nmnT1710863941173\":[\"l87mi4jyujT1758717525120\",\"y1sbd6l9cwqT1758717548819\",\"veamg9b0nj8T1758717558684\"],\"r6xl43e7wulT1758717582209\":[],\"uwsg2tvclo7T1758717542908\":[\"r6xl43e7wulT1758717582209\"],\"veamg9b0nj8T1758717558684\":[],\"y1sbd6l9cwqT1758717548819\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6jtkwtrk7d2T1758717543549\":{\"option\":\"【修炼功法？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…反正你一个外人，我也没什么好瞒的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我此来是为了求仙访道，求教古华派振兴之法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成每日委托「剑去之日」前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"l87mi4jyujT1758717525120\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e在下古华派弟子孙宇，特来此处…修炼功法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你有什么事情吗？没事请不要打扰我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么？有什么事情吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"r6xl43e7wulT1758717582209\":{\"option\":\"【古华派只剩下你们两个了吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e虽说我派人少了些，不过也不至于这么少…只是我派弟子分散在璃月各地罢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e旅行者，你可曾听过行秋这个名字？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他是我的小师弟，却也是我派第一位领悟了「武理」概念的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他曾写过一篇歌诀，彻底改变了我们古华派的武功传承…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也不知道他现在怎么样了，应该还在四处云游、行侠仗义吧，哈哈哈…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"uwsg2tvclo7T1758717542908\":{\"option\":\"【古华派？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你没听说过大名鼎鼎的古华派？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…也罢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当年「古华团」行走天下，难逢敌手。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「枪剑双绝」的名声在江湖之上无人不知，无人不晓。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可惜天下无不散之筵席…数百年来，物是人非…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e先是人去楼空，「古华团」凋零成了区区百人的「古华堂」，再后，如今的「古华派」已是门口罗雀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"veamg9b0nj8T1758717558684\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e保重。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"y1sbd6l9cwqT1758717548819\":{\"option\":\"【你们感情很好的样子。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我一直把她当做亲妹妹…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e平时习武练功，形影不离。师妹的武艺与侠胆皆不在我之下。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以此次特地带她一起寻仙，共同复兴古华派。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可她脾气古怪，性情聒噪…但对待我又完全是另一番态度…这也让我很是头疼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758719183","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"