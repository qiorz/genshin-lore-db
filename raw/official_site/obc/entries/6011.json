\u003e\u003cp\u003e它还不到一岁，是一只好奇心强的小猫咪。每次我用咖啡渣为客人占卜时，它都会凑上来围观。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果您愿意的话，可以摸摸伽塔的后脑。它会发出开心的呼呼声，而您也一定会享受到世界上最柔软的触感。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临，一杯好的咖啡能让您全天精神充沛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jvpsau2cu6iT1779963758335\":{\"option\":\"【好耶，呼呼！】———获得禽肉*4\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，看来您也是爱猫之人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那就告诉您一个小技巧吧，比起鱼，伽塔更喜欢禽肉的味道。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果它愿意吃您喂的禽肉，那一定会和您成为很好的朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"784\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/08/24077343/8f33d41eadcd12b1e00b53a9196c9163_2237734340651292985.png\\\" data-entry-name=\\\"禽肉\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/784/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/784/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/08/24077343/8f33d41eadcd12b1e00b53a9196c9163_2237734340651292985.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e禽肉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/28/288180982/b26706122e54335e75a99308e473cc62_5136567775906624754.png\"},\"k39s1t1gm9eT1779963744783\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人慢走，欢迎再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【有什么吃的？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人喜欢甜食吗？本店有一些适合搭配咖啡的甜品，欢迎品尝。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/05/28/288180982/11ee64c710e3b091256c0d349ac55461_2829009584879079797.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【这里是…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里是普斯帕咖啡馆，我是这里的代理店长。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果您是初来乍到的新客人，不妨告诉我您的口味，这样我便可以为您推荐合适的咖啡了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是想要甜一些，还是苦一些？是想要浓一些，还是淡一些？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无论是何种偏门的喜好，我都可以帮您调制。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1780019732","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{