\"label\\\":\\\"至冬\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"活动地区\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"洞天\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"活动\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"商人\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"任务\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"牌手挑战\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"对话奖励\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"特殊效果\\\",\\\"children\\\":[{\\\"label\\\":\\\"心声\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"秘闻馆情报\\\",\\\"children\\\":[]}]}]\"},{\"type\":\"text\",\"attribute_name\":\"首页更多\",\"attribute_key\":\"home_more\",\"value\":\"https://baike.mihoyo.com/ys/obc/channel/map/189/20?bbs_presentation_style=no_header\"},{\"type\":\"text\",\"attribute_name\":\"在目录中展示\",\"attribute_key\":\"show_in_catalog\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"最新词条\",\"attribute_key\":\"is_latest\",\"value\":\"0\"},{\"type\":\"text\",\"attribute_name\":\"更多入口icon\",\"attribute_key\":\"king_kong_icon\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"首页更多文案\",\"attribute_key\":\"home_more_text\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"开放全量C端玩家可新建词条\",\"attribute_key\":\"open_for_create\",\"value\":\"0\"}]","updated_at":"-62135596800"}],"template_id":"6605788895f7dc84ca833e44","ext":{"fe_ext":"{\"c_20\":{\"filter\":{\"text\":\"[\\\"地区/洞天\\\"]\"}}}","post_ext":{"post_id":"","post_user_name":"","post_time":"0","post_avatar_url":"","url":""},"server_ext":"","personalized_color":"","scrolling_text":"","corner_mark":"None"},"alias_name":"","lang":"","beta":false,"page_type":"Default","menu_style":"","status":"Online"}}}