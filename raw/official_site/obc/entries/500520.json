io=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e \u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"20000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e  \u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【美食美酒的华丽外衣好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，我还以为这种铁皮房子很难在其他地方建起来呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真厉害，不愧是你。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e既然氛围都到了，要不要一起去钓鱼玩？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【朴实无华的白淞街镇好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…枫丹餐饮业的装潢都大同小异呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要评价一家饭店的好坏，可不能看桌椅是否奢华，还是要看端上桌的餐点是否美味。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对于你的手艺和品味，我放一百个心！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"3d0lwcktm3yT1712691802639\":[\"71tzkb5gljdT1712691804039\",\"o8d0vm02hdlT1712691833352\"],\"4cf2vhylew3T1710863944349\":[\"7rvf2iichzuT1712692112009\"],\"63yq3gpx91lT1712692198702\":[],\"6ql15lo74pvT1712692134009\":[\"kg3qhodga39T1712692147070\",\"yxfaimlq6kT1712692148407\"],\"71tzkb5gljdT1712691804039\":[],\"7rvf2iichzuT1712692112009\":[\"gzqimqplusrT1712692112972\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"goyzg2b1izbT1712692197355\",\"63yq3gpx91lT1712692198702\"],\"9fsff51wd2T1712692026213\":[\"m11vnb8xleT1712692027010\"],\"ejocrcazximT1712692029072\":[],\"goyzg2b1izbT1712692197355\":[],\"gzqimqplusrT1712692112972\":[\"6ql15lo74pvT1712692134009\"],\"kg3qhodga39T1712692147070\":[],\"m11vnb8xleT1712692027010\":[\"ejocrcazximT1712692029072\"],\"nqb471m7nmnT1710863941173\":[\"3d0lwcktm3yT1712691802639\"],\"o8d0vm02hdlT1712691833352\":[],\"yxfaimlq6kT1712692148407\":[],\"z2tn3pzsbujT1710863943430\":[\"9fsff51wd2T1712692026213\"]},\"contents\":{\"0qcn98iykoqbT1712692175462\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对了，我作为好朋友，是不是应该烤一个写着你我和派蒙名字的蛋糕，端到这里来？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总觉得派蒙会很想要那种东西…也不是不行！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"3d0lwcktm3yT1712691802639\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哪有，不可以这么说哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e人们家里总是会留下只有主人才能布置出的感觉，来别人家看的不是别的，是性格。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯嗯，我概括得真好。对，就是性格！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好比这里…嗯，能感觉到呢，是你和派蒙的家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【跟你家比还是差了一点。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一起玩吧！爬山、爬树、逗猫、遛狗…什么都好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"63yq3gpx91lT1712692198702\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呼啊——晚安晚安，我有点困了，你也早点睡吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唔…希望能梦到开心的事…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，娜维娅。】——【夜晚】\"},\"6ql15lo74pvT1712692134009\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e会啊，还梦到过它。梦里总是和它玩得很开心，不过醒来之后也不会特别特别留恋…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e贝贝壳也不希望我总是被一件事困住，对吧？它肯定也希望我今后交到更多的好朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【 你会想它吗？】\"},\"71tzkb5gljdT1712691804039\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…温馨实用就好？我才没有那么挑剔啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我家的布置很多都是迈勒斯安排的，我喜欢那种感觉。一旦习惯，就很难突然变更布设了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你喜欢什么风格的家？】\"},\"7rvf2iichzuT1712692112009\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对呀，别看我这个裙摆大，行动不会受影响的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我就是考虑到这点，才要求服装设计师在一般的礼服裙基础上做了改良。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【娜维娅要穿成这样去爬树？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀呀，你好啊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这地方真不错，你和派蒙两个人住这么大的地方吗？会不会有点太空了，我可以经常来玩吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9fsff51wd2T1712692026213\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，说到这个，你可以考虑买顶帽子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e倒不是因为在外旅行需要遮风挡雨之类的原因…我单纯是觉得你的发型很适合戴帽子啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【或许我们可以聊聊帽子？】\"},\"ejocrcazximT1712692029072\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？居然是这样…有意思，你果然是很想得开的人呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你知道吗，能做到这种事的人大多非常洒脱哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不论世界是什么样子，就以最基本的姿态去面对。我觉得这样也挺好的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这就是到处旅行的人的底气，对吧？啊当然，有机会还是要给你买点帽子皮鞋的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【 基本也都是现在这身。】\"},\"goyzg2b1izbT1712692197355\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好，今天一定会是很好的一天。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要出去逛逛吗？去哪里都可以，带好你的小包裹，马上出发！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，娜维娅。】——【白天】\"},\"gzqimqplusrT1712692112972\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很久以前养过一条小狗，后来它因病去世了，我就没再养新的小狗了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e它叫「贝贝壳」，名字是老爹起的，没什么特别的意思，就是捡到它那天刚去过海边而已。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也很喜欢贝贝壳，小时候经常和它一起出去，它还会带我钻那些废弃的管道，很聪明的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【娜维娅养过宠物吗？】\"},\"kg3qhodga39T1712692147070\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这是什么话呀！我们不只是好朋友，还是一起经历过生死关头的好朋友！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e人一辈子可遇不到多少这样的朋友，我当然要好好珍惜你了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，我作为好朋友，是不是应该烤一个写着你我和派蒙名字的蛋糕，端到这里来？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总觉得派蒙会很想要那种东西…也不是不行！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我是娜维娅的好朋友吧？】\"},\"m11vnb8xleT1712692027010\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊，我带你去枫丹最好的服装店。我想想…你和派蒙可能需要出席正式场合的服装，还有帽子和新皮鞋…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这么说来，你们以前出席正式场合的时候会怎么打扮呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有机会的话，一起去买衣服吧。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很不错，我喜欢这里。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e风景好，室内布设也很有品味，不愧是你家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"o8d0vm02hdlT1712691833352\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的？我真的会经常来哦？没问题吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e放心，我会带点心来的，手工饼干，小蛋糕…你喜欢哪种都可以。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e派蒙的份也一起！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【喜欢这里的话，请务必常来！】\"},\"yxfaimlq6kT1712692148407\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，听听你在说什么呀，我们早就是了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不是好朋友，怎么会愿意经常来你家玩呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，我作为好朋友，是不是应该烤一个写着你我和派蒙名字的蛋糕，端到这里来？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总觉得派蒙会很想要那种东西…也不是不行！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【娜维娅能做我的好朋友吗？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然啦，来这里就是找你们玩的嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯~从什么开始呢？你最近有感兴趣的事吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712801615","langs":[],"template_layout":{"tab":[{"tab_id":"69","t