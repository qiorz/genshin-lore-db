m/wiki-user-upload/2026/05/16/258999284/dae5442cb7c3d404c2706842ca6894e3_4316787261359887372.png\",\"life\":3,\"life_bg\":2,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次\u0026lt;strong\u0026gt;战斗行动\u0026lt;/strong\u0026gt;后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;打出具有此规则的手牌是一个\u0026lt;strong\u0026gt;战斗行动\u0026lt;/strong\u0026gt;，而非\u0026lt;strong\u0026gt;快速行动\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cstrong\u003e：\u003c/strong\u003e我方出战角色为\u003cstrong\u003e菈乌玛\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e菈乌玛装备此牌后，立刻使用一次\u003cstrong\u003e\u003cu\u003e圣言述咏·终宵永眠\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;圣言述咏·终宵永眠：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素战技\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成1点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(82, 196, 26)\u0026#34;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，生成\u0026lt;strong\u0026gt;霜林圣域\u0026lt;/strong\u0026gt;。如果我方手牌中存在附着有\u0026lt;strong\u0026gt;费用降低\u0026lt;/strong\u0026gt;的卡牌，则移除随机1张牌的1层\u0026lt;strong\u0026gt;费用降低\u0026lt;/strong\u0026gt;效果并改为生成可造成2点伤害的\u0026lt;strong\u0026gt;霜林圣域\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e我方触发绽放和月绽放后：\u003c/strong\u003e治疗我方受伤最多的角色2点。（每回合1次）\u003c/p\u003e\u003cp\u003e（牌组中包含菈乌玛，才能加入牌组）\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}}]}\n","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038509","langs":[],"template_layout":{"tab":[{"tab_id":"49","tab_name":"七圣召唤","module_group":[{"module_group_id":"87","layout":"l1r1","module":[{"id":"131","pos":"left"},{"id":"132","pos":"right"},{"id":"133","pos":"left"},{"id":"134","pos":"left"}],"name":"七圣召唤","repeated":false,"parent_group_id":"0"},{"module_group_id":"2630","layout":"l2r1","module":[{"id":"8551","pos":"banner"},{"id":"8550","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]},{"tab_id":"445","tab_name":"自行巧局","module_group":[{"module_group_id":"2158","layout":"l1r1","module":[{"id":"6537","pos":"banner"},{"id":"6496","pos":"left"},{"id":"6497","pos":"right"},{"id":"6498","pos":"left"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"233","name":"角色牌","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"角色牌","is_hidden":false,"parent_id":"231","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\