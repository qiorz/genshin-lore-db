d":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"list\":[],\"author\":\"\",\"created_at\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8888bc4ixz9T1786676414250\":{\"icon\":\"\",\"option\":\"【你的生意怎么样？】——完成魔神任务第七章第二幕 「死魂灵的夜曲」前\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e说实话，自从「严冬计划」开始，大家日子都过得捉襟见肘…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e别说买这些异国风情的小玩意儿了，连购买必需品，如今都得精打细算的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也许过不了多久，我就得另谋生路了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e足不出户，走出至冬！这里什么都有——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"g9egfs0w3avT1786676367350\":{\"icon\":\"\",\"option\":\"【没有至冬本土商品吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看来您不是本地人，我跟您说实话吧。我这里做的其实是本地人的生意。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在这片广袤的土地上，大多数人终其一生，都没有踏出过至冬的边界。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但这不代表他们不对外面的世界感到好奇，不代表他们不想要一点变数。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而这些异国风情的小东西，既不昂贵，又能为他们编织一段陌生且奇特的幻梦…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e正所谓哪里有需求，哪里就有市场。您说对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"iv9cq2u09lfT1786676415257\":{\"icon\":\"\",\"option\":\"【你的生意怎么样？】——完成魔神任务第七章第二幕 「死魂灵的夜曲」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e说实话，自从「严冬计划」开始，大家日子都过得捉襟见肘…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e行情不好，生意也难做，前段时间，我都已经打算另谋生路了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，您说巧不巧，「严冬计划」竟然就在不久前中止了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然大家都还没从节衣缩食的习惯里缓过来，但我对未来还是挺乐观的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"loo4arsep3oT1786676368397\":{\"icon\":\"\",\"option\":\"【不稀奇，这些地方我都去过。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那您真是太幸运了，想必您是一个既有勇气，也有智慧的冒险家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，这里还有许多人，终生都没有离开过至冬。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也许我卖的只是些平常的小玩意，不过对于他们来说，这些东西何尝又不是领略异国风情最快的方式呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/14/178964736/11ee64c710e3b091256c0d349ac55461_5512320756875390216.png\",\"option\":\"【让我看看有什么…】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞，我这里的可都是些在外面收罗来的…嘿嘿，有很多可是货真价实的「遗物」呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【什么都有？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什么都有！世界各地的风物，你都能在我这儿找到。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e稻妻的小说、须弥的论文集、枫丹的茶点，纳塔的颜料…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要付出一点小小的摩拉，您在这里的收获，说不定比那些周游各国的冒险家还大!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8888bc4ixz9T1786676414250\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"g9egfs0w3avT1786676367350\":[\"8888bc4ixz9T1786676414250\",\"iv9cq2u09lfT1786676415257\"],\"iv9cq2u09lfT1786676415257\":[],\"loo4arsep3oT1786676368397\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"g9egfs0w3avT1786676367350\",\"loo4arsep3oT1786676368397\"]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"",