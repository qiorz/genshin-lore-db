"option\":\"【关于蒙德城的特色…】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e请您~慢慢挑选~\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/661f4aed07b4e34115c0ea22f4b4b711_4447761468130020882.png\",\"option\":\"【这里卖什么？】——打开商店界面\"},\"v55uxfeeq9T1746847013980\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e谢谢惠顾蒙德百货，诚挚等候您下次光临~\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e【胜利】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e…我还得去接待其他顾客，失陪了。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan\u003e【失败】\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan\u003e抱歉了客人，这一局我赢了。\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/10/50494840/cc2a44c2e85425afbbd461e49fe0875d_2128682074690192858.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手二级解锁】\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1747018933","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"}