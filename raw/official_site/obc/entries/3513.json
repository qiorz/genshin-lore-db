ithout_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e才不会呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，那就转个身吧，我可从来没见过这样的衣服。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然有点丑陋，但也不是什么意思都没有。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e居然觉得丑，那还不如不要看...\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是的，以往我让那些女官们给我作范本，可没有那么烦的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，白夜国的人啊，穿的衣服，长的样子我也全都看腻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你们身上的倒是少见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，我知道了，原来这个衣服是这样的结构的...你们异乡还真是不知羞耻。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，衣服结构若是这样的，那身躯就做成这个造型吧!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你这是在做什么呢?\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e造像啊，用泥水混合，用双手捏出造型。每每只有做这事的时候，内心才能平静。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平时的议会，照本宣科地按着大人们写好的词句读，总让人不安。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e...好了，你的造型我也已经看腻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e别烦我，去做自己的事去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【让派蒙不动...】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e才不会呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，那就转个身吧，我可从来没见过这样的衣服。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然有点丑陋，但也不是什么意思都没有。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e居然觉得丑，那还不如不要看...\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是的，以往我让那些女官们给我作范本，可没有那么烦的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过，白夜国的人啊，穿的衣服，长的样子我也全都看腻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你们身上的倒是少见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，我知道了，原来这个衣服是这样的结构的...你们异乡还真是不知羞耻。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，衣服结构若是这样的，那身躯就做成这个造型吧!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你这是在做什么呢?\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【里栖太御须】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e造像啊，用泥水混合，用双手捏出造型。每每只有做这事的时候，内心才能平静。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e平时的议会，照本宣科地按着大人们写好的词句读，总让人不安。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e...好了，你的造型我也已经看腻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e别烦我，去做自己的事去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【会掉下来吗？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1781763852","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":f