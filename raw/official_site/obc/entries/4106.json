er":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【山上】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e演出一开始，你就说「德长，快，给大家来一个」！然后我立即登场，一个后空翻…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德长】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，会不会太夸张了啊？我觉得按照原来那样就可以了，你从后边吓我，我假装被吓一跳…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【山上】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不行不行，太平淡了。我们的目标可是搞笑艺人出道！不拿出全力，怎么出人头地。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e假装吓人这么老套的手法，狗看了都不会笑的。你说是不是，皮卡？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【皮卡】（狗）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【山上】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德长】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e看什么…你过来吓我，我也可以演得很好笑啊。不信我演给你看！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊啊啊啊啊啊啊啊——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【山上】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德长】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是不是，挺好笑的吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个…皮卡，你告诉他，好笑不好笑。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【皮卡】（狗）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（摇尾巴）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7n