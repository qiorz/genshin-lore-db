iki-user-upload/2024/06/13/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_9075954547130955975.JPG\\\" data-entry-name=\\\"家书难递\\\" data-entry-link=\\\"/ys/obc/content/501470/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/501470/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e家书难递\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2zc54tolqtdT1757950238549\":[\"wzecdcjugzcT1757950249112\"],\"4cf2vhylew3T1710863944349\":[\"gj0umdul1o8T1757950202276\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"dbpq0zw6wwT1757950285577\":[\"oq2exr0d06T1769951904049\"],\"e8o036cr9dT1769952015057\":[],\"eq4z9i32qcT1757950215384\":[\"v2pg96nk2weT1757950229704\"],\"gj0umdul1o8T1757950202276\":[\"eq4z9i32qcT1757950215384\"],\"gt0yrv2ik2nT1757950272849\":[\"dbpq0zw6wwT1757950285577\"],\"nqb471m7nmnT1710863941173\":[\"gj0umdul1o8T1757950202276\"],\"oq2exr0d06T1769951904049\":[\"e8o036cr9dT1769952015057\"],\"v2pg96nk2weT1757950229704\":[\"2zc54tolqtdT1757950238549\"],\"wzecdcjugzcT1757950249112\":[\"gt0yrv2ik2nT1757950272849\"],\"z2tn3pzsbujT1710863943430\":[\"gj0umdul1o8T1757950202276\"]},\"contents\":{\"2zc54tolqtdT1757950238549\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e千岩牢固，重嶂不移。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看过音乐节的演出了吗？乐声真响亮啊，感觉比霄灯飘得更遥远。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…也不知道站在轻策庄的山坡上，能不能听到乐声…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…小六，爸爸好想你啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见旅行者。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你路过轻策庄的话，麻烦告诉一个叫小六的女孩，爸爸很好，爸爸会去看她的，一定会的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是旅行者啊，你好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不要看看我女儿的画像？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"dbpq0zw6wwT1757950285577\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第六次海灯节（2026）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"e8o036cr9dT1769952015057\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"eq4z9i32qcT1757950215384\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e千岩牢固，重嶂不移。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你放飞过霄灯了吗？把愿望写到上面，在未来一定会实现的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e比如我，就许愿我的女儿小六能平安健康，多交些朋友，哈哈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…也不知道站在轻策庄的山坡上，能不能看到漫天的霄灯…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…小六，爸爸好想你啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gj0umdul1o8T1757950202276\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次海灯节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"gt0yrv2ik2nT1757950272849\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e千岩牢固，重嶂不移。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你最近放过风筝了吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我看璃月港的小孩子们啊，好多都去结伴放风筝了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…也不知道站在轻策庄的山坡上，能不能看到飞得那么高的风筝…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…小六，爸爸好想你啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「千岩牢固，重嶂不移。干城戒甲，靖妖闲邪」。我们是守卫璃月的千岩军。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e能成为千岩军的一员、守卫璃月港是我的荣幸。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…话是这么说，可我还是更想回到轻策庄附近工作。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毕竟我心心念念的女儿还在那边啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"oq2exr0d06T1769951904049\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e千岩牢固，重嶂不移。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你放过霄灯了吗？据说今年纪念的白马仙人，是会从月亮上下来，帮人们实现愿望的仙人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，要是白马仙人真的能帮助人们实现愿望，能否让我像月亮一样，和家人团团圆圆呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…小六，爸爸好想你啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"v2pg96nk2weT1757950229704\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第三次海灯节（2023）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"wzecdcjugzcT1757950249112\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第四次海灯节（2024）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【关于女儿…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e她叫小六。我夫人在她出生的时候就难产去世了，如今是轻策庄的长辈们在照顾她。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…她还太小，我都不知道该怎么和她说这件事…只好骗他说，妈妈一直在璃月港工作…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…唉，独自来到璃月工作后，我已经很久没有见到她了。上次抱起她时，好像还远没有这把长枪重…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她有好好吃饭吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她有没有健健康康的呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她有没有交到朋友呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉…小六，爸爸好想你啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1769997918","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\