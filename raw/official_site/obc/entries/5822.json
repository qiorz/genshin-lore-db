003e…啊，可是姐姐她还在神社工作，我答应过她不能乱跑，要在这边等她一起回家…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果姐姐找不到我的话，会担心的吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谢谢你，我还是一个人玩吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你在做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我在数来神社求签的人呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有个个子小小的、穿着狸猫衣服的女孩子求签，许愿想要长高什么的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有个长得很漂亮的大姐姐说希望稻妻能安稳什么的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦，还有个大哥哥，说希望九条家能繁荣昌盛…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大家的愿望都好特别呀，我的愿望是能和姐姐玩捉迷藏就好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1783069096","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1