-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/26/80663279/8d13718394910e0eb47b42159a7fa4f3_5970122536495089791.png\\\" data-entry-name=\\\"第五章 幕间「万火归一」\\\" data-entry-link=\\\"/ys/obc/content/503686/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/503686/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e第五章 幕间「万火归一」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e小心，下一次，也许就是见胜负的时刻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那我可真是求之不得呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e希望不要到时候你又要说「真可惜，又是平手」，我可是听腻了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没办法，谁让你一直没能在击杀敌人的数量上超过我呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那容我提醒你，平手的意思是指，这话也可以原封不动还给你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那这样争下去也没什么意义，只能让我们继续努力咯？我是说，作为对手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是什么话，当然是对手。我还没到需要和你组队的地步呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务 第五章第四幕「命定将焚的虹光」后】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…真可惜…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e停，停！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…又是平手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你就一定要跟我对着干是吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等你赢过我的那天，你想让我闭嘴多久都行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但在那之前，我想说什么就说什么。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…总有一天。只要我们还能站在这里喘气，那就总有一天能分出胜负！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊图提娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e到时候我不仅要让你闭嘴，还要让你摘下这个面具！看看你一直戴着它，是不是因为下面留了伤疤。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥杜力】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦吼，那就要看你的本事了。争取先比我多干掉半个敌人试试吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1736239443","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频