,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"41dirmzzvdmT1788964190780\":[],\"7vc3h1whd0uT1788963741989\":[\"41dirmzzvdmT1788964190780\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[\"7vc3h1whd0uT1788963741989\"]},\"contents\":{\"41dirmzzvdmT1788964190780\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"45h08mxdiwaT1788963786656\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"7vc3h1whd0uT1788963741989\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成首次对话后】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【薇涅兹卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好漂亮的戒指！谢谢你，亲爱的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不用赔违约金，最近又接了好多活，终于可以给你买个最闪亮、最漂亮的戒指了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「坏事发生了，好事也就不远了」，这句话还真是有道理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【薇涅兹卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说到这，我想给编撰《奥古洛夫诡谈》的作者写一封感谢信，唔，再附上一点感谢费。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真是多亏了他，我们才能提前规避风险…虽然很多人说他在胡说八道，但我要为他正名！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真希望他之后多多更新啊，我一定会去支持的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成系列世界任务「在生命的寓所」后 首次对话】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【薇涅兹卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e他们还没有找上门来…我已经把我能卖的首饰都卖了，但要赔100倍违约金，还是不够。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，我只是想给你买一个最好的、最闪亮的戒指…或者，我去隧道口看看？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【薇涅兹卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可别了…最最新的一版的《奥古洛夫诡谈》可说了，最近那只大火鸟又开始活动啦…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有一位自称「铁头老大」的目击证人，信誓旦旦地说他看到了那只大火鸟，一口吞掉了一截列车车厢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了安全，你还是别去隧道口了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e实在、实在不行，我们请个私家侦探去打探打探…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e向雅里说明了在奥古洛夫镇外围开通隧道的事…\u003c/p\u003e\u003cp\u003e【雅里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，还发生了这样的事啊…也就是说，你已经替我完成工作了？帮大忙了啊！这些小小感谢费你收下吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【薇涅兹卡】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，这样也不用付违约金了，我得马上赎回我的首饰了…不，我要新买一批！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509309\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/dc19a468160d1a2a4ef36d3a16850de6_4382679750654021094.png\\\" data-entry-name=\\\"红甜菜\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/509309/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/509309/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/dc19a468160d1a2a4ef36d3a16850de6_4382679750654021094.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e红甜菜\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【我已经替你完成工作了。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1789005697","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"",