e,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"召唤物\",\"layout_\":\"left\",\"list\":[{\"tab_name\":\"默认标题\",\"skill_type\":\"\",\"icon\":\"\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},\"tab_id\":\"1730815724349_0\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6498","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e自行巧局\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"6537","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"list\":[{\"tab_name\":\"崇诚之真\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/161a55bb8e3e5141557f38536579e897_8485844821422279523.png\",\"life\":4,\"life_bg\":4,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;战斗行动：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为\u003cstrong\u003e迪希雅\u003c/strong\u003e时，装备此牌。\u003c/p\u003e\u003cp\u003e迪希雅装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e熔铁流狱\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;熔铁流狱：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;元素战技\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;召唤\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;净焰剑狱领域\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;；如果已存在\u0026lt;strong\u0026gt;\u0026lt;em\u0026gt;净焰剑狱领域\u0026lt;/em\u0026gt;\u0026lt;/strong\u0026gt;，就先造成1点火元素伤害。\u0026lt;/p\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;净焰剑狱领域\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;结束阶段\u0026lt;/strong\u0026gt;：造成1点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(245, 34, 45)\u0026#34;\u0026gt;\u0026lt;u\u0026gt;火元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span data-type=\u0026#34;详情\u0026#34; data-name=\u0026#34;\u0026amp;lt;p\u0026amp;gt;\u0026amp;lt;strong\u0026amp;gt;\u0026amp;lt;span style=\u0026#34;\u0026gt;火元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;附着火元素，可发生元素反应：\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;融化：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害+2\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;蒸发：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害+2\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;超载：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害+2，目标强制切换到下一个角色\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;燃烧：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;本伤害+1，生成回合结束时造成1点火伤害的[\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span\u0026gt;燃烧烈焰\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span\u0026gt;]（可生效1次，最多叠加到2次）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026amp;#34; class=\u0026amp;#34;wiki-note-text\u0026amp;#34;\u0026amp;gt;\u0026lt;sup class=\u0026#34;wiki-sup\u0026#34;\u0026gt;[详情]\u0026lt;/sup\u0026gt;\u0026lt;/span\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;可用次数\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span data-type=\u0026#34;详情\u0026#34; data-name=\u0026#34;\u0026amp;lt;p\u0026amp;gt;\u0026amp;lt;strong\u0026amp;gt;可用次数：\u0026amp;lt;/strong\u0026amp;gt;\u0026amp;lt;/p\u0026amp;gt;\u0026amp;lt;p\u0026amp;gt;此牌效果触发后，会消耗1次\u0026amp;lt;strong\u0026amp;gt;可用次数\u0026amp;lt;/strong\u0026amp;gt;；\u0026amp;lt;/p\u0026amp;gt;\u0026amp;lt;p\u0026amp;gt;\u0026amp;lt;strong\u0026amp;gt;可用次数\u0026amp;lt;/strong\u0026amp;gt;耗尽后，立刻弃置此牌。\u0026amp;lt;/p\u0026amp;gt;\u0026#34; class=\u0026#34;wiki-note-text\u0026#34;\u0026gt;\u0026lt;sup class=\u0026#34;wiki-sup\u0026#34;\u0026gt;[详情]\u0026lt;/sup\u0026gt;\u0026lt;/span\u0026gt;：3\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;当此召唤物在场且迪希雅在我方后台，我方出战角色受到伤害时\u0026lt;/strong\u0026gt;：抵消1点伤害；然后，如果迪希雅生命值至少为7，则对其造成1点\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;穿透伤害\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span data-type=\u0026#34;详情\u0026#34; data-name=\u0026#34;\u0026amp;lt;p\u0026amp;gt;\u0026amp;lt;strong\u0026amp;gt;穿透伤害：\u0026amp;lt;/strong\u0026amp;gt;\u0026amp;lt;/p\u0026amp;gt;\u0026amp;lt;p\u0026amp;gt;穿透伤害无法收到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。\u0026amp;lt;/p\u0026amp;gt;\u0026#34; class=\u0026#34;wiki-note-text\u0026#34;\u0026gt;\u0026lt;sup class=\u0026#34;wiki-sup\u0026#34;\u0026gt;[详情]\u0026lt;/sup\u0026gt;\u0026lt;/span\u0026gt;。（每回合1次）\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(245, 34, 45)\u0026#34;\u0026gt;火元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;附着火元素，可发生元素反应：\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;融化：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;蒸发：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;超载：\u0026lt;/strong\u0026gt;本伤害+2，目标强制切换到下一个角色\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;燃烧：\u0026lt;/strong\u0026gt;本伤害+1，生成回合结束时造成1点火伤害的[\u0026lt;strong\u0026gt;燃烧烈焰\u0026lt;/strong\u0026gt;]（可生效1次，最多叠加到2次）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;此牌效果触发后，会消耗1次\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;可用次数\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;穿透伤害：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;穿透伤害无法收到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e结束阶段：如果装备有此牌的迪希雅生命值不多于6，则治疗该角色2点。\u003c/p\u003e\u003cp\u003e（牌组中包含迪希雅，才能加入牌组）\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}}]}\n","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component