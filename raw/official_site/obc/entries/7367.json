gin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动流程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e玩法教学：\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/4521515/e4bd9a9694be789433a365fae8f4d789_3366648186985198844.png\\\" href=\\\"\\\" style=\\\"width:450px;border:none;vertical-align:middle;\\\"\u003e\u003cimg src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/4521515/bb8183b2a0502a49c4e475b3656ea1bc_4042837148217151797.png\\\" href=\\\"\\\" style=\\\"width:450px;border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/4521515/950ba747c61d283506a9a94d6c96d3ef_5424630878167082612.png\\\" href=\\\"\\\" style=\\\"width:450px;border:none;vertical-align:middle;\\\"\u003e\u003cimg src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/07/4521515/75b234188581a27d2ac5d9785150339d_5147763079491019545.png\\\" href=\\\"\\\" style=\\\"width:450px;border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e第一天：\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e平静的果酒湖中，蒙德的鱼儿们正享受着安详的生活。然而，一支从没见过的角角鱼大军出现在了这片水域，抢占了蒙德鱼儿们的家，粗暴地赶走了原住民。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e为了保护家园，赶走霸道的入侵者，蒙德鱼儿们找到了力气大大，又点子多多的嘟嘟可，请嘟嘟可帮帮它们···\u003c/p\u003e\u003cdiv class=\\\"table-wrapper\\\"\u003e\u003ctable style=\\\"border-color:rgb(193, 199, 208);line-height:1;font-size:16px;min-width:75px;border-collapse:collapse;\\\" border=\\\"1\\\" cellspacing=\\\"0\\\"\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e序号\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e目标\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e奖励\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e1\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e得分达到16\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e原石\u003c/a\u003e×70，\u003ca href=\\\"/ys/obc/content/804/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e高塔孤王的残垣\u003c/a\u003e×3\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e2\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(64,64,64,1)\\\"\u003e得分达到28\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×30000，\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e大英雄的经验\u003c/a\u003e×3\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e3\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"color:rgba(64,64,64,1)\\\"\u003e得分达到35\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×20000，\u003ca href=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e精锻用魔矿\u003c/a\u003e×3\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e第二天：\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e点子多多的嘟嘟可拿出了特别的蹦蹦炸弹，虽然威力小小，但对付坏坏的角角鱼士兵，已经完全足够了，还不会把蒙德鱼儿们的家园都毁掉!\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嘟嘟可凭着灵敏的耳朵，找到了角角鱼们的据点，开始教训这些坏家伙!不过，角角鱼士兵似平也是有备而来的……\u003c/p\u003e\u003cdiv class=\\\"table-wrapper\\\"\u003e\u003ctable style=\\\"border-color:rgb(193, 199, 208);line-height:1;font-size:16px;min-width:290px;border-collapse:collapse;\\\" border=\\\"1\\\" cellspacing=\\\"0\\\"\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol style=\\\"width: 240px;\\\"\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e序号\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e目标\u003c/p\u003e\u003c/td\u003e\u003ctd data-colwidth=\\\"240\\\"\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e奖励\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e1\u003c/p\u003e\u003c/td\u003e\u003ctd\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e得分达到16\u003c/p\u003e\u003c/td\u003e\u003ctd data-colwidth=\\\"240\\\"\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e原石\u003c/a\u003e×70，\u003ca href=\\\"/ys/obc/content/796/detail?bbs_pres