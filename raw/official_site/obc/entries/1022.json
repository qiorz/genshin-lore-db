act":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cuf6j2pyrT1758031416732\":[\"gtt2zmgze8jT1758031431845\"],\"6m71orh6qblT1758031345364\":[\"uqpv1s085qT1758031380864\"],\"7aav88qftxT1758031448547\":[\"iorg06w3zbT1758031584675\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"8v8mi03gugjT1758031829139\":[],\"dbpgrzgbtgT1758031364112\":[\"4cuf6j2pyrT1758031416732\"],\"gtt2zmgze8jT1758031431845\":[\"7aav88qftxT1758031448547\"],\"iorg06w3zbT1758031584675\":[\"xrwbvpmy43T1758031804283\"],\"nqb471m7nmnT1710863941173\":[\"6m71orh6qblT1758031345364\",\"tamy8l2p3hT1758031346092\",\"dbpgrzgbtgT1758031364112\"],\"tamy8l2p3hT1758031346092\":[\"4cuf6j2pyrT1758031416732\"],\"uqpv1s085qT1758031380864\":[\"4cuf6j2pyrT1758031416732\"],\"xrwbvpmy43T1758031804283\":[\"8v8mi03gugjT1758031829139\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"4cuf6j2pyrT1758031416732\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一、二次风花节（2021、2023）期间 白天】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，我说的是真的啦，誓言岬那边真的有心形的日落果…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e贝雅，一定是你看错了，日落果是不可能长成那样的，这不符合自然规律。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且，即便真的有那样的日落果，味道也一定不如我卖的这种。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们就去誓言岬看看嘛，反正也用不了多长时间的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不，这是我的信念与底线。靠外形吸引眼球终究是投机取巧的行为，我是绝对不会做的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…真是的，为什么还听不懂我的意思呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？你说什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳，没什么…你再考虑考虑嘛～！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一、二次风花节（2021、2023）期间 夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"6m71orh6qblT1758031345364\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗝，是你啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没错没错，我是卖水果的昆恩，摊子在…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e新鲜水果尽在…昆恩水果…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…嗯，等等，我们见过吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（脑袋晕晕乎乎的啊…）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"7aav88qftxT1758031448547\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，你问贝雅啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知道她到底在想什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e自从风花节开始，就一直在念叨什么誓言岬、心形的日落果…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么可能有那种日落果啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说对吧，嗝…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那个家伙？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e新鲜水果尽在昆恩水果摊——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e昆恩——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…又是你啊，今天要多少？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我先声明，绝不打折！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e青梅竹马都不给亲友价嘛？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我说过很多次了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e价钱不打折，品质也绝不打折！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀～～再商量商量嘛～\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我帮你带午饭来的话，可以打折吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你说什么都不会打折的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8v8mi03gugjT1758031829139\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"dbpgrzgbtgT1758031364112\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗝…再…再…来一杯！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"gtt2zmgze8jT1758031431845\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e就算是青梅竹马，也不能动摇我的决心…嗝…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"iorg06w3zbT1758031584675\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次佳酿节（2022）期间 白天】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e昆恩——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…又是你啊，不会又要拉着我要打折吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我先声明，佳酿节这阵我可忙得很，没空和你闲扯啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就算忙，也不能连我都顾不上吧！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e别说是水果了，就算是果酒，看在青梅竹马的份上，难道不能帮我要个折扣吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我说过很多次了，水果不打折。而且我只是帮果酒摊送原料，怎么能硬要人家打折呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，帮帮忙嘛！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我知道你爱喝果酒，等我买了之后送你一些，再帮你做下酒菜\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【贝雅特丽奇】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可以打折吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昆恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你说什么都不会打折的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次佳酿节（2022）期间 夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一摩拉就想买仨苹果…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想什么呢，那个家伙…嗝…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"tamy8l2p3hT1758031346092\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，你问贝雅啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知道她到底在想什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e每天都要来讨价还价…就算是青梅竹马…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就一摩拉，也不能卖给她仨苹果啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说对吧，嗝…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那个家伙？】\"},\"uqpv1s085qT1758031380864\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗝，晚上…不卖水果…也不打折…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u00