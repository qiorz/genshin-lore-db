8/317305234/41a53cbf3d3742b30dd4261689b9e6fc_530083573432791861.png\\\" data-entry-name=\\\"游戏一场\\\" data-entry-link=\\\"/ys/obc/content/1453/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1453/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e游戏一场\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"ofpmat2tc6cT1783678987579\"],\"nqb471m7nmnT1710863941173\":[],\"ofpmat2tc6cT1783678987579\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【那边的碑…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，这两块石头是几位千岩军叔叔送上来的，他们说，是爸爸妈妈让他们把这两块石头立在这里的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我还没学过多少字呢，上面写的字好复杂，我好多都看不懂…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过既然是爸爸妈妈让他们送过来的，应该是对爸爸妈妈来说很重要的东西吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e爸爸妈妈什么时候才回来呀…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【这里是你家？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对呀，我和爸爸妈妈一直住在这，可是他们现在也不知道到哪去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，我也不敢走太远，不然他们回来的时候找不到我，肯定会担心的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ofpmat2tc6cT1783678987579\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，再见，有空的话，就再来陪我玩一下捉迷藏吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【你平时的生活…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一位老伯伯经常来给我送吃的，他让我叫他天叔，还说是我家的一个远方亲戚，和我爸爸妈妈关系很好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他说，爸爸妈妈现在还在办事，暂时回不来，我有什么事可以去找他。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我问他爸爸妈妈在哪，他却不和我说，真是个奇怪的老伯伯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有一些千岩军的叔叔也会经常来看我，会给我带很多好吃的，我吃不下了，他们就往屋子里放。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是，他们也说不知道我爸爸妈妈去哪了，真奇怪…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"关联词条","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501808\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/15/317305234/3815df205bd386b5031aea49d4881792_5320842348032762827.png\\\" data-entry-name=\\\"绍元之墓【天衡山】\\\" data-entry-link=\\\"/ys/obc/content/501808/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/501808/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" cla