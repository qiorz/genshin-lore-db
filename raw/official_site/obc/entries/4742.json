alse,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"el97pc1ilmT1746577206901\"],\"auq86p39gxfT1746577097244\":[],\"el97pc1ilmT1746577206901\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"auq86p39gxfT1746577097244\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那当然咯。不然你以为我卖的肉都是哪来的，是笨猪往我箭头上撞的吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…哈哈，不开玩笑了。跟着提纳里先生待久了，连说话方式都跟他差不多了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我是巡林队里负责后勤的人，会打猎做饭不是很正常嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要我说，想当个好厨子，就得先当个好猎人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你会打猎？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有了这些新鲜的肉，就算是笨蛋也能做出好吃的菜！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"auq86p39gxfT1746577097244\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，怎么还跟我杠上了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看你长得眉清目秀、通情达理的，不像是不讲道理的人啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦，我明白了！你一定是想用激将法，骗我的肉吃！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过没关系，在分享美食方面，我不介意上当。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只有一个要求，你吃完如果觉得好吃的话，得帮我宣传宣传啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4388\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/07/24077343/57d9c5482a414984898b7483423807e2_5633088460961994868.png\\\" data-entry-name=\\\"烤肉卷\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/4388/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/4388/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/07/24077343/57d9c5482a414984898b7483423807e2_5633088460961994868.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e烤肉卷\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/288180982/b26706122e54335e75a99308e473cc62_1002357358266142155.png\",\"option\":\"【我不信。】——获得烤肉卷*3\"},\"el97pc1ilmT1746577206901\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，想吃肉时可以来找我！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦吼，看来是识货的人啊，想要什么自己挑吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/288180982/11ee64c710e3b091256c0d349ac55461_3579296654680249768.png\",\"option\":\"【我也想要新鲜的肉。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，这是问的什么话！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不要看我穿着巡林官的制服，就小瞧我的厨艺！我可是巡林队里大名鼎鼎的「大厨」！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…哈哈，不开玩笑了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然没到「大名鼎鼎」的程度，但我的厨艺确实没的说，周围吃过的人都说好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你会做饭？】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222444","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"