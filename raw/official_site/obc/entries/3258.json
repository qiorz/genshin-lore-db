ents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不愧是五郎大将，真是可靠…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9fcwekhovaiT1713862510748\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e五郎大将可以说是我最崇拜的人了，不仅在战场上有勇有谋，私下里还非常体恤手下，视我们为同生共死的手足。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就连平常兄弟们生活里遇到的各种小事，五郎大将也都会耐心对待，帮我们排忧解难。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这样好的将领，我敢说没有别的地方可以找到了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于五郎…】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是珊瑚宫军队的武士，在五郎大将不在的时候，这里由我负责。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你也听说了吧，我们可是在前线顶住了幕府大军的攻势！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e必须得说，正是因为有了五郎大将的领导，我们珊瑚宫军才能获得现在的成果！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，要是我也能像五郎大将一样厉害…说笑了，哈哈！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713882795","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692