9/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"20000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"1rq0o1sqt0iT1717603649868\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e在我认识娜维娅之前…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【成为最强决斗代理人之前的故事！】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…要来玩有关「决斗」的游戏吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你回来了。我想问问你，有没有专供训练的场所？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我担心在这里练习打靶会吵到别人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8msaxonz74uT1717603767921\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那么恭喜你，你可以选择自己最顺手的武器，外加一次无视致命攻击的机会。我要击中你两次才能赢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【如果骰到了「大成功」…】\"},\"b0d3k0p335T1717603767001\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那么很抱歉，你必须绑住自己的双手双脚来和我决斗。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【如果骰到了「大失败」…】\"},\"dkzvxahayopT1717603571290\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我钦佩它的原理与设计，令人大开眼界。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，感谢你的邀请。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还会再多待一段时间，希望并不构成对你的打扰。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【毕竟是壶中洞天嘛。】\"},\"ek1mg7odym5T1717603572672\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e因人而异，看你心情。我不了解你的笑点高低，不适合为你做出推荐。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，感谢你的邀请。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还会再多待一段时间，希望并不构成对你的打扰。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【…我该笑吗？】\"},\"fnveas1sizT1717603843521\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，安心休息吧。这里足够安全，看样子不需要我来守夜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，克洛琳德。】\"},\"kygo1oju2kT1717603743444\":{\"dialogue\":\"\u003cp\u003e很简单，用「命运示数牌」来决定决斗的规则和使用的武器。我以前和师父常玩，不过那时用的是骰子。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【我先问问怎么玩…】\"},\"m7dzildip3T1717603842463\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早安，祝你今日一切顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，克洛琳德。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e放心，我对环境并不挑剔。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e拥挤，空旷，吵闹，安静…这些对我来说无关紧要，我向来不受外在因素的影响。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至于生存方面的隐患…我暂时还没有发现。这点不错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"rencm7ubuuT1717603793238\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e的确。但那是审判庭上用来自证名誉的决斗。这个游戏是用来锻炼逐影猎人野外生存能力的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时候，你就算是断了腿，又折了胳膊，依然需要同魔物战斗。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「永远不能停止思考如何胜利」——这是师父教给我的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她也有次运气非常不好，武器还只骰到了一根小树枝，结果我还是输了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不论如何，这都是一个充满随机性的游戏，尝试一下自己极限也未尝不可。输了马上重来就行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么样？你准备好了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我以为「决斗」要讲求公平…】\"},\"rxcqk2scuqoT1717603651716\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e工作…嗯…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e即使你把「工作」和「趣闻」两个词组放进同一个杯子里，它们也会分层。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我听说，不少同事曾在下班途中被隔天的决斗对象拽住，拖进咖啡馆里，听对方痛诉衷肠。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很浪费时间的行为，不是吗？我很高兴我从没遇上过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我不建议你继续打听下去。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们这一行很容易见到过剩的故事性与戏剧感，但它们多半虚伪且肮脏…你会失望的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【决斗代理人工作中的趣闻！】\"},\"sj7kuel19maT1717603570143\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e别客气，这是你的功劳，应当道谢的反倒是我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，感谢你的邀请。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还会再多待一段时间，希望并不构成对你的打扰。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【谢谢？】\"},\"sxd70y5igqT1717603824363\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，你的眼神比你自认为的更加坚定。我欣赏。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那就开始吧，输了的请吃饭。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【来…来就来！】\"},\"ypeve60crfT1717603686757\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e既然你想听的，是与如今我的生活截然不同的故事，我认为那会是一个很好的节点。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那时，我和师父朝夕相处。她是一位强大而又严格的人，对我的童年造成了许多影响。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我曾害怕夜行的魔物，因为不知它们会从哪个地方发起攻势。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她用布蒙上了我的双眼，把我推到林间，说「这里全是魔物」，要我在白天也靠听觉与直觉做出反应。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我曾惧怕孤独，在她离开我身边后便难以入睡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后来很长一段时间，她都要我每天练习到再也抬不动手之后才放我去休息。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e每天早上睁眼看到师父的脸，反倒成为了新的噩梦…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知不觉，我也成为了一个如她一般坚强的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而可怕的是，如果现在要我收一名徒弟，我想不出比她当年更好的教育方法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那么早吗？！】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然。你有什么感兴趣的话题吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1rq0o1sqt0iT1717603649868\":[\"ypeve60crfT1717603686757\"],\"4cf2vhylew3T1710863944349\":[\"kygo1oju2kT1717603743444\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"m7dzildip3T1717603842463\",\"fnveas1sizT1717603843521\"],\"8msaxonz74uT1717603767921\":[\"rencm7ubuuT1717603793238\"],\"b0d3k0p335T1717603767001\":[\"rencm7ubuuT1717603793238\"],\"dkzvxahayopT1717603571290\":[],\"ek1mg7odym5T1717603572672\":[],\"fnveas1sizT1717603843521\":[],\"kygo1oju2kT1717603743444\":[\"b0d3k0p335T1717603767001\",\"8msaxonz74uT1717603767921\"],\"m7dzildip3T1717603842463\":[],\"nqb471m7nmnT1710863941173\":[\"sj7kuel19maT1717603570143\",\"dkzvxahayopT1717603571290\",\"ek1mg7odym5T1717603572672\"],\"rencm7ubuuT1717603793238\":[\"sxd70y5igqT1717603824363\"],\"rxcqk2scuqoT1717603651716\":[],\"sj7kuel19maT1717603570143\":[],\"sxd70y5igqT1717603824363\":[],\"ypeve60crfT1717603686757\":[],\"z2tn3pzsbujT1710863943430\":[\"1rq0o1sqt0iT1717603649868\",\"rxcqk2scuqoT1717603651716\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1717639800","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"地区\\\"