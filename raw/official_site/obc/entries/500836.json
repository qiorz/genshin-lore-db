h_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"001b0jnt9uyqaT1713355879142\":[\"i2ne7m2nhiT1713355889256\",\"x9uf9t3oae9T1713355890058\"],\"1q8cdvn2xo4T1713355902748\":[],\"8rwauub84yrT1713355866203\":[\"001b0jnt9uyqaT1713355879142\"],\"afoc2gbm2rsT1713355801658\":[\"qcw7ceul3faT1713355815004\"],\"djx62vdmljmT1713355824397\":[\"mvxy1yix597T1713355857570\"],\"ewllh0qqr0dT1711546416025\":[\"afoc2gbm2rsT1713355801658\",\"jcfvldu3rfT1713355802645\"],\"i2ne7m2nhiT1713355889256\":[\"1q8cdvn2xo4T1713355902748\"],\"jcfvldu3rfT1713355802645\":[\"qcw7ceul3faT1713355815004\"],\"mvxy1yix597T1713355857570\":[\"8rwauub84yrT1713355866203\",\"sfy7pukdmkT1713355866865\"],\"qcw7ceul3faT1713355815004\":[\"djx62vdmljmT1713355824397\",\"zk8yhxyhtklT1713355825119\"],\"sfy7pukdmkT1713355866865\":[\"001b0jnt9uyqaT1713355879142\"],\"x9uf9t3oae9T1713355890058\":[\"1q8cdvn2xo4T1713355902748\"],\"zk8yhxyhtklT1713355825119\":[\"mvxy1yix597T1713355857570\"]},\"contents\":{\"001b0jnt9uyqaT1713355879142\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，我这不是想要取一些壮观的景色，放在映影里壮壮声势吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谁知道拍得太入神，被这些盗宝团抓住了空档，我们一路跑到了这里，结果还是被堵住了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等等，难道斡流小姐之前说的那几位专业的留影师，就是…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e没错，就是邱老板他们。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e斡流小姐，你、你是从哪冒出来的？我刚才都没见到你…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e因为我藏得比较好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e原来你们都认识啊…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哎呀，斡流小姐是专业的水文学家，对这附近的地形了如指掌。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于取景点这个问题，我们也请教了她很多次。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们还想请斡流小姐加入我们的映影团队呢！可她说要等到自己有空的时候再考虑…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e老板，那个…我们刚才跑的时候，好像把装着画片和设备的箱子放在原地了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e里面…好像还有我们拍了一部分的映影画片…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e……\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e斡流小姐！玩家，派蒙，多谢你们了啊！有…有空的话，就来翘英庄找我吧！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e无论怎么说…这救命之恩，多少得为你准备点报酬。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们就先告辞了啊！快快快！那个箱子放哪了！快走快走！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板一行人急匆匆地离开了…\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e感觉…邱老板他们的箱子，真是多灾多难呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e俗话说「好事多磨」，邱老板一定能拍出很不错的映影。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e好了，我先把报酬结给你们吧。等一下我就去安置最后一台仪器，然后…我也会找个时间，去和邱老板聊聊。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不然，他们不知道又要跑去什么地方拍映影了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔，他们刚才说，可以去翘英庄找他们吧…等一下我先去那边找找好了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e在翘英庄寻找邱老板\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，还是先把翘英庄里的景取了吧…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"1q8cdvn2xo4T1713355902748\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e玩家，派蒙，哎哟！托了你们的福，设备和画片一点没丢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过，我们下次想要去那边取景，看来必须得去雇几个冒险家同行了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e所以，你们那部关于茶的映影，到底拍得怎么样了呀？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e呃…这部片子处于…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e有一个良好的开头。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e和一个良好的趋势。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这不就是才刚开始拍吗？！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哎呀，我们现在的资金…有点紧张，热赛尔先生的收费就和他的学问一样高超…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e虽然我们也拍了几部小片，赚了几笔小钱，但这种大型记录映影，实在是太花钱了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e特别是老板还拒绝了几家过来赞助的客商。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e和谢绝了一堆合作邀请。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们懂什么！这是为了我们能完全依照我们自己的审美，拍出一部好片。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但是老板，我们最开始拍片的目的，不也是为了赚钱吗…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我…你、你们别管这么多，先去把设备支起来！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e玩家，这些报酬给你，多谢你帮我这么多次。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等我拍出了好片，一定请你来看，然后再请你喝一顿好茶。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e弈丰，兴晔，找好光源角度！这次要一遍拍好！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e老板，这又不是拍人和人的对手戏…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e拍景物能不能一遍过，不都是全凭缘分嘛。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e总…总之先把设备架起来！先…先在这等着！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e斡流：\u003c/span\u003e\u003c/em\u003e\u003c/strong\u003e\u003cem\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e希望邱老板能在保证自己人身安全的情况下，拍出她想要的映影。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8rwauub84yrT1713355866203\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：这里…是不是离翘英庄有点远？\"},\"afoc2gbm2rsT1713355801658\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：听起立不算复杂。\"},\"djx62vdmljmT1713355824397\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：这件事就交给我吧。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e水流的流势不错，周围水域的情况也很正常…真是太好了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e周围的土质环境也得在观察一下才行。看来，不得不多放一些仪器了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e发生什么事了？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者？请你留步，我想请你帮我一个…小忙、\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e先自我介绍一下，我叫斡流，是一个「水文学家」，目前正在沉玉谷里搜集和研究水文问题。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e研究水文，为什么要观察土质？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这个问题不错。但想要在这里研究水文，可不能仅仅研究水文。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e山体、水流、地质、天候、还有人们的日常生活，都一同复杂地影响着这里的水文环境。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e听…听不明白，但感觉这是一件很复杂的事呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e确实不算简单。但是和枫丹的水文环境比起来，还是好太多了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e在枫丹考察的时候，我想要放一个水下的水文勘探装置真是难如登天，要么是被水生生物袭击，要么就被洋流冲走。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e还有哪些不知道谁造的水下机关…算了，我真的不想再回忆了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e所以，你要我们帮的忙…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯…也不算是什么大事。我只是想要请你们帮忙把这些检测仪器安置安置在旁边的山上。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这些仪器是我刚刚从枫丹订购的机关装置，安置后就会不断往下钻探，直到取出深层的土壤标本。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e有了这些标本，我就可以测算出水文环境对附近山体土质的影响了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"i2ne7m2nhiT1713355889256\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：一切都还好吗？\"},\"jcfvldu3rfT1713355802645\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：难得接到这么利落的委托。\"},\"mvxy1yix597T1713355857570\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那么，安置仪器的事就交给你们了。只要安置在附加的山坡上就好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我还要在这里调试仪器，安装好仪器之后，就回来找我吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e斡流\u003c/span\u003e\u003c/em\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e：\u003c/span\u003e\u003c/em\u003e\u003c/strong\u003e\u003cem\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e前面那个位置应该不错，唔…等一下去吊桥附近看看好了…\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e帮助斡流安装仪器\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e安装传送锚点旁的仪器\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e别、别往下看！太高了，安置好仪器之后就快走啦！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e安装亭子上方的仪器\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e唔…这里能行吗？算了，我们就相信这台仪器的实力吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e向斡流回报\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…这么调整应该没问题了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者，你们把仪器都安置好了？真是太感谢了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等我把这台仪器也安置好，就把报酬结给你们。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e刚才直接让我一起安置就好啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e多谢你的好意。不过，这台仪器有些特殊，需要调试的地方有些多，要是你来操作的话，实在太麻烦你了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我们先去那边的悬崖上把这台仪器安置好，然后我就可以和你们结清报酬了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e听起来好复杂…你一直都这样工作的吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e现在我只用把仪器安置在陆地上…在有一次考察里，我还不得不想办法把仪器浸到一条大江的中央呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不能直接坐船过去吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，如果只用把仪器沉进江水里，那我当然可以坐着船，过去把仪器丢进水里，然后就离开…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但那次考察我要勘测的是水流强度，所以必须把勘测用的特型仪器持续置于水流的中央，不能浮到顶，也不能沉到底…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e还好那条河上面有一座吊桥，要是没吊桥的话，我就只能求人在两座山之间拉一条绳索…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e再把这台仪器用绳索吊起来，用另一条绳索拉着，一直送到河流中心再放下。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咳…先不说这些了，现在我们也不用处理这种情况…虽然我们等会也要路过一座吊桥。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这边走吧，那座吊桥离我们不远。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e和斡流同行\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e嗯…应该是往这边。这附近的风景很不错，慢点走也没关系。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e之前也有不少专业的留影师不远千里来到这里，就为了记录一张此地的景色呢。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等去吊桥上，你们可以远眺一下周围的景色。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e打倒所有盗宝团\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e？？？：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那边的兄弟，给我守好了！你跑啊！你接着跑啊！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e？？？：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哎哟，累死了，非得老子两头堵…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e？？？：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e救命啊！！！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e他、他们是…不，不管了，我们快去救人吧！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e吊桥两边都有盗宝团…小心啊，旅行者！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e与刚脱困的人对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e赶走了所有盗宝团后，带着被盗宝团围困的人去到了旁边的亭子里休息…\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谢谢，太谢谢你了，您…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你是…邱老板？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e您、您是玩家！怎么遇见您了，这真是…我又欠了您一笔大人情啊！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e派蒙：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们不是在枫丹学怎么拍映影吗？怎么突然回璃月了呀？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e已经学成了？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e与其说是学成了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不如说是不得不「先赚钱」啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你们两个人…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e热塞尔先生的确非常专业，为我们做出的各种指导也非常有用，但是…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e他所指导我们拍的映影，都太过注重表现意义和概念，至于具体的事物和情节嘛…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e用热塞尔先生的话来说，就「让他们退居幕后」了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e兴晔：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但我们要拍的可是用来宣传翘英庄茶叶的映影，这么学下去，根本就是南辕北辙嘛，所以…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e所以！我就决定，暂停学习，先回来拍一部记录映影，用实际的练习来检验我们的学习成果！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…也有一部分原因是，我们的资金快用差不多了啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e邱老板：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e都、都说了，我已经把事情都计划好了，只要我们拍好这部映影，资金不就回来了吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e弈丰：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e然后，就被盗宝团两头堵在了吊桥上，还好有玩家搭救啊。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"qcw7ceul3faT1713355815004\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e话…也不能这么说啦，我听说这附近的野外有盗宝团出没，本来我想雇几位冒险家，可是一直没人接受我的委托…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e斡流：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过，看你们的模样，肯定不会怕那些欺软怕硬的盗宝团，对吧？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"sfy7pukdmkT1713355866865\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：但你们拍翘英庄，来这里做什么？\"},\"x9uf9t3oae9T1713355890058\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：看来你们没损失设备嘛。\"},\"zk8yhxyhtklT1713355825119\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：他们应该怕我。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1731896926","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"