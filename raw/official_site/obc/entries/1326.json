llapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"text-align: start\\\"\u003e\u003cstrong\u003e挑战目标：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e赢得胜利——210【牌手经验】，250【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e5回合内胜利——500【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e打出3张手牌——500【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e\u003cstrong\u003e特殊规则：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我方每回合打出第一张行动牌时，少花费2个元素骰。行动阶段开始时：如果我方出战角色受到护盾保护，则生成2个万能元素，抓2张牌。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e世界任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1245\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/11/13/4833807/5f9af9d051379276e4fc7f76ed7d9bcb_8376231294054532606.png\\\" data-entry-name=\\\"此诗送此城\\\" data-entry-link=\\\"/ys/obc/content/1245/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1245/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e此诗送此城\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1434\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/08/317305234/41a53cbf3d3742b30dd4261689b9e6fc_5590498800543375436.png\\\" data-entry-name=\\\"群玉阁…再现？\\\" data-entry-link=\\\"/ys/obc/content/1434/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1434/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e群玉阁…再现？\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4bg1lyrmpmmT1713079137862\":[],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"4bg1lyrmpmmT1713079137862\",\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"kr6p08gwlxT1713078805414\":[],\"nqb471m7nmnT1710863941173\":[\"kr6p08gwlxT1713078805414\"],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4bg1lyrmpmmT1713079137862\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e真是豪气万丈的牌技！若是不嫌弃，且等我作诗一首，赞颂方才卓绝的牌局！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是一时好运罢了，真正的胜负还未见分晓，再来一局吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/14/72954525/cc2a44c2e85425afbbd461e49fe0875d_5433959797920708926.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请多保重，恕不远送。我将心送十里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「尽日荻海泊钓船…」。唉，不得下句苦我久矣！啊，您好您好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"kr6p08gwlxT1713078805414\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e岩王圣迹我都已经去过了，山水绝景也都有所感悟。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我璃月山水奇绝之处都在深秘之境。所以才「匣中琉璃云间月」一说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e接下来，我就该去访神问仙了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e璃月各处都有白日升仙的传说，曰「云海仙岛一造访，久别天地无数年」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e也就是说，此行一去，绝竟云间。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈哈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你的旅途。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e在下清昼，自诩诗客。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过几年就要承担家业，因此与家父有一故山三年之约。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e趁自己仍在舞象之年，将寻璃月遍处诗迹。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过想要试试自己究竟诗才几石几斗罢了，啊哈哈哈。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【请问你是？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「百战方孑存，万劫苦浩茫。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「掠影傍孤云，祓恶报仙王。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是一首有关一位仙人的诗，不知为何感觉在这里吟诵会非常合适呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵见笑了，见笑了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你有什么作品吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713101845","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attri