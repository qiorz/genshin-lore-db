3338/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e彩糖与蔷薇的幻色颂 第一份礼物「赠予她惊喜」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1pvxe57z3ruT1745942353791\":[],\"4cf2vhylew3T1710863944349\":[\"9tuje8r9tcT1745942338178\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\",\"nud1ogxeizT1745942244329\"],\"9tuje8r9tcT1745942338178\":[\"1pvxe57z3ruT1745942353791\"],\"nqb471m7nmnT1710863941173\":[\"9tuje8r9tcT1745942338178\"],\"nud1ogxeizT1745942244329\":[]},\"contents\":{\"1pvxe57z3ruT1745942353791\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要是我能像你这样豁达就好了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e归根到底，或许是因为我对这座剧场有着感情，也对自己有一定的要求吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过还是谢谢你的安慰，这里有些打造道具剩下的石料，质量很不错，请收下吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"727\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/03/07/184753361/11fc6d41bb5896ee6e6a83a359bcab1b_4207472483324742637.png\\\" data-entry-name=\\\"水晶块\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/727/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/727/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/03/07/184753361/11fc6d41bb5896ee6e6a83a359bcab1b_4207472483324742637.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e水晶块\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/29/288180982/b26706122e54335e75a99308e473cc62_7361669055655077723.png\",\"option\":\"【放宽心。】——获得水晶块*4\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，道具做到一半，想起来又该做场地维护了，得在演出开始前检查完成才行，不然演员可能会有危险。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你在做什么？】——完成妮露传说任务睡莲之章「致智慧者」后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好。现在不是对外演出的时间，周围有些混乱…请注意脚下，和头顶。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9tuje8r9tcT1745942338178\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢赫祖拜尔先生对演出相关的一切事物都有着十分严格的要求，所以我总是担心自己的工作做得不够好…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e道具的外形是不是足够美观，细节是不是充分展现，机关能不能顺利运转…这些都是我每天在努力思考的事情。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时候，我都想去报考妙论派进修了。有几个常客就是妙论派的，和我关系也不坏…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过想想还是算了，又不是真的要我在舞台上建起一座完整的宫殿，对吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【工作顺利吗？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是祖拜尔剧场的道具工程师，除了设计和制作道具之外，也兼顾场地设施的维护工作。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成妮露传说任务睡莲之章「致智慧者」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【你是…】——完成妮露传说任务睡莲之章「致智慧者」前\"},\"nud1ogxeizT1745942244329\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不客气。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【谢谢提醒。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762236952","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"