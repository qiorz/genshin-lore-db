ry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/08/21/183046623/79b77eeb63503f854da4815f8e46ee89_5607193834461311160.png\\\" data-entry-name=\\\"跑，希尔米，跑\\\" data-entry-link=\\\"/ys/obc/content/4848/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/4848/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e跑，希尔米，跑\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【奥贝德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好无聊啊。大哥哥们又不让咱打水漂，要不——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【希尔米】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，你不会又要提议那个了吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥贝德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对，就是那个——\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「保卫阿如村·大演习」！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e第一步，先封路！走，我们去堵住吊桥…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【希尔米】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不要了吧。在我们跑到吊桥之前，就会被哈巴奇哥哥抓回来的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥贝德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那、那怎么办嘛…要不你想个好玩的游戏？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【希尔米】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…要不我们比赛去爬…什么颜色来着，我总是忘记名字。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…总之就是爬那个升降梯！看谁爬得更快更高！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥贝德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，听上去还挺有意思的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是换这个的话，一定又会被卡齐姆大叔教训了吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762236948","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeate