/2023/03/14/5700838/540cbdfc0863929b93b09ad72ab4ead3_1568466514611463655.png\\\" data-entry-name=\\\"邀约事件·云堇 第一幕「弦歌知雅意」\\\" data-entry-link=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e邀约事件·云堇 第一幕「弦歌知雅意」\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e世界任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1136\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/5f9af9d051379276e4fc7f76ed7d9bcb_4169335007544946.png\\\" data-entry-name=\\\"海上盛珠钿\\\" data-entry-link=\\\"/ys/obc/content/1136/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1136/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海上盛珠钿\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6pk33m7wa83T1717824732499\":{\"option\":\"【这里是什么地方？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，这可是整个璃月最值得一来的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…按我们至冬国的气候和环境，可造不出这种饭店呐，啧啧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e咳咳，虽然我来璃月的初衷是做生意赚钱，但现在我已经彻底没心思经商了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…那怕是凝光大人请我到群玉阁谈生意我都不想去。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"mu90ja8quc8T1717824734136\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e别害羞啊，有空一起吃一杯，我认识个乐师弹琴可是一绝…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这「珠钿舫」真是名不虚传，男的英俊帅气，女的闭月羞花…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哪怕只是看看，也算是不虚此行了啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"6pk33m7wa83T1717824732499\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"mu90ja8quc8T1717824734136\":[],\"nqb471m7nmnT1710863941173\":[\"6pk33m7wa83T1717824732499\",\"mu90ja8quc8T1717824734136\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1718038143","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos