03e\u003ca href=\\\"/ys/obc/content/1584/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（轻策庄的霄灯）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"csnr6sv3hkpT1746602597151\",\"tz00gqun0eT1746602611067\"],\"csnr6sv3hkpT1746602597151\":[\"l4qlg98cjgiT1746602671033\"],\"l4qlg98cjgiT1746602671033\":[],\"nqb471m7nmnT1710863941173\":[],\"tz00gqun0eT1746602611067\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e古华派的那小子，自那以后我就没见过他了，现在八成也在做些莫名其妙的事吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过我总觉得有点古怪，他的身份可能没那么简单…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e算了，和我也没什么关系。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于行秋…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e什么风把你吹来了？快请进，快请进。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"csnr6sv3hkpT1746602597151\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你说那群种地的穷鬼？哼…真是晦气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我常九爷只是暂时不得不与他们当邻居，等我重振了家业，他们就连我脚后跟都摸不着了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于邻居…】\"},\"l4qlg98cjgiT1746602671033\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，那我就借你吉言了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e上次你帮了我这么大忙，我也得谢谢你才是。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些夜泊石你们也收下吧，虽然说不上贵重，不过权当做上次的纪念。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"752\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/f70c51d39c7da1b40370de615078bb19_6106335164052246339.png\\\" data-entry-name=\\\"夜泊石\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/752/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/752/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/f70c51d39c7da1b40370de615078bb19_6106335164052246339.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e夜泊石\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/24077343/b26706122e54335e75a99308e473cc62_849671803859438367.png\",\"option\":\"【祝你一切顺利】——获得夜泊石*4\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不记得我了？是我啊，常九爷！之前你来我这里买了好多石珀的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可能是你见过的人太多，记不得我了也正常…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想当年我还在绯云坡做生意的时候，谁听到我的大名都要抖一抖。唉，哪像现在…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"tz00gqun0eT1746602611067\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走啊。再过不久，我们就会在璃月港再见了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多亏了你，那批石珀能卖出不错的价钱，简直救了命了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我就知道我的眼光不会错的，虽然做生意有很多波折，但能赚钱的东西它就是能赚钱。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，我用那笔钱买来了更多的矿石，等我矿石的生意周转起来，我就能从这个鬼地方搬走了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到时候，整个璃月港都会知道「那个常九爷他回来了」！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那以后怎么样了？】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1765648372","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{