null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"n9oe7xd8qkT1746522697375\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"n9oe7xd8qkT1746522697375\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e你好，欢迎光临鄙店。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"n9oe7xd8qkT1746522697375\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里偶尔也兼顾一些珠宝之外的生意，客人请便吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么在卖？】——梦之树达到50级后、打开商店界面\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e目前在售的珠宝都已经被预定走了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说店中的那些？很多都是我自己的收藏，仅做展示罢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【有什么在卖？】——梦之树达到50级前\"},\"rzvg3z5v2hnT1746522689372\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"wymiwrawazT1746522730928\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是古董收藏家，偶尔也做些珠宝生意。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e珍贵的古董都值得珍藏，价格也不是普通人能承受得起的，所以我并不在乎是不是能做成买卖。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我更在乎的，是能不能有更多像桑歌玛哈巴依老爷那样眼光犀利的供货商，为我提供最具价值的收藏品。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…这样说来，做生意似乎只是我的副业了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至于主业…大概是把我的儿子培养成和我一样有眼光的收藏家吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e费雷斯特是个很有天赋的孩子，他一定可以成为比我还有名的古董鉴赏专家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己…】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762236688","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"t