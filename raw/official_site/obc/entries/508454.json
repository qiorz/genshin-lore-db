e}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"obu89qsvuzT1776589861876\"],\"ee359nyedqnT1776589592449\":[\"zvcpfwuv0cT1776589652084\"],\"flvflakxa2tT1778416140918\":[\"gq849vp918bT1778416334574\"],\"gq849vp918bT1778416334574\":[],\"jiet1uy3akeT1776589970408\":[\"flvflakxa2tT1778416140918\"],\"k0e4k05762cT1776589969103\":[\"flvflakxa2tT1778416140918\"],\"nqb471m7nmnT1710863941173\":[\"ee359nyedqnT1776589592449\"],\"obu89qsvuzT1776589861876\":[\"flvflakxa2tT1778416140918\"],\"z2tn3pzsbujT1710863943430\":[\"k0e4k05762cT1776589969103\",\"jiet1uy3akeT1776589970408\"],\"zvcpfwuv0cT1776589652084\":[\"flvflakxa2tT1778416140918\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e【未使用\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e巴巴托斯大人，愿您聆听，这风中的心愿…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【使用\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e后】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好香的气味…欸？原来是香水吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ee359nyedqnT1776589592449\":{\"option\":\"【完全没看到教堂…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那是当然的，这里毕竟是荆夫港。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e早在风神大人推翻高塔暴君的统治前，这里便是古恩希尔德家族的采邑，而他们也曾在这里建立起蒙德最初的圣堂。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是，在旧贵族统治的黑暗时代，教会逐渐沦为了宗室的傀儡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了表明与日渐专政的伊蒙洛卡家彻底决裂，古恩希尔德的祖先将蒙德城派来的主教从圣堂的高塔上掷出了窗外，并拆毁了圣堂。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对西风教会而言，古恩希尔德家族的所作所为才是真正的虔敬之举，代表着「与一切假借信仰之名行恶之徒势不两立」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因此，在那之后，圣堂就再也没有被重新建起来…这地方现在也就连个屋顶都没有了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"flvflakxa2tT1778416140918\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【随机刷新与洛恩的场景对话】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"gq849vp918bT1778416334574\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【汉娜洛蕾】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e洛恩先生，我觉得有必要跟您谈谈告解的事…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【洛恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？我做了什么需要告解的事吗？我怎么不记得？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【汉娜洛蕾】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e您还记得史图维尔他们吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【洛恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那三个吵吵嚷嚷的坏小子吧，记得。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【汉娜洛蕾】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e前些天他们突然哭着喊着要来告解，说是要承认自己的恶作剧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【洛恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦？有点意思，他们干什么了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【汉娜洛蕾】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…溜进了玛莎婆婆的屋子，想把奶油涂到她脸上。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但莫里兹提尔在望风的时候，头顶的铃铛突然被风吹响，吓得他立刻逃远了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e麦克斯打算偷偷溜进里屋的时候，一阵风把脚边的蜂蜜罐吹倒了，直接惊醒了玛莎奶奶。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后史图维尔拼命往外逃的时候，背后又是一阵风，直到跑回了朋友身边才发现身上多了一张纸…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【洛恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e——是不是写着「风神一直在看着你」？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵呵，这不是挺好的嘛？世上少了三个捣蛋鬼，多了三个虔诚的风神信徒…虽然顶多撑个两天吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【汉娜洛蕾】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳，洛恩先生，不管出于什么目的，吓唬小孩子都得适可而止…还有冒用风神大人的名字也是！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jiet1uy3akeT1776589970408\":{\"option\":\"【离开。】\",\"dialogue\":\"\",\"icon\":\"\"},\"k0e4k05762cT1776589969103\":{\"option\":\"【（赠送香氛。）】———赠送香水·风息*1，获得《爱、圣启与美德的典律》、大英雄的经验*2、摩拉*21500、特制香水·风息*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你的慷慨。只不过，我是西风教会的修女，不能收下来自他人的财物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对我而言，能借着海风嗅到这般美妙的芬芳，便已经足够了。将美好的事物留给风，而非独自占有，才是虔信者应行之事。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，你这份如南风般和煦的善意，我确切地收到了。作为回礼，请你收下这本书吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e愿风神护佑你。愿你未来的道路，也能如这香氛一般，盈满美德、自由与仁爱。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508365\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/eeeaae1d0fb039aac24f3ac73159bddd_4129737700760582358.png\\\" data-entry-name=\\\"《爱、圣启与美德的典律》\\\" data-entry-link=\\\"/ys/obc/content/508365/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508365/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/eeeaae1d0fb039aac24f3ac73159bddd_4129737700760582358.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e《爱、圣启与美德的典律》\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1025\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/d50fb37e3954b2b7105c61cf8f442c6e_7679619291811796065.png\\\" data-entry-name=\\\"大英雄的经验\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/d50fb37e3954b2b7105c61cf8f442c6e_7679619291811796065.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大英雄的经验\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"21500\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*21500\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/19/288180982/cc70592f615b485afe4437ec77de50a8_1656839164125832079.png\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你在做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我在聆听风的声音…还有人们的声音。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里往来的商人与水手众多，带来的自然不只有货物，还有深埋心底的秘密与罪恶。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e聆听他们的告解，安抚他们的内心，这就是我们西风教会应当做的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"obu89qsvuzT1776589861876\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。愿风护佑你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【关于香氛…】——使用后特制香水·风息后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，你的香氛很特别，清新而不甜腻，就像是初春时节拂过摘星崖的微风。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e许多人在告解前都会用些香氛，毕竟告解与祷告一样，都是正式的圣事，而不远处的风车镇又恰好盛产这些…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但你的气息要温柔得多，有一种能让人安下心来的感觉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果在聆听告解时点缀些许这样的香气…那些满怀愁绪来到这里的人，他们紧绷的灵魂或许也会稍稍放松一些吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zvcpfwuv0cT1776589652084\":{\"option\":\"【荆夫港是古恩希尔德家的？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不是。温妮莎大人起义后，古恩希尔德家族主动牵头废除了所有世袭的宗室采邑，将土地与自由还给了蒙德人民。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看看现在吧。当初不可一世的伊蒙洛卡家已经绝嗣，他们的帮凶也早已荣光不再。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e时间总会平等地冲垮一切强权，唯有风依然吹拂如初。这也是巴巴托斯大人的恩眷。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1782094583","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg