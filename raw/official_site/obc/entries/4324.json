bc/content/4324/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/06/380453694/4751f1b480da9c872bd22d12f744eb58_308730757445567355.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e为了圆满的送别\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"1601","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1368","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"为了圆满的送别","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"list\":[{\"key\":\"触发条件\",\"value\":[\"完成前一任务后触发\"]},{\"key\":\"等级限制\",\"value\":[\"冒险等阶≥40级\"]},{\"key\":\"特殊限制\",\"value\":[\"完成魔神任务：第一章·第二幕「辞行久远之躯」\"]}]}","style":""}],"id":"1593","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1367","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e原来狼哥的魂灵是被驱咒仪式吸引而来，在了解到狼哥并非恶鬼，只是关心老孟以及其他童年好友的生活现状之后，胡桃决定满足他的心愿，并为他举办一个欢送仪式。为了解开狼哥的心结， 你从他的童年好友那里获得了信物，还获得了他们对狼哥的祝福。现在一切就绪，只待启程与送别。\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e将信物带去无妄坡，交给胡桃\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e前往胡桃所说的「寻常之地」\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e沿路深入，前往边界\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e继续向前，见证欢送仪式\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与胡桃交谈，等待两人叙旧\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e回到无妄坡，为狼哥送别\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1595