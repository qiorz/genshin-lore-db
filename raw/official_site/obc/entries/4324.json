652.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用魔矿\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*6\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1610","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1370","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e从老孟那里，你得知狼哥是他的童年好友，因意外身亡，而现今灵异事件频发，老孟认为是狼哥化作了厉鬼，心中颇为惋惜与担忧。和老孟同样相信凶鬼恶灵传说的，还有一-位前来拜访往生堂驱咒的洛成。而胡桃知道让他们如此不安的东西其实只是心理作用，于是将计就计，设下了假的驱咒仪式。没想到仪式之后，狼哥的魂灵竟然主动出现了。\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e返回往生堂，了解来龙去脉\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e找小五寻求信物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e寻找绝云椒椒并交给小五\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与小五交谈\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e找木木寻求信物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e找聪子寻求信物\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e与仓库管理员交谈\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在货物堆中寻找浮生石片\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e将浮生石片交给聪子\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1602","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1369","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-u