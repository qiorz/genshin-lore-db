位名叫狼哥的人。\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e回往生堂向老孟了解情况\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e前往驱咒地点\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e守护地脉镇石，击退敌人\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听胡桃对洛成讲述诅咒真相\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1609","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1369","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5349259235170137229.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"400\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5349259235170137229.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*400\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/f8bacc007a6b264469a5e2b9c142b493_6744947693065748314.png\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"27825\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_hea