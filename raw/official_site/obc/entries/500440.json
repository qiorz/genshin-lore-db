pan\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;琢光镜\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;值。如果消耗\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;琢光镜\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;为0/1/2，则为角色附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;为3/2/1的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;琢光镜\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e时：如果消耗了\u003c/span\u003e\u003cstrong\u003e\u003cu\u003e持续回合\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;持续回合：\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;每回合结束阶段，\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;-1；\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e至少为1的\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e琢光镜\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;琢光镜：\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;状态\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;角色造成的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;物理伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;变为\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;角色普通攻击后：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;造成1点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。如果此技能为\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;重击\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，则使此状态的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;+1。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;：2（可叠加，最多叠加到3回合）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，则总是附属\u003c/span\u003e\u003cstrong\u003e\u003cu\u003e持续回合\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;持续回合：\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;每回合结束阶段，\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;-1；\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e为3的\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e琢光镜\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;琢光镜：\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;状态\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;角色造成的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;物理伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;变为\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;角色普通攻击后：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;造成1点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(82, 196, 26)\u0026quot;\u0026gt;草元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;。如果此技能为\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;重击\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;，则使此状态的\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;+1。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;持续回合\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u0026gt;：2（可叠加，最多叠加到3回合）\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，并且抓1张牌。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e（牌组中包含艾尔海森，才能加入牌组）\u003c/span\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"2","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"卡牌故事","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e艾尔海森·正理\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e「理论的推演。」\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"3","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1703038939","langs":[],"template_layout":{"tab":[{"tab_id":"1","tab_name":"页签1","module_group":[{"module_group_id":"1","layout":"l1r1","module":[{"id":"1","pos":"left"},{"id":"2","pos":"right"},{"id":"3","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"234","name":"行动牌","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"行动牌","is_hidden":false,"parent_id":"231","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"cardFilter\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"