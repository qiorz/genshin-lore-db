74114945/f8bacc007a6b264469a5e2b9c142b493_5642902498231244136.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*25000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/20/76078930/2784cbacdcbdd60681864ef5970833b6_4296366486827041250.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e帮助全能美食队捕捉雷樱树旁边的螃蟹\u003c/p\u003e\u003cp\u003e（其实拿雷种子也没用，要做完世界任务【医樱】后雷樱树才不会伤人哦）\u003c/p\u003e\u003cp\u003e玩家攻略推荐：\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/7651530\\\" target=\\\"_blank\\\"\u003e【稻妻系列世界任务·其1】全能美食队\u003c/a\u003e\\t\\t作者：\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(102, 102, 102)\\\"\u003eDramaturge\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4wcsmlbxwt5T1713303285308\":[],\"ek0pcz192zjT1713303246487\":[\"4wcsmlbxwt5T1713303285308\"],\"ewllh0qqr0dT1711546416025\":[\"o006pyjimm7T1713303246072\",\"ek0pcz192zjT1713303246487\"],\"o006pyjimm7T1713303246072\":[\"4wcsmlbxwt5T1713303285308\"]},\"contents\":{\"4wcsmlbxwt5T1713303285308\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e喔！旅行者，嘿嘿，我就说嘛，我们肯定还会再见面的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e朱莉：\u003c/strong\u003e旭东刚从城里拿到的一份新食谱喔！叫做「蟹黄壳壳烧」，怎么样，名字很好听吧？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e这道菜做起来倒也不复杂。但这道菜需要很多螃蟹…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e我已经准备了一些普通的螃蟹，正准备找一些…特别的螃蟹。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旅行者：\u003c/strong\u003e特别的螃蟹？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e没错，就是盘踞在那棵雷樱树下的螃蟹！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e你不如直接说…被雷劈过的螃蟹…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e哈哈哈，总之我很好奇啦，生活在这种环境下的螃蟹…吃起来会是什么口感。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e不过…因为那棵雷樱树旁边落雷不断，我们也不敢靠近…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e我的那本书上说…和之前一样，要先去触摸一下「雷樱枝条」，让一种叫做「雷种子」的东西附着在你身上…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e这样的话，你就不会被雷樱树旁边的落雷劈到…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e但那棵树旁边落雷的声势你也看见了，就凭这么粗略的记录，我可不敢去尝试…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e但只要跑得够快，应该就没问题了吧？\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e我说你啊…你跑得再快，能有雷落下来的速度快吗？！\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e朱莉：\u003c/strong\u003e那我们就在外面，用树枝什么的把螃蟹夹出来…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e要我说，我们干脆直接在旁边挖一条沟渠，把水和螃蟹一起引出来好了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e哈哈哈…大家都在各抒己见，不错不错。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e旅行者，如果你愿意的话，也去试试抓一下那棵雷樱树旁的螃蟹吧。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e如果抓到的话，就拿来给我，我会做一顿大餐好好感谢你的。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e哦对了，稍等一下…这些诱饵你拿好。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e如果你要去那边抓螃蟹的话，就先用这些诱饵来吸引它们吧。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e这样的话，你抓螃蟹的时候应该也会省事一些。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e在雷樱树旁生活的螃蟹…唔，不知道味道到底如何…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e芭尔瓦涅的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e\u003cspan\u003e我的那本书上说，只要去触摸一下「雷樱枝条」，就不会被雷樱树旁边的落雷劈到…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e\u003cspan\u003e但那棵树旁边落雷的声势你也看见了，就凭这么粗略的记录，我可不敢去尝试…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch3 style=\\\"text-align: center\\\"\u003e朱莉的场景对话\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e朱莉\u003c/span\u003e：\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e这附近有没有比较硬的树枝呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch3 style=\\\"text-align: center\\\"\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e旭东的场景对话\u003c/span\u003e\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e旭东\u003c/span\u003e：\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e唔…挖一条沟渠是不是费时太长了点呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch2 style=\\\"text-align: center\\\"\u003e在雷樱树旁捕捉螃蟹\u003c/h2\u003e\u003ch2 style=\\\"text-align: center\\\"\u003e将捕捉到的螃蟹交给旭东\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e怎么样旅行者，你的收获如何？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e喔！这只螃蟹看起来不错，你挺厉害的嘛。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e好了，既然材料都齐全了，那就开始准备烹饪吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e我先准备一下，旅行者，你再稍等一会吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东开始了烹饪…\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e壳壳烧…为什么要叫壳壳烧呢…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e算了，还是先做出来再说吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e完成了！这就是「蟹黄壳壳烧」了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e朱莉：\u003c/strong\u003e\u003cspan\u003e我要一个！嗯…就这个好了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e\u003cspan\u003e给我个小一点的，太大的我可吃不完…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e喏，这一份是你的，旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e还有这份「蟹黄壳壳烧」的制作方法，我也给你抄了一份。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e这道菜做起来倒还算简单，你有空的话也自己试试看吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e接下来我们准备去八酝岛附近转转，如果你有空的话，可以来找我们。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e好了，我也得去吃一点了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e\u003cspan\u003e喂！朱莉！给我留一个，别吃完了啊！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e和旅行者一起享受完美餐后，\u003c/span\u003e「全能美食队」离开了…\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ek0pcz192zjT1713303246487\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：又是什么好吃的？\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e旭东：\u003c/strong\u003e这道菜的名字还真是，很有朱莉的风格。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e芭尔瓦涅：\u003c/strong\u003e嗯，第一次看的时候，我还以为是蒙德的菜，没想到居然是稻妻本土的特色菜…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e朱莉：\u003c/strong\u003e名字都这么好听，肯定也很好吃，旭东，拜托啦！\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"o006pyjimm7T1713303246072\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：又见面了。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713319278","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\