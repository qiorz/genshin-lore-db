士\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"6143","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"iz25ku95i4T1746504122960\",\"child_ids\":{\"4o3f5xhuvmxT1746504500077\":[\"e6c4zryb278T1746506451818\"],\"4t4f8c2k699T1746612718689\":[\"ax788pxxo8wT1746504470374\",\"lp7458bj5okT1746504472160\",\"4o3f5xhuvmxT1746504500077\"],\"ablnw0t78hpT1746612717581\":[\"ax788pxxo8wT1746504470374\",\"lp7458bj5okT1746504472160\",\"4o3f5xhuvmxT1746504500077\"],\"ax788pxxo8wT1746504470374\":[\"e6c4zryb278T1746506451818\"],\"e6c4zryb278T1746506451818\":[\"waoeuuqojdT1746506476241\"],\"exqei5nkvmaT1746612715688\":[\"ax788pxxo8wT1746504470374\",\"lp7458bj5okT1746504472160\",\"4o3f5xhuvmxT1746504500077\"],\"iz25ku95i4T1746504122960\":[\"exqei5nkvmaT1746612715688\",\"ablnw0t78hpT1746612717581\",\"4t4f8c2k699T1746612718689\"],\"lp7458bj5okT1746504472160\":[\"e6c4zryb278T1746506451818\"],\"waoeuuqojdT1746506476241\":[\"zrxawvlkg8T1746506700696\"],\"zrxawvlkg8T1746506700696\":[]},\"contents\":{\"4o3f5xhuvmxT1746504500077\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cp\u003e多多积累你在这座城市的声望吧，路总会越走越宽的。\u003c/p\u003e\",\"icon\":\"\"},\"4t4f8c2k699T1746612718689\":{\"option\":\"【开场白】——蒙德声望达到7级后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好久不见，今天是为骑士团的工作而来的吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e⋯如果你是骑士团正式成员就好了，希望骑士团未来能有更多像你这样能干的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7a5d768m3mgT1746506277267\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"ablnw0t78hpT1746612717581\":{\"option\":\"【开场白】——蒙德声望达到3级后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是你啊，最近骑士团人手有些不够用⋯不知道你是否有空来帮帮忙？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ax788pxxo8wT1746504470374\":{\"option\":\"【我在蒙德城的声望⋯】——解锁蒙德声望后、打开声望界面\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/24077343/60e98896f16b1e2f98bb1952b677ae4f_4584396931930760421.png\"},\"e6c4zryb278T1746506451818\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次佳酿节（2022）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"exqei5nkvmaT1746612715688\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很高兴见到你，来找我有什么事吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"iz25ku95i4T1746504122960\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"lp7458bj5okT1746504472160\":{\"option\":\"【关于你自己⋯】\",\"dialogue\":\"\u003cp\u003e我是骑士团负责后勤的第六小队队长，叫我赫塔就可以了。\u003c/p\u003e\u003cp\u003e我的工作一般来说包括物资辎重的采购和管理，骑士团各类资源的调用与登记。\u003c/p\u003e\u003cp\u003e⋯当前蒙德的状态你应该也有所了解，大团长带走了许多人力，骑士团一直处在人手紧缺的状态。\u003c/p\u003e\u003cp\u003e与此同时，我这边清点的后勤物资又相对过剩⋯所以我是很乐意以报酬的形式用物资换些人力支持的。\u003c/p\u003e\u003cp\u003e对处理各类问题有些手腕的人可以来尝试一下，也是为了给辛勤的代理团长减轻一些负担。\u003c/p\u003e\u003cp\u003e前提是你要得到蒙德城大家的信任，就从帮助居民做些小事开始积累声望如何？\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"waoeuuqojdT1746506476241\":{\"option\":\"【关于埃泽⋯】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，你听到了？埃泽先生就是酒业行会的那位执行主席。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e今年西风骑士团联合西风教会和冒险家协会共同举办「美酒集市」，本来是需要特别规划一下预算的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没想到埃泽先生却来邀我详谈了一次不错的合作，帮助我们解决了不少资金方面的问题。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然他没有明说⋯但我猜，这次资助大概来自那位曾经的骑士团前辈的指示吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zrxawvlkg8T1746506700696\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"6144","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746671841","langs":[],"template_layout":{"tab":[{"tab_id":"75","tab_name":"页签1","module_group":[{"module_group_id":"702","layout":"l2r1","module":[{"id":"1229","pos":"left"},{"id":"1230","pos":"right"},{"id":"6143","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"703","layout":"l1r1","module":[{"id":"1231","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"704","layout":"l1r1","module":[{"id":"1232","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"705","layout":"l1r1","module":[{"id":"1233","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"706","layout":"l1r1","module":[{"id":"1234","pos":"banner"},{"id":"6144","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"att