72d3c636003d29e2930af3ce4e4767_1545323688639804783.png\\\" data-entry-name=\\\"生活的意义是…？\\\" data-entry-link=\\\"/ys/obc/content/501506/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/501506/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e生活的意义是…？\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502421\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/09/10/105506159/a872d3c636003d29e2930af3ce4e4767_2479151265037424442.png\\\" data-entry-name=\\\"一场公差\\\" data-entry-link=\\\"/ys/obc/content/502421/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/502421/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e一场公差\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"2zk7c8qirsxT1718550518092\":{\"icon\":\"\",\"option\":\"【玩得愉快。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"3ihygw09jvoT1719419591706\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【别想太多。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…你说的对。应当把以前发生的麻烦忘掉，只留下有用的经验就好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"5n3rcgx98wkT1718550434222\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\"},\"5zwgfan9shuT1718550564988\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/76362111/b26706122e54335e75a99308e473cc62_3134387980322863327.png\",\"option\":\"【是个好办法。】——获得鱼肉*4\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊。不过讲道理容易，能不能实际做到又是另一回事了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e谢谢你愿意一直帮我。一些微不足道的回礼，是我亲自钓来的成果，请收下吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"771\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/10/8912764/609a57bb9e6ee8a2ae6451f7637c6462_2695821719949782576.png\\\" data-entry-name=\\\"鱼肉\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/771/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/771/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/10/8912764/609a57bb9e6ee8a2ae6451f7637c6462_2695821719949782576.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e鱼肉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\"},\"hhxzc30z1opT1718550381432\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e工作的意义究竟是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"jjevfl44sgT1718547319719\":{\"icon\":\"\",\"option\":\"【压力还是那么大吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…嗯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没有什么不好承认的，压力大只是说明我「太认真对待每一个遇到的问题了」！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e——反正洛耶茨先生和瑟米安先生是这么劝慰我的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我依然不觉得认真是不好的事情，这也是为什么我仍然会把一个文件的工作量扩展到三倍吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过请不用太担心我，我会坚持完成工作的，你也去忙你的生活吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【你好。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，我马上就把今天需要的材料…啊，原来是你！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e又见面了，旅行者，真高兴见到你。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不是客气话，见到你就像见到了钟表里正在精密运转的齿轮，让我感觉生活还在正轨上。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ohwmscv5vbbT1718550453931\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e该计划一次露营了，是去钓鱼还是登山呢？要不还是约上伊丝黛莱一起…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"okay4piajddT1718550515049\":{\"icon\":\"\",\"option\":\"【在指定假期计划吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e说是假期有点夸张了，只是在想平常休息日要做些什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我现在要尽量学着不在工作以外的时间思考工作…嗯，尽量。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2zk7c8qirsxT1718550518092\":[\"3ihygw09jvoT1719419591706\"],\"3ihygw09jvoT1719419591706\":[],\"4cf2vhylew3T1710863944349\":[\"5n3rcgx98wkT171855043