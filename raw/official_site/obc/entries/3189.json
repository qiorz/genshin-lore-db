s_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务开始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/81ca9a57ebe719d2f3db0f74c789b53e_8833441910076773505.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e〓路线攻略〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e具体路线攻略推荐：\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/5829514\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e【迪奥娜】邀约事件 剧情视频＋故事＋空荧视角\u003c/a\u003e  作者：\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=159922380\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color:rgba(102,102,102,1)\\\"\u003e德克萨斯斯斯斯\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd1 猫咪派对\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/303c9cdcddcb76725462d44197e2607b_8933861952766307002.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e看来，猫尾酒馆里会有一场盛大的猫咪派对了。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd2 难揣测的猫咪们\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/8f0893c8c0e86a37bcc1b41ddb9ca2c1_8803127731455168446.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e猫咪真是一种...难以揣测的生物啊...\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd3 迪奥娜的特制饮品\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/28/1694811/0120e5ea66ddc3b4fe08a707e65cad74_6831379995449504898.png\\\" href=\\\"\\\" style=\\\"vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e如果是迪奥娜亲手调制，那么味道也许...不会太糟？\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd4 「我...只喝了...一点点...」\u003c/span\u003e\u003c/p\u003e\u003c