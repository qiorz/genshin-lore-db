itch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e每日委托：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5223\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/08/21/183046623/79b77eeb63503f854da4815f8e46ee89_5607193834461311160.png\\\" data-entry-name=\\\"货比两价\\\" data-entry-link=\\\"/ys/obc/content/5223/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5223/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e货比两价\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"wyow4p9ic1iT1746387122860\"],\"nqb471m7nmnT1710863941173\":[],\"v14nlpbuxefT1746387083038\":[],\"wyow4p9ic1iT1746387122860\":[],\"z2tn3pzsbujT1710863943430\":[\"v14nlpbuxefT1746387083038\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呃，它们算是我的猫吗？…大概不算吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也不知道这猫们都是从哪来的，自从我喂了第一只后，就陆陆续续来了好多，拖家带口地在我这蹭吃蹭喝。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也没办法，谁让小猫实在太可爱了，给它们喂鱼的手就是停不下来啊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e甚至还有从旅馆老板家跑来不走了的猫咪。喏，就是边上那两只。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但怎么说呢，也不怪它们吧。听说那个老板老糊涂了，整天絮絮叨叨的，小猫听了也烦死了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你的猫…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的鱼，肉质好，小猫吃了喵喵叫！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e随便挑，个顶个的新鲜！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/11ee64c710e3b091256c0d349ac55461_3667827954894149401.png\",\"option\":\"【来点鱼。】——打开商店界面\"},\"v14nlpbuxefT1746387083038\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e夸张？不不不！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我一直在这卖鱼，要是过分自夸，被附近的客人嫌弃，可能早就没生意了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e空口无凭，送你一些，权当试吃！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你要是觉得好，今后就请多多照顾我的生意吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/b26706122e54335e75a99308e473cc62_4719954538040375031.png\",\"option\":\"【太夸张了。】——获得鱼肉*4\"},\"wyow4p9ic1iT1746387122860\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，欢迎再来！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当天捕捞，当天售卖，足斤足两，绝无虚言。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你瞧瞧这鱼，这虾，又肥又新鲜，按下去都能弹回来，再把我顶进海里去。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是教令院开设捕鱼学院，我一定能拿全额奖学金。要是鱼的新鲜度能得分，我的鱼就能包揽所有学位证书。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你的鱼…】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222051","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"18