03cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大树·统计态\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6088\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/08/21/183046623/79b77eeb63503f854da4815f8e46ee89_1535917647023263788.png\\\" data-entry-name=\\\"大树·生长态\\\" data-entry-link=\\\"/ys/obc/content/6088/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6088/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大树·生长态\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"civy3udbrfoT1725889085041\":[],\"nqb471m7nmnT1710863941173\":[\"civy3udbrfoT1725889085041\"],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔，还好…圣树的根系一切正常。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"civy3udbrfoT1725889085041\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e从学业角度来说，他们俩现在可开心啦。既有了研究成果，又搜集到了实证数据。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但从生活角度来说，他们已经连饭都顾不上吃了，作息也已经完全混乱…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e用他们的话说，这就是做研究的代价吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【他们俩还好吗？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你是说上次我们一起播撒的那种药水吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唔…拉德普和法尔希还在改进它呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然效果确实不错，但拉德普加入的那种「生理催吐剂」实在是让其他人不太好受。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且不知道为什么，这种药水还会吸引覃兽。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e希望拉德普能快点想出改良的办法来…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于那种药水…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，再见。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e下次我播撒药水的时候，说不定还要请你帮忙，到时候就拜托啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762236868","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_grou