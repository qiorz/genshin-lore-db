e":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"created_at\":\"\",\"list\":[],\"author\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【至烈至强的醇音好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e竟然配备了如此专业的烤肉炉，温度和转速都很好控制。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，想到了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e今天就用这几样香料，烤些适合搭配卷饼的肉排吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【繁闹畅旺的市集好感套装对话】 \u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我每次去大巴扎都会先直奔小吃摊，买几样零食饮料，再慢慢吃慢慢逛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但有时候吧，手里拿着东西，像毛毯店之类的地方就不方便去了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不如这样，小吃分你一半，我们赶快吃完一起去逛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"2nw7tjl6jibT1717605030645\":{\"option\":\"【听上去还好。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的？那就太好了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我想想，首先，至少要有两座帐篷。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一处用于休息，要配最厚实的布料，才能保证隔音效果。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e除了用来睡觉，在里面做做研究、整理资料也不错。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e另一处用于闲聊和游戏，门口摆放成套的野餐用具和躺椅。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你这里天气一直不错，倒是不太需要遮风挡雨…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那，接下来就是游戏机关了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有有有，有好多呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e考虑到这里是你的住处，我没敢贸然动手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好你好，又见面了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里环境真不错，感谢你邀请我来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8kjbwlh8pi7T1717604943288\":{\"option\":\"【沙漠啊，我熟，你随便选一片。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这就是冒险家老手的自信吗，连不同沙漠区域的气候差异都想到了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那就拿赤王陵附近举例好了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那里是赤王遗迹最密集的区域，调查队伍会遇到的难题也最多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明面前是空无一物的沙地，走近了却会一头撞上看不见的墙壁。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等我们好不容易摸清了那片废墟占地多大，才发现高度更难观测。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后来有个同伴提议，要不要拆几块那些看不见的材料搬回去…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e用它们在缄默之殿门口造个迷宫，这样就可以防范外人入侵了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"9j255hm43stT1717604804262\":{\"option\":\"【我用心布置过了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，看得出来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有人喜欢出门游玩，有人则喜欢把自家整理得温馨舒适，独享清净。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在我看来，形式不同，但都是热爱生活的表现。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说起来，这里真是宽敞，不仅有房屋建筑，还有大片的空地…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能按照不同风貌设计一番，岂不是每天都能换着地方露营玩耍了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你想的话，可以叫我来帮忙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我脑子里已经出现不少合适的摆设了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"a5ze6di9zb4T1717605019815\":{\"option\":\"【你、你要做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…可能…也许…在这里建一处营地？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"bud7t88wz5hT1717605078683\":{\"option\":\"【我家很大，你玩得开心就好。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！有你的首肯我就满足了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等我先设计一下，出了图纸之后再找你商量。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能邀请其他朋友来玩，应该会更热闹吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ign32tj3xpeT1717605105990\":{\"option\":\"【早啊，赛索斯。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早啊，又要开始新一天的生活咯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是选条新路线出去徒步，还是就在这附近找地方露营呢…嗯，我想想。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jfxepv8qkT1717605065846\":{\"option\":\"【或许可以问问阿圆。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦？是说那位笑容很和蔼的团雀小姐吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这个好办，我跟她聊过啦。她好厉害，懂得很多管家的好办法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就是有些机关技术我摸索不透。不过我能理解，缄默之殿也是这样，每个组织都会保留一些不能外传的秘密。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没关系，我也有我的办法。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然，非常好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我向来随遇而安，什么环境都能适应，就更不用说这样优美宜人的地方了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"oe1tjxfpp2pT1717605107009\":{\"option\":\"【晚安，赛索斯。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚上好！这么晚不睡，难道还有安排？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也还不困，我们一起去吧？我来保护你。不乐意的话，你保护我！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"r105qw0r7jT1717605051511\":{\"option\":\"【欸？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再好的风景，干看着也有些无聊，对吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e更重要的，是人在其中做些什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果有用来跳高、跑步或者攀岩、飞行的装置，那就有意思多了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有了那些东西，你也可以呼一下上去，哗一下下来，唰一下远去…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"srxnqgv9eqT1717604864399\":{\"option\":\"【我不常去沙漠，你应该比我有经验。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的吗？那看来是我的情报有误？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，就算是长期生活在沙漠里的人，也无法窥探它的全貌。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时连遗迹正门都还没进去呢，就已经被三四个机关拦下来啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那就拿赤王陵附近举例好了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那里是赤王遗迹最密集的区域，调查队伍会遇到的难题也最多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明面前是空无一物的沙地，走近了却会一头撞上看不见的墙壁。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等我们好不容易摸清了那片废墟占地多大，才发现高度更难观测。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后来有个同伴提议，要不要拆几块那些看不见的材料搬回去…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e用它们在缄默之殿门口造个迷宫，这样就可以防范外人入侵了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"szrq949e1bT1717604894947\":{\"option\":\"【你说的这个同伴，是不是你自己？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，我是这样的人吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但你别说，我和他确实想到一块去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只不过我觉得，我们自己人也可能通不过那样的迷宫，就没说出来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e事实证明，我的担忧是对的，这件事最终没能实现。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"tyzbog3ju1gT1717604822048\":{\"option\":\"【久疏打理，见笑了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不不不，别这样说。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也是个喜欢出门冒险的人，家中布置得就比较简单了，可能还没有你这整洁呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说起来，这里真是宽敞，不仅有房屋建筑，还有大片的空地…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能按照不同风貌设计一番，岂不是每天都能换着地方露营玩耍了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你想的话，可以叫我来帮忙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我脑子里已经出现不少合适的摆设了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"vrlxx4uh619T1717605077176\":{\"option\":\"【我家要变成游乐场咯。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！有你的首肯我就满足了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等我先设计一下，出了图纸之后再找你商量。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能邀请其他朋友来玩，应该会更热闹吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xwvysq4jy2tT1717604973775\":{\"option\":\"【我代表冒险家们感谢你。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e别客气别客气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但就算没有这个迷宫，也不要小看沙漠里的神秘力量哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"yo91swe20jaT1717604863249\":{\"option\":\"【是有新的发现吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e暂时没有，只是先假设一下。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e缄默之殿的成员们大部分时间都在驻地研究和管理古老文明技术，但偶尔也会出现需要外出调查的情况。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一般来说，我不会错过这些机会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好好好，我正觉得有些安静呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e刚巧有事想向你请教。以你的经验来看，探访沙漠里新挖出的遗迹，应该提前做好哪些准备呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2nw7tjl6jibT1717605030645\":[\"r105qw0r7jT1717605051511\"],\"4cf2vhylew3T1710863944349\":[\"a5ze6di9zb4T1717605019815\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"ign32tj3xpeT1717605105990\",\"oe1tjxfpp2pT1717605107009\"],\"8kjbwlh8pi7T1717604943288\":[\"szrq949e1bT1717604894947\"],\"9j255hm43stT1717604804262\":[\"tyzbog3ju1gT1717604822048\"],\"a5ze6di9zb4T1717605019815\":[\"2nw7tjl6jibT1717605030645\"],\"bud7t88wz5hT1717605078683\":[],\"ign32tj3xpeT1717605105990\":[],\"jfxepv8qkT1717605065846\":[\"vrlxx4uh619T1717605077176\",\"bud7t88wz5hT1717605078683\"],\"nqb471m7nmnT1710863941173\":[\"9j255hm43stT1717604804262\"],\"oe1tjxfpp2pT1717605107009\":[],\"r105qw0r7jT1717605051511\":[\"jfxepv8qkT1717605065846\"],\"srxnqgv9eqT1717604864399\":[\"szrq949e1bT1717604894947\"],\"szrq949e1bT1717604894947\":[\"xwvysq4jy2tT1717604973775\"],\"tyzbog3ju1gT1717604822048\":[],\"vrlxx4uh619T1717605077176\":[],\"xwvysq4jy2tT1717604973775\":[],\"yo91swe20jaT1717604863249\":[\"srxnqgv9eqT1717604864399\",\"8kjbwlh8pi7T1717604943288\"]