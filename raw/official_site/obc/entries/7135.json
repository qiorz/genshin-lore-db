,"without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【利涅尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…不能再商量商量吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【萨维尼恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就这个数，不能少。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【利涅尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我知道您很厉害，可这已经比正常的决斗代理费高出五成了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【萨维尼恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是「亲情价」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【利涅尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e什、什么亲情？而且哪有亲情价往上涨的？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【萨维尼恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我都查到了，你想要发起决斗的对象，其实是你的表亲吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【利涅尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【萨维尼恩】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e亲属纠纷可是很难办的，要是你请不起我的话，那我不如…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【利涅尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e稍等，稍等！我再想想！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u