e":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【烟霞入梦阁好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最近手头紧，不运镖的时候会去帮一些老板坐夜，看家护院，虽然是轮流的，但也没几个完整觉能睡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e走镖的时候更加不用讲了，我都是坐着睡的，就怕有什么风吹草动，我可以第一时间跳起来…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在好咯，哈…终于可以安安乐乐睡个大觉了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【千家饔飧坊好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e 英雄不问出处，美食也是一样道理。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e街边小摊有连大酒楼大饭店都没办法做出来的人情味和烟火气，还能吃到不同老板的手艺。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e让我看看先，从哪一家吃起咧？有没有推荐啊你？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"0lj2gvmp99vnT1712671688911\":[\"3xtd7m2tt8nT1712671708250\"],\"3vdbvmqkmshT1712671643398\":[\"0lj2gvmp99vnT1712671688911\"],\"3xtd7m2tt8nT1712671708250\":[],\"4cf2vhylew3T1710863944349\":[\"3vdbvmqkmshT1712671643398\",\"9ppyu5od8evT1712671646234\"],\"4ciwv6llwfhT1712671383648\":[],\"6m41tlzwiunT1712671235649\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"knsl503madgT1712671233728\",\"6m41tlzwiunT1712671235649\"],\"9ppyu5od8evT1712671646234\":[\"0lj2gvmp99vnT1712671688911\"],\"c8hxn18ix6gT1712671564638\":[\"epa3trtjiv7T1712671579534\"],\"epa3trtjiv7T1712671579534\":[],\"j9ozpppi6gT1712671465004\":[\"c8hxn18ix6gT1712671564638\"],\"k1ndk54lr9T1712671357824\":[\"4ciwv6llwfhT1712671383648\"],\"knsl503madgT1712671233728\":[],\"nqb471m7nmnT1710863941173\":[\"w3vp4ffp9jjT1712671346218\"],\"sbbqcdai2nsT1712671454075\":[\"c8hxn18ix6gT1712671564638\"],\"w3vp4ffp9jjT1712671346218\":[\"k1ndk54lr9T1712671357824\"],\"z2tn3pzsbujT1710863943430\":[\"sbbqcdai2nsT1712671454075\",\"j9ozpppi6gT1712671465004\"]},\"contents\":{\"0lj2gvmp99vnT1712671688911\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，别跟我讲笑啦，哪里是做生意，这是做人做事的基本而已。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e尊重别人，答应别人的事就要做到。你明明也是这样的喔，说到做到，牙齿当金使。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e更何况这是工作，丢了这个饭碗我就没钱继续研究舞兽戏咯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以能邀请你陪我一齐去采点木桩子回来吗？报酬是舞一段「瑞兽大战发财树」给你看？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这明明挺会做生意嘛。】\"},\"3vdbvmqkmshT1712671643398\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不知道喔。虽然我帮不少做生意的老板运过，但品种好像都不是同一个。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哇，你都不知道啊，要将那棵树从山里运到城里，山长水远的，中途不能随意修剪啦、不能随便淋水啦…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好多讲究的，跑那一趟真是累死我了，比跟十个贼打架还累…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好啦，玩笑话这里讲完这里散，我不是做生意的料啦，但就算我不理解还是会做好我的本职工作的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说几点钟淋水我就不会晚一分钟让它们淋到，说晒多久太阳我就不会让它们少晒一秒。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【发财树和富贵竹长什么样？】\"},\"3xtd7m2tt8nT1712671708250\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【早讲嘛！快点快点我想看！】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好久没上桩舞兽了，有点坐不住了！准备去找些木头回来打磨一下，自己做些简易的梅花桩。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想在周围找找，但问一下你先，你这里有没有种着什么发财树和富贵竹之类的植物呀？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的话我标记下位置，避开一点，不然不小心刮花它们就无谓啦…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"4ciwv6llwfhT1712671383648\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那自己人打理自己的屋子有什么问题？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e数到三不说话就是没问题——三！好！没问题！那就这么愉快地决定咯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那当然！】\"},\"6m41tlzwiunT1712671235649\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦晚安！盖好被子啊尤其要记得盖住肚子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e睡不着就随时找我咯，有心事也好熬夜工作也好，我都陪你！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没睡好的话我明天就煲凉茶给你喝，哎呀听我的，睡不着也是热气，要喝凉茶啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，嘉明。】——【夜晚】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊老友，又见面了喔。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里好大好靓啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9ppyu5od8evT1712671646234\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你问我吗？听说这些树很贵一棵的，还没发财前就要破一次财先，我肯定舍不得啦！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e记得我家也养了一棵发财树，我老爸天天早上起来都要去看看它的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我倒觉得靠它们发财还不如靠发梦快…呃，这句话被我老爸听到肯定要请我吃「藤条焖猪肉」了哈哈！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好啦，玩笑话这里讲完这里散，我不是做生意的料啦，但就算我不理解还是会做好我的本职工作的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说几点钟淋水我就不会晚一分钟让它们淋到，说晒多久太阳我就不会让它们少晒一秒。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【嘉明相信这些能招财吗？】\"},\"c8hxn18ix6gT1712671564638\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，就是圆滚滚的意思，没猜错的话那位应该是这里的前辈吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【…「圆碌碌」？】\"},\"epa3trtjiv7T1712671579534\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来是阿圆前辈！失敬失敬。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呼…不愧是你啊，人面真广，什么能人异士都认识。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e合理合理，你心地又好能力又强，人见人爱花见花开。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也是？哈哈哈，那就承你贵言咯！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那是阿圆，确实是前辈。】\"},\"j9ozpppi6gT1712671465004\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦？那就要让你失望了喔，我只带了老家的「游韵单丛」来…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过嘛，你想喝的话，等我留意一下周围有哪些药草药材，采回来备齐料先。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到时候我就煲一大壶，人人有份，永不落空。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦，讲起饮茶，那怎么少得了点心！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好在我还带了很多冬蓉酥来，全部都打包好了，分点给你…还有住这里的客人…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦！差点数漏了那位！门口圆碌碌很可爱的那位！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不会是传说中的凉茶吧？】\"},\"k1ndk54lr9T1712671357824\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我就知道你会这么说的咯，这也太见外了吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们是不是自己人先？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【 哪有让客人做这些的…】\"},\"knsl503madgT1712671233728\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早晨好早晨好！我已经跑完步扎完马踢完腿咯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你有事去忙先？等我再练完剩下的动作我们在茶楼见？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，嘉明。】——【白天】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不是吧你？这种问题还用问的？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看我的样子就知道我喜欢得不得了啦！唔唔…自己落手落脚打理的地方就是不一样的喔！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总体来讲咧，十二个字：睡得安心，玩得开心，住得舒心！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"qx9lsv73dp8T1712671677653\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啦，玩笑话这里讲完这里散，我不是做生意的料啦，但就算我不理解还是会做好我的本职工作的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说几点钟淋水我就不会晚一分钟让它们淋到，说晒多久太阳我就不会让它们少晒一秒。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"sbbqcdai2nsT1712671454075\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？哦、哈哈…对不住啊对不住，我讲话用词是不是有点让人听不懂啊？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我从小就跟着我老妈，很多生活习惯都是从她那里学过来的，讲话也是，哈哈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果我讲了什么让你误会或者听不明白的话，随时截断我就好啦，我换种说法换个词嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎呀小意思，我们饮多几次茶聊多几次天，自然什么都听得懂了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦，讲起饮茶，那怎么少得了点心！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好在我还带了很多冬蓉酥来，全部都打包好了，分点给你…还有住这里的客人…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦！差点数漏了那位！门口圆碌碌很可爱的那位！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【嘉明讲话用词就挺有意思的！】\"},\"w3vp4ffp9jjT1712671346218\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，怎么又学我讲话啊你？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗱嗱嗱，事先声明，人情呢是人情，数目要分明的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我知道你肯定不肯收我住宿费的，那你也不要拦住我给你打扫卫生、养护花花草草那样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有没有那么夸张啊你？】\"},\"yhuqnpjmhyT1712671535531\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，讲起饮茶，那怎么少得了点心！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好在我还带了很多冬蓉酥来，全部都打包好了，分点给你…还有住这里的客人…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦！差点数漏了那位！门口圆碌碌很可爱的那位！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊好啊！主人公都这么讲了，我肯定奉陪的咯。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过干聊没什么意思吧…你等一下先，我去泡杯茶来…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712801666","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent