ated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"07n6b4fi8r6pT1757517151402\":[\"2lgt370jbcmT1761451434987\"],\"0n3x2vxtccpnT1757517265819\":[\"2lgt370jbcmT1761451434987\"],\"2lgt370jbcmT1761451434987\":[],\"4cf2vhylew3T1710863944349\":[\"2lgt370jbcmT1761451434987\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"unu6x9ewktmT1757517149252\",\"m2cggz5xzlT1761451298766\",\"9s8xu3ekkfT1757517150496\",\"07n6b4fi8r6pT1757517151402\"],\"9s8xu3ekkfT1757517150496\":[\"0n3x2vxtccpnT1757517265819\",\"hnc4h6zfs3T1757517266458\"],\"hnc4h6zfs3T1757517266458\":[\"2lgt370jbcmT1761451434987\"],\"m2cggz5xzlT1761451298766\":[\"2lgt370jbcmT1761451434987\"],\"nqb471m7nmnT1710863941173\":[\"2lgt370jbcmT1761451434987\"],\"rhb270xr39qT1757517436888\":[\"2lgt370jbcmT1761451434987\"],\"unu6x9ewktmT1757517149252\":[\"2lgt370jbcmT1761451434987\"],\"z2tn3pzsbujT1710863943430\":[\"rhb270xr39qT1757517436888\"]},\"contents\":{\"07n6b4fi8r6pT1757517151402\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞，路上小心！下次想尝尝鲜或者需要什么食材，欢迎随时再来！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"0n3x2vxtccpnT1757517265819\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没问题，客人请您看这边！这一堆墩墩桃可新鲜啦，来来，你直接尝一个吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【听起来还挺麻烦的…】\"},\"2lgt370jbcmT1761451434987\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是呀，我是从璃月港来的！俗话说「八方四路，为商为贾」，这地方既然有商机，那自然少不了我们啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e更何况，多走走看看，了解不同地方的风土人情，对生意总是有帮助的嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是璃月人？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎来试吃！北地难得一见的品种也应有尽有哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9s8xu3ekkfT1757517150496\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e特别的水果？你瞧这墩墩桃，还有这青蜜莓，在挪德卡莱已经算是很特别的水果啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你想要璃月特产，我倒是也能帮你订购，不过，这就要视商队的时间安排啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么特别的水果吗…】\"},\"hnc4h6zfs3T1757517266458\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没问题，客人请您看这边！这一堆墩墩桃可新鲜啦，来来，你直接尝一个吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那我还是看看别的吧。】\"},\"m2cggz5xzlT1761451298766\":{\"dialogue\":\"\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么特别的水果吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【采若】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…那就要看，奈芙尔老板想吃\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;要\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e什么样的水果\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;情报\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e喔？什么都可以？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【采若】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等您说了之后，我自会去和商队老板\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;统管上司\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e商量的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想订购的水果\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;情报\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e数量不少，可能的话，采若小姐能把您的老板\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;统管上司\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e请来和我面谈么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【采若】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊哈哈，此事亦要等老板\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;统管上司\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e定夺。您也知道我们的行事风格，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我的耐心一向不错，那就麻烦采若小姐，替我邀请一下这位贵客了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/26/80663279/ead302bf7db83ccaefbafca7162a8b8c_3860734200318837792.png\",\"option\":\"【（奈芙尔似乎有话要说…？）】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都是新鲜食材，请随意挑选！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/288180982/661f4aed07b4e34115c0ea22f4b4b711_1730393643371648473.png\",\"option\":\"【关于你的商品…】——打开商店界面\"},\"rhb270xr39qT1757517436888\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，没错吧？来，先拿几个尝尝！要是觉得好吃的话，欢迎随时再来！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506057\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/20/24077343/67aae875285d743352fae3a912104fc0_378684261666186988.png\\\" data-entry-name=\\\"白灵果\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/506057/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506057/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/20/24077343/67aae875285d743352fae3a912104fc0_378684261666186988.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e白灵果\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/288180982/b26706122e54335e75a99308e473cc62_979671506908383585.png\",\"option\":\"【真是让人垂涎欲滴！】——获得白灵果*5\"},\"unu6x9ewktmT1757517149252\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，居然这么直接地向别人打听商业机密吗？还真是大胆呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵呵，开玩笑的啦。主要是靠可靠的商队和特殊的保存方法，不过更具体的细节，那就真的是商业机密啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，能让大家在这里品尝到异国或者家乡的美食，辛苦点也值得，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这些食材是怎么运来的？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哼哼，都是从各国运来的新鲜食材喔！比如这饱满的墩墩桃，还有从纳塔运来的青蜜莓，在挪德卡莱其他地方可找不到！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e怎么样，是不是看着就很有食欲？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这些是…】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1761877400","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_k