\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},\"tab_id\":\"1730815724349_0\"}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6498","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e自行巧局\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"6537","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"天赋牌","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"天赋牌\",\"layout_\":\"banner\",\"list\":[{\"tab_name\":\"冒险憧憬\",\"skill_type\":\"装备牌\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/21/258999284/044617980be5a70980f7826036963e74_5462155620981122224.png\",\"life\":4,\"life_bg\":4,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"天赋效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cu\u003e战斗行动\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;战斗行动：\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;我方执行了一次战斗行动后，会轮到对方行动。\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;打出具有此规则的手牌是一个战斗行动，而非快速行动。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e：我方出战角色为班尼特时，装备此牌。\u003c/p\u003e\u003cp\u003e班尼特装备此牌后，立刻使用一次\u003cstrong\u003e\u003cspan style=\\\"color: rgb(212, 177, 6)\\\"\u003e\u003cu\u003e美妙旅程\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;美妙旅程：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;元素爆发\u0026lt;/u\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;造成2点\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;\u0026lt;u\u0026gt;火元素伤害\u0026lt;/u\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;，生成\u0026lt;strong\u0026gt;鼓舞领域\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;blockquote\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;鼓舞领域\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方角色使用技能时：\u0026lt;/strong\u0026gt;如果该角色生命值至少为7，则使此伤害额外+2；技能结算后，如果该角色生命值不多于6，则治疗该角色2点。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;持续回合\u0026lt;/u\u0026gt;：2\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;/blockquote\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;元素爆发：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;角色的充能达到上限时，可以消耗所有的充能，来使用威力强大的「元素爆发」。\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color: rgb(207, 19, 34)\u0026quot;\u0026gt;火元素伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;附着火元素，可发生元素反应：\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;融化：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;蒸发：\u0026lt;/strong\u0026gt;本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;超载：\u0026lt;/strong\u0026gt;本伤害+2，目标强制切换到下一个角色\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;燃烧：\u0026lt;/strong\u0026gt;本伤害+1，生成回合结束时造成1点火伤害的[\u0026lt;strong\u0026gt;燃烧烈焰\u0026lt;/strong\u0026gt;]（可生效1次，最多叠加到2次）\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;每回合结束阶段，\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;-1；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003cp\u003e装备有此牌的班尼特生成的\u003cstrong\u003e\u003cu\u003e鼓舞领域\u003c/u\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;鼓舞领域：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;出战状态\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;我方角色使用技能时：\u0026lt;/strong\u0026gt;如果该角色生命值至少为7，则使此伤害额外+2；技能结算后，如果该角色生命值不多于6，则治疗该角色2点。\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;u\u0026gt;持续回合\u0026lt;/u\u0026gt;：2\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合：\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;每回合结束阶段，\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;-1；\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;持续回合\u0026lt;/strong\u0026gt;耗尽后，立刻弃置此牌。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e，其伤害提升效果改为总是生效，不再具有生命值限制。\u003c/p\u003e\u003cp\u003e（牌组中包含班尼特，才能加入牌组）\u003c/p\u003e\"]},\"tab_id\":\"1759479143814_0\"}],\"baseInfoSwitchDisabled\":false,\"repeated\":true}","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,