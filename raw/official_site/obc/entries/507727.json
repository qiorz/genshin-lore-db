onent_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"11ntiz0gx08T1768452116929\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"1s2oigc8axhT1768409781176\":{\"option\":\"【你要回至冬吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是的，等卖掉这批货，我就要买票坐列车回去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽说那里一年到头都在下雪，到处冰天雪地的，每天就只能窝在城里。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但在外面的时间长了，也有点怀念能在家里睡上一整天的日子了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"1xp098r9ubkT1768408746901\":{\"option\":\"【不好意思，我先走了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，你怎么就走了，不看看吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"45a1g3b5hxgT1768451346859\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e太好了，终于把货都卖完了，果然薄利多销的策略是正确的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e按理来说我也该启程回至冬了，只是现在顶多也就赚回了路费…我光脚出来，可不想再光脚回去啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎，总之多谢你照顾生意了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【远征军的近况…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这场远征终于接近尾声，许多骑士都已经在盼着回家了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过根据大团长的安排，这座营地还是会继续维持下去，作为收集深渊情报的前哨站。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也有很多骑士自发报名要留下守岗……人数多得我都有些惊讶了，最后还是靠抽签决定由哪些人来值第一轮班。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也会留下陪他们一起，完成这座据点的建设工作。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4jaydyyvopeT1768451816945\":{\"option\":\"【你怎么在愚人众的地盘？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e瞧您说的，我可是遵纪守法的至冬公民，看到愚人众就跟回家了一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在我这里的货都是愚人众淘汰下来的老旧装备，是他们特别托我处理的。你在别处可买不到，独此一家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"622zv5vubwgT1768401872998\":{\"option\":\"【不会想家吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈，只要是风能吹到的地方，都可以是骑士的家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e况且我们又不是回不去了，还会有骑士从蒙德来接我们的班。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这么长的远征都等过来了，再等一轮又有什么呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6lysrulyjasT1768451147268\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这么巧，我们又见面了。您要买点什么吗？新货滞销，帮帮我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7lrwk3f4qvrT1768451084869\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e行情还真是差啊…要不我还是再凑笔钱，想办法去那夏镇租个摊位吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"7vc3ft2cp4aT1768452060649\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真是太感谢了，多亏了你，我可以不用那么灰头土脸地回去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这次真的要告别了。你买了我这么多东西，我们怎么说也算是朋友了吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你若是有机会来至冬的话，就到新基捷城来找我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次清空商店前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"950epixzttgT1768451410058\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第三次清空商店前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"a0u4a7zb1qT1768480996897\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀呀，没想到真的卖完了看来我还是有一些商业眼光的嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e接下来我会拜托执灯人送我穿过噩影泽地，之后再往北应该就是通途了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定回去的路上还能碰到什么商机呢…那么就此别过吧，我们有缘再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"az8g615qk8cT1768451164484\":{\"option\":\"【让我看看有什么好货。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都是些本地的特产，放心，一定给您最优惠的价格。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/11ee64c710e3b091256c0d349ac55461_4457574648243368114.png\"},\"bd5en16vomT1768451289620\":{\"option\":\"【你猜他为什么急着出手。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，您就别挖苦我了，要不您看看有什么用得上的东西？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"c5fo1ci2yssT1768451706084\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎哟，缘分真是奇妙，居然在这又碰上了。怎么样，要看看吗？这次有不少好东西哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cxu40kc02ucT1768451341171\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次清空商店后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"ejxdu0lhnjeT1768405067502\":{\"option\":\"【你似乎有些不满？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e作为执灯士，我尊重马鲁什金军士长的一切决定。对于兵士来说，服从军令是基本中的基本。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我只是觉得…我通过了那样严酷的选拔与考核，不是来做门卫的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e马鲁什金军士长还说什么「多看看其他人是怎么战斗的，不切实际的英雄幻想只会让你白白送命」…那又如何呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e真正的英雄就该像西格德前辈那样，浴血而战、至死方休，成为众人仰慕的传说，而不是每天傻站在这里，看其他人立功凯旋。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"f4roxmfhvntT1768451844961\":{\"option\":\"【不用了，我先走了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那可真是遗憾…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"fcamu8emf6fT1768480978975\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次清空商店前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"guzdkf8oq0pT1768451165219\":{\"option\":\"【你怎么又进货了？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，怎么说呢。商业嘛，正所谓该出手时就出手…我在皮拉米达城碰到了个好机会，一批急着出手的货物，给了我优惠价。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我当时一激动，就忘了我这次是要回家了，全给买了下来。结果就…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"j250t2kba2T1768451709915\":{\"option\":\"【看看有什么好东西。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，都是愚人众淘汰下来的老旧装备，在别处可买不到，有想要的就一起拿走吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/11ee64c710e3b091256c0d349ac55461_5823804647400158107.png\"},\"kq0pm5oppuT1768451165901\":{\"option\":\"【抱歉，我先走了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不再看看吗，一定有您需要的东西！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【有什么好货吗？】——打开商店界面、清空商店前\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都是些从纳塔淘来的小玩意，有什么感兴趣的您尽管挑。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/11ee64c710e3b091256c0d349ac55461_8668992438028441842.png\"},\"phohhhheyhkT1768401774252\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，有顾客来了！您好，我叫库济米奇，是来自至冬的旅行商人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e话是这么说，其实只是在旅行的路上顺便做些小本生意，赚点路费罢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e结果路过纳塔的时候，那里的人实在太热情了，我一时脑热就…现在我要是不把这些货卖光，连回去的车票钱都要没有啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"rh2owz2hblT1768451816242\":{\"option\":\"【你不是回至冬了吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不瞒您说，我的家在新基捷城，全家都是采矿工人。他们啊，一个个比矮灵还顽固，我说要出门经商，他们坚决不同意。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e于是出门前我夸下海口，要赚一大笔钱回去…结果没想到，到头来会差点连路费都凑不上。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在赚大钱是没戏了，至少最后让我能赚点小钱吧，起码回去也有个交待。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"syb7d8zl0tT1768409782306\":{\"option\":\"【这里看着就没什么生意。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e但如果想在镇上租个摊位，我就只能去北国银行借钱了，听说那夏镇的那家风评也不是很好…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e算啦，至少这里的人流比较多。货嘛，只要来的人多总能卖出去的，您说是不是？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"wq2xnjkf4jeT1768451125732\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次清空商店后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"y10c0bex3yiT1768452037625\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第三次清空商店后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【西蒙枢机卿？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e西蒙枢机卿已经返回了蒙德，之前远征军内外的行政工作几乎都是由他一人操持的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在他离开后，由我、纳尼娜和洛朗三个人轮流填补这个空缺，但还是经常感到力不从心。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听说留在蒙德的琴团长也几乎包办了骑士团里的大小事务…真是有其父必有其女啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"11ntiz0gx08T1768452116929\":[],\"1s2oigc8axhT1768409781176\":[\"wq2xnjkf4jeT1768451125732\"],\"1xp098r9ubkT1768408746901\":[\"wq2xnjkf4jeT1768451125732\"],\"45a1g3b5hxgT1768451346859\":[\"950epixzttgT1768451410058\"],\"4jaydyyvopeT1768451816945\":[\"y10c0bex3yiT1768452037625\"],\"6lysrulyjasT1768451147268\":[\"az8g615qk8cT1768451164484\",\"guzdkf8oq0pT1768451165219\",\"kq0pm5oppuT1768451165901\"],\"7lrwk3f4qvrT1768451084869\":[\"nqb471m7nmnT1710863941173\",\"phohhhheyhkT1768401774252\",\"1xp098r9ubkT1768408746901\"],\"7vc3ft2cp4aT1768452060649\":[\"11ntiz0gx08T1768452116929\"],\"8gfxrw8wla9T1710863939170\":[\"7lrwk3f4qvrT1768451084869\"],\"950epixzttgT1768451410058\":[\"c5fo1ci2yssT1768451706084\"],\"a0u4a7zb1qT1768480996897\":[\"fcamu8emf6fT1768480978975\"],\"az8g615qk8cT1768451164484\":[\"cxu40kc02ucT1768451341171\"],\"bd5en16vomT1768451289620\":[\"cxu40kc02ucT1768451341171\"],\"c5fo1ci2yssT1768451706084\":[\"j250t2kba2T1768451709915\",\"rh2owz2hblT1768451816242\",\"4jaydyyvopeT1768451816945\",\"f4roxmfhvntT1768451844961\"],\"cxu40kc02ucT1768451341171\":[\"45a1g3b5hxgT1768451346859\"],\"f4roxmfhvntT1768451844961\":[\"y10c0bex3yiT1768452037625\"],\"fcamu8emf6fT1768480978975\":[\"6lysrulyjasT1768451147268\"],\"guzdkf8oq0pT1768451165219\":[\"bd5en16vomT1768451289620\"],\"j250t2kba2T1768451709915\":[\"y10c0bex3yiT1768452037625\"],\"kq0pm5oppuT17