{"retcode":0,"message":"OK","data":{"page":{"id":"507727","name":"库济米奇【流浪的商人】","desc":"库济米奇【流浪的商人】","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/cf9ce361a9b16ce405e694a79d07aaac_4240004020018211189.png","header_img_url":"","modules":[{"name":"库济米奇","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e相关成就 归乡歧旅\u003c/p\u003e\"],\"key\":\"编者注\"}],\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/e24548a5f4793b284183cd1e8190d2a4_3144628855021666957.png\",\"attr\":[{\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"],\"key\":\"性别\"},{\"value\":[\"\u003cp\u003e虚海望【第一次清空商店前】\u003c/p\u003e\u003cp\u003e逐浪野【第二次清空商店前】\u003c/p\u003e\u003cp\u003e特辖地研究所【第三次清空商店前】\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e流浪的商人\u003c/p\u003e\"],\"key\":\"职业\"},{\"value\":[\"\u003cp\u003e商店\u003c/p\u003e\"],\"key\":\"功能\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图【第一次清空商店前】\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/a14d16bba3aa54ac93010e105b19e128_415677090096779686.png\"},{\"tab_name\":\"位置【第一次清空商店前】\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/e854dfa225ca3159e388e2e7add6c3c8_8064564432370827183.png\"},{\"tab_name\":\"截图【第二次清空商店前】\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/70a979590518abb3ba1830be1216dfcd_6594139678247065427.png\"},{\"tab_name\":\"位置【第二次清空商店前】\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/15/288180982/0f27dfd63962833ddc0aee2779357bd6_507455030223041