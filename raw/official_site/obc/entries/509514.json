n_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"46z33kpczfjT1786680201302\":[\"irtfv1cwn7T1786680294150\"],\"4cf2vhylew3T1710863944349\":[\"irtfv1cwn7T1786680294150\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"46z33kpczfjT1786680201302\"],\"irtfv1cwn7T1786680294150\":[],\"nqb471m7nmnT1710863941173\":[\"irtfv1cwn7T1786680294150\"],\"z2tn3pzsbujT1710863943430\":[\"irtfv1cwn7T1786680294150\"]},\"contents\":{\"46z33kpczfjT1786680201302\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是嘛，那等到了新货，你再看看，说不定有你想要的呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没什么想看的…】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…以前偶尔有，只不过最近数量多了起来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e家家都有本难念的经，来我们「布莱茨卡」这儿买东西的也大多是居住在附近的居民，总有生活突遭变故，难以为继的时候…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说是赊账，其实大部分赊的账呢，钱款也讨不回来，权当帮衬了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有很多人赊账吗？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e来看看新进的商品吧！不过注意了，离开柜台钱货两讫，然后…原则上不接受赊账！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"irtfv1cwn7T1786680294150\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【队伍中有「阿罗夏」时】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…这些就够了，谢谢你，格里戈里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【格里戈里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e行了，咱们哥俩还这么客气，我出去送货的时候，有时候还指望你帮忙呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那只是我应该做的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【格里戈里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你又来了，得了，把这些肉干和饼子装好了，要不要再来点水果？看你又要出远门。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e差不多吧。这次的捕猎，可能要花很长的时间。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【格里戈里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e很危险？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e每次狩猎都并不是那么安全，格里戈里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【格里戈里】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好吧…我是不懂狩猎，但要是情况不对，你可记得要掉头就跑啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然，图加林总是能帮我找到捷径。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509261\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/a1c7dcbc4be93b6bf83cb37c89e7e799_1295098886615275033.png\\\" data-entry-name=\\\"金蕨\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/509261/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/509261/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/a1c7dcbc4be93b6bf83cb37c89e7e799_1295098886615275033.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e金蕨\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509312\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/868d7cf660e7eb400a5d320a27769bbf_3306266009497394716.png\\\" data-entry-name=\\\"冰醋栗\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/509312/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/509312/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/183046623/868d7cf660e7eb400a5d320a27769bbf_3306266009497394716.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冰醋栗\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看看吧，都是些刚进的好东西！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/14/178964736/661f4aed07b4e34115c0ea22f4b4b711_1880932155129486911.png\",\"option\":\"【让我看看有什么…】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，客人你看上去也不是什么穷酸人，还是算了吧，小店本就是成本经营…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说正经的，名为赊账，其实大多也就是帮帮实在过不去的乡里乡亲，像您这样的，就不是「赊账」服务提供的对象啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我要赊账！】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_edit