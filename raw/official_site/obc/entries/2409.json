material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e万端珊瑚事件簿·合适的身份\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2477\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/08/03/4359827/79b77eeb63503f854da4815f8e46ee89_2970504524097865254.png\\\" data-entry-name=\\\"神明啊，回应我吧！\\\" data-entry-link=\\\"/ys/obc/content/2477/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/2477/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e神明啊，回应我吧！\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，相信下次见面就能看到我的新作品了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e极上品质，尽在「弥生漆器」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请便，只要不影响我的研究工作就好。注意安全。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/07/288180982/415b6e81005dd9122bbda4b2f4280ef4_473586370430831649.png\",\"option\":\"【可以借用合成台吗？】——打开合成台界面\"},\"p5zjnv8x05T1783416054591\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我曾去往须弥教令院游学，在那里学到的合成秘法可以让我制出世上独一无二的涂料。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e漆器的技艺令人着迷，我的追求便是精通一技，融会贯通。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果最终能抵达极致的境界，那么漆器之中也会蕴藏真理的纹样吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【须弥？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果想寻得全稻妻最好的漆器，那就只有在「弥生漆器」了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e极上品质，独此一家，就连幕府的大人物们都会前来定制。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我家是经营多年的老工坊，到我手上已是第四代，追求极致的祖训也传承至今。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e再加上我从须弥学到的合成秘法，一定可以锦上添花。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于「弥生漆器」…】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"p5zjnv8x05T1783416054591\":[],\"z2tn3pzsbujT1710863943430\":[\"p5zjnv8x05T1783416054591\"]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":