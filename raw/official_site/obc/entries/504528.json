src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/18/4521515/0f1d443f850425b26ada0f33c6a602a6_7326075727440937086.png\\\" style=\\\"width: 333px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/18/4521515/3bc4bdb933c8b4aa08b57dabc21eb9b7_4258910552250422580.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"333\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 333px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/02/18/4521515/3bc4bdb933c8b4aa08b57dabc21eb9b7_4258910552250422580.png\\\" style=\\\"width: 333px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"]]}]}\n","style":""}],"id":"8980","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"三川游艺绮梦谭","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://upload-bbs.miyoushe.com/upload/2025/02/11/75276539/a3ecb761fc0b14bce0b311af58c8d31d_8214263580555432958.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"0\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://upload-bbs.miyoushe.com/upload/2025/02/11/75276539/a3ecb761fc0b14bce0b311af58c8d31d_8214263580555432958.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" style=\\\"\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8981","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色对话彩蛋","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"74nengdo62xT1786965525945\",\"child_ids\":{\"74nengdo62xT1786965525945\":[\"nxwgowzrmtgT1786990490703\"],\"nxwgowzrmtgT1786990490703\":[]},\"contents\":{\"74nengdo62xT1786965525945\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第一天\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【梦见月瑞希】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e梦见月瑞希：关卡的终点，嗯…就包装成「拉面摊」吧。\u003c/p\u003e\u003cp\u003e「刑部小判」：为什么是拉面摊呶？\u003c/p\u003e\u003cp\u003e珊瑚宫心海：莫非…也是取材于「现实」？\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【早柚、宵宫】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e宵宫：能让全稻妻的孩子都玩上我们做的[游艺」啊…想想就很兴奋呢，我们可一定不能输啊！\u003c/p\u003e\u003cp\u003e「吉法师」：——不能输呶！\u003c/p\u003e\u003cp\u003e早柚：也…也不用这么拼吧…？至少先保证睡眠…\u003c/p\u003e\u003cp\u003e宵宫：嗯…说的也是，还是开心最重要。\u003c/p\u003e\u003cp\u003e早柚：还有长高的法术…啊不对…还有学习新的忍术也很重要！\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【枫原万叶】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e枫原万叶：「天也醉樱花，云脚乱满跚…」\u003c/p\u003e\",\"icon\":\"\"},\"nxwgowzrmtgT1786990490703\":{\"option\":\"旅行者：万叶没去玩游艺吗？\",\"dialogue\":\"\u003cp\u003e枫原万叶：你们不是也被这里吸引了吗？虽是为祭典而来，但影向山的绯樱，也还是一如既往地引人驻足呢。\u003c/p\u003e\u003cp\u003e枫原万叶：游艺那边我打算花上几天慢慢感受。山在观山色，雨来听雨声…既然是来游玩的，自然得随性些？\u003c/p\u003e\",\"icon\":\"\"}}},{\"root_id\":\"8ju7jtwiguhT1786986860550\",\"child_ids\":{\"8ju7jtwiguhT1786986860550\":[]},\"contents\":{\"8ju7jtwiguhT1786986860550\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第二天\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【梦见月瑞希】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e「铁之助」：大妖怪，真是自愿熬夜的？\u003c/p\u003e\u003cp\u003e梦见月瑞希：没错，我是自愿的。\u003c/p\u003e\u003cp\u003e「金阁」：大妖怪为什么要工作啊？\u003c/p\u003e\u003cp\u003e梦见月瑞希：…可能这就是成为大妖怪的代价吧。\u003c/p\u003e\u003cp\u003e「银阁」：大妖怪，好可怜呶…\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【鹿野院平藏】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e鹿野院平藏：真有意思…犯人的动机和手法似乎都有矛盾之处，但矛盾又是从哪开始的呢？\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【早柚、宵宫】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e旅行者：（看起来大家正在抓紧时间制作游艺…还是晚些再来吧。）\u003c/p\u003e\",\"icon\":\"\"}}},{\"root_id\":\"rr9xzqxv89cT1786966574314\",\"child_ids\":{\"rr9xzqxv89cT1786966574314\":[]},\"contents\":{\"rr9xzqxv89cT1786966574314\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第三天\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【梦见月瑞希】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e五郎：说起来，社奉行发下来的「小纸条」要怎么念啊？\u003c/p\u003e\u003cp\u003e梦见月瑞希：啊，那是神子写的，她从前就喜欢这种拗口的东西呢…要不你去问问她？\u003c/p\u003e\u003cp\u003e五郎：我…我还是问问别人吧！\u003c/p\u003e\u003cp\u003e「刑部小判」：大狗狗，在害怕呶？\u003c/p\u003e\u003cp\u003e珊瑚宫心海：我来看看吧…「天尊雷衹，今我奏命」…\u003c/p\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【早柚、宵宫、神里绫华】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e宵宫：好嘞，旅行者已经揽下最难的活了，我们也要拿出干劲来！\u003c/p\u003e\u003cp\u003e神里绫华：嗯，早柚，你昨晚睡得怎么样？还需要休息吗？\u003c/p\u003e\u003cp\u003e早柚：唔唔…就、就这一次的话，就算拿出干劲…应该也不影响长高！\u003c/p\u003e\u003cp\u003e「吉法师」：大貉妖…加油呶！\u003c/p\u003e\",\"icon\":\"\"}}},{\"root_id\":\"gvswbk2luxlT1786992165279\",\"child_ids\":{\"gvswbk2luxlT1786992165279\":[]},\"contents\":{\"gvswbk2luxlT1786992165279\":{\"option\":\"\",\"dialogue\":\"\u003ch1 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e第四天\u003c/h1\u003e\u003cp\u003e\u003cstrong\u003e【早柚、宵宫、神里绫华】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e早柚：奇怪…明明做完了游艺很开心，但总觉得好像忘了什么事情…好像是最初的目标什么的…\u003c/p\u003e\u003cp\u003e宵宫：唔…既然想不起来，那会不会，也不是什么重要的事？\u003c/p\u003e\u003cp\u003e神里绫华：那不如就先放一下，来享受「三川花祭」吧？这次的「游艺」都很让人身临其境呢。\u003c/p\u003e\u003cp\u003e「吉法师」：呶哈哈！——妖狸法术，噼咔噼咔！\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"9597","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787019266","langs":[],"template_layout":{"tab":[{"tab_id":"524","tab_name":"活动介绍","module_group":[{"module_group_id":"2716","layout":"l2r1","module":[{"id":"8981","pos":"banner"},{"id":"8979","pos":"left"},{"id":"8980","pos":"right"},{"id":"8910","pos":"left"},{"id":"8911","pos":"left"},{"id":"9597","pos":"left"},{"id":"8912","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"105","name":"活动","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"活动","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"1\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"活动类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"纪行\\\",\\\"chil