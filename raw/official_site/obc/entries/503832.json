6485/a61d948bed8dff8cb714fcf48e200e39_708836126957271704.png\"},{\"tab_name\":\"任务结束地点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/12/17/4746485/e6f6fcc45247941c96c071a4de8d4929_1710561530903174063.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"ewllh0qqr0dT1711546416025\",\"child_ids\":{\"ewllh0qqr0dT1711546416025\":[]},\"contents\":{\"ewllh0qqr0dT1711546416025\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e解开迷雾中海岛的秘密\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：啊⋯异邦的勇者⋯小心,此处⋯漆黑的大敌⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：异邦的冒失者啊。还请留步，此处是部族的禁地，如无准许，不得擅自靠近⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：异邦的冒失者，为何还不离去，此处危险重重，勿要再向内深入了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：勇者啊⋯揭开封印，如此才能打败⋯漆黑的大敌⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：帮帮我，那封印，就在附近⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：对，就是这个⋯只要⋯「灵觉」⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：就是这样，异邦的勇士，我没有看错人⋯你果然⋯\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e揭开海岛的封印\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e威严的低语：唉⋯你为何要做出如此举动，你在打开封印，一旦封印被打开⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：现在回头⋯还来得及⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：快，来到山上⋯那里是⋯下一处⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：正是如此⋯正是如此，异邦的勇者啊⋯\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e继续揭开海岛的封印\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e威严是低语：你在做什么，你知不知道这会有什么后果？冒进的异邦人，你⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：快⋯剩下两处的封印，就在深岩的地底与悬垂的高处。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：就在下面，能感觉得到⋯就在那⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：够了⋯别再靠近了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：没想到它也有如此慌乱的时候⋯好了，异邦的勇士⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：用三角的三只火炬，照亮此处⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：不，不能再让你前进了⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：本来不想这样⋯唉,夜魂们啊⋯阻止他的步伐吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：对⋯这下，还剩下⋯异邦的勇士啊⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：前往浮岛之上吧⋯那里，可以揭开⋯最后的封印⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：不，只差一点了，怎么可以让你⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：来，异邦的勇者，来吧⋯让我来助你一臂之力⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：破碎的石块，将之补全⋯快，揭开封印吧⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e威严的低语：狡猾的⋯如果⋯我⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：在这里，异邦的勇士⋯过来，这里⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：就是这样，快⋯只要用你的「灵觉」⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：快，快来⋯\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e前往被涂鸦封印的中心\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e威严的低语：你以为你真的能逃脱吗？来啊⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的声音：从来不是为了逃脱⋯这是⋯最大的差别⋯唔⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e拟覆的大灵显化身：本来我很快就能完全占据这具寄寓在人偶上的灵体⋯侵蚀此处的权柄⋯这封印给了我绝佳的机会⋯\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e与深渊魔物化作的大灵显化身战斗\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e拟覆的大灵显化身：本来我很快就能完全占据这具寄寓在人偶上的灵体⋯侵蚀此处的权柄⋯这封印给了我绝佳的机会⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e拟覆的大灵显化身：居然在最后是的时刻⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：来吧，异邦的勇士⋯同真正之夜一起，拯救那些受到蛊惑的夜魂吧⋯\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cspan\u003e与大灵显化身对话\u003c/span\u003e\u003c/h2\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：啊，终于⋯异邦的勇士啊，若不是你相助，恐怕此处早已被漆黑的大敌占据⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：⋯许久之前，此处的部族住民受到漆黑大敌显化的造型的蛊惑，诸多夜魂亦被深渊纠缠。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：受封之处，即便是夜之化身的力量也被一点点蚕食⋯此处的封印隔绝了外界，也隔绝了部族之人信念的来源。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：唯有揭开封印，才有一战之力⋯\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：多谢你啊，异邦的勇士⋯夜魂得以回归迷梦的故土，避免污秽的瘤瘿占据夜神的国度。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e虚弱的大灵显化身：啊，终于，可以回归夜的静谧之处了⋯\u003c/span\u003e\u003c/p\u003e\"}}}]}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1734488855","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"传说任务\\\",\\\"children\\\":