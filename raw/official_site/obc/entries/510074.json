达利亚：呼，总算闲下来了，准备一下就去冰钓吧。\u003c/p\u003e\u003cp\u003e达达利亚：托克上次好像说，他也想跟着去？唔，等下也把他带上吧。\u003c/p\u003e\u003cp\u003e达达利亚：哦对了，那暖炉的燃料要多带点才行…\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"11020","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8176","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"逸闻纪事对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"qk3b6skxgpmT1791787458662\",\"child_ids\":{\"qk3b6skxgpmT1791787458662\":[]},\"contents\":{\"qk3b6skxgpmT1791787458662\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e达达利亚：冬妮娅，这些东西带回去家里去吧，除了给父亲的药之外，还有一些零食，你和托克分分吧。\u003c/p\u003e\u003cp\u003e冬妮娅：你不回家么？母亲前几天又念叨你了。\u003c/p\u003e\u003cp\u003e达达利亚：…等我处理好手头的事就回家了，这次，一定在家里多待几天。\u003c/p\u003e\u003cp\u003e冬妮娅：好吧…这次别再爽约了，好吗？\u003c/p\u003e\u003cp\u003e达达利亚：行，冬妮娅，我保证。\u003c/p\u003e\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"11040","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8176","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/10/05/50494840/4d86b13cc7524d5fd5ec588061969b51_5165644006833172192.png\"}]}\n","style":""}],"id":"10897","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"8175","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"逸闻纪事·四","is_poped":false,"components":[{"component_id":"rich_base_info","l