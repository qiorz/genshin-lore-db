653608\"],\"nqb471m7nmnT1710863941173\":[\"ohqre4qoknbT1713361260396\"],\"o5oz9dkchmbT1713361581732\":[\"gqji5257a1T1713361707798\"],\"ohqre4qoknbT1713361260396\":[\"xjpfw627vyfT1713361416812\"],\"ohyvkhs07ilT1713361510628\":[\"17gw3bbv1vqT1713361536574\",\"br19mmmndasT1713361629240\"],\"sg0edhv030mT1713361905327\":[\"zz5at883vqT1713373411056\"],\"vur20kvw6crT1790521588126\":[\"z1qvpv8jn8iT1790521666210\"],\"xjpfw627vyfT1713361416812\":[\"ohyvkhs07ilT1713361510628\"],\"z1qvpv8jn8iT1790521666210\":[],\"z2tn3pzsbujT1710863943430\":[\"xjpfw627vyfT1713361416812\"],\"zz5at883vqT1713373411056\":[\"9yczax0jk34T1713373414212\"]},\"contents\":{\"17gw3bbv1vqT1713361536574\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没事儿，道上规矩都说要一报还一报。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当年闹鬼那事儿也受过你照顾，我就不跟你计较了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不好意思…】\"},\"21d8yepliahT1713361755499\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然我没能赢下这次的厨王争霸赛，但在比赛中确实学到了不少东西！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想趁着逐月节多学几道新菜，再试试香菱大厨的那些奇思妙想，没准能有意想不到的效果呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…欸，话说你咋又随随便便进来厨房了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"2c73xa0t65pT1790521653608\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咋还这么见外？有空再来啊，和我唠两句也不碍事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你先忙，不打扰了。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？！干啥？厨房咋能随便进来？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9yczax0jk34T1713373414212\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第二次逐月节（2026）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"b6t2jf1o5avT1713361586178\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e还不错。自从那之后就再也没有看到奇怪的东西了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过就算再出现也无所谓了。老板娘通过朋友认识了一位叫做重云的方士。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果再闹鬼，找他就行了。听说他对除妖驱鬼还是挺在行的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近怎么样？】\"},\"br19mmmndasT1713361629240\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，吃好啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见咯。】\"},\"gqji5257a1T1713361707798\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次逐月节期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"lj4t5tp27jT1790521505938\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e枫丹人的把戏还挺多，不过口味倒也确实新奇…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我叫言笑。厨子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没事就出去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【请、请问您是？】\"},\"o5oz9dkchmbT1713361581732\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e咋还问起这个了，我不就一厨子吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过的确很多人都说我不像是厨子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是这样的。以前是道上的。不小心劫了老板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e然后被打了一顿，关了些时候。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e放出来，老板说接我当厨子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我发现当厨子是比当强盗开心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这才是真正的我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你的身世…】\"},\"ohqre4qoknbT1713361260396\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可不咋的。没看到我切肉炖汤吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过的确很多人都说我不像是厨子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是这样的。以前是道上的。不小心劫了老板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e然后被打了一顿，关了些时候。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e放出来，老板说接我当厨子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我发现当厨子是比当强盗开心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这才是真正的我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【只、只是厨子？】\"},\"ohyvkhs07ilT1713361510628\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？咋又随随便便进来厨房了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"sg0edhv030mT1713361905327\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「有朋自远方来」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"vur20kvw6crT1790521588126\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e收获？厨子能好好卖几盘菜，听食客几句夸赞，就算有收获了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过…这回见了几个德波大饭店的同行…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e烹饪方法差距大是一码事，食材倒是不妨互换着试试。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我从他们那搞到了点发酵果实汁，听说还挺贵。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以就回了他们几盒上品豆腐，自己磨的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这发酵果实汁很不错，适中的酸口，配上一点辣椒，肯定能让肉菜吃得更有劲儿。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e先炒两盘自己尝尝，再整两盘给江雪那厮试试成色。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么收获吗？】\"},\"xjpfw627vyfT1713361416812\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务 第一章第一幕 浮世浮生千岩间后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z1qvpv8jn8iT1790521666210\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e回见。不是，别来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见咯。】\"},\"zz5at883vqT1713373411056\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e油、盐、酱、醋…嗯，储备都很充足，够用过这阵了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1790563106","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_ke