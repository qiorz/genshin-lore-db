-entry-id=\\\"6222\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/03/4521515/eaa3e43881819c3630a1cd1e2fa0a741_3100800087378155802.jpg\\\" data-entry-name=\\\"风花的呼吸\\\" data-entry-link=\\\"/ys/obc/content/6222/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6222/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e风花的呼吸\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6263\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/10/50494840/8205b476a4525d25d3954de55f716799_7246465726204603055.png\\\" data-entry-name=\\\"匿于人海的预言之谜\\\" data-entry-link=\\\"/ys/obc/content/6263/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6263/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e匿于人海的预言之谜\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1590c8pun0mT1731895721190\":[],\"4cf2vhylew3T1710863944349\":[],\"5wthhxohrxbT1731895675597\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"5wthhxohrxbT1731895675597\",\"qjl8dmbg3csT1731895684757\",\"1590c8pun0mT1731895721190\"],\"nqb471m7nmnT1710863941173\":[],\"qjl8dmbg3csT1731895684757\":[\"quc2fc0tbpT1731895700827\"],\"quc2fc0tbpT1731895700827\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"1590c8pun0mT1731895721190\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈，没事，那我接着练剑了，你可稍微离远点哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【打扰了。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e果然和我想的一样，即便是风魔龙，在琴大人的面前也不过如此嘛！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然琴大人说那位旅行者帮了大忙，但我相信这只是琴大人谦虚，最大的功劳肯定是她的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果我要是能和琴大人一起去的话，我们会一起合力击败风魔龙，然后在授勋仪式那天，她会含笑看着我…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e只是想一想就如此让人心潮澎湃…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在下一次危机来临前，我要好好练剑了，争取把握下一次机会，嗯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第三幕「巨龙与自由之歌」后\"},\"5wthhxohrxbT1731895675597\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呼…我在模仿琴大人挥剑的方式。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e每一次挥击都会感觉——真不愧是琴大人啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那种剑法，一定是精神无比强大的人才能用得出的吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e看来不能一味练习力量，精神的修行也要准备开始了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你的剑法…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么事吗？不好意思，我出了不少汗。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原，原来还可以用这种方式获胜吗…呜…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这一局就由我拿下啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/18/288180982/cc2a44c2e85425afbbd461e49fe0875d_8954345339578879523.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手一级解锁】\"},\"qjl8dmbg3csT1731895684757\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是吗？觉得我像骑士团的人吗？真的吗！？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊哈哈哈哈，这就是修炼的成果吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然我现在还不是，但我一定会通过骑士选拔的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e然后晋升队长再被提拔为琴大人的副手，等琴大人年迈退休的那天，她会握着我的手说…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，好像说得太远了，总之等着瞧吧，我会比我那没用的老爸强的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于骑士团…】\"},\"quc2fc0tbpT1731895700827\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢，我一定会成功的，就像《侍从骑士之歌》的那位「晨曦骑士」一样…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你看过这本书了吗？我可是看了很多遍的！如果有空的话，请一定要看看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"505\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/16/181950745/48928c28dea81296632cfae6238159cd_4430216047679698560.png\\\" data-entry-name=\\\"侍从骑士之歌·上篇\\\" data-entry-link=\\\"/ys/obc/content/505/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/505/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/16/181950745/48928c28dea81296632cfae6238159cd_4430216047679698560.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e侍从骑士之歌·上篇\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/11/18/288180982/b26706122e54335e75a99308e473cc62_1965196197936219007.png\",\"option\":\"【祝你成功。】——获得《侍从骑士之歌》·上篇\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然很可怕，但其实我并不太担心…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e因为我相信琴大人一定会保护我们、保护这个蒙德城的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，如果我也是骑士团的一员就好了，好希望能和琴大人一起并肩作战啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 序章第三幕「巨龙与自由之歌」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——魔神任务 序章第三幕「巨龙与自由之歌」期间\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1731896638","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_gr