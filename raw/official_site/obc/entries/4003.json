child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"b77xs35qr48T1746422914013\":[],\"elad7sdghtjT1746422633046\":[\"b77xs35qr48T1746422914013\"],\"gu2dli4cxksT1746422900537\":[\"b77xs35qr48T1746422914013\"],\"lncnh8gpqfjT1746422617369\":[\"r5jzo1kzqkT1746422632273\",\"elad7sdghtjT1746422633046\",\"wnjn9rbj9q9T1746422633731\",\"gu2dli4cxksT1746422900537\"],\"nqb471m7nmnT1710863941173\":[\"svxyh22ydvmT1746422569167\"],\"r5jzo1kzqkT1746422632273\":[\"b77xs35qr48T1746422914013\"],\"svxyh22ydvmT1746422569167\":[\"lncnh8gpqfjT1746422617369\"],\"wnjn9rbj9q9T1746422633731\":[\"b77xs35qr48T1746422914013\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次光华容彩祭（2022）期间 完成世界任务「祭典之行」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"b77xs35qr48T1746422914013\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"elad7sdghtjT1746422633046\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这次容彩祭和以往的祭典都不相同，对于游客来说应该很有意思吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过我的工作只有收钱、找钱、谢谢惠顾，有点单调呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，我不能和你闲聊太久，如果被平山编辑长看到就糟了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成世界任务「五彩光华本相」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【祭典怎么样？】——完成世界任务「五彩光华本相」前\"},\"gu2dli4cxksT1746422900537\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，欢迎再来！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"lncnh8gpqfjT1746422617369\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里是八重堂官方摊位，来看看吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里是八重堂官方摊位，不过现在还是布展阶段，要等到容彩祭开幕后才会开始营业。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"r5jzo1kzqkT1746422632273\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请随意挑选，容彩祭上有许多新书首发哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/11ee64c710e3b091256c0d349ac55461_3976610410213986095.png\",\"option\":\"【我想买些书。】——打开商店界面\"},\"svxyh22ydvmT1746422569167\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次光华容彩祭（2022）期间 完成世界任务「翠庵酩酊疑闻」后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"wnjn9rbj9q9T1746422633731\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e容彩祭上一切顺利，编辑部的大家现在终于都松了一口气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽说新刊发售会结束了，但祭典还会持续一段时间，我听说还有插花、机关棋谭这些活动…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果不是因为要在这里照看摊位，我也想去逛一逛呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【祭典怎么样？】——完成世界任务「五彩光华本相」后\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746430607","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],