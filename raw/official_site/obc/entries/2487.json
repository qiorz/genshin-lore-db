se}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"vsfx2ebfpkT1783413001110\",\"p2cyo3da7gT1783413092577\",\"gp165vupq7uT1783413128417\",\"cqq61gje0tT1783413163205\"],\"cqq61gje0tT1783413163205\":[],\"gp165vupq7uT1783413128417\":[],\"nqb471m7nmnT1710863941173\":[],\"p2cyo3da7gT1783413092577\":[],\"vsfx2ebfpkT1783413001110\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【有没有特别商品？】——打开珍奇货品商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人请便，看上了什么和我说就行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/07/288180982/650cdfd0004b3a417b36f7badeda09b4_3672707706207759164.png\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，看上什么工艺品了吗？如果在店里找不到现成的，我可以定做。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cqq61gje0tT1783413163205\":{\"option\":\"【谢谢，再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人慢走，有什么想要的下次再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gp165vupq7uT1783413128417\":{\"option\":\"【能定做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人想要什么？说说看，只要是我会做的都能安排。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这爿小店虽然不像街上那些祖传的老商户一样出名，但在制作工艺品方面还是很有一手的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e实不相瞒，在下其实是家中长子，不过从小就被人说性格木讷，怕是没那个本事继承家业。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，倒不如在这里盘一家小店，凭手艺给邻里乡亲提供一些便利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【想买些东西…】——神樱眷顾50级前\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e让我看看客人的要求…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，非常抱歉，客人需要的这些物品，鄙店还在筹备中。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e小店能力有限，有些商品需要一段时间才能进到货，麻烦客人等商品准备好之后再来吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在神樱眷顾50级后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/07/288180982/a0688e82c2c53cce368e3c470e9e64ac_6017841509397327143.png\"},\"p2cyo3da7gT1783413092577\":{\"option\":\"【关于「根付之源」…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你是说，小店为什么叫这个名字？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，看客人的样子，多半不是稻妻本地人吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「根付」是稻妻人用来挂随身物品的一种小工艺品，圆润耐用，一般会根据主人的喜好，雕刻成各种样子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e喏，像这样，绳子从腰带内侧穿过去，下面挂上钱袋、印笼之类的随身物品，绳头的根付便正好卡在腰带上了。是不是很方便？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至于「源」字…哈哈，是取自在下的名字，让您见笑了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"vsfx2ebfpkT1783413001110\":{\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手六级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，了不起，没想到客人的应对手段如此灵活…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e客人只是一些细节没有注意到而已…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/07/288180982/cc2a44c2e85425afbbd461e49fe0875d_7530603518487893155.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【想选些纪念品。】——打开纪念品商店界面、神樱眷顾50级后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我手上的确还有些别人寄卖的货物，不知是否合客人心意？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/07/288180982/a0688e82c2c53cce368e3c470e9e64ac_6258384337956560340.png\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"珍奇货品","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"197\\\" style=\\\"\\\"\u003e\u003cp\u003e\u003cstrong\u003e【商品列表】\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【商品种类】\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e价格【摩拉】\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【限购】\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"197\\\" style=\\\"\\\"\u003e\u003cp\u003e\u003cspan cla