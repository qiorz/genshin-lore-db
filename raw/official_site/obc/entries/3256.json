d":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"i238h6ebvzT1713863487907\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"i238h6ebvzT1713863487907\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，有什么需要欢迎再来哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，要买东西吗？我这里的商品价格便宜，方便实用，包你满意！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"i238h6ebvzT1713863487907\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个嘛…毕竟这里地方偏远，又不受幕府待见，物资流通困难，真不知道我来之前这些本地人是怎么生活下去的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e咳咳，总之我有我的渠道，出售的商品都是从码头运送进来的正规货物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只是每次都要被那里的士兵盘问好久，实在是麻烦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看在我帮了本地人这么大忙的份上，他们应该给我发个免检凭证之类的东西才对…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【进货方便吗？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e都在这边，请随意挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/23/183046623/11ee64c710e3b091256c0d349ac55461_5651817591984598251.png\",\"option\":\"【都卖些什么？】——打开商品页面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是专门来海袛岛做生意的商人，为村子里的居民提供物美价廉的商品。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这里的情况你也看到了吧，村子很小，村民生活闭塞，还要接济那些士兵…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e咳咳，倒不是说我看不起这里啦。正是因为这里不够发达，我们才多需要提供帮助呀。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以我常年在这里售卖低价货物，让岛上的居民都能买到需要的日用品。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你自己…】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713883176","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"