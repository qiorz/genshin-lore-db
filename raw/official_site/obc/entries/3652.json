r-upload/2024/07/10/50494840/41a53cbf3d3742b30dd4261689b9e6fc_913091138055386301.png\\\" data-entry-name=\\\"白皑谜影・重逢\\\" data-entry-link=\\\"/ys/obc/content/6907/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6907/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e白皑谜影・重逢\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e2.3：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3169\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/23/4521515/8663fd588dac1ed8547aa1fcb716a698_1647455909117603097.jpg\\\" data-entry-name=\\\"皑尘与雪影\\\" data-entry-link=\\\"/ys/obc/content/3169/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/3169/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e皑尘与雪影\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（灰中之秘）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"fsyxljzie6T1781753095521\":[],\"iou1cg92ijdT1781753000770\":[\"fsyxljzie6T1781753095521\"],\"nqb471m7nmnT1710863941173\":[\"iou1cg92ijdT1781753000770\",\"zfpwto2b06T1781753087905\"],\"zfpwto2b06T1781753087905\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【完成世界任务「白皑谜影・重逢」或版本活动任务「灰中之秘」后】\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"fsyxljzie6T1781753095521\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，你说得对。只要乔尔开心，我陪他做什么都行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我答应了他一起去堆小狐狸雪人，不知为何心里有些熟悉又温暖的感觉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过雪山还是很危险，我会保护好乔尔，不让他乱跑的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【他是因为找到你而开心。】\"},\"iou1cg92ijdT1781753000770\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e承蒙关照，一切都好。但是我的记忆还很模糊，不知道什么时候才能完全恢复…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e乔尔为了让我想起以前的事情，做了不少努力。看他这样兴奋，我也得加把劲呀。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近如何？】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，我记得你，我们又见面了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"zfpwto2b06T1781753087905\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你的帮助，祝你一路顺风。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_