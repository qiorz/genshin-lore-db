:false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"0npm75o6kcmT1741664316457\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好呀，有什么需要帮助的吗？ \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e或者有什么想要帮助「悬木人」的吗？ \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"443gh5gwigzT1741665045763\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来真的是帮手呀！谢谢你！ \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/03/11/80663279/60e98896f16b1e2f98bb1952b677ae4f_8281240272478045734.png\",\"option\":\"【关于我在「悬木人」的声望…】\"},\"4ehfwr9h0cqT1741665047611\":{\"dialogue\":\"\u003cp\u003e那请慢走哦。 \u003c/p\u003e\",\"icon\":\"\",\"option\":\"【暂时有别的事…】\"},\"4i3sq59ks0gT1741668717087\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"tsmx0thd8mT1741665046355\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，是这样的，部族里经常有忙不完的事情，有些就会变成对外开放的委托。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想要接取委托的人呢，就可以来「曜石图腾柱」这里啦。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e完成委托会有报酬哦！请务必来帮忙！ \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，「帮助」是指…】\"},\"u00xiq0nj3T1741665046971\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这里给龙看病的「医生」，请多指教！ \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哈哈，虽然听起来很厉害，但我目前只能帮小龙们上上药、谈谈心什么的，顶多只能算个见习医生。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果龙受了很严重的伤，最好还是请专业的龙医生来哦。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e比如「花羽会」的伊法哥哥，只要叫他，他就会咻地赶来！ \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，我也有很厉害的地方！虽然匿叶龙不太喜欢和人待在一起，但似乎并不排斥我呢。 \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时候，小龙们看起来身体不舒服，但其实只是心情不好…所以，陪陪他们也是一种很好的「疗愈」哦。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"}},\"root_id\":\"0npm75o6kcmT1741664316457\",\"child_ids\":{\"0npm75o6kcmT1741664316457\":[\"443gh5gwigzT1741665045763\",\"tsmx0thd8mT1741665046355\",\"u00xiq0nj3T1741665046971\",\"4ehfwr9h0cqT1741665047611\"],\"443gh5gwigzT1741665045763\":[\"4i3sq59ks0gT1741668717087\"],\"4ehfwr9h0cqT1741665047611\":[\"4i3sq59ks0gT1741668717087\"],\"4i3sq59ks0gT1741668717087\":[],\"tsmx0thd8mT1741665046355\":[\"4i3sq59ks0gT1741668717087\"],\"u00xiq0nj3T1741665046971\":[\"4i3sq59ks0gT1741668717087\"]}}]}\n","style":""}],"id":"6144","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1744165479","langs":[],"template_layout":{"tab":[{"tab_id":"75","tab_name":"页签1","module_group":[{"module_group_id":"702","layout":"l2r1","module":[{"id":"1229","pos":"left"},{"id":"1230","pos":"right"},{"id":"6143","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"703","layout":"l1r1","module":[{"id":"1231","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"704","layout":"l1r1","module":[{"id":"1232","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"705","layout":"l1r1","module":[{"id":"1233","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"706","layout":"l1r1","module":[{"id":"1234","pos":"banner"},{"id":"6144","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0