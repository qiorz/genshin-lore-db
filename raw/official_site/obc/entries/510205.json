ontents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"tab_name\":\"这小家伙…——2026-03-23\",\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e今天咔库库可是给了我一个惊喜。\u003c/p\u003e\u003cp\u003e它一大早就飞了出去，直到午饭时间也没回来。想着它玩这么久肯定饿了，我正准备带上吃的去找，就听见一阵轰隆隆的声音由远及近。\u003c/p\u003e\u003cp\u003e出门就看见咔库库率领着一群龙狂奔过来，每一只龙嘴里还叼着水果和花。\u003c/p\u003e\u003cp\u003e原来都是我之前的患者。哈哈，看来它们是和咔库库商量好了要在我生日这天给我一个惊喜啊。\u003c/p\u003e\u003cp\u003e能看到它们这样有精神，我的确很高兴。这下今天要做一顿丰盛的午餐了。\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501913\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/183046623/8afb298a4333d138a542bf561115e494_2724666528930906278.png\\\" data-entry-name=\\\"青蜜莓\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/501913/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/501913/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e青蜜莓\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501957\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/24077343/8166622af618bfbdec732bd3b8f48be6_3131202153264596437.png\\\" data-entry-name=\\\"烬芯花\\\" data-entry-amount=\\\"5\\\" da