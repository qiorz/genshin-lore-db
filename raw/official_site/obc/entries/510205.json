e":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"默认标题\",\"image\":\"\"}]}\n","style":""}],"id":"8175","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"k45b6lim3jpT1757441158030\",\"child_ids\":{\"k45b6lim3jpT1757441158030\":[]},\"contents\":{\"60ply1mx6afT1763004827776\":{\"option\":\"旅行者：在给小龙们做药物？\",\"dialogue\":\"\u003cp\u003e伊法：很有洞察力嘛，旅行者。\u003c/p\u003e\u003cp\u003e伊法：喏，我刚琢磨出来的新药，用来治疗小龙们的厌食症很有效。\u003c/p\u003e\u003cp\u003e伊法：不过，这种药似乎太有效了。不厌食的小龙吃了之后，甚至变得有些…暴饮暴食。\u003c/p\u003e\u003cp\u003e伊法：前几天，咔库库趁我不注意的时候偷吃了两块，结果…\u003c/p\u003e\u003cp\u003e咔库库：还能吃，哥们！\u003c/p\u003e\",\"icon\":\"\"},\"86ut93easfgT1763004828504\":{\"option\":\"旅行者：确实有效！\",\"dialogue\":\"\u003cp\u003e伊法：哈哈哈哈哈，看来，我要调整一下这种药本身的味道了。\u003c/p\u003e\u003cp\u003e伊法：不然，恐怕纳塔马上要多出不少体重超标的小龙了。\u003c/p\u003e\u003cp\u003e咔库库：不会吧，哥们！\u003c/p\u003e\",\"icon\":\"\"},\"k45b6lim3jpT1757441158030\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8176","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"名称\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"上线时间\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"相关奖励\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]}]}\n"