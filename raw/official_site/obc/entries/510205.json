6e18108c97cffe3484_8819842933943285440.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/74117533\\\" target=\\\"_blank\\\"\u003e伊法生日快乐 | 别误会，不是让你吃这些小家伙们的饭的意思…\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}]}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"q4fr2idwo6T1757441158046\",\"child_ids\":{\"04bxunajfkq5T1757442297079\":[\"ro5s9x9ptpT1757442323675\"],\"2y0x0sjhaslT1757442519443\":[\"hvre9k6mh7mT1757442561578\"],\"4im79qvn5vtT1757442596196\":[\"iw0tgv8g9j9T1757442615034\"],\"6f20rhz6wdhT1757442282104\":[\"04bxunajfkq5T1757442297079\"],\"8b8j1hma9zfT1757442496984\":[],\"94vhlfu5om5T1757441808399\":[\"cnu7cbqqw17T1757441818456\"],\"9e074pcrbxcT1757442423316\":[\"8b8j1hma9zfT1757442496984\"],\"cnu7cbqqw17T1757441818456\":[\"6f20rhz6wdhT1757442282104\"],\"dypkh615jb5T1757442393722\":[\"9e074pcrbxcT1757442423316\"],\"hkxcjzls26pT1757442347207\":[\"jdaig83garpT1757442391703\",\"dypkh615jb5T1757442393722\"],\"hvre9k6mh7mT1757442561578\":[\"4im79qvn5vtT1757442596196\"],\"iw0tgv8g9j9T1757442615034\":[\"o84umix39udT1757442636360\"],\"jdaig83garpT1757442391703\":[\"8b8j1hma9zfT1757442496984\"],\"o84umix39udT1757442636360\":[],\"pmtmnewq9jT1757441668656\":[\"hkxcjzls26pT1757442347207\",\"w8g81t58l09T1757442349102\"],\"pnx60k66rejT1757441773008\":[\"94vhlfu5om5T1757441808399\"],\"q4fr2idwo6T1757441158046\":[\"vo9wl2vh4fT1757441666287\",\"pmtmnewq9jT1757441668656\",\"s4r7tz4c909T1757441669753\",\"ud3iydws6qT1757441670492\",\"uyj72y0gxi9T1757441671521\"],\"ro5s9x9ptpT1757442323675\":[],\"s4r7tz4c909T1757441669753\":[\"2y0x0sjhaslT1757442519443\",\"xurj7e9miwkT1757442520757\"],\"ud3iydws6qT1757441670492\":[],\"uyj72y0gxi9T1757441671521\":[],\"vo9wl2vh4fT1757441666287\":[\"pnx60k66rejT1757441773008\"],\"w8g81t58l09T1757442349102\":[\"jdaig83garpT1757442391703\",\"dypkh615jb5T1757442393722\"],\"xurj7e9miwkT1757442520757\":[\"hvre9k6mh7mT1757442561578\"]},\"contents\":{\"04bxunajfkq5T1757442297079\":{\"option\":\"【听上去你对你的朋友颇有微词。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？能听出来吗？好吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"2y0x0sjhaslT1757442519443\":{\"option\":\"【请尽情学习吧！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，不收我学费吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4im79qvn5vtT1757442596196\":{\"option\":\"【勾勾手？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对，只是看着简单。角度和频率都很重要。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不紧不慢，温和一点。勾手的频率也别太低，这样它们就能感觉到你很有活力。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e做得好的话，猫狗和龙都会主动跑来跟你打招呼。对它们来说这是友好的信号。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6f20rhz6wdhT1757442282104\":{\"option\":\"【为什么呢？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e热爱生活的人往往愿意主动收拾屋子，也不会把一切搞得乱七八糟。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这样你的负担就会小得多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8b8j1hma9zfT1757442496984\":{\"option\":\"【伊法做事好周到啊，谢谢你。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你能这么想，我很高兴。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过不瞒你说，我小时候也很丢三落四，当了医生以后才好起来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e糟糕事难免有，但总会过去的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也祝你无论遇到什么困难都能越过去。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"94vhlfu5om5T1757441808399\":{\"option\":\"【听起来像在夸我。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e然。对于那些帮助了纳塔的伙伴，我没必要吝惜赞美。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e据我观察，你是一个对野外生活很有心得，也很热爱生活的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种类型的人适合做\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"9e074pcrbxcT1757442423316\":{\"option\":\"【这个脆多了呢。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嚼得动就好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，这袋肉干给你，拿去喂龙可以跟它们搞好关系。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不确定你是否有这种需要，先拿着吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cnu7cbqqw17T1757441818456\":{\"option\":\"【听起来像在夸我。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然。对于那些帮助了纳塔的伙伴，我没必要吝惜赞美。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e据我观察，你是一个对野外生活很有心得，也很热爱生活的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种类型的人适合做\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"dypkh615jb5T1757442393722\":{\"option\":\"【谢谢，不过…很难嚼呢…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e糟糕，默认你的牙口和龙一样好了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不好意思，那换些别的吧，还有烤好的小饼干…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hkxcjzls26pT1757442347207\":{\"option\":\"【是用来喂龙的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e自己吃也行，喂龙也行，多带点食物不会错。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些是我自己烤的肉干，尝尝吧，很好吃的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hvre9k6mh7mT1757442561578\":{\"option\":\"【伊法也教我点什么吧？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e教你啊，唔，我想想…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e像你这种成熟独立的冒险家，会的东西已经很多了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e非要学点什么的话…来，学习一下这个手势。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"iw0tgv8g9j9T1757442615034\":{\"option\":\"【学到了！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很实用吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jdaig83garpT1757442391703\":{\"option\":\"【好脆，好好吃！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是吗？那就好。还有撒了其他调料的，下次带给你。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，这袋肉干给你，拿去喂龙可以跟它们搞好关系。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不确定你是否有这种需要，先拿着吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"o84umix39udT1757442636360\":{\"option\":\"【对了，能吹口哨吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个我不推荐。对小动物可能还好，对龙吹口哨，有可能激怒它们。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e纳塔有些龙自尊心很强，甚至还很聪明。不要试图糊弄那群家伙。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e跟龙相处，本质上和跟人交往差不多。真心换真心才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"pmtmnewq9jT1757441668656\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我这里有零食，正好，来点吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"pnx60k66rejT1757441773008\":{\"option\":\"【不愧是兽医，总想着动物。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e每个人都有自己必须关注的事，就像你们冒险家也会对冒险的事格外有心得。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e又或者，你对拯救各个地方更有心得？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"q4fr2idwo6T1757441158046\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你一个人住这么好的地方？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不错，这里能养十头龙了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ro5s9x9ptpT1757442323675\":{\"option\":\"【是指欧洛伦吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那倒不是。他的生活习惯还是很良好的。要知道，做事乱七八糟的人根本种不好菜。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我说的是那些龙伙伴。既然是伙伴，也可以算朋友。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e龙发起脾气来比人厉害多了，会像狂风一样袭击你家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种时候你得想办法安抚它们。至于算账嘛…都是后话了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"s4r7tz4c909T1757441669753\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e想在你这里四处看看，参考学习一下布置手法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有些摆设放得很有趣，还很实用。正好我也想调整一下自家的院子。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ud3iydws6qT1757441670492\":{\"option\":\"【早安，伊法。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早啊，起得挺早的嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e保持良好作息，你会获得健康。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"uyj72y0gxi9T1757441671521\":{\"option\":\"【晚安，伊法。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安。早点休息，能睡就多睡一会儿。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我还要给病患们写个病历，晚点再睡。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"vo9wl2vh4fT1757441666287\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e挺不错的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e空气清新，场地宽敞，人在这里舒服，宠物或龙过来也没问题。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"w8g81t58l09T1757442349102\":{\"option\":\"【是应急的干粮吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e自己吃也行，喂龙也行，多带点食物不会错。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这些是我自己烤的肉干，尝尝吧，很好吃的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xurj7e9miwkT1757442520757\":{\"option\":\"【这是大师我的匠心之作。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e让我偷师一下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/2f8def3fb964a92fac299d38bf94e8dc_5003024076116964822.png\"}]}\n","style":""}],"