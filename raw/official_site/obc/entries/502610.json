rder":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"created_at\":\"\",\"list\":[],\"author\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"fxw4agf48aT1727189666790\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"dg0l5gfvn4T1727189301027\",\"tithe6twewgT1727189302280\"],\"dg0l5gfvn4T1727189301027\":[],\"fxw4agf48aT1727189666790\":[],\"nqb471m7nmnT1710863941173\":[],\"tithe6twewgT1727189302280\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【声音太大会有什么影响吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个问题问得好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很多人在做东西的时候会忽略环境因素，你能这样问就已经和他们拉开差距了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他们都知道澄晶实粉的多少会影响药剂的功能，知道符咒多画上一笔就可能导致完全不同的效果。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那怎么就不能理解声音也会影响材料合成的结果呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘘，这里不能大声讲话。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e想买什么自己拿，把钱留在旁边就好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"dg0l5gfvn4T1727189301027\":{\"icon\":\"\",\"option\":\"【不怕丢东西吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你这个问题问得不好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一旦将不劳而获的想法讲出来，就算是品德高尚的人，心中也会被埋下不好的种子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过这里没关系的，反正卖的都是些寄售在摩尔石屋的杂货。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就算搞丢了一两件商品，只要老夫随手画两道祝祷之符，也就赚回来了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"fxw4agf48aT1727189666790\":{\"icon\":\"\",\"option\":\"【道理我懂，但周围并不安静…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…啊，你说的这个，老夫当然已经考虑在内了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我在这里的一切行动，都是建立在已有的环境基础上进行的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e过往的人流自然会带来不同的故事，这些…嗯，这些也是制作工序中的一部分。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e按照我们烟谜主的说法：「一切都已洞悉，未来已成过去。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/09/24/288180982/415b6e81005dd9122bbda4b2f4280ef4_3158363983478671309.png\",\"option\":\"【想要借用合成台。】——打开合成界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e空着的台子随便用，不用特意跟我讲。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"tithe6twewgT1727189302280\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢点走，脚步轻一些。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/09/24/288180982/661f4aed07b4e34115c0ea22f4b4b711_1130253089025088949.png\",\"option\":\"【有什么卖的？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e喏，这些，和，这些…全在这里了。没有的就是缺货。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"炼金列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501697\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/28/76362111/d8aa4bdb17f0e16298b05c10bc149846_1347587270460355323.png\\\" data-entry-name=\\\"可炼金物品索引\\\" data-entry-link=\\\"/ys/obc/content/501697/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/501697/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/07/28/76362111/d8aa4bdb17f0e16298b05c10bc149846_1347587270460355323.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e可炼金物品索引\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"6147","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":fals