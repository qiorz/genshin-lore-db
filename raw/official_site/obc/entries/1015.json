terial-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e商机无限\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"06ros5uzloxkT1724588574652\":[\"9wuz59fm9mqT1724691296387\"],\"0ev1d1f6rh3kT1724691305938\":[],\"4cf2vhylew3T1710863944349\":[\"kac8y9dityjT1724691199141\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"9wuz59fm9mqT1724691296387\":[\"i7fj76t9i7lT1724588593610\"],\"aloqhwyke1gT1724691247597\":[\"gmbz8pdboijT1724588529135\"],\"gmbz8pdboijT1724588529135\":[\"vkwwm2vmchrT1724691280213\"],\"i7fj76t9i7lT1724588593610\":[\"0ev1d1f6rh3kT1724691305938\"],\"kac8y9dityjT1724691199141\":[\"po4fgdhttlT1724588508302\"],\"mzjx5itjq7nT1724588397661\":[\"kac8y9dityjT1724691199141\"],\"nqb471m7nmnT1710863941173\":[\"kac8y9dityjT1724691199141\"],\"po4fgdhttlT1724588508302\":[\"aloqhwyke1gT1724691247597\"],\"vkwwm2vmchrT1724691280213\":[\"06ros5uzloxkT1724588574652\"],\"z2tn3pzsbujT1710863943430\":[\"mzjx5itjq7nT1724588397661\"]},\"contents\":{\"06ros5uzloxkT1724588574652\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e霄灯的光芒真是温暖…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且不知道是不是因为音乐节的演出，舞台的灯光让霄灯更加明亮了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种炽热的温度，让人思念家乡的炉火啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"0ev1d1f6rh3kT1724691305938\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，下次货到了再来看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，朋友！抱歉，我手上的商品已经断货了，请下次再来吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"9wuz59fm9mqT1724691296387\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第四次海灯节（2024）期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\"},\"aloqhwyke1gT1724691247597\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次逐月节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\"},\"gmbz8pdboijT1724588529135\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e逐月节可真热闹啊，看璃月人都在忙着准备美食，我也有些跃跃欲试了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你说，用至冬的食材做馅料，烤一些饼类的点心拿来卖，会不会是个好主意啊？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"i7fj76t9i7lT1724588593610\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来风筝的形状可以这样千奇百怪…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，我说的「千奇百怪」，是称赞的意思。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们商人，最喜欢的就是新奇玩意儿了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能把这个模式套用到别的商品上…哦，再加上枫丹引进的机械装置，可能是个不错的新市场。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"kac8y9dityjT1724691199141\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次海灯节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\"},\"mzjx5itjq7nT1724588397661\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/288180982/b26706122e54335e75a99308e473cc62_7622830743594519796.png\",\"option\":\"【我怎么觉得附近凉飕飕的？】——获得哀叙冰玉断片*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你也这么感觉么！原来不是我的幻觉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明我穿了这么多，却还总是冻得直哆嗦，我研究研究是怎么回事…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦！原来是我口袋里的这块石头，嗯…估计是我在家乡时候不小心落进口袋的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯？你感兴趣吗，反正这种算不上是矿石的货，在我这边也没销路，那就送给你好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"858\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/5e8bc93c3fb60d77b6363292f98cbb84_8442728250190718596.png\\\" data-entry-name=\\\"哀叙冰玉断片\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/858/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/858/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/5e8bc93c3fb60d77b6363292f98cbb84_8442728250190718596.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e哀叙冰玉断片\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【你是…？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很高兴见到你，我叫伊凡诺维奇，是来自至冬国的商人。正在等下一批商品到货。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e璃月人可真有钱啊…我每次从至冬国进货，都很快就卖完了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e早知道我在璃月开一家门面，直接面向这边的顾客销售，就不用每次都要自己亲自监督运货了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"po4fgdhttlT1724588508302\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e霄灯的光芒真是温暖…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看看灯火通明的街道和升上夜空的霄灯，尽管是在异国他乡，心中却有了些许难以言状的温暖。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这份温暖，让我想起了我们至冬的「冰炉节」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有机会，也请来我们至冬做客吧，感受一下我们的节日。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"vkwwm2vmchrT1724691280213\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第三次海灯节（2023）期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【你是卖什么的？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，准确来说我是经销商，专卖至冬国生产的日用品。另外，我也会为这边的石珀商人做代理销售，主要面向至冬国的工厂。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最近七星商会对我们至冬国的高层盯得很紧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有人说我们之所以能从璃月的商人手中买到石珀，是我国那些大人物们从中斡旋的结果…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过此中缘由，恕我不做评论。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们的商品虽然产量不小，但价格可不低。所以说…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我对璃月的消费者评价很高。他们总是能达成高于预期的消费额。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724693703","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}]