\\\"506171\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/08/83684823/41a53cbf3d3742b30dd4261689b9e6fc_3574989093243658636.png\\\" data-entry-name=\\\"织卷上的挑战\\\" data-entry-link=\\\"/ys/obc/content/506171/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506171/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e织卷上的挑战\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e7.0：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509391\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/12/50494840/afdc26f30721a552f665dcca715f493d_7862405484451089751.png\\\" data-entry-name=\\\"新芽相助·初探雪原\\\" data-entry-link=\\\"/ys/obc/content/509391/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509391/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e新芽相助·初探雪原\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509539\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/15/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4496608225903333295.png\\\" data-entry-name=\\\"互助与「强化」的诀窍？\\\" data-entry-link=\\\"/ys/obc/content/509539/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509539/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e互助与「强化」的诀窍？\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509641\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/19/83684823/41a53cbf3d3742b30dd4261689b9e6fc_7586917490080190588.png\\\" data-entry-name=\\\"共享诀窍的约定…\\\" data-entry-link=\\\"/ys/obc/content/509641/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509641/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e共享诀窍的约定…\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"3t59nwyxrspT1787499782229\":[\"6vbp4lxrcvtT1787499796478\",\"k236bggkr19T1787499799013\"],\"479ek3esxidT1787499816628\":[\"j4f01jqkiz7T1787499871028\"],\"5whgh1wikx8T1787499635111\":[\"y51jqnts8b9T1787499741375\",\"3t59nwyxrspT1787499782229\",\"qmyxkti8ujT1787499852374\"],\"6vbp4lxrcvtT1787499796478\":[\"479ek3esxidT1787499816628\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"j4f01jqkiz7T1787499871028\":[],\"k236bggkr19T1787499799013\":[\"479ek3esxidT1787499816628\"],\"nqb471m7nmnT1710863941173\":[\"5whgh1wikx8T1787499635111\"],\"qmyxkti8ujT1787499852374\":[\"j4f01jqkiz7T1787499871028\"],\"y51jqnts8b9T1787499741375\":[\"j4f01jqkiz7T1787499871028\"]},\"contents\":{\"3t59nwyxrspT1787499782229\":{\"option\":\"【先说说你们的情况？】\",\"dialogue\":\"\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，我们…我们是来远游锻炼的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「小松果」的爸爸，也就是「塞提阿德的砂刃」阿姆鲁叔叔，教了我们很多战斗的本领。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是因为常年在纳塔待着，不了解其他地方的战士，也不太像话。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，爸爸就给了我们一大笔旅费，让我们来至冬好好锻炼一番。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"479ek3esxidT1787499816628\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我，我们都不小了哦，我已经十二岁了，「小松果」也十岁了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「沃陆之邦」的瓦雷莎姐姐在我们这么大的时候，好像都已经打败过几百只魔物了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e再过几年，我们也该像基尼奇哥哥和阿乔领主那样，成为部族的正式战士。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这回只是出国锻炼一下，跟着琪琪科娃姐姐，找了几只大白熊练了练拳击和摔跤而已。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e完全没有招惹厉害的家伙，不会有事的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e爸爸说过，老是待在安逸的环境里，人会变呆变慢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大喜儿姐姐也说，璃月人都抱着一种，怎么说的来着…那种心态，在努力锻炼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…居安思危？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对的对的，居安思危！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e随时做好坏家伙还会冒出来的准备，全力锻炼，碰见不妙的情况，就不会慌张。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等到下次，纳塔需要更多战士的时候，我和木头人都要站出来帮忙！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5whgh1wikx8T1787499635111\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「新芽相助 · 初探雪原」期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cp\u003e杜杜杜杜杜杜杜杜麦尼！您是不是有什么秘密任务？不方便透露身份？\u003c/p\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cp\u003e需要我们做什么吗？虽然我们本领不强，但您交待的任务，我们一定全力以赴！\u003c/p\u003e\",\"icon\":\"\"},\"6vbp4lxrcvtT1787499796478\":{\"option\":\"【放你们两个小孩到国外玩吗…】\",\"dialogue\":\"\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「炽烈传说·跨界乱斗」期间 未完成「炽烈的还魂诗」】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有机会就创造机会！厉害的战士都会主动寻找适合自己发挥的情景，所以不能单凭场地环境下定论！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这倒是没说错，按「马力卜」的习惯，只要一被敌人甩开，他就会「呼」腾空而起，抄近道，想办法来个出其不意的截击！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【旅行者】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（这两个孩子好像讨论得非常入神，还是不要打扰他们了吧…）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"j4f01jqkiz7T1787499871028\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【版本活动「新芽相助 · 初探雪原」期间  完成「共享诀窍的约定」后】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【琪琪科娃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e接下来，你们都有什么打算？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【大喜儿】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e听说东南方向有座很大的雪山，那里的环境相当恶劣，不同凡响，我想去挑战一下自己…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「燃爆木头人」\u0026「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我们也一起！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【琪琪科娃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，不过那边我不太熟，村里的大人们也叮嘱过，千万不要随意靠近。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e远远参观一圈，就要回来了喔？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"k236bggkr19T1787499799013\":{\"option\":\"【这么看来，你爸也是真心大…】\",\"dialogue\":\"\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「炽烈传说·跨界乱斗」期间 已完成「炽烈的还魂诗」】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有机会就创造机会！厉害的战士都会主动寻找适合自己发挥的情景，所以不能单凭场地环境下定论！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这倒是没说错…如果换成「杜麦尼」那样的强者，应该会一剑铲平山丘，干掉不舒服的场地，来一场公平的单挑！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【旅行者】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（这两个孩子好像讨论得非常入神，还是不要打扰他们了吧…）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"qmyxkti8ujT1787499852374\":{\"option\":\"【没事，不打扰你们玩啦。】\",\"dialogue\":\"\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我我我，其实我还蛮想被杜麦尼打扰的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e感觉…杜麦尼还有事？等你不那么忙了，请和我们一起玩吧！几分钟也好！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"y51jqnts8b9T1787499741375\":{\"option\":\"【任务是让大家一起变强。】\",\"dialogue\":\"\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那那那，我们已经开始锻炼了，不会让您失望的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「小松果」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e琪琪科娃姐姐让我们用留影机观察各种小动物，我们就去找猎人学习，不惊动它们…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种本领，就是一些烟谜主勇士精通的「潜伏」吧？也可以用在竞技比赛里！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【「燃爆木头人」】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还有还有，对着手册到处转悠，路上都会碰到厚厚的积雪，还有厉害的风雪…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们也要适应冷冷的环境，学会使用更多新鲜的冰雕！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787538260","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module