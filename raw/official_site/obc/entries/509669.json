{"retcode":0,"message":"OK","data":{"page":{"id":"509669","name":"「燃爆木头人」","desc":"「燃爆木头人」","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/23/178964736/41d7635a2c394d3b90aef45276994d0c_97793672250945316.png","header_img_url":"","modules":[{"name":"「燃爆木头人」","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e\u003c/p\u003e\"],\"key\":\"编者注\"}],\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/23/178964736/56370ee34fa426ef15cb3b32d305d236_2164097156314650311.png\",\"attr\":[{\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"],\"key\":\"性别\"},{\"value\":[\"\u003cp\u003e【炽烈传说·跨界乱斗】回声之子\u003c/p\u003e\u003cp\u003e【新芽相助·初探雪原】海屑镇\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"职业\"},{\"value\":[\"\u003cp\u003e暂无\u003c/p\u003e\"],\"key\":\"功能\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/23/178964736/65f70ce4b42422de39017fadab5edcf0_702123045678975387.png\"},{\"tab_name\":\"位置\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/23/178964736/976c33129917ae8f64c13d7a1c562671_1436866832754225095.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\