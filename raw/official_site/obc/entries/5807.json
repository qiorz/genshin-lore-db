name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e「七圣召唤」，其中有些牌上的画很好看吧，我在收集好看的牌。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e美丽，也是另外一种胜利呢！怎么样，要来一局「七圣召唤」吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【恭敬不如从命。】——进行七圣召唤对局【牌手一级解锁】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e只顾着牌面漂亮，有的时候就会非常难用···不过我是不会因此改变我的信念的，下次再打牌吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e用好看的牌收获漂亮的胜利，这就是我的目标！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【之后再说吧···】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e好吧，不过你要找到什么牌面好看的牌，记得来找我哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"【决斗对局】：七夜由美","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"七夜由美\",\"created_at\":\"2023-1-8\",\"list\":[{\"energy_bg\":0,\"e