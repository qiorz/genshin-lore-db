e_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2yoe4zrwdo8T1776591165062\":[],\"4cf2vhylew3T1710863944349\":[\"591oyab6zt4T1776591163679\",\"2yoe4zrwdo8T1776591165062\"],\"591oyab6zt4T1776591163679\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"atfc3jd8zxlT1776591097289\"],\"atfc3jd8zxlT1776591097289\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"2yoe4zrwdo8T1776591165062\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"【离开。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵…应该也能算是朋友吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e很久以前的事了。那时我还年轻，在挪德卡莱做些…不那么光彩的生意，姑且算是一群走投无路的可怜人们的头儿吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e快快活活过了几年，结果遇上了一个名叫卡嘉的宝藏猎人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那姑娘和我差不多大，只凭着一腔热血，说是要制止我的恶行…前前后后揍了我七八回，却一直没有要我的命。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她和我说，那样游走法外的日子终究还是长不了的。再这样下去，早晚会有其他人要取我性命…不是她，总有别人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她说得对。所以…我就把钱财全都分给了海螺帮的小鬼，出海冒险去了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e后面的事就没什么意思了。也不知道那女人是不是还活着…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵，你这香水倒是让我想起她来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【老朋友？】\"},\"591oyab6zt4T1776591163679\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵…那我就不客气地收下了。谢谢你，慷慨的客人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这香氛的气息…清冽，又带着点不服输的倔强…就和那姑娘一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来而不往可不行。虽说我只是个普通的餐馆老板，拿不出什么稀罕的宝物，但要是不嫌弃的话，就请收下这个吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/1f321f032da3385996c4f77aab7fb1c5_3479981062891798313.png\\\" data-entry-name=\\\"《阿伊·哈努姆之歌》\\\" data-entry-link=\\\"/ys/obc/content/508363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/10/317305234/1f321f032da3385996c4f77aab7fb1c5_3479981062891798313.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e《阿伊·哈努姆之歌》\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1025\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/d50fb37e3954b2b7105c61cf8f442c6e_7679619291811796065.png\\\" data-entry-name=\\\"大英雄的经验\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1025/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/20/15568211/d50fb37e3954b2b7105c61cf8f442c6e_7679619291811796065.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大英雄的经验\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"21500\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*21500\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/19/288180982/cc70592f615b485afe4437ec77de50a8_6533004945267767296.png\",\"option\":\"【（赠送香氛。）】———赠送香水·风息*1，获得《阿伊·哈努姆之歌》、大英雄的经验*2、摩拉*21500\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【未使用\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e北大陆的美味就在这里，来尝尝吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【使用\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508296\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/08/105506159/5f31846a5abb2cebeca32dc4efc2f531_6031364204126372652.png\\\" data-entry-name=\\\"特制香水·风息\\\" data-entry-link=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508296/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e特制香水·风息\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e后】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，那个香氛…呵呵，让我想起了一位老朋友呢。来，别站那么远，坐下喝杯热茶吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"atfc3jd8zxlT1776591097289\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，菜单就在这里了，请看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/19/288180982/8c1682d1176d5e5c252663655f810639_2513865955957609400.png\",\"option\":\"【有什么推荐菜吗？】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e只是个普通的餐馆老板而已，没什么特别的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e比起那个，要不要来尝尝看我们厨师的手艺？既然到了荆夫港，还是应该体验一下这里的特色菜呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1776651134","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name"