\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;所附属角色\u0026lt;strong\u0026gt;普通攻击\u0026lt;/strong\u0026gt;造成的伤害+1，造成的\u0026lt;strong\u0026gt;物理伤害\u0026lt;/strong\u0026gt;变为\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026quot;color:rgba(24,144,255,1)\u0026quot;\u0026gt;水元素伤害\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;。\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;white-space: pre-wrap;\u0026quot;\u0026gt;\u0026lt;strong\u0026gt;可用次数：2\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e的效果时，对于生命值不多于6的敌人伤害+2。\u003c/p\u003e\u003cp\u003e（牌组中包含神里绫人，才能加入牌组）\u003c/p\u003e\"]},\"tab_id\":\"1759479143814_0\"}],\"baseInfoSwitchDisabled\":false,\"repeated\":true}","style":""}],"id":"8550","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ch1 class=\\\"custom-heading-cls\\\"\u003e\u003cstrong\u003e天赋牌\u003c/strong\u003e\u003c/h1\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":true}\n","style":""}],"id":"8551","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":true,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1787038068","langs":[],"template_layout":{"tab":[{"tab_id":"49","tab_name":"七圣召唤","module_group":[{"module_group_id":"87","layout":"l1r1","module":[{"id":"131","pos":"left"},{"id":"132","pos":"right"},{"id":"133","pos":"left"},{"id":"134","pos":"left"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"2630","layout":"l2