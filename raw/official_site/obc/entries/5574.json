3c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬前】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e亲爱的，你怎么又偷偷跑出来了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你别急，不用担心，晚上天气没有那么炎热，我正好可以出来透透风。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但正是因为昼夜温差大，才更要注意身体啊。而且，你还是待在绿色植物比较多的地方比较好⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯，我知道的。只是偶尔，偶尔出来转转。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e倒是你哦，年纪轻轻，说话反而越来越像我家长辈了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e没、没有吧⋯关心你的人都会这么说的⋯咳，话说，之前给你的盆栽长得还好吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e呜⋯谢谢你送我的花，很漂亮，但是叶子已经有点发黄了⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e对不起，是我没有照顾好它们⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哎，哎，别道歉啊！没关系的，不是你的错！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬后】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e亲爱的，你怎么又偷偷跑出来了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你别急，不用担心，晚上天气没有那么炎热，我正好可以出来透透风。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e但正是因为昼夜温差大，才更要注意身体啊。你大病初愈，还是需要再休养一阵⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯，我知道的。只是偶尔，偶尔出来转转。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e倒是你哦，年纪轻轻，说话反而越来越像我家长辈了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e没、没有吧⋯关心你的人都会这么说的⋯咳，话说，之前给你的盆栽长得还好吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【内尔敏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e呜⋯谢谢你送我的花，很漂亮，但是叶子已经有点发黄了⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e对不起，是我没有照顾好它们⋯\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【里夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e哎，哎，别道歉啊！没关系的，不是你的错！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762236962","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layou