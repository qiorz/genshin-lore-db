t":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e玩家攻略推荐：\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/7768866\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e【稻妻世界任务】诸国游记\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\\t\\t作者：\u003c/strong\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(102, 102, 102)\\\"\u003eDramaturge\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"02a5vr8b3ya5T1713678189164\":[\"cb5kwydt1gsT1713678234663\"],\"1eiecydx2bnT1713693695125\":[\"spfv3zzkxt7T1713693725787\",\"9i07lyegsuT1713693726210\"],\"6rygdxvdvt3T1713693771714\":[],\"9i07lyegsuT1713693726210\":[\"6rygdxvdvt3T1713693771714\"],\"cb5kwydt1gsT1713678234663\":[\"rn55v7zb1wT1713678282693\",\"frcuaqm1es8T1713678283016\"],\"ewllh0qqr0dT1711546416025\":[\"02a5vr8b3ya5T1713678189164\",\"yd0oy2fo9wlT1713678189505\"],\"frcuaqm1es8T1713678283016\":[\"1eiecydx2bnT1713693695125\"],\"rn55v7zb1wT1713678282693\":[\"1eiecydx2bnT1713693695125\"],\"spfv3zzkxt7T1713693725787\":[\"6rygdxvdvt3T1713693771714\"],\"yd0oy2fo9wlT1713678189505\":[\"cb5kwydt1gsT1713678234663\"]},\"contents\":{\"02a5vr8b3ya5T1713678189164\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e反、反正拉姆齐叔叔是这么讲给我听的…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者： 真的假的…\"},\"1eiecydx2bnT1713693695125\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e没错，严肃地来说，这些「游记」都不是真的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e虽然有些地点和人物趋势取材于现实…但大部分的内容，都是出自于我个人的想象。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e当然啦，有些内容不完全是想象的。比如我正在写的一篇「游记」里，一个人制作了一个超级气球。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e然后他召集了几位同伴，想要用这个气球在八十天内患有提瓦特大陆一圈。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e而且，操作这个气球完全不需要「神之眼」，只需要有技术常识就行。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这群人搭着气球环游着世界，一路上遇见了无数奇怪的事物和现象…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这篇本来就是我准备写给小绿的，但因为…某些原因，我到现在连一小段都没机会写完。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e什么原因？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你看见走廊上那个家伙了吗？他叫平八，不知道从什么时候起，那家伙就一直盯着我。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我本来想出去采风，给那篇「游记」取取材，但那家伙每次都跟着我，不知道想做什么。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e因为担心这家伙对我图谋不轨，我也就不敢出去采风了，这篇「游记」也就搁置了下来…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但好在你来了，旅行者，你能陪我出去采采风吗？有你陪着，谅那家伙也不敢对我做什么。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"6rygdxvdvt3T1713693771714\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e而且俗话讲「防人之心不可无」，有这么一位在后面盯着我，无论他打着什么主意，我多少也得防着点。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e所以，在我裁缝的时候，护卫我的事就拜托你了，旅行者。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我之前其实已经订好了几处采风的地点，我们直接过去就好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e第一个地点是附近的海滩，我们现在就出发吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e平八的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e瞅我干啥？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e一边去，别来耽误我的事！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往附近的海滩\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这片海滩的水质格外清澈，细砂的颜色也很白净，与狂躁的外海截然不同。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e从这里出海…起飞的话，应该还挺有氛围的…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咳，这里的景致很不错，我得记录一下。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者，请稍等片刻，我需要思考一下游记的写法，你们可以在附近走走，欣赏海滩的风光。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e…但是，请别离我太远，那个叫平八的家伙已经跟出来了，就在旁边。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e拉姆齐的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这片海滩的水质格外清澈，细砂的颜色也很白净，与狂躁的外海截然不同。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e从这里出海的话，应该会十分顺利…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e在海滩上四处走走\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e杵在我面前干什么？找茬啊？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你跟着做什么？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e跟着？什么跟着，我在这遛弯！怎么，这片沙滩你家开的？你谁啊，管天管地…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与拉姆齐对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不错！这里的景致果然不错…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e然后是…我看看啊，城北的郊外有一个河湾，那里的小瀑布很有特色，我们就去那里好了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往城北的瀑布\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e击败魔物\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这附近怎么会有魔物？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e拜、拜托你了旅行者，快打倒它们！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与拉姆齐对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e没想到这里居然有魔物活动…虽然这地方景致也还算可以，但实在有些危险…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e但这段遭遇也可以写进「游记」里去，作为一点小小的桥段…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e不过，我们还是先离开这里，去找个安全的地方再说吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那家伙居然还跟着，真是…哼…锲而不舍…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e平八的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这是什么鬼地方，还有魔物，真是…\u003cbr\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你跟着做什么？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我…跟着？我来这里摘果子散步，不可以吗？疑神疑鬼的…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往安全的地点\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e最后一个采风地点是那边的山顶。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那里的视野很好，应该能将周围的风景尽收眼底。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往附近的山顶\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e果然，站在山顶，就能俯瞰大半个鸣神岛了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e山顶的风力相当强，高度适合起飞，还没有障碍物干扰。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e而且距离稻妻城比较远，不会被同心…被闲人打扰。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e的确是个很棒的地方。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e总之，在这里起飞应该很不错…写进「游记」里肯定也非常不错。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这家伙…果然还在跟着，真是没完没了\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我去把他赶走吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e算了，不必和他计较，有你在，他不敢轻举妄动。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e而且对付这种人…加入你真的主动搭理他，他反而会更加纠缠不休。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e总之，这次采风之行就到此为止吧，我们先回木漏茶室去。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e返回木漏茶室\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e游记的主要内容，我已经有思路了，不过携程完整的篇章，还需要一两天时间。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我之前写好了几小段，请你们先把这几段带给小绿吧，\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e等我全部写好了之后，我会托人把完整的「游记」带给她的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e「游记」…哼，嘴上这么说，指不定有什么目的…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你在说什么？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我说，这个家伙写这些「游记」，是另有目的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谁没事会想那些乱七八糟的东西，还用热气球环游提瓦特，而且还不用「神之眼」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e拉姆齐的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e请你们先把这几段「游记」带给小绿吧，等我全部写好了之后，我会托人把完整的「游记」带给她的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e平八：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哼，这家伙准是有什么目的…只不过，现在还没露出马脚而已。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与小绿对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e旅行者哥哥/姐姐，你们拿到了「游记」了吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这是拉姆齐先生给你的…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e《八十天环游提瓦特》…哇啊！谢谢你！我看看…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦，怎么这么薄，之前的几本「游记」都很厚很厚的…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e他还没有写完。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是这样吗…我会等着拉姆齐叔叔写完的，等他写完，我再看完…我就又有故事给宏一讲了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e谢谢你，大哥哥/姐姐，这些东西给你，请你收下吧。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"9i07lyegsuT1713693726210\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e我不知道。但是…对某个人产生恶意，可不需要什么太充分的理由。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：他为什么要这么做？\"},\"cb5kwydt1gsT1713678234663\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔，这不是重点啦！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e最近拉姆齐叔叔不知道怎么了，已经很久没有把他的「游记」寄给我看了，我也没有故事可以讲给宏一听了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我知道拉姆齐叔叔一直呆在木漏茶室里，就想直接去找他。但看门的梢姐姐不许我这种小孩子进去…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e大哥哥/姐姐，你、你看着就很成熟，能帮我去里面问问拉姆齐叔叔，那些「游记」怎么样了吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咳，一般成熟…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e总之！大哥哥/姐姐看着就很可靠啦，这件事就拜托你了！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我会先看看的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e咦？你也想看那些「游记」吗？没问题啦，你看了之后记得带给我就好。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e我…我和你一起过去吧，虽然进不去…但我可以在茶室附近等你…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唉，真想快点看到拉姆齐叔叔写的新「游记」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与梢对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e梢：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这位客人，今日光临「木漏茶室」有何贵干？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于拉姆齐…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e梢：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那位商人啊…他确实在茶室里，不过，最近他似乎看上去有些紧张，不知道遇见了什么事…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e梢：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你要是想找他的话，往里面走一走就能看见他了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与茶室内的拉姆齐对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e你是…旅行者？找我有什么事吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e关于「游记」…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e噢，你是说我写给小绿那孩子的「游记」吧。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e这真是…我最近实在没空写了，估计那孩子肯定等急了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那些「游记」是真的吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哈哈哈，你觉得呢？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与小绿对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e唔…都没什么新故事可以给宏一讲了…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e旅行者：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e什么新故事？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e是一位叫拉姆齐的叔叔，给我说的新故事啦。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那个叔叔说，他去过很多国家，见识过很多新奇的东西，为了记录这些东西，他还专门写了一种叫做「游记」的东西…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e他还给我看过不少「游记」呢！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e比如，枫丹有一种飞在天上，沿着看不见的道路前进的铁马车，从村子一头到另一头，一瞬间就到了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e须弥还有一种可以种在任何地方的草，无论是土里，水里还是沙子里，只要种下了，这种草都能发芽长大。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e还有…还有…枫丹那边还有一种能够在海底呆很久很久的…呃…船！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e搭着那种船，可以去很深的海底做各种事，看各种鱼！\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"frcuaqm1es8T1713678283016\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e哈哈哈，我也希望我写的这些东西能够成真。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：我希望是真的。\"},\"rn55v7zb1wT1713678282693\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e哈哈哈，不愧是四处旅行过的人，一看就明白了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：不太像真的…\"},\"spfv3zzkxt7T1713693725787\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e拉姆齐：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e那就拜托你了。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：交给我吧。\"},\"yd0oy2fo9wlT1713678189505\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e\u003cspan\u003e小绿：\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e至冬？嗯…那他倒是没怎么说过。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：他没和你说过至冬国？\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,