alse,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【先不看了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，下次再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临「白棠珍奇屋」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"k9zbjtc9efT1717775127035\":{\"option\":\"【收藏是你的爱好？】——获得4★黄金飞鸟的落羽*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没错，这也是我寻找设计灵感的一种方式。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我相信「唯有那些被彻底遗忘之物，才是崭新之物」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e时尚就是不断游离于「遗忘」与「复兴」之间。你要是感兴趣，就送你这个体会体会吧。它对我已经无用了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cem\u003e4★\u003c/em\u003e\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500036\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/11/288180982/de6504169f4c39fe375b7d3ae761a0e5_1565047732198982938.png\\\" data-entry-name=\\\"「黄金飞鸟的落羽」\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/500036/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/500036/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/11/288180982/de6504169f4c39fe375b7d3ae761a0e5_1565047732198982938.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「黄金飞鸟的落羽」\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/07/75981509/b26706122e54335e75a99308e473cc62_9126764937418088862.png\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【有什么在售？】——露景泉达到50级前\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很遗憾，最近没遇到什么合我眼缘的收藏，客人请过些时日再来一吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/11/288180982/a0688e82c2c53cce368e3c470e9e64ac_519387936068272812.png\"},\"suui1dkl5T1717775127827\":{\"option\":\"【千织？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…「千织屋」的千织。一位从稻妻来的服装设计师。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她的品味…倒也不错，就是理念上和我有些出入。而且，她还挺挑剔，连对自己的作品都毫不客气…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e上次我提了个她设计中的瑕疵之处，她不但不生气，反倒比我还狠地挑出了更多的刺，听得我都不敢接话…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"w6xa6zb098hT1718036205420\":{\"option\":\"【有什么在售？】——露景泉达到50级后 打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请随意挑选，希望能对上你的眼缘。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/11/288180982/a0688e82c2c53cce368e3c470e9e64ac_236420374702191825.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【你的职业是收藏家？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这倒没有，我的本职是个服装设计师。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你若去询问枫丹哪位裁缝衣服做得好，那多半会提到我的名字。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳…还有「千织」的名字…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"w6xa6zb098hT1718036205420\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"k9zbjtc9efT1717775127035\":[],\"nqb471m7nmnT1710863941173\":[],\"suui1dkl5T1717775127827\":[],\"w6xa6zb098hT1718036205420\":[],\"z2tn3pzsbujT1710863943430\":[\"k9zbjtc9efT1717775127035\",\"suui1dkl5T1717775127827\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1718038132","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"