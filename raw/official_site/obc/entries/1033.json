class=\\\"name\\\"\u003e决斗！召唤之巅！\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6678\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/05/20/83684823/ede553a038111e518d5f25c89227bd8c_5847809874043148086.png\\\" data-entry-name=\\\"决斗！召唤之巅！ 第二回合「骰落！新朋满座」\\\" data-entry-link=\\\"/ys/obc/content/6678/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6678/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e决斗！召唤之巅！ 第二回合「骰落！新朋满座」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0vk2gjj581doT1783672826498\":[],\"16teb57swk4jT1783672411250\":[\"0vk2gjj581doT1783672826498\"],\"2fioo7mekcyT1783668401142\":[\"hfh8d4hhv9gT1783672225709\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"dkh5f8kfa2bT1783668400352\":[\"xfoj3u9z55oT1783668431800\",\"i2lik8z2doT1783668433959\"],\"erzlv537h77T1783672767169\":[\"0vk2gjj581doT1783672826498\"],\"hfh8d4hhv9gT1783672225709\":[\"iwdl25jr81T1783672298130\"],\"i2lik8z2doT1783668433959\":[\"hfh8d4hhv9gT1783672225709\"],\"iwdl25jr81T1783672298130\":[\"16teb57swk4jT1783672411250\",\"erzlv537h77T1783672767169\"],\"nqb471m7nmnT1710863941173\":[\"dkh5f8kfa2bT1783668400352\",\"2fioo7mekcyT1783668401142\"],\"xfoj3u9z55oT1783668431800\":[\"hfh8d4hhv9gT1783672225709\"],\"z2tn3pzsbujT1710863943430\":[\"hfh8d4hhv9gT1783672225709\"]},\"contents\":{\"0vk2gjj581doT1783672826498\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"16teb57swk4jT1783672411250\":{\"option\":\"【你在看什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？哦…我在想怎么设置这个东西呢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这几盏灯，要怎么转才对来着…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"2fioo7mekcyT1783668401142\":{\"option\":\"【你是分会长？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我并不是分会长，只是自愿帮她承担这些琐碎的事…虽然有些吃力不讨好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要问原因…嘿嘿，没错，因为我爱上她了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e她不是那种小鸟依人型的女生，不过她那坚强、干练的气质让我着迷…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也知道分会长的性子，可不是那么轻松就能搞定的。对我来说，这会是一场无比艰难的「赌局」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可追求刺激是赌徒们与生俱来的本能，往往胜算越是微小，就越是期待那丰厚的回报，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哟，来打一把吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e放心，不是打架，是打牌，我对我的牌技可是很自信的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"dkh5f8kfa2bT1783668400352\":{\"option\":\"【牌手？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，这可是我最引以为傲的技能，没有之一。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我最喜欢做的一件事就是和对方打牌，然后让对手下「输了就加入冒险家协会」的赌注。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e迄今为止，因为和我打牌输掉而加入的人可能比自愿加入的人还要多，这可不是吹牛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"erzlv537h77T1783672767169\":{\"option\":\"【关于「玲珑霄灯图」】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…你还想玩吗？再等等吧，我还没把新的灯准备好呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hfh8d4hhv9gT1783672225709\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次海灯节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"i2lik8z2doT1783668433959\":{\"option\":\"【关于获胜的技巧…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么？你对打牌感兴趣？那我就跟你讲讲吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e打牌嘛，七分靠技术，三分靠运气…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽说运气只占三分，但双方技术旗鼓相当的话，决定胜负的便是这三分运气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但有一种情况除外…听说蒙德有个叫班尼特的冒险家，那家伙可是出了名的倒霉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果是这种情况，就算牌技再好也没救了吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"iwdl25jr81T1783672298130\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哟，来打一把吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e放心，不是打架，是打牌，我对我的牌技可是很自信的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e只是个不值一提的小人物罢了，在冒险家协会打打杂，顺便也是璃月最好的牌手。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果有事情要找分会长的话，你找我就可以了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xfoj3u9z55oT1783668431800\":{\"option\":\"【该不会是靠作弊赢的吧？】——获得3★赌徒的胸花*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你这话说的，我可是从来不会作弊的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但正所谓「知己知彼百战百胜」，我确实知道不少作弊的手法，以防对方作弊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…就比如这个赌徒们很喜欢戴的胸花，里面其实有个空间，你可以藏自己的卡片、骰子…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这个就送你吧，反正我是不屑于用这种东西作弊的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-