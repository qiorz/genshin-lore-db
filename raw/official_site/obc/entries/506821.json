se,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1fuxxwm16cfT1764732561249\":[\"qdkcx10x2iqT1761140327571\"],\"4cf2vhylew3T1710863944349\":[\"qdkcx10x2iqT1761140327571\"],\"5frth7zllgsT1759759053542\":[\"qdkcx10x2iqT1761140327571\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"y0lknuadh2jT1767014248769\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"wv60d0yh8gT1759758836127\",\"5frth7zllgsT1759759053542\",\"zbsni75bqekT1761140111499\",\"1fuxxwm16cfT1764732561249\",\"iwiq8qr9ovsT1768527060154\",\"rc0tt3urq8T1775749448311\",\"hycy9zkemrT1770788103690\",\"8zwwr73ova6T1775750355193\",\"lvt7ankkl1T1759759273111\",\"srh9xyvq8zT1759759324558\"],\"8zwwr73ova6T1775750355193\":[\"qdkcx10x2iqT1761140327571\"],\"hycy9zkemrT1770788103690\":[\"qdkcx10x2iqT1761140327571\"],\"iwiq8qr9ovsT1768527060154\":[\"qdkcx10x2iqT1761140327571\"],\"lvt7ankkl1T1759759273111\":[\"qdkcx10x2iqT1761140327571\"],\"nqb471m7nmnT1710863941173\":[\"qdkcx10x2iqT1761140327571\"],\"qdkcx10x2iqT1761140327571\":[],\"rc0tt3urq8T1775749448311\":[\"qdkcx10x2iqT1761140327571\"],\"srh9xyvq8zT1759759324558\":[\"qdkcx10x2iqT1761140327571\"],\"wv60d0yh8gT1759758836127\":[\"qdkcx10x2iqT1761140327571\"],\"y0lknuadh2jT1767014248769\":[\"qdkcx10x2iqT1761140327571\"],\"z2tn3pzsbujT1710863943430\":[\"qdkcx10x2iqT1761140327571\"],\"zbsni75bqekT1761140111499\":[\"qdkcx10x2iqT1761140327571\"]},\"contents\":{\"1fuxxwm16cfT1764732561249\":{\"option\":\"【（或许雅珂达会对糖雕有兴趣…？）】——获得糖雕·雅珂达*1\",\"dialogue\":\"\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e老板，来一份大号的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e雅珂达，你也不是第一次来买了，应该知道我的糖雕尺寸都是固定的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，今天我遇见好事了嘛，快点快点，做得稍微大一点。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好事？委托执行得很顺利么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿嘿，那是，一个简单的护送委托，轻轻松松，全部搞定。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e货物，委托人，全都毫发无损。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不说了不说了，快点给我做个大点的，等会我带回去吃。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，稍等一下喔…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/177adf75e2598214e052a2c938212aa1_228467634724346902.png\\\" data-entry-name=\\\"糖雕·雅珂达\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/177adf75e2598214e052a2c938212aa1_228467634724346902.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·雅珂达\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/03/80663279/ead302bf7db83ccaefbafca7162a8b8c_2468616381175046190.png\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【（或许伊涅芙会对糖雕有兴趣…？）】——获得糖雕-伊涅芙*1\",\"dialogue\":\"\u003cp\u003e【伊涅芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e请问，可以给我做一份糖雕么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，这次还是带给爱诺小姐的么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊涅芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不是。爱诺要我过来，买一份属于自己的漂亮糖雕。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e据她说，这是在训练我进行「社会性活动」，以后也能更方便地进行采购。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样啊~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【伊涅芙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但我并不明白，因为我其实并不用摄入如此多的糖分。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最后，说不定还是会被爱诺偷偷吃掉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e乌娜亚塔小姐，可以请您把糖雕的尺寸做得小一些么？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e爱诺很想吃糖，但我觉得，她还是应该吃得少一些。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e交给我吧，嗯…让我想想…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/250728badfb3d01bb59fb67646c29c62_5478979478306595791.png\\\" data-entry-name=\\\"糖雕·伊涅芙\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/250728badfb3d01bb59fb67646c29c62_5478979478306595791.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·伊涅芙\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/06/178964736/6e0eac7ba87adb0a51fb5dc577c33998_3659413082960948176.png\"},\"5frth7zllgsT1759759053542\":{\"option\":\"【（或许菲林斯会对糖雕有兴趣…？）】——获得糖雕·菲林斯*1\",\"dialogue\":\"\u003cp\u003e【菲林斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e乌娜亚塔小姐。如果可以，请为我做一份糖雕吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞，你是…那位执灯士，菲林斯先生吧，我之前在商店里看见过你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菲林斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是的。我偶尔回来采购物资，您能记住我，是我的荣幸。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e今天恰好路过此处，看见了您高超的糖雕技艺。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e思虑再三后，我还是想要请您为我做一份糖雕。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，别这么客气，我都要不好意思了~\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e稍等一下，我这就给你做糖雕。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唔…一位执灯士，糖雕应该特别一些吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/c288289ee0e0f3f4cd538f7c4e3542ce_8077920446828667902.png\\\" data-entry-name=\\\"糖雕·菲林斯\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/c288289ee0e0f3f4cd538f7c4e3542ce_8077920446828667902.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·菲林斯\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/06/178964736/d64d65f6c179b8f037d36281edf2efc8_8928737307117511488.png\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e新鲜的蜂蜜~好看又好吃的糖雕~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8zwwr73ova6T1775750355193\":{\"option\":\"【来一份糖雕】——当日已经领取过任意糖雕后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e每人每天限购一份哦，客人明天再来吧~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hntoidwip9aT1770788063100\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"hycy9zkemrT1770788103690\":{\"option\":\"【（或许叶洛亚会对糖雕有兴趣…？）】——获得糖雕·叶洛亚*1\",\"dialogue\":\"\u003cp\u003e【叶洛亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e来都来了…您好，也请给我拿一份糖雕吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e噢！请您做小一些，我担心会临时有事，没办法一下子吃完…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题！放心吧，就算是小型糖雕，味道也一样好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，执灯士的任务还真是繁忙啊…就连糖雕都有可能吃不完…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶洛亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈…也不完全是因为任务，有时候也是因为遇见了需要帮忙的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您也知道，吃了一半的糖雕很难保存，我最多拿布包一包，再放在口袋里…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是等我忙完了事，把布拿出来的时候，里面的糖雕都已经完全化掉了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样啊…我想想喔，小型的糖雕…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有了，我可以在小型的糖雕里做出很多口味！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e把这个口味的垫在下方…把这个口味的放在上面…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好了，瞧瞧这份「多口味复合小型糖雕」，符合您的要求吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶洛亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e很符合！谢谢你，乌娜亚塔小姐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没事。虽然我没办法替你们执灯士分担任务…但是，如果你想吃糖雕的话，要多少就有多少！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【叶洛亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这是我们分内的事，您太客气了，乌娜亚塔小姐…那我先告辞了，还有任务要处理呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞，慢走，下次想吃糖雕的话，直接过来就好啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/34b722c3b9a2e4961ef8b3377cc1d5a9_5304951935614814754.jpg\\\" data-entry-name=\\\"糖雕·叶洛亚\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/34b722c3b9a2e4961ef8b3377cc1d5a9_5304951935614814754.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·叶洛亚\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/02/11/80663279/d64d65f6c179b8f037d36281edf2efc8_7464230692107525036.png\"},\"iwiq8qr9ovsT1768527060154\":{\"option\":\"【（或许哥伦比娅会对糖雕有兴趣…？）】——获得糖雕·哥伦比娅*1\",\"dialogue\":\"\u003cp\u003e【哥伦比娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e糖雕…之前好像吃过，可以给我做一份么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题！请稍等喔~\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（咦？这个女孩，我之前是不是在镇上见过…）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【哥伦比娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e（呜哇！她这种满是期待的感觉，我我我我做个什么好呢…）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（用直觉…跟着直觉走…）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个…我做好了，看看你喜欢吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【哥伦比娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e很好看，谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，你喜欢就好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（没错，我的直觉告诉我，这种轻飘飘的造型，就适合这种轻飘飘的孩子！)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【哥伦比娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔，也很好吃…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可以再帮我做两份吗？我想带回去，给月灵们也尝尝。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e给…给月灵们也尝尝？可以倒是可以，但我的食材不太够…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【哥伦比娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，那我明天再来。带着月灵一起来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，您慢走…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/74cd525bb3b8806abbf8e9f3890a4c0b_8912001411812920876.png\\\" data-entry-name=\\\"糖雕·哥伦比娅\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/74cd525bb3b8806abbf8e9f3890a4c0b_8912001411812920876.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·哥伦比娅\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/01/16/80663279/612d4fd45992985939a5cac11512e204_8539651407719918814.png\"},\"lvt7ankkl1T1759759273111\":{\"option\":\"【关于糖雕…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一开始我说要做糖雕的时候，爷爷还训斥了我，让我不要拿食物玩，说浪费食物是要遭报应的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e爷爷就是个老古板，我这分明是为了让更多人知道咱们家的蜂蜜就是好嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就算是一样的东西，肯定也是卖相更好的那个更受欢迎，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【来一份糖雕。】——随机获得糖雕*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e给~打开之后要尽快吃掉喔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【随机获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/68daab5d340cce26b92f58b101c6d856_3464531058854975031.png\\\" data-entry-name=\\\"糖雕\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/68daab5d340cce26b92f58b101c6d856_3464531058854975031.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（角色特殊糖雕及糖雕·月灵除外）】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/06/178964736/b26706122e54335e75a99308e473cc62_5764465026820213961.png\"},\"qdkcx10x2iqT1761140327571\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"rc0tt3urq8T1775749448311\":{\"option\":\"【（或许莉奈娅会对糖雕有兴趣…？）】——获得糖雕·莉奈娅*1\",\"dialogue\":\"\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e莉奈娅小姐，又来给露米买糖雕了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莉奈娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呀，露米可喜欢你做的糖雕啦，每次都不舍得吃，只是舔舔就让我收好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，毕竟是糖雕嘛…舔多了也就化了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以，拜托乌娜亚塔小姐，再帮露米做一份糖雕吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题！稍等一下喔…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（哎呀，露米太可爱了！好想摸一摸！但随便摸的话，算了算了，这样太失礼了…）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e做好了，请拿好，莉奈娅小姐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莉奈娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你！露米，糖雕好了，现在要吃么…咦，已经睡着了，那我等一会再把糖雕给它吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/53a813c6dc017358b8a52c89eb360858_4102418390339732320.png\\\" data-entry-name=\\\"糖雕·莉奈娅\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/53a813c6dc017358b8a52c89eb360858_4102418390339732320.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·莉奈娅\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/4966a51b537ea9907745afe9151ac2b9_4965824905842059962.png\"},\"srh9xyvq8zT1759759324558\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"wv60d0yh8gT1759758836127\":{\"option\":\"【（或许菈乌玛会对糖雕有兴趣…？）】——获得糖雕·菈乌玛*1\",\"dialogue\":\"\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e乌娜亚塔小姐，请为我做几份糖雕吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，菈乌玛小姐。上次你带回去的糖雕，孩子都喜欢么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，他们很喜欢，有的孩子拿着糖雕不舍得吃，一直到糖雕快融化了，才慢慢品尝。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样啊…嗯，下次我带上工具，直接到你那边去，给孩子们现场做。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样就太好了~孩子们一定会很高兴的~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e噢，聊远了…我稍后就去做糖雕。等做完了，就托人直接送到你们那边去。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但在那之前…嘿嘿，我刚巧有一个灵感~\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e稍等一下喔，菈乌玛小姐，我这就给你做一份特别的糖雕。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/6a926ca3ccc43c9669629ea9d6216b37_8086166989064786021.png\\\" data-entry-name=\\\"糖雕·菈乌玛\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/6a926ca3ccc43c9669629ea9d6216b37_8086166989064786021.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·菈乌玛\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/06/178964736/612d4fd45992985939a5cac11512e204_3848376180317959548.png\"},\"y0lknuadh2jT1767014248769\":{\"option\":\"【（领取祈月之夜的糖雕）】——完成魔神任务空月之歌第六幕「散于晨雾的月芒」后、获得糖雕·月灵*1\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这份糖雕您拿好，祈月之夜快乐！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/f9864a43ae2258bd6ecfd122577dad1d_2142637340200149510.png\\\" data-entry-name=\\\"糖雕·月灵\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/f9864a43ae2258bd6ecfd122577dad1d_2142637340200149510.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·月灵\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/29/80663279/b26706122e54335e75a99308e473cc62_8052012055300329914.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【（或许爱诺会对糖雕有兴趣…？）】——获得糖雕·爱诺*1\",\"dialogue\":\"\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e老板！我要一份糖雕！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e爱诺小姐~好久不见~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，今天来镇上帮人修东西，正好来你这边买糖吃。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e快快，趁着伊涅芙不在，帮我多做几块…或者做的甜一些也行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e倒是没问题…但您吃完之后，可记得要刷牙啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱诺】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e知道的知道的，我每次吃糖之后都刷牙，牙齿好着呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈…那您稍等一下…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/68daab5d340cce26b92f58b101c6d856_3464531058854975031.png\\\" data-entry-name=\\\"糖雕·爱诺\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/01/75610764/68daab5d340cce26b92f58b101c6d856_3464531058854975031.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·爱诺\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/06/178964736/d14d59d4aa24fe90d719dafc11f4d7b8_4884065049351275551.png\"},\"zbsni75bqekT1761140111499\":{\"option\":\"【（或许奈芙尔会对糖雕有兴趣…？）】——获得糖雕·奈芙尔*1\",\"dialogue\":\"\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e给我来一份糖雕吧，乌娜亚塔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e奈芙尔老板，你怎么有空过来买糖雕了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e偶尔出来散散步，对我的身体和精神都有好处。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e吃点甜的，也有助于我进行思考。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好嘞~稍等一下，我这就给您做一份。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e行。对了，这些钱给你，下次雅珂达来的时候…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【乌娜亚塔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e给她做得大一些？还是甜一些？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奈芙尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e把这些钱给她。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就说：「奈芙尔出双倍的钱，请你在偷懒完毕后，帮她也带一份糖雕回去。」\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506363\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/5cfc236aa27fd0ec610256ba85d969a5_4364826474541776738.png\\\" data-entry-name=\\\"糖雕·奈芙尔\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/506363/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/09/288180982/5cfc236aa27fd0ec610256ba85d969a5_4364826474541776738.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e糖雕·奈芙尔\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/22/80663279/54cebfac162c965c4d188878857dc7fd_7732670498774362178.png\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can