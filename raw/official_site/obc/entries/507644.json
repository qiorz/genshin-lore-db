#34;\u0026gt;物理伤害：\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;物理伤害不会附着元素，也不会发生元素反应。\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e。\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}},{\"tab_name\":\"极恶技·闪\",\"skill_type\":\"元素战技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/24/288180982/404a493d3b7964a708c6cd5eab69343c_7826501761266708897.png\",\"life\":2,\"life_bg\":1,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e获得2点\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e蛇之狡谋\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，生成手牌\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e诸武相授\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;诸武相授：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;事件牌\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;费用：0\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;我方\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;丝柯克\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;附属\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;七相一闪\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;，并且下次造成的伤害+1。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;回合开始或我方执行切换后：舍弃\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;此牌，获得1点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;蛇之狡谋\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。（每回合1次）\u003c/span\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}},{\"tab_name\":\"极恶技·灭\",\"skill_type\":\"元素爆发\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/24/288180982/e886b8ebfa2d73c7dbfc49fa09841135_3678711609038599260.png\",\"life\":3,\"life_bg\":1,\"energy\":2,\"energy_bg\":8,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e消耗所有\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e蛇之狡谋\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，造成等同于消耗\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e蛇之狡谋\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e数量的\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(145, 213, 255)\\\"\u003e\u003cu\u003e冰元素伤害\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;冰元素伤害：\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;附着冰元素，可发生元素反应:\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;\u0026lt;strong\u0026gt;融化\u0026lt;/strong\u0026gt;：本伤害+2\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;\u0026lt;strong\u0026gt;超导：\u0026lt;/strong\u0026gt;本伤害+1，对目标以外的所有敌方角色造成1点穿透伤害\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap;\u0026#34;\u0026gt;\u0026lt;strong\u0026gt;冻结\u0026lt;/strong\u0026gt;：本伤害+1，使目标本回合无法行动（受到物理或火元素伤害后提前解除，但是伤害+2）\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026#34;white-space: pre-wrap; min-height: 1.5em;\u0026#34;\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，对后台角色造成2点\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e穿透伤害\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;穿透伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;穿透伤害无法受到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，如果消耗了7点\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e蛇之狡谋\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，则改为对后台角色造成3点\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e穿透伤害\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;穿透伤害：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;穿透伤害无法受到伤害加成，但是也无法被护盾、伤害免疫等效果抵消。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。\u003c/span\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}},{\"tab_name\":\"理外之理\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/24/288180982/a2b8fba62b565fe8974be882752896d1_2374940261433586247.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e【被动】丝柯克无法获得充能，改为可以积累\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e蛇之狡谋\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e，最多7点。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e我方触发冻结/冰扩散/超导/冰结晶反应后：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e生成手牌\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e虚境裂隙\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;虚境裂隙：\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;事件牌\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;费用：0\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;舍弃\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;1张原本元素骰费用为3的手牌，我方\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;丝柯克\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;获得2点\u0026lt;/span\u0026gt;\u0026lt;strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;蛇之狡谋\u0026lt;/span\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span style=\u0026#34;color: rgb(0, 0, 0)\u0026#34;\u0026gt;。\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。（每回合3次）\u003c/span\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"]}}]}\n","style":""}],"id":"132","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"召唤物","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"list\":[{\"tab_name\":\"默认标题\",\"skill_type\":\"\",\"icon\":\"\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]}}]}\n","style":""}],"id":"133","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","wi