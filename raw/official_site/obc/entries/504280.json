me":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"rv0351af82rT1736690685987\"],\"nqb471m7nmnT1710863941173\":[],\"rv0351af82rT1736690685987\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好哦，我叫奥罗卢柯，是纳塔钓鱼协会的员工。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果想买纳塔特色的渔具，鱼饵，委托我跑腿就好了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是觉得这里有点偏远，可以在「奥特华的渔网」留言，我是店主的朋友，也经常去那边买东西！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，谈到钓鱼技术，我就只是普普通通的水平啦，我会不断练习，努力变强的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好呀，你也是来和可爱的鱼鱼们互动的吗？需不需要我和钓鱼协会的帮助？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【需要钓鱼用品…】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯哼，我这里的货品不多，但质量还行，请随意挑选~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/01/12/288180982/1b764ab0418774d3f6ebf1bf4b1bd200_3441800273405114960.png\"},\"rv0351af82rT1736690685987\":{\"option\":\"【回见了！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，我有种感觉，你是个钓鱼高手…那就下次再见了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【可爱？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对呀，在河里湖里海里悠悠哉哉地来回游动，尾巴摆呀摆…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯，我自己是觉得挺可爱的啦，你如果没什么感觉，那也没关系！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我为了看到、钓到和养到更多可爱的鱼，才加入了钓鱼协会。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，也有人只是为了鲜美的鱼肉，或者把鱼卖掉赚钱来钓鱼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我理解他们，不干涉他们。大部分钓鱼协会的朋友也很尊重我。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，我也希望更多人能认识到鱼鱼的可爱~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1736734794","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id"