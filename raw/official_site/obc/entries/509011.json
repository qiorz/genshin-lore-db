upload/2026/07/02/50494840/135aaf64dc41fef8d45468f43c06fe23_7389756409992014474.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/135aaf64dc41fef8d45468f43c06fe23_7389756409992014474.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e打开背包，在小道具页面装备「桑多涅的便携式茶桌」，点击道具下方的\u003cspan style=\\\"color: rgb(250, 219, 20)\\\"\u003e「茶会笔记」\u003c/span\u003e按钮，能够开启茶会。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e注意：\u003cspan style=\\\"color: rgb(250, 219, 20)\\\"\u003e推荐完成\u003c/span\u003e魔神任务——空月之歌·第十幕「道成千壑，因果异灭」，及「映夏！归乡？千灵节！」后开启茶会剧情，以获得最佳体验。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/3700e6f4be53f3ac850658cad094f8c8_3283480775206027217.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/3700e6f4be53f3ac850658cad094f8c8_3283480775206027217.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e在「茶会笔记」页面，能够选择想要邀请的角色参加茶会，并发出邀请。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/3266ee142e69237139f93537bb95bb28_7515880644377855509.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/3266ee142e69237139f93537bb95bb28_7515880644377855509.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e向角色发出邀请后，根据提示前往适当的位置。放置小道具「桑多涅的便携式茶桌」，并使用桑多涅落座后，开启茶会。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/516d05d35bd2443e5a576c889345d6fd_5895747341222726921.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/02/50494840/516d05d35bd2443e5a576c889345d6fd_5895747341222726921.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e在任务所指引的黄圈范围内寻找符合任务描述的地点，放置茶桌并使用桑多涅落座，方能开启茶会。已完成的茶会内容，能够在「茶会笔记」中进行回顾。\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8979","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关道具及奖励","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"\"],\"row\":[[\"\u003cul\u003e\u003cli\u003e\u003cp\u003e道具：\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508948\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/105506159/9b2aeec8a5854a79302467f1be129533_580522415402122814.png\\\" data-entry-name=\\\"桑多涅的便携式茶桌\\\" data-entry-link=\\\"/ys/obc/content/508948/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508948/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/01/105506159/9b2aeec8a5854a79302467f1be129533_580522415402122814.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e桑多涅的便携式茶桌\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（桑多涅加入队伍中完成任务后获得）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e奖励：\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509147\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/28/50494840/04ce22ae01800d128a53c7ee8dbb8f25_4511935358610402000.png\\\" data-entry-name=\\\"「暇间茶叙」\\\" data-entry-link=\\\"/ys/obc/content/509147/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509147/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/28/50494840/04ce22ae01800d128a53c7ee8dbb8f25_4511935358610402000.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「暇间茶叙」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（完成所有的茶会邀请获得）；\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8980","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"茶会笔记","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"哥伦比娅\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：白鸽的栖处\u003c/p\u003e\u003cp\u003e简介：没想到哥伦比娅竟然喜欢月亮棋这类游戏。既然这样，下次就带些好玩的数理游戏去找她吧。哈哈，看我不让她输个灰头土脸。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509206\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"白鸽的栖处\\\" data-entry-link=\\\"/ys/obc/content/509206/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509206/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e白鸽的栖处\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"],[\"\u003cp\u003e名称：花园小聚\u003c/p\u003e\u003cp\u003e简介哥伦比娅似乎对隐居处的花园挺中意。哼哼，那也是自然，我打理花园的手艺可是一流的。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509455\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"花园小聚\\\" data-entry-link=\\\"/ys/obc/content/509455/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509455/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e花园小聚\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"「仆人」\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：火与冰\u003c/p\u003e\u003cp\u003e简介：奥黛塔和罗莎琳吗…唔，真令人怀念。到至冬后，我也尽量多关照关照奥黛塔吧。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509212\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"火与冰\\\" data-entry-link=\\\"/ys/obc/content/509212/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509212/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e火与冰\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"阿贝多\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：雪山小叙\u003c/p\u003e\u003cp\u003e简介：没想到阿贝多也怪辛苦的…在研究之余还要照顾一位初入社会的家人，总觉得类似的事我也体会过…\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509200\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"雪山小叙\\\" data-entry-link=\\\"/ys/obc/content/509200/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509200/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e雪山小叙\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"「公子」\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：—如往日\u003c/p\u003e\u003cp\u003e简介：我就知道…这家伙满脑子都和以前一样，就想着打架…\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509210\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"一如往日\\\" data-entry-link=\\\"/ys/obc/content/509210/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509210/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e一如往日\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"娜维娅\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：故事乃最好的茶点\u003c/p\u003e\u003cp\u003e简介：桌上剧团还挺有趣的…啧，可是哥伦比娅那家伙…就连在故事里都经常搞些让人摸不着头脑的行动…\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"510024\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"故事乃最好的茶点\\\" data-entry-link=\\\"/ys/obc/content/510024/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/510024/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e故事乃最好的茶点\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"茜特菈莉\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：小小的心意\u003c/p\u003e\u003cp\u003e简介：她收到礼物的样子应该是…挺开心的？但又好像有些…不甘心？闹别扭？啊，真搞不懂上了年纪的人。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509452\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"小小的心意\\\" data-entry-link=\\\"/ys/obc/content/509452/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509452/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e小小的心意\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"奈芙尔\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：猫咪与齿轮\u003c/p\u003e\u003cp\u003e简介：啊啊啊阿舍鲁真可爱！毛茸茸的又暖和！肉垫也好好摸！肚子也好好摸！下次多带些零食给它！\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"510017\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"猫咪与齿轮\\\" data-entry-link=\\\"/ys/obc/content/510017/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/510017/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e猫咪与齿轮\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"菈乌玛\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：小小的尝试\u003c/p\u003e\u003cp\u003e简介：呼…不枉我练习了那么久霜月之子泡茶的方法。尊重与理解，嗯，是个好的开端。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"510021\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"小小的尝试\\\" data-entry-link=\\\"/ys/obc/content/510021/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/510021/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e小小的尝试\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"芙宁娜\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：为了枫丹！\u003c/p\u003e\u003cp\u003e简介：和芙宁娜聊了些以前的话题，还挺投缘。以后可以多去找她玩玩。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509208\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"为了枫丹！\\\" data-entry-link=\\\"/ys/obc/content/509208/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509208/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e为了枫丹！\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"林尼\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：壁炉畔的絮语\u003c/p\u003e\u003cp\u003e简介：真羡慕他们的感情啊，三人一定不管遇到什么困难都会相互扶持着度过吧。希望他们前路顺遂。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509924\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"壁炉畔的絮语\\\" data-entry-link=\\\"/ys/obc/content/509924/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509924/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e壁炉畔的絮语\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"那维莱特\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：过去的故事\u003c/p\u003e\u003cp\u003e简介：从那维莱特口中听到了阿兰曾经的故事。感觉更了解了阿兰一些。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509895\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"过去的故事\\\" data-entry-link=\\\"/ys/obc/content/509895/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509895/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e过去的故事\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"阿帽\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：「人偶」的相会\u003c/p\u003e\u003cp\u003e简介：同为「人偶」，我们却有不同的路要走。各自加油吧。\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509201\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"「人偶」的相会\\\" data-entry-link=\\\"/ys/obc/content/509201/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509201/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「人偶」的相会\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"玛丽安\u0026安\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：安与玛丽安与小玛丽安\u003c/p\u003e\u003cp\u003e简介：哈哈，知道了很多阿兰小时候的事。玛丽安，能感觉到她是一位乐观而有趣的女孩。要是阿兰能看到这些就好了…\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509453\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"安与玛丽安与小玛丽安\\\" data-entry-link=\\\"/ys/obc/content/509453/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/509453/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e安与玛丽安与小玛丽安\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e  \u003c/p\u003e\"]]},{\"tab_name\":\"西摩尔\u0026玛梅赫\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：茶叶还是泡泡桔？\u003c/p\u003e\u003cp\u003e简介：西摩尔与玛梅赫。嗯，真是个有趣的组合。另外…我再次对阿兰的天赋叹为观止。你告诉我这是他二十岁前造出的机械？\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509870\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"茶叶还是泡泡桔？\\\" data-entry-link=\\\"/ys/obc/content/509870/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509870/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e茶叶还是泡泡桔？\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]},{\"tab_name\":\"玛梅赫\u0026西摩尔\u0026安\u0026玛丽安\",\"header\":[\"\"],\"row\":[[\"\u003cp\u003e名称：水仙的圆舞曲\u003c/p\u003e\u003cp\u003e简介：有这么个「家庭」似乎也不错。谁能想到我突然就变成了家里的[妹妹」呢？但我绝对不会叫西摩尔「大哥」的·\u003c/p\u003e\u003cp\u003e任务详细：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509875\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/04/83684823/41a53cbf3d3742b30dd4261689b9e6fc_4548423598487944964.png\\\" data-entry-name=\\\"水仙的圆舞曲\\\" data-entry-link=\\\"/ys/obc/content/509875/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/509875/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e水仙的圆舞曲\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]]}]}\n","style":""}],"id":"8981","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"x3tbh3eu5mT1782928539764\",\"child_ids\":{\"x3tbh3eu5mT1782928539764\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"9597","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1790577799","langs":[],"template_layout":{"tab":[{"tab_id":"524","tab_name":"活动介绍","module_group":[{"module_group_id":"2716","layout":"l2r1","module":[{"id":"8981","pos":"b