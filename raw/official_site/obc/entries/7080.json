erial-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e他们的童年·游城记\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"5iot5969j7cT1783065877716\"],\"5iot5969j7cT1783065877716\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"plv7jujj8krT1783065982619\"],\"nqb471m7nmnT1710863941173\":[],\"plv7jujj8krT1783065982619\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【推荐菜…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e亲爱的，你可问对人了。这世界上最好吃的东西非炸鱼薯条莫属！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e早餐来点炸鱼薯条，提供一上午所需的能量；下午点心来点炸鱼薯条，每个孩子都会喜欢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e逛街散步也能来点炸鱼薯条，酥松香脆，特巡队队长和海鸥都喜欢得不得了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我都想象不出离了炸鱼薯条的枫丹会变成什么样子！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"5iot5969j7cT1783065877716\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/03/288180982/b26706122e54335e75a99308e473cc62_8428012403153725604.png\",\"option\":\"【真有那么好吃？】———获得美味的炸鱼薯条*3\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿，亲爱的，这份炸鱼薯条我给你包好，你尝尝就知道了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7070\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/7ef2ff5ef78022d84188ecbde98b029a_3250688989966816751.png\\\" data-entry-name=\\\"美味的炸鱼薯条\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/7070/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/7070/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/7ef2ff5ef78022d84188ecbde98b029a_3250688989966816751.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的炸鱼薯条\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e世上最美味的东西！亲爱的，要来一份吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/03/288180982/11ee64c710e3b091256c0d349ac55461_1725962990307437385.png\",\"option\":\"【有菜单吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这边，亲爱的，请慢慢看，想吃什么就和我说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"plv7jujj8krT1783065982619\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e想吃炸鱼薯条了就来找我，亲爱的，我们下次见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【你是…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是街头美食的代言，亲爱的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果我像大人物那样拥有称号，我想管自己叫做…「卖炸鱼薯条的路易」。简单好记，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wl