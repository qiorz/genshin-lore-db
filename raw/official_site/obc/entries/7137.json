l\u003e\u003cp\u003e【奥菲利亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，有道理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【桑塔利耶】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e毕竟这附近是最安全的街区，决斗代理人的办公处就在边上。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥菲利亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e的确是这样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【桑塔利耶】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谁知他们说——「 只有你才能担当起这一片地区的巡逻重任」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥菲利亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，竟然这样说···\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【桑塔利耶】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个···我听大家都说，你是很厉害的冒险家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e都被人们赋予了期望，我们是不是很相似？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e作为命运相仿的两个人，要不我们下班后去喝一杯？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥菲利亚】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不，冒险家从不下班。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\