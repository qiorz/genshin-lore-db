"data":"{\"list\":[],\"author\":\"\",\"created_at\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"28jnkltec3yT1759888084563\":[\"7906ep2wjbsT1759888209790\"],\"4cf2vhylew3T1710863944349\":[\"z2882lqzvsT1759888062059\"],\"7906ep2wjbsT1759888209790\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[\"z2882lqzvsT1759888062059\"],\"z2882lqzvsT1759888062059\":[\"28jnkltec3yT1759888084563\"],\"z2tn3pzsbujT1710863943430\":[\"z2882lqzvsT1759888062059\"]},\"contents\":{\"28jnkltec3yT1759888084563\":{\"dialogue\":\"\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e请为我拿一支金属花吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【丽切娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e您是…那位「咏月使」大人？您也喜欢我做的金属花么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是我一位朋友，对这样的花很感兴趣。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e菈乌玛向丽切娅诉说了事情的来龙去脉…\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【丽切娅】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，原来是这样啊。没想到，我做的金属花居然能被小鸟认可。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e喏，这一束花给您，不收钱了。就当是我送给那只小鸟的吧。这束花的尺寸很小，它一定能带得动。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菈乌玛】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我替那孩子感谢您的慷慨，那么，我就收下了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/08/80663279/612d4fd45992985939a5cac11512e204_7502981676244211296.png\",\"option\":\"【开场白】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好哦，再见！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"7906ep2wjbsT1759888209790\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临「春景花房」！请您看看这些芬芳的花朵，送人或者装饰都再合适不过啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸，是说那种需要泥土和水的吗？有喔，但那种花太麻烦了，也不能像这些一样随便摸摸。不过既然您喜欢的话…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/08/80663279/11ee64c710e3b091256c0d349ac55461_3936211011808229571.png\",\"option\":\"【有普通的花吗？】——打开商店\"},\"z2882lqzvsT1759888062059\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【队伍中包含菈乌玛并与团雀对话后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，当然特别啦。这些可是用最棒的白铁合金打造的花，在别处可买不到呢！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且养护也超级简单，不用浇水，只要偶尔滴几滴机油保持润滑和光亮就好啦。是不是很省心？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这些花…看起来很特别？】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1759905913","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\