\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e神社大扫除\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2830\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/28/76953456/79b77eeb63503f854da4815f8e46ee89_5450180184368421496.png\\\" data-entry-name=\\\"鱼之味\\\" data-entry-link=\\\"/ys/obc/content/2830/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/2830/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e鱼之味\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2829\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/07/28/76953456/79b77eeb63503f854da4815f8e46ee89_5450180184368421496.png\\\" data-entry-name=\\\"猫之迹\\\" data-entry-link=\\\"/ys/obc/content/2829/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/2829/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e猫之迹\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，喵喵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e神社看起来比以前好多了，奴家的毛毛也变柔顺了，喵喵。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多亏了你们帮忙，神社现在已经很有样子了，阿响回来以后，一定会很高兴。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，倒是有件事，奴家觉得很奇怪…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e奴家之前出去逛了逛，周围的村子里都没有人了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e喵喵…真奇怪，那些人类都去哪里了呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于神社...】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e奴家能看出来，那些人类都是好人。他们给「塞钱箱」塞了好多好多钱。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个绿色的人类一直皱着眉毛，念叨个不停，好像是一直在担心着自己让…什么什么协会失望…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个绿色的、又比较高的人类嘛…唔唔，是个可怕的人类。对猫的弱点，可是了如指掌哪，喵喵...\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那个会叮叮当当的人类，虽然很在意工钱…但他对奴家似乎很虔诚，而且他好像还在用木头做猫呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e都是很好的人哪。等阿响回来，她一定能和他们变成朋友的。喵喵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于神社里的人...】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin