T1758180614926\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"alf3wryoramT1758180696389\":[],\"dk1qi76bcmoT1758180540185\":[\"wd08td7jwrkT1758180552669\"],\"frydwr16lvT1758180566013\":[\"qiuj9ta39jT1758180614926\"],\"l8u081kj8rT1758180653429\":[\"alf3wryoramT1758180696389\"],\"nqb471m7nmnT1710863941173\":[\"dk1qi76bcmoT1758180540185\"],\"om47a2nzocaT1758180656289\":[\"alf3wryoramT1758180696389\"],\"p9xmyji1o0oT1758180655182\":[\"alf3wryoramT1758180696389\"],\"qiuj9ta39jT1758180614926\":[\"7926yl75gmxT1758180632269\"],\"ra888msdogT1758180654173\":[\"alf3wryoramT1758180696389\"],\"wd08td7jwrkT1758180552669\":[\"frydwr16lvT1758180566013\",\"66m49oec0j8T1758180566773\",\"8ee2nm5oymT1758180592508\",\"wz41d83dqidT1758180593413\"],\"wz41d83dqidT1758180593413\":[\"qiuj9ta39jT1758180614926\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"66m49oec0j8T1758180566773\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e过去许多的故事，都是在那菈法留纳到达桓那兰那后，才开始被讲述的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e新的那菈朋友和那菈法留纳一样都是金灿灿的，一定也能够带来许多新故事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于过去的故事…】\"},\"7926yl75gmxT1758180632269\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那菈旅行者带来了许多新故事，兰随尼的故事讲完了，新故事都没有结束。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8ee2nm5oymT1758180592508\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e兰随尼的「杖」，是听过许多故事的宝杖。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e杖的纹路就像是树的年轮一样不断增长。听过越多的故事，就会越强壮。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总有一天，能够长成充满了故事的大树。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果那菈朋友是兰那罗的话，一定能够明白。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于手中的杖…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【初入桓那兰那】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"alf3wryoramT1758180696389\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"dk1qi76bcmoT1758180540185\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」举办之前】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"frydwr16lvT1758180566013\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那菈朋友带来什么样的故事呢？能不能让古老的树惊落叶片上的露珠？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/288180982/11ee64c710e3b091256c0d349ac55461_8449566531910318409.png\",\"option\":\"【讲述与兰那罗的冒险。】——打开商店界面\"},\"l8u081kj8rT1758180653429\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来这就是兰罗摩的故事…新的觉王树的故事…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/18/288180982/11ee64c710e3b091256c0d349ac55461_1060274417342852721.png\",\"option\":\"【讲述与兰那罗的冒险。】——打开商店界面\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e杖跟树一样，性格大不相同，嗯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"om47a2nzocaT1758180656289\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。兰随尼明白，你是充满了故事的那菈。如果有好的故事，我们就分享吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"p9xmyji1o0oT1758180655182\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e兰随尼的「杖」，是听过许多故事的宝杖。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e杖的纹路就像是树的年轮一样不断增长。听过越多的故事，就会越强壮。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总有一天，能够长成充满了故事的大树。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果那菈朋友是兰那罗的话，一定能够明白。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于手中的杖…】\"},\"qiuj9ta39jT1758180614926\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」结束之后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ra888msdogT1758180654173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那菈旅行者与兰罗摩的新故事像是惟耶之实那样饱满。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不管太阳再升起多少次，你们的故事不会被遗忘，桓那会永远记住你们。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于新故事…】\"},\"wd08td7jwrkT1758180552669\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那菈朋友，想要听兰那罗的故事吗？兰随尼知道许多，但是要用新故事交换。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"wz41d83dqidT1758180593413\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。兰随尼明白，你是充满了故事的那菈。如果有好的故事，我们就分享吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758183280","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","p