ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"20000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这种储能炉其实可以再加装一层炉芯，比商家宣传的更耐用。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还有这种风扇，它的电机一直在以临界转速工作，这样不够安全…\u003c/p\u003e\u003c/li\u003e\u003cl