class=\\\"name\\\"\u003e空月之歌 第二幕「尘与灯的挽歌」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"2ne4sdjbktoT1757599766846\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没事，欢迎你常来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【随便逛逛就走。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…自从愚人众在帕哈岛建起那座试验设计局之后，周遭的气氛也变了不少呢。明面上说是对付狂猎，谁知道呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有人看不惯愚人众在这儿飞扬跋扈的样子，也有人对他们带来的新技术垂涎欲滴。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过霜月之子对他们的态度倒是一以贯之…想到愚人众对神像的所作所为，不难想象。依我看，迟早会有更大的冲突。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么新鲜事儿吗？】——完成空月之歌 第二幕「尘与灯的挽歌」前\"},\"7g4n4gll72iT1759884623398\":{\"dialogue\":\"\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/08/80663279/d64d65f6c179b8f037d36281edf2efc8_5018015331700749657.png\",\"option\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，请随便坐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"br7a9i011neT1759884993127\":{\"dialogue\":\"\u003cp\u003e【德米安】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e菲林斯先生，欢迎光临，您上次订购的酒已经到了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菲林斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢您，德米安先生。要是没了您，我简直难以想象如何才能喝到美酒了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德米安】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…您真谦虚，在品酒这一行里，您是比我更有品味的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e上次您推荐的那几种酒，可是在店里大受好评，一转眼就卖空了，让我小赚了一笔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菲林斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是提供了一些小小的建议。我想，更重要的是您售酒时的高尚职业品德。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德米安】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不掺水和劣酒？是的，这可是让我少赚了不少钱。但同时，也让这座酒馆能继续开下去。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好了，先生，随我来，您的酒我特意放在酒窖里。我向您保证，它们绝对没有丧失一丝风味。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【菲林斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我很期待。噢，您能拿两个杯子么？我想，咱们可以先小品两口。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【德米安】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没问题，先生。两个杯子，一瓶酒，一段美好的时光。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/08/80663279/d64d65f6c179b8f037d36281edf2efc8_34223717009427452.png\",\"option\":\"【开场白】\"},\"cgfzz9rom5oT1757599975058\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，多谢夸奖。老板大概也是看中了我这一点才把我安排到这里的吧，可以说是我的天职了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506273\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/09/183046623/4748cf2348025afe5ba2bfabb6e65813_13064722583348001.png\\\" data-entry-name=\\\"「乐园」的指引\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/506273/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/506273/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/09/183046623/4748cf2348025afe5ba2bfabb6e65813_13064722583348001.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「乐园」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/11/288180982/b26706122e54335e75a99308e473cc62_3621553021011994843.png\",\"option\":\"【看来你的心态不错。】——获得「乐园」的指引*1\"},\"fjtsoeo5inuT1759885083857\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请看菜单。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/11/288180982/11ee64c710e3b091256c0d349ac55461_783212327071031368.png\",\"option\":\"【有什么喝的？】——打开商店界面\"},\"s8ca2bilfwrT1761867933441\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那就不得不提试验设计局挨的那一下了，不管怎么说，愚人众被挫了锐气，除了霜月之子，也有不少人为这事儿高兴呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，这话还是小声点说，毕竟愚人众的生意我们也是要做的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么新鲜事儿吗？】——完成空月之歌 第二幕「尘与灯的挽歌」后\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e托你的福，还算不错。虽然偶尔有些小情况，不过有活气总是好过死气沉沉，不是么？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且，就算是处理麻烦事也是很有乐趣的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近生意怎么样？】\"},\"ztt6wg07evaT1759884867804\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【使用菲林斯与德米安对话】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2ne4sdjbktoT1757599766846\":[\"ztt6wg07evaT1759884867804\"],\"4cf2vhylew3T1710863944349\":[\"ztt6wg07evaT1759884867804\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"s8ca2bilfwrT1761867933441\",\"2ne4sdjbktoT1757599766846\"],\"br7a9i011neT1759884993127\":[\"fjtsoeo5inuT1759885083857\"],\"cgfzz9rom5oT1757599975058\":[\"ztt6wg07evaT1759884867804\"],\"fjtsoeo5inuT1759885083857\":[],\"nqb471m7nmnT1710863941173\":[\"ztt6wg07evaT1759884867804\"],\"s8ca2bilfwrT1761867933441\":[\"ztt6wg07evaT1759884867804\"],\"z2tn3pzsbujT1710863943430\":[\"cgfzz9rom5oT1757599975058\"],\"ztt6wg07evaT1759884867804\":[\"br7a9i011neT1759884993127\"]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1763950302","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col