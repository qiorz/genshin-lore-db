{"retcode":0,"message":"OK","data":{"page":{"id":"510199","name":"希诺宁【彩蛋】","desc":"希诺宁彩蛋","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/97c84525443624a162b60fc5c1b2c33f_8931557864133744986.png","header_img_url":"","modules":[{"name":"基本信息","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e纳茨卡延的铸名师，善于在工作的重担与舒适的生活之间找到平衡点。\u003c/p\u003e\"],\"key\":\"角色介绍\"}],\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/ff1745c76b33c041c26e64e137dae368_6313515938722178186.png\",\"attr\":[{\"value\":[\"\u003cp\u003e希诺宁\u003c/p\u003e\"],\"key\":\"角色名\"},{\"value\":[\"\u003cp\u003e3月13日\u003c/p\u003e\"],\"key\":\"生日\"},{\"value\":[\"\u003cp\u003e纳茨卡延\u003c/p\u003e\"],\"key\":\"所属\"}]}\n","style":""}],"id":"8151","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/16011e8b49ea88c961eaa55050cbddf9_7968048648675950049.png\"}]}\n","style":""}],"id":"8155","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"8174","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"默认标题\",\"image\":\"\"}]}\n","style":""}],"id":"8175","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"xai8n9zylaiT1757443368276\",\"child_ids\":{\"xai8n9zylaiT1757443368276\":[]},\"contents\":{\"6bslxxdd1cjT1762850235229\":{\"option\":\"旅行者：怎么了? \",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"dcrtjpxptswT1762850235977\":{\"option\":\"旅行者：是难缠的客人吗？\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"l2u6uxkcxkT1762850071680\":{\"option\":\"旅行者：还、还能原路退回的？\",\"dialogue\":\"\u003cp\u003e希诺宁：唉，你是不知道，用书信的方式谈工作真的很麻烦啊。\u003c/p\u003e\u003cp\u003e希诺宁：光是修改一个零件的尺寸，我说不定就要和客人来来回回互相寄十几封信。\u003c/p\u003e\u003cp\u003e希诺宁：光是递送信件，就不知道浪费了多少时间。\u003c/p\u003e\u003cp\u003e希诺宁：有那个闲工夫，还不如直接到部族里和我面谈，这样子效率最高。\u003c/p\u003e\u003cp\u003e希诺宁：…哈？还有一封信给我？一定要我拆开？真是…\u003c/p\u003e\u003cp\u003e希诺宁：……\u003c/p\u003e\",\"icon\":\"\"},\"xai8n9zylaiT1757443368276\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"zy8upr8bz2pT1762850236917\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e希诺宁：是玛薇卡。她已经在我的工坊里，等着和我「面谈」了。\u003c/p\u003e\u003cp\u003e希诺宁：玛…薇…卡…\u003c/p\u003e\u003cp\u003e希诺宁：不行。我要再想个办法，离部族远一点…\u003c/p\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8176","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"名称\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"上线时间\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]},{\"key\":\"相关奖励\",\"value\":[\"\u003cp\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"8177","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"地图展示\",\"image\":\"\"}]}\n","style":""}],"id":"8178","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情彩蛋对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"child_ids\":{\"rl5ybxayxoaT1757443368290\":[]},\"contents\":{},\"root_id\":\"rl5ybxayxoaT1757443368290\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8179","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"七圣召唤对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"p7fognx40hT1757443368309\",\"child_ids\":{\"p7fognx40hT1757443368309\":[]},\"contents\":{}}]}\n","style":""}],"id":"8180","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"幻想真境剧诗对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"jdttxlvm7rT1757443368314\",\"child_ids\":{\"jdttxlvm7rT1757443368314\":[]},\"contents\":{}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"8181","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"生日","is_poped":false,"components":[{"component_id":"timeline_base_info","layout":"","data":"{\"list\":[{\"attr\":[{\"key\":\"\",\"value\":[\"\u003cp\u003e呼啊…今天闹钟定得有点太早了，睡得确实有点少。\u003c/p\u003e\u003cp\u003e也没办法，我一睡起来就没个完，总不能把大早上来我家做客的朋友们都晾在外面吧。\u003c/p\u003e\u003cp\u003e之前有一年，卡齐娜一大早就送礼物过来，看我没起床，就乖乖抱着礼物盒在门外等着。结果…一直等到太阳下山了我也没醒。还是路过的玛薇卡把门踢开，才把我摇醒了…\u003c/p\u003e\u003cp\u003e自从那次生日之后，我就专门做了一台只会在我生日当天启用的「生日专用闹钟」。\u003c/p\u003e\u003cp\u003e哦对了，今天招待卡齐娜的时候，我和她一起做了很多糖果，她说挺好吃的，也分你一点。\u003c/p\u003e\u003cp\u003e…等等，玛薇卡怎么还没出现？她不会又在打什么鬼点子吧…\u003c/p\u003e\u003cp\u003e【邮件赠礼：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502084\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/27/8912764/a5fa7e0267b0f175caffce733b3799fc_4125024951897549227.png\\\" data-entry-name=\\\"美味的宝石闪闪\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/502084/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502084/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e美味的宝石闪闪\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"502074\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/26/75610764/630ae796733289f91620b55ebf458764_1837410372047827690.png\\\" data-entry-name=\\\"果味奶糖\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/502074/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/502074/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e果味奶糖\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\u003cdetails class=\\\"custom-details\\\"\u003e\u003csummary\u003e生日贺图\u003c/summary\u003e\u003cdiv data-type=\\\"detailsContent\\\"\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/11/294074726/934cdcadc7e67a51f9237efeaba920ed_5407347901955151913.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"450\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 450px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/11/294074726/934cdcadc7e67a51f9237efeaba920ed_5407347901955151913.png\\\" style=\\\"width: 450px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/62627946\\\" target=\\\"_blank\\\"\u003e希诺宁生日快乐｜来吧，别呆站在那，一起跳一段…\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/details\u003e\"]}],\"tab_name\":\"起了个大早…——2025-03-13\"}]}\n","style":""}],"id":"8182","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"pqcjylxzvyoT1757443368294\",\"child_ids\":{\"29k9qygqornT1757443533242\":[],\"2ilc54j09jiT1757443707773\":[],\"41lobz2yoscT1757443639779\":[\"uqv6767pwT1757443649689\"],\"4iln7jow1eT1757443658284\":[\"jiratc8sysT1757443673589\"],\"jiratc8sysT1757443673589\":[\"mfibkmbc75rT1757443682323\"],\"ksrxpcmvx3eT1757443534633\":[],\"mfibkmbc75rT1757443682323\":[],\"n706adnhm0qT1757443531434\":[\"41lobz2yoscT1757443639779\"],\"nimbiuzoafT1757443696149\":[\"qcgklc1t4slT1757443704923\",\"2ilc54j09jiT1757443707773\"],\"noocgcginaT1757443595837\":[\"z2xb4gms0iT1757443607598\"],\"pqcjylxzvyoT1757443368294\":[\"r9x50wvjmvfT1757443530267\",\"n706adnhm0qT1757443531434\",\"zhjz4daxvkT1757443532384\",\"29k9qygqornT1757443533242\",\"ksrxpcmvx3eT1757443534633\"],\"qcgklc1t4slT1757443704923\":[],\"r9x50wvjmvfT1757443530267\":[\"noocgcginaT1757443595837\"],\"smyd63xjrtdT1757443624191\":[],\"uqv6767pwT1757443649689\":[\"4iln7jow1eT1757443658284\"],\"z2xb4gms0iT1757443607598\":[\"smyd63xjrtdT1757443624191\"],\"zhjz4daxvkT1757443532384\":[\"nimbiuzoafT1757443696149\"]},\"contents\":{\"29k9qygqornT1757443533242\":{\"option\":\"【早啊，希诺宁。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好，看你的样子，昨晚上睡得很不错啊。我的睡眠质量也很好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"2ilc54j09jiT1757443707773\":{\"option\":\"【发呆有这么深奥吗…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然啦。不信你去问茜特菈莉，或者欧洛伦，他们「烟谜主」里有许多人都要专门学习如何冥想。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e冥想和发呆其实差不多啦，都是先清理思想，再让自己的内心平静下来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e两者的区别就在于，「烟谜主」需要在冥想状态进行某种行动，而我们，只需要享受发呆带来的平静就好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好了好了，说起来复杂，其实很简单的，你跟着我一步一步来就行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e首先，凝望着空气里的某一个点…随便哪里都可以，只要你觉得舒服。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e接着，开始放松你的眉头…再放松肩膀…专注盯着那个点，脑子里只思考，那个点究竟在哪里…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然后…呼啊…然后…继续放松…放松…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…呼…呼…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"41lobz2yoscT1757443639779\":{\"option\":\"【那你怎么不多睡一会？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e差不多就可以了。我也不是那种极端嗜睡的人，只要保证每天有八九个小时的充足睡眠就足够。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是…在有工作上门的时候，我也很难一次性睡这么久。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e特别是打造「古名」，一旦开始，我每天都只能断断续续地睡三到四个小时，甚至连续好几天都不能睡觉。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4iln7jow1eT1757443658284\":{\"option\":\"【但那么多故事，怎么查证真伪？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一般我会去「烟谜主」那边，查阅一下他们的「织卷」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「织卷」上记录的历史一向非常可靠，而且…「烟谜主」那边还有茜特菈莉，我有时候也会去找她请教。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果「织卷」上也没有，那我就会去联系各个部族里的人，看能不能找到相关的资料。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在搜集到大量的资料后，我会找出彼此之间有联系的故事，再对这些故事进行「交叉对比」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e将查出来的谬误记录下来，再继续查找与之有关的故事，确定其究竟是谬误，还是漏传…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jiratc8sysT1757443673589\":{\"option\":\"【感觉是一个巨大的工程…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，所以我说，一旦开始打造「古名」，我就别想睡了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e每天睁开眼睛是打造「古名」，闭上眼睛还是打造「古名」。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e玛拉妮曾经还自告奋勇地来帮我，结果…还没查证多少故事呢，她就沉沉地睡过去了，怎么叫都叫不醒。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在你知道，我为什么总是抽空去睡觉了吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e光是提起这些忙不完的工作，我就…呼啊…就有点犯困了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ksrxpcmvx3eT1757443534633\":{\"option\":\"【晚安，希诺宁。】\",\"dialogue\":\"\u003cp\u003e晚安，早点睡啊，睡之前就别看那些复杂的资料了，会睡不着或者做噩梦的。\u003c/p\u003e\",\"icon\":\"\"},\"mfibkmbc75rT1757443682323\":{\"option\":\"【以后我也来帮你！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊，你旅行了那么久，肯定见多识广，也听过不少故事，应该有判断一段故事真伪的经验。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e下次打造「古名」的时候，我一定叫上你。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，你来的时候记得带上个枕头，困了之后可以枕着睡觉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你和卡齐娜一样，枕着书睡觉的话，第二天醒来的时候，脖子会疼得直不起来。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在你知道，我为什么总是抽空去睡觉了吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e光是提起这些忙不完的工作，我就…呼啊…就有点犯困了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"n706adnhm0qT1757443531434\":{\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e行啊。我正好已经睡饱了，这盏壶里的温度正好，床和枕头也很舒服…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e感觉这一觉的质量够我回味一周的了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nimbiuzoafT1757443696149\":{\"option\":\"【这事情还有诀窍？】\",\"dialogue\":\"\u003cp\u003e当然了。发呆的本质，就是迅速清理自己脑子里乱七八糟的事情，再将自己的精神抽出身体，达到一种有专注性的完全平静…\u003c/p\u003e\",\"icon\":\"\"},\"noocgcginaT1757443595837\":{\"option\":\"【希诺宁最喜欢哪个部族的环境？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e最喜欢？嗯…要是我爸在这里，听我说这话，肯定又要瞪我…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我最喜欢的其实是玛拉妮那边的「流泉之众」啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e每天都可以泡温泉，空气也很湿润，有很多好喝的饮料，还有专门的首饰店和唱片店。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无论从哪个角度来说，都很适合悠闲地生活啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e基尼奇那边的「悬木人」也不错，他们的帐篷都建得很高，只要躺在里面就能吹到很清爽的风。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e偶尔还能蹦个极啦，滑个草啦之类的…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"pqcjylxzvyoT1757443368294\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你居然还有这种秘密基地，环境还这么好，不错啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是我也有一个这样的壶就好了。想偷懒了就往里面一钻，看谁还发现得了我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"qcgklc1t4slT1757443704923\":{\"option\":\"【有一种「烟谜主」祭祀的感觉…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e喔，我确实也向茜特菈莉学习过和冥想相关的知识。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但我可没有…也懒得找那种和万物沟通的「灵性」，我只想学习到让自己清净下来的方法。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e好了好了，说起来复杂，其实很简单的，你跟着我一步一步来就行。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e首先，凝望着空气里的某一个点…随便哪里都可以，只要你觉得舒服。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e接着，开始放松你的眉头…再放松肩膀…专注盯着那个点，脑子里只思考，那个点究竟在哪里…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然后…呼啊…然后…继续放松…放松…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…呼…呼…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"r9x50wvjmvfT1757443530267\":{\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e挺不错的。我还是第一次住在一盏壶里，和在部族里的感觉完全不一样，感觉很新奇。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"smyd63xjrtdT1757443624191\":{\"option\":\"【看来希诺宁还是最喜欢「回声之子」呢。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是吗？我自己倒是没什么感觉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，我真的想再去「流泉之众」度个假啊…唉，过几天去问问玛拉妮吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"uqv6767pwT1757443649689\":{\"option\":\"【打造「古名」很复杂吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对我来说，打造「古名」在技术上并不复杂，但去求证那枚「古名」背后故事的真伪，就是一件天大的麻烦事了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一枚「古名」背后的故事，往往会横跨很长一段时间，牵涉多个相关人物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一般来说，这些相关人物都是在以自己的言行举止，践行对应「古名」之中所蕴含的「精神力量」…不然也不会被归到这枚「古名」之中。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e然后，问题就来了，这些相关人物早已作古，他们的一言一行，都只能通过卷宗来查证。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但谁也不知道，这些卷宗里所记录着的人物言行到底是不是符合史实，所说的话究竟是不是准确无误。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果贸然把虚构的故事，和被讹传的话语锻造进「古名」里…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那这枚「古名」一定会出现重大缺陷，甚至波及到持有这枚「古名」的人，让他的心神都出现问题。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2xb4gms0iT1757443607598\":{\"option\":\"【不然，去其他部族里住一住？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这个啊…哎呀，我其实试过啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e之前玛拉妮就邀请我去她家参加聚会，顺便留我在家里住了好几天。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最开始我住得可舒服了，每天泡泡温泉，喝喝饮料，再和玛拉妮出去闲逛…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是…怎么说呢，越住我越…那个，怎么说呢…越住越不踏实。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也不是住腻了，就是越来越想回「回声之子」去看看。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到最后，我满脑子都是工坊里的事务，就匆匆向玛拉妮告别，回了部族里。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e也不知道为什么，一回到工坊…不，一进部族里，看见红色的峭壁时，我的心一下子就踏实了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zhjz4daxvkT1757443532384\":{\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没有。我不想做任何事，在这里发呆就挺好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e难得在一个根本没人能找到我的地方休息，我就不给自己找麻烦了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来来，我们一起发发呆吧，我教你迅速进入发呆状态的诀窍。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/869ed4b2ff66bc5cf20b389a42eb6adb_2054651181696531708.png\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色赠礼","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"同伴赠礼\",\"header\":[\"好感套装\",\"对应奖励\",\"好感套装对话\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"505162\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/0291f223284c06df0692f6944b6a0225_2745627140479188358.png\\\" data-entry-name=\\\"于最灼热的炉火中诞生\\\" data-entry-link=\\\"/ys/obc/content/505162/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/505162/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/0291f223284c06df0692f6944b6a0225_2745627140479188358.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e于最灼热的炉火中诞生\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501922\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/183046623/631ef3b55abddd4078da9d8ef65439e9_6531465554783788863.png\\\" data-entry-name=\\\"「焚燔」的指引\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/501922/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/501922/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/183046623/631ef3b55abddd4078da9d8ef65439e9_6531465554783788863.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「焚燔」的指引\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*2\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"20000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"\u003cul\u003e\u003cli\u003e\u003cp\u003e锻炉，铁砧…连招牌和支架都搬来了，真是个有模有样的铁匠铺，只要点起火就能正常开工了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呼啊…光是看着这些东西，想象用它们工作的样子，我就已经感觉有些累了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不行，不行，我真的有点困…真的必须要睡一觉…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"],[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"505160\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/40596e9bfd4ed073c39f40fca9a68a92_125433919913483648.png\\\" data-entry-name=\\\"「回声之子」的热血\\\" data-entry-link=\\\"/ys/obc/content/505160/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/505160/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/04/08/50494840/40596e9bfd4ed073c39f40fca9a68a92_125433919913483648.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e「回声之子」的热血\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"862\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/01/80410800/169abdbbb1e79d89131543f944e42e1d_6255025949454286240.png\\\" data-entry-name=\\\"坚牢黄玉断片\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/862/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/862/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entr