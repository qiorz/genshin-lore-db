status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1267/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e且听下回分解\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【茂才公】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈…这刘苏刘博士不愧是璃月的名嘴，尤其是古华派被砸招牌那段，可把我逗得…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昌虎】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，可不是吗，有老爷您在这儿捧场，那刘博士还不得赶紧把浑身解数都使出来？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【茂才公】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e话说在你之前，我的上一任跟班儿，他就是古华派的出身。舞刀弄枪没咋学会，倒是练了一手腿上功夫。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当初他跟我讲，他那双腿啊，能日行千里，追云逐月！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昌虎】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e豁！没点能耐哪儿能给您当跟班儿啊，您说是不，嘿嘿嘿…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【茂才公】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e正巧，我那小儿子正天天在府上闹腾得我脑仁儿疼，我说那得了，你听小少爷指挥，抬着轿子带他上街转悠去吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昌虎】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e小少爷那精神头儿，将来准跟您老一样是人中龙凤呐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【茂才公】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e后来你猜怎么着，小少爷就那么让他跑了三天三夜，吃着喝着睡着都没让他停下过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等回府上，他往那儿一坐就再也起不来了，活像他们古华派祖师爷那尊坐像…这不才把你招进府里接替那个废人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昌虎】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈…老爷您真是太幽默了，像那祖师爷的坐像…也算他修成正果了吧，哈哈哈…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【茂才公】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，别说我还有点儿想他，就那几天府上觉着最清静。欸，说起来…你是不是也有「花轿资格证」来着？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【昌虎】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈哈…哈哈…啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e老爷…您的意思是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746978446","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","