1173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e随意挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成世界任务「富豪游戏」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【我要购物。】——打开商店界面、完成世界任务「富豪游戏」前\"},\"pq1z2fpymllT1728036384096\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e现在没什么值得一看的稀罕玩意儿！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e上次小云雀和你们一起把东西全买完了，后续补货又出了些意外，好几个老主顾想来买瓶枫达我都拿不出来，本店的声誉啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之我这儿现在没什么值得你出手的货品，不如去别处看看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【让我购物！】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e无可奉告。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我只能说货品是安全的，途径是正规的，定价是合理的。至于其他的，我没什么可说的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你的货是从哪来的？】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1728037392","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"