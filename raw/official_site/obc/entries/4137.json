be2e4c5fc_8232162997839619540.png\\\" data-entry-name=\\\"三川游艺绮梦谭\\\" data-entry-link=\\\"/ys/obc/content/504528/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/504528/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e三川游艺绮梦谭\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"01bonu8180s8T1739861935199\":[\"mnir8vv0u5T1739861973855\"],\"1gswww54jx7T1739861515496\":[\"r2lw4m0dj1kT1739861556264\"],\"54igugsdvzqT1739861475728\":[\"1gswww54jx7T1739861515496\"],\"7ncjn1spf08T1739862027671\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"exvhtnd6ewfT1739861748095\":[\"01bonu8180s8T1739861935199\"],\"jv3klaxgatT1739861490848\":[\"1gswww54jx7T1739861515496\"],\"mnir8vv0u5T1739861973855\":[\"7ncjn1spf08T1739862027671\"],\"n75v5ce21rT1739861610304\":[\"w93udaohkzlT1739861717560\"],\"nqb471m7nmnT1710863941173\":[\"54igugsdvzqT1739861475728\",\"jv3klaxgatT1739861490848\"],\"r2lw4m0dj1kT1739861556264\":[\"wijmm0thnbpT1739861606400\",\"n75v5ce21rT1739861610304\"],\"w93udaohkzlT1739861717560\":[\"exvhtnd6ewfT1739861748095\"],\"wijmm0thnbpT1739861606400\":[\"w93udaohkzlT1739861717560\"]},\"contents\":{\"01bonu8180s8T1739861935199\":{\"icon\":\"\",\"option\":\"【你们怎么不去？】\",\"dialogue\":\"\u003cp\u003e【阿晃】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我们以前跟老大去过一次。但老大当时突发奇想，突然就开始比赛…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"1gswww54jx7T1739861515496\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请...请不要说这种话啊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不要这样冷漠地打击我的积极性啊！这样我的工作不就失去了意义吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您是老大的挚友，请代替老大给我一些支持吧。拜托了，对我说那句话吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"54igugsdvzqT1739861475728\":{\"icon\":\"\",\"option\":\"【完全没有。】\",\"dialogue\":\"\"},\"7ncjn1spf08T1739862027671\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「荒泷极上盛世豪鼓大祭典」期间】\u003c/strong\u003e\u003c/p\u003e\"},\"exvhtnd6ewfT1739861748095\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e【阿守】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？你没跟老大他们去泡温泉吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"jv3klaxgatT1739861490848\":{\"icon\":\"\",\"option\":\"【根本不会有。】\",\"dialogue\":\"\"},\"mnir8vv0u5T1739861973855\":{\"icon\":\"\",\"option\":\"【比赛什么？】\",\"dialogue\":\"\u003cp\u003e【元太】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…忘了，只记得当时差点就热晕过去了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"n75v5ce21rT1739861610304\":{\"icon\":\"\",\"option\":\"【我快要…我快要…抱歉我说不出口。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…好吧。就算您这样说，但看着荒泷派的大家都在努力做好自己的工作，所以就算这样我也不能松懈…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无论遭受什么打击也不放弃，这是老大的教导！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e来吧，朋友们！接着奏乐接着舞！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是荒泷豪鼓祭氛围大使阿守，您有什么需要吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您问我的工作？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e啊，氛围大使嘛，主要就是营造火热的氛围，让参加祭典的人们产生「我快要嗨到不行了」的感觉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您有那种感觉吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"r2lw4m0dj1kT1739861556264\":{\"icon\":\"\",\"option\":\"【哪句话？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「我快要嗨到不行了」那句话。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"w93udaohkzlT1739861717560\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「三川游艺绮梦谭」期间\u0026完成终夜「如伴雷电」后】\u003c/strong\u003e\u003c/p\u003e\"},\"wijmm0thnbpT1739861606400\":{\"icon\":\"\",\"option\":\"【我快要嗨到不行了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e太棒了！太棒了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这是对我最好的认可！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1739868954","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{