{"retcode":0,"message":"OK","data":{"page":{"id":"6505","name":"白术【洞天】","desc":"白术【洞天】","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/11/5787925/cad4feea8ddf34396ca1a45179cde0ee_3286684074005522038.png","header_img_url":"","modules":[{"name":"白术","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"attr\":[{\"key\":\"性别\",\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"]},{\"key\":\"位置\",\"value\":[\"\u003cp\u003e尘歌壶\u003c/p\u003e\"]},{\"key\":\"功能\",\"value\":[\"\u003cp\u003e增加好感\u003c/p\u003e\"]},{\"key\":\"职业\",\"value\":[\"\u003cp\u003e不卜庐药师\u003c/p\u003e\"]}],\"extra_attr\":[{\"key\":\"编者注：\",\"value\":[\"\u003cp\u003e「璃月有间不卜庐，庐里有位白大夫。妙手回春百病除，就是开的药——太苦!」\u003c/p\u003e\"]},{\"key\":\"好感套装：\",\"value\":[\"\u003cp\u003e绯云文斋、柴烟庖屋\u003c/p\u003e\"]}],\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/06/5787925/9069eafa8d5fc6a40cb9bf8cd1bf0f4b_7532626694916141266.png\"}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/05/06/5787925/6e97686eb34a555f86a43d4b1df40331_3184554762955043741.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"同伴赠礼","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e好感套装\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e奖励\u003c/strong\u003e\u003c/p\u003e\u003c/th\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"2182\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/06/19/74019947/94ac2bfb98a5e9f955f2730f72deef06_2824211271967764467.png\\\" data-entry-name=\\\"绯云文斋\\\" data-entry-link=\\\"/ys/obc/content/2182/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/2182/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/06/19/74019947/94ac2bfb98a5e9f955f2730f72deef06_2824211271967764467.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e绯云文斋\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4424\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/21/187743934/99724c403a9339063275be49f4e6857b_5169929359223233571.png\\\" data-entry-name=\\\"生长碧翡断片\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/4424/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/4424/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/21/187743934/99724c403a9339063275be49f4e6857b_5169929