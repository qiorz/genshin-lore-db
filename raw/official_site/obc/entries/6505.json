bc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/f9de059da2ee541c770eb1c83d0018a9_6412355601661015430.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e \u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"20000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/12/08/160182379/605f7e564ce17decc9e09508567776ce_5737054899684571258.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*20000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e  \u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【绯云文斋好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e看得出来，你在书斋的布置上下了功夫。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e盆景尤其挑得好，既有清雅的姿态又不乏野趣，长期伏案的人正需要靠它放松精神。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e养生中关键的一步就是养心，这件书斋的陈设很符合个中之道。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【柴烟庖屋好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这地方不仅能生火做饭，也便于制药…让你费心了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…就用这个小号的炉灶煎药，其余的器具我正好都带着。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这样一来就不至于耽误急等着用药的病患了，我心安了许多，谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"xvpf5v3r7gT1712846148522\",\"g27zyiwcydT1712846149632\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"jgumkvt0e4bT1712845957771\",\"d74i478fvq5T1712845958825\"],\"a7ndhh1dluT1712845982725\":[\"xgyob27hvgjT1712845983853\",\"oame6wpy2oT1712846007210\"],\"ccvti00ryujT1712846106519\":[],\"d74i478fvq5T1712845958825\":[],\"e9mm8ha7nsmT1712846095598\":[\"ccvti00ryujT1712846106519\"],\"g27zyiwcydT1712846149632\":[],\"jgumkvt0e4bT1712845957771\":[],\"nqb471m7nmnT1710863941173\":[\"a7ndhh1dluT1712845982725\"],\"oame6wpy2oT1712846007210\":[\"ry4dk31hgfjT1712846033312\"],\"ry4dk31hgfjT1712846033312\":[\"seys81v3r6T1712846047045\"],\"rz4ifc5xkcT1712846082083\":[\"e9mm8ha7nsmT1712846095598\"],\"seys81v3r6T1712846047045\":[],\"xgyob27hvgjT1712845983853\":[\"ry4dk31hgfjT1712846033312\"],\"xvpf5v3r7gT1712846148522\":[],\"z2tn3pzsbujT1710863943430\":[\"rz4ifc5xkcT1712846082083\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e 想做的吗？人生在世几十年，往往是想做的太多，而活着的时间太短。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我们平时闲聊也不必说得太远，只谈谈最近想做的事好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e璃月港这么大，偶尔有人猝然间受了重伤无法行动，或者有口难言不好求救。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等大夫赶到现场的时候，有可能会耽误救治的时机。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e人们平时总想着让大夫掐紧时间，但我自问没办法瞬息移动，要是到晚了不就错失良机了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e遇到这种情况，病患还是应该先努力自救。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e自救的方法很多，但并不是所有人都知道。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e从这里开始就是我作为一个大夫能做的事了，我得想点主意把自救的方法教给大家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有个说法叫「住所是主人性情的忠实反映」，我觉得挺有道理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e今天亲眼见到了这壶中洞天，嗯，你果然是个有意思的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"a7ndhh1dluT1712845982725\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e其实也没什么特别的，因为我身体不好，有些毛病一旦发作起来必须得及时吃药，这才带了一个药箱。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e除了药之外，还有些其他瓶瓶罐罐，又重又占地方，我也就没多带。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【重要的东西？】\"},\"ccvti00ryujT1712846106519\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e小心驶得万年船，就算你嫌啰嗦我也得说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【知道了，大夫。】\"},\"d74i478fvq5T1712845958825\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e夜晚是身体休眠的时间，这时候睡觉是自然规律。不能总想着晚上不睡，白天补觉，这样不好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊…不好意思，我没有指责你的意思。平时总跟病人说这些，成习惯了，你别在意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，白术。】\"},\"e9mm8ha7nsmT1712846095598\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e就是些药草罢了，其中有些毒性比较大，不处理一下是无法入药的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说到这个，我觉得有必要提醒你一下，是药三分毒。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不仅只有我那里的药材有毒性，哪怕是些温和的药，如果不对症，长期吃着也对身体不好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没生病的时候一定不要乱吃药，有些身体上的不适症状，不用药也能好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这时候就不要想着先吃药，最好是先来问我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么好东西？】\"},\"g27zyiwcydT1712846149632\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我现在的确有了些方向，但还没想清楚如何做最迅速有效。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你愿意听我唠叨就已经是莫大的帮助了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e以后我有了更成熟的方案，一定会再和你商量的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e届时，多半还要再麻烦你了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【需要我帮忙吗？】\"},\"jgumkvt0e4bT1712845957771\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e早晨空气清新，人也为之精神振奋，如果有什么要紧事，放到这时候做正好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哈…看起来你们都不困，那你们先聊，我眯一会儿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，白术。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的生活习惯和别人略有不同，但你不用太在意这种事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e重要的东西我都随身备好了，毕竟是个大夫，要是连自己都照顾不好就太不像话了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"oame6wpy2oT1712846007210\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你，我的东西…有点多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原本就是来做客的，占了主人太多地方就不好意思了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，瞧他这又惦记又含蓄的样子，我来说好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那些瓶瓶罐罐啊，不能说是有点多，得说是很多，特别多！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果都搬来的话，恐怕一间屋子都不够放。玩家，你得考虑好哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里地方很大。】\"},\"ry4dk31hgfjT1712846033312\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那…我来写个单子吧，请阿桂帮忙把那些东西送来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不，他一个人肯定是拿不下的，就算叫上七七，也拿不了许多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还是我回去一趟，把所有东西装好箱再分批送进来…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没、没关系。】\"},\"rz4ifc5xkcT1712846082083\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…没错，除了煎服的汤剂之外，我也会给病人开些外用药。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e外用药多是药膏与药液，成分复杂，混合比例有讲究，炮制过程也麻烦一些。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e病人当然是不懂如何制药的，一般都是我自己动手。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e制药时需要用到处理过的药材，就是那些瓶瓶罐罐里泡着的东西了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没错没错，那里面泡着不少好东西哪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【瓶瓶罐罐？】\"},\"seys81v3r6T1712846047045\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，我这人是有些麻烦…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这么多吗？】\"},\"xgyob27hvgjT1712845983853\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你，我的东西…有点多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e原本就是来做客的，占了主人太多地方就不好意思了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，瞧他这又惦记又含蓄的样子，我来说好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那些瓶瓶罐罐啊，不能说是有点多，得说是很多，特别多！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果都搬来的话，恐怕一间屋子都不够放。玩家，你得考虑好哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【可以放心带来。】\"},\"xvpf5v3r7gT1712846148522\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e医者的责任重大，既然做了大夫这些就是我份内的事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你愿意听我唠叨就已经是莫大的帮助了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e以后我有了更成熟的方案，一定会再和你商量的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e届时，多半还要再麻烦你了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是很有意义的想法。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不知道你对什么感兴趣？说药学怕你觉得无聊，和你谈养生大概也不切实际。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你不是一直念叨那些瓶瓶罐罐吗？说那个就是了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712847245","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"地区\\\",\\\"children\\\":[{\\\"label\\\":\\\"蒙德\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"璃月\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"稻妻\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"须弥\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"枫丹\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"纳塔\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"挪德卡莱\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"至冬\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"活动地区\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"洞天\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"活动\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"商人\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"任务\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"牌手挑战\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"对话奖励\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"特殊效果\\\",\\\"children\\\":[{\\\"label\\\":\\\"心声\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"秘闻馆情报\\\",\\\"children\\\":[]}]}]\"},{\"type\":\"text\",\"attribute_name\":\"首页更多\",\"attribute_key\":\"home_more\",\"value\":\"https://baike.mihoyo.com/ys/obc/channel/map/189/20?bbs_presentation_style=no_header\"},{\"type\":\"text\",\"attribute_name\":\"在目录中展示\",\"attribute_key\":\"show_in_catalog\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"最新词条\",\"attribute_key\":\"is_latest\",\"value\":\"0\"},{\"type\":\"text\",\"attribute_name\":\"更多入口icon\",\"attribute_key\":\"king_kong_icon\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"首页更多文案\",\"attribute_key\":\"home_more_text\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"开放全量C端玩家可新建词条\",\"attribute_key\":\"open_for_create\",\"value\":\"0\"}]","updated_at":"-62135596800"}],"template_id":"6605788895f7dc84ca833e44","ext":{"fe_ext":"{\"c_20\":{\"filter\":{\"text\":\"[\\\"地区/洞天\\\"]\"}}}","post_ext":{"post_id":"","post_user_name":"","post_time":"0","post_avatar_url":"","url":""},"server_ext":"","personalized_color":"","scrolling_text":"","corner_mark":"None"},"alias_name":"","lang":"","beta":false,"page_type":"Default","menu_style":"","status":"Online"}}}