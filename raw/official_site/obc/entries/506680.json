ps://act-upload.mihoyo.com/wiki-user-upload/2025/12/06/80663279/dbfe7bfe83d191936f3be3b67d10435f_7518108917206475632.png\\\" data-entry-name=\\\"空月之歌 第六幕「散于晨雾的月芒」\\\" data-entry-link=\\\"/ys/obc/content/507424/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/507424/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e空月之歌 第六幕「散于晨雾的月芒」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp\u003e【维萨】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e梅妲姐姐，你就和我去嘛！哇，那可是两个头的鸟、三只眼睛的龙和肚子里装满摩拉但会咬人的宝箱！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【梅妲】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【维萨】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e听说运气好还能碰到精灵哦！风就像这样——呜…呜…吹来一阵大雾…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【梅妲】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…对了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【维萨】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哼哼，反正我现在已经等不及要出发啦！梅妲和维萨，可是最好的冒险组合！对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【梅妲】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没错，但是…我突然想起来我有些事儿，要不下次再说吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【维萨】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咦？可是梅妲姐姐，你刚刚明明和别人说，「今天老爹有事不在，可以一起出门冒险啦！」——\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【梅妲】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，海螺帮的朋友们正…咳咳，你听错了，我刚才是说…呃，今天老爹有事儿不在，我需要看门，不能出去冒险啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是下次，下次有好机会的时候，我们再一起出发，好么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【维萨】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！好耶！那接下来每天我都要早早地起床，这样就一定不会错过和梅妲姐姐一起冒险的[好机会」了!\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1768184205","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":tr