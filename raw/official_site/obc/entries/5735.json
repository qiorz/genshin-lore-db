03e\u003cspan class=\\\"name\\\"\u003e兰纳迦的回忆\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5285\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/07/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_8057617322572995012.JPG\\\" data-entry-name=\\\"回忆终章\\\" data-entry-link=\\\"/ys/obc/content/5285/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5285/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e回忆终章\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2pdya4gpxrcT1758189394554\":[\"v4sgj47tttT1758189419297\"],\"4o0vn9uhg3wT1758189347705\":[\"fe99c3poadhT1758189445200\"],\"6vy6m5bilfuT1758189395360\":[\"v4sgj47tttT1758189419297\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"8h9t6ok86giT1758189396170\":[\"v4sgj47tttT1758189419297\"],\"fe99c3poadhT1758189445200\":[\"ptaxyxfhm9eT1758189380492\"],\"nqb471m7nmnT1710863941173\":[\"4o0vn9uhg3wT1758189347705\"],\"ptaxyxfhm9eT1758189380492\":[\"2pdya4gpxrcT1758189394554\",\"6vy6m5bilfuT1758189395360\",\"8h9t6ok86giT1758189396170\"],\"v4sgj47tttT1758189419297\":[]},\"contents\":{\"2pdya4gpxrcT1758189394554\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e已经成为风中的尘灰，「耶然草」，那菈大概是这样看的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是…又都会从森林草木中重新焕发，那些已经飘飞的、深埋的、没有痕迹的绿叶的记忆…每当新的「耶然草」长出新芽。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那菈旅行者和白飞飞也一样，是新朋友，也是老朋友，因为谢落了，又重生了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于「耶然草」…】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"4o0vn9uhg3wT1758189347705\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」期间】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【兰迦鲁】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，无忧节好热闹，桓那兰那到处都是快乐！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰纳真】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是无忧节会结束。兰那罗的那菈朋友，可能也会离开。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"6vy6m5bilfuT1758189395360\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没有了「无留陀」的侵扰，「无郁夷摩」又会重新覆满花与树…在月亮的升起与落下之后。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要对那菈旅行者还有白飞飞道谢，兰纳迦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于「无郁夷摩」…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【初入桓那兰那】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"8h9t6ok86giT1758189396170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，新的朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"fe99c3poadhT1758189445200\":{\"dialogue\":\"\u003cp\u003e【兰纳迦】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e森林会记住一切。但是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【兰迦鲁】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望不要有风，吹走快乐，让快乐多留一下。希望有雨，淋湿大地，留住那菈朋友，多停一下…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【「无忧节」结束之后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【森林会记住一切。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e耶然草…必须取回。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"ptaxyxfhm9eT1758189380492\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢落的记忆，促生的新的朋友，像是「耶然草」一样，兰纳迦觉得。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"v4sgj47tttT1758189419297\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758189521","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"