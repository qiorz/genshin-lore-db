ion_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e这本小说···好像看过？\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"2vvaiiql6tcT1739700574741\":[\"osk4j7raszT1739700579873\"],\"3jb8xn6j4nxT1739552481775\":[\"2vvaiiql6tcT1739700574741\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[\"s8jy3dlhn0mT1713781243128\"],\"osk4j7raszT1739700579873\":[],\"s8jy3dlhn0mT1713781243128\":[\"3jb8xn6j4nxT1739552481775\"]},\"contents\":{\"2vvaiiql6tcT1739700574741\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我说顺吉，是你说要来「三川花祭」上找灵感，我才推迟了截稿日陪你来的…可你怎么全在吃喝玩乐啊？ \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咳咳…找灵感的事情，怎么能叫吃喝玩乐呢！我这是在体验祭典的氛围！喧闹的祭典、欢快的人类跟妖怪… \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…其中却悄然混入了掌握「秘技·千变方化」的「鬼武者」！——你看灵感这不就来了吗！ \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"3jb8xn6j4nxT1739552481775\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动任务「三川游艺绮梦谭·继夜」前】\u003c/strong\u003e\u003c/p\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…接着，就是现在，啪康一下！时间停止！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等等，停一停…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对，就是停一停，然后…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不是的，我是说停下，啊不，不是说时间停下…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，不要时停吗？那隐形呢？好像也不错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊啊，听人说话啊，你这个人！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这个角色身上已经有很多超能力了吧？突然加设定的话，会整个垮掉的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e可是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e没有可是！你再好好想想。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e行吧…唉，灵感一下就没了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e明明我的直觉说，这里就是要时间停止。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不…你再好好想想？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜，好累…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【光华荣彩祭（2022）期间】\u003c/strong\u003e\u003c/p\u003e\"},\"osk4j7raszT1739700579873\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\"},\"s8jy3dlhn0mT1713781243128\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啧，这个截稿日…怎么看都来不及了啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不我写个发生在平行世界的短篇故事，先赶上光华荣彩祭的出摊时间再说吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？平行世界？登场的还是原本的角色吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呃，是，但又不完全是吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e设定一个新的世界观，就可以不考虑已有的剧情，自由发挥了啊！写起来应该很快的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿茂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e请千万不要这样，不要做出像是原作者写同人作品这样的事情！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了这种原因硬加设定，以前积累的内容可就全被破坏了，完全不值得！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【顺吉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，不可以吗？那…就要做好交不上稿开天窗的准备了哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1739758170","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基