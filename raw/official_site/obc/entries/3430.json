\\"\u003e\u003ca href=\\\"/ys/obc/content/3503/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/06/76078930/a02011f5d076beed9708bd5cd2eca085_1247280457995386704.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e大仓\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"结束NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3502\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/21/192134014/1fae7a0403d8de4922e9d81ecc548128_4470789058106637474.jpg\\\" data-entry-name=\\\"安贞【罪人】\\\" data-entry-link=\\\"/ys/obc/content/3502/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/3502/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/21/192134014/1fae7a0403d8de4922e9d81ecc548128_4470789058106637474.jpg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e安贞【罪人】\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3429\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/06/76078930/5f9af9d051379276e4fc7f76ed7d9bcb_5074179183430744210.png\\\" data-entry-name=\\\"龙蛇藏归辑录\\\" data-entry-link=\\\"/ys/obc/content/3429/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/3429/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e龙蛇藏归辑录\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_custo