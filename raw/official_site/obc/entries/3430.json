load/2023/12/26/177469359/f8bacc007a6b264469a5e2b9c142b493_4984468555068751384.png\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"30000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/26/177469359/f8bacc007a6b264469a5e2b9c142b493_4984468555068751384.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*30000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/06/76078930/09a61e376b84ddbfd5b33f9fe468da45_5674231552003700618.png\"},{\"tab_name\":\"安贞位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2022/01/06/76078930/d62f0380b7de8794000b862decd57c1c_3230625392167605988.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e玩家攻略推荐：\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/14175679\\\" target=\\\"_blank\\\"\u003e【V2.4攻略】#探索解密#龙蛇藏归揖录：图书馆丢失的五本书\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"05v05wpqjt1uT1715072517716\":[\"rizmn08kyfpT1715072541374\"],\"ewllh0qqr0dT1711546416025\":[\"05v05wpqjt1uT1715072517716\"],\"fpa1vqg3n38T1715072560580\":[\"ubsq9r3jqzT1715072569629\"],\"rizmn08kyfpT1715072541374\":[\"ty44a15m2w7T1715072551167\"],\"ty44a15m2w7T1715072551167\":[\"fpa1vqg3n38T1715072560580\"],\"ubsq9r3jqzT1715072569629\":[]},\"contents\":{\"05v05wpqjt1uT1715072517716\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e安贞：先不说这些了。你们是来捉拿我回去的吗？我已经证明了自己的清白。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：是坎瑞亚的家伙，他们偷走了图书馆的书。我虽然是接待他们的保镖卫士，但我绝无可能和他们沆瀣一气。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：我在这边追查到了使团的踪迹，打倒了他们所有人。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：我为了停下他们的机关巨物，和它周旋了很久。最后我扯下了它的核心。但是我也因此受了重伤。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：失去动力的机器压在了丢失的书上面。我已经没办法把它取出来了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：白夜国的地走官可真厉害啊…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：你们不是地走官或者候补吗？唉，无所谓了。最早地走官都是对抗深海龙蜥的勇士，后来才变成执法人员、幽冥判官的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：核心就在营地里。你们不信我的话，可以拿着核心去看看。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e \u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan\u003e安贞：我听闻鸣神岛的使节谈到过鸟这种生物。有翅膀，能够在高天里飞翔。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan\u003e安贞：太梦幻了，你们可以想象吗？\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan\u003e安贞：也有人认为，它们是神明的使者，会特地前来传达人的命运。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan\u003e安贞：如果有人因为流放之罚而最终曝尸荒野的话，同一种鸟还会过来啄食他的凡躯。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp\u003e\u003cem\u003e\u003cspan\u003e安贞：我对这种生灵很着迷。如果今天以后，还有机会见到天光，我一定要养一只鸟。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e拾取遗迹机关的核心\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e找到废弃的遗迹守卫\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e启动遗迹守卫\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e获得《日月前事》\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与安贞的残影对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：你们拿到书了吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：拿到了。安贞你确实是无辜的。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：从刚才的话来看，你们并不是地走官，有点可惜。不然就能现场正式承认我的无罪了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：不然就能立刻证明我的清白了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：我现在感觉非常精神，但是之前那种流血过多的疲倦感也很真实。我是不是真的快要死了所以回光返照啊？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：唔…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：唉，我问你啊，陌生人。被白夜国所判的冤罪，是罪孽吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：…\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与悬空牢的残影对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e寻找安贞的下落\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与安贞的残影对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：你们是…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：你就是安贞吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：没错，是我。我感觉…有点奇怪…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：我记得我一直在追那群家伙，然后拔下来了一个核心丢在营地里。之后我因为自己也受伤挺重的，有点发困。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：现在醒来看到你们，我觉得还挺精神的。我是不是快死了回光返照了？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"fpa1vqg3n38T1715072560580\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e安贞：…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你只是安贞留下的残影。\"},\"rizmn08kyfpT1715072541374\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e安贞：如果此刻的我，因为这种难以平复的心境，被常世大神留为罪影。这是罪孽吗？\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：我，有罪吗？\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：…\"},\"ty44a15m2w7T1715072551167\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：喂，旅行者，你要小心点说话。让他意识到了…意识到那件事的话，他会消失的。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你没有罪。\"},\"ubsq9r3jqzT1715072569629\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e安贞：哼哼，是吗。原来我只是生前的一个影子。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e安贞：原来，我是无罪的啊。\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：你是无罪的，我会让所有人知道。\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_