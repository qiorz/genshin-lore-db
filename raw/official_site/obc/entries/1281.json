style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"5uvj3ie1salT1713359642383\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"nqb471m7nmnT1710863941173\":[\"5uvj3ie1salT1713359642383\"],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"5uvj3ie1salT1713359642383\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e非常不错，除了诸多遗迹和历史之外，璃月本地的风土人情也很有意思。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e毕竟很多风俗的由来也是有着历史故事，光是研究这些就能学到很多。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就像这本我们须弥学者出品的《璃月风土志·绣球》，里面记载的便是璃月地区婚姻相关的习俗。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果感兴趣的话就拿去看看吧，还是很有趣的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"606\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/28/8797197/9a347f9377f725392659ec617f9fe33c_7720237083528907198.png\\\" data-entry-name=\\\"《璃月风土志》第一卷\\\" data-entry-link=\\\"/ys/obc/content/606/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/606/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/28/8797197/9a347f9377f725392659ec617f9fe33c_7720237083528907198.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e《璃月风土志》第一卷\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/72954525/b26706122e54335e75a99308e473cc62_7128318879379475627.png\",\"option\":\"【璃月的旅行感觉如何？】——获得《璃月风土志》第一卷\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔哇，你是旅行者吗？最近有没有什么稀奇的发现？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是须弥来的学者，叫做索拉雅。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然大陆七国都有各自的特殊之处，但是璃月的仙人传说和历史真的太有趣了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【请问你是？】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯嗯，再见噢。听到了什么有趣的故事下次说给我吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713459184","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"69