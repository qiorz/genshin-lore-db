"],\"cd4cnx5l5gpT1783659528689\":[],\"nqb471m7nmnT1710863941173\":[\"5fldit2i7gaT1783511604861\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"5fldit2i7gaT1783511604861\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【活动「映夏！归乡？千灵节！」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"605ds7pmavqT1783659518752\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e的确都是保险定损过的货品，其中九成的失主都不再介意物品的去向，还有一成已经作古…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的古董甚至能在拍卖会上炒出高价…这个价格卖给市民们，称得上亏本的良心商家了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e无论在哪工作都差不多，还是这边好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"cd4cnx5l5gpT1783659528689\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【为什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e因为上班地点离城里的住处更近了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e之前我的工作和审判庭有关，常常需要沫芒宫和歌剧院两头跑。现在方便多了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e偶尔休假时去那边看看演出，见到以前工作过的地方，竟然感觉有些怀念。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidd