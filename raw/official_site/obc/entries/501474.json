al-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e放松时间\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"3rbkpvq5koeT1718549518572\":[\"mp9a5opigwfT1719505453302\"],\"4cf2vhylew3T1710863944349\":[\"ud67871scxhT1718549396702\"],\"8gfxrw8wla9T1710863939170\":[\"hqtgj3c9pzjT1718549325353\"],\"hqtgj3c9pzjT1718549325353\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"kbeyxctu05T1718548520525\":[\"ud67871scxhT1718549396702\"],\"mp9a5opigwfT1719505453302\":[],\"nqb471m7nmnT1710863941173\":[\"kbeyxctu05T1718548520525\"],\"nx53lcdq38iT1718549516470\":[\"mp9a5opigwfT1719505453302\"],\"oryh6686nhT1718549493004\":[\"nx53lcdq38iT1718549516470\",\"3rbkpvq5koeT1718549518572\"],\"ud67871scxhT1718549396702\":[\"oryh6686nhT1718549493004\"]},\"contents\":{\"3rbkpvq5koeT1718549518572\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见啦，明天又是美好的一天。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【白天】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"hqtgj3c9pzjT1718549325353\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e工作上的事情，无过就是功。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"kbeyxctu05T1718548520525\":{\"option\":\"【「劳逸结合」，我懂。】——获得晶螺糕*3\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e说得好，这句话可以当成座右铭了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e正好柯妮莉娅小姐刚刚拿了茶歇的点心来，请取一些走吧，不用客气。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7072\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/3baf4743643438c92db7483ba9d6c01b_1141222144263362308.png\\\" data-entry-name=\\\"晶螺糕\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/7072/detail?bbs_presentation_style=no_header\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/7072/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/11/04/24077343/3baf4743643438c92db7483ba9d6c01b_1141222144263362308.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e晶螺糕\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/76362111/b26706122e54335e75a99308e473cc62_6955119293794078794.png\"},\"mp9a5opigwfT1719505453302\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【一切都还好吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e托您的福，除了「自动盖章机」那边时不时有些响动，其他都不错。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e塞勒先生不在的时候，那个机器反而安静许多，像被主人拴在咖啡店前的小狗一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，就连最有精神的小动物也都知道适度休息才能保证第二天跑得更远，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nx53lcdq38iT1718549516470\":{\"option\":\"【晚上好。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚上好，旅行者。看你的样子，又是忙碌的一天？就像艾尤恩先生一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过你看起来比他开朗多了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他疲惫的原因在于太热情，这在年轻人身上很常见，需要一定的时间去调整。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我和瑟米安先生会看好他的，放心吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"oryh6686nhT1718549493004\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e年轻人来了之后白天总是那么热闹，更显得晚上清净了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ud67871scxhT1718549396702\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【夜晚】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1768875093","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"