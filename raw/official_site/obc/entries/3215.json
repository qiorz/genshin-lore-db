"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务开始位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/03/291696164/4ebd67efbf9ea9a47225c25678ac57dc_174783642058421967.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e〓路线攻略〓\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: left;\\\"\u003e具体路线攻略推荐：\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/12394872\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e【V2.3攻略】【北斗，五郎】邀约事件简明攻略【导图】\u003c/a\u003e 作者：\u003ca href=\\\"https://bbs.mihoyo.com/ys/accountCenter/postList?id=232866066\\\" data-type=\\\"a\\\" target=\\\"_blank\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"color:rgba(102,102,102,1)\\\"\u003eDramaturge\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd1 两个人的留影课\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/03/291696164/51b4df47be48b584976a827a46f09dce_8364666192350799552.png\\\" href=\\\"\\\" style=\\\"width:2048px;border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e久违的笑语打破了渔村的沉寂，无人的天地也似乎变得动听起来。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd2「妩媚」\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/03/291696164/7ff97fea780b50b37841f08c7febbe8b_8810312000134503947.png\\\" href=\\\"\\\" style=\\\"border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e「明明说好了摆个妩媚的姿势…」「和谁说好了！？」\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd3 当一切结束后\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003cimg src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/03/291696164/a34a31d8cb67665bf0d054486e9e4f0b_7481925637260330119.png\\\" href=\\\"\\\" style=\\\"border:none;vertical-align:middle;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cem\u003e\u003cspan style=\\\"color:rgba(140,140,140,1)\\\"\u003e北斗期待着与你在「船上」再见的那天。\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:19px\\\"\u003eEnd4 绯樱飘落归离处\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-heig