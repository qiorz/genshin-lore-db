/80663279/13c209a2d69a423eda20f9efee9d001a_3532520476403532604.png\\\" data-entry-name=\\\"眠龙之章 第一幕「兵戈梦去，春草如茵」\\\" data-entry-link=\\\"/ys/obc/content/4009/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/4009/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e眠龙之章 第一幕「兵戈梦去，春草如茵」\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【岩田】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e又失败了…你说，我下次应该尝试哪种种子比较好？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【平井】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这都第几次了，每次种下去的作物都活不了多久，你还不放弃吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e海祇岛的土壤向来不适合培育农作物，顶多长些萝卜，恐怕就连须弥的肥料也救不回来，我劝你还是放弃吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就算你因为旧伤的缘故不能再和我一起出海，也还可以做些别的工作嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【岩田】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不行，怎么能被这点困难打倒，我一定要找出可以在这里正常生长的农作物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e倒是你，怎么最近总在村里闲逛，不去出海打渔了吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【平井】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e打渔么，当然还是要去的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只是前些日子在出海时看到附近有陌生的船只，似乎是从外国来的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总觉得有些不安…看来出海的时候得多留意一下了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713881991","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_na