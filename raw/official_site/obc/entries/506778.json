"e9jx2znejn8T1772075463579\":[\"nhmpmbhmpdhT1759895645454\"],\"nhmpmbhmpdhT1759895645454\":[],\"nqb471m7nmnT1710863941173\":[\"9uy5gooaym8T1759895597544\"],\"z2tn3pzsbujT1710863943430\":[\"nhmpmbhmpdhT1759895645454\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这本之前看过吗…唔，想不起来了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"9uy5gooaym8T1759895597544\":{\"icon\":\"\",\"option\":\"【有什么推荐的书吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e推荐…抱歉，其实我不太知道好坏，也记不清书里的情节了。只是打发时间，没有很认真地看。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一定要说的话…那就《大盗雷德·米勒传奇》吧，老板说这本卖得最好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e既然卖得最好，如果它不是最烂的那本，应该就是还值得一看吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"e9jx2znejn8T1772075463579\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/02/26/80663279/cc2a44c2e85425afbbd461e49fe0875d_7052719187948200675.png\",\"option\":\"【决斗对局】——进行七圣召唤对局【牌手等级十级解锁】\",\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我输了，看来书里的情节果然不能当真呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯？我赢了？啊，谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nhmpmbhmpdhT1759895645454\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【你在看什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…书？我看不懂太难的书，就看些娱乐小说，故事情节精彩的那种。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过新书我已经看得差不多了，在想要不要找点老书看看。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【打扰了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯