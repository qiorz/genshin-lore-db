{"retcode":0,"message":"OK","data":{"page":{"id":"500566","name":"勒鲁瓦·行刑队","desc":"勒鲁瓦·行刑队","icon_url":"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/08/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_3502926638665642858.JPG","header_img_url":"","modules":[{"name":"勒鲁瓦·行刑队","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"moduleName\":\"\",\"layout_\":\"left\",\"list\":[{\"key\":\"触发条件\",\"value\":[\"完成枫丹世界任务「勒鲁瓦·回光返照」，游戏内时间次日自动接取\"]},{\"key\":\"等级限制\",\"value\":[\"无\"]},{\"key\":\"特殊限制\",\"value\":[\"无\"]}]}","style":""}],"id":"1367","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"500567\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/29/82503813/5f9af9d051379276e4fc7f76ed7d9bcb_7880490304982083589.png\\\" data-entry-name=\\\"勒鲁瓦·回光返照\\\" data-entry-link=\\\"/ys/obc/content/500567/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/500567/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e勒鲁瓦·回光返照\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1604\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/29/82503813/e9722fc9323ce2b1ceed605b5fa33e18_8177072614279102589.jpeg\\\" data-entry-name=\\\"伯努瓦·勒鲁瓦\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"