ut_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e与伯努瓦约定了今天见面…\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e与伯努瓦对话\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e清理门口\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e清理门口\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e清理门口\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"text-align: justify\\\"\u003e向伯努瓦回报\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":true}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"842\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/29/82503813/4e25967e554814606c97e11b51381beb_9146952948535912824.jpeg\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"150\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/29/82503813/4e25967e554814606c97e11b51381beb_9146952948535912824.jpeg\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*150\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5566\\\" data-entry