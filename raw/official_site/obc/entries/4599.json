1085739.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"商品列表","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1209","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【白天】\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e下次再有人找你换班，一定不能随便答应！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e好的，监察官大人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你们镀金旅团的人，就是在沙漠里闲散惯了，不懂得规矩的重要性！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e如果大家都随意调换岗位，不按照定好的计划办事，一定会造成疏漏！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e好的，您说的对。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e虽然你是教令院从外面雇来的佣兵，但你的工作也是维持港口秩序的一部分，和学者们一样十分重要，懂了吗！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e好的，我明白了。\u003c/p\u003e\u003chr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e夜晚 完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬前\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e】\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是不那么书呆子，是不是⋯嗝，以前上学时就能更受欢迎一点⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，也许吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是⋯嗝⋯能和你一样好脾气的话，是不是就能和大家搞好关系了⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，可能吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是说话做事更委婉⋯嗝！是不是早就能升职了⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，是的吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我这样碌碌无为，是不是辜负了树王大人留下的宝贵遗产⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯啊，不是的。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不能这样讲。您现在的工作也十分重要。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e真、真的吗⋯嗝⋯\u003c/p\u003e\u003chr\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e【\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e夜晚 完成魔神任务 第三章第五幕 虚空鼓动，劫火高扬后\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"font-size:22px\\\"\u003e】\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是不那么书呆子，是不是⋯嗝，以前上学时就能更受欢迎一点⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，也许吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是⋯嗝⋯能和你一样好脾气的话，是不是就能和大家搞好关系了⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，可能吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我要是说话做事更委婉⋯嗝！是不是早就能升职了⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯嗯，是的吧。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e你说，我这样碌碌无为，是不是辜负了小吉祥草王大人对须弥人的期待⋯\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e嗯⋯啊，不是的。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛塔莉】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e不能这样讲。您现在的工作也十分重要。\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e【玛希德】\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e真、真的吗⋯嗝⋯\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222612","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"