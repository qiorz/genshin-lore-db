 data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/25/82503813/2cfae2cc40ba43d03dd8e9346fb61a77_6455814707750784719.JPG\\\" data-entry-name=\\\"振晶，归来仍是振晶\\\" data-entry-link=\\\"/ys/obc/content/501261/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/501261/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"name\\\"\u003e振晶，归来仍是振晶\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【4.6版本活动「振晶的应用研究」期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【帕特里克】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e能赚钱的应用场景！我想到了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你看，只要把「应振晶」与控制灯亮暗的拉绳机关做个绑定，在远处激发「响振晶」就能关闭吊灯了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿纳托尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这个和「应振晶」协同的拉绳机关想必造价不菲吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【帕特里克】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e技术应用初期，成本总归还是高昂的，但是只要用的人更多，有更多的生产线，成本就会逐渐下降。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿纳托尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是…比起用你这个机关，直接把拉绳延长不是既便宜又有同样的效果？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【帕特里克】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那…那，下一个，把「应振晶」绑定在很容易丢失的物件上，只要触发「响振晶」，就能够找到那些不知道被丢在哪的物件。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿纳托尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好想法，但是如果我找不到「响振晶」了呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【帕特里克】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那就在「响振晶」上再绑个「应振晶」…还能赚双倍的钱，你真是个天才阿纳托尔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿纳托尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我是不是个天才，我不知道，但显然你离这个词还有点距离。唉，帕特里克，还是给点靠谱方案吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【帕特里克】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔…。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1715178111","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":