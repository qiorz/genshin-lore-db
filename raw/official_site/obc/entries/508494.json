an class=\\\"name\\\"\u003e空之神殿「地狱」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508442\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/04/14/83684823/f882538e388f6f8392d1b6c4e900da84_4763330454479442102.png\\\" data-entry-name=\\\"空之神殿「审判」\\\" data-entry-link=\\\"/ys/obc/content/508442/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508442/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e空之神殿「审判」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【说一说湮灭在后世的秘密吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那可太多了。你不问具体哪个我都想不起来说哪个好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不你有具体疑惑了再来问我吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e质量与能量的转化，局部宇宙规则的定义…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有什么事吗，旅行者？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"i20rsi47qbkT1777221274605\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\"},\"mbyl6pl2r9T1777221033208\":{\"option\":\"【再见，伊斯托利亚。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，我是字面意思的，永永远远在这里等你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【和我说说这里吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e此处是空之神殿。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e本意是神明为了保存消亡文明历史而建设的展览馆…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只是那位神明大人的姐妹们…似乎都很有自己的想法，什么东西有趣都会丢这里。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以你看到什么东西都不必奇怪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【说说你的时代吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我的时代？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e应该是我自己事后回忆都不敢想象的「尘世乐园」吧…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e从北方的亥珀波瑞亚，到南边的琅玕、德尔斐。还有这里，曾经的这里——阿卡狄亚…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你想问什么呢？我们吃什么，思考什么，创造什么？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我其实也想好好和你们细说，但是你们听完之后，大概也只会觉得我们每个人都是有智慧的孩童吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们吃和你们一样的东西，思考脱离现实的问题，因为现实的问题有祭司和天使们来解答。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们创造让我们自己开心的小破烂，因为无论如何也比不上天空赐予的技术。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种像是小孩子做一些让家长开心的事情一样。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有个叫博斯的家伙，听了我的描述，画了一幅《尘世乐园》。味道很对，味道很对。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"i20rsi47qbkT1777221274605\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"mbyl6pl2r9T1777221033208\"],\"i20rsi47qbkT1777221274605\":[],\"mbyl6pl2r9T1777221033208\":[\"i20rsi47qbkT1777221274605\"],\"nqb471m7nmnT1710863941173\":[\"i20rsi47qbkT1777221274605\"],\"z2tn3pzsbujT1710863943430\":[\"i20rsi47qbkT1777221274605\"]}}]