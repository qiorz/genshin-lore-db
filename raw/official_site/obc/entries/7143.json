le_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【爱丝蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…你家壁炉里的火，最近烧得挺旺吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥利弗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你家里的天平，最近也用得很勤吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【马尼特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我家火挺旺的，柴火足！天平咱用不上，买菜不缺那点斤两。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱丝蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你最好小心着点，要是火苗跳到了歌剧院的地毯上，那灭火的时候，恐怕就得连你家壁炉里的火一起灭了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥利弗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哟，这还真是不得了。但你怎么能保证，歌剧院能从火焰中幸存呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【马尼特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我寻思家里的火烧不到歌剧院，远着咧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥利弗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱丝蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以， 最近那些火苗还老实吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥利弗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，你猜？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱丝蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我才不猜，你老实交代。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【马尼特】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我猜老实得很，火苗能造到哪里去？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【奥利弗】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【爱丝蒂】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746594635","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n