r":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【西芒】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…事情按照原来的安排来吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【加希】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e指示如此，你接到的消息，应该和我是一样的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【西芒】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是的。你接到的命令是什么？我们再核对一下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【加希】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我不想惹麻烦，我们各自跟着指令走，做完之后就拿钱走人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【西芒】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…你的上头，是在海里，还是在地上？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【加希】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我说了，不要讨论额外的消息，我可不想被送去喂鱼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【西芒】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，说不定你的命令是把我送去喂鱼呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【加希】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果你不接着问下去，那么就不会是。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}},\"root_id\":\"8gfxrw8wla9T17108