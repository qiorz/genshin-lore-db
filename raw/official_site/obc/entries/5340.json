10062223040815.png\\\" data-entry-name=\\\"加入镀金旅团，拥抱美好生活！\\\" data-entry-link=\\\"/ys/obc/content/5016/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/5016/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e加入镀金旅团，拥抱美好生活！\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"felwjr8bqiwT1746548854712\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[\"felwjr8bqiwT1746548854712\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的？还有比佣兵更好的工作吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可惜了啊。等你回心转意了，再来找我吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有别的差事。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这位朋友请留步！一看你就身手不凡，有没有加入镀金旅团的打算？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"felwjr8bqiwT1746548854712\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e…除了我刚才说的那些以外，镀金旅团的伙食也是一绝哦！不信的话尝尝这个。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们旅团给同伴的待遇，无论从哪方面讲都没得挑。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4388\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/07/24077343/57d9c5482a414984898b7483423807e2_5633088460961994868.png\\\" data-entry-name=\\\"烤肉卷\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/4388/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/4388/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/10/07/24077343/57d9c5482a414984898b7483423807e2_5633088460961994868.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e烤肉卷\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【我考虑考虑。】——获得烤肉卷*3\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好强好强好强…这位朋友，像你这样的强者，在镀金旅团里肯定能找到更多对手，混得如鱼得水！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嚯，我只是侥幸占了上风！请你不要介意啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【冒险挑战】——进行七圣召唤对局\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e多得是！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e首先，加入镀金旅团可是为数不多可以走出村子的办法之一。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要出了这个荒芜的小地方，世界就摆在你面前。稍微有点追求的年轻人，哪个不想去外边见见世面呢？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且别看团里都是沙漠人，我们可是会从住树上的家伙手里赚钱的！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e教令院是全须弥钱包最鼓的地方，他们付酬金从不讲价，也不拖欠。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e只要你接过一次这样的委托，就能发大财。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这种赚钱的办法，你在别处可找不到的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么好处吗？】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762232656","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute