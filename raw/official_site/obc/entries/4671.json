f8e46ee89_5583068273563019302.png\\\" data-entry-name=\\\"加尔恰的赞歌·举手之劳\\\" data-entry-link=\\\"/ys/obc/content/6075/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6075/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e加尔恰的赞歌·举手之劳\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"00cnllt91lq1qT1746036307176\":[],\"0t05t3wbh0nT1746036455935\":[\"h6dbeuqflugT1746036552366\"],\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"fd0yxkfwlzoT1746036294467\",\"00cnllt91lq1qT1746036307176\",\"9uxjt5jc47eT1746036385897\",\"9nxtjse6cycT1746036454632\",\"0t05t3wbh0nT1746036455935\",\"luf74xnnh58T1746036500873\"],\"9nxtjse6cycT1746036454632\":[\"h6dbeuqflugT1746036552366\"],\"9uxjt5jc47eT1746036385897\":[],\"fd0yxkfwlzoT1746036294467\":[],\"h6dbeuqflugT1746036552366\":[],\"luf74xnnh58T1746036500873\":[],\"nqb471m7nmnT1710863941173\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"00cnllt91lq1qT1746036307176\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你是想问须弥出产矿石的地方？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e确实有一些，还有不少很难处理的「魔晶矿」，你可以去碰碰运气。地图给我…嗯，都标在上边了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/cc70592f615b485afe4437ec77de50a8_1559019465801733221.png\",\"option\":\"【关于须弥的矿产…】——有可标记地点【须弥声望二级解锁】\"},\"0t05t3wbh0nT1746036455935\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是专门为镀金旅团打造金属武器的铁匠，偶尔也为其他人做一些工具、饰品或家具之类的东西。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e须弥是崇尚草元素的地方，学者们不习惯佩戴武装，又信奉草神大人，似乎大多对金属兵器有些抵触。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e木刀木剑什么的，我也能做。但订单最多的，还是佣兵们需要的纹钢兵器。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】——完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」后\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e之前的委托已完成。还有吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/45b433a26de72a670e897bbcda70fa8f_6290773521740128470.png\",\"option\":\"【委托锻造…】——打开锻造界面【有未获取的已完成锻造物品】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有事请直说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"9nxtjse6cycT1746036454632\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是专门为镀金旅团打造金属武器的铁匠，偶尔也为其他人做一些工具、饰品或家具之类的东西。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e须弥是崇尚草元素的地方，学者们不习惯佩戴武装，又信奉树王大人，似乎大多对金属兵器有些抵触。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e木刀木剑什么的，我也能做。但订单最多的，还是佣兵们需要的纹钢兵器。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【你是…】——完成魔神任务第三章第五幕「虚空鼓动，劫火高扬」前\"},\"9uxjt5jc47eT1746036385897\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，目前没什么消息。你可以过段时间再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/cc70592f615b485afe4437ec77de50a8_2946917072330890237.png\",\"option\":\"【关于须弥的矿产…】——无可标记地点【须弥声望二级解锁】\"},\"fd0yxkfwlzoT1746036294467\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是你赢了，不得不说，你确实很厉害。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你很了不起，只是我更强。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/cc2a44c2e85425afbbd461e49fe0875d_156687964173556590.png\",\"option\":\"【冒险挑战】————进行七圣召唤对局【牌手八级解锁】\"},\"h6dbeuqflugT1746036552366\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那说明你对自己的身手很有自信。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过下雨最容易淋湿打伞的人，你最好也不要太大意了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e定期维护趁手的武器，才能随时应对危机。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1030\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/2e39a9f5b912ec7717a4f77182e8605b_4227205780581648845.png\\\" data-entry-name=\\\"精锻用魔矿\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/2e39a9f5b912ec7717a4f77182e8605b_4227205780581648845.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用魔矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/b26706122e54335e75a99308e473cc62_8221584077690969177.png\",\"option\":\"【我都不挑。】——获得精锻用魔矿*4\"},\"luf74xnnh58T1746036500873\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e纹钢兵器需要预定，现成的只有这些。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/11ee64c710e3b091256c0d349ac55461_1161499162837493702.png\",\"option\":\"【想买武器。】——打开商店界面\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/45b433a26de72a670e897bbcda70fa8f_4674618705983342898.png\",\"option\":\"【委托锻造…】——打开锻造界面【无已完成锻造物品】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"铁匠铺","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"264\\\" style=\\\"\\\"\u003e\u003cp\u003e【商品名称】\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e【商品种类】\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e价格【摩拉】\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"139\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u