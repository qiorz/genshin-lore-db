9170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"nb7ndtevk7iT1722352323626\":[],\"nqb471m7nmnT1710863941173\":[\"nb7ndtevk7iT1722352323626\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，我要是考上了一个的话，也不至于这么纠结了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e教令院有这么多学院，到底选哪个好啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nb7ndtevk7iT1722352323626\":{\"icon\":\"\",\"option\":\"【找人占卜看看。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，你可真会开玩笑！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…是开玩笑的对吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不管有多难选，这都是关系到我毕生职业规划的重要抉择。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果选错了，没准就会像阿莲佐一样退学，或者像胡塞尼那样一直毕不了业。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我可千万不要那样啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【你在烦恼什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，我正在为要去教令院的哪个学派进修发愁。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这次考核的成绩超出我想象的好，每个学派的要求都达标了。可是问题来了，学派有六个啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听说从阿弥利多学派毕业当医生赚的摩拉多，又有人说刹诃伐罗学派中的建筑方向就业形势好…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到底该选哪个呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"