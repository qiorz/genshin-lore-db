icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e···那姣好的面容被雨点打湿，她笑笑，觉得自己很幸运。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因为这样他就不会知道，自己是在哭了···\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jt47v4z9ivjT1719924432489\":{\"option\":\"【你看起来很累···】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎，连载小说真难写···\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我原本只是闲着没事，想打发打发时间，就写了一本恋爱小说，没想到大家都很喜欢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我当时也不懂，糊里糊涂签了个连载的合同。这下好了···每天都得熬夜写稿赶进度···\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哎，连载完这篇就不写了，我又不缺钱···\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【你在说什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦···我在构思小说的情节。编辑已经催了我两天，不能再拖下去了···\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"4cf2vhylew3T1710863944349\"],\"jt47v4z9ivjT1719924432489\":[],\"nqb471m7nmnT1710863941173\":[\"jt47v4z9ivjT1719924432489\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1719972480","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group