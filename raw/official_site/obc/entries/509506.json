ent_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【委托锻造…】——打开锻造界面【有未获取的已完成锻造物品】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e看看吧。不是我自夸，整个至冬堡，我的手艺是最好的！要来点别的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/13/178964736/45b433a26de72a670e897bbcda70fa8f_4777077690967030899.png\"},\"509untdepd6T1786623198446\":{\"option\":\"【有臻冰了，还需要打造武器？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，上次也有人跟我说这个，争论了半天，我拿起手边的铲子轻轻拍了他的脸…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可他呢？慌乱之下，半点臻冰都凝造不出来，最后闭上嘴灰溜溜滚了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…客人，要我说，防身的家伙，能立刻握在手里的才比较妥当啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…得精准控制炉温才行啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"gjb7fkrryqvT1786622864267\":{\"option\":\"【你在做什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我在看炉火的火候，得很仔细才行…细微的温度差别就会影响到锻材的强度。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而一把武器最后成败与否，就在这些细节上呀。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"jgbv82zu7fbT1786623411807\":{\"option\":\"【不打扰了，再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，有需要就来找我！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【想买些武器。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，那就尽管看看吧，客人，我保证都是些好宝贝！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/13/178964736/11ee64c710e3b091256c0d349ac55461_3646771183100421106.png\"},\"rdkb235dpejT1786623434846\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【队伍中包含阿罗夏时】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003c/p\u003e\u003cp\u003e【库兹米切夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e喔，阿罗夏，你来得正巧，上次你要我打造的捕猎夹已经做好了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢您，库兹米切夫先生，这些夹子我带走，这些请您修理一下吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【库兹米切夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e天哪，你到底是怎么把这些夹子弄坏的？我用的可是最好的材料。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e前几天，我遇见了一只难对付的合成魔兽，在追逐的过程中，我觉得我们彼此都在试图把对方带进陷阱，我不得不用尽了身上所有能用的东西…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【库兹米切夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e小子，你还活着，那么就是你赢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e仁慈的大自然放了我一马，而那个被愤怒冲昏头脑的魔兽则跌进了冰渊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【库兹米切夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e死透了？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我没看到。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【库兹米切夫】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哼，小子，把这些夹子放在这里，我会把它们修得更牢靠，说不定你和那头畜生还有一场仗要打。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等你再遇见了那畜生，就干掉它，我相信它逃不出你的手心。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿罗夏】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好的，如果真如您所说，那么我会把它最尖锐的牙齿送给您，库兹米切夫先生。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1030\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/2e39a9f5b912ec7717a4f77182e8605b_4227205780581648845.png\\\" data-entry-name=\\\"精锻用魔矿\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/1030/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/21/15568211/2e39a9f5b912ec7717a4f77182e8605b_4227205780581648845.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e精锻用魔矿\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*3\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【委托锻造…】——打开锻造界面【无已完成锻造物品】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好，跟我说说看，你想要什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/13/178964736/45b433a26de72a670e897bbcda70fa8f_508142848635138685