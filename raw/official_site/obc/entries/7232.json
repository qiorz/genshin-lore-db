"label\\\":\\\"4.7\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"4.8\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.0\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.1\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.2\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.3\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.4\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.5\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.6\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.7\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"5.8\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之一\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之二\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之三\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之四\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之五\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之六\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之七\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"月之八\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"7.0\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"7.1\\\",\\\"children\\\":[]}]}]\"},{\"type\":\"text\",\"attribute_name\":\"首页更多\",\"attribute_key\":\"home_more\",\"value\":\"https://baike.mihoyo.com/ys/obc/channel/map/189/43?bbs_presentation_style=no_header\"},{\"type\":\"text\",\"attribute_name\":\"在目录中展示\",\"attribute_key\":\"show_in_catalog\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"最新词条\",\"attribute_key\":\"is_latest\",\"value\":\"0\"},{\"type\":\"text\",\"attribute_name\":\"更多入口icon\",\"attribute_key\":\"king_kong_icon\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"首页更多文案\",\"attribute_key\":\"home_more_text\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"开放全量C端玩家可新建词条\",\"attribute_key\":\"open_for_create\",\"value\":\"0\"}]","updated_at":"-62135596800"}],"template_id":"6579ac2b66d84d942840e5be","ext":{"fe_ext":"{\"c_43\":{\"filter\":{\"text\":\"[\\\"任务类型/世界任务\\\",\\\"任务区域/枫丹\\\",\\\"版本号/4.0\\\"]\"}}}","post_ext":{"post_id":"","post_user_name":"","post_time":"0","post_avatar_url":"","url":""},"server_ext":"","perso