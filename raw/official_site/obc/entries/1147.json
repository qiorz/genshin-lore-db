ting":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e传说任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1437\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/03/25/80663279/ba8b2094f34e892c502015f2566dfdd5_8330547883113372789.png\\\" data-entry-name=\\\"仙麟之章 第一幕：云之海，人之海\\\" data-entry-link=\\\"/ys/obc/content/1437/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/1437/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e仙麟之章 第一幕：云之海，人之海\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e角色邀约：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"6269\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/03/14/5700838/540cbdfc0863929b93b09ad72ab4ead3_1568466514611463655.png\\\" data-entry-name=\\\"邀约事件·云堇 第一幕「弦歌知雅意」\\\" data-entry-link=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/6269/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e邀约事件·云堇 第一幕「弦歌知雅意」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，客官慢走，以后常来啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客官您好，欢迎光临「荣发商铺」，今日可是想买些什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"aoopww9iy7qT1746429876170\":{\"option\":\"【不好意思我还有事。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e也好，过去的事了，不提也罢…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…平平淡淡才是真啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【我想买些东西。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e来，这边请，您随便挑。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/661f4aed07b4e34115c0ea22f4b4b711_9127852716420931278.png\"},\"pac2ghn9e9bT1746429875214\":{\"option\":\"【请和我讲讲吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我曾是个冒险家，五湖四海哪里都闯荡过。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…可惜好景不长，有一次在荻花洲冒险时我遭遇了意外，身负重伤…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所幸，一位戴着面具的仙人出手相救，我这才勉强捡回了一条命。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e自那之后我就不再冒险了。这条命可以说是仙人赐给我的，可不能那么轻易就丢了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e璃月古语云「枯木发荣」，意为重获新生，这与我的经历一样…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e因此我就取了后两个字作为我的店名，来纪念我这段经历。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【这里是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不过是个卖日用品的小铺子…店名有些特殊，我是想纪念一下过去的经历。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e客官可有兴趣听一听这店名的来历？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"aoopww9iy7qT1746429876170\":[],\"nqb471m7nmnT1710863941173\":[],\"pac2ghn9e9bT1746429875214\":[],\"z2tn3pzsbujT1710863943430\":[\"pac2ghn9e9bT1746429875214\",\"aoopww9iy7qT1746429876170\"]}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1746430519","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_