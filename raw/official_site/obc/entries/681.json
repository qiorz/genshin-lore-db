w_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【关于「明星斋」…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我们「明星斋」是璃月的百年老字号珠宝行，百年指的是好几百年，不是一百年的意思哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「明星斋」可以说就像是珠宝界的岩王爷，从来没断过香火，自古独一家，呵呵。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不知客人有没有听人提过我们家「琉璃新月」？在年轻男女之间很受欢迎的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e都说只要买到每月限定十枚的超稀有的「琉璃新月」，就可以俘获心上人的心…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e感兴趣了吗？呵呵…不管这传说是不是真的，至少对我自己而言，如果有人愿意买来送我的话，我肯定是会心动的哦~?\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"685zt424h3bT1718552066591\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/288180982/4c5fca1105302971229747410ab9893e_2531991771567467363.png\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好怀念的音乐啊，我想到了小时候，我很早就要爬起来去老师家上书法课，那时天都还没有亮，我很害怕。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还好路上会经过一个老奶奶家，常常能听见屋子里传来这首曲子，我就会安心很多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在那个奶奶应该已经不在了，但我也已经长大，没那么怕黑了，哈哈…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说回正事，我认真考虑了，虽然我很想答应，但我们这老字号，临时找人看店多少有点困难。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e所以我给您推荐一个人吧——希古居的老板琳琅。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那家伙白天都不开张，不是在睡大觉就是在闲逛，时间充裕得很，我想她应该能帮上您。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e论如何，还是很感谢您，让我又听见了这首曲子。希望您的音乐节一切顺利！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e珠宝行老字号「明星斋」，虽然目前珠宝只接受预订…但还有一些其他的货品在售。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"kzwg11g93zmT1718552032114\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【荒泷生命摇滚虹色大巡回期间】\u003c/strong\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/288180982/a0688e82c2c53cce368e3c470e9e64ac_2237624364652900453.png\",\"option\":\"【有什么在卖？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一些珠宝外的小生意，你是旅行者吗？可能对你有帮助哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"qw31qvfjvjT1718552068321\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\"},\"wi6d5n67bhT1718551905888\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e等珠宝的存货充足，会跟熟客打招呼的，慢走哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【珠宝只接受预定？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是啊，真是不好意思。本来我们「明星斋」就经常缺货…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e客人您也知道的，璃月的琉璃享誉天下，只有璃月的特殊砂土才能烧制得出。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e更何况…有些不谦虚地讲，「明星斋」一直是这行当的翘楚，许多富商不远万里过来，就是为了买一块我们的「琉璃新月」…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可谁知道最近「层岩巨渊」的矿坑居然被封，原材料的供应一下子就断了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e店里如您所见，只剩一些存货了。原则上只供展示，硬要说价格的话…还是算了，一定是您听了不会开心的数字…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"kzwg11g93zmT1718552032114\"],\"685zt424h3bT1718552066591\":[\"qw31qvfjvjT1718552068321\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"wi6d5n67bhT1718551905888\"],\"kzwg11g93zmT1718552032114\":[\"685zt424h3bT1718552066591\"],\"nqb471m7nmnT1710863941173\":[\"kzwg11g93zmT1718552032114\"],\"qw31qv