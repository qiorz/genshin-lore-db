o=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/01/28/288180982/fb135c066f010ed1e0c4646d00c39295_8329287527371527906.png\\\" data-entry-name=\\\"塞琉斯\\\" data-entry-link=\\\"/ys/obc/content/1194/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1194/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2023/01/28/288180982/fb135c066f010ed1e0c4646d00c39295_8329287527371527906.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e塞琉斯\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e蒙德城（白天）\u003c/p\u003e\u003cp\u003e天使的馈赠（夜晚）\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]}]}\n","style":""}],"id":"1368","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e虽然在风暴之中，冒险家协会的塞琉斯先生却正在摩拳擦掌…\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e（接取该任务后将不能接取「孤身犯险」）\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e➢寻找杰克的踪迹\u003c/p\u003e\u003cp\u003e➢解救被围困的杰克\u003c/p\u003e\u003cp\u003e➢与杰克对话\u003c/p\u003e\u003cp\u003e➢清理营地\u003c/p\u003e\u003cp\u003e➢与塞琉斯对话\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1369","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5555159106525158234.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"100\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5555159106525158234.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*100\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/f8bacc007a6b264469a5e2b9c142b493_8319919776048507791.png\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"6000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/f8bacc007a6b264469a5e2b9c142b493_8319919776048507791.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*6000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1024\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/d4706b85cf3d6181509b62630078eecf_1685304396091176622.png\\\" data-entry-name=\\\"冒险家的经验\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/d4706b85cf3d6181509b62630078eecf_1685304396091176622.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的经验\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"96\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/60154473aa26756917b883e66a53d3ba_6548691550069173883.png\\\" data-entry-name=\\\"提瓦特煎蛋\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/96/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/96/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/60154473aa26756917b883e66a53d3ba_6548691550069173883.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e提瓦特煎蛋\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务触发点\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/27a06f0e454add4514fa650465b47d58_4322938382524443935.png\"},{\"tab_name\":\"任务结束点\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/27a06f0e454add4514fa650465b47d58_6503788041393390812.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e塞琉斯：可恶⋯要是能再多点人的话⋯\u003c/p\u003e\u003cp\u003e旅行者：怎么了？\u003c/p\u003e\u003cp\u003e塞琉斯：旅行者？你来得正好，风魔龙在蒙德城里掀起的风暴，你也看见了。\u003c/p\u003e\u003cp\u003e塞琉斯：西风骑士团已经全员出动，我们冒险家协会当然也不能袖手旁观。是时候让人们感受冒险家协会的力量了!\u003c/p\u003e\u003cp\u003e塞琉斯：骑士团负责蒙德城内，而城外那些蠢蠢欲动的魔物，就是我们冒险家协会的专长部分。\u003c/p\u003e\u003cp\u003e塞琉斯：协会里经验丰富的冒险家们都已经出发去各处调查，但是⋯我唯一担心的就是杰克。\u003c/p\u003e\u003cp\u003e塞琉斯：杰克自告奋勇，要去千风神殿附近调查，但是到现在他也没有传回消息。\u003c/p\u003e\u003cp\u003e塞琉斯：这小子虽然勇气值得肯定，但经验着实不足，有时候又太过鲁莽，我担心他会出什么事。\u003c/p\u003e\u003cp\u003e塞琉斯：旅行者，如果你愿意的话，能帮我去千风神殿附近找找杰克吗？\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e没问题。/还有别的事⋯\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“没问题。”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：太好了，我必须留在协会里指挥，不然我就自己去找杰克了。\u003c/p\u003e\u003cp\u003e塞琉斯：拜托你了，冒险家协会绝对不能再失去任何一位年轻人了。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“还有别的事⋯”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e（放弃任务）\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢寻找杰克的踪迹\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢解救被围困的杰克\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢与杰克对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e杰克：嘶，疼⋯\u003c/p\u003e\u003cp\u003e杰克：谢谢你，我还以为自己回不去了。\u003c/p\u003e\u003cp\u003e旅行者：你怎么样？\u003c/p\u003e\u003cp\u003e杰克：哈，一点小伤⋯呃！一点⋯小伤，我没问题。\u003c/p\u003e\u003cp\u003e杰克：我是因为发现一群丘丘人正在向前面的营地里集结，觉得它们想要做什么，才跟了上去。\u003c/p\u003e\u003cp\u003e杰克：⋯但我跟踪调查的时候靠得太近，不小心就被它们发现了。\u003c/p\u003e\u003cp\u003e杰克：不说这个了，不用担心我，请快点去把前面的丘丘人都清理掉！\u003c/p\u003e\u003cp\u003e杰克：它们的数量越来越多，绝不能让它们的阴谋得逞。\u003c/p\u003e\u003cp\u003e杰克：至于我⋯我会照顾好我自己的。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢清理营地\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e（清理完成后杰克会回到塞琉斯附近，此时对话触发以下内容）\u003c/p\u003e\u003cp\u003e杰克：你已经清理掉那个营地了吧。\u003c/p\u003e\u003cp\u003e旅行者：是的。\u003c/p\u003e\u003cp\u003e杰克：你的实力可真强啊，要是我能像你一样优秀就好了⋯\u003c/p\u003e\u003cp\u003e杰克：我也想留下斩杀恶龙、拯救世界的传说，但到头来连丘丘人都没法胜过⋯\u003c/p\u003e\u003cp\u003e杰克：呃，那个⋯虽然很不好意思，但是我有件事拜托你⋯\u003c/p\u003e\u003cp\u003e杰克：其实我这次之所以会去千风神殿调查，是因为我马上就要「冒险等阶评定」了⋯\u003c/p\u003e\u003cp\u003e杰克：我想着如果能在这个时候展现出实力的话，等阶评定一定会顺利不少。\u003c/p\u003e\u003cp\u003e杰克：但是没想到，实力没展现出来，反而差点把自己给赔进去。\u003c/p\u003e\u003cp\u003e杰克：能，能拜托你，别把我的惨样告诉塞琉斯先生吗？要是真的影响到「冒险等阶评定」，那我就真的惨了⋯\u003c/p\u003e\u003cp\u003e旅行者：我知道了⋯/这样不好。\u003c/p\u003e\u003cp\u003e选择“我知道了⋯”\u003c/p\u003e\u003cp\u003e杰克：太谢谢你了！我以后一定不会再这么鲁莽了！\u003c/p\u003e\u003cp\u003e选择“这样不好。”\u003c/p\u003e\u003cp\u003e杰克：我知道这样不好，塞琉斯先生也说「冒险家应该直面自己」⋯\u003c/p\u003e\u003cp\u003e杰克：但是⋯唉，算了，希望塞琉斯先生不会太生我的气⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(217, 217, 217); color: inherit\\\"\u003e【当前场景对话】\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(217, 217, 217); color: inherit\\\"\u003e杰克 : 唉，希望我的「冒险等阶评定」不会受到影响…\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢与塞琉斯对话\u003c/strong\u003e\u003c/p\u003e\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp\u003e在与塞琉斯对话前\u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e没有与杰克进行对话\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp\u003e在与塞琉斯对话前\u003cspan style=\\\"color: rgb(245, 34, 45)\\\"\u003e与杰克进行过对话\u003c/span\u003e\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp\u003e塞琉斯：你回来了，杰克也回来了，但是一瘸一拐的⋯\u003c/p\u003e\u003cp\u003e塞琉斯：到底发生什么了？\u003c/p\u003e\u003cp\u003e旅行者：杰克因为冒进受伤了⋯\u003c/p\u003e\u003cp\u003e塞琉斯：果然和我想的一样，唉⋯平时我和他说的话，他都没怎么记得。\u003c/p\u003e\u003cp\u003e塞琉斯：虽然我也理解他想要证明自己的心思，但是⋯\u003c/p\u003e\u003cp\u003e塞琉斯：算了，这件事我已经了解了，杰克那边我会去和他谈谈。\u003c/p\u003e\u003cp\u003e塞琉斯：这是给你的，算是你冒险的奖励吧。\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp\u003e塞琉斯：你回来了，杰克也回来了，但是一瘸一拐的。\u003c/p\u003e\u003cp\u003e塞琉斯：到底发生什么了？\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e杰克战斗时很英勇。/杰克因为冒进受伤了⋯\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“杰克战斗时很英勇。”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：你和他并肩作战了吗？原来他是这么受伤的⋯\u003c/p\u003e\u003cp\u003e塞琉斯：唉，英勇是好事⋯但我宁愿他更加稳重一些，毕竟，活下来的冒险家才是冒险家。\u003c/p\u003e\u003cp\u003e塞琉斯：旅行者，你和杰克的勇气都值得嘉奖，这些东西你拿着，算是你冒险的奖励吧。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“杰克因为冒进受伤了⋯”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e塞琉斯：果然和我想的一样，唉⋯平时我和他说的话，他都没怎么记得。\u003c/p\u003e\u003cp\u003e塞琉斯：虽然我也理解他想要证明自己的心思，但是⋯\u003c/p\u003e\u003cp\u003e塞琉斯：算了，这件事我已经了解了，杰克那边我会去和他谈谈。\u003c/p\u003e\u003cp\u003e塞琉斯：这是给你的，算是你冒险的奖励吧。\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略推荐","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003ca href=\\\"https://bbs.mihoyo.com/ys/article/1982904\\\" target=\\\"_blank\\\"\u003ehttps://bbs.mihoyo.com/ys/article/1982904\u003c/a\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"孤身犯险","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"list\":[{\"key\":\"触发条件\",\"value\":[\"在蒙德城内与杰克对话\"]},{\"key\":\"等级限制\",\"value\":[\"无\"]},{\"key\":\"特殊限制\",\"value\":[\"完成魔神任务【序章 第一幕「捕风的异乡人」】后\"]}]}","style":""}],"id":"2848","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1367","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1195\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/c99bc8168a0156b01badded5a02e331d_6503788041393390812.png\\\" data-entry-name=\\\"杰克\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/1195/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1195/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/c99bc8168a0156b01badded5a02e331d_6503788041393390812.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e杰克\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e蒙德城（白天）\u003c/p\u003e\u003cp\u003e天使的馈赠（夜晚）\u003c/p\u003e\"]},{\"key\":\"结束NPC\",\"value\":[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1195\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/c99bc8168a0156b01badded5a02e331d_6503788041393390812.png\\\" data-entry-name=\\\"杰克\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/1195/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1195/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/10/08/16576950/c99bc8168a0156b01badded5a02e331d_6503788041393390812.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e杰克\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e蒙德城（白天）\u003c/p\u003e\u003cp\u003e天使的馈赠（夜晚）\u003c/p\u003e\"]},{\"key\":\"后续任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]}]}\n","style":""}],"id":"2847","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1368","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e在千风神殿监视魔物动向时，杰克因为太过鲁莽而被魔物发现并围攻。虽然杰克勉强逃回了蒙德城，但他身上的一些东西却遗失在了千风神殿里⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e➢前往千风神殿搜索杰克的遗失物品（2/2）\u003c/p\u003e\u003cp\u003e➢向杰克回报\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2846","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1369","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务奖励","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5555159106525158234.png\\\" data-entry-name=\\\"冒险阅历\\\" data-entry-amount=\\\"100\\\" data-entry-link=\\\"无\\\"\u003e\u003ca href=\\\"%E6%97%A0\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/6ee632dc08f8146408597e4b9001fa98_5555159106525158234.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险阅历\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*100\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/f8bacc007a6b264469a5e2b9c142b493_8319919776048507791.png\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"6000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/f8bacc007a6b264469a5e2b9c142b493_8319919776048507791.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*6000\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1024\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/d4706b85cf3d6181509b62630078eecf_1685304396091176622.png\\\" data-entry-name=\\\"冒险家的经验\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/1024/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/d4706b85cf3d6181509b62630078eecf_1685304396091176622.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的经验\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"96\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/60154473aa26756917b883e66a53d3ba_6548691550069173883.png\\\" data-entry-name=\\\"提瓦特煎蛋\\\" data-entry-amount=\\\"5\\\" data-entry-link=\\\"/ys/obc/content/96/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/96/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2023/12/23/78524498/60154473aa26756917b883e66a53d3ba_6548691550069173883.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e提瓦特煎蛋\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2845","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1370","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务触发点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/04/317305234/27a06f0e454add4514fa650465b47d58_3141306664108978244.png\"},{\"tab_name\":\"任务结束点\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/01/04/317305234/27a06f0e454add4514fa650465b47d58_9108764792627397096.png\"}]}\n","style":""}],"id":"2844","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1371","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e杰克：这下糟了⋯这下糟了⋯\u003c/p\u003e\u003cp\u003e旅行者：怎么了？\u003c/p\u003e\u003cp\u003e杰克：你是⋯旅行者吧。唉，城里的那股风暴你应该也看见了，整个蒙德城都被搞得一团糟。\u003c/p\u003e\u003cp\u003e杰克：塞琉斯先生说，为了防止野外的魔物趁机发动攻击什的，就发布了委托，让冒险家们去监视魔物的动向。\u003c/p\u003e\u003cp\u003e杰克：我接下的委托是监视千风神殿附近的魔物，确认好了之后，我就出发了。\u003c/p\u003e\u003cp\u003e杰克：在千风神殿那里，我看见了一大群聚集在一起的魔物，我就想要靠近看看⋯\u003c/p\u003e\u003cp\u003e杰克：结果没想到，我刚走近了一点就被那群魔物发现了，要不是一位路过的冒险家搭救，我说不定就回不来了。\u003c/p\u003e\u003cp\u003e杰克：因为担心还有更多魔物攻击，我们俩马上就离开了千风神殿，回到了蒙德城。\u003c/p\u003e\u003cp\u003e杰克：回来了之后，我发现⋯我的地图和冒险之证都掉在了千风神殿里。\u003c/p\u003e\u003cp\u003e杰克：但是我这个样子，也没办法再去千风神殿找东西⋯\u003c/p\u003e\u003cp\u003e杰克：旅行者，你愿意帮我个忙，去千风神殿把我的地图和冒险之证带回来吗？\u003c/p\u003e\u003cp\u003e旅行者：\u003cstrong\u003e\u003cu\u003e交给我吧。/为什么要去千风神殿⋯\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“交给我吧。\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e杰克：那就拜托你了，唉⋯实在是不好意思⋯\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e选择“为什么要去千风神殿⋯”\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e杰克：呃，说出来有点不好意思，你知道「冒险等阶评定」吗？\u003c/p\u003e\u003cp\u003e杰克：我想，要是我能多表现一下自己，也许能更顺利地通过评定⋯\u003c/p\u003e\u003cp\u003e杰克：但是没想到...唉，请你帮我把地图和冒险之证拿回来吧。\u003c/p\u003e\u003cp\u003e杰克：我以后还是得再谨慎一点才行⋯\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢前往千风神殿搜索杰克的遗失物品（2/2）\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(217, 217, 217); color: inherit\\\"\u003e【当前场景对话】\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(217, 217, 217); color: inherit\\\"\u003e杰克：我以后还是得再谨慎一点才行⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003cmark style=\\\"background-color: rgb(217, 217, 217); color: inherit\\\"\u003e杰克：但是太谨慎的话⋯唉⋯\u003c/mark\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e➢向杰克回报\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e杰克：那些东西，你都找到了吗\u003c/p\u003e\u003cp\u003e旅行者：找到了⋯\u003c/p\u003e\u003cp\u003e杰克：太好了，这份地图我一直在用，上面还有很多我做的标记，弄丢了可麻烦了。\u003c/p\u003e\u003cp\u003e杰克：而且，要是我连冒险之证都弄丢了，我可没脸去找凯瑟琳小姐再要一份。\u003c/p\u003e\u003cp\u003e杰克：冒险家在冒险的途中，弄丢了冒险之证⋯这不纯粹是个笑话了吗⋯\u003c/p\u003e\u003cp\u003e杰克：谢谢你，我会把这些东西都收好的，这是谢礼，请收下吧。\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2843","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"1372","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"2842","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"1373","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1704334501","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"天赐良机？","repeated":true,"parent_group_id":"0"},{"module_group_id":"1200","layout