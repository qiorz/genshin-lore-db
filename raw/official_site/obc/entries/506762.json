"3r1sk02v505T1764733838258\":[\"hy0zxq94qgkT1764733952538\"],\"4cf2vhylew3T1710863944349\":[\"hy0zxq94qgkT1764733952538\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"3r1sk02v505T1764733838258\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"hy0zxq94qgkT1764733952538\":[],\"nqb471m7nmnT1710863941173\":[\"hy0zxq94qgkT1764733952538\"],\"z2tn3pzsbujT1710863943430\":[\"hy0zxq94qgkT1764733952538\"]},\"contents\":{\"3r1sk02v505T1764733838258\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/03/80663279/ead302bf7db83ccaefbafca7162a8b8c_8066934339039736899.png\",\"option\":\"【（雅珂达似乎有所思考…）】\",\"dialogue\":\"\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e雷科先生，上次老板在您这边订的那几颗宝石，您找到货了么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雷科】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e雅珂达小姐请放心，我已经找到了可靠的供货商，只要宝石运到，马上送到「秘闻馆」里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雅珂达】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那就麻烦您了，等宝石到了，我会过来帮忙护送的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（一定不能出事，一定不能出事，不然奈姐肯定又要我跑腿…）\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e（等宝石运到，奈姐肯定心情超好，到时候请假肯定也轻轻松松啦。）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【雷科】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e喔…那样最好，那到时候就麻烦雅珂达小姐了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【下次再来。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走不送。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e海上珍奇，秘境藏宝，瞧一瞧看一看咯。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"hy0zxq94qgkT1764733952538\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/10/05/80663279/11ee64c710e3b091256c0d349ac55461_2114241295919960498.png\",\"option\":\"【你这儿卖什么？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e随意挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"wiuii35g5dT1759651866334\":{\"icon\":\"\",\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【关于这些货品…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e问这个可就不地道了，具体的渠道当然不能跟你细说。不过嘛…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e你知道吗，在刻拉蒂之眼附近沉没的阿特拉号，这些年过去了，还有不少宝物沉在海底呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e据说那些宝物之中，就有大盗雷德·米勒留下的「识者之证」。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e贩售「海中珍宝」的行商\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说到底也就是打捞沉船的二道贩子\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e售价倒是合算，可惜买不到真正值钱的物件\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e雅珂达：（听说奈姐之前在他这边订了几枚宝石，拜托你，一定要把这些宝石安安稳稳送到奈姐手上啊，不然我又要跑腿了…）\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1764739250","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1