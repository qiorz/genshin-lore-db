alse,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"71kuceursdT1787046842274\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"eyqrmmzjg7T1787046841307\":[\"zfxn6n06x8rT1787047047767\"],\"m2zn9cqjb4T1787047094587\":[],\"nqb471m7nmnT1710863941173\":[\"xl22fh5f27T1787046840627\",\"eyqrmmzjg7T1787046841307\",\"71kuceursdT1787046842274\"],\"xl22fh5f27T1787046840627\":[],\"zfxn6n06x8rT1787047047767\":[\"m2zn9cqjb4T1787047094587\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"71kuceursdT1787046842274\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，祝您今天愉快。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"\",\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成「雪后曙光」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"eyqrmmzjg7T1787046841307\":{\"option\":\"【充实心灵的手段是…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有很多。例如看书、听音乐…或者是单纯的沉思，和自我进行一场平静的对话…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但值得一提的是，我认为「挥霍金钱」和「索求财富」这一行为绝不在此列。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无度的奢靡花销不会让我们的心灵得到满足，与之相反，在奢靡过后，我们的心灵反而会被空虚填满。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而索求财富嘛…哈哈哈哈哈，过于鼓鼓囊囊的钱袋，有时候会挤占我们心灵的位置，让真正的自我无处容身啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像我们亲爱的克尼亚泽夫，他的人生曾经被这二者完全占据，如今…呵…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"m2zn9cqjb4T1787047094587\":{\"option\":\"【那…你准备教他什么？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我现在不打算教他。过几天，我准备送他几本书——当然，不是他最想看，最想学习效仿的商业巨著，而是几本小说。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在那几本小说里，有人走上了自愿选择的歧途，有人与自己的兄弟刀剑相向，还有人悲天悯人，最后却发现自己无人能救…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e亲爱的克尼亚泽夫，年轻的克尼亚泽夫。看看他们吧，再去寻找到自己。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…相信我，人这一生最重要的，就是寻找到真正的自己。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e亲爱的朋友，记得时刻充实你的心灵。啊，如果有必要的话，也可以充实一下行囊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"xl22fh5f27T1787046840627\":{\"option\":\"【你这里卖什么？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请看这边，我的货物任您挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/18/178964736/661f4aed07b4e34115c0ea22f4b4b711_6098969547688282241.png\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zfxn6n06x8rT1787047047767\":{\"option\":\"【等等，你认识他？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e只在很久之前的宴会上见过几面，当时他斗志昂扬，骄傲自信，仿佛即将登临世界的王座。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而现在，他心灰意冷，垂头丧气，好像被弃之如敝履…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但谁又能知道，跌入谷底的鹰隼，会不会再度乘风飞起，翱翔天际？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e克尼亚泽夫的父亲托我照顾他，并且叮嘱我，等到他的儿子再次鼓起勇气，就由我做他的老师，教他如何在商场里与狡诈的蛇博弈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但是，我的朋友…我年轻的克尼亚泽夫，我不愿让你空荡荡的心被锱铢必较的算计完全占据，在那之前，它理应容纳更加美好的东西。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\"