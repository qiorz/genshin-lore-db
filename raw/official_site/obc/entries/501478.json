003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e120\u003c/p\u003e\u003c/td\u003e\u003ctd colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e100（每天）\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"list\":[],\"author\":\"\",\"created_at\":\"\"}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"0fkuqevmf327T1718730966991\":{\"option\":\"【这么严重…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉，水涨得快退得也快，虽然现在看上去水位下去了，但谁知道还会不会再来一次。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"4cf2vhylew3T1710863944349\":{\"option\":\"【最近镇上还好吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e稳步向好，大部分镇上的居民已经基本恢复原本的生活了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e多谢您的关心。若您再见到老板的话，也请多关照下她吧。她…实在是经历了太多事情了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6budckentgaT1718730157869\":{\"option\":\"【先不用了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"6mo6hleu4owT1718730155534\":{\"option\":\"【这里是…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎来到白淞镇，一个渔民们生活的小地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e风景大概比不上城里那么华贵，但镇上的居民过得都很悠闲。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e对了，这里地形不太好走，路面很滑。如果客人是来旅游的，还请小小脚下。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我这的鱼种类齐全，客人需要哪种？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"b13ef21eu8qT1718730483962\":{\"option\":\"【情况如何？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e老板说「预言」中的危机已经过去，所以镇上回来了不少人。大家一起忙活，重建的进度快了不少。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过总归还是有些混乱，人们不注意的话难免摔倒受伤。所以我在此处警戒，防止镇外的人误入这里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"elizg52foivT1718730517650\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成娜维娅传说任务野蔷薇之章 第一幕「共渡潮落」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"g2a7t8xmiqcT1718730719400\":{\"option\":\"【附近有什么值得留意的吗？】——有可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有位好心的客人告诉我，附近有出产萃凝晶和魔晶矿的地方，问我需不需要取一些来加固渔船。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我暂时用不到，放着也是可惜。您若是感兴趣的话，可以去这附近转转。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/19/288180982/cc70592f615b485afe4437ec77de50a8_7486739328980708943.png\"},\"g64x7zy1g8oT1718531686790\":{\"option\":\"【回见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，多谢您的关照。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"hic97pxcuvcT1718730389084\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【魔神任务第四章 第五幕「罪人舞步旋」期间 完成「怒涛之灾」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"hiq52k0avllT1718730070073\":{\"option\":\"【看看鱼。】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/19/288180982/11ee64c710e3b091256c0d349ac55461_1823713428570189321.png\"},\"ix86tfhv2uiT1718730146243\":{\"option\":\"【附近有什么值得留意的吗？】——有可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有位好心的客人告诉我，附近有出产萃凝晶和魔晶矿的地方，问我需不需要取一些来加固渔船。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我暂时用不到，放着也是可惜。您若是感兴趣的话，可以去这附近转转。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/19/288180982/cc70592f615b485afe4437ec77de50a8_2341916658736193231.png\"},\"jrrn7r6c9gT1718730968345\":{\"option\":\"【你多小心。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，我会的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过这里还离不开人，总得有人留在这里警戒，不能让无关人员误入这里再次遇难了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"kzdj9qzpwvpT1718730485128\":{\"option\":\"【没关系，我来看看。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那您多留意脚下，注意不要受伤哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【可以买鱼吗？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没想到您真是来买鱼的，请随意挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/76362111/11ee64c710e3b091256c0d349ac55461_3485945699863100721.png\"},\"prrxqrwjyxT1718730077556\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这不是老板的朋友吗，欢迎。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"silb0apzzrT1718730463377\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，这不是老板的朋友吗，欢迎。不过白淞镇现在的环境还不太好，可能要怠慢您了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"sjcj14pyfq8T1718730597862\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\"},\"v4kki9v1gvT1718730147757\":{\"option\":\"【附近有什么值得留意的吗？】——无可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，我忙着打理鱼摊，没怎么注意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/19/288180982/cc70592f615b485afe4437ec77de50a8_4093571714173625494.png\"},\"wimeav9disiT1718730970083\":{\"option\":\"\",\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务第四章 第五幕「罪人舞步旋」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【附近有什么值得留意的吗？】——无可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，我忙着打理鱼摊，没怎么注意。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/06/16/76362111/cc70592f615b485afe4437ec77de50a8_301178644985319363.png\"},\"zh1ytbzd6aaT1718730953565\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这不是老板的朋友吗。最近白淞镇的环境不太好，我知道您不是本地人，但还是不建议您久留啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"0fkuqevmf327T1718730966991\":[\"wimeav9disiT1718730970083\"],\"4cf2vhylew3T1710863944349\":[\"sjcj14pyfq8T1718730597862\"],\"6budckentgaT1718730157869\":[\"hic97pxcuvcT1718730389084\"],\"6mo6hleu4owT1718730155534\":[\"hic97pxcuvcT1718730389084\"],\"8gfxrw8wla9T1710863939170\":[\"hiq52k0avllT1718730070073\",\"ix86tfhv2uiT1718730146243\",\"v4kki9v1gvT1718730147757\",\"6mo6hleu4owT1718730155534\",\"6budckentgaT1718730157869\"],\"b13ef21eu8qT1718730483962\":[\"elizg52foivT1718730517650\"],\"elizg52foivT1718730517650\":[\"prrxqrwjyxT1718730077556\"],\"g2a7t8xmiqcT1718730719400\":[\"sjcj14pyfq8T1718730597862\"],\"g64x7zy1g8oT1718531686790\":[\"sjcj14pyfq8T1718730597862\"],\"hic97pxcuvcT1718730389084\":[\"zh1ytbzd6aaT1718730953565\"],\"hiq52k0avllT1718730070073\":[\"hic97pxcuvcT1718730389084\"],\"ix86tfhv2uiT1718730146243\":[\"hic97pxcuvcT1718730389084\"],\"jrrn7r6c9gT1718730968345\":[\"wimeav9disiT1718730970083\"],\"kzdj9qzpwvpT1718730485128\":[\"elizg52foivT1718730517650\"],\"nqb471m7nmnT1710863941173\":[\"sjcj14pyfq8T1718730597862\"],\"prrxqrwjyxT1718730077556\":[\"nqb471m7nmnT1710863941173\",\"g2a7t8xmiqcT1718730719400\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"g64x7zy1g8oT1718531686790\"],\"silb0apzzrT1718730463377\":[\"b13ef21eu8qT1718730483962\",\"kzdj9qzpwvpT1718730485128\"],\"sjcj14pyfq8T1718730597862\":[],\"v4kki9v1gvT1718730147757\":[\"hic97pxcuvcT1718730389084\"],\"wimeav9disiT1718730970083\":[\"silb0apzzrT1718730463377\"],\"z2tn3pzsbujT1710863943430\":[\"sjcj14pyfq8T1718730597862\"],\"zh1ytbzd6aaT1718730953565\":[\"0fkuqevmf327T1718730966991\",\"jrrn7r6c9gT1718730968345\"]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1774428168","langs"