\u003e\u003cli\u003e\u003cp\u003e阿如村的土地种不出什么作物，大部分的物资只能靠外部提供。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总是等人送东西进来太被动了，所以我就摆了这么个铺子。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哦对了，明人不说暗话，我先提醒下，这里东西的售价会比城里高一些哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没办法，只能单程运货，运输成本太高了，我已经尽力压低价格了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过不一定非要付摩拉，大家来我这里以物易物也是可以的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，有什么需要的？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"n4vol4sesmnT1746448002892\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e在小地方生活就要靠大家互帮互助嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有时还会有村民把不用的东西寄放在我这，等需要的人来把它们拿走。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e而且这对我的生意也有帮助。毕竟很少有人能路过摊位而不看上两眼的，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是个好办法。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请随意挑选。不过提前说下，用摩拉支付的话，价格会比城里高一些哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/11ee64c710e3b091256c0d349ac55461_358465786348408822.png\",\"option\":\"【有什么卖的？】——打开商店界面\"},\"t1g3obgsulT1746448004253\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是呀，这附近除了沙子还是沙子，根本没什么东西可以拉到城里去卖的，所以也没什么利润可言。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说来，之前我有一次进货时遇到沙暴迷了路，在沙漠深处的土地上遇到了一些学者打扮的人。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他们分给了我一些食物，又告诉了我怎么回阿如村，但是却不愿意向我透露他们的身份。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不要再进沙漠一次，找一找那些人呢？我听说学者都比较富裕，如果能赚到他们的钱就好了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这样一来，货物的售价也能降下一些，村里人的日子也会好过一点吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【运输成本？】\"},\"x4qes15qq4bT1746447988588\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e慢走，下次再来哦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【暂时没有。】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e惊人的牌技！没想到这么一位七圣召唤的强者不声不响造访了阿如村！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e多谢赏脸！有兴趣再来一场吗！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/05/288180982/cc2a44c2e85425afbbd461e49fe0875d_2903818312563969298.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762232696","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[