03c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e\u003cstrong\u003e旅者之路\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e·旅行者装备时，命中敌人后，攻击力提升\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e16%\u003c/span\u003e，持\u003cspan style=\\\"color: rgb(51, 51, 51)\\\"\u003e续\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e8\u003c/span\u003e秒，并使旅行者恢复\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e3\u003c/span\u003e点元素能量。该效果每\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e5\u003c/span\u003e秒至多触发一次，角色处于队伍后台也能触发。\u003c/strong\u003e\u003c/p\u003e\"],\"key\":\"追加属性解锁\"},{\"value\":[\"\u003cp\u003e旅者远走他乡，为的是一份概率渺茫的救赎。\u003c/p\u003e\"],\"key\":\"强化描述\"}],\"materials\":[],\"tab_name\":\"阶段1\"},{\"attr\":[{\"value\":[\"\u003cp\u003e星声的韵乐\u003c/p\u003e\"],\"key\":\"名称\"},{\"value\":[\"\u003cp\u003e40级\u003c/p\u003e\"],\"key\":\"武器等级\"},{\"value\":[\"\u003cp\u003e基础攻击力: 235\u003c/p\u003e\u003cp\u003e暴击率: 18.5%\u003c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e\u003cstrong\u003e旅者之路\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e·旅行者装备时，每与一种元素共鸣过，旅行者的暴击伤害就会提升\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e6%\u003c/span\u003e。此外，旅行者的攻击命中敌人后，攻击力提升\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e20%\u003c/span\u003e，持续\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e8\u003c/span\u003e秒，并使旅行者恢复\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e3\u003c/span\u003e点元素能量。该效果每\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e5\u003c/span\u003e秒至多触发一次，角色处于队伍后台也能触发。\u003c/strong\u003e\u003c/p\u003e\"],\"key\":\"追加属性效果提升\"},{\"value\":[\"\u003cp\u003e不知从何时起，旅者放弃了在寂灭中捕捉声音。「既然如此，就由我来说点什么吧。」\u003c/p\u003e\"],\"key\":\"强化描述\"}],\"materials\":[],\"tab_name\":\"阶段2\"},{\"attr\":[{\"value\":[\"\u003cp\u003e星海的驰往\u003c/p\u003e\"],\"key\":\"名称\"},{\"value\":[\"\u003cp\u003e60级\u003c/p\u003e\"],\"key\":\"武器等级\"},{\"value\":[\"\u003cp\u003e基础攻击力: 382\u003c/p\u003e\u003cp\u003e暴击率: 24.4%\u003c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e宇宙的某个角落，一定存在解答与希望。\u003c/p\u003e\u003cp\u003e——距离仰望星空产生这种想法，已经过去多久了呢？\u003c/p\u003e\"],\"key\":\"强化描述\"}],\"materials\":[],\"tab_name\":\"阶段3\"},{\"attr\":[{\"value\":[\"\u003cp\u003e星舟的孤悬\u003c/p\u003e\"],\"key\":\"名称\"},{\"value\":[\"\u003cp\u003e80级\u003c/p\u003e\"],\"key\":\"武器等级\"},{\"value\":[\"\u003cp\u003e基础攻击力: 532\u003c/p\u003e\u003cp\u003e暴击率: 30.2%\u003c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e\u003cstrong\u003e旅者之路\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e·旅行者装备时，每与一种元素共鸣过，旅行者的暴击伤害就会提升\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e6%\u003c/span\u003e。此外，旅行者的攻击命中敌人后，攻击力提升\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e24%\u003c/span\u003e，持续\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e8\u003c/span\u003e秒，并使旅行者恢复\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e5\u003c/span\u003e点元素能量。该效果每\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e5\u003c/span\u003e秒至多触发一次，角色处于队伍后台也能触发。\u003c/strong\u003e\u003c/p\u003e\"],\"key\":\"追加属性效果提升\"},{\"value\":[\"\u003cp\u003e或许人类并不特殊，与循光而行的飞蛾并无不同。\u003c/p\u003e\u003cp\u003e那又如何，最普通的生命也渴望活下去。\u003c/p\u003e\"],\"key\":\"强化描述\"}],\"materials\":[],\"tab_name\":\"阶段4\"},{\"attr\":[{\"value\":[\"\u003cp\u003e星动的伟愿\u003c/p\u003e\"],\"key\":\"名称\"},{\"value\":[\"\u003cp\u003e90级\u003c/p\u003e\"],\"key\":\"武器等级\"},{\"value\":[\"\u003cp\u003e基础攻击力: 608\u003c/p\u003e\u003cp\u003e暴击率: 33.1%\u003c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e黑暗无法抹灭旅者的锋芒，因为飞船上有剑有犁，一切尚能从头开始。\u003c/p\u003e\"],\"key\":\"强化描述\"}],\"materials\":[],\"tab_name\":\"阶段5\"},{\"attr\":[{\"value\":[\"\u003cp\u003e星降的薄明\u003c/p\u003e\"],\"key\":\"名称\"},{\"value\":[\"\u003cp\u003e90级\u003c/p\u003e\"],\"key\":\"武器等级\"},{\"value\":[\"\u003cp\u003e基础攻击力: 608\u003c/p\u003e\u003cp\u003e暴击率: 33.1%\u003c/p\u003e\"],\"key\":\"基础数值：\"},{\"value\":[\"\u003cp\u003e\u003cstrong\u003e旅者之路\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e·旅行者装备时，每与一种元素共鸣过，旅行者的暴击伤害就会提升\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e6%\u003c/span\u003e。此外，旅行者的攻击命中敌人后，攻击力提升\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e32%\u003c/span\u003e，持续\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e8\u003c/span\u003e秒，并使旅行者恢复\u003cspan style=\\\"color: rgb(0, 151, 225)\\\"\u003e5\u003c/span\u003e点元素能量。该效果每\u003cspan style=\\\"color: rgb(172, 133, 86)\\\"\u003e5\u003c/span\u003e秒至多触发一次，角色处于队伍后台也能触发。\u003c/strong\u003e\u003c/p\u003e\"],\"key\":\"追加属性效果提升\"}],\"materials\":[],\"tab_name\":\"【本版本暂无法解锁】阶段6\"},{\"attr\":[{\"value\":[\"\u003cp\u003e？？？\u003c/p\u003e\"],\"key\":\"？？？\"}],\"materials\":[],\"tab_name\":\"【本版本暂无法解锁】阶段7\"}]}\n","style":""}],"id":"1189","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关故事","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e暂无\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1190","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"推荐角色","is_poped":false,"components":[{"component_id":"multi_table","layout":"","data":"{\"tables\":[{\"tab_name\":\"默认标题\",\"header\":[\"角色名称\",\"描述\"],\"row\":[[\"\u003cp\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"509226\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/07/50494840/f20e826527f6df0cd93ce9944d96e53c_3531577982268140268.png\\\" data-entry-name=\\\"旅行者·冰\\\" data-entry-link=\\\"/ys/obc/content/509226/detail?bbs_presentation_s