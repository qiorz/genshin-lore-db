bs.mihoyo.com/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" data-type=\\\"obc-content\\\" target=\\\"_blank\\\"\u003e摩拉\u003c/a\u003e×20000，冒险家的经验×4，精锻用魔矿×2\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1313","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"活动玩法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/02/75276545/0deb6dabdabcbb9bc377ee35acf7e747_7449102335216552995.jpg?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,jpg\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e全新活动「追想练行」即将开启！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(51,51,51,1)\\\"\u003e多种冒险历练交织而成的幻境悄然出现在了金苹果群岛的某地。迎接幻境中的挑战，将冒险所需的技巧锤炼至极点吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/02/75276545/7ddcca25332c1c4c61d523867c7ceaf3_1802139945559058834.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(17,17,17,1)\\\"\u003e「海蓝纪行」中也增加了对应的活动任务，完成后可领取纪行经验。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch4 style=\\\"text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓活动时间〓\u003c/span\u003e\u003c/h4\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(231,82,0,1)\\\"\u003e2022/08/04 10:00 ~ 2022/08/15 03:59\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch4 style=\\\"text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓参与条件〓\u003c/span\u003e\u003c/h4\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(231,82,0,1)\\\"\u003e冒险等阶≥32级\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(231,82,0,1)\\\"\u003e完成任务「远海诗夏游纪 其一」\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cbr\u003e\u003c/p\u003e\u003ch4 style=\\\"text-align: center;\\\"\u003e\u003cspan style=\\\"color:rgba(26,26,26,1)\\\"\u003e〓玩法介绍〓\u003c/span\u003e\u003c/h4\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/02/75276545/ffa597edd44868cf93d45353fbcdccd6_5877781577576912328.png?x-oss-process=image//resize,s_600/quality,q_80/auto-orient,0/interlace,1/format,png\\\" href=\\\"\\\" style=\\\"border:1px solid rgb(245, 245, 245);vertical-align:;\\\"\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; min-height: 1.5em; text-align: center;\\\"\u003e\u003cimg src=\\\"https://upload-bbs.mihoyo.com/upload/2022/08/02/75276545/52937619c12a5d3e33e267d302f96c5e_