an_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【稳定作息的重要因素好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这似曾相识的感觉…感觉又回到了入行初期，满大街寻找新闻素材的日子呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e正是在人群聚居之处，信息得以流转，新闻才会诞生。现在只有你我的话，大概是不会有什么大新闻的吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e话说回来，你这里的报刊亭如果要进货的话，我还是要推荐《蒸汽鸟报》哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【正义之廷的平淡日常好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我在枫丹廷住的房子里也有这样一套家具呢，不过我有时看到它们总是莫名其妙地犯困……\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e现在想想，之前没日没夜赶稿的时候，也是在长差不多的床和椅子面前来回折返。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果可以的话，这里能作为我备用的「秘密赶稿室」吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"43gwy7y5kqwT1712693715924\":[\"lqu098j44erT1712693718405\"],\"4cf2vhylew3T1710863944349\":[\"tc7ymmfwp5mT1712693795588\"],\"5pybbny3bzT1712693659868\":[],\"7se8n99b19yT1712693798495\":[\"dkl880dfmhfT1712693834657\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"o0s2kqkxpbT1712693617429\",\"totrnt390loT1712693619024\"],\"8tx49hu8apoT1712693720254\":[\"u46n065tpyeT1712693763892\"],\"dkl880dfmhfT1712693834657\":[],\"jblgegsulgoT1712693658350\":[],\"lqu098j44erT1712693718405\":[\"8tx49hu8apoT1712693720254\"],\"nqb471m7nmnT1710863941173\":[\"jblgegsulgoT1712693658350\",\"5pybbny3bzT1712693659868\"],\"o0s2kqkxpbT1712693617429\":[],\"qsjrm5f901qT1712693796503\":[\"7se8n99b19yT1712693798495\"],\"tc7ymmfwp5mT1712693795588\":[\"qsjrm5f901qT1712693796503\"],\"totrnt390loT1712693619024\":[],\"u46n065tpyeT1712693763892\":[],\"z2tn3pzsbujT1710863943430\":[\"43gwy7y5kqwT1712693715924\"]},\"contents\":{\"43gwy7y5kqwT1712693715924\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可不是？他们认为，长期饮用枫达会让人的牙齿和身上骨头变得脆弱不堪。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e最后，枫达会将一个人摧毁到生活不能自理的地步，连走路和吃饭都变得十分困难。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e到了这一步，人们就不得不借助各种机关造物生活。由此，开发各种机关造物的枫丹科学院就可以大赚一笔了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那这个阴谋还挺甜蜜的喔。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我…想去周围拍点画片，你不会介意吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那个圆圆的，大大的团雀居然还会说话，如果能写成报道，一定会很有趣的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"5pybbny3bzT1712693659868\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？你没用过吗？真可惜，我还想问问你，用这种壶泡出来的茶是什么味道呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我之前采访璃月人时听过一个传说。说是有位仙人曾经拿着一盏茶壶，用半条碧水河的水来泡茶…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e泡完茶后，这位仙人就把茶水重新倒回河里，所以碧水河的颜色才成了如今这样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e也不知道传说是真是假…有机会的话，真想尝尝碧水河里有没有茶叶味呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我不会用它泡茶的啦，放心。】\"},\"7se8n99b19yT1712693798495\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e居然是仙人做的…那、那你能把我引荐给那位仙人吗？我真的很好奇璃月仙人的故事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e据我所知，访仙有许多规矩和禁忌…你能给我详细讲讲吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【是璃月的一位仙人喔。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者，你可算来了，这地方可真神奇…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我拍了好多画片，还有很多问题想问你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8tx49hu8apoT1712693720254\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e安里先生表示，从采访那一天开始，他会每天饮用三杯枫达，一直持续到自己六十岁。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e而且他会将自己每个月的体检单据在我们《蒸汽鸟报》上公开，接受所有人的监督。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【 他怎么亲身验证？】\"},\"dkl880dfmhfT1712693834657\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的？！那一言为定，等我准备好了之后就来找你，你可不准食言喔！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者，你的人脉果然很厉害啊，连仙人都这么熟识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有了你这位好朋友，我根本就不用愁新闻来源啦，嘿嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e独家仙人访谈…新闻题目叫什么好呢？《仙人调查》？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不行不行，这听起来有点不太礼貌，说不定我会被仙人们丢下山去…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e《绝云仙踪》…对！就叫《绝云仙踪：漫漫璃月访仙路》好了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没那么复杂啦，我带你去就行。】\"},\"jblgegsulgoT1712693658350\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e也不算是担心啦。我就是在想…如果有人掀开这盏壶的盖子，往里面倒水的话…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这里会发生怎样的情景呢？洪水？暴雨？还是说从底部突然开始涨水？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好想记录一下…旅行者，你能现在就去外面，往这盏壶里倒水吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【对呀，你在担心什么吗？】\"},\"lqu098j44erT1712693718405\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当时我的许多同事也这么认为。但鉴于大家都知道，《惊奇！》除了胡说八道和造谣之外什么也不会…我们也没当回事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谁知道，许多本来就不太喜欢枫达的枫丹人把这个谣言当真了…或者说，他们总算找到另一个发泄口。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e在那篇文章发表后，无数投诉信飞去复律庭，控告枫达伤害了孩子们的身体。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e人们说，枫达不仅损坏了孩子们的牙齿，还让他们长不高、不爱喝水、吃不下饭…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这场乱子越闹越大，逼得安里先生不得不接受了我们的公开采访，并且表示愿意亲身验证枫达的无害性…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【联想力太过剩了！】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这里的环境可太舒服了，而且光线特别好，无论从什么角度取景，都能拍出很好看的画片。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但是…我们其实是在那盏「茶壶」里，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"o0s2kqkxpbT1712693617429\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早上好啊，哎呀！都这个点了，我要赶紧去拿最新一期的报刊才行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e等我回来的时候，也给你带一份。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，夏洛蒂。】——【白天】\"},\"qsjrm5f901qT1712693796503\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啦，既然你不愿意，那我也不会拿这个作为新闻报道。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过…你能透露一下，是谁制作了这盏壶吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你就饶了我吧，夏洛蒂大记者！】\"},\"tc7ymmfwp5mT1712693795588\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，那只团雀叫阿圆啊…你放心，登载有关某人的具体新闻，我一定会先取得当事人同意的，我可是专业记者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e话又说回来，你介意大家知道你有这么一盏神奇的茶壶吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【可能要问问阿圆的意见…】\"},\"totrnt390loT1712693619024\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安啦，唔…平时这个时候，我应该要么在校对稿件，要么在写新稿件…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e现在这么放松，反而有点不太适应了。哈哈哈…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呃…等等，我最新一期的稿件交了吗？应该…应该交了吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，夏洛蒂。】——【夜晚】\"},\"u46n065tpyeT1712693763892\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈哈哈，没错，这件事也成了我们办公室里经久不衰的经典新闻笑话。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过，安里先生倒是借着这件事，又给枫达做了一波巨大的宣传，大大地提高了一波枫达的销量。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e至于他定时公开的体检单据，还有「喝枫达喝到六十岁」的承诺嘛…没过几个月，大家就完全忘到脑后啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【总感觉，我是在听什么冷笑话…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，你想听什么话题？不如…我给你讲讲《惊奇！》惹出的一次乱子吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e《惊奇！》曾经刊发过一篇特别访谈文章，文章里说，制造并推广枫达其实是枫丹科学院的阴谋。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1712801699","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"地区\\\",\\\"children\\\":[{\\\"label\\\":\\\"蒙德\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"璃月\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"稻妻\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"须弥\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"枫丹\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"纳塔\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"挪德卡莱\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"至冬\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"活动地区\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"洞天\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"活动\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"商人\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"其他\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"任务\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"牌手挑战\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"对话奖励\\\",\\\"children\\\":[{\\\"label\\\":\\\"有\\\",\\\"children\\\":[]}]},{\\\"label\\\":\\\"特殊效果\\\",\\\"children\\\":[{\\\"label\\\":\\\"心声\\\",\\\"children\\\":[]},{\\\"label\\\":\\\"秘闻馆情报\\\",\\\"children\\\":[]}]}]\"},{\"type\":\"text\",\"attribute_name\":\"首页更多\",\"attribute_key\":\"home_more\",\"value\":\"https://baike.mihoyo.com/ys/obc/channel/map/189/20?bbs_presentation_style=no_header\"},{\"type\":\"text\",\"attribute_name\":\"在目录中展示\",\"attribute_key\":\"show_in_catalog\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"最新词条\",\"attribute_key\":\"is_latest\",\"value\":\"0\"},{\"type\":\"text\",\"attribute_name\":\"更多入口icon\",\"attribute_key\":\"king_kong_icon\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"首页更多文案\",\"attribute_key\":\"home_more_text\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"开放全量C端玩家可新建词条\",\"attribute_key\":\"open_for_create\",\"value\":\"0\"}]","updated_at":"-62135596800"}],"template_id":"6605788895f7dc84ca833e44","ext":{"fe_ext":"{\"c_20\":{\"filter\":{\"text\":\"[\\\"地区/洞天\\\"]\"}}}","post_ext":{"post_id":"","post_user_name":"","post_time":"0","post_avatar_url":"","url":""},"server_ext":"","personalized_color":"","scrolling_text":"","corner_mark":"None"},"alias_name":"","lang":"","beta":false,"page_type":"Default","menu_style":"","status":"Online"}}}