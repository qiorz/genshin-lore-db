nt_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"z6ahbgo3svdT1786633994512\",\"q1bmzqnzngT1786634019062\"],\"nqb471m7nmnT1710863941173\":[],\"q1bmzqnzngT1786634019062\":[],\"z2tn3pzsbujT1710863943430\":[],\"z6ahbgo3svdT1786633994512\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【可以预订座位吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e按店里的规矩，不行，但是如果您真的需要，可以提前和我说…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您看，偶尔也会有忘了安排客人的桌子，遇上了凑巧来就餐的您，这不是皆大欢喜的好事嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎，欢迎光临「老庭院餐厅」，如果您有什么需要，请随时和我说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【让我看看菜单…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好的，您请，有需要点单就和我说。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/08/13/178964736/8c1682d1176d5e5c252663655f810639_1307918652104344366.png\"},\"q1bmzqnzngT1786634019062\":{\"option\":\"【呃…没什么需要…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那期待您下次的光临，客人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【老庭院…有多老？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那可真的很老了，毕竟在这里供职的全都是长生的妖精嘛…不过具体的年份，就连我也不是很清楚。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果您是在担心吃到的不是正宗的老味道，那大可不必，我们现在的老板…从很久以前开始就在这掌勺啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他当上老板的时候，我都还是在雪原上滚来滚去的毛球呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z6ahbgo3svdT1786633994512\":{\"option\":\"【有什么推荐菜吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e「老庭院」的每道菜都是推荐菜哦，每道能在漫长岁月里留在菜单里的佳肴都有各自的可取之处。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e是否喜欢，就得看客人您自己的口味了，而我的建议是…多做些尝试吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1786673074","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"七圣召唤挑战","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u