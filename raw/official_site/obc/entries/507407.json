/span\u003e\u003c/p\u003e\u003cp\u003e完成「魔女的课业」相关任务，可以解锁对应角色的额外天赋，部分角色的技能与命之座效果也会发生变化。\u003c/p\u003e\u003cp\u003e\u003cspan class=\\\"custom-image-view\\\" data-image-url=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/03/50494840/4e89d10d8e47e9207fcc98f4234c489c_512796682248045953.png\\\" data-image-unit=\\\"px\\\" data-image-width=\\\"790\\\"\u003e\u003cspan class=\\\"custom-image-wrapper\\\" style=\\\"width: 790px;\\\"\u003e\u003cspan style=\\\"\\\"\u003e\u003cimg class=\\\"custom-image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/12/03/50494840/4e89d10d8e47e9207fcc98f4234c489c_512796682248045953.png\\\" style=\\\"width: 790px;\\\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e每个「魔女的课业」任务分别对应一名角色。获得对应角色，并使对应角色的角色等级提升至70级以上，即可解锁对应的任务。\u003c/p\u003e\"]},{\"key\":\"魔女的课业·说明\",\"value\":[\"\u003cp\u003e【角色强化】\u003c/p\u003e\u003cp\u003e完成「魔女的课业」相关任务，可以解锁对应角色的额外天赋，部分角色的技能、突破天赋与命之座效果也会发生变化。此外，完成「魔女的课业」相关任务后，对应角色还会成为魔导角色。队伍中编入一定数量的魔导角色时，将获得「魔导·秘仪」效果，使魔导角色获得进一步强化。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【解锁条件】\u003c/p\u003e\u003cp\u003e每个「魔女的课业」任务分别对应一名角色。获得对应角色，并使对应角色的角色等级提升至70级以上，即可解锁对应的任务。\u003c/p\u003e\"]},{\"key\":\"玩法说明\",\"value\":[\"\u003cp\u003e【基本玩法】\u003c/p\u003e\u003cp\u003e完成「魔女的课业·题解」，即可获得「小魔女辞典」。跟随「小魔女辞典」的指引，完成其中的课业，即可解锁对应角色的额外天赋，并获得角色强化。完成「魔女的课业·题解」后，还可以从菲谢尔、砂糖和雷泽三名角色中自选邀约一位加入队伍。\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e【参与条件】\u003c/p\u003e\u003cp\u003e完成魔神任务「巨龙与自由之歌」。\u003c/p\u003e\"]}]}\n","style":""}],"id":"8910","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"更多信息","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"官方资讯\",\"value\":[\"\u003cp\u003e\u003ca href=\\\"https://www.miyoushe.com/ys/article/71075609\\