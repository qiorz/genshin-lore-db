{"retcode":0,"message":"OK","data":{"page":{"id":"679","name":"老章【「寒锋铁器」铁匠】","desc":"老章【「寒锋铁器」铁匠】","icon_url":"https://uploadstatic.mihoyo.com/ys-obc/2021/12/16/75981509/72371deea53cf332d9cadaeb4038b33e_5141756454943940741.jpg","header_img_url":"","modules":[{"name":"老章","is_poped":false,"components":[{"component_id":"npc_base_info","layout":"","data":"{\"extra_attr\":[{\"value\":[\"\u003cp\u003e璃月的百年老字号，以德望与手艺赢得了人们的青睐。\u003c/p\u003e\u003cp\u003e不论来者何人，只要有需求，有原料，就一定能拿出相应的成品。\u003c/p\u003e\u003cp\u003e铸炉的火与对锻造的热情恒常燃烧，正如「薪火相传，而不知其尽」。\u003c/p\u003e\"],\"key\":\"编者注：\"}],\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/22/4905523/9a57df2094349270bacce9e874aa0556_4907342281128885466.png\",\"attr\":[{\"value\":[\"\u003cp\u003e男\u003c/p\u003e\"],\"key\":\"性别\"},{\"value\":[\"\u003cp\u003e璃月港\u003c/p\u003e\"],\"key\":\"位置\"},{\"value\":[\"\u003cp\u003e铁匠铺\u003c/p\u003e\u003cp\u003e矿物富集点指引\u003c/p\u003e\"],\"key\":\"功能\"},{\"value\":[\"\u003cp\u003e「寒锋铁器」铁匠\u003c/p\u003e\"],\"key\":\"职业\"}]}\n","style":""}],"id":"1207","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"截图\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2020/07/22/4905523/43cfb215998ae8e797c56444619b9c48_4942390121032360165.png\"},{\"tab_name\":\"位置\",\"image\":\"https://uploadstatic.mihoyo.com/ys-obc/2021/12/15/75981509/2d50a0df6a50cbf8111ceb929f63fd37_8369062910419579928.png\"}]}\n","style":""}],"id":"1208","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"锻造列表","is_poped":false,"components"