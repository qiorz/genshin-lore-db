entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/4287/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e小小的远行·防身的方法？\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"5u3kten38jiT1783581707378\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"uq40sr2pojT1783581696530\",\"5u3kten38jiT1783581707378\",\"igpuo6s9nloT1783581730064\",\"xy55mz73lqtT1783581739274\"],\"igpuo6s9nloT1783581730064\":[],\"nqb471m7nmnT1710863941173\":[],\"uq40sr2pojT1783581696530\":[],\"xy55mz73lqtT1783581739274\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【关于璃月的矿产…】——有可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e璃月可是岩王爷的地盘，这儿的矿产绝对不会让人失望。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e幸亏我平日里免费帮别人修理东西积攒了些人脉，他们时不时会给带来些矿石的情报…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最近他们发现了不少变异的水晶矿，俗称「魔晶矿」，这质地和成色可不是普通的水晶矿可以比得了的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可惜，这种矿石的加工难度实在太大了，即便是我也束手无策…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是你找到了加工这些矿石的方法，那就来找我吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…矿脉的位置我已经给你在地图上画出来了，你去这附近转转，应该会有所收获的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/09/288180982/cc70592f615b485afe4437ec77de50a8_2010996521619663799.png\"},\"5u3kten38jiT1783581707378\":{\"option\":\"【有什么卖的？】——打开商店界面\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e绝好的矿材，祖传的手艺，放心挑吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/09/288180982/11ee64c710e3b091256c0d349ac55461_2799328650145404586.png\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e想买兵器还是委托锻造？修东西的话免费，记得帮我留意下有没有好矿石就行。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"igpuo6s9nloT1783581730064\":{\"option\":\"【关于「寒锋铁器」…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这铺子是我爹留给我的，他老人家正在轻策庄养老呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e爹留给我的除了这些工具和炉子外，还教给我做生意靠得是人情的道理。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e附近的矿工劳工之类的，拿来要修的铁器，我从不收他们修理费。代价就是多多帮我留意稀有的矿石。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e哪个铁匠不想打一把神兵利器出来呢？我想璃月既然是岩王爷的地盘，肯定会有大陆其他地方找不到的稀世好矿…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e从原材料上就彻底打败那些同行，振一振这百年老铺的名声，嘿嘿。你也要记得帮我留意啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【委托锻造…】——打开锻造界面【无已完成锻造物品】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e自己带了材料来吗？让我看看是些什么货色。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/09/288180982/45b433a26de72a670e897bbcda70fa8f_2521429234826396359.png\"},\"uq40sr2pojT1783581696530\":{\"option\":\"【关于璃月的矿产…】——无可标记地点\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e矿石啊…附近的很多矿点你都去过了吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我这边暂时没什么新的情报，不如你下次再来碰碰运气。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/09/288180982/cc70592f615b485afe4437ec77de50a8_6559915655818620121.png\"},\"xy55mz73lqtT1783581739274\":{\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e走吧，要帮忙记得回来找我。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【委托锻造…】——打开锻造界面【有未获取的已完成锻造物品】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，话说之前的委托已经锻造好了，还有其他委托么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2026/07/09/288180982/45b433a26de72a670e897bbcda70fa8f_2076566409409138853.png\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"铁匠铺","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003ctable class=\\\"tableWrapperContent\\\"\u003e\u003ctbody\u003e\u003ctr\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" colwidth=\\\"343\\\" style=\\\"\\\"\u003e\u003cp\u003e【商品名称】\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e【商品种类】\u003c/p\u003e\u003c/th\u003e\u003cth colspan=\\\"1\\\" rowspan=\\\"1\\\" style=\\\"\\\"\u003e\u003cp style=\\\"text-align: center\\\"\u003e价格【摩拉】\u003c/p\u003e\u003c/th\u003e