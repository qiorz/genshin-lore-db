"n7myu3pjqpT1713363131290\"],\"phqe53q5l2aT1713363294027\":[\"6td2aiymeofT1713363571708\"],\"r8hgb3j73kiT1713363035577\":[\"n7myu3pjqpT1713363131290\"],\"vowbrebecmeT1713362962307\":[\"n7myu3pjqpT1713363131290\"],\"vwxjjuitkwT1713363369712\":[\"6td2aiymeofT1713363571708\"],\"vyeht7fog6T1713362963555\":[\"n7myu3pjqpT1713363131290\"],\"z2tn3pzsbujT1710863943430\":[\"n7myu3pjqpT1713363131290\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我叫戈黛特，来自蒙德。是望舒客栈的老板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不是老板娘。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是、老、板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【请问你是？】\"},\"5zx49ztu58tT1713363649732\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"6td2aiymeofT1713363571708\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次逐月节（2021）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"75ga0jchoogT1713363268043\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您好啊，您也算回头客了吧，欢迎欢迎。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"7l3maqkjr0qT1713363290435\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请点单吧，蒙德和璃月的料理都有哦，另外「杏仁豆腐」可是我们的招牌菜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/72954525/11ee64c710e3b091256c0d349ac55461_5628619207043224842.png\",\"option\":\"【我想买些吃的。】——打开商店界面\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您好啊。打扮、面庞…还有奇怪的伙伴小精灵。猜不出来了呢…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"bkwo1qzi0opT1713363629004\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您好啊，您也算回头客了吧，欢迎欢迎。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e逐月节可是品尝美食和登高赏月的最好时节，望舒客栈两者兼得，您算是来对了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"btds6yem2lT1713363291841\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还好你没有提出「打赢就免单」的要求，不然，我的面子可就挂不住了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，可别小瞧客栈老板啊~我可是经常和客人们玩牌的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/72954525/cc2a44c2e85425afbbd461e49fe0875d_6349680047853874039.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\"},\"eehvolv1g7eT1713363370882\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉…这猫是自己跟来的，不过看着挺可爱的就留下了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e名字吗，叫阿伟，随便起的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于这猫…】\"},\"fadrojbg79hT1713363293099\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉…说了多少次了，不是老板娘。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这家望舒客栈的老板哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是、老、板。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你好，老板娘。】\"},\"n7myu3pjqpT1713363131290\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成魔神任务 第一章第一幕「浮世浮生千岩间」后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nnhs7upc2yT1713363493245\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e祝您旅途平安。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e请点单吧，蒙德和璃月的料理都有哦，另外「杏仁豆腐」可是我们的招牌菜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/72954525/11ee64c710e3b091256c0d349ac55461_3405090624852218659.png\",\"option\":\"【我想买些吃的。】——打开商店界面\"},\"otj0hj0czj9T1713363067461\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e祝您旅途平安。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"phqe53q5l2aT1713363294027\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e他就在那边，是客栈的掌柜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e别看他笑嘻嘻的，其实拳脚功夫很厉害的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我也是，我们的厨子也是，都是这么招进来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不会功夫还怎么招待好客人呢，你说是不是这个道理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你丈夫？】\"},\"r8hgb3j73kiT1713363035577\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e他就在那边，是客栈的掌柜。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e别看他笑嘻嘻的，其实拳脚功夫很厉害的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我也是，我们的厨子也是，都是这么招进来的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不会功夫还怎么招待好客人呢，你说是不是这个道理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于你丈夫？】\"},\"vowbrebecmeT1713362962307\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，能在这里开店，怎么可能和七星没有关系呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我意思是，肯定需要他们同意嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e其他一些有的没的，那当然都是谣言啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这么说来，您听到过什么有意思的事情吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有些传闻…】\"},\"vwxjjuitkwT1713363369712\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈哈，能在这里开店，怎么可能和七星没有关系呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我意思是，肯定需要他们同意嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e其他一些有的没的，那当然都是谣言啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这么说来，您听到过什么有意思的事情吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有些传闻…】\"},\"vyeht7fog6T1713362963555\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唉…这猫是自己跟来的，不过看着挺可爱的就留下了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e名字吗，叫阿伟，随便起的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于这猫…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还好你没有提出「打赢就免单」的要求，不然，我的面子可就挂不住了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呵呵，可别小瞧客栈老板啊~我可是经常和客人们玩牌的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/72954525/cc2a44c2e85425afbbd461e49fe0875d_8026167834230964620.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713373125","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_g