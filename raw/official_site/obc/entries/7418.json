is_hidden":false,"rich_text_editing":false},{"name":"好感套装对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e【禁止触犯的规则之源好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不会是想让我在你家办公，然后趁机窥探梅洛彼得堡的机密吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那可能要让你失望了，因为大部分工作都是枯燥的账目。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还是说，你愿意帮我算数学题？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp\u003e\u003cstrong\u003e【禁限之堡的「拳力以赴」好感套装对话】\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还挺像模像样的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e能被你邀请参赛的人一定实力不凡。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我就不上去献丑了，当观众也挺适合我的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1210","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"card_group_info","layout":"","data":"{\"author\":\"\",\"created_at\":\"\",\"list\":[]}\n","style":""}],"id":"1211","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"18pcmpkk3beT1712735494560\":[\"z4teouf03r8T1712735531985\",\"tjiirp4xupT1712735533458\"],\"25m3uhtojgxT1712735352176\":[],\"4cf2vhylew3T1710863944349\":[\"ov0zxg3a01fT1712735613655\",\"7t8ck7s3cd2T1712735615062\"],\"7t8ck7s3cd2T1712735615062\":[\"k029f3wb16eT1712735652683\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"zzygeb3y7wT1712735759656\",\"kwjvuaqvosT1712735761001\"],\"axl046k6b3bT1712735734582\":[],\"b2h6u9gw978T1712735687381\":[\"axl046k6b3bT1712735734582\"],\"e0nys1vqxojT1712735375061\":[],\"e54h8ibcbkT1712735688687\":[\"axl046k6b3bT1712735734582\"],\"k029f3wb16eT1712735652683\":[\"b2h6u9gw978T1712735687381\",\"e54h8ibcbkT1712735688687\"],\"kwjvuaqvosT1712735761001\":[],\"msg0c9tzaxmT1712735353502\":[\"e0nys1vqxojT1712735375061\"],\"nqb471m7nmnT1710863941173\":[\"25m3uhtojgxT1712735352176\",\"msg0c9tzaxmT1712735353502\"],\"ov0zxg3a01fT1712735613655\":[\"k029f3wb16eT1712735652683\"],\"s3v243l3axcT1712735471067\":[\"18pcmpkk3beT1712735494560\"],\"tjiirp4xupT1712735533458\":[],\"z2tn3pzsbujT1710863943430\":[\"s3v243l3axcT1712735471067\"],\"z4teouf03r8T1712735531985\":[],\"zzygeb3y7wT1712735759656\":[]},\"contents\":{\"18pcmpkk3beT1712735494560\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，没错。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说起来，我小时候也犯过类似的错误，以为美露莘就是天使海兔跳上岸以后的形态。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e后来读了些书，被狠狠上了一课。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你应该知道，根据法律规定，美露莘是枫丹的正式公民，严禁被当作宠物或怪物对待。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【不可貌相哦。】\"},\"25m3uhtojgxT1712735352176\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e语气如此坚定，看来是生命中至关重要的大事。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e执着于某项目标是好事，能避免人生陷入迷茫。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但千万不要因为被执念掌控而步入险途，好吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e毕竟还有这样一个美妙的地方等你回来呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我有必须要做的事。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我想在这里到处转转，你不介意吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【有什么想做的吗？】\"},\"7t8ck7s3cd2T1712735615062\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e如果换个地方的话…的确，我至少要先确保周边是安全的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但这里是你家，应该不会有什么危险的，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是出于好奇，想在这片似乎无边无际的神奇天地里闲逛一番，就像旅游一样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【还以为你肯定已经探索过了。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e正想着若是你没事找我，我要不要去找块草坪躺一会儿呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"axl046k6b3bT1712735734582\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e衷心感谢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e当然，我也知道世上不应当有白拿的午餐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e所以需要我帮忙的时候无需顾虑，水下永远欢迎你的到访。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e——当然，不作为犯人下来的话最好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【我可以切换给你看哦。】\"},\"b2h6u9gw978T1712735687381\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，这对我来说肯定是难能可贵的机会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果有想要的东西就该去争取，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你想试试吗？】\"},\"e0nys1vqxojT1712735375061\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀，被你看穿了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e放心吧，我只是开玩笑而已。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e就算真要定什么规矩，我也会亲自负责的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【休想推卸责任。】\"},\"e54h8ibcbkT1712735688687\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，这对我来说肯定是难能可贵的机会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果有想要的东西就该去争取，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【兴趣已经写在脸上了哦。】\"},\"is23cry6y3mT1712735551723\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然能到水下干活的人多多益善，但我并没有教唆犯罪的癖好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望大家尽量通过正规途径入职梅洛彼得堡，不要给沫芒宫的女士先生们添麻烦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"k029f3wb16eT1712735652683\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这么厉害？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e也就是说，只要你想，就能足不出壶地周游各国？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【还可以切换其他地区的景色哦。】\"},\"kwjvuaqvosT1712735761001\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e白天总是很嘈杂，所以我习惯把那些需要安静思考的事务留到晚上处理。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过…在这就算了，让我再发会儿呆吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【晚安，莱欧斯利。】——【夜晚】\"},\"msg0c9tzaxmT1712735353502\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，很有说服力的一句话，我可以记下来写进梅洛彼得堡的什么守则里。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e需要给你署名吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【生命在于运动。】\"},\"npjat1rgcehT1712735716835\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，这对我来说肯定是难能可贵的机会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e如果有想要的东西就该去争取，不是吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，环境很好，温度和湿度都无可挑剔，是适合悠闲度日的地方。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有这样舒适的庇护所还愿意在外面闯荡，你确实不一般。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\"},\"oje3zqt73iT1712735649584\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e但这里是你家，应该不会有什么危险的，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是出于好奇，想在这片似乎无边无际的神奇天地里闲逛一番，就像旅游一样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"\"},\"ov0zxg3a01fT1712735613655\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e且不谈武力强弱，如果你拒绝，我肯定不会四处乱逛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不过你也算是对我有些了解了，我的确不习惯在自己不熟悉的地方久留。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e但这里是你家，应该不会有什么危险的，对吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我只是出于好奇，想在这片似乎无边无际的神奇天地里闲逛一番，就像旅游一样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没关系，反正我也没法一直盯着你。】\"},\"s3v243l3axcT1712735471067\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e原来如此，那位管家是壶灵啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我刚到这里时，远远看去还误以为你养了只大型青冠雀一类的宠物。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【都是壶灵阿圆的功劳。】\"},\"tjiirp4xupT1712735533458\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那你可要感谢我了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e对美露莘不敬的犯人，刑期可能会不太好看哦？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然能到水下干活的人多多益善，但我并没有教唆犯罪的癖好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望大家尽量通过正规途径入职梅洛彼得堡，不要给沫芒宫的女士先生们添麻烦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【第一次听说…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好啊，有什么想聊的话题吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谈论天气是个打开话匣的好办法，不过这里的气候好像始终如一。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\"},\"z4teouf03r8T1712735531985\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那就没什么问题了，至少你陷入法律纠纷的原因又少了一个。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然能到水下干活的人多多益善，但我并没有教唆犯罪的癖好。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e希望大家尽量通过正规途径入职梅洛彼得堡，不要给沫芒宫的女士先生们添麻烦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【略知一二。】\"},\"zzygeb3y7wT1712735759656\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e难得不在水下碰面，就不用叫得这么正式了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e早安，祝你度过美好的一天。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【早啊，公爵。】——【白天】\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1724392816","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"v