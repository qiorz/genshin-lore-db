ank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e海灯节\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e（轻策来客）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"q52z1fsvsv8T1758038511076\",\"de3ziqj3fnT1758038512203\",\"i66bt7ewpjkT1758038535877\"],\"c4ir6pncdpkT1758038585641\":[],\"de3ziqj3fnT1758038512203\":[\"c4ir6pncdpkT1758038585641\",\"dzntty4j0wnT1758038600571\"],\"dzntty4j0wnT1758038600571\":[],\"i66bt7ewpjkT1758038535877\":[],\"nqb471m7nmnT1710863941173\":[],\"q52z1fsvsv8T1758038511076\":[\"c4ir6pncdpkT1758038585641\",\"dzntty4j0wnT1758038600571\"],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e从我爷爷的爷爷那一代，一直传到老夫手里的木工作坊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e常家九爷的房子也好，庄里的大磨坊也好，都是我们「范木堂」修的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就连七星的人也会来找我们定制家具。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【工坊？】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎来到「范木堂」，轻策庄老字号工坊！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e大到百尺高楼，小到指尖陀螺，但凡是客官想得到的，没有老夫做不出的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"c4ir6pncdpkT1758038585641\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦哦，此话当真？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但看你的样子，也有不得不做的事情，有不得不去的地方吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等你把该做的事情做完了，到时候如果老夫还健在的话，再来叫我师父吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e决定了，届时一定倾尽全力把「范木堂」的手艺传授给你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【师父！】\"},\"de3ziqj3fnT1758038512203\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客官是听到老夫念叨了吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呵呵，老夫新收的徒弟大雨，干活麻利，人也算勤快，就是话太多。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我们做木匠的，踏踏实实做好自己的活计就行了，跟客人说那么多闲话做什么。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这小子不够稳健哪，我还是再收一个徒弟好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e两个徒弟互相帮衬着，就能把「范木堂」的名号好好传承下去了吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…这么说来，客官对木工活有兴趣吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于徒弟…】——完成世界任务「台上台下」后\"},\"dzntty4j0wnT1758038600571\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真遗憾。木工活真的很有趣。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看你的样子，也有不得不做的事情，不得不去的地方吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e等你把该做的事情做完了，如果改变了心意的话，一定要来找老夫啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e届时老夫一定倾尽全力把「范木堂」的手艺传授给你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【还是算了。】\"},\"i66bt7ewpjkT1758038535877\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这就走了吗？唉…对老夫来说，客人也是接一个少一个咯…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哦？客官可是想制作些摆设？恰好我们「范木堂」进了些图纸，客官来挑挑吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/17/288180982/11ee64c710e3b091256c0d349ac55461_6148368138216155643.png\",\"option\":\"【关于摆设…】——打开商店界面\"},\"q52z1fsvsv8T1758038511076\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客官是听到老夫念叨了吗，唉…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e老夫年纪已经太大了，风也见过雨也见过，腿脚不麻利了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e还是想收个徒弟，把「范木堂」的名号传下去啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…这么说来，你对木工活有兴趣吗？通过劳动，把原始的木材，变成巧夺天工的艺术品，这样的事情，没兴趣吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成世界任务「台上台下」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于徒弟…】——完成世界任务「台上台下」前\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不错不错！年轻人果然更擅长牌戏！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp style=\\\"text-align: start\\\"\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e和你打牌格外解闷！有空再来陪老夫玩两局啊！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/17/288180982/cc2a44c2e85425afbbd461e49fe0875d_8413904469096044092.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手九级解锁】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758038742","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","mod