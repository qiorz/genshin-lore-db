,"data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成每日委托 哎呀！海盗想长大！前】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e万里波涛号，扬帆起航！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【小蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e风浪好大哇！我的货物和金子都要翻进海里啦！服务生，服务生！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e服务生，服务生！快去帮忙，不然…不然我…就把你踢进海里去！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e服务生，服务生！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我不想玩了，每次都是我扮服务生…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那你要扮什么？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…我要扮北斗大人…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e帅气的北斗大人每次都是璐璐扮，我也想扮一次！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那是因为我是女孩子，而且年纪最大！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我…我个子最高！而且不管男孩子女孩子…盖上一只眼不都一样！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【小蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哪里能一样啦，你都没有那个…气质！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜呜…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【小蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哇，阿飞又哭鼻子了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好啦好啦…就让你扮一次吧？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成每日委托 哎呀！海盗想长大！后】\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e小蒙为什么突然想去须弥旅行了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【璐璐】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说不定他只是想出去逛逛呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【阿飞】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欸？是这样吗？真好啊…我也想出去玩…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1758014178","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"