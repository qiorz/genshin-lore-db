003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e灵蕈旅记：综景一览\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e、\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"508220\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2026/03/23/80663279/41a53cbf3d3742b30dd4261689b9e6fc_1176334455133858400.png\\\" data-entry-name=\\\"灵蕈旅记：水下趣览\\\" data-entry-link=\\\"/ys/obc/content/508220/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/508220/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e灵蕈旅记：水下趣览\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e）\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"nqb471m7nmnT1710863941173\":[\"zakpske2j8T1774543474862\",\"v1q7zckyapT1774543475609\",\"ot18wq7njpT1774543476562\"],\"ot18wq7njpT1774543476562\":[],\"qnb198g72tpT1774543175921\":[],\"u1tzxorzt1T1774543173706\":[],\"u7730rcvfjfT1774543175069\":[],\"v1q7zckyapT1774543475609\":[],\"z2tn3pzsbujT1710863943430\":[\"u1tzxorzt1T1774543173706\",\"u7730rcvfjfT1774543175069\",\"qnb198g72tpT1774543175921\"],\"zakpske2j8T1774543474862\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"option\":\"【待会儿再来和蕈兽伙伴们玩。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e那就回头见哦，「咚咚小圆帽」和「欢腾之火」！以后我们一起玩的时间还很多！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"8gfxrw8wla9T1710863939170\":{\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e「咚咚小圆帽」、「欢腾之火」，我们来陪你们玩啦！以后可以经常这样轻轻松松待在一起！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e旅行者，我们陪蕈兽伙伴们做些什么好呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【老规矩，投喂蕈兽伙伴？】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀好呀，海妮耶和左右加好像根据自己的见闻，给「妙妙琼脂」新增了许多口味呢，可以试试看！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"ot18wq7njpT1774543476562\":{\"option\":\"【投喂咖啡味的「妙妙琼脂」。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e说起来，咖啡一般是工作的人加班提神用的吧？蕈兽伙伴们需要加班吗…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♪~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♫~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e咦？咖啡的味道好像让伙伴们更开心了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e嗯…还是不要把咖啡和上班关联起来比较好！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果吃下了含有咖啡的东西，能让蕈兽伙伴们痛痛快快玩不累，就最好了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，也要注意，不能让伙伴们玩得太过火，累到自己！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"qnb198g72tpT1774543175921\":{\"option\":\"【右手指向派蒙，左手摸头。】\",\"dialogue\":\"\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♪~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，这个动作，我和「咚咚小圆帽」都还记得，「咚咚小圆帽」随时可以让我摸它的头！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这次「欢腾之火」的反应是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♫~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！现在「欢腾之火」也知道了，不能跳到我的脑袋上，「欢腾之火」也有进步！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"u1tzxorzt1T1774543173706\":{\"option\":\"【比个「留影机」拍摄的手势。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，这是注意留影时机的意思吗？现在的蕈兽伙伴肯定能理解了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♪！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♫！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e果然，两位蕈兽伙伴的反应都很快，说不定以后都能成为留影专家！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"u7730rcvfjfT1774543175069\":{\"option\":\"【手放在耳朵旁，倾听状。】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e是让蕈兽伙伴们注意聆听动静吗？嗯…在野外一起行动的时候，确实很关键！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不愧是「咚咚小圆帽」和「欢腾之火」，马上就安静下来了，好像在用小脚感受地面的振动…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e凭我们现在的合作，在野外，八成能立刻感知到附近的危险，早早做好准备了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"v1q7zckyapT1774543475609\":{\"option\":\"【投喂白灵果味的「妙妙琼脂」。】\",\"dialogue\":\"\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e……\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e唔？好神奇…挪德卡莱进口水果风味的琼脂，让伙伴们都陷入了沉思？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e可能是以前从没接触过这种味道，伙伴们开始想象那里的景象了？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果能像去枫丹的那次，解决外来物种的问题…说不定可以带着蕈兽伙伴们去低调地游览一番？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【再来玩…向蕈兽伙伴比手势！】\",\"dialogue\":\"\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，以我们现在和蕈兽伙伴的默契，应该能用更复杂的手势来沟通？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就算是带有一点点专业知识的信号，都可以试试看了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"zakpske2j8T1774543474862\":{\"option\":\"【投喂泡泡桔味的「妙妙琼脂」。】\",\"dialogue\":\"\u003cp\u003e【咚咚小圆帽】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e♪\u003cspan\u003e♫\u003c/span\u003e~\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【欢腾之火】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【派蒙】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，两位伙伴都喜欢泡泡桔，不过反应出来的情绪好像有点不同！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「咚咚小圆帽」感到非常满足，像是吃饱甜食后，要慢慢飘到云朵里去了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「欢腾之火」现在好像也能接受甜食了，而且更加振奋！作风一如既往帅气！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true