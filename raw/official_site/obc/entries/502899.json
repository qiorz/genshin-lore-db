\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e）\u003c/span\u003e\u003c/p\u003e\"]},\"tab_id\":\"1728389964874_2\"},{\"tab_name\":\"厄灵之能\",\"skill_type\":\"被动技能\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/6f2fc1e2e7ad6747577d954f3db9012f_2120144226908224970.png\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"desc\":{\"key\":\"技能效果\",\"value\":[\"\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e【被动】\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e此角色受到伤害后：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e如果此角色生命值不多于7，则获得1点\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e充能\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e。（每回合1次）\u003c/span\u003e\u003c/p\u003e\"]},\"tab_id\":\"1728390448217_3\"}]}","style":""}],"id":"132","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"召唤物","is_poped":false,"components":[{"component_id":"card_skill","layout":"","data":"{\"moduleName\":\"召唤物\",\"layout_\":\"left\",\"list\":[{\"tab_name\":\"厄灵·草之灵蛇\",\"skill_type\":\"特技\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/10/08/258999284/3261818320d16e4b8cabb03dbe540914_6911917252679998208.png\",\"life\":0,\"life_bg\":10,\"energy\":0,\"desc\":{\"key\":\"特技效果\",\"value\":[\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e特技\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e特技：\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e出战角色装备有「特技」卡牌时，就可以使用对应的「特技」。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e使用「特技」是一种「战斗行动」。角色因冻结、石化、眩晕等原因无法使用技能时，也会同时无法使用「特技」。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e角色使用「特技」时不视为使用技能，无法触发「使用技能后」「角色引发元素反应后」等效果；角色使用「特技」造成的伤害不被视为角色造成的伤害。\u003c/span\u003e\u003c/p\u003e\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e：\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e藤蔓锋鳞\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u003cp\u003e\u003cstrong\u003e藤蔓锋鳞：\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e特技\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e费用：1+1点充能\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e造成1点\u003cstrong\u003e\u003cspan style=\u0026quot;color: rgb(126, 194, 54)\u0026quot;\u003e草元素伤害\u003c/span\u003e\u003c/strong\u003e。\u003c/p\u003e\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e\u003cu\u003e可用次数\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan data-type=\\\"详情\\\" data-name=\\\"\u003cp\u003e\u003cstrong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e可用次数：\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e此牌效果触发后，会消耗1次\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e可用次数\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e;\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e可用次数\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\u0026quot;color: rgb(0, 0, 0)\u0026quot;\u003e耗尽后，立刻弃置此牌。\u003c/span\u003e\u003c/p\u003e\\\" class=\\\"wiki-note-text\\\"\u003e\u003csup class=\\\"wiki-sup\\\"\u003e[详情]\u003c/sup\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e：\u003c/span\u003e\u003c/strong\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e2\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(0, 0, 0)\\\"\u003e（角色最多装备1个「特技」）\u003c/span\u003e\u003c/p\u003e\"]},\"tab_id\":\"1694067334491_0\"}],\"repeated\":true}","style":""}],"id":"133","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"卡牌故事","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003cstrong\u003e旋舞之忆·叶轮舞者\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e「沙之民有音乐与舞蹈的传统，起初是对神的礼赞，后来则是讨取王者欢心的演艺与战斗的技术。」\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"134","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"基础信息","is_poped":false,"components":[{"component_id":"card_base_info","layout":"","data":"{\"moduleName\":\"基础信息\",\"layout_\":\"left\",\"name\":\"\",\"common_img\":\"\",\"gold_img\":\"\",\"life\":0,\"life_bg\":0,\"energy\":0,\"energy_bg\":0,\"attr\":[{\"key\":\"充能：\",\"value\":[]},{\"key\":\"攻击：\",\"value\":[]}],\"baseInfoSwitchDisabled\":false}","style":""}],"id":"6496","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"