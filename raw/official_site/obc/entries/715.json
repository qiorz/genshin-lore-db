,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"124qt10olikbT1713366919351\":[\"ef8yq8vjv8sT1713371586478\"],\"4cf2vhylew3T1710863944349\":[\"ef8yq8vjv8sT1713371586478\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"mw62hautp6T1713365987778\",\"n5ln1ipqkzmT1713366062472\"],\"98dnfsc96hsT1713366886015\":[\"ef8yq8vjv8sT1713371586478\"],\"ef8yq8vjv8sT1713371586478\":[\"sto3kt6q1sT1713374759078\"],\"eo88k8b61unT1713366884921\":[\"124qt10olikbT1713366919351\"],\"g1nwa1gcylaT1713374794555\":[\"rjyn6ah32jT1713374815062\"],\"ibpm1qivzcfT1713374949393\":[\"p3txfkdfq4nT1713374970089\"],\"jag1iljr6nT1713366886948\":[\"ef8yq8vjv8sT1713371586478\"],\"ky8b9ea1sxkT1713723130196\":[],\"mw62hautp6T1713365987778\":[\"eo88k8b61unT1713366884921\",\"98dnfsc96hsT1713366886015\",\"jag1iljr6nT1713366886948\"],\"n5ln1ipqkzmT1713366062472\":[\"ef8yq8vjv8sT1713371586478\"],\"nqb471m7nmnT1710863941173\":[\"ef8yq8vjv8sT1713371586478\"],\"ntpbo121x9cT1713374842240\":[\"ibpm1qivzcfT1713374949393\"],\"p3txfkdfq4nT1713374970089\":[\"ky8b9ea1sxkT1713723130196\"],\"qxeaud9wdcrT1713374830814\":[\"ibpm1qivzcfT1713374949393\"],\"rjyn6ah32jT1713374815062\":[\"qxeaud9wdcrT1713374830814\",\"ntpbo121x9cT1713374842240\"],\"sto3kt6q1sT1713374759078\":[\"g1nwa1gcylaT1713374794555\"],\"z2tn3pzsbujT1710863943430\":[\"ef8yq8vjv8sT1713371586478\"]},\"contents\":{\"124qt10olikbT1713366919351\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呼呼，为什么呢，可能是因为以前看过的这本《蒲公英海的狐狸》吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这本书送给你吧，说不定看完了这个故事你也会喜欢上蒲公英呢，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"624\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/30/8797197/33858c1ea33b916045ee30f83c6b962f_6097440085697368267.png\\\" data-entry-name=\\\"《蒲公英海的狐狸》第一卷\\\" data-entry-link=\\\"/ys/obc/content/624/detail?bbs_presentation_style=no_header\\\"\u003e\u003ca href=\\\"/ys/obc/content/624/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2020/04/30/8797197/33858c1ea33b916045ee30f83c6b962f_6097440085697368267.png\\\"\u003e\u003cspan class=\\\"name\\\"\u003e《蒲公英海的狐狸》第一卷\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/183046623/b26706122e54335e75a99308e473cc62_6604183533147209006.png\",\"option\":\"【你为什么喜欢蒲公英？】——获得《蒲公英海的狐狸》第一卷\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e不用担心店里的花被风刮飞了，真是太好了呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过蒲公英种子因为这次的风灾而随风飞向了蒙德各地，说不定不久后蒲公英就会在蒙德各地盛开呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这么一想，风灾好像也没那么可怕了，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第三幕「巨龙与自由之歌」后\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临「花语」，呼呼，有什么需要了解的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"98dnfsc96hsT1713366886015\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e甜甜花啊…呼呼。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e花朵是很好看，但大家一般都是拿它去做菜的呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要是你看到有人家里种着甜甜花盆栽…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定只是为了熬糖用的呢，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于甜甜花。】\"},\"ef8yq8vjv8sT1713371586478\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成世界任务「轻飘飘的花与芙萝拉」后在白天触摸花朵】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"eo88k8b61unT1713366884921\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呼呼，芙萝拉最喜欢蒲公英啦。轻飘飘，轻飘飘。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那位，骑士团的代理团长琴大人，好像就叫蒲公英骑士哦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说不定就是跟蒲公英待久了，才掌握了风元素的力量的呢，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于蒲公英。】\"},\"g1nwa1gcylaT1713374794555\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一、二次风花节（2021、2023）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"ibpm1qivzcfT1713374949393\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【第一次佳酿节（2022）期间】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"jag1iljr6nT1713366886948\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e塞西莉亚花呀，你可真有品味呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e耐寒，喜风，传说只会在安静的地方开放。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果想要培育的话…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e呼呼，或许比养冰雾花还要难呢！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于塞西莉亚花。】\"},\"ky8b9ea1sxkT1713723130196\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"mw62hautp6T1713365987778\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e呼呼～本店的花种类齐全哦，想了解哪一种呢？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于店里的花…】\"},\"n5ln1ipqkzmT1713366062472\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e唔，这就要走了吗。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没事，芙萝拉以后也会告诉你花的事情。下次再来哦，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【打扰了。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可以哦，无论是送人还是自己养都很不错的，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2024/04/17/183046623/11ee64c710e3b091256c0d349ac55461_9002278667355771472.png\",\"option\":\"【我想买些花。】——打开商店界面\"},\"ntpbo121x9cT1713374842240\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e希望你也能在这次风花节庆典中获得快乐。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【打扰了。】\"},\"o3fwflfmmxT1713371639652\":{\"dialogue\":\"\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"p3txfkdfq4nT1713374970089\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临「花语」，呼呼，有什么需要了解的吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最近大家都来问，什么花最能代表丰收的快乐，呼呼，我觉得蒲公英就很不错哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"qxeaud9wdcrT1713374830814\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e风花节是蒙德的古老节日，是属于自由和爱情的节日。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e说起风花节的传统，应该就是把心中的「风之花」送给最重要的人吧，呼呼…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e至于「风之花」到底是哪种花，大家都有不同的看法呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这也是蒙德人自由的体现吧，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于风花节…】\"},\"rjyn6ah32jT1713374815062\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎光临「花语」，呼呼，风花节到了，要给重要的人买一束花吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"sto3kt6q1sT1713374759078\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎！那些花是用来展示的，要买花的话请来我这边！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e比起风魔龙，更吓人的是笼罩蒙德的飓风啊，呼呼…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然大家都在关注民众的伤亡与损失，而我更在意的还是那些花草植物。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像巴巴托斯大人保护我们一样，我也会保护它们的，呼呼。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 序章第三幕「巨龙与自由之歌」后消失）\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"【关于龙灾…】——完成魔神任务 序章第一幕「捕风的异乡人」后\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713723251","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value