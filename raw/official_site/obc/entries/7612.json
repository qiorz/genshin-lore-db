8","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务过程","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e为了治疗祖莉亚夫人的孩子，你们加入了一场幻想的历险。今天就是前往水妖王国的启程之日，会在那里遇见什么呢？\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e等待两天后\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e前往菲米尼的营地\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e向水妖王国的方向进发\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e寻找制作王冠的材料\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e前往水妖王国\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e进入副本勇闯水妖王国\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e和众人交谈\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp style=\\\"white-space: pre-wrap;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败魔物\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cl