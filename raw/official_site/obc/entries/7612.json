\\\"https://act-upload.mihoyo.com/ys-obc/2023/11/25/83684823/d50fb37e3954b2b7105c61cf8f442c6e_9075677896008395211.png\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e大英雄的经验\u003c/span\u003e\\n      \u003cspan class=\\\"amount\\\"\u003e*5\u003c/span\u003e\\n    \u003c/a\u003e\\n  \u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/11/26/83684823/ca505f60467bfdcf38ef463251c1b99d_1470813799428032831.png\"},{\"tab_name\":\"任务结束位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/11/26/83684823/ca505f60467bfdcf38ef463251c1b99d_2330905246792988111.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"child_ids\":{\"11yaelm7gccpT1713280759806\":[\"uo3wmihyu5gT1713280779992\"],\"ewllh0qqr0dT1711546416025\":[\"p4pvi3x2emdT1713280758912\",\"11yaelm7gccpT1713280759806\"],\"p4pvi3x2emdT1713280758912\":[\"uo3wmihyu5gT1713280779992\"],\"uo3wmihyu5gT1713280779992\":[]},\"contents\":{\"11yaelm7gccpT1713280759806\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：菲米尼很努力。\"},\"ewllh0qqr0dT1711546416025\":{\"dialogue\":\"\u003cp\u003e为了治疗祖莉亚夫人的孩子，你们加入了一场幻想的历险。今天就是前往水妖王国的启程之日，会在那里遇见什么呢？\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e等待两天后\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往菲米尼的营地\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：您的孩子情况好点了吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：多谢关心，现在还比较稳定。我的家庭医生说，今天可以试试带他出门散心了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：祖莉亚夫人！菲米尼！我们来啦。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：呵呵，看来大家都到齐了呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：其实还少一个人吧？嘿嘿，但我猜到他在哪了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：喂——「特尔克西」——\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e「特尔克西」：-.. -... .-- -...？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哇！「特尔克西」多了一把剑和一面盾牌！好漂亮哦。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：有了武器的「特尔克西」，看起来格外有冲劲呢。菲米尼先生的手艺，真令人赞叹。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：也有我们的功劳！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：嗯，旅行者的眼光很好，找来的材料成色都很棒。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：对了，祖莉亚夫人刚和我说，在历险的最后，希望能用一次加冕仪式当作结局。所以旅行者，王冠的材料…能不能也拜托你？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：等会过去的途中顺便找一找就好，本来我打算自己解决，但现在我觉得，你找来的也许会更精美。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：包在我身上。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：看来已经万事俱备啦，我们现在要出发了吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：请稍等，我在想，既然「特尔克西」已经是一副全新的面貌了，也许我们现在就可以更新一页绘本，大家觉得呢？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哇哦！一下就期待起来了！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：要画什么内容呢？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：…就在原有的基础上调整怎么样？至少让画的内容不再那么悲伤…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：把坏的部分去掉，画成好的吗？听起来好像很不错。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：那就由我来动手吧，虽然我不是特别擅长绘画，但工作上也有不少接触，至于具体内容，大家可以畅所欲言。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：我想…首先可以把武器画上，王子拿起了勇气的剑和坚毅的盾，证明他已经跨过沉沦，决心向黑暗开战。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：好，把武器画上…还有呢？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：我觉得要加上伙伴！这一次「特尔克西」身边站着可靠的伙伴，他不是一个人在战斗。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：好，把伙伴画上…还有呢？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：还有色彩。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：色彩…色彩…好！色彩很重要，前方的路不会再是灰败的，而是五颜六色的，充满希望的。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：没想到…居然变成了这种振奋人心的画面…太棒了，大家的想法太棒了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：真好呀，大家看起来都很有精神，「特尔克西」最有精神！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：我的孩子，你看到了吗？你一定也会被鼓舞吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e「特尔克西」：-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：一定会的，祖莉亚夫人，而且这只是第一页。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：没错，我已经迫不及待地想要看到最后的绘本啦，我们要用最快的速度和最真诚的心意完成它！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：嗯！我也开始期待了，那就不再浪费时间，各位，我们现在就动身吧！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：好耶！《特尔克西的奇幻历险》出发咯！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e一段时间后，你们来到了水妖王国附近的岸边…\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e向水妖王国的方向进发\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e寻找制作王冠的材料\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e前往水妖王国\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e进入副本勇闯水妖王国\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e和众人交谈\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：这里就是菲米尼找到的水下遗迹吗？虽然有点壮观，但跟想象中还是有些不一样…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：不是水下遗迹，是水妖王国。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：知道啦，我是说…我还以为真的会看到一个童话世界呢，比如水妖们住的彩色房子，还有彩虹桥…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：抱歉…其实我有想过做一些装饰，但是因为人力和时间关系…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：没关系，现在是幻想时间！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：喂喂！旅行者，你一下就入戏好深哦。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：说明旅行者已经领会到精髓了，小派蒙也要加油。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哼，不要小看我，我不会拖后腿的，现在就进入…进入幻想派蒙模式！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：咳咳…年轻的勇者们哟！我是守护此地的女神派蒙，诸位来此有何贵干哟？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：…呃…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：回禀女神大人，我们是王子特尔克西的伙伴，来到此地是要帮他寻回遗失的荣耀。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：喔——寻回荣耀哟！本女神这里有一个金荣耀，一个银荣耀和一个铜荣耀，哪一个才是王子遗失的呢？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：咦？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：唔…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：是不是串戏了？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：才没有！这是女神的测试哟！本女神已经测试出来，你们的内心没有一丝贪婪，是真正值得尊敬的勇者哟！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：那么请接受本女神的奖励吧，本女神要把金荣耀，银荣耀和铜荣耀全部奖励给你们！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：还有这位王子，本女神要额外再赐予你七彩的荣耀，愿你的未来充满明亮！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e「特尔克西」：-.. -... .-- -...？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：多谢女神大人的祝福，我现在感觉浑身充满了力量。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：我…我也是…哇…这就是传说中的，女神的真言鼓舞吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：派蒙女神真是太厉害啦！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哼哼，勇者们哟，现在就去打败侵占王国的魔物吧！你们一定能在此地找到想要的东西！\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e击败魔物\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e与菲米尼对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：呼——终于结束啦，这下就算我们打败了邪恶的魔物，顺利夺回了水妖王国对吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：是的，到这里，本来应该为「特尔克西」举行加冕仪式了，只是…原以为不可能一次就闯入遗迹的最深处，没想到今天这么顺利…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：是我的问题，我应该早点告诉菲米尼先生，还需要一个王冠…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：是旅行者和本女神太厉害啦，一下就捅穿了魔物的老巢！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：没关系，祖莉亚夫人，等做好王冠，我们还可以再来一趟。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：那真要辛苦大家了，还有「特尔克西」，我的孩子，你也很棒。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e「特尔克西」：-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：确实没想到哦，「特尔克西」也很能打嘛！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：他就像个真正的王子，我想…没有什么困难能够一直阻碍他。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：菲米尼先生…嗯！我相信！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：先回营地吧，来的路上拜托了旅行者搜集材料，我想尽快把王冠做出来。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：正好回去把我们的旅程画下来，夺回了水妖王国，《特尔克西的奇幻历险》也可以更新啦。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e\u003cspan\u003e返回营地\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：祖莉亚夫人，菲米尼，我们先来画画吧？比起王冠，我更想看看绘本的新内容！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：其实是在期待派蒙女神的样子吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哎呀！你知道就行了，不用一定说出来的！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：哈哈，好，我知道了，那么今天的故事应该是这样…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：在历经千难万险后，王子与他的勇者们终于抵达了水妖王国的入口。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：这时，同伴中的小精灵派蒙，向大家展现了她的真实身份——一位隐藏的女神。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：好耶！女神出场了！女神大大赞扬了勇者们的诚实，作为奖励，她洒下好多好多祝福，然后还许愿王子一定能够完成目标！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：沐浴在女神的荣耀下，王子与勇者冲入了邪恶的巢穴，驱逐了魔物，拯救了被关押的可爱水妖。王子终于夺回了王国，但王冠…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哎呀，王冠还没有做好！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：不…王冠就在那，逃跑的魔物将它秘密带走了，邪恶仍不死心。但王子很快就会夺回王冠，绚烂的彩虹会重新降临在王国中。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：唔…这个解释…很有代入感！\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哇，真好…祖莉亚夫人画得真好…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：谢谢，这下绘本的第二页也完成了，「特尔克西」的历险离终点越来越近，他会加冕为王…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：而我的孩子，你一定也会在那时振作起来吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e「特尔克西」：-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：一定会的，祖莉亚夫人！而且，说不定今天你回家后，就能听见医生的好消息了呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：借您吉言，女神大人。对了，菲米尼先生，关于王冠的制作…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：一天的时间足够了，请放心。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：麻烦你了，那么最后的历险，就还放在两天后吧，大家仍然在这里集合，好吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：没问题。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：那两天后见了，可爱的朋友们。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e祖莉亚·德斯特雷：\u003cspan\u003e♪♫♪\u003c/span\u003e~\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哎呀，夫人回去了，我们差不多也该回去了，菲米尼还有工作要做吧？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：嗯，我待会要去城里买一些零件，用来制作王冠的底座。我打算做几个不同的方案，然后选出最合适的那个。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"p4pvi3x2emdT1713280758912\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：菲米尼很认真。\"},\"uo3wmihyu5gT1713280779992\":{\"dialogue\":\"\u003cp\u003e派蒙：是呀，我以前只知道菲米尼不会轻易接受别人的委托，没想到一旦接受了委托会这么用心呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：…可能…因为…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：什么？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：因为…我希望…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：哎呀，怎么吞吞吐吐的，那是什么表情呀？感觉立刻就要脸红戴上头盔躲起来了呢。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：啊！我脸红了吗？\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：不要为难菲米尼了。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e派蒙：嘿嘿，好啦，菲米尼，那今天就不打扰你的工作了哦，我们两天后再见吧。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：…谢谢…好…两天后见…\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e旅行者：两天后见。\u003c/p\u003e\u003cp style=\\\"text-align: justify\\\"\u003e菲米尼：…我希望，所有身处困境的人们，都能看到美好的东西，都能看到奇迹…\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"}},\"root_id\":\"ewllh0qqr0dT1711546416025\"}\n","style":""}],"id":"4059","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1713319350","langs":[],"template_layout":{"tab":[{"tab_id":"95","tab_name":"页签1","module_group":[{"module_group_id":"771","layout":"l2r1","module":[{"id":"1367","pos":"left"},{"id":"1368","pos":"right"},{"id":"1369","pos":"left"},{"id":"1370","pos":"left"},{"id":"1371","pos":"right"},{"id":"1372","pos":"banner"},{"id":"4059","pos":"banner"},{"id":"1373","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"43","name":"任务","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"任务","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"default\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attribute_key\":\"icon_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"跳转链接\",\"attribute_key\":\"jump_url\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc\",\"attribute_key\":\"icon_url_pc\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"频道icon-pc-hover\",\"attribute_key\":\"icon_url_pc_hover\",\"value\":\"\"},{\"type\":\"text\",\"attribute_name\":\"筛选器\",\"attribute_key\":\"filter\",\"value\":\"[{\\\"label\\\":\\\"任务类型\\\",\\\"children\\\":[{\\\"label\\\":\\\"魔神任务\\\",\\\"children\\\":[]},{\\\