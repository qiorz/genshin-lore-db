8180982/0d9658a712e98f7613b29319892d7ca4_5361056356539158012.png\"},\"nqb471m7nmnT1710863941173\":{\"option\":\"【领取「每日委托」奖励】——未完成四个每日委托\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很抱歉，今天你完成委托的数量还不够呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/e7adaae20a9e97e64ae2d49040ef6cd2_5807507832017073832.png\"},\"tgi8maghieT1757610011483\":{\"option\":\"【再见。】——对话角色为除桑多涅外的角色\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，感谢您对协会做出的贡献，冒险家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"tx5hxncojaT1757610009752\":{\"option\":\"【果然是你，凯瑟琳！】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好，我的确是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e看来你已经很熟悉冒险家协会的运作模式，我就不多赘述了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"option\":\"【领取「每日委托」奖励】——已完成四个每日委托，未领取每日委托奖励\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你完成了今天的委托，这是给你的奖励。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/e7adaae20a9e97e64ae2d49040ef6cd2_1862856068476292543.png\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1783329141","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"na