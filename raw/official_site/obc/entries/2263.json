舰履孤云\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cp\u003e【开场白】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，或许这就是舵手的宿命吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【你是？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是这艘船的舵手，每次航行时得寸步不离地守着舵…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…要是遇到了暗礁、漩涡之类的突发情况就得迅速做出反应，真是一刻也不能松懈。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽说不是一份容易的差事，但好歹一直都是我的梦想。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"wstoms0ndzcT1717855783071\":{\"icon\":\"\",\"option\":\"【梦想？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我成为舵手的原因，就是想开着一艘大船到世界各地去游历冒险，无拘无束地航行…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e到现在，我的梦想已经实现了一半，我成了「死兆星号」的舵手…可惜，另一半梦想可能没法实现了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e虽然我是舵手，但去哪里、走哪条航路都必须要听船长和航海士的…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，一开始确实有些失望的，不过时间久了也就看开了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e毕竟大多数人的人生都是这样，能自由掌控方向的终归是少数…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e最起码我遇到了一个可以全心信任的领导者，不是吗？北斗大人指的方向是绝对不会错的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"z2tn3pzsbujT1710863943430\":{\"icon\":\"\",\"option\":\"【再见。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有空记得来找我聊聊天。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}},\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"nqb471m7nmnT1710863941173\":[\"wstoms0ndzcT1717855783071\"],\"wstoms0ndzcT1717855783071\":[],\"z2tn3pzsbujT1710863943430\":[]}}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1718038208","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","has_page":false,"style":"","sub_menus":[],"icon":"","mi18n_key":"NPC\u0026商店","is_hidden":false,"parent_id":"189","template_id":"","bg_img":"","ch_ext":"[{\"type\":\"text\",\"attribute_name\":\"每行个数\",\"attribute_key\":\"col_per_row\",\"value\":\"2\"},{\"type\":\"text\",\"attribute_name\":\"展示样式\",\"attribute_key\":\"display_type\",\"value\":\"avatar\"},{\"type\":\"text\",\"attribute_name\":\"频道icon\",\"attr