out":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":true,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"ewllh0qqr0dT1711546416025\",\"child_ids\":{\"60lktyyne5wT1760200775913\":[\"lq2e2dbnvplT1760200820568\"],\"6pzthpt5ivwT1760200701971\":[\"60lktyyne5wT1760200775913\"],\"ampxxydsl6nT1760200889135\":[],\"ewllh0qqr0dT1711546416025\":[\"p1jlwi7o8gT1760200701576\",\"6pzthpt5ivwT1760200701971\",\"ocwymdravxoT1760200702383\"],\"lhh47hu2naeT1760200888790\":[],\"lq2e2dbnvplT1760200820568\":[\"yzqnh433bulT1760200902055\"],\"ocwymdravxoT1760200702383\":[\"60lktyyne5wT1760200775913\"],\"p1jlwi7o8gT1760200701576\":[\"60lktyyne5wT1760200775913\"],\"yzqnh433bulT1760200902055\":[\"lhh47hu2naeT1760200888790\",\"ampxxydsl6nT1760200889135\"]},\"contents\":{\"60lktyyne5wT1760200775913\":{\"dialogue\":\"\u003cp\u003e派蒙：欸？这是什么？是刚才那个奇怪的人的东西吗…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506433\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/105506159/75b21c6d90772542dcdb427716241688_6395104625971394125.png\\\" data-entry-name=\\\"不死者的哀铃\\\" data-entry-link=\\\"/ys/obc/content/506433/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506433/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/105506159/75b21c6d90772542dcdb427716241688_6395104625971394125.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e不死者的哀铃\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e派蒙：欸？是那个奇怪的人！我们去帮帮他吧！\u003c/p\u003e\u003cp\u003e派蒙：看起来是属于那个奇怪的人的东西…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506478\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/105506159/9221118e6620c220e6cab41cf4b5fe57_583949526583355041.png\\\" data-entry-name=\\\"未吹响的号角\\\" data-entry-link=\\\"/ys/obc/content/506478/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506478/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/105506159/9221118e6620c220e6cab41cf4b5fe57_583949526583355041.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e未吹响的号角\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e派蒙：又是他！这次是从哪里冒出来的…\u003c/p\u003e\u003cp\u003e派蒙：说起来，看他的打扮应该是执灯人…曾经是执灯人吧。\u003c/p\u003e\u003cp\u003e派蒙：那夏镇也有执灯人呢，要不找他们问问？说不定他们会知道些什么。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506510\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/8f32ed0d9f3a13d48675414adc22fb7d_8166056978552904747.png\\\" data-entry-name=\\\"被浸染的缨盔\\\" data-entry-link=\\\"/ys/obc/content/506510/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/506510/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/105506159/8f32ed0d9f3a13d48675414adc22fb7d_8166056978552904747.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e被浸染的缨盔\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e前往那夏镇，寻找执灯人了解情况\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e派蒙：打扰一下！有件事想问问两位…\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e向两位执灯士出示了此前得到的物件，并讲述了与身着执灯人服饰的怪人并肩作战，击退狂猎的事…\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e卢什涅：难道是西格德？他…直到现在也无法安息啊，要是我能更加…\u003c/p\u003e\u003cp\u003e苏霍维赫：别这么说，这不是你一个人的责任。只要狂猎尚存，他就不会停止战斗…我们所能做的，只有尽力完成自己的使命而已。\u003c/p\u003e\u003cp\u003e派蒙：所以西格德他也曾经是执灯人的一员，对吧？\u003c/p\u003e\u003cp\u003e苏霍维赫：是的，他是了不起的执灯长。在狂猎的大军席卷挪德卡莱时，他英勇地战斗到了最后一刻。\u003c/p\u003e\u003cp\u003e苏霍维赫：据说警铃响起时，失却了心智的魔物就像是为之胆寒一样，不敢贸然向前…没想到他的遗物会被两位找到。\u003c/p\u003e\u003cp\u003e苏霍维赫：如果可以的话，请两位将遗物带去伦波岛东的战场遗址，带去他的墓前。\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"6pzthpt5ivwT1760200701971\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：旅行者，那边有人在和狂猎作战，我们去帮帮他吧！\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：他的样子看起来怪怪的…可是他跟狂猎也不是一伙的…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"从叮铃哐啷蛋卷工坊左侧点位开始触发\"},\"ampxxydsl6nT1760200889135\":{\"dialogue\":\"\",\"icon\":\"\",\"option\":\"旅行者：（暂时离去。）\"},\"lhh47hu2naeT1760200888790\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e西格德：原来是我…但是终于…结束了…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：（做好准备…）\"},\"lq2e2dbnvplT1760200820568\":{\"dialogue\":\"\u003cp\u003e苏霍维赫：感谢。愿他的灵魂得以安息的那一日尽早到来…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e苏霍维赫的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e苏霍维赫：劳烦两位将遗物带去伦波岛东的战场遗址，带去他的墓前吧。愿他的灵魂得以安息的那一日尽早到来…\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e卢什涅的场景对话\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e卢什涅：拜托了。\u003c/p\u003e\u003ch2 class=\\\"custom-heading-cls\\\" style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e将遗物交还至西格德的墓前\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003e派蒙：这就是西格德的墓了吧，只有他一个在这里…\u003c/p\u003e\u003cp\u003e派蒙：总之，我们先把这些装备交还给他吧。\u003c/p\u003e\u003cp\u003e碑铭：「为了家园与炉火。」\u003c/p\u003e\",\"icon\":\"\",\"option\":\"旅行者：放心交给我们吧。\"},\"ocwymdravxoT1760200702383\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：是新的敌人？不对…他跟狂猎好像不是一伙的，可是…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"从星砂滩上方点位开始触发\"},\"p1jlwi7o8gT1760200701576\":{\"dialogue\":\"\u003cp\u003e\u003cspan\u003e派蒙：那个人在干什么呢…难道是狂猎？但是又有点不像…\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003e派蒙：他也在和狂猎作战，他们不是一伙的？可是他的样子怪怪的…\u003c/span\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"从叮铃哐啷蛋卷工坊上方点位开始触发\"},\"yzqnh433bulT1760200902055\":{\"dialogue\":\"\u003cp\u003e\u003cstrong\u003e交付\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"506433\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/105506159/75b21c6d90772542dcdb427716241688_6395104625971394125.png\\\" data-entry-name=\\\"不死者的哀铃\\\" data-entry-link=\\\"/ys/obc/content/506433/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003