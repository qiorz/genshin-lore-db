"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色洞天对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"list\":[{\"root_id\":\"c22klsjb23T1757446532487\",\"child_ids\":{\"2lci3nsrts6T1757446806427\":[],\"4mj5xbtzkz3T1757446718414\":[\"ub0xfigfb49T1757446775317\",\"ycdkgyzo1gT1757446776361\"],\"70wdrxr0gs4T1757446826951\":[\"zz4fq1rtfmgT1757446848358\",\"mqictjpjga8T1757446857763\"],\"bihc90y2ckhT1757446722229\":[],\"c22klsjb23T1757446532487\":[\"4mj5xbtzkz3T1757446718414\",\"ztmvgg98thlT1757446719382\",\"h6gr8grodT1757446720282\",\"tyzhs8vrq3iT1757446721008\",\"bihc90y2ckhT1757446722229\"],\"h6gr8grodT1757446720282\":[\"70wdrxr0gs4T1757446826951\",\"pjfv6w6xqmnT1757446827984\"],\"mqictjpjga8T1757446857763\":[],\"pjfv6w6xqmnT1757446827984\":[\"zz4fq1rtfmgT1757446848358\",\"mqictjpjga8T1757446857763\"],\"tfxu0r1xknT1757446804673\":[],\"tyzhs8vrq3iT1757446721008\":[],\"ub0xfigfb49T1757446775317\":[],\"v4i21h28sxT1757446796106\":[\"tfxu0r1xknT1757446804673\",\"2lci3nsrts6T1757446806427\"],\"ycdkgyzo1gT1757446776361\":[],\"ztmvgg98thlT1757446719382\":[\"v4i21h28sxT1757446796106\"],\"zz4fq1rtfmgT1757446848358\":[]},\"contents\":{\"2lci3nsrts6T1757446806427\":{\"icon\":\"\",\"option\":\"【班尼特也要更小心自己…】\",\"dialogue\":\"\u003cp\u003e谢谢你…不过，有时候我小心了也没用。还不如提醒提醒别人。\u003c/p\u003e\"},\"4mj5xbtzkz3T1757446718414\":{\"icon\":\"\",\"option\":\"【在这里还习惯吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！这里非常棒！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e比我在冒险时候露宿的地方，好上太多了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不用躲在树洞里休息，也不用担心魔物的突袭。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e还有天上砸下来的石头…地里突然蹦出来的骗骗花…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"70wdrxr0gs4T1757446826951\":{\"icon\":\"\",\"option\":\"【这些我都明白…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对，对哦…我们一起行动那么久了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e…关于这个问题，我其实也思考过很多次了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我当然也会坚持我的使命。但使命之外的追求，也算是我的私心吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我想要成为能让你信任、能让你依靠的人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e患难与共的伙伴，来之不易的幸运…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e这一次，我想成为你的力量！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"bihc90y2ckhT1757446722229\":{\"icon\":\"\",\"option\":\"【晚安，班尼特。】——【夜晚】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e晚安，旅行者。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e充分的休息对第二天的冒险非常重要！千万记得别熬夜哦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"c22klsjb23T1757446532487\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e旅行者！嘿嘿…你好啊。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e看来今天我的运气很不错嘛。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"h6gr8grodT1757446720282\":{\"icon\":\"\",\"option\":\"【有什么想做的吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e对于冒险家来说，想做的事情，果然还是冒险吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e为了终点的宝藏，踏上未知的旅途…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e不对不对…我想说的是，想成为你的助力！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e你看…我虽然没有什么体格上的特长，但我不怕疼痛，可以适应持久的战斗！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e虽然经常因为意外受伤，但包扎伤口的手法非常熟练！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"mqictjpjga8T1757446857763\":{\"icon\":\"\",\"option\":\"【我也会把我的好运分给你。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e...谢、谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…我这是…怎么了。明明是那么开心的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"pjfv6w6xqmnT1757446827984\":{\"icon\":\"\",\"option\":\"【为什么会想要成为我的助力呢？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e那还用说！你可是我最崇拜的冒险家！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"tfxu0r1xknT1757446804673\":{\"icon\":\"\",\"option\":\"【班尼特真的很考虑别人呢…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哎呀…这也是应该的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我受到那么多人的照顾，当然也要回报大家！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e哦，对了！下次有冒险记得叫上我哦，有我在的话，我能帮你避开这些危险！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"tyzhs8vrq3iT1757446721008\":{\"icon\":\"\",\"option\":\"【早啊，班尼特。】——【白天】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e早！旅行者！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e新的一天，我们也一起踏上新的冒险吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ub0xfigfb49T1757446775317\":{\"icon\":\"\",\"option\":\"【那冒险之余，多来坐坐吧。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e可、可以吗！太棒了！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我是多幸运啊，能够认识你这样好心的搭档！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿…今后，也要给你添麻烦啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"v4i21h28sxT1757446796106\":{\"icon\":\"\",\"option\":\"【难道拉肚子了？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，拉肚子什么的，我倒是习惯了啦。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e一开始是有色彩斑斓的光点，后面变成了小人手拉手在脑袋里跳舞。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e我人倒是好得也快，就是遗憾也没放点在包里…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e告诉大家，这种树莓不能吃。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ycdkgyzo1gT1757446776361\":{\"icon\":\"\",\"option\":\"【这也太…辛苦了。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没有没有…冒险嘛，都这样。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e有你的关怀，我已经什么伤口都不觉得疼了！真的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"ztmvgg98thlT1757446719382\":{\"icon\":\"\",\"option\":\"【想一起聊聊天吗？】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好呀，和你说说我冒险的见闻吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯…前几天，我在冒险途中发现了一种颜色奇怪的树莓。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e甜倒是很甜，就是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"zz4fq1rtfmgT1757446848358\":{\"icon\":\"\",\"option\":\"【你一直都是我重要的同伴。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e...谢、谢谢你。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呜…我这是…怎么了。明明是那么开心的事情。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢你…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"}}}],\"root_id\":\"\",\"child_ids\":null,\"contents\":null}\n","style":""}],"id":"8227","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"角色展示","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"角色展示\",\"image\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/10/83684823/6d17f4a3d04133c45dee8203bc69c96b_1458416967378465619.jpg\"}]}\n","style":""}],"id":"8228","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":fa