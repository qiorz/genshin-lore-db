e},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"drz99esyrohT1755424781404\"],\"7xd3lwk833nT1754401351589\":[\"drz99esyrohT1755424781404\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"7xd3lwk833nT1754401351589\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\"],\"90dfl0t1bpT1754401114485\":[\"drz99esyrohT1755424781404\"],\"drz99esyrohT1755424781404\":[],\"nqb471m7nmnT1710863941173\":[\"drz99esyrohT1755424781404\"],\"z2tn3pzsbujT1710863943430\":[\"90dfl0t1bpT1754401114485\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您慢走。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见】\"},\"7xd3lwk833nT1754401351589\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我看看…有这些已经加入售卖清单了，请随意挑选。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/05/288180982/a0688e82c2c53cce368e3c470e9e64ac_1422252383426140862.png\",\"option\":\"【有什么在售？】——煅石之轮达到50级后 打开商店界面\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您好，您好。这里的东西分类有些乱，还请见谅…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"90dfl0t1bpT1754401114485\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真的吗？您的背包也能装下这么多东西吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…哈哈！您一定是在开玩笑对吧，我不小心当真了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e唉，玩笑归玩笑，您要是有什么整理东西的诀窍，可一定要教教我啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他们都说回声之子的人比较会做生意，所以推选我来这里当店长。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但实际工作下来，这里其实更需要的是收纳专家吧…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【没事，我的背包也差不多这样。】\"},\"drz99esyrohT1755424781404\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e抱歉，最近协会送来的东西有些杂乱，需要一些时间整理…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/05/288180982/a0688e82c2c53cce368e3c470e9e64ac_8036325253560854125.png\",\"option\":\"【有什么在售？】——煅石之轮达到50级前\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是「龙遗物协会」的一处店面，我算是这里的管理员。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e您知道，纳塔是龙与人共同生活的国度，自然有不少古龙时代遗留下来的财富。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「龙遗物协会」就是专门收集和整理这些物品的组织。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…不过其实呢，这只是比较正式的说法啦。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e实际上，因为收容的物品种类太杂，这里已经和大卖场差不多了…让您见笑…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【这里是…】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1755482952","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repe