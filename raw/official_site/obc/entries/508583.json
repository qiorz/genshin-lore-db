submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\"],\"nqb471m7nmnT1710863941173\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e【史图维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘘…都听好了，今晚的计划是…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫里兹提尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，在这里吗，这是哪啊…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【史图维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e嘿嘿，你不知道吧。这里是风车镇有名的鬼屋呢。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e传说，可怜的小艾莎曾在这里失足摔下了山崖，从此便无法离开此处。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e每当夜晚来临，小艾莎总是会在鬼屋附近哭泣。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e今晚我们要来这个鬼屋探险，看看小艾莎的故事究竟是不是真的！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【麦克斯】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么探险，像上次溜进玛莎婆婆家里那样吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【史图维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e呃啊！能不能不要再提那次失败的恶作剧了，麦克斯！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e要不是你莽莽撞撞地打翻了玛莎婆婆家的蜂蜜罐，我们早就把奶油涂上婆婆的脸了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这次我们要有计划，要有计划！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e听我说，我们这次要从后面的窗子溜进去，然后从后往前探险，嘿嘿。怎么样，莫里兹提尔，你来放哨？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【莫里兹提尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e啊？哦，都行啊。如果我困了的话能不能在外面睡一会？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【史图维尔】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e天呐！你究竟知道什么是放哨吗。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"秘闻馆情报","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":true,\"without_border\":false}\n","style":""}],"id":"8697","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1778216957","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"8697","pos":"left"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right