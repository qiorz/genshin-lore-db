u003ca href=\\\"/ys/obc/content/504971/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e荣花竞捷之争 第一幕 「为了龙伙伴」\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"rh9x9wjec1T1728742854737\",\"g11miz42qyT1736336658445\",\"4cf2vhylew3T1710863944349\"],\"g11miz42qyT1736336658445\":[],\"nqb471m7nmnT1710863941173\":[],\"rh9x9wjec1T1728742854737\":[],\"uwkavznh4diT1725252055980\":[],\"z2tn3pzsbujT1710863943430\":[\"uwkavznh4diT1725252055980\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"icon\":\"\",\"option\":\"【你也一样，再会。】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再会啦，我的朋友。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"8gfxrw8wla9T1710863939170\":{\"icon\":\"\",\"option\":\"【开场白】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e你好啊，朋友，希望一切顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"g11miz42qyT1736336658445\":{\"icon\":\"\",\"option\":\"【关于深渊…】——完成魔神任务 第五章第五幕「炽烈的还魂诗」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，这个纳塔的老对头，现在可算安静一些了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一直以来与深渊的争斗仿佛一场漫长的极限运动，没有什么是我们悬木人应付不来的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像挑战跳下悬崖，有些人重新跳了回来，有些人安全着陆，而有些人则飞去了更远的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一切结果都有其价值，值得纪念。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"nqb471m7nmnT1710863941173\":{\"icon\":\"\",\"option\":\"【关于你自己…】\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我是「悬木人」部族的首领，叫我瓦伊纳就好。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e有的人会叫我叔叔，但你可别听他们的，我哪有那么老嘛。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e「成熟」，可以是一种时尚风格。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e在我们的部族中，它只能代表我有比其他人更丰富的冒险经验，但并不与我的实际年龄挂钩，懂了吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\"},\"rh9x9wjec1T1728742854737\":{\"icon\":\"\",\"option\":\"【关于对抗深渊…】——完成魔神任务 第五章第四幕「命定将焚的虹光」后\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，这个啊…也还算顺利吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果把深渊战争也当作一种极限运动，那就没有什么是我们悬木人应付不来的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e就像挑战跳下悬崖，有些人重新跳了回来，有些人安全着陆，而有些人则飞去了更远的地方。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e一切结果都有其价值，值得纪念。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan style=\\\"color: rgb(140, 140, 140)\\\"\u003e（该对话将在完成魔神任务 第五章第五幕「炽烈的还魂诗」后消失）\u003c/span\u003e\u003c/p\u003e\"},\"uwkavznh4diT1725252055980\":{\"icon\":\"\",\"option\":\"【不用担心，我很厉害。】——获得烬芯花*3\",\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，很自信啊。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我也听说了，你是能使用燃素的外来者，这可真是厉害。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那这些东西对你来说应该是有用的吧？请拿着吧，不用客气。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e获得\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"501957\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2024/08/23/24077343/8166622af618bfbdec732bd3b8f48be6_3131202153264596437.png\\\" data-entry-name=\\\"烬芯花\\\" data-entry-amount=\\\"3\\\" data-entry-link=\\\"/ys/obc/content/501957/detail?bbs_presentat