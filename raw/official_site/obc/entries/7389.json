003cli\u003e\u003cp\u003e使用1次「元素爆发」——900【幸运牌币】\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e特殊规则：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e战斗开始后，敌方所有角色获得1点充能。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1212","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":true,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"相关任务","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"4cf2vhylew3T1710863944349\":[\"8z1g29y884jT1758092122312\"],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"4cf2vhylew3T1710863944349\",\"ohiuiihg0c7T1758092099257\",\"gmfys7xc36T1758092107976\"],\"8z1g29y884jT1758092122312\":[],\"gmfys7xc36T1758092107976\":[],\"nqb471m7nmnT1710863941173\":[],\"ohiuiihg0c7T1758092099257\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e您好，我是这里的摊主。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果我的叫卖声不小心吵到了您，还请多多包涵！一会儿我给您偷偷多塞几颗水果，嘿嘿。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是…】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e要来看看新鲜蔬果吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"8z1g29y884jT1758092122312\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e当然！这一批果子是今早刚从蒙德进来的，特别甜哦!请您尽管尝尝，不用客气，好吃再来。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/17/288180982/b26706122e54335e75a99308e473cc62_6237312350316979423.png\",\"option\":\"【真的吗？】——获得落落莓*4\"},\"gmfys7xc36T1758092107976\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e有空再来哦！我会准备好最甜的水果等着您的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我这的蔬菜水果个个饱满水灵，请您随意挑选！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/17/288180982/11ee64c710e3b091256c0d349ac55461_2107409585601129075.png\",\"option\":\"【看看。】——打开商店界面\"},\"ohiuiihg0c7T1758092099257\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e枫丹本地盛产泡泡桔，但依靠发达的水路，也会引进很多国外的水果，只是价格会略高一些。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e但请您放心。我欧仁妮绝不做亏心生意，保证客人买到的蔬果从头美味到根，绝不会有一个坏果。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【关于蔬果…】\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cp\u003e【胜利】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e怎么这样！你的打法就像枣椰…我完全不知道该怎么应对！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e【失败】\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e新鲜的牌组，比钩钩果还少见，不好对付吧！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/17/288180982/cc2a44c2e85425afbbd461e49fe0875d_8300982817096685087.png\",\"option\":\"【冒险挑战】——进行七圣召唤对局【牌手等级十级解锁】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":f