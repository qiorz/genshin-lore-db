1746581930950\":[],\"z2tn3pzsbujT1710863943430\":[\"snyo1khgrfT1746581930950\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e真遗憾。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【走了。】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我这有些好商品，还有些好故事，客人若有兴趣，不妨听我一叙。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e仅靠眼睛很难看出商品的真实价值…所以只能给你看这些了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【看看。】——选择此项将会打开商店\"},\"snyo1khgrfT1746581930950\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e噢哟，听起来有些不信我啊…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e那这件商品请您拿去，再多多体会一下其中的真谛吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e无妨，在我那丰富的存货之中，这只是一件小小的纪念品罢了。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/24077343/b26706122e54335e75a99308e473cc62_2664165974834272117.png\",\"option\":\"【有点耳熟，又有点不同…】——获得鸣草*4\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e傲然立于璃月山巅的花朵，在高空的寒风中飘摇，一如触碰过它的神女身后苍白的发丝…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e此等不俗之物，仅售八万摩拉。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e历经百年的酒坛，聆听过风神轻声哼唱的歌谣，喝了它，你也能随口唱出动人的诗篇…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如此神奇之物，仅售二十万摩拉。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【听听。】\"}}}],\"root_id\":\"\",\"child_ids\":null}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222453","langs":[],"te