u003cul\u003e\u003cli\u003e\u003cp\u003e你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/e7adaae20a9e97e64ae2d49040ef6cd2_4197343720577924889.png\",\"option\":\"【领取「每日委托」奖励】——已领取每日委托奖励\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cp\u003e（对话角色为除\u003cspan style=\\\"color: rgb(96, 98, 102)\\\"\u003e桑多涅外的角色\u003c/span\u003e）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e向着星辰与深渊！欢迎来到冒险家协会。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e（对话角色为\u003cspan style=\\\"color: rgb(96, 98, 102)\\\"\u003e桑多涅\u003c/span\u003e）\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"d604tz3aw85T1757611295507\":{\"dialogue\":\"\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/13/288180982/26e2a1ae4752b2530e2bcb81c0a7f65e_7320282716774058944.png\",\"option\":\"【查看「豪斗旅纪」信息】——打开豪斗旅纪/地方传奇界面\"},\"nbomejq64wcT1783305453637\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，感谢您对协会做出的贡献，「木偶」大人。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】——对话角色为桑多涅\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e很抱歉，今天你完成委托的数量还不够呢。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/e7adaae20a9e97e64ae2d49040ef6cd2_1170644589346113550.png\",\"option\":\"【领取「每日委托」奖励】——未完成四个每日委托\"},\"ounzjt3qddiT1757611293257\":{\"dialogue\":\"\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/4966a51b537ea9907745afe9151ac2b9_6251092138847293975.png\",\"option\":\"【领取「冒险等阶」奖励】——打开冒险等阶界面\"},\"u79yxyl9mmT1757611294265\":{\"dialogue\":\"\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/0d9658a712e98f7613b29319892d7ca4_1915063778697674646.png\",\"option\":\"【探索派遣】——打开探索派遣界面\"},\"uwqib25lqjT1757611296641\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我吗？我是冒险家协会的接待员凯瑟琳。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e专门负责为蒙德的冒险家们提供任务发布和情报支援工作。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e顺带一提，冒险家协会的服务全年无休喔。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"wt246b1gox8T1757611414598\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e冒险家协会是为了七国各地的冒险家们所设立的支援组织。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e为了让新手冒险家们更好地适应冒险生活，老手冒险家们能够更自由地进行冒险…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…协会负责整合起冒险家们口口相传的繁杂信息，将合适的冒险任务分配到冒险家的手中。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【冒险家协会是做什么的？】\"},\"xhz2a5c3gaT1757611297523\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见，感谢您对协会做出的贡献，冒险家。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】——对话角色为除桑多涅外的角色\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e感谢你完成了今天的委托，这是给你的奖励。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/09/12/288180982/e7adaae20a9e97e64ae2d49040ef6cd2_439103251349208703.png\",\"option\":\"【领取「每日委托」奖励】——已完成四个每日委托，未领取每日委托奖励\"}}}],\"root_id\":\"\"}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1783329155","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"