003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e版本活动任务：\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e2.3：\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"3169\\\" data-entry-ratio=\\\"text\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2021/11/23/4521515/8663fd588dac1ed8547aa1fcb716a698_1647455909117603097.jpg\\\" data-entry-name=\\\"皑尘与雪影\\\" data-entry-link=\\\"/ys/obc/content/3169/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\"\u003e\u003ca href=\\\"/ys/obc/content/3169/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-text\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e皑尘与雪影\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"doqwcnlh3jT1746527119686\":[],\"dsjb76o3gjtT1746526947886\":[\"pr4p9t0kfyjT1746526990020\",\"pi15isywfisT1746526991300\"],\"e93wiczfxehT1746526059013\":[\"k56iiasmf2T1746526107725\"],\"jo1bvxqvmv9T1746526031629\":[\"e93wiczfxehT1746526059013\"],\"k56iiasmf2T1746526107725\":[\"dsjb76o3gjtT1746526947886\"],\"nqb471m7nmnT1710863941173\":[\"jo1bvxqvmv9T1746526031629\"],\"pi15isywfisT1746526991300\":[\"doqwcnlh3jT1746527119686\"],\"pr4p9t0kfyjT1746526990020\":[\"unme9a176mT1746527048012\"],\"unme9a176mT1746527048012\":[\"doqwcnlh3jT1746527119686\"],\"z2tn3pzsbujT1710863943430\":[\"k56iiasmf2T1746526107725\"]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谁呀…啊，爸爸说要有礼貌一些…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e…你好？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"doqwcnlh3jT1746527119686\":{\"dialogue\":\"\u003chr\u003e\",\"icon\":\"\",\"option\":\"\"},\"dsjb76o3gjtT1746526947886\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e啊，是旅行者，你好！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"e93wiczfxehT1746526059013\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e谢谢…看你的样子，你是旅行者吧，之后会到山上去冒险吗？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果要去的话，那请你带上这块怀表吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这是一位冒险家叔叔送给我的，他说这是一块能带来幸运的表。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我本来是想送给我爸爸的，不过一直没有机会…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e如果你要到山上的话，就带上它吧。希望它能给你带来好运，祝你一切顺利。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1644\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/178964736/892aa6e0b8a77022c0002a18fc8dade7_6858319151403686347.png\\\" data-entry-name=\\\"冒险家的怀表\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/1644/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/1644/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/178964736/892aa6e0b8a77022c0002a18fc8dade7_6858319151403686347.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的怀表\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/07/178964736/b26706122e54335e75a99308e473cc62_3646029540568312853.png\",\"option\":\"【他一定会没事的。】——获得冒险家的怀表*1\"},\"jo1bvxqvmv9T1746526031629\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e没有…不过那位西风骑士叔叔说，看到他往山顶上走了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我、我想去找他，但西风骑士叔叔不让我去，我只好暂时住在这里等我爸爸了…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我一定会见到他的，我们约好了一起看雪的，他会遵守约定的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【那你找到他了吗？】\"},\"k56iiasmf2T1746526107725\":{\"dialogue\":\"\u003chr\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e【完成版本活动任务 皑尘与雪影第三幕\u003c/strong\u003e「\u003cstrong\u003e灰中之秘\u003c/strong\u003e」\u003cstrong\u003e后】\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cstrong\u003e或【完成世界任务\u003c/strong\u003e「\u003cstrong\u003e白皑谜影·重逢\u003c/strong\u003e」\u003cstrong\u003e后】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，他是个冒险家。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e他说好了要接我来雪山看雪的，不过约定的日子到了，爸爸却一直没有来接我…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我猜，他一定是发现了什么珍贵秘宝的藏宝图之类的，所以才没来找我的，一定是这样的。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我就一个人来到雪山了。既然他没法来找我，我就来找他好了…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你的爸爸？】\"},\"pi15isywfisT1746526991300\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯，再见！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"pr4p9t0kfyjT1746526990020\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e一切都好！爸爸虽然还是记不起太多事情，但他能一直陪着我，我就很开心啦！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我找来了以前常跟爸爸一起玩的玩具，或许爸爸看到之后，就能想起来什么了！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e当然，就算爸爸永远想不起以前的事也不要紧。我会和爸爸一起去找新的玩具，一起创造新的回忆！\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e比如…比如…\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【最近如何？】\"},\"unme9a176mT1746527048012\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e嗯！我喜欢堆雪人，还有捉迷藏、搭积木、读故事书…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e这附近的雪又多又白，我已经和爸爸说好啦，下次一起去堆狐狸形状的雪人！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"1644\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/178964736/892aa6e0b8a77022c0002a18fc8dade7_6858319151403686347.png\\\" data-entry-name=\\\"冒险家的怀表\\\" data-entry-amount=\\\"1\\\" data-entry-link=\\\"/ys/obc/content/1644/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/1644/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/06/178964736/892aa6e0b8a77022c0002a18fc8dade7_6858319151403686347.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e冒险家的怀表\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*1\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"htt