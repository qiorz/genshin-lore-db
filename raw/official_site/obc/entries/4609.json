\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\"],\"nqb471m7nmnT1710863941173\":[\"p9zc4fsrblT1746032724286\"],\"p9zc4fsrblT1746032724286\":[],\"z2tn3pzsbujT1710863943430\":[]},\"contents\":{\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e是以前没见过的生面孔呀…是来这里的新游客吗？\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e我呀，我的名字叫阿莲佐，是一名…前教令院学者。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我和我的弟弟胡塞尼都考上了教令院，只不过呢，我实在是没法适应那样的生活…\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e我弟弟看上去倒是乐在其中，那就随他去吧。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e总之，我放弃了学者生涯，回到故乡——也就是这里，过上了没有论文和报告会议的舒适生活啦！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【你是？】\"},\"p9zc4fsrblT1746032724286\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e光嘴上说羡慕是不会获得幸福的哦。如果有期待，就要付诸行动。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e不过看你步履匆匆的样子，应该还有要做的事情吧？\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e没关系，天有阴晴，花有开合。等做完那些必须完成的事情，再给自己放个假也不迟。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"4439\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/21/187743934/4809810eaf4ff7268b84c2a898538c80_7192220839477862407.png\\\" data-entry-name=\\\"月莲\\\" data-entry-amount=\\\"4\\\" data-entry-link=\\\"/ys/obc/content/4439/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"\u003e\u003ca href=\\\"/ys/obc/content/4439/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://uploadstatic.mihoyo.com/ys-obc/2022/07/21/187743934/4809810eaf4ff7268b84c2a898538c80_7192220839477862407.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e月莲\u003c/span\u003e\u003c/span\u003e\u003cspan class=\\\"amount\\\"\u003e*4\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/05/01/288180982/b26706122e54335e75a99308e473cc62_398671171368214915.png\",\"option\":\"【说实话，有点羡慕。】——获得月莲*4\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好哦，希望你在这里玩得愉快！\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false}],"filter_values":{},"menu_id":"0","menu_name":"","version":"1762222598","langs":[],"template_layout":{"tab":[{"tab_id":"69","tab_name":"页签1","module_group":[{"module_group_id":"691","layout":"l2r1","module":[{"id":"1207","pos":"left"},{"id":"1208","pos":"right"},{"id":"3882","pos":"banner"}],"name":"基本资料","repeated":false,"parent_group_id":"0"},{"module_group_id":"692","layout":"l1r1","module":[{"id":"1209","pos":"banner"}],"name":"","repeated":true,"parent_group_id":"0"},{"module_group_id":"693","layout":"l1r1","module":[{"id":"1210","pos":"banner"},{"id":"3885","pos":"banner"}],"name":"","repeated":false,"parent_group_id":"0"},{"module_group_id":"694","layout":"l2r1","module":[{"id":"1211","pos":"left"},{"id":"1212","pos":"right"}],"name":"","repeated":true,"parent_group_id":"0"}]}]},"edit_lock_status":"Unlock","correct_lock_status":"Unlock","menus":[{"id":"20","name":"NPC\u0026商店","h