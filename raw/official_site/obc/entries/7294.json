{"retcode":0,"message":"OK","data":{"page":{"id":"7294","name":"好事多磨","desc":"好事多磨","icon_url":"https://act-upload.mihoyo.com/ys-obc/2023/05/14/31153611/5f9af9d051379276e4fc7f76ed7d9bcb_3183104034606893038.png","header_img_url":"","modules":[{"name":"好事多磨","is_poped":false,"components":[{"component_id":"base_info","layout":"","data":"{\"list\":[{\"key\":\"触发条件\",\"value\":[\"无\"]},{\"key\":\"等级限制\",\"value\":[\"暂无\"]},{\"key\":\"特殊限制\",\"value\":[\"需在海沫村传送点东北处（本任务结束点）与柯莎对话并给予种子种花后，等待至第二天\"]}]}","style":""}],"id":"1367","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"任务概述","is_poped":false,"components":[{"component_id":"rich_base_info","layout":"","data":"{\"list\":[{\"key\":\"前置任务\",\"value\":[\"\u003cp\u003e无\u003c/p\u003e\"]},{\"key\":\"起始NPC\",\"value\":[\"\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7242\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/09/21/83684823/4e08734630bacfb3ec84e9c0da65db85_3430892596367806548.png\\\" data-entry-name=\\\"柯莎\\\" data-entry-amount=\\\"\\\" data-entry-link=\\\"/ys/obc/content/7242/detail?bbs_presentation_style=no_header\\\"\u003e\\n    \u003ca href=\\\"/ys/obc/content/7242/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\\n      \u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/09/21/83684823/4e08734630bacfb3ec84e9c0da65db85_3430892596367806548.png\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e柯莎\u003c/span\u003e\\n      \\n    \u003c/a\u003e\\n  \u003c/span\u003e\"]},{\"key\":\"结束NPC\",\"value\":[\"\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"7242\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.co