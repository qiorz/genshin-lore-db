/ys-obc/2023/07/23/83684823/f9de059da2ee541c770eb1c83d0018a9_1879667633848609499.jpg\\\" data-entry-name=\\\"原石\\\" data-entry-amount=\\\"20\\\" data-entry-link=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\"\u003e\\n    \u003ca href=\\\"/ys/obc/content/5566/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\\n      \u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/07/23/83684823/f9de059da2ee541c770eb1c83d0018a9_1879667633848609499.jpg\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e原石\u003c/span\u003e\\n      \u003cspan class=\\\"amount\\\"\u003e*20\u003c/span\u003e\\n    \u003c/a\u003e\\n  \u003c/span\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"5565\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/05/14/31153611/605f7e564ce17decc9e09508567776ce_8343868217188920411.jpg\\\" data-entry-name=\\\"摩拉\\\" data-entry-amount=\\\"25000\\\" data-entry-link=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\"\u003e\\n    \u003ca href=\\\"/ys/obc/content/5565/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\\n      \u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/05/14/31153611/605f7e564ce17decc9e09508567776ce_8343868217188920411.jpg\\\"\u003e\\n      \u003cspan class=\\\"name\\\"\u003e摩拉\u003c/span\u003e\\n      \u003cspan class=\\\"amount\\\"\u003e*25000\u003c/span\u003e\\n    \u003c/a\u003e\\n  \u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1370","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"地图说明","is_poped":false,"components":[{"component_id":"map_desc","layout":"","data":"{\"list\":[{\"tab_name\":\"任务起始位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/09/21/83684823/c7ef2aca04c68b902440568358c8140f_1021711483735718701.png\"},{\"tab_name\":\"任务结束位置\",\"image\":\"https://act-upload.mihoyo.com/ys-obc/2023/09/22/83684823/19187690bba0086e5c946b60b596bb76_5109087471593794536.png\"}]}\n","style":""}],"id":"1371","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"剧情对话","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e小花匠柯莎的烦恼仍未解决…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：是带来异国花朵的旅行者和派蒙！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：你好啊柯莎。我们带来的花，成长得怎么样了？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：这个…柯莎已经一天没去看了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：欸，不是很喜欢我们带来的花吗，为什么不去看呢？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：异国的花，那么难得，柯莎想要赶紧去照料它。可是一想到它可能会在眼前枯萎，就不敢去看了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：不会吧，都在意成这个样子了？…不如我们一起去看看吧！如果遇到什么问题，派蒙和旅行者会帮助你的！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：光提心吊胆也不是办法。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：…说得对，我们一起去吧！有派蒙和旅行者帮助，柯莎就有信心了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e前往花圃\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败隙境原体\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与柯莎对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：呜呜呜…宝贵的花朵，被弄坏了…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：真是好可惜…原来花儿无法成活，是因为隙境原体在搞破坏吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：…柯莎，柯莎从此要守在花朵旁边，一步也不离开了！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：冷静一点啊，柯莎，我们一起来想想办法吧！话说回来，隙境原体为什么会破坏花圃…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e柯莎之前带别的花回来时…/…被隙境原体找过麻烦吗？\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：从没有过！哼，这些坏家伙，只敢躲着我做坏事！柯莎好生气！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：哇啊…没想到柯莎也会有这么气愤的时候。看来是真的非常在意这些花朵。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：但是，回忆一下的话，刚才柯莎靠近的时候，隙境原体也没有主动躲开啊…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：或许吸引隙境原体的不是花。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：对呀，也有这种可能，我们调查一下花圃周围的情况吧！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e在附近寻找线索\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e击败警卫机关\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cstrong\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e与柯莎对话\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：旅行者真厉害，把丑丑的机关，「咚」地一下变成了美丽的零件。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：这样一来花圃应该不会被打扰了。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：虽然已经被糟蹋了一些，但剩下的花好像状态还不错。隙境原体也不会再来捣乱了，柯莎的花可以茁壮生长啦。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：太好了…不过，柯莎已经吸取了教训，对宝贵的花朵要小心看护，小心照顾。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：旅行者和派蒙…送来了异国的花，还帮柯莎保护花圃。柯莎要怎么报答…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：不必那么客气啦。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：对了，还有柯莎亲手采到的花朵，最珍贵的花朵！就把这个送给旅行者和派蒙！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：哦！既然是这么珍贵的花朵，不如旅行者也开辟一片花圃把它种下去…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：话说这不是汐藻吗？汐藻也算是花吗？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：汐藻是植物，汐藻又很美丽，当然属于花朵啦。这是人类的「生物学」，为了成为厉害的花匠，柯莎学了一点，哼哼。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：总觉得哪里不对，可我也不太懂那些分类理论啦…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：柯莎以后要继续努力，成为更厉害的花匠。听人类说，厉害的花匠会培育出新品种的花，拿去参加「园艺会」。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：柯莎也要培育出新品种，在「园艺会」上赢得「奖项」。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：柯莎的劲头倒是很不错，不过好像还有很多难以解释的误会…\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：参加园艺会，就是说要把自己培育的新品种拿去给人类鉴赏吧？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：柯莎的感官和审美，跟人类差别太大了…她培育的新品种花朵，在人类看来会不会很奇怪啊？\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：派蒙真关心柯莎的园艺事业啊。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：那当然了！我可是柯莎的园艺教师。要是柯莎能参赛获奖，我脸上也有光彩嘛！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e旅行者：\u003cu\u003e不必太在意奖项，最重要的是开心。/至少已经成功地迈出了第一步。\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：…也对哦！柯莎认为自己培育的花美丽就够啦！旁人的评价也没有那么重要吧。/对哦，柯莎培育出的品种可能会有些不寻常，但有些人就是喜欢独树一帜的东西嘛！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e派蒙：柯莎要照顾好花圃，看着美丽的花，每天都开开心心的哦！/柯莎！培育出了新品种之后，要第一个告诉派蒙和旅行者哦！\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"white-space: pre-wrap; text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size:10.5pt\\\"\u003e柯莎：嗯！柯莎会让异国的花茁壮成长的！/没问题，派蒙和旅行者帮了柯莎那么多!\u003c/span\u003e\u003c/p\u003e\",\"switch\":false,\"is_show_switch\":false}\n","style":""}],"id":"1372","is_customize_name":true,"is_abstract":false,"is_show_switch":true,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"攻略方法","is_poped":false,"components":[{"component_id":"collapse_panel","layout":"","data":"{\"rich_text\":\"\u003cp\u003e\u003c/p\u003e\",\"switch\":true,\"is_show_switch\":true}\n","style":""}],"id":"1373","is_customize_name":true,"is_abstract"