c/p\u003e\",\"switch\":false,\"is_show_switch\":false,\"without_border\":false}\n","style":""}],"id":"3882","is_customize_name":true,"is_abstract":false,"is_show_switch":false,"switch":false,"desc":"","repeated":false,"is_submodule":false,"origin_module_id":"0","without_border":false,"can_delete":false,"is_hidden":false,"rich_text_editing":false},{"name":"NPC对话","is_poped":false,"components":[{"component_id":"interactive_dialogue","layout":"","data":"{\"root_id\":\"\",\"child_ids\":null,\"contents\":null,\"list\":[{\"root_id\":\"8gfxrw8wla9T1710863939170\",\"child_ids\":{\"1rnjlxm9a74T1756651420271\":[],\"5g9zm3vkxb3T1756651528249\":[],\"8gfxrw8wla9T1710863939170\":[\"nqb471m7nmnT1710863941173\",\"z2tn3pzsbujT1710863943430\",\"1rnjlxm9a74T1756651420271\"],\"nqb471m7nmnT1710863941173\":[],\"qnb8jhv69kT1756651529065\":[],\"z2tn3pzsbujT1710863943430\":[\"5g9zm3vkxb3T1756651528249\",\"qnb8jhv69kT1756651529065\"]},\"contents\":{\"1rnjlxm9a74T1756651420271\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e再见。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【再见。】\"},\"4cf2vhylew3T1710863944349\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【】\"},\"5g9zm3vkxb3T1756651528249\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e好小子，我说怎么店里营业额和成本对不上。原来这家伙在捣鬼，不能让他再留在店里了。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e客人您真是正义使者，市场上要是您这种人再多一点也不会这么乌烟瘴气！这些是我的谢意，感谢您。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【拉威亚说你卖隔夜的鱼。】——导致拉威亚被开除\"},\"8gfxrw8wla9T1710863939170\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e悠悠纳塔，悠悠夏天！欢迎来到「鱼群之家」餐厅！小店有着每天现捕、保证新鲜的渔获和料理，客人一定要试试。 \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【开场白】\"},\"d8f0ec0qyneT1754668130742\":{\"dialogue\":\"\u003chr\u003e\u003cp\u003e\u003c/p\u003e\",\"icon\":\"\",\"option\":\"\"},\"nqb471m7nmnT1710863941173\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e这将会是您见过最新鲜的。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/08/80663279/8c1682d1176d5e5c252663655f810639_1191660019632437965.png\",\"option\":\"【让我看看你的货。】——打开商店界面\"},\"qnb8jhv69kT1756651529065\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e哈哈，那小子还是很有眼光的啊，就跟我招了他一样有眼光。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e客人您也是识货的人，选择小店绝对没错，这些就送给您了吧。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"icon\":\"\",\"option\":\"【拉威亚说你的鱼很新鲜。】——解锁拉威亚特殊对话\"},\"z2tn3pzsbujT1710863943430\":{\"dialogue\":\"\u003cul\u003e\u003cli\u003e\u003cp\u003e客人说什么？我没听清。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e【获得\u003c/strong\u003e\u003cspan class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"505724\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/07/27/75610764/65cf0f195579d59b065631526a523840_7270462661762556556.png\\\" data-entry-name=\\\"食谱：虾肉浓汤\\\" data-entry-link=\\\"/ys/obc/content/505724/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"1\\\"\u003e\u003ca href=\\\"/ys/obc/content/505724/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"\u003e\u003cimg class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/wiki-user-upload/2025/07/27/75610764/65cf0f195579d59b065631526a523840_7270462661762556556.png\\\"\u003e\u003cspan class=\\\"entry-material-wrap\\\"\u003e\u003cspan class=\\\"name\\\"\u003e食谱：虾肉浓汤\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cstrong\u003e】\u003c/strong\u003e\u003c/p\u003e\",\"icon\":\"https://act-upload.mihoyo.com/wiki-user-upload/2025/08/31/288180982/b26706122e54335e75a99308e473cc62_1252982573894957981.png\",\"option\":\"【拉威亚说你卖隔夜的鱼。】——获得食谱：虾肉浓汤\"}}}]}\n","style":""}],"id":"3885","is_customize_name":true,"is_abstract":false,"i